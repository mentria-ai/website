---
layout: feed-layout.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/index.html"
eleventyComputed:
  lang: "{{ locale.code }}"
  title: "{{ 'stream.home_title' | t }}"
  description: "{{ 'stream.hero_lede' | t }}"
---
<link rel="stylesheet" href="/assets/css/feed-deck.css?v={{ buildHash }}">
<link rel="stylesheet" href="/assets/css/pack.css?v={{ buildHash }}">
<link rel="stylesheet" href="/assets/css/stream.css?v={{ buildHash }}">

<div class="feed-scroll stream" id="stream">
  <section class="feed-card stream-card stream-card--hero">
    <div class="stream-hero">
      <p class="stream-hero__kicker">mentria</p>
      <h1 class="stream-hero__title">{{ "stream.hero_title" | t }}</h1>
      <p class="stream-hero__lede">{{ "stream.hero_lede" | t }}</p>
      <div class="stream-hero__actions">
        <a class="pack-btn pack-btn--primary" href="{{ locale.pathPrefix }}/learn/">{{ "stream.browse" | t }}</a>
        <a class="pack-btn pack-btn--ghost" href="{{ locale.pathPrefix }}/feed/">{{ "nav.feed" | t }}</a>
      </div>
    </div>
    <p class="stream-hero__hint" aria-hidden="true">{{ "stream.scroll_hint" | t }} ↓</p>
  </section>

  <div id="stream-dynamic"></div>

  <div id="stream-tail">
    {% for pack in packs | head(40) %}
    <section class="feed-card stream-card stream-card--cover" data-pack-id="{{ pack.id }}"{% if pack.cover %} style="--feed-card-bg: url('{{ pack.cover }}')"{% endif %}>
      {% if pack.cover %}<img class="feed-card__media" src="{{ pack.cover }}" alt="" loading="{{ 'eager' if loop.first else 'lazy' }}" decoding="async">{% else %}<div class="feed-card__color-bg stream-card__blank"></div>{% endif %}
      <div class="feed-card__gradient"></div>
      <div class="stream-chip stream-chip--{{ pack.collection }}">{% if pack.collection == "source" %}Source{% else %}Deep Cuts{% endif %}</div>
      <div class="feed-card__info">
        <p class="feed-card__caption">{% if pack.collection == "source" %}Source{% else %}Deep Cuts{% endif %} · {{ ("learn.cards_n" | t) | replace("{n}", pack.cards.length) }} · {{ ("learn.minutes_n" | t) | replace("{n}", pack.minutes) }}</p>
        <h2 class="feed-card__title">{{ pack.title | tloc(locale.code) }}</h2>
        <a class="pack-btn pack-btn--primary stream-card__cta" href="{{ locale.pathPrefix }}/learn/{{ pack.id }}/">{{ "stream.open" | t }}</a>
      </div>
    </section>
    {% endfor %}
  </div>
  <div id="stream-more" class="stream-more"></div>
  <div id="stream-live" class="sr-only" role="status" aria-live="polite"></div>
</div>

<script>
  window.MENTRIA_STREAM_TAIL = [{% for pack in packs %}{{ { id: pack.id, title: (pack.title | tloc(locale.code)), cover: pack.cover, cards: pack.cards.length, minutes: pack.minutes, collection: pack.collection } | dump | safe }}{% if not loop.last %},{% endif %}{% endfor %}];
  window.MENTRIA_STREAM_DAILY = {{ daily | dump | safe }};
  window.MENTRIA_STREAM_TOOLS = [{% for tool in tools %}{% if tool.category != "Game" and tool.slug != "extensions" and tool.slug != "search" %}{{ { slug: tool.slug, title: (("tools." + tool.slug + ".title") | traw), summary: (("tools." + tool.slug + ".lede") | traw) } | dump | safe }},{% endif %}{% endfor %}];
  window.MENTRIA_STREAM_I18N = {
    prefix: {{ locale.pathPrefix | dump | safe }},
    try_tool: {{ ("stream.try_tool" | t) | dump | safe }},
    open_tool: {{ ("stream.open_tool" | t) | dump | safe }},
    lab: {{ ("stream.lab" | t) | dump | safe }},
    lab_title: {{ ("stream.lab_title" | t) | dump | safe }},
    lab_text: {{ ("stream.lab_text" | t) | dump | safe }},
    open: {{ ("stream.open" | t) | dump | safe }},
    start: {{ ("stream.start" | t) | dump | safe }},
    today: {{ ("stream.today" | t) | dump | safe }},
    review: {{ ("stream.review" | t) | dump | safe }},
    imported: {{ ("stream.imported" | t) | dump | safe }},
    card_pos: {{ ("stream.card_pos" | t) | dump | safe }},
    done_title: {{ ("stream.done_title" | t) | dump | safe }},
    done_text: {{ ("stream.done_text" | t) | dump | safe }},
    cards_n: {{ ("learn.cards_n" | t) | dump | safe }},
    minutes_n: {{ ("learn.minutes_n" | t) | dump | safe }},
    progress_n: {{ ("learn.progress_n" | t) | dump | safe }}
  };
</script>
{% include "learn-i18n.njk" %}
<script src="/assets/js/markdown.js?v={{ buildHash }}"></script>
<script src="/assets/js/mentria-backdrop.js?v={{ buildHash }}"></script>
<script src="/assets/js/mentria-packs.js?v={{ buildHash }}"></script>
<script src="/assets/js/pack-cards.js?v={{ buildHash }}"></script>
<script src="/assets/js/stream.js?v={{ buildHash }}" defer></script>
