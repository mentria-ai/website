---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/guides/run-llm-in-browser/index.html"
eleventyComputed:
  lang: "{{ locale.code }}"
  title: "{{ 'guide_llm.title' | tlang(locale.code) }}"
  seoTitle: "{{ 'guide_llm.seo_title' | tlang(locale.code) }}"
  description: "{{ 'guide_llm.description' | tlang(locale.code) }}"
localeReload: true
models:
  - { id: "b2-2b", name: "Ternary Bonsai 2 2B", size: "520", unit: "mb", where: "where_08b" }
  - { id: "b2-4b", name: "Ternary Bonsai 2 4B", size: "1.1", unit: "gb", where: "where_2b" }
  - { id: "b2-9b", name: "Ternary Bonsai 2 9B", size: "2.4", unit: "gb", where: "where_4b" }
  - { id: "27b", name: "Bonsai 27B", size: "3.8", unit: "gb", where: "where_27b" }
speeds:
  - { name: "Ternary Bonsai 2 2B", device: "Mac · Chrome", ttft: "0.64", speed: "149" }
  - { name: "Ternary Bonsai 2 2B", device: "Mac · Safari", ttft: "0.76", speed: "80–85" }
  - { name: "Ternary Bonsai 2 2B", device: "iPhone · Safari", ttft: "5.3", speed: "23.9" }
  - { name: "Ternary Bonsai 2 2B", device: "Android (Mali-G57) · Chrome", ttft: "54.0", speed: "2.9" }
  - { name: "Ternary Bonsai 2 4B", device: "Mac · Chrome", ttft: "1.62", speed: "88.3" }
  - { name: "Ternary Bonsai 2 9B", device: "Mac · Chrome", ttft: "3.1", speed: "57.4–58.4" }
  - { name: "Bonsai 27B", device: "Mac · Chrome", ttft: "1.2", speed: "39" }
---
{%- set G = "guide_llm" | tsub -%}
{%- set P = locale.pathPrefix -%}
<section class="hero" style="padding-top:1rem;">
  <p class="eyebrow eyebrow--crumbs"><a class="eyebrow__link" href="{{ P }}/" aria-label="{{ 'nav.home' | t }}">~</a><span class="eyebrow__sep">/</span><span class="eyebrow__current">guides/run-llm-in-browser</span></p>
  <h1>{{ G.title }}</h1>
  <p>{{ G.lede }}</p>
</section>

<div class="guide">
  <section class="guide__part" aria-labelledby="try">
    <h2 id="try">{{ G.try_h }}</h2>
    <p>{{ G.try_p }}</p>
    <div class="llm-demo" id="llm-demo">
      <label class="llm-demo__label" for="llm-demo-input">{{ G.demo.label }}</label>
      <textarea class="llm-demo__input" id="llm-demo-input" rows="3" spellcheck="false">{{ G.demo.prompt1 }}</textarea>
      <div class="llm-demo__examples" aria-label="{{ G.demo.examples }}">
        <button type="button" data-prompt="{{ G.demo.prompt1 }}">{{ G.demo.ex1 }}</button>
        <button type="button" data-prompt="{{ G.demo.prompt2 }}">{{ G.demo.ex2 }}</button>
        <button type="button" data-prompt="{{ G.demo.prompt3 }}">{{ G.demo.ex3 }}</button>
      </div>
      <div class="llm-demo__bar">
        <button type="button" class="llm-demo__run" id="llm-demo-run">{{ G.demo.run }}</button>
        <span class="llm-demo__status" id="llm-demo-status" aria-live="polite">{{ G.demo.checking }}</span>
      </div>
      <div class="llm-demo__out" id="llm-demo-out" aria-live="polite" hidden></div>
      <dl class="llm-demo__stats" id="llm-demo-stats" hidden>
        <div><dt>{{ G.demo.stat_model }}</dt><dd id="llm-demo-model"></dd></div>
        <div><dt id="llm-demo-ttft-label">{{ G.demo.stat_ttft }}</dt><dd id="llm-demo-ttft"></dd></div>
        <div><dt>{{ G.demo.stat_speed }}</dt><dd id="llm-demo-speed"></dd></div>
      </dl>
      <a class="llm-demo__share" id="llm-demo-share" href="https://github.com/mentria-ai/website/discussions/categories/show-and-tell" target="_blank" rel="noopener" hidden>{{ G.demo.share }}</a>
    </div>
    <p class="guide__note">{{ G.privacy_note | replace("{p}", P) | safe }}</p>
  </section>

  <section class="guide__part" aria-labelledby="how">
    <h2 id="how">{{ G.how_h }}</h2>
    <p>{{ G.how1 | safe }}</p>
    <p>{{ G.how2 | safe }}</p>
    <p>{{ G.how3 | safe }}</p>
  </section>

  <section class="guide__part" aria-labelledby="need">
    <h2 id="need">{{ G.need_h }}</h2>
    <ul class="guide__list">
      <li>{{ G.need1 | safe }}</li>
      <li>{{ G.need2 | safe }}</li>
      <li>{{ G.need3 | safe }}</li>
      <li>{{ G.need4 | safe }}</li>
    </ul>
    <div class="guide__table">
      <table>
        <caption>{{ G.support_caption }}</caption>
        <thead><tr><th scope="col">{{ G.th_browser }}</th><th scope="col">{{ G.th_where }}</th></tr></thead>
        <tbody>
          <tr><th scope="row">{{ G.chromium_th }}</th><td>{{ G.chromium_td }}</td></tr>
          <tr><th scope="row">Safari</th><td>{{ G.safari_td }}</td></tr>
          <tr><th scope="row">Firefox</th><td>{{ G.firefox_td }}</td></tr>
        </tbody>
      </table>
    </div>
    <p class="guide__note">{{ G.support_source | safe }}</p>
  </section>

  <section class="guide__part" aria-labelledby="models">
    <h2 id="models">{{ G.models_h }}</h2>
    <div class="guide__table">
      <table>
        <thead><tr><th scope="col">{{ G.th_model }}</th><th scope="col" class="guide__num">{{ G.th_download }}</th><th scope="col">{{ G.th_used }}</th></tr></thead>
        <tbody>
          {%- for m in models %}
          {%- set size = m.size | replace(".", G.dec) %}
          <tr><th scope="row">{{ m.name }}</th><td class="guide__num">{{ G["fmt_" ~ m.unit] | replace("{n}", size) }}</td><td>{{ G[m.where] }}</td></tr>
          {%- endfor %}
        </tbody>
      </table>
    </div>
    <p>{{ G.models_p | replace("{p}", P) | safe }}</p>
  </section>

  {%- if speeds.length %}
  <section class="guide__part" aria-labelledby="speed">
    <h2 id="speed">{{ G.speed_h }}</h2>
    <div class="guide__table">
      <table>
        <thead><tr><th scope="col">{{ G.th_model }}</th><th scope="col">{{ G.th_device }}</th><th scope="col">{{ G.th_first }}</th><th scope="col">{{ G.th_speed }}</th></tr></thead>
        <tbody>
          {%- for s in speeds %}
          {%- set ttft = s.ttft | replace(".", G.dec) if s.ttft else "" %}
          {%- set speed = s.speed | replace(".", G.dec) if s.speed else "" %}
          <tr><th scope="row">{{ s.name }}</th><td>{{ s.device }}</td><td class="guide__num">{% if ttft %}{{ G.fmt_s | replace("{n}", ttft) }}{% endif %}</td><td class="guide__num">{% if speed %}{{ G.fmt_tps | replace("{n}", speed) }}{% endif %}</td></tr>
          {%- endfor %}
        </tbody>
      </table>
    </div>
    <p>{{ G.speed_p }}</p>
    <p class="guide__note">{{ G.speeds_note }}</p>
  </section>
  {%- endif %}

  <section class="guide__part" aria-labelledby="limits">
    <h2 id="limits">{{ G.limits_h }}</h2>
    <ul class="guide__list">
      <li>{{ G.lim1 | safe }}</li>
      <li>{{ G.lim2 | safe }}</li>
      <li>{{ G.lim3 | safe }}</li>
      <li>{{ G.lim4 | safe }}</li>
      <li>{{ G.lim5 | safe }}</li>
      <li>{{ G.lim6 | safe }}</li>
    </ul>
  </section>

  <section class="guide__part" aria-labelledby="more">
    <h2 id="more">{{ G.more_h }}</h2>
    <ul class="guide__list">
      <li>{{ G.more1 | replace("{p}", P) | safe }}</li>
      <li>{{ G.more2 | replace("{p}", P) | safe }}</li>
      <li>{{ G.more3 | replace("{p}", P) | safe }}</li>
      <li>{{ G.more4 | replace("{p}", P) | safe }}</li>
    </ul>
    <p class="guide__updated">{{ G.updated }}</p>
  </section>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": {{ G.title | dump | safe }},
  "description": {{ G.description | dump | safe }},
  "inLanguage": "{{ locale.code }}",
  "datePublished": "2026-10-09",
  "dateModified": "2026-10-28",
  "mainEntityOfPage": "{{ site.siteUrl }}{{ P }}/guides/run-llm-in-browser/",
  "author": { "@type": "Organization", "name": "Mentria", "url": "{{ site.siteUrl }}/" },
  "publisher": { "@type": "Organization", "name": "Mentria", "url": "{{ site.siteUrl }}/" }
}
</script>
<script type="application/json" id="llm-demo-copy">{{ { lang: locale.code, dec: G.dec, fmt_s: G.fmt_s, fmt_tps: G.fmt_tps, fmt_mb: G.fmt_mb, fmt_gb: G.fmt_gb, text: G.demo } | dump | safe }}</script>

<style>
  .guide { max-width: 720px; margin: 0 auto 3rem; display: grid; gap: 2.2rem; line-height: 1.6; }
  .guide p, .guide ul { margin: 0; }
  .guide__part { display: grid; gap: 0.8rem; }
  .guide__part h2 { margin: 0; font-size: 1.25rem; }
  .guide__list { padding-left: 1.2rem; display: grid; gap: 0.55rem; }
  .guide strong { color: var(--term-fg); }
  .guide a { color: var(--syn-cyan); text-decoration: underline; text-underline-offset: 0.2em; }
  .guide__note, .guide__updated { font-size: 0.9rem; color: var(--term-muted); }
  .guide__table { overflow-x: auto; }
  .guide__table table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  .guide__table caption { text-align: left; font-size: 0.86rem; color: var(--term-muted); padding-bottom: 0.4rem; }
  .guide__table th, .guide__table td { text-align: left; vertical-align: top; padding: 0.55rem 0.7rem 0.55rem 0; border-bottom: 1px solid var(--term-border); }
  .guide__table thead th { font-size: 0.8rem; font-weight: 600; color: var(--term-muted); }
  .guide__table tbody th { color: var(--term-fg); font-weight: 600; }
  .guide__num { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .llm-demo { display: grid; gap: 0.7rem; padding: 16px; border: 1px solid var(--term-border-strong); border-radius: var(--radius-md); background: var(--term-bg-raised); }
  .llm-demo [hidden] { display: none; }
  .llm-demo__label { font-size: 0.86rem; color: var(--term-muted); }
  .llm-demo__input { width: 100%; box-sizing: border-box; resize: vertical; min-height: 4.5rem; padding: 10px 12px; font: inherit; color: var(--term-fg); background: var(--term-bg); border: 1px solid var(--term-border-strong); border-radius: var(--radius-md); }
  .llm-demo__input:focus-visible, .llm-demo button:focus-visible { outline: 2px solid var(--syn-cyan); outline-offset: 2px; }
  .llm-demo__examples { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .llm-demo__examples button { font: inherit; font-size: 0.86rem; color: var(--term-fg); background: transparent; border: 1px solid var(--term-border-strong); border-radius: 999px; padding: 4px 12px; cursor: pointer; }
  .llm-demo__examples button:hover { border-color: var(--syn-cyan); }
  .llm-demo__bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1rem; }
  .llm-demo__run { font: inherit; font-weight: 600; color: var(--term-bg); background: var(--syn-cyan); border: 0; border-radius: var(--radius-md); padding: 8px 16px; cursor: pointer; }
  .llm-demo__run:disabled { opacity: 0.55; cursor: default; }
  .llm-demo__status { font-size: 0.9rem; color: var(--term-muted); min-width: 0; overflow-wrap: anywhere; }
  .llm-demo__out { white-space: pre-wrap; overflow-wrap: anywhere; padding: 12px; border-left: 2px solid var(--syn-cyan); background: var(--term-bg); border-radius: 0 var(--radius-md) var(--radius-md) 0; color: var(--term-fg); }
  .llm-demo__stats { display: flex; flex-wrap: wrap; gap: 0.4rem 1.6rem; margin: 0; font-size: 0.9rem; }
  .llm-demo__stats div { display: grid; }
  .llm-demo__stats dt { color: var(--term-muted); font-size: 0.8rem; }
  .llm-demo__stats dd { margin: 0; color: var(--term-fg); font-variant-numeric: tabular-nums; }
  .llm-demo__share { justify-self: start; font-size: 0.9rem; }
</style>

<script type="module">
const $ = (id) => document.getElementById(id);
const runBtn = $('llm-demo-run');
const input = $('llm-demo-input');
const statusEl = $('llm-demo-status');
const out = $('llm-demo-out');
const stats = $('llm-demo-stats');
const L = JSON.parse($('llm-demo-copy').textContent);
const T = L.text;
const NAMES = { 'b2-2b': 'Ternary Bonsai 2 2B', 'b2-4b': 'Ternary Bonsai 2 4B', 'b2-9b': 'Ternary Bonsai 2 9B', '27b': 'Bonsai 27B', '0.8b': 'Qwen3.5 0.8B', '2b': 'Qwen3.5 2B', '4b': 'Qwen3.5 4B' };
const SYSTEM = 'You are a helpful assistant. Reply briefly in plain text, without markdown, headings or lists.' + (T.reply_lang ? ' ' + T.reply_lang : '');
const shareEl = $('llm-demo-share');
const STAGES = { download: T.p_download, upload: T.p_upload, prefill: T.p_prefill };
const fill = (s, vars) => Object.keys(vars).reduce((acc, k) => acc.split('{' + k + '}').join(vars[k]), s);
const num = (n, digits) => n.toLocaleString(L.lang, { minimumFractionDigits: digits, maximumFractionDigits: digits });
function sizeText(label) {
  const [n, unit] = String(label || '').split(' ');
  const key = unit === 'MB' ? 'fmt_mb' : unit === 'GB' ? 'fmt_gb' : '';
  return key && n ? fill(L[key], { n: n.split('.').join(L.dec) }) : label;
}
function browserName() {
  const brands = navigator.userAgentData && navigator.userAgentData.brands;
  const known = brands && brands.find((b) => /Edge|Opera|Brave|Chrome/.test(b.brand) && !/Not/.test(b.brand) && b.brand !== 'Chromium');
  const os = (navigator.userAgentData && navigator.userAgentData.platform) || ((navigator.userAgent.match(/Android|iPhone|iPad|Mac OS X|Windows|Linux|CrOS/) || [''])[0].replace('Mac OS X', 'macOS').replace('CrOS', 'ChromeOS'));
  let name = known ? known.brand + ' ' + known.version : '';
  if (!name) {
    const ua = navigator.userAgent;
    const m = ua.match(/Firefox\/(\d+)/) || ua.match(/Edg\/(\d+)/) || ua.match(/Chrome\/(\d+)/) || ua.match(/Version\/(\d+[.\d]*).*Safari/);
    name = m ? (/Firefox/.test(m[0]) ? 'Firefox ' : /Edg/.test(m[0]) ? 'Edge ' : /Chrome/.test(m[0]) ? 'Chrome ' : 'Safari ') + m[1] : '';
  }
  return [name, os].filter(Boolean).join(' on ');
}
async function gpuName() {
  try {
    const a = await navigator.gpu.requestAdapter();
    const i = a && (a.info || (a.requestAdapterInfo ? await a.requestAdapterInfo() : null));
    return i ? [i.vendor, i.architecture, i.description].filter(Boolean).join(' ') : '';
  } catch (_) { return ''; }
}
for (const b of document.querySelectorAll('.llm-demo__examples [data-prompt]')) {
  b.addEventListener('click', () => { input.value = b.dataset.prompt; input.focus(); });
}
if (!navigator.gpu) {
  runBtn.disabled = true;
  statusEl.textContent = T.no_webgpu;
} else {
  let Ask = null;
  try {
    Ask = await import('/assets/js/mentria-local-ask.js');
    const info = await Ask.modelInfo();
    statusEl.textContent = info.cached
      ? fill(T.saved, { model: NAMES[info.tier] })
      : fill(T.first, { model: NAMES[info.tier], size: sizeText(info.sizeLabel) });
  } catch (_) {
    statusEl.textContent = '';
  }
  let busy = false;
  runBtn.addEventListener('click', async () => {
    const prompt = input.value.trim();
    if (!prompt || busy || !Ask) return;
    busy = true;
    runBtn.disabled = true;
    out.hidden = true;
    out.textContent = '';
    stats.hidden = true;
    shareEl.hidden = true;
    statusEl.textContent = T.starting;
    const onEvent = (e) => {
      const d = e.detail || {};
      if (d.phase !== 'progress') return;
      const label = STAGES[d.stage] || T.starting;
      statusEl.textContent = d.pct != null && (d.stage === 'download' || d.stage === 'upload') ? label + ' ' + fill(T.pct, { n: num(d.pct, 0) }) : label;
    };
    window.addEventListener('mentria:localask', onEvent);
    const loadedBefore = !!(Ask.debugState && Ask.debugState().loaded);
    const tStart = performance.now();
    let tFirst = 0;
    let tLast = 0;
    let tokens = 0;
    try {
      await Ask.askLocal(SYSTEM, prompt, {
        source: 'guide',
        noOffer: true,
        maxTokens: 200,
        onToken: (_, all) => {
          const now = performance.now();
          if (!tFirst) { tFirst = now; statusEl.textContent = T.writing; out.hidden = false; }
          tLast = now;
          tokens += 1;
          out.textContent = all;
        }
      });
      const info = await Ask.modelInfo().catch(() => null);
      const model = info ? NAMES[info.tier] : '';
      const ttft = tFirst ? (tFirst - tStart) / 1000 : 0;
      const tps = tokens > 1 && tLast > tFirst ? Math.round((tokens - 1) / ((tLast - tFirst) / 1000)) : 0;
      $('llm-demo-model').textContent = model;
      $('llm-demo-ttft-label').textContent = loadedBefore ? T.stat_ttft : T.stat_ttft_cold;
      $('llm-demo-ttft').textContent = ttft ? fill(L.fmt_s, { n: num(ttft, 1) }) : '';
      $('llm-demo-speed').textContent = tps ? fill(L.fmt_tps, { n: num(tps, 0) }) : '';
      stats.hidden = false;
      statusEl.textContent = T.done;
      if (tps) {
        const speed = tps + ' tokens/s';
        const lines = ['**Model:** ' + model, '**Speed:** ' + speed];
        if (loadedBefore) lines.push('**First word after:** ' + ttft.toFixed(1) + ' s');
        const browser = browserName();
        if (browser) lines.push('**Browser:** ' + browser);
        const gpu = await gpuName();
        if (gpu) lines.push('**GPU:** ' + gpu);
        lines.push('**Device:** (add your device, for example: MacBook Air M2, 16 GB)', '', 'Measured with the demo on https://mentria.ai/guides/run-llm-in-browser/');
        shareEl.href = 'https://github.com/mentria-ai/website/discussions/new?category=show-and-tell&title=' + encodeURIComponent('Benchmark: ' + model + ' at ' + speed) + '&body=' + encodeURIComponent(lines.join('\n'));
        shareEl.hidden = false;
      }
    } catch (e) {
      const msg = (e && e.message) || '';
      statusEl.textContent = msg === 'download-postponed' ? T.postponed : fill(T.failed, { msg: msg.slice(0, 120) });
    } finally {
      window.removeEventListener('mentria:localask', onEvent);
      busy = false;
      runBtn.disabled = false;
    }
  });
}
</script>
