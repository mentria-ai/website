<!DOCTYPE html>
<html lang="{{ lang or 'en' }}" class="ext-app">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    {% include "site/csp.njk" %}
    {%- if usesThree %}
    {% include "site/importmap.njk" %}
    {%- endif %}
    <meta name="robots" content="noindex, nofollow">
    <title>{{ title }}</title>
    <link rel="icon" href="/assets/img/favicon-96x96.png" type="image/png">
    <link rel="apple-touch-icon" href="/assets/img/icon-192x192.png">
    <link rel="stylesheet" href="/assets/css/style.css?v={{ buildHash }}">
    <link rel="stylesheet" href="/assets/css/terminal.css?v={{ buildHash }}">
    <script src="/assets/js/mentria-store.js?v={{ buildHash }}"></script>
    {%- if not appPlain %}
    <script src="/assets/js/mentria-gamepad.js?v={{ buildHash }}" defer></script>
    <script src="/assets/js/mentria-input-help.js?v={{ buildHash }}" defer></script>
    {%- endif %}
    <style>
      html.ext-app, html.ext-app body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #04060a; }
      html.ext-app body::before, html.ext-app body::after { content: none; display: none; }
    </style>
</head>
<body>
{{ content | safe }}
</body>
</html>
