</section>

<div class="ph-wrap">
  <div class="ph-stage" id="ph-stage">
    <canvas class="ph-canvas" id="ph-canvas"></canvas>

    <div class="ph-hud" id="ph-hud" hidden>
      <div class="ph-hud__tl">
        <div class="ph-stat">
          <span class="ph-stat__k">{{ "tool.phosphor.hud_time" | t }}</span>
          <span class="ph-stat__v" id="ph-time">0:00.000</span>
        </div>
        <div class="ph-stat">
          <span class="ph-stat__k">{{ "tool.phosphor.hud_targets" | t }}</span>
          <span class="ph-stat__v" id="ph-targets">0/0</span>
        </div>
        <div class="ph-stat">
          <span class="ph-stat__k">{{ "tool.phosphor.hud_par" | t }}</span>
          <span class="ph-stat__v ph-stat__v--sub" id="ph-hud-par">—</span>
        </div>
      </div>

      <div class="ph-hud__tr">
        <span class="ph-chip" id="ph-method"></span>
        <span class="ph-chip"><span class="ph-stat__k">{{ "tool.phosphor.hud_fps" | t }}</span> <span id="ph-fps">--</span></span>
        <button type="button" class="ph-btn ph-btn--icon" id="ph-fs" aria-label="{{ 'tool.phosphor.fullscreen' | t }}" title="{{ 'tool.phosphor.fullscreen' | t }}" hidden>⛶</button>
        <button type="button" class="ph-btn ph-btn--icon" id="ph-pausebtn" aria-label="{{ 'tool.phosphor.hud_pause' | t }}" title="{{ 'tool.phosphor.hud_pause' | t }}">‖</button>
      </div>

      <div class="ph-hud__bl">
