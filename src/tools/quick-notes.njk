---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/tools/quick-notes/index.html"
eleventyComputed:
  lang: "{{ locale.code }}"
  title: "{{ 'tools.quick-notes.title' | t }}"
  description: "{{ 'tools.quick-notes.lede' | t }}"
localeReload: true
unlockTool: true
---
<section class="hero" style="padding-top:1rem;">
  <p class="eyebrow eyebrow--crumbs"><a class="eyebrow__link" href="{{ locale.pathPrefix }}/" aria-label="{{ 'nav.home' | t }}">~</a><span class="eyebrow__sep">/</span><a class="eyebrow__link" href="{{ locale.pathPrefix }}/tools/">tools</a><span class="eyebrow__sep">/</span><span class="eyebrow__current">quick-notes</span></p>
  <h1>{{ "tools.quick-notes.title" | t }}</h1>
  <p>{{ "tools.quick-notes.lede" | t }}</p>
  {% include "tldr.njk" %}
</section>

{% set terminalTitle = "quick-notes.js" %}
{% include "terminal-frame-open.njk" %}
<section class="qn-tool" id="qn-tool">
  <aside class="qn-sidebar" id="qn-sidebar">
    <div class="qn-sidebar__header">
      <span class="qn-sidebar__label">{{ "tool.quick-notes.notes_label" | t }}</span>
      <button class="qn-sidebar__toggle" id="qn-sidebar-toggle" title="{{ 'tool.quick-notes.toggle_sidebar' | t }}" aria-label="{{ 'tool.quick-notes.toggle_sidebar' | t }}">
        <span class="qn-sidebar__toggle-icon"></span>
      </button>
    </div>
    <div class="qn-sidebar__list" id="qn-note-list">
    </div>
    <button class="qn-sidebar__new" id="qn-new-btn" title="{{ 'tool.quick-notes.new_note_title' | t }}">
      <span>+</span> {{ "tool.quick-notes.new_note_btn" | t }}
    </button>
    <button type="button" class="qn-sidebar__export" id="qn-export-all-btn" title="{{ 'tool.quick-notes.export_all_title' | t }}">{{ "tool.quick-notes.export_all_btn" | t }}</button>
  </aside>

  <div class="qn-editor" id="qn-editor">
    <div class="qn-editor__titlebar">
      <input
        type="text"
        class="qn-editor__title"
        id="qn-title-input"
        placeholder="{{ 'tool.quick-notes.untitled' | t }}"
        spellcheck="false"
        autocomplete="off"
      />
      <div class="qn-editor__actions">
        <button class="qn-action-btn m-btn m-btn--ghost" id="qn-export-btn" title="{{ 'tool.quick-notes.export_title' | t }}">{{ "tool.quick-notes.export_btn" | t }}</button>
        <button class="qn-action-btn m-btn m-btn--ghost" id="qn-share-btn" title="{{ 'common.share' | t }}">{{ "common.share" | t }}</button>
        <button class="qn-action-btn m-btn m-btn--ghost" id="qn-mdpdf-btn" title="{{ 'tool.quick-notes.to_mdpdf_title' | t }}">{{ "tool.quick-notes.to_mdpdf_btn" | t }}</button>
        <button class="qn-action-btn m-btn m-btn--ghost" id="qn-lock-btn" title="{{ 'tool.quick-notes.lock_title' | t }}">{{ "tool.quick-notes.lock_btn" | t }}</button>
        <button class="qn-action-btn m-btn m-btn--ghost" id="qn-remove-lock-btn" title="{{ 'tool.quick-notes.remove_lock_btn' | t }}" hidden>{{ "tool.quick-notes.remove_lock_btn" | t }}</button>
        <button class="qn-action-btn m-btn m-btn--danger" id="qn-delete-btn" title="{{ 'tool.quick-notes.delete_title' | t }}">{{ "tool.quick-notes.delete_btn" | t }}</button>
      </div>
    </div>
    <p class="qn-unsaved" id="qn-unsaved" role="status" aria-live="polite" hidden>
      <span data-unsaved="blocked" hidden>{{ "tool.quick-notes.unsaved_blocked" | t }}</span>
      <span data-unsaved="full" hidden>{{ "tool.quick-notes.unsaved_full" | t }}</span>
    </p>
    <p class="qn-convert" id="qn-convert" role="status" aria-live="polite" hidden></p>
    <p class="qn-readonly" id="qn-readonly" role="status" aria-live="polite" hidden>{{ "tool.quick-notes.read_only_old" | t }}</p>
    <textarea
      class="qn-editor__textarea"
      id="qn-textarea"
      placeholder="{{ 'tool.quick-notes.start_typing' | t }}"
      spellcheck="false"
    ></textarea>
    <div class="qn-locked" id="qn-locked" hidden>
      <svg class="qn-locked__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="4" y="11" width="16" height="10" rx="2"/>
        <path d="M8 11V7a4 4 0 0 1 8 0v4"/>
      </svg>
      <h2 class="qn-locked__heading">{{ "tool.quick-notes.locked_heading" | t }}</h2>
      <p class="qn-locked__body" id="qn-locked-body">{{ "tool.quick-notes.locked_body" | t }}</p>
      <p class="qn-locked__body qn-locked__note" id="qn-locked-note" hidden></p>
      <div class="qn-locked__link" id="qn-locked-link" hidden>
        <p class="qn-locked__link-title">{{ "unlock.link_title" | t }}</p>
        <p class="qn-locked__link-body">{{ "unlock.link_body" | t }}</p>
      </div>
      <button class="qn-unlock-btn m-btn m-btn--primary m-btn--pill" id="qn-unlock-btn">{{ "tool.quick-notes.unlock_btn" | t }}</button>
      <div class="qn-locked__card" id="qn-locked-card" hidden>
        <div id="qn-locked-card-slot"></div>
        <button type="button" class="qn-card-later m-btn m-btn--ghost" id="qn-card-later" hidden>{{ "unlock.not_now" | t }}</button>
      </div>
    </div>
    <div class="qn-print" id="qn-print" aria-hidden="true"></div>
    <div class="qn-editor__statusbar">
      <span class="qn-status__counts" id="qn-counts">{{ ('tool.quick-notes.count_summary' | t) | replace('{words}', '0') | replace('{chars}', '0') }}</span>
      <span class="qn-status__saved" id="qn-saved"></span>
    </div>
  </div>
</section>
{% include "terminal-frame-close.njk" %}

{% include "tool-schema.njk" %}

<script>
(() => {
  const COPY = {
    untitled:          {{ ("tool.quick-notes.untitled"           | t) | dump | safe }},
    exportAllSkipped:  {{ ("tool.quick-notes.export_all_skipped" | t) | dump | safe }},
    savedPrefix:       {{ ("tool.quick-notes.saved_prefix"       | t) | dump | safe }},
    emptyPreview:      {{ ("tool.quick-notes.empty_preview"      | t) | dump | safe }},
    confirmDelete:     {{ ("tool.quick-notes.confirm_delete"     | t) | dump | safe }},
    linkConfirm:       {{ ("tool.quick-notes.link_confirm"       | t) | dump | safe }},
    noteDeleted:       {{ ("tool.quick-notes.note_deleted"       | t) | dump | safe }},
    lockBtn:           {{ ("tool.quick-notes.lock_btn"           | t) | dump | safe }},
    removeLockBtn:     {{ ("tool.quick-notes.remove_lock_btn"    | t) | dump | safe }},
    lockedTag:         {{ ("tool.quick-notes.locked_tag"         | t) | dump | safe }},
    confirmLock:       {{ ("tool.quick-notes.confirm_lock"       | t) | dump | safe }},
    confirmRemoveLock: {{ ("tool.quick-notes.confirm_remove_lock" | t) | dump | safe }},
    lockFailed:        {{ ("tool.quick-notes.lock_failed"        | t) | dump | safe }},
    unlockFailed:      {{ ("tool.quick-notes.unlock_failed"      | t) | dump | safe }},
    prfUnsupported:    {{ ("tool.quick-notes.prf_unsupported"    | t) | dump | safe }},
    countSummary:      {{ ("tool.quick-notes.count_summary"      | t) | dump | safe }},
    toMdpdfFailed:     {{ ("tool.quick-notes.to_mdpdf_failed"    | t) | dump | safe }},
    lockTitleOne:      {{ ("tool.quick-notes.lock_title_one"     | t) | dump | safe }},
    relockTitle:       {{ ("tool.quick-notes.relock_title"       | t) | dump | safe }},
    confirmLockOne:    {{ ("tool.quick-notes.confirm_lock_one"   | t) | dump | safe }},
    lockFailedOne:     {{ ("tool.quick-notes.lock_failed_one"    | t) | dump | safe }},
    keyMissing:        {{ ("tool.quick-notes.key_missing"        | t) | dump | safe }},
    lockKeyMissing:    {{ ("tool.quick-notes.lock_key_missing"   | t) | dump | safe }},
    relockOldTitle:    {{ ("tool.quick-notes.relock_old_title"   | t) | dump | safe }},
    oneOff:            {{ ("tool.quick-notes.one_unlock_off"     | t) | dump | safe }},
    convertSkipped:    {{ ("tool.quick-notes.convert_skipped"    | t) | dump | safe }}
  };

  const STORAGE_KEY = 'mentria-quick-notes';
  const DEBOUNCE_MS = 500;

  const noteList    = document.getElementById('qn-note-list');
  const newBtn      = document.getElementById('qn-new-btn');
  const titleInput  = document.getElementById('qn-title-input');
  const textarea    = document.getElementById('qn-textarea');
  const countsEl    = document.getElementById('qn-counts');
  const savedEl     = document.getElementById('qn-saved');
  const unsavedEl   = document.getElementById('qn-unsaved');
  const exportBtn   = document.getElementById('qn-export-btn');
  const shareBtn    = document.getElementById('qn-share-btn');
  const MDPDF_URL = {{ ("/tools/markdown-pdf/" | localeUrl(lang)) | dump | safe }};
  const mdpdfBtn    = document.getElementById('qn-mdpdf-btn');
  const lockBtn     = document.getElementById('qn-lock-btn');
  const deleteBtn   = document.getElementById('qn-delete-btn');
  const lockedPanel = document.getElementById('qn-locked');
  const unlockBtn   = document.getElementById('qn-unlock-btn');
  const sidebar     = document.getElementById('qn-sidebar');
  const sidebarToggle = document.getElementById('qn-sidebar-toggle');
  const toolEl      = document.getElementById('qn-tool');
  const removeLockBtn = document.getElementById('qn-remove-lock-btn');
  const convertEl   = document.getElementById('qn-convert');
  const readOnlyEl  = document.getElementById('qn-readonly');
  const lockedBody  = document.getElementById('qn-locked-body');
  const lockedNote  = document.getElementById('qn-locked-note');
  const linkBox     = document.getElementById('qn-locked-link');
  const cardBox     = document.getElementById('qn-locked-card');
  const cardSlot    = document.getElementById('qn-locked-card-slot');
  const cardLater   = document.getElementById('qn-card-later');
  const printEl     = document.getElementById('qn-print');

  let notes = [];
  let activeId = null;

  const CRED_KEY = 'mentria-qn-cred';
  const SALT_KEY = 'mentria-qn-salt';
  const PAIR_KEY = 'mentria.qn.pair';
  const USED_KEY = 'mentria.qn.used';
  let sessionKeys = null;
  const opened = new Map();
  const cryptoOK = !!(window.PublicKeyCredential && window.isSecureContext && window.crypto && crypto.subtle);

  const BETA = document.documentElement.dataset.release === 'beta';
  const TRY_ONE = BETA && (() => {
    try {
      const l = JSON.parse(localStorage.getItem('mentria.keyring.local') || 'null');
      return !!l && l.enabled === true;
    } catch (_) {
      return false;
    }
  })();
  const UNLOCK_JS = '/assets/js/mentria-unlock.js';
  const UNLOCK_UI_JS = '/assets/js/mentria-unlock-ui.js';
  const oneOK = !!(window.isSecureContext && window.crypto && crypto.subtle);
  let U = null;
  let uiP = null;
  let one = false;
  let oneSettled = !TRY_ONE;
  let oneReady = Promise.resolve();
  let notesKeys = [];
  let ringSig = '';
  let linkPending = false;
  let card = null;
  let cardP = null;
  let cardFocus = false;
  let panelView = 'old';
  let renderSeq = 0;
  let openChain = Promise.resolve();
  let retiring = false;
  let wasUnlocked = false;
  const skipped = new Set();
  const skippedKv = new Set();
  const curOk = new Set();

  let autoBlank = null;

  function load() {
    const v = MentriaUI.migrateStore('quick_notes', 'blob', STORAGE_KEY, null);
    if (Array.isArray(v)) notes = v;
    if (!Array.isArray(notes) || notes.length === 0) {
      notes = [];
      const waiting = window.MentriaStore && MentriaStore.get('quick_notes', 'inbox');
      if (!(Array.isArray(waiting) && waiting.length)) autoBlank = createNote().id;
    }
  }

  function dropAutoBlank() {
    if (!autoBlank) return;
    const id = autoBlank;
    autoBlank = null;
    const n = notes.find((x) => x.id === id);
    if (!n || n.enc || n.title || n.body) return;
    if (id === activeId && (titleInput.value || textarea.value)) return;
    notes = notes.filter((x) => x.id !== id);
  }

  let persistingSelf = false;
  let unsavedWhy = null;

  function storageTrouble() {
    const S = window.MentriaStore;
    if (S && typeof S.status === 'function') {
      try {
        const s = S.status();
        if (s === 'ok') return null;
        if (s === 'blocked' || s === 'full') return s;
      } catch (_) {}
    }
    try { window.localStorage.getItem(STORAGE_KEY); return null; } catch (_) { return 'blocked'; }
  }

  function showUnsaved(why) {
    const was = unsavedWhy;
    unsavedWhy = why || null;
    if (unsavedWhy === was) return;
    unsavedEl.hidden = !unsavedWhy;
    unsavedEl.querySelectorAll('[data-unsaved]').forEach((s) => { s.hidden = s.dataset.unsaved !== unsavedWhy; });
    if (unsavedWhy) savedEl.textContent = '';
    else if (was) {
      const note = getNote(activeId);
      updateSavedLabel(note && note.updatedAt);
    }
  }

  function persist() {
    persistingSelf = true;
    let ok = false;
    try {
      if (window.MentriaStore) ok = window.MentriaStore.set('quick_notes', 'blob', notes);
      else {
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(notes)); ok = true; } catch (_) {}
      }
    } finally {
      persistingSelf = false;
    }
    showUnsaved(ok ? null : (storageTrouble() === 'blocked' ? 'blocked' : 'full'));
    return ok;
  }

  function reconcileExternal() {
    const S = window.MentriaStore;
    if (!S) return;
    const ext = S.get('quick_notes', 'blob');
    if (!Array.isArray(ext)) return;
    const del = S.get('quick_notes', 'deleted');
    const deleted = (del && typeof del === 'object') ? del : {};
    const byId = new Map(notes.map(n => [n.id, n]));
    const editing = saver.pending();
    let changed = false;
    let activeChanged = false;
    for (const e of ext) {
      if (!e || !e.id || typeof e.body !== 'string') continue;
      if (deleted[String(e.id)] && e.id !== activeId) continue;
      const l = byId.get(e.id);
      if (!l) { byId.set(e.id, e); changed = true; }
      else if ((e.updatedAt || 0) > (l.updatedAt || 0) && (e.id !== activeId || !editing)) {
        byId.set(e.id, e);
        changed = true;
        if (e.id === activeId) activeChanged = true;
      }
    }
    for (const n of [...byId.values()]) {
      if (deleted[String(n.id)] && n.id !== activeId) { byId.delete(n.id); changed = true; }
    }
    if (!changed) return;
    notes = [...byId.values()].sort((a, b) => (b.updatedAt || 0) - (a.updatedAt || 0));
    if (activeId && !notes.some(n => n.id === activeId)) {
      if (notes.length) selectNote(notes[0].id);
      else createNote();
    } else if (activeChanged) {
      const focused = document.activeElement === textarea;
      const start = textarea.selectionStart, end = textarea.selectionEnd;
      Promise.resolve(renderEditor()).then(() => {
        if (!focused) return;
        const len = textarea.value.length;
        textarea.setSelectionRange(Math.min(start, len), Math.min(end, len));
      });
    }
    renderList();
    if (one && notesKeys.length) openNotes();
  }

  function acceptExternalDelete() {
    notes = [];
    activeId = null;
    createNote();
  }

  function b64enc(buf) {
    const bytes = new Uint8Array(buf);
    let s = '';
    for (let i = 0; i < bytes.length; i++) s += String.fromCharCode(bytes[i]);
    return btoa(s);
  }
  function b64dec(str) {
    const bin = atob(str);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return bytes;
  }

  function prfSalt() {
    const S = window.MentriaStore;
    const have = S ? S.get('quick_notes', 'salt') : null;
    if (have) return String(have);
    const legacy = localStorage.getItem(SALT_KEY);
    if (legacy) {
      if (S && S.set('quick_notes', 'salt', legacy)) localStorage.removeItem(SALT_KEY);
      return legacy;
    }
    const s = b64enc(crypto.getRandomValues(new Uint8Array(32)));
    if (S) S.set('quick_notes', 'salt', s);
    else localStorage.setItem(SALT_KEY, s);
    return s;
  }

  function storedPair() {
    const S = window.MentriaStore;
    let salt = S ? S.get('quick_notes', 'salt') : null;
    let cred = S ? S.get('quick_notes', 'cred_id') : null;
    try {
      if (!salt) salt = localStorage.getItem(SALT_KEY);
      if (!cred) cred = localStorage.getItem(CRED_KEY);
    } catch (_) {}
    return { salt: salt ? String(salt) : null, cred: cred ? String(cred) : null };
  }

  function fullPair(p) {
    return !!p && typeof p.salt === 'string' && !!p.salt && typeof p.cred === 'string' && !!p.cred;
  }

  function samePair(a, b) {
    return fullPair(a) && fullPair(b) && a.salt === b.salt && a.cred === b.cred;
  }

  function ownPair(note) {
    if (!note || typeof note.salt !== 'string' || !note.salt || typeof note.credId !== 'string' || !note.credId) return null;
    return { salt: note.salt, cred: note.credId };
  }

  function devicePair() {
    try {
      const p = JSON.parse(localStorage.getItem(PAIR_KEY) || 'null');
      if (p && typeof p.salt === 'string' && p.salt && typeof p.credId === 'string' && p.credId) return { salt: p.salt, cred: p.credId };
    } catch (_) {}
    return null;
  }

  function keepDevicePair(p) {
    if (!fullPair(p) || devicePair()) return;
    try { localStorage.setItem(PAIR_KEY, JSON.stringify({ salt: p.salt, credId: p.cred })); } catch (_) {}
  }

  function usedIds() {
    try {
      const v = JSON.parse(localStorage.getItem(USED_KEY) || '[]');
      return Array.isArray(v) ? v.filter((x) => typeof x === 'string' && x) : [];
    } catch (_) {
      return [];
    }
  }

  function noteUsed(ids) {
    const have = usedIds();
    const add = ids.filter((id, i) => typeof id === 'string' && id && !have.includes(id) && ids.indexOf(id) === i);
    if (!add.length) return;
    try { localStorage.setItem(USED_KEY, JSON.stringify(have.concat(add))); } catch (_) {}
  }

  function pairOf(note) {
    return opened.get(noteSig(note)) || ownPair(note) || storedPair();
  }

  function keyIn(keys, pair) {
    return keys && fullPair(pair) ? keys.get(pair.salt + '|' + pair.cred) || null : null;
  }

  function oldKeysHeld() {
    return !!sessionKeys && sessionKeys.size > 0;
  }

  function setPair(n, k) {
    if (k) {
      n.salt = k.salt;
      n.credId = k.cred;
    } else {
      delete n.salt;
      delete n.credId;
    }
  }

  async function holdKey(raw, pair) {
    const key = await crypto.subtle.importKey(
      'raw', new Uint8Array(raw), { name: 'AES-GCM' }, false, ['encrypt', 'decrypt']
    );
    const got = { key: key, salt: pair.salt, cred: pair.cred };
    sessionKeys = new Map(sessionKeys || []).set(pair.salt + '|' + pair.cred, got);
    keepDevicePair(got);
    return got;
  }

  async function keyFor(pair) {
    const held = keyIn(sessionKeys, pair);
    if (held) return held;
    if (!cryptoOK) throw new Error('prf-unsupported');
    const assertion = await navigator.credentials.get({
      publicKey: {
        challenge: crypto.getRandomValues(new Uint8Array(32)),
        allowCredentials: [{ type: 'public-key', id: b64dec(pair.cred) }],
        userVerification: 'required',
        extensions: { prf: { eval: { first: b64dec(pair.salt) } } }
      }
    });
    if (!assertion) throw new Error('cancelled');
    const prf = assertion.getClientExtensionResults().prf;
    if (!prf || !prf.results || !prf.results.first) throw new Error('prf-unsupported');
    return holdKey(prf.results.first, pair);
  }

  async function ensureKey() {
    const held = keyIn(sessionKeys, storedPair());
    if (held) return held;
    if (!cryptoOK) throw new Error('prf-unsupported');
    const saltB64 = prfSalt();
    let credId = window.MentriaStore ? window.MentriaStore.get('quick_notes', 'cred_id') : null;
    if (!credId) {
      const legacy = localStorage.getItem(CRED_KEY);
      if (legacy) {
        credId = legacy;
        if (window.MentriaStore) { window.MentriaStore.set('quick_notes', 'cred_id', credId); localStorage.removeItem(CRED_KEY); }
      }
    }
    if (credId) return keyFor({ salt: saltB64, cred: String(credId) });
    const cred = await navigator.credentials.create({
      publicKey: {
        challenge: crypto.getRandomValues(new Uint8Array(32)),
        rp: { name: 'Mentria Quick Notes' },
        user: {
          id: crypto.getRandomValues(new Uint8Array(16)),
          name: 'quick-notes',
          displayName: 'Quick Notes'
        },
        pubKeyCredParams: [{ type: 'public-key', alg: -7 }, { type: 'public-key', alg: -257 }],
        authenticatorSelection: { residentKey: 'required', userVerification: 'required' },
        extensions: { prf: { eval: { first: b64dec(saltB64) } } }
      }
    });
    if (!cred) throw new Error('cancelled');
    const prf = cred.getClientExtensionResults().prf;
    if (!prf || prf.enabled === false) throw new Error('prf-unsupported');
    credId = b64enc(cred.rawId);
    if (window.MentriaStore) window.MentriaStore.set('quick_notes', 'cred_id', credId);
    else localStorage.setItem(CRED_KEY, credId);
    const pair = { salt: saltB64, cred: credId };
    if (prf.results && prf.results.first) return holdKey(prf.results.first, pair);
    return keyFor(pair);
  }

  async function lockKey() {
    const st = storedPair();
    const dev = devicePair();
    const held = keyIn(sessionKeys, st) || keyIn(sessionKeys, dev);
    if (held) return held;
    if (sessionKeys && sessionKeys.size) return [...sessionKeys.values()].pop();
    if (dev && !samePair(dev, st)) return keyFor(dev);
    return ensureKey();
  }

  async function sealOld(note, text) {
    const k = keyIn(sessionKeys, pairOf(note));
    if (!k) throw new Error('locked');
    const sealed = await sealLegacy(k.key, text);
    sealed.pair = k;
    return sealed;
  }

  async function openOld(keys, note) {
    if (!keys) throw new Error('locked');
    const tried = new Set();
    const order = [opened.get(noteSig(note)), ownPair(note), storedPair(), devicePair()].map((p) => keyIn(keys, p)).concat([...keys.values()]);
    for (const k of order) {
      if (!k || tried.has(k)) continue;
      tried.add(k);
      let text;
      try { text = await openLegacy(k.key, note); } catch (_) { continue; }
      opened.set(noteSig(note), { salt: k.salt, cred: k.cred });
      return { text: text, k: k };
    }
    throw new Error('locked');
  }

  function notePair(note, k) {
    const cur = getNote(note.id);
    if (!cur || !isLegacyLocked(cur) || noteSig(cur) !== noteSig(note) || samePair(ownPair(cur), k)) return;
    setPair(cur, k);
    cur.updatedAt = (Number(cur.updatedAt) || 0) + 1;
    persist();
  }

  async function decryptNote(note) {
    const got = await openOld(sessionKeys, note);
    if (oneSettled && !one) notePair(note, got.k);
    return got.text;
  }

  async function promptOpen(note) {
    const own = ownPair(note);
    const list = [];
    for (const p of own ? [own, storedPair()] : [storedPair(), devicePair()]) {
      if (fullPair(p) && !list.some((q) => samePair(q, p))) list.push(p);
    }
    if (!list.length) throw new Error('no-legacy');
    for (let i = 0; i < list.length; i++) {
      let k;
      try {
        k = await keyFor(list[i]);
      } catch (err) {
        if (i < list.length - 1 && err && err.name === 'NotAllowedError') continue;
        throw err;
      }
      try {
        await openLegacy(k.key, note);
        opened.set(noteSig(note), { salt: k.salt, cred: k.cred });
        return;
      } catch (_) {}
    }
  }

  function handleCryptoError(err, fallbackMsg) {
    if (err && err.name === 'NotAllowedError') return;
    if (err && err.message === 'prf-unsupported') { mentriaAlert(COPY.prfUnsupported); return; }
    if (err && err.message === 'cancelled') return;
    mentriaAlert(fallbackMsg);
  }

  function noteSig(n) { return n.id + '|' + (n.iv || ''); }
  function isLegacyLocked(n) { return !!n && !!n.enc && !n.kv; }
  function hasKv2() { return notes.some((n) => !!n && !!n.enc && n.kv === 2); }
  function noteAad(id) { return new TextEncoder().encode('mentria-notes|v2|' + id); }

  async function sealV2(key, id, text) {
    const iv = crypto.getRandomValues(new Uint8Array(12));
    const ct = await crypto.subtle.encrypt({ name: 'AES-GCM', iv: iv, additionalData: noteAad(id) }, key, new TextEncoder().encode(text));
    return { body: b64enc(ct), iv: b64enc(iv) };
  }

  async function openV2(key, note) {
    const pt = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: b64dec(note.iv), additionalData: noteAad(note.id) }, key, b64dec(note.body));
    return new TextDecoder().decode(pt);
  }

  async function sealLegacy(key, text) {
    const iv = crypto.getRandomValues(new Uint8Array(12));
    const ct = await crypto.subtle.encrypt({ name: 'AES-GCM', iv: iv }, key, new TextEncoder().encode(text));
    return { body: b64enc(ct), iv: b64enc(iv) };
  }

  async function openLegacy(key, note) {
    const pt = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: b64dec(note.iv) }, key, b64dec(note.body));
    return new TextDecoder().decode(pt);
  }

  function curKey() { return notesKeys.length ? notesKeys[0] : null; }

  function notesLinked() {
    try { return !!U && U.state().linked.includes('notes'); } catch (_) { return true; }
  }

  function oldReadOnly(note) {
    return one && isLegacyLocked(note) && !notesKeys.length && notesLinked();
  }

  function ringFor(note, ring) {
    if (!note.kid) return ring;
    return ring.filter((k) => k.id === note.kid).concat(ring.filter((k) => k.id !== note.kid));
  }

  async function openKv2(note) {
    const ring = notesKeys;
    for (const k of ringFor(note, ring)) {
      try { return { text: await openV2(k.key, note), current: k === ring[0] }; } catch (_) {}
    }
    return null;
  }

  async function sealCur(id, text) {
    const c = curKey();
    if (!c) throw new Error('locked');
    const sealed = await sealV2(c.key, id, text);
    sealed.kid = c.id;
    return sealed;
  }

  function setKid(n, kid) {
    if (kid) n.kid = kid;
    else delete n.kid;
  }

  async function decryptOne(note) {
    if (note.kv === 2) {
      if (!U || !U.state().unlocked || !notesKeys.length) throw new Error('locked');
      const got = await openKv2(note);
      if (!got || !U.state().unlocked) throw new Error('locked');
      return got.text;
    }
    if (note.kv) throw new Error('locked');
    return decryptNote(note);
  }

  function loadUI() {
    if (!uiP) uiP = import(UNLOCK_UI_JS).catch((e) => { uiP = null; throw e; });
    return uiP;
  }

  function linkNotesKey() {
    const run = async () => {
      const have = await U.secrets('notes');
      if (have.length) return have;
      const fresh = crypto.getRandomValues(new Uint8Array(32));
      try { await U.link('notes', fresh); } finally { fresh.fill(0); }
      return U.secrets('notes');
    };
    if (navigator.locks && typeof navigator.locks.request === 'function') return navigator.locks.request('mentria-notes-key', run);
    return run();
  }

  async function ensureNotesKey(allowLink) {
    let list = [];
    try { list = await U.secrets('notes'); } catch (_) { notesKeys = []; return false; }
    if (!list.length && allowLink) list = await linkNotesKey();
    const ring = [];
    try {
      for (const x of list) ring.push({ id: typeof x.id === 'string' && x.id ? x.id : null, key: await crypto.subtle.importKey('raw', x.bytes, { name: 'AES-GCM' }, false, ['encrypt', 'decrypt']) });
    } finally {
      for (const x of list) x.bytes.fill(0);
    }
    const sig = ring.map((k) => String(k.id)).join(',');
    if (sig !== ringSig) {
      ringSig = sig;
      skippedKv.clear();
      curOk.clear();
    } else if (notesKeys.length === ring.length && ring.length && ring.every((k) => k.id)) {
      return true;
    }
    notesKeys = ring;
    return ring.length > 0;
  }

  function lockView(note) {
    const s = U.state();
    if (note.kv === 2) {
      if (notesKeys.length && s.unlocked) return 'open';
      return !s.unlocked && s.setUp ? 'card' : 'missing';
    }
    if (note.kv) return 'missing';
    if (linkPending && s.setUp && !s.unlocked) return 'card';
    if (oldKeysHeld() && !skipped.has(noteSig(note))) return 'open';
    return 'legacy';
  }

  function underCurrent(n, cur) {
    return !!cur && ((!!cur.id && n.kid === cur.id) || curOk.has(noteSig(n)));
  }

  function forgetLegacy(legacyKeys) {
    if (legacyKeys && sessionKeys === legacyKeys && notes.every((n) => !isLegacyLocked(n) || skipped.has(noteSig(n)))) sessionKeys = null;
  }

  async function convertNotes() {
    const ring = notesKeys;
    const cur = ring[0];
    if (!cur) return false;
    const legacyKeys = sessionKeys;
    const wants = (n) => {
      if (!n || !n.enc) return false;
      const sig = noteSig(n);
      if (!n.kv) return !!legacyKeys && !skipped.has(sig);
      return n.kv === 2 && !underCurrent(n, cur) && !skippedKv.has(sig);
    };
    if (notes.some(wants)) {
      try { await saver.flush(); } catch (_) {}
    }
    for (let pass = 0; pass < 3; pass++) {
      if (notesKeys !== ring || sessionKeys !== legacyKeys) return false;
      const todo = notes.filter(wants);
      if (!todo.length) break;
      const done = new Map();
      for (const n of todo) {
        const sig = noteSig(n);
        let text;
        let cred = null;
        if (isLegacyLocked(n)) {
          let got;
          try { got = await openOld(legacyKeys, n); } catch (_) { skipped.add(sig); continue; }
          text = got.text;
          cred = got.k.cred;
        } else {
          const got = await openKv2(n);
          if (!got) { skippedKv.add(sig); continue; }
          if (got.current && !cur.id) { curOk.add(sig); continue; }
          text = got.text;
        }
        done.set(n.id, { sig: sig, cred: cred, sealed: await sealV2(cur.key, n.id, text) });
      }
      if (!done.size) break;
      if (!U.state().unlocked || notesKeys !== ring || sessionKeys !== legacyKeys) return false;
      const prev = notes;
      const used = [];
      notes = notes.map((n) => {
        const d = n && done.get(n.id);
        if (!d || !n.enc || noteSig(n) !== d.sig) return n;
        if (d.cred) used.push(d.cred);
        const out = Object.assign({}, n, { body: d.sealed.body, iv: d.sealed.iv, kv: 2, updatedAt: (Number(n.updatedAt) || 0) + 1 });
        setKid(out, cur.id);
        setPair(out, null);
        return out;
      });
      if (!persist()) { notes = prev; return false; }
      noteUsed(used);
    }
    forgetLegacy(legacyKeys);
    return true;
  }

  function signalRetired(ids) {
    const P = window.PublicKeyCredential;
    if (!P || typeof P.signalUnknownCredential !== 'function') return;
    for (const id of ids) {
      try {
        Promise.resolve(P.signalUnknownCredential({ rpId: location.hostname, credentialId: id.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '') })).catch(() => {});
      } catch (_) {}
    }
  }

  function storedConverted() {
    const S = window.MentriaStore;
    if (!S || unsavedWhy) return false;
    const stored = S.get('quick_notes', 'blob');
    if (stored != null && !Array.isArray(stored)) return false;
    const cur = curKey();
    const ok = (n) => !isLegacyLocked(n) && !(!!n && !!n.enc && n.kv === 2 && !underCurrent(n, cur));
    return (stored || []).every(ok) && notes.every(ok);
  }

  async function retireIfReady() {
    if (retiring) return;
    const s = U.state();
    if (!s.unlocked || !s.linked.includes('notes')) return;
    let r = null;
    try { r = U.retirement('notes', { notesConverted: storedConverted() }); } catch (_) { return; }
    if (!r || !r.ready) return;
    retiring = true;
    try {
      const ids = [];
      const add = (id) => { if (typeof id === 'string' && id && !ids.includes(id)) ids.push(id); };
      add(window.MentriaStore ? window.MentriaStore.get('quick_notes', 'cred_id') : null);
      try { add(localStorage.getItem(CRED_KEY)); } catch (_) {}
      usedIds().forEach(add);
      sessionKeys = null;
      await U.markRetired('notes');
      signalRetired(ids);
    } catch (_) {
    } finally {
      retiring = false;
    }
  }

  function dropOld() {
    try { saver.flush(); } catch (_) {}
    sessionKeys = null;
    linkPending = false;
    printEl.textContent = '';
  }

  function openNotes() {
    openChain = openChain.then(openNotesNow, openNotesNow);
    return openChain;
  }

  async function openNotesNow() {
    if (!one) return;
    const s = U.state();
    const dropped = wasUnlocked && !s.unlocked;
    wasUnlocked = s.unlocked;
    if (s.unlocked) {
      const legacy = !!sessionKeys && notes.some((n) => isLegacyLocked(n) && !skipped.has(noteSig(n)));
      try { await ensureNotesKey(legacy); } catch (_) {}
      if (notesKeys.length) {
        linkPending = false;
        try { await convertNotes(); } catch (_) {}
        await retireIfReady();
      }
    } else {
      if (dropped) dropOld();
      if (notesKeys.length) {
        try { await saver.flush(); } catch (_) {}
      }
      notesKeys = [];
    }
    refreshEditor();
    renderList();
  }

  function refreshEditor() {
    const note = getNote(activeId);
    if (!note) return;
    const keep = (!note.enc && editorMode === 'plain') || (one && note.enc && editorMode === 'unlocked' && lockView(note) === 'open');
    if (keep) applyEditorMode(editorMode, panelView);
    else renderEditor();
  }

  function focusLost() {
    const a = document.activeElement;
    return !a || a === document.body || a === unlockBtn || a === lockBtn || a.hidden;
  }

  function mountLockCard() {
    if (card || cardP || !one) return;
    cardP = loadUI().then((ui) => ui.mountCard(cardSlot, {
      onUnlocked: () => {
        openNotes().then(() => {
          if (focusLost() && !textarea.hidden) textarea.focus({ preventScroll: true });
        });
      }
    })).then((h) => {
      cardP = null;
      card = h;
      if (panelView !== 'card' || lockedPanel.hidden) { dropLockCard(); return; }
      if (cardFocus && focusLost()) {
        const t = cardBox.querySelector('.m-unlock__title');
        if (t) t.focus({ preventScroll: true });
      }
      cardFocus = false;
    }, () => { cardP = null; });
  }

  function dropLockCard() {
    if (!card) return;
    const c = card;
    card = null;
    try { c.destroy(); } catch (_) {}
  }

  function showPanel(view) {
    panelView = view;
    const cardView = view === 'card';
    const oldPanel = view === 'old' || view === 'legacy';
    lockedPanel.classList.toggle('qn-locked--card', cardView);
    lockedBody.hidden = !oldPanel;
    unlockBtn.hidden = !oldPanel;
    linkBox.hidden = view !== 'legacy';
    lockedNote.textContent = view === 'missing' ? COPY.keyMissing : (view === 'off' && oneSettled ? COPY.oneOff : '');
    lockedNote.hidden = !lockedNote.textContent;
    cardBox.hidden = !cardView;
    cardLater.hidden = !(cardView && linkPending);
    if (cardView && !lockedPanel.hidden) mountLockCard();
    else dropLockCard();
  }

  function showSkipped() {
    const n = one ? notes.filter((x) => (isLegacyLocked(x) && skipped.has(noteSig(x))) || (!!x && !!x.enc && x.kv === 2 && skippedKv.has(noteSig(x)))).length : 0;
    const text = n ? COPY.convertSkipped.replace('{n}', n.toLocaleString(document.documentElement.lang || 'en')) : '';
    if (convertEl.textContent !== text) convertEl.textContent = text;
    convertEl.hidden = !text;
  }

  function genId() {
    return Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
  }

  function createNote() {
    dropAutoBlank();
    const note = {
      id: genId(),
      title: '',
      body: '',
      createdAt: Date.now(),
      updatedAt: Date.now()
    };
    notes.unshift(note);
    persist();
    selectNote(note.id);
    renderList();
    titleInput.focus();
    return note;
  }

  function recordNoteDeletion(id) {
    if (!window.MentriaStore) return;
    let del = window.MentriaStore.get('quick_notes', 'deleted');
    if (!del || typeof del !== 'object') del = {};
    del[String(id)] = Date.now();
    const keys = Object.keys(del);
    if (keys.length > 200) {
      keys.sort((a, b) => (Number(del[a]) || 0) - (Number(del[b]) || 0));
      keys.slice(0, keys.length - 200).forEach(k => { delete del[k]; });
    }
    window.MentriaStore.set('quick_notes', 'deleted', del);
  }

  function deleteNote(id) {
    const idx = notes.findIndex(n => n.id === id);
    if (idx === -1) return;
    notes.splice(idx, 1);
    recordNoteDeletion(id);
    if (notes.length === 0) {
      createNote();
      return;
    }
    if (activeId === id) {
      selectNote(notes[0].id);
    }
    persist();
    renderList();
  }

  function getNote(id) {
    return notes.find(n => n.id === id) || null;
  }

  function selectNote(id) {
    if (id !== activeId) saver.flush();
    activeId = id;
    const note = getNote(id);
    if (!note) return;
    renderEditor();
    renderList();
    if (window.innerWidth <= 640) {
      sidebar.classList.remove('qn-sidebar--open');
    }
  }

  async function renderEditor() {
    const seq = ++renderSeq;
    const note = getNote(activeId);
    if (!note) return;
    titleInput.value = note.title || '';
    let mode;
    let view = 'old';
    if (!note.enc) {
      mode = 'plain';
      textarea.value = note.body || '';
    } else if (one) {
      view = lockView(note);
      mode = view === 'open' ? 'unlocked' : 'locked';
      if (mode === 'unlocked') {
        let text = null;
        try { text = await decryptOne(note); } catch (_) {}
        if (seq !== renderSeq || activeId !== note.id) return;
        if (text === null) {
          mode = 'locked';
          view = note.kv === 2 ? 'missing' : 'legacy';
        } else {
          textarea.value = text;
        }
      }
    } else if (note.kv) {
      mode = 'locked';
      view = 'off';
    } else if (oldKeysHeld()) {
      mode = 'unlocked';
      try {
        const text = await decryptNote(note);
        if (activeId !== note.id) return;
        textarea.value = text;
      } catch (_) {
        mode = 'locked';
      }
    } else {
      mode = 'locked';
    }
    if (seq !== renderSeq) return;
    if (mode === 'locked') textarea.value = '';
    applyEditorMode(mode, view);
    updateCounts();
    updateSavedLabel(note.updatedAt);
  }

  let editorMode = 'plain';
  function applyEditorMode(mode, view) {
    editorMode = mode;
    const locked = mode === 'locked';
    if (!locked) drainInbox();
    textarea.hidden = locked;
    lockedPanel.hidden = !locked;
    exportBtn.hidden = locked;
    shareBtn.hidden = locked || !navigator.share;
    mdpdfBtn.hidden = locked;
    const readOnly = mode === 'unlocked' && oldReadOnly(getNote(activeId));
    textarea.readOnly = readOnly;
    titleInput.readOnly = readOnly;
    readOnlyEl.hidden = !readOnly;
    if (one) {
      lockBtn.hidden = locked || !oneOK;
      lockBtn.textContent = COPY.lockBtn;
      lockBtn.title = mode === 'unlocked' ? (U.state().unlocked ? COPY.relockTitle : COPY.relockOldTitle) : COPY.lockTitleOne;
      removeLockBtn.hidden = mode !== 'unlocked' || readOnly;
    } else if (!cryptoOK) {
      lockBtn.hidden = true;
    } else {
      lockBtn.hidden = locked;
      lockBtn.textContent = mode === 'unlocked' ? COPY.removeLockBtn : COPY.lockBtn;
    }
    if (locked && one) printEl.textContent = '';
    showPanel(locked ? (view || 'old') : 'old');
    showSkipped();
  }

  function renderList() {
    noteList.innerHTML = '';
    notes.forEach(note => {
      const btn = document.createElement('button');
      btn.className = 'qn-note-tab' + (note.id === activeId ? ' qn-note-tab--active' : '');
      btn.dataset.id = note.id;
      const title = note.title || COPY.untitled;
      let preview;
      if (note.enc) preview = '🔒 ' + COPY.lockedTag;
      else preview = note.body ? note.body.slice(0, 50).replace(/\n/g, ' ') : COPY.emptyPreview;
      btn.innerHTML =
        '<span class="qn-note-tab__title">' + escHtml(title) + '</span>' +
        '<span class="qn-note-tab__preview">' + escHtml(preview) + '</span>';
      btn.addEventListener('click', () => selectNote(note.id));
      noteList.appendChild(btn);
    });
    showSkipped();
  }

  function escHtml(s) {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  const saver = MentriaUI.debouncedSaver(saveActive, DEBOUNCE_MS);

  async function saveLocked(note) {
    if (editorMode !== 'unlocked') {
      note.updatedAt = Date.now();
      persist();
      renderList();
      return;
    }
    const id = note.id;
    const title = note.title;
    const text = textarea.value;
    let sealed = null;
    let kv = 0;
    try {
      if (notesKeys.length) {
        sealed = await sealCur(id, text);
        kv = 2;
      } else if (!note.kv && oldKeysHeld() && !notesLinked()) {
        sealed = await sealOld(note, text);
      }
    } catch (_) {
      sealed = null;
    }
    if (!sealed) return;
    const cur = getNote(id);
    if (!cur || !cur.enc) return;
    cur.title = title;
    cur.body = sealed.body;
    cur.iv = sealed.iv;
    if (kv) cur.kv = kv;
    else delete cur.kv;
    setKid(cur, kv ? sealed.kid : null);
    setPair(cur, kv ? null : sealed.pair);
    cur.updatedAt = Date.now();
    const ok = persist();
    if (ok && cur.id === activeId) updateSavedLabel(cur.updatedAt);
    renderList();
  }

  async function saveActive() {
    const note = getNote(activeId);
    if (!note) return;
    if (oldReadOnly(note)) return;
    note.title = titleInput.value;
    if (one && note.enc) return saveLocked(note);
    if (note.enc && (!oldKeysHeld() || editorMode !== 'unlocked')) {
      note.updatedAt = Date.now();
      persist();
      renderList();
      return;
    }
    if (note.enc) {
      try {
        const enc = await sealOld(note, textarea.value);
        note.body = enc.body;
        note.iv = enc.iv;
        setPair(note, enc.pair);
      } catch (_) { return; }
    } else {
      note.body = textarea.value;
    }
    note.updatedAt = Date.now();
    const ok = persist();
    if (ok && note.id === activeId) updateSavedLabel(note.updatedAt);
    renderList();
  }

  const wordSegmenter = (() => {
    try { return new Intl.Segmenter(document.documentElement.lang || undefined, { granularity: 'word' }); }
    catch (_) { return null; }
  })();

  function countWords(text) {
    const t = text.trim();
    if (t === '') return 0;
    if (wordSegmenter) {
      let n = 0;
      for (const seg of wordSegmenter.segment(t)) if (seg.isWordLike) n++;
      return n;
    }
    return t.split(/\s+/).length;
  }

  function updateCounts() {
    const text = textarea.value;
    const chars = text.length;
    const words = countWords(text);
    const lang = document.documentElement.lang || 'en';
    countsEl.textContent = COPY.countSummary.replace('{words}', words.toLocaleString(lang)).replace('{chars}', chars.toLocaleString(lang));
  }

  function updateSavedLabel(ts) {
    if (!ts || unsavedWhy) { savedEl.textContent = ''; return; }
    const d = new Date(ts);
    const now = new Date();
    const lang = document.documentElement.lang || 'en';
    const sameDay = d.getFullYear() === now.getFullYear() && d.getMonth() === now.getMonth() && d.getDate() === now.getDate();
    let stamp;
    try {
      stamp = sameDay
        ? new Intl.DateTimeFormat(lang, { timeStyle: 'medium' }).format(d)
        : new Intl.DateTimeFormat(lang, { dateStyle: 'medium', timeStyle: 'short' }).format(d);
    } catch (_) {
      stamp = d.toLocaleString();
    }
    savedEl.textContent = COPY.savedPrefix + ' ' + stamp;
  }

  function exportNote() {
    const note = getNote(activeId);
    if (!note) return;
    const title = titleInput.value.trim() || COPY.untitled;
    const filename = title.replace(/[\/\\:*?"<>|\s]/g, '_') + '.txt';
    const blob = new Blob([textarea.value], { type: 'text/plain;charset=utf-8' });
    MentriaUI.downloadFile(filename, blob);
  }

  async function exportAll() {
    const sorted = notes.slice().sort((a, b) => (Number(b.updatedAt) || 0) - (Number(a.updatedAt) || 0));
    const parts = [];
    let skipped = 0;
    for (const n of sorted) {
      let body;
      if (!n.enc) body = n.id === activeId && !textarea.hidden ? textarea.value : String(n.body || '');
      else if (one) {
        try { body = await decryptOne(n); } catch (_) { body = null; }
      } else if (sessionKeys) {
        try { body = await decryptNote(n); } catch (_) { body = null; }
      } else body = null;
      if (body == null) { skipped++; continue; }
      parts.push('# ' + ((n.title || '').trim() || COPY.untitled) + '\n\n' + body.trim() + '\n');
    }
    if (parts.length) {
      const stamp = new Date().toISOString().slice(0, 10);
      MentriaUI.downloadFile('mentria-notes-' + stamp + '.md', new Blob([parts.join('\n---\n\n')], { type: 'text/markdown;charset=utf-8' }));
    }
    if (skipped) MentriaUI.toast(COPY.exportAllSkipped.replace('{n}', skipped));
  }

  async function shareNote() {
    const note = getNote(activeId);
    if (!note || !textarea.value) return;
    try {
      await navigator.share({ title: titleInput.value.trim() || COPY.untitled, text: textarea.value });
    } catch (_) {}
  }

  async function handleLockClick() {
    if (TRY_ONE) await oneReady;
    const note = getNote(activeId);
    if (!note) return;
    if (one) {
      if (note.enc) relock();
      else lockNoteOne();
      return;
    }
    if (note.enc) removeLock();
    else lockNote();
  }

  async function openForLock() {
    let s = U.state();
    if (!s.setUp) {
      if (hasKv2()) return 'missing';
      const ui = await loadUI();
      const fresh = crypto.getRandomValues(new Uint8Array(32));
      try { await ui.showSetup({ service: 'notes', secret: fresh }); } finally { fresh.fill(0); }
    } else if (!s.unlocked) {
      const ui = await loadUI();
      await ui.showLaunch();
    }
    s = U.state();
    if (!s.unlocked) return false;
    return (await ensureNotesKey(true)) ? true : 'missing';
  }

  async function lockNoteOne() {
    const note = getNote(activeId);
    if (!note || note.enc) return;
    if (!oneOK) { mentriaAlert(COPY.lockFailedOne); return; }
    if (!(await mentriaConfirm(COPY.confirmLockOne))) return;
    let ready = false;
    try { ready = await openForLock(); } catch (_) { mentriaAlert(COPY.lockFailedOne); return; }
    if (ready === 'missing') { mentriaAlert(COPY.lockKeyMissing); return; }
    if (ready !== true || activeId !== note.id) return;
    try { await saver.flush(); } catch (_) {}
    const cur = getNote(note.id);
    if (!curKey() || !cur || cur.enc) return;
    let sealed;
    try { sealed = await sealCur(cur.id, textarea.value); } catch (_) { mentriaAlert(COPY.lockFailedOne); return; }
    const n = getNote(note.id);
    if (!n || n.enc || activeId !== n.id) return;
    n.title = titleInput.value;
    n.enc = true;
    n.kv = 2;
    n.body = sealed.body;
    n.iv = sealed.iv;
    setKid(n, sealed.kid);
    setPair(n, null);
    n.updatedAt = Date.now();
    persist();
    renderEditor();
    renderList();
  }

  async function relock() {
    try { await saver.flush(); } catch (_) {}
    sessionKeys = null;
    linkPending = false;
    cardFocus = true;
    if (U.state().unlocked) {
      try {
        const ui = await loadUI();
        await ui.lockNow();
      } catch (_) {
        try { await U.lock(); } catch (_) {}
      }
    }
    await openNotes();
  }

  async function bringIn() {
    if (!sessionKeys) return;
    const s = U.state();
    if (s.unlocked) { await openNotes(); return; }
    if (s.setUp) {
      linkPending = true;
      cardFocus = true;
      return;
    }
    if (hasKv2()) return;
    const ui = await loadUI();
    const fresh = crypto.getRandomValues(new Uint8Array(32));
    try { await ui.showSetup({ service: 'notes', secret: fresh }); } finally { fresh.fill(0); }
    await openNotes();
  }

  async function lockNote() {
    const note = getNote(activeId);
    if (!note || note.enc) return;
    if (!cryptoOK) { mentriaAlert(COPY.prfUnsupported); return; }
    if (!(await mentriaConfirm(COPY.confirmLock))) return;
    let enc;
    let k;
    try {
      k = await lockKey();
      enc = await sealLegacy(k.key, textarea.value);
    } catch (err) {
      handleCryptoError(err, COPY.lockFailed);
      return;
    }
    note.title = titleInput.value;
    note.enc = true;
    note.body = enc.body;
    note.iv = enc.iv;
    setPair(note, k);
    note.updatedAt = Date.now();
    persist();
    renderEditor();
    renderList();
  }

  async function unlockNote() {
    const note = getNote(activeId);
    if (!note || !note.enc || note.kv) return;
    try {
      let open = false;
      if (oldKeysHeld()) {
        try { await openOld(sessionKeys, note); open = true; } catch (_) {}
      }
      if (!open) await promptOpen(note);
    } catch (err) {
      if (err && err.message === 'no-legacy') {
        if (TRY_ONE) await oneReady;
        if (one) {
          for (const n of notes) if (isLegacyLocked(n)) skipped.add(noteSig(n));
          applyEditorMode(editorMode, panelView);
        } else {
          mentriaAlert(COPY.unlockFailed);
        }
        return;
      }
      handleCryptoError(err, COPY.unlockFailed);
      return;
    }
    if (TRY_ONE) await oneReady;
    if (one) {
      skipped.clear();
      await bringIn();
    }
    renderEditor();
  }

  async function removeLock() {
    const note = getNote(activeId);
    if (!note || !note.enc) return;
    if (one && (editorMode !== 'unlocked' || oldReadOnly(note))) return;
    if (!(await mentriaConfirm(COPY.confirmRemoveLock))) return;
    if (one && (editorMode !== 'unlocked' || oldReadOnly(note) || activeId !== note.id || getNote(note.id) !== note)) return;
    note.enc = false;
    note.body = textarea.value;
    delete note.iv;
    delete note.kv;
    delete note.kid;
    setPair(note, null);
    note.updatedAt = Date.now();
    persist();
    renderEditor();
    renderList();
  }

  function confirmDelete() {
    const note = getNote(activeId);
    if (!note) return;
    saver.flush();
    const snapshot = Object.assign({}, getNote(activeId));
    const index = notes.findIndex(n => n.id === snapshot.id);
    const wasLast = notes.length === 1;
    deleteNote(snapshot.id);
    const placeholderId = wasLast ? activeId : null;
    const name = (snapshot.title || '').trim() || COPY.untitled;
    MentriaUI.undoToast(COPY.noteDeleted.replace('{name}', name), () => restoreNote(snapshot, index, placeholderId));
  }

  function restoreNote(snapshot, index, placeholderId) {
    if (notes.some(n => n.id === snapshot.id)) return;
    if (placeholderId) {
      const p = notes.findIndex(n => n.id === placeholderId && !n.enc && !(n.title || '').trim() && !(n.body || '').trim());
      if (p !== -1) notes.splice(p, 1);
    }
    notes.splice(Math.min(index, notes.length), 0, Object.assign({}, snapshot, { updatedAt: Date.now() }));
    if (window.MentriaStore) {
      const del = window.MentriaStore.get('quick_notes', 'deleted');
      if (del && typeof del === 'object' && del[String(snapshot.id)] != null) {
        delete del[String(snapshot.id)];
        window.MentriaStore.set('quick_notes', 'deleted', del);
      }
    }
    persist();
    selectNote(snapshot.id);
  }

  function toggleSidebar() {
    sidebar.classList.toggle('qn-sidebar--open');
  }

  textarea.addEventListener('input', () => {
    updateCounts();
    saver.schedule();
  });

  titleInput.addEventListener('input', () => {
    saver.schedule();
  });

  newBtn.addEventListener('click', createNote);
  import('/assets/js/mentria-bus.js').then(({ MentriaBus }) => {
    MentriaBus.provide('notes.create', (args) => {
      const o = args || {};
      const note = createNote();
      titleInput.value = String(o.title || '').slice(0, 200);
      textarea.value = String(o.body || o.text || '');
      titleInput.dispatchEvent(new Event('input', { bubbles: true }));
      textarea.dispatchEvent(new Event('input', { bubbles: true }));
      if (saver && saver.flush) saver.flush();
      return { ok: true, id: note.id };
    }, { description: 'Create a new note with an optional title and body text.', ai: true, parameters: { type: 'object', properties: { title: { type: 'string' }, body: { type: 'string' } } } });
    MentriaBus.provide('notes.count', () => ({ count: notes.length }), { description: 'How many notes exist.', ai: true, readonly: true });
    MentriaBus.provide('notes.readAll', () => notes.map((n) => ({ title: n.title || '', body: String(n.body || n.text || '') })), { description: 'Full note contents for on-device processing only.', parameters: { type: 'object', properties: {} }, ai: false });
    MentriaBus.provide('notes.list', () => notes.map((n) => ({ title: n.title || '', preview: String(n.body || n.text || '').replace(/\s+/g, ' ').slice(0, 80), updatedAt: n.updatedAt || 0 })), { description: 'List saved notes: title, a short preview, and last-updated time.', parameters: { type: 'object', properties: {} }, ai: true, readonly: true });
  }).catch(() => {});
  exportBtn.addEventListener('click', exportNote);
  window.addEventListener('beforeprint', () => {
    const out = document.getElementById('qn-print');
    out.textContent = '';
    if (textarea.hidden) return;
    const h = document.createElement('h1');
    h.textContent = titleInput.value.trim() || COPY.untitled;
    const body = document.createElement('div');
    body.className = 'qn-print__body';
    body.textContent = textarea.value;
    out.append(h, body);
  });
  window.addEventListener('afterprint', () => {
    if (one) printEl.textContent = '';
  });
  document.getElementById('qn-export-all-btn').addEventListener('click', exportAll);
  if (navigator.share) shareBtn.addEventListener('click', shareNote);
  else shareBtn.hidden = true;
  mdpdfBtn.addEventListener('click', () => {
    const body = textarea.value;
    const title = titleInput.value.trim();
    const text = title ? '# ' + title + '\n\n' + body : body;
    if (!text.trim()) return;
    if (window.MentriaStore && !window.MentriaStore.set('handoff', 'md', { text, ts: Date.now() })) {
      MentriaUI.toast(COPY.toMdpdfFailed, { duration: 6000 });
      return;
    }
    location.href = MDPDF_URL;
  });
  lockBtn.addEventListener('click', handleLockClick);
  removeLockBtn.addEventListener('click', removeLock);
  unlockBtn.addEventListener('click', unlockNote);
  cardLater.addEventListener('click', () => {
    linkPending = false;
    renderEditor().then(() => {
      if (focusLost() && !textarea.hidden) textarea.focus({ preventScroll: true });
    });
  });
  deleteBtn.addEventListener('click', confirmDelete);
  sidebarToggle.addEventListener('click', toggleSidebar);

  function ingestSharedContent() {
    let p;
    try { p = new URLSearchParams(location.search); } catch (_) { return false; }
    const title = (p.get('title') || '').trim();
    const text  = (p.get('text')  || '').trim();
    const url   = (p.get('url')   || '').trim();
    if (!title && !text && !url) return false;
    history.replaceState(null, '', location.pathname);
    const ask = () => window.mentriaConfirm(COPY.linkConfirm).then((ok) => {
      if (!ok) return;
      const note = {
        id: genId(),
        title: title,
        body: [text, url].filter(Boolean).join('\n\n'),
        createdAt: Date.now(),
        updatedAt: Date.now()
      };
      notes.unshift(note);
      persist();
      selectNote(note.id);
    });
    if (typeof window.mentriaConfirm === 'function') ask();
    else document.addEventListener('DOMContentLoaded', ask, { once: true });
    return false;
  }

  function drainInbox() {
    const S = window.MentriaStore;
    if (!S) return;
    if (lockedPanel && !lockedPanel.hidden) return;
    const inbox = S.get('quick_notes', 'inbox');
    if (!Array.isArray(inbox) || !inbox.length) return;
    const del = S.get('quick_notes', 'deleted');
    const deleted = (del && typeof del === 'object') ? del : {};
    let added = false;
    for (const n of inbox) {
      if (n && n.id && typeof n.body === 'string' && !deleted[String(n.id)] && !notes.some(x => x.id === n.id)) {
        notes.unshift(n);
        added = true;
      }
    }
    S.remove('quick_notes', 'inbox');
    if (added) {
      dropAutoBlank();
      persist();
      if (!notes.some((x) => x.id === activeId)) selectNote(notes[0].id);
      renderList();
    }
  }

  window.addEventListener('mentria:write', (e) => {
    const d = e.detail || {};
    if (d.ns !== 'quick_notes') return;
    if (d.key === 'inbox' && d.op === 'set') drainInbox();
    if (d.key === 'blob' && d.op === 'set' && !persistingSelf) reconcileExternal();
    if (d.key === 'blob' && d.op === 'remove' && !persistingSelf) acceptExternalDelete();
  });
  window.addEventListener('storage', (e) => {
    if (e.key === 'mentria.store.quick_notes.inbox' && e.newValue) drainInbox();
    if (e.key === 'mentria.store.quick_notes.blob' && e.newValue) reconcileExternal();
    if (e.key === 'mentria.store.quick_notes.blob' && !e.newValue) acceptExternalDelete();
  });

  function addSharedText(text, meta) {
    const body = String(text || '').trim();
    if (!body) return;
    const title = String((meta && meta.title) || '').trim();
    const note = { id: genId(), title, body, createdAt: Date.now(), updatedAt: Date.now() };
    dropAutoBlank();
    notes.unshift(note);
    persist();
    selectNote(note.id);
  }

  load();
  keepDevicePair(storedPair());
  if (!unsavedWhy && storageTrouble() === 'blocked') showUnsaved('blocked');
  drainInbox();
  if (ingestSharedContent()) {
    selectNote(activeId);
  } else if (activeId === null && notes.length > 0) {
    selectNote(notes[0].id);
  }
  renderList();
  if (window.MentriaUI && MentriaUI.consumeShared) MentriaUI.consumeShared(null, addSharedText);

  if (TRY_ONE) {
    oneReady = import(UNLOCK_JS).then(async (m) => {
      if (!m.enabled()) return;
      U = m;
      one = true;
      let seenUnlocked = false;
      let seenEpoch = U.state().epoch;
      U.onChange((s) => {
        if (s && !s.unlocked && (seenUnlocked || wasUnlocked || s.epoch !== seenEpoch)) dropOld();
        seenUnlocked = !!(s && s.unlocked);
        if (s) seenEpoch = s.epoch;
        openNotes();
      });
      try { await U.ready(); } catch (_) {}
      await openNotes();
    }).catch(() => {}).then(() => {
      oneSettled = true;
      toolEl.dataset.lock = one ? 'one' : 'old';
      if (!one && panelView === 'off' && !lockedPanel.hidden) showPanel('off');
    });
  } else {
    toolEl.dataset.lock = 'old';
  }
})();
</script>

