          <p class="ph-ov__note">{{ "tool.phosphor.course_error_hint" | t }}</p>
        </div>
      </div>

      <p class="ph-ov__cta" id="ph-ready-click">{{ "tool.phosphor.ready_click" | t }}</p>
      <button type="button" class="ph-btn ph-btn--primary" id="ph-ready-start" hidden>{{ "tool.phosphor.ready_touch_start" | t }}</button>
