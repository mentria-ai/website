    setSavedRooms(list);
  }
  const fresh = !at || Math.abs(Date.now() - at) < 120000;
  if (fresh && !mine) sys(fmt(T.invite.joined, { name: String(ctl.name || '').slice(0, 32) || T.people.someone }));
};

const handleRoomCtl = (ctl, sfp, sig, at) => {
  if (!ctl || !currentRoomName || isDmRoom(currentRoomName)) return;
  if (ctl.k === 'joined') { onJoinedCtl(ctl, sig, at); return; }
  if (ctl.k === 'locked') { onLockedCtl(ctl, sig, at); return; }
  if (ctl.k !== 'ring') return;
  const token = (typeof ctl.token === 'string' && RING_TOKEN_RE.test(ctl.token)) ? ctl.token : null;
  if (!token || (ringToken && token === ringToken)) return;
  const list = savedRooms();
  const entry = list.find((r) => r.room === currentRoomName);
  if (!entry) return;
  const rings = roomRings(entry);
  if (ctl.off) delete rings[token];
  else rings[token] = { name: String(ctl.name || '').slice(0, 32), sfp: sfp || null, ts: Date.now() };
  const keys = Object.keys(rings);
  if (keys.length > 20) keys.sort((a, b) => (rings[a].ts || 0) - (rings[b].ts || 0)).slice(0, keys.length - 20).forEach((k) => { delete rings[k]; });
  entry.rings = rings;
  setSavedRooms(list);
};

const sealCache = new Map();
const sealPlain = (text, cmid, extra) => {
  if (cmid && sealCache.has(cmid)) return sealCache.get(cmid);
  const body = packChatBody(text, { fp: myFp, legacyFp: myLegacyFp }, extra);
  const room = currentRoomName;
  const signer = mySign;
  const out = (signer && room && cmid ? signBody(signer.signKey, signer.spub, room, cmid, body).catch(() => body) : Promise.resolve(body)).then((o) => JSON.stringify(o));
  if (cmid) {
    sealCache.set(cmid, out);
    if (sealCache.size > 200) sealCache.delete(sealCache.keys().next().value);
  }
  return out;
};

const publishRoomCtl = async (ctl) => {
  if (!chatKey || !currentRoomName || isDmRoom(currentRoomName) || !chatTopic || !chatPersist) return false;
  const cmid = newCmid();
  seenCmids.add(cmid);
  try {
    const enc = await encryptText(chatKey, await sealPlain('', cmid, { ctl }));
    if (chatAction) { try { chatAction.send({ cmid, enc }); } catch (_) {} }
    rememberSentCmid(cmid);
    const eventStr = await createPersistentEvent(CHAT_KIND, chatTopic, JSON.stringify({ cmid, ts: Date.now(), enc }), expiryTags());
    let sent = false;
    const sockets = getRelaySockets() || {};
    for (const ws of Object.values(sockets)) {
      if (ws && ws.readyState === 1) { try { ws.send(eventStr); sent = true; } catch (_) {} }
    }
    return sent;
  } catch (_) { return false; }
};

const announceRoomRing = async () => {
  if (!currentRoomName || !chatKey || isDmRoom(currentRoomName)) return;
  const list = savedRooms();
  const entry = list.find((r) => r.room === currentRoomName);
  if (!entry) return;
  const stale = (Date.now() - (entry.announcedAt || 0)) > 7 * 86400000;
  if (entry.notify && ringToken && (entry.announced !== ringToken || stale)) {
    const sent = await publishRoomCtl({ k: 'ring', token: ringToken, name: (myProfile && myProfile.name) || '' });
    if (sent) {
      const fresh = entry.announced !== ringToken;
      entry.announced = ringToken;
      entry.announcedAt = Date.now();
      setSavedRooms(list);
      if (fresh) sys(T.rooms.alerts_on);
    }
  } else if (!entry.notify && entry.announced) {
    const sent = await publishRoomCtl({ k: 'ring', token: entry.announced, off: true });
    if (sent) { entry.announced = null; setSavedRooms(list); sys(T.rooms.alerts_off); }
  }
};

const setRoomNotify = async (roomName, on) => {
  const entry = roomNotifyEntry(roomName);
  if (!entry) return;
  if (on) {
    if (!window.MentriaPush || !MentriaPush.isSupported()) {
      const iosTab = /iPhone|iPad|iPod/.test(navigator.userAgent) && !navigator.standalone;
      notice(iosTab ? T.rooms.alerts_ios : T.rooms.alerts_unsupported);
      return;
    }
    if (MentriaPush.permission() !== 'granted') {
      const ok = await MentriaPush.requestPermission();
      if (!ok) { notice(T.rooms.alerts_denied); return; }
    }
    if (!ringToken) await initRingToken();
    if (!ringToken) { notice(T.rooms.alerts_failed); return; }
  }
  const list = savedRooms();
  const fresh = list.find((r) => r.room === roomName);
  if (!fresh) return;
  fresh.notify = !!on;
  setSavedRooms(list);
  renderContacts();
  if (currentRoomName === roomName) { await announceRoomRing(); return; }
  if (on) { openSavedRoom(fresh); setView('chat'); }
};

if (new URLSearchParams(window.location.search).has('debug')) {
  window.__commsDebug = { lastInvite: () => lastInviteUrl, notifTargetNow, roomNotifUrl, setRoomNotify, announceRoomRing, publishRoomCtl, savedRooms, setSavedRooms, setRingToken: (t) => { ringToken = t; }, ringToken: () => ringToken };
}

let lastRoomRingAt = 0;
const ringRoomMembers = () => {
  if (!currentRoomName || currentDmContact || isDmRoom(currentRoomName)) return;
  if (!window.MentriaPush || !MentriaPush.ring) return;
  const entry = roomNotifyEntry(currentRoomName);
  const rings = roomRings(entry);
  const connected = new Set();
  for (const p of peerProfiles.values()) if (p && p.verified && p.ring) connected.add(p.ring);
  const targets = Object.keys(rings).filter((tk) => tk !== ringToken && !connected.has(tk));
  if (!targets.length || Date.now() - lastRoomRingAt < 8000) return;
  lastRoomRingAt = Date.now();
  targets.forEach((tk) => {
    MentriaPush.ring(tk, 'comms-msg').then((res) => {
      if (!(res && res.reason === 'unknown-token')) return;
      const list = savedRooms();
      const e = list.find((r) => r.room === entry.room);
      if (e && e.rings && e.rings[tk]) { delete e.rings[tk]; setSavedRooms(list); }
    }).catch(() => {});
  });
};

const sentCmidsFor = (fp) => {
  try {
    const log = MentriaStore.get('comms', 'sentlog') || {};
    return Array.isArray(log[fp]) ? log[fp] : [];
  } catch (_) { return []; }
};

const publishChat = async (text, cmid, extra) => {
  if (!chatTopic || !chatPersist || !chatKey) return;
  rememberSentCmid(cmid);
  try {
    const enc = await encryptText(chatKey, await sealPlain(text, cmid, extra));
    const eventStr = await createPersistentEvent(CHAT_KIND, chatTopic, JSON.stringify({ cmid, ts: Date.now(), enc }), expiryTags());
    const sockets = getRelaySockets() || {};
    for (const ws of Object.values(sockets)) {
      if (ws && ws.readyState === 1) {
        try { ws.send(eventStr); } catch {}
      }
    }
    ringRoomMembers();
  } catch (err) {
    console.warn('chat publish failed:', err);
  }
};

const connBinding = (peerId) => {
  try {
    const pc = room && room.getPeers ? room.getPeers()[peerId] : null;
    const local = pc && pc.localDescription ? certFingerprints(pc.localDescription.sdp) : '';
    const remote = pc && pc.remoteDescription ? certFingerprints(pc.remoteDescription.sdp) : '';
    return local && remote ? { local, remote } : null;
  } catch (_) { return null; }
};

const finishCheck = (peerId) => {
  const pend = pendingChecks.get(peerId);
  if (!pend) return;
  clearTimeout(pend.timer);
  pendingChecks.delete(peerId);
};

const announcePeer = (peerId, fallback) => {
  if (!peers.has(peerId)) return;
  let prof = peerProfiles.get(peerId);
  const contact = prof && prof.verified && prof.pub ? CID.contactByPub(prof.pub) : null;
  const label = (contact && contact.name) || (prof && prof.name) || '';
  if (prof && typeof prof.announcedAs === 'string' && (prof.announcedAs || !label)) return;
  if (!label && !fallback) return;
  if (!prof) { prof = { name: '' }; peerProfiles.set(peerId, prof); }
  prof.announcedAs = label;
  const withFp = !!(label && prof.verified && prof.fp && !isDmRoom(currentRoomName || ''));
  sys(fmt(withFp ? T.log.here_fp : T.log.here, { name: label || T.people.someone, fp: prof.fp }));
};

const challengePeer = (peerId, action) => {
  const prof = peerProfiles.get(peerId);
  if (!action || !myId || !prof || !prof.pub) return;
  finishCheck(peerId);
  const entry = { n: b64urlEncode(crypto.getRandomValues(new Uint8Array(16))), pub: prof.pub, timer: null };
  entry.timer = setTimeout(() => { if (pendingChecks.get(peerId) === entry) announcePeer(peerId); }, 8000);
  pendingChecks.set(peerId, entry);
  try { action.send({ t: 'q', n: entry.n, pub: { x: myId.publicJwk.x, y: myId.publicJwk.y } }, peerId); } catch (_) {}
};

const applyVerifiedProfile = async (peerId) => {
  const prof = peerProfiles.get(peerId);
  if (!prof || !prof.verified || !prof.pub) return;
  if (prof.spub) {
    try { noteRoomMember({ sigFp: await sigFingerprint(prof.spub), name: prof.name, pub: prof.pub, spub: prof.spub }); } catch (_) {}
  }
  const existing = CID.contactByPub(prof.pub);
  if (!existing) return;
  const ringNew = !!prof.ring && existing.ring !== prof.ring;
  const spubNew = !!prof.spub && !(existing.spub && existing.spub.x === prof.spub.x && existing.spub.y === prof.spub.y);
  if (!ringNew && !spubNew) return;
  try {
    await CID.addContact({ name: existing.name || prof.name, pub: prof.pub, ring: prof.ring || existing.ring, spub: prof.spub, ssig: prof.ssig });
    if (currentDmContact && currentDmContact.fp === existing.fp) currentDmContact.ring = prof.ring;
  } catch (_) {}
};

let joinSeq = 0;

const joinNew = async (roomName, b64Key = null, opts = {}) => {
  const seq = ++joinSeq;
  if (aiView && aiView.isOpen()) aiView.close();
  if (agentView && agentView.isOpen()) agentView.close();
  document.getElementById('comms-media-btn').hidden = true;
  if (attach) attach.setOpenThread(null);
  fileLines.clear();
  albumCards.clear();
  watchChatVia();
  const leavingDm = currentDmContact;
  joinTarget = (opts.leave || !roomName) ? null : { room: roomName, key: b64Key || null, kv: opts.kv === 2 ? 2 : 1 };
  stopScan();
  MentriaBus.unprovide('comms.peers');
  MentriaBus.unprovide('comms.share');
  MentriaBus.unprovide('extensions.requestInstall');
  endCall(true);
  incomingRings.clear();
  stopRinging();
  if (room) {
    closeChatSub();
    try { await room.leave(); } catch {}
    if (seq !== joinSeq) return;
    room = null;
    chatAction = metaAction = chunkAction = profAction = callAction = null;
    peers.clear();
    peerProfiles.clear();
    pendingChecks.forEach((pend) => clearTimeout(pend.timer));
    pendingChecks.clear();
    proofAnswers.clear();
    chatSubId = null;
    chatTopic = null;
    chatKey = null;
  }
  revokeObjectUrls();
  if (currentRoomName && !currentDmContact && !isDmRoom(currentRoomName)) { touchRoom(currentRoomName); clearUnreadFor(roomUnreadKey(currentRoomName)); }
  currentDmContact = null;
  if (leavingDm) clearUnreadFor(leavingDm.fp);
  els.log.innerHTML = '';
  logPinned = true;
  introTs = 0;
  roomJoinedAt = Date.now();
  els.status.textContent = T.chat.connecting;
  els.peers.hidden = true;
  els.enc.hidden = true;

  if (opts.leave || !roomName) {
    currentRoomName = null;
    currentDmContact = null;
    joinedLocked = false;
    els.room.value = '';
    els.status.textContent = T.chat.not_in_chat;
    els.share.hidden = true;
    paintOldLink(null);
    paintTwice();
    paintRekey();
    els.eph.hidden = true;
    els.leave.hidden = true;
    els.callStart.hidden = true;
    els.msg.disabled = true;
    els.go.disabled = true;
    if (window.location.hash) window.history.replaceState(null, '', window.location.pathname + window.location.search);
    setView('people');
    renderContacts();
    return;
  }

  const roomKv = opts.kv === 2 ? 2 : 1;
  const keys = b64Key ? await roomKeys(b64Key, roomKv) : null;
  chatKey = keys ? keys.chatKey : null;
  const topic = chatKey && !isEphemeralRoom(roomName) ? await chatTopicFor(roomName, b64Key, roomKv) : null;
  if (seq !== joinSeq) return;
  if (b64Key && !chatKey) sysTop(T.log.bad_key);
  if (chatKey && b64Key && !opts.self) { if (isEphemeralRoom(roomName)) eph.set(roomName, b64Key, roomKv); else rememberRoom(roomName, b64Key, { kv: roomKv }); clearUnreadFor(roomUnreadKey(roomName)); }

  if (opts.share === false || isDmRoom(roomName)) {
    if (window.location.hash) window.history.replaceState(null, '', window.location.pathname + window.location.search);
  } else {
    const nextHash = formatHash(roomName, null);
    if (window.location.hash !== nextHash) window.location.hash = nextHash;
  }
  refreshShareUrl(roomName);
  paintOldLink(roomName);
  paintTwice();
  paintRekey();

  let iceServers;
  try {
    iceServers = await getIce();
  } catch {
    iceServers = FALLBACK_ICE;
  }
  if (seq !== joinSeq) return;

  const rtcConfig = { iceServers };
  if (relayOnly && hasTurn(iceServers)) rtcConfig.iceTransportPolicy = 'relay';
  else if (relayOnly) console.warn('hide-my-ip requested but no relay server available — connecting normally');
  const roomConfig = { appId: 'mentria', relayConfig: { urls: [RELAY] }, rtcConfig };
  if (chatKey && b64Key) roomConfig.password = keys.password;
  const keyNotes = new Set();
  const onJoinError = (info) => {
    const reason = String((info && info.error) || '').toLowerCase();
    if (seq !== joinSeq || !reason.includes('password')) return;
    const note = isDmRoom(roomName) ? T.log.key_dm : peers.size > 0 ? T.log.key_room_other : T.log.key_room_mine;
    if (keyNotes.has(note)) return;
    keyNotes.add(note);
    sys(note);
  };
  try {
    room = joinRoom(roomConfig, roomName, { onJoinError });
  } catch (err) {
    sys(fmt(T.log.join_failed, { reason: why(err) }));
    els.status.textContent = T.chat.error;
    return;
  }

  currentRoomName = roomName;
  joinedLocked = CID.idState() !== 'unlocked';
  if (chatKey && b64Key) {
    renderContacts();
    subscribeUnread();
    closeLocalNotif('comms-room:' + roomName);
    setTimeout(() => { if (seq === joinSeq) announceRoomRing(); }, 3000);
  }
  if (opts.contact) currentDmContact = opts.contact;
  els.chatTitle.textContent = opts.self ? T.devices.title : opts.contact ? (opts.contact.name || opts.contact.fp) : ((roomNotifyEntry(roomName) || {}).label || roomName);
  paintAvatar(els.chatAvatar, opts.contact ? (opts.contact.name || opts.contact.fp) : '#', opts.contact ? opts.contact.fp : roomName);
  els.status.textContent = isDmRoom(roomName) ? T.chat.private : opts.self ? (selfStatus() || T.devices.title) : fmt(T.chat.room, { room: roomName });
  els.leave.hidden = false;
  setView('chat');
  setConnUI();
  els.eph.hidden = !!chatKey && !isEphemeralRoom(roomName);
  els.eph.title = chatKey ? T.chat.eph_bang : T.chat.eph_nokey;
  els.enc.hidden = !chatKey;
  els.msg.disabled = false;
  els.go.disabled = false;
  updatePeers();
  updateCallUI();
  if (isDmRoom(roomName)) sysTop(T.log.dm_note);
  else if (!opts.self) sysTop(myProfile.name ? fmt(T.log.alone_named, { name: myProfile.name, room: roomName }) : fmt(T.log.alone, { room: roomName }));
  if (chatKey && !isDmRoom(roomName) && !opts.self) sysTop(T.log.enc_note);

  callAction = room.makeAction('call');
  callAction.onMessage = (data, ctx) => {
    if (seq !== joinSeq || !data || typeof data !== 'object') return;
    const cid = (typeof data.cid === 'string' && data.cid && data.cid.length <= 64) ? data.cid : 'legacy:' + ctx.peerId;
    if (data.kind === 'ring') onCallRing(ctx.peerId, cid);
    else if (data.kind === 'join') onCallJoin(ctx.peerId, cid, true);
    else if (data.kind === 'here') onCallJoin(ctx.peerId, cid, false);
    else if (data.kind === 'decline') onCallDecline(ctx.peerId, cid);
    else if (data.kind === 'leave') onCallLeave(ctx.peerId);
  };

  room.onPeerStream = (stream, peerId) => {
    if (seq !== joinSeq) return;
    if (call.active && call.members.has(peerId)) addTile(peerId, stream, { label: displayName(peerId) });
    else pendingStreams.set(peerId, stream);
  };

  const pchk = room.makeAction('pchk');
  pchk.onMessage = async (data, ctx) => {
    if (!data || typeof data !== 'object' || !myId || !myFp || typeof data.n !== 'string' || data.n.length > 64) return;
    if (data.t === 'q') {
      if (!data.pub || typeof data.pub.x !== 'string' || typeof data.pub.y !== 'string') return;
      const asked = (proofAnswers.get(ctx.peerId) || 0) + 1;
      proofAnswers.set(ctx.peerId, asked);
      const bind = asked <= 12 ? connBinding(ctx.peerId) : null;
      if (!bind) return;
      try {
        const theirPub = { x: data.pub.x, y: data.pub.y };
        const mac = await CID.pairProof(myId.privateKey, theirPub, [PROOF_LABEL, data.n, myFp, await CID.fingerprint(theirPub), bind.local, bind.remote]);
        if (seq === joinSeq) pchk.send({ t: 'a', n: data.n, mac }, ctx.peerId);
      } catch (_) {}
      return;
    }
    if (data.t !== 'a') return;
    const pend = pendingChecks.get(ctx.peerId);
    const prof = peerProfiles.get(ctx.peerId);
    if (!pend || pend.n !== data.n || !prof || !prof.fp || !samePubOf(prof.pub, pend.pub)) return;
    const bind = connBinding(ctx.peerId);
    if (!bind) return;
    const ok = await CID.checkPairProof(myId.privateKey, pend.pub, [PROOF_LABEL, pend.n, prof.fp, myFp, bind.remote, bind.local], data.mac);
    const cur = peerProfiles.get(ctx.peerId);
    if (!ok || seq !== joinSeq || pendingChecks.get(ctx.peerId) !== pend || !cur || !samePubOf(cur.pub, pend.pub)) return;
    finishCheck(ctx.peerId);
    cur.verified = true;
    await applyVerifiedProfile(ctx.peerId);
    renderPeerList();
    announcePeer(ctx.peerId);
  };

  profAction = room.makeAction('prof');
  profAction.onMessage = async (data, ctx) => {
    if (!data || typeof data !== 'object') return;
    const prof = { name: String(data.name || '').slice(0, 32) };
    if (data.pub && typeof data.pub.x === 'string' && typeof data.pub.y === 'string') {
      prof.pub = { x: data.pub.x, y: data.pub.y };
      try { prof.fp = await CID.fingerprint(prof.pub); } catch {}
    }
    if (typeof data.ring === 'string') prof.ring = data.ring.slice(0, 64);
    if (prof.pub && validSpub(data.spub) && await verifyLink(prof.pub, data.spub, data.ssig)) { prof.spub = { x: data.spub.x, y: data.spub.y }; prof.ssig = data.ssig; }
    prof.caps = { files: data.caps && Number.isInteger(data.caps.files) ? data.caps.files : 0 };
    if (prof.fp) rememberCaps(prof.fp, prof.caps);
    if (seq !== joinSeq || !peers.has(ctx.peerId)) return;
    const known = peerProfiles.get(ctx.peerId);
    prof.verified = !!(known && known.verified && samePubOf(known.pub, prof.pub));
    if (known && typeof known.announcedAs === 'string') prof.announcedAs = known.announcedAs;
    peerProfiles.set(ctx.peerId, prof);
    if (prof.verified) await applyVerifiedProfile(ctx.peerId);
    else if (prof.pub && myId) challengePeer(ctx.peerId, pchk);
    else finishCheck(ctx.peerId);
    renderPeerList();
    if (!prof.pub || !myId) announcePeer(ctx.peerId);
  };

  chatAction = room.makeAction('chat');
  chatAction.onMessage = async (data, ctx) => {
    const cmid = data && data.cmid;
    if (cmid && seenCmids.has(cmid)) return;
    let text, sfp = null, sfp2 = null, parts = null, sig = null;
    if (data && data.enc) {
      if (!chatKey) return;
      try {
        const unpacked = unpackChatPlain(await decryptText(chatKey, data.enc));
        text = unpacked.text;
        sfp = unpacked.sfp;
        sfp2 = unpacked.sfp2;
        parts = unpacked.parts;
        if (unpacked.sg && cmid) sig = await verifyBody(unpacked.obj, currentRoomName, cmid);
        if (unpacked.ctl) { if (cmid) seenCmids.add(cmid); handleRoomCtl(unpacked.ctl, sfp, sig); return; }
      } catch { return; }
    } else {
      text = String(data && data.text || '');
    }
    if (cmid) seenCmids.add(cmid);
    renderRemoteChat({ senderId: ctx.peerId, text, ts: Date.now(), sfp, sfp2, cmid, parts, signer: signerFor(sig) });
    playPing(880);
  };

  const incoming = new Map();
  metaAction = room.makeAction('fmeta');
  metaAction.onMessage = (meta, ctx) => {
    if (!meta || typeof meta !== 'object') return;
    const size = Number(meta.size);
    if (!Number.isFinite(size) || size < 0 || size > MAX_FILE) return;
    let open = 0;
    incoming.forEach((_, k) => { if (k.startsWith(ctx.peerId + ':')) open++; });
    if (open >= 4) return;
    const line = renderLine(displayName(ctx.peerId), '', { peerId: ctx.peerId, quiet: true, html: progressHTML(T.files.receiving, meta.name, size, 0) });
    incoming.set(ctx.peerId + ':' + meta.id, { meta, size, chunks: [], received: 0, line, paint: 0 });
  };

  chunkAction = room.makeAction('fchunk');
  chunkAction.onMessage = async (data, ctx) => {
    const m = ctx.metadata || {};
    const key = ctx.peerId + ':' + m.id;
    const entry = incoming.get(key);
    if (!entry) return;
    keepAwakeReceiving();
    const bytes = (data instanceof ArrayBuffer || ArrayBuffer.isView(data)) ? data.byteLength : -1;
    const received = entry.received + bytes;
    if (bytes < 0 || received > entry.size || received > MAX_FILE) {
      incoming.delete(key);
      entry.chunks = [];
      if (entry.paint) cancelAnimationFrame(entry.paint);
      entry.line.line.removeAttribute('aria-live');
      entry.line.what.innerHTML = fmtHtml(T.files.interrupted, { name: strongName(entry.meta.name) });
      return;
    }
    entry.chunks.push(data);
    entry.received = received;
    if (!entry.paint) {
      entry.paint = requestAnimationFrame(() => {
        entry.paint = 0;
        if (incoming.get(key) === entry) entry.line.what.innerHTML = progressHTML(T.files.receiving, entry.meta.name, entry.size, entry.received);
      });
    }
    if (m.done) {
      if (entry.paint) { cancelAnimationFrame(entry.paint); entry.paint = 0; }
      entry.line.what.innerHTML = progressHTML(T.files.receiving, entry.meta.name, entry.size, entry.received);
      entry.line.line.removeAttribute('aria-live');
      const safeType = /^image\/(png|jpeg|gif|webp|avif|bmp)$/i.test(entry.meta.type || '') ? entry.meta.type : 'application/octet-stream';
      const blob = new Blob(entry.chunks, { type: safeType });
      if (entry.meta.kind === 'mentria-pack' || /\.mentria\.json$/i.test(entry.meta.name || '')) {
        const text = await blob.text();
        const who = nameOf(ctx.peerId);
        const label = document.createElement('span');
        label.textContent = fmt(T.files.pack_from, { who, title: entry.meta.packTitle || entry.meta.name }) + ' ';
        const importBtn = document.createElement('button');
        importBtn.type = 'button';
        importBtn.className = 'comms__btn comms__btn--ghost';
        importBtn.textContent = T.files.import;
        importBtn.addEventListener('click', async () => {
          importBtn.disabled = true;
          try {
            const P = await loadPacks();
            const res = await P.importText(text, { source: 'contact', from: who });
            importBtn.replaceWith(Object.assign(document.createElement('a'), { href: PREFIX + '/learn/play/?id=' + encodeURIComponent(res.row.id), textContent: T.files.open }));
            label.textContent = (res.replaced ? T.files.updated : T.files.imported) + ' ';
          } catch (e) { sys(fmt(T.files.import_failed, { reason: (e && e.errors && e.errors[0]) || why(e) })); importBtn.disabled = false; }
        });
        entry.line.what.innerHTML = '';
        entry.line.what.append(label, importBtn);
      } else if (entry.meta.kind === 'mentria-ext') {
        const html = await blob.text();
        const who = nameOf(ctx.peerId);
        const label = document.createElement('span');
        label.textContent = fmt(T.files.ext_from, { who, name: entry.meta.extName || entry.meta.name }) + ' ';
        const installBtn = document.createElement('button');
        installBtn.type = 'button';
        installBtn.className = 'comms__btn comms__btn--ghost';
        installBtn.textContent = T.files.install;
        installBtn.addEventListener('click', async () => {
          installBtn.disabled = true;
          try {
            const installed = await MentriaBus.invoke('extensions.requestInstall', { html, from: who });
            if (installed) {
              installBtn.replaceWith(Object.assign(document.createElement('a'), { href: PREFIX + '/tools/extensions/run/?id=' + encodeURIComponent(installed.manifest.id), textContent: T.files.open }));
              label.textContent = T.files.installed + ' ';
            } else { installBtn.disabled = false; }
          } catch (e) { sys(fmt(T.files.install_failed, { reason: why(e) })); installBtn.disabled = false; }
        });
        entry.line.what.innerHTML = '';
        entry.line.what.append(label, installBtn);
      } else {
        const url = trackObjectUrl(blob);
        entry.line.what.innerHTML = completeHTML(T.files.received, {}, entry.meta.name, entry.meta.size, safeType, url);
      }
      incoming.delete(key);
      playPing(660);
    }
  };

  room.onPeerJoin = (peerId) => {
    peers.add(peerId);
    updatePeers();
    renderPeerList();
    sendProfileTo(peerId);
    setTimeout(() => { if (seq === joinSeq && peers.has(peerId) && !peerProfiles.has(peerId)) announcePeer(peerId, true); }, 6000);
  };
  room.onPeerLeave = (peerId) => {
    const who = nameOf(peerId);
    const announced = (peerProfiles.get(peerId) || {}).announcedAs;
    const wasMember = call.members.has(peerId);
    for (const [key, entry] of incoming) {
      if (key.startsWith(peerId + ':')) {
        entry.line.line.removeAttribute('aria-live');
        entry.line.what.innerHTML = fmtHtml(T.files.peer_left, { name: strongName(entry.meta.name), who: escapeHtml(who) });
        incoming.delete(key);
      }
    }
    if (incomingRings.delete(peerId)) { sys(fmt(T.people.tried_call, { name: who })); renderRing(); }
    call.invited.delete(peerId);
    peers.delete(peerId);
    peerProfiles.delete(peerId);
    finishCheck(peerId);
    proofAnswers.delete(peerId);
    if (!wasMember) removeTile(peerId);
    pendingStreams.delete(peerId);
    updatePeers();
    renderPeerList();
    if (typeof announced === 'string') sys(fmt(T.log.left, { name: who }));
    if (wasMember) dropMember(peerId, false);
    else if (call.active && !call.connected && call.cid && !call.invited.size) endCall(false);
  };

  setupChatPersistence(roomName, topic);

  MentriaBus.provide('comms.peers', () => ({ count: peers.size }), { description: 'Number of connected comms peers.', parameters: { type: 'object', properties: {} }, ai: false });
  MentriaBus.provide('comms.share', async ({ filename, html, name }) => {
    if (!metaAction || !chunkAction) throw new Error(T.share_err.not_connected);
    if (peers.size === 0) throw new Error(T.share_err.no_peers);
    if (new Blob([html]).size > MAX_FILE) throw new Error(T.share_err.too_large);
    const file = new File([html], filename || 'extension.html', { type: 'text/html' });
    await sendOne(file, { kind: 'mentria-ext', extName: name });
    return { sentTo: peers.size };
  }, { description: 'Send an extension to connected comms peers.', parameters: { type: 'object', properties: { filename: { type: 'string' }, html: { type: 'string' }, name: { type: 'string' } }, required: ['html'] }, ai: false });
  MentriaBus.provide('extensions.requestInstall', ({ html, from }) => confirmInstall(html, Object.assign({ from }, INSTALL_OPTS)), { description: 'Install a received extension after a human trust prompt.', parameters: { type: 'object', properties: { html: { type: 'string' }, from: { type: 'string' } }, required: ['html'] }, ai: false });
};

