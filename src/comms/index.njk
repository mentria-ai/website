};

els.pushTest.addEventListener('click', async () => {
  els.pushTest.disabled = true;
  els.pushTestLog.textContent = '';
  try {
    if (!window.MentriaPush || !MentriaPush.isSupported()) {
      const isIos = /iPhone|iPad|iPod/.test(navigator.userAgent);
      pushTestLog(isIos && !navigator.standalone
        ? '1. push not available in the iPhone browser — install comms to your home screen first (share → add to home screen), then test from the installed app'
        : '1. push not supported in this browser');
      return;
    }
    pushTestLog('1. support: yes');
    if (MentriaPush.permission() !== 'granted') {
      pushTestLog('2. permission: asking…');
      const ok = await MentriaPush.requestPermission();
      pushTestLog('2. permission: ' + (ok ? 'granted' : 'NOT granted — the browser blocked or you declined; check site settings'), true);
      if (!ok) return;
    } else {
      pushTestLog('2. permission: granted');
    }
    let sub = null;
    let subErr = null;
    try {
      const reg = await navigator.serviceWorker.ready;
      sub = await reg.pushManager.getSubscription();
      if (!sub) {
        const r = await fetch('https://relay.mentria.ai/push/vapid-public', { cache: 'no-store' });
        const { publicKey } = await r.json();
        const pad = '='.repeat((4 - publicKey.length % 4) % 4);
        const b64 = (publicKey + pad).replace(/-/g, '+').replace(/_/g, '/');
        const raw = atob(b64), key = new Uint8Array(raw.length);
        for (let i = 0; i < raw.length; i++) key[i] = raw.charCodeAt(i);
        sub = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: key });
      }
    } catch (e) { subErr = (e && e.name ? e.name + ': ' : '') + String(e && e.message || e).slice(0, 120); }
    if (!sub) { pushTestLog('3. subscription: FAILED — ' + (subErr || 'unknown error')); return; }
    let host = 'unknown';
    try { host = new URL(sub.toJSON().endpoint).host; } catch (_) {}
    pushTestLog('3. subscription: ' + host);
    let testToken = MentriaStore.get('comms', 'selftest_token');
    if (!testToken || !/^[A-Za-z0-9_-]{20,64}$/.test(testToken)) {
      const b = crypto.getRandomValues(new Uint8Array(18));
      testToken = 'st' + btoa(String.fromCharCode(...b)).replaceAll('+', '-').replaceAll('/', '_').replaceAll('=', '');
      MentriaStore.set('comms', 'selftest_token', testToken);
    }
    const reg2 = await MentriaPush.ringRegister(testToken);
    pushTestLog('4. register with relay: ' + (reg2 ? 'ok' : 'FAILED'));
    if (!reg2) return;
    const rung = await MentriaPush.ring(testToken, 'comms-msg');
    if (rung && rung.throttled) { pushTestLog('5. self-knock: throttled — you just tested; wait ~25s and try again'); return; }
    pushTestLog('5. self-knock: ' + (rung && rung.ok ? 'sent' : 'FAILED — ' + ((rung && rung.reason) || 'unknown')));
    if (!rung || !rung.ok) return;
    pushTestLog('6. waiting for the notification…');
    const reg = await navigator.serviceWorker.ready;
    const t0 = Date.now();
    let seen = false;
    while (Date.now() - t0 < 15000) {
      await new Promise((r) => setTimeout(r, 600));
      const notes = await reg.getNotifications({ tag: 'comms-msg' });
      if (notes.length) { seen = true; break; }
    }
    pushTestLog(seen
      ? '6. notification arrived ✓ — push works on this device'
      : '6. relay accepted but NO notification in 15s ✗ — the push service (' + host + ') did not deliver; tell mihir this line', true);
  } finally {
    els.pushTest.disabled = false;
    updatePushStatus();
  }
});

