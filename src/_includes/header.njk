<a class="skip-link" href="#main-content">{{ "common.skip_to_content" | t }}</a>
<header class="site-header">
    <div class="site-header__inner">
        <a class="brand" href="{{ '/' | localeUrl(lang) }}" aria-label="Mentria home">MENTRIA<span class="brand__ai" aria-hidden="true"><span class="brand__ai-text"><span class="brand__ai-a">A</span><span class="brand__ai-i">I</span></span><svg class="brand__star" viewBox="0 0 48 48" aria-hidden="true"><path class="brand__spark" d="M24 1c1.8 16.5 4.7 19.2 23 23-18.3 3.8-21.2 6.5-23 23-1.8-16.5-4.7-19.2-23-23 18.3-3.8 21.2-6.5 23-23z" fill="currentColor"/></svg></span><span class="brand__cursor">_</span></a>
        <nav class="site-nav">
            <a class="week-ring" href="{{ '/learn/' | localeUrl(lang) }}" data-week-ring data-label-n="{{ 'nav.week_ring_n' | t }}" aria-label="{{ 'nav.week_ring' | t }}" title="{{ 'nav.week_ring' | t }}">
                <svg viewBox="0 0 24 24" aria-hidden="true">{% for i in range(0, 7) %}<circle class="week-ring__seg" cx="12" cy="12" r="9" transform="rotate({{ i * 51.43 }} 12 12)"/>{% endfor %}</svg>
            </a>
            {% set learnHref = '/learn/' | localeUrl(lang) %}
            {% set toolsHref = '/tools/' | localeUrl(lang) %}
            {% set inLearnNav = (page.url | startsWith(learnHref)) or (page.url | startsWith('/feed/' | localeUrl(lang))) %}
            <a href="{{ learnHref }}" class="nav-link{% if inLearnNav %} active{% endif %}"{% if inLearnNav %} aria-current="page"{% endif %} title="{{ 'learn.title' | t }}">
                <svg class="nav-link__i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 6.6c-1.7-1.4-4.1-1.9-7.6-1.6v13.2c3.5-.3 5.9.2 7.6 1.6 1.7-1.4 4.1-1.9 7.6-1.6V5c-3.5-.3-5.9.2-7.6 1.6zM12 6.6v13.2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
                <span class="nav-link__t">{{ "learn.title" | t }}</span>
            </a>
            <a href="{{ toolsHref }}" class="nav-link{% if page.url | startsWith(toolsHref) %} active{% endif %}"{% if page.url | startsWith(toolsHref) %} aria-current="page"{% endif %} title="{{ 'nav.tools' | t }}" data-tools-open>
                <svg class="nav-link__i" viewBox="0 0 24 24" aria-hidden="true"><path d="M14.8 3.6a5.2 5.2 0 0 0-5.8 7l-5.4 5.4a1.6 1.6 0 0 0 0 2.3l1.1 1.1a1.6 1.6 0 0 0 2.3 0l5.4-5.4a5.2 5.2 0 0 0 7-5.8l-3 3-2.6-.7-.7-2.6z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
                <span class="nav-link__t">{{ "nav.tools" | t }}</span>
            </a>
            <a href="/comms/" class="nav-link nav-link--comms{% if page.url | startsWith('/comms/') %} active{% endif %}"{% if page.url | startsWith('/comms/') %} aria-current="page"{% endif %} title="{{ 'nav.comms' | t }}" data-comms-link>
                <svg class="nav-link__i" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.6 4.8h14.8a1.4 1.4 0 0 1 1.4 1.4v8.6a1.4 1.4 0 0 1-1.4 1.4H9.4l-5.2 3.8V6.2a1.4 1.4 0 0 1 1.4-1.4z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
                <span class="nav-link__t">{{ "nav.comms" | t }}</span>
                <span class="nav-badge" data-comms-badge hidden>0</span>
            </a>
            {% set aboutHref = '/about/' | localeUrl(lang) %}
            <a href="{{ aboutHref }}" class="nav-link nav-link--about{% if page.url | startsWith(aboutHref) %} active{% endif %}"{% if page.url | startsWith(aboutHref) %} aria-current="page"{% endif %} title="{{ 'nav.about' | t }}">
                <svg class="nav-link__i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M12 11v5.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="12" cy="7.8" r="1.1" fill="currentColor"/></svg>
                <span class="nav-link__t">{{ "nav.about" | t }}</span>
                <span class="nav-dot" data-update-dot hidden></span>
            </a>

            {%- set currentLocale = lang | findLocale -%}
            <button type="button" class="nav-cmdk" data-palette-open aria-label="{{ 'palette.open' | t }}" aria-keyshortcuts="Meta+K Control+K">⌘K</button>
            <details class="lang-switcher">
                <summary aria-label="{{ 'lang_switcher.current_label' | t }}: {{ currentLocale.nativeName }}">
                    <span aria-hidden="true">🌐</span>
                    <span class="lang-switcher__current" lang="{{ currentLocale.code }}">{{ currentLocale.nativeName }}</span>
                    <span class="lang-switcher__chevron" aria-hidden="true">▾</span>
                </summary>
                <ul class="lang-switcher__menu">
                    {%- for loc in locales %}
                    <li>
                        <a hreflang="{{ loc.code }}"
                           href="{% if englishOnly %}{{ '/' | switchLocale(loc.code) }}{% else %}{{ page.url | switchLocale(loc.code) }}{% endif %}"
                           class="lang-switcher__item{% if loc.code == lang %} is-active{% endif %}">
                            <span class="lang-switcher__name" lang="{{ loc.code }}">{{ loc.nativeName }}</span>
                            <span class="lang-switcher__code">{{ loc.code }}</span>
                        </a>
                    </li>
                    {%- endfor %}
                </ul>
            </details>
        </nav>
    </div>
</header>
