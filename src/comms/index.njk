const renderContacts = () => {
  if (!els.contactList) return;
  els.contactList.innerHTML = '';
  const requests = CID.getRequests();
  const contacts = CID.getContacts();
  const rooms = savedRooms();
  const roomInvitesNow = roomInvites();
  if (!contacts.length && !requests.length && !rooms.length && !homeThreads.length && !roomInvitesNow.length && !agentList().length) {
    els.contactList.append(listNote(T.people.empty));
    return;
  }
  const agents = agentList();
  const rows = homeRows({ contacts, requests, roomInvites: roomInvitesNow, rooms, agents, threads: homeThreads, unread: unreadMap }, { filter: homeFilter, query: homeQuery });
  if (!rows.length) {
    els.contactList.append(listNote(T.home.at_none));
    return;
  }
  const missedMap = getMissed();
  for (const r of rows) {
    if (r.kind === 'request') els.contactList.append(requestRow(r.ref));
    else if (r.kind === 'invite') els.contactList.append(inviteRow(r.ref));
    else if (r.kind === 'agent') els.contactList.append(agentRow(r.ref, r));
    else if (r.kind === 'contact') els.contactList.append(contactRow(r.ref, r, missedMap));
    else if (r.kind === 'room') els.contactList.append(roomRow(r.ref, r));
    else if (r.kind === 'self') els.contactList.append(selfRow(r.ref, r));
    else els.contactList.append(aiRow(r.ref, r));
  }
};

const refreshHomeThreads = () => {
  clearTimeout(homeThreadsTimer);
  homeThreadsTimer = setTimeout(async () => {
    const next = historyOn() ? await commsStore.listThreads().catch(() => null) : [];
    if (!next) return;
    homeThreads = next;
    if (els.contactList && els.contactList.querySelector('.comms__room-rename')) return;
    renderContacts();
  }, 120);
};

const dropStoredThreads = async (match) => {
  if (!historyOn()) return;
  try {
    for (const t of await commsStore.listThreads()) {
      if (!match(t)) continue;
      if (attach) await attach.removeMedia((await commsStore.listMedia({ threadId: t.id }).catch(() => [])).map((r) => r.id));
      const gone = await commsStore.deleteThread(t.id);
      if (attach && gone && gone.length) await attach.removeMedia(gone);
    }
  } catch (e) {
    historyFail(e);
  }
  refreshHomeThreads();
};

const homeSearch = document.getElementById('comms-search');
const homeFilterBar = document.getElementById('comms-filter');
homeSearch.addEventListener('input', () => { homeQuery = homeSearch.value; renderContacts(); });
homeFilterBar.addEventListener('click', (e) => {
  const b = e.target.closest('button[data-f]');
  if (!b) return;
  homeFilter = b.dataset.f;
  homeFilterBar.querySelectorAll('button[data-f]').forEach((x) => {
    const on = x === b;
    x.classList.toggle('is-active', on);
    x.setAttribute('aria-pressed', String(on));
  });
  renderContacts();
});
document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') refreshHomeThreads(); });

const homeForm = document.getElementById('comms-home-send');
const homeMsg = document.getElementById('comms-home-msg');
const homeAt = document.getElementById('comms-at');
const phoneWidth = window.matchMedia('(max-width: 720px)');
let homeTarget = null;
let atItems = [];
let atIndex = 0;
const homePlaceholder = () => { homeMsg.placeholder = phoneWidth.matches ? homeMsg.dataset.phPhone : homeMsg.dataset.phDesk; };
homePlaceholder();
if (phoneWidth.addEventListener) phoneWidth.addEventListener('change', homePlaceholder);

const homeTargets = () => {
  const out = CID.getContacts().map((c) => ({ kind: 'contact', id: c.fp, label: c.name || c.fp, ref: c }));
  for (const r of savedRooms()) out.push({ kind: 'room', id: r.room, label: r.label || r.room, ref: r });
  out.push({ kind: 'ai', id: 'ai', label: T.home.filter_ai });
  for (const h of aiClient.hosts()) {
    if (!h.device || h.device.id === myDevice.id) continue;
    for (const m of h.models) out.push({ kind: 'model', id: h.device.id + ':' + m.tier, label: fmt(T.ai.at_label, { model: tierName(m.tier), device: aiDeviceName(h.device) }), ref: { device: h.device, tier: m.tier } });
  }
  return out;
};

const closeAt = () => {
  homeAt.hidden = true;
  homeAt.replaceChildren();
  atItems = [];
  homeMsg.setAttribute('aria-expanded', 'false');
  homeMsg.removeAttribute('aria-activedescendant');
};

let atMeasure = null;
const placeAt = () => {
  const style = getComputedStyle(homeMsg);
  if (!atMeasure) atMeasure = document.createElement('canvas').getContext('2d');
  atMeasure.font = style.fontWeight + ' ' + style.fontSize + ' ' + style.fontFamily;
  const before = homeMsg.value.slice(0, homeMsg.selectionStart);
  const x = homeMsg.offsetLeft + (parseFloat(style.paddingLeft) || 0) + atMeasure.measureText(before.slice(0, before.lastIndexOf('@'))).width - homeMsg.scrollLeft;
  homeAt.style.setProperty('--at-x', Math.max(4, Math.min(x, homeForm.clientWidth - homeAt.offsetWidth - 4)) + 'px');
};

const pickAt = (i) => {
  const t = atItems[i];
  if (!t) return;
  const caret = homeMsg.selectionStart;
  const before = homeMsg.value.slice(0, caret);
  const at = before.lastIndexOf('@');
  const insert = '@' + t.label + ' ';
  homeMsg.value = before.slice(0, at) + insert + homeMsg.value.slice(caret).replace(/^ /, '');
  homeMsg.setSelectionRange(at + insert.length, at + insert.length);
  homeTarget = t;
  closeAt();
  homeMsg.focus();
};

const renderAt = () => {
  const q = mentionQuery(homeMsg.value, homeMsg.selectionStart);
  if (q == null) { closeAt(); return; }
  atItems = matchTargets(q, homeTargets());
  atIndex = Math.min(atIndex, Math.max(0, atItems.length - 1));
  homeAt.replaceChildren();
  if (!atItems.length) {
    const none = document.createElement('div');
    none.className = 'comms__at-none';
    none.textContent = T.home.at_none;
    homeAt.append(none);
  }
  atItems.forEach((t, i) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'comms__at-i';
    b.id = 'comms-at-' + i;
    b.setAttribute('role', 'option');
    b.setAttribute('aria-selected', String(i === atIndex));
    const av = document.createElement('span');
    av.setAttribute('aria-hidden', 'true');
    if (t.kind === 'contact') {
      av.className = 'comms__avatar';
      paintAvatar(av, t.label, t.id);
    } else if (t.kind === 'room') {
      av.className = 'comms__avatar comms__avatar--room';
      av.innerHTML = '<svg class="comms__i" aria-hidden="true"><use href="#ci-lock"></use></svg>';
    } else {
      av.className = 'comms__avatar comms__avatar--tool';
      av.innerHTML = '<svg viewBox="0 0 48 48" focusable="false"><use href="#tool-ai-chat"></use></svg>';
      if (!document.getElementById('tool-ai-chat') && window.MentriaToolsPopup) window.MentriaToolsPopup.load();
    }
    const label = document.createElement('span');
    label.textContent = t.label;
    b.append(av, label);
    b.addEventListener('mousedown', (e) => e.preventDefault());
    b.addEventListener('click', () => pickAt(i));
    homeAt.append(b);
  });
  homeAt.hidden = false;
  homeMsg.setAttribute('aria-expanded', 'true');
  if (atItems.length) homeMsg.setAttribute('aria-activedescendant', 'comms-at-' + atIndex);
  else homeMsg.removeAttribute('aria-activedescendant');
  placeAt();
};

homeMsg.addEventListener('input', () => { atIndex = 0; renderAt(); });
homeMsg.addEventListener('keydown', (e) => {
  if (homeAt.hidden) return;
  if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
    e.preventDefault();
    if (!atItems.length) return;
    atIndex = (atIndex + (e.key === 'ArrowDown' ? 1 : atItems.length - 1)) % atItems.length;
    renderAt();
  } else if (e.key === 'Enter' && atItems.length) {
    e.preventDefault();
    pickAt(atIndex);
  } else if (e.key === 'Escape') {
    e.preventDefault();
    closeAt();
  }
});
homeMsg.addEventListener('blur', () => { setTimeout(() => { if (document.activeElement !== homeMsg) closeAt(); }, 150); });

const composerFor = async (target) => {
  for (let i = 0; i < 80; i++) {
    const here = target.kind === 'contact' ? !!currentDmContact && currentDmContact.fp === target.id : currentRoomName === target.ref.room;
    if (here && !els.msg.disabled && chatAction) return true;
    await new Promise((r) => setTimeout(r, 150));
  }
  return false;
};

homeForm.addEventListener('submit', async (e) => {
  e.preventDefault();
  closeAt();
  const { target, body } = splitTarget(homeMsg.value, homeTarget);
  if (!body) return;
  if (target && target.kind === 'model' && commsStore) {
    homeMsg.value = '';
    homeTarget = null;
    const t = await aiNewThread({ device: target.ref.device.id, kind: target.ref.device.kind, tier: target.ref.tier }, body);
    if (t) {
      refreshHomeThreads();
      await openAiThread(t);
      aiView.send(body);
      return;
    }
  }
  if (!target || target.kind === 'ai' || target.kind === 'model') {
    try { sessionStorage.setItem(HANDOFF_KEY, JSON.stringify({ text: body, at: Date.now() })); } catch (_) {}
    window.location.href = PREFIX + '/tools/ai-chat/?thread=new';
    return;
  }
  homeMsg.value = '';
  homeTarget = null;
  if (target.kind === 'contact') openDmWith(target.ref);
  else openSavedRoom(target.ref);
  const ready = await composerFor(target);
  els.msg.value = body;
  if (ready) els.send.requestSubmit();
});

const showAddError = (text) => {
  els.addErr.textContent = text || '';
  els.addErr.hidden = !text;
};

const contactCodeError = (err) => {
  const msg = String((err && err.message) || '');
  if (msg === 'not a contact code') return T.people.code_not;
  if (msg === 'bad contact code' || (err && (err.name === 'SyntaxError' || err.name === 'InvalidCharacterError' || err.name === 'TypeError'))) return T.people.code_broken;
  return fmt(T.people.add_failed, { reason: why(err) });
};

els.contactAdd.addEventListener('click', async () => {
  showAddError('');
  if (!els.contactIn.value.trim()) { showAddError(T.people.code_empty); els.contactIn.focus(); return; }
  let saved;
  try {
    const payload = CID.decodeContactCode(els.contactIn.value);
    saved = await CID.addContact(payload);
  } catch (err) {
    showAddError(contactCodeError(err));
    els.contactIn.focus();
    return;
  }
  if (saved && saved.fp) CID.dropRequest(saved.fp);
  els.contactIn.value = '';
  renderContacts();
  subscribeUnread();
  const reached = await announceToContact(saved);
  notice(fmt(reached ? T.people.added_reached : T.people.added, { name: saved.name || saved.fp }));
});
els.contactIn.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); els.contactAdd.click(); } });
els.contactIn.addEventListener('input', () => { if (!els.addErr.hidden) showAddError(''); });

const RECOVERY_ALPHA = 'abcdefghjkmnpqrstuvwxyz23456789';
const makeRecoveryCode = () => {
  const bytes = crypto.getRandomValues(new Uint8Array(20));
  let out = '';
  for (let i = 0; i < 20; i++) {
    if (i && i % 5 === 0) out += '-';
    out += RECOVERY_ALPHA[bytes[i] % RECOVERY_ALPHA.length];
  }
  return out;
};

const cryptoOk = () => !!(window.MentriaIdentity && MentriaIdentity.cryptoReady && MentriaIdentity.cryptoReady());

const showOnboardStep = (which) => {
  const step = cryptoOk() ? which : 'insecure';
  els.obInsecure.hidden = step !== 'insecure';
  els.obIntro.hidden = step !== 'intro';
  els.obForm.hidden = step !== 'form';
  els.obDone.hidden = step !== 'done';
};

els.obStart.addEventListener('click', () => {
  showOnboardStep('form');
  els.obName.focus();
});

els.obName.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); els.obCreate.click(); } });

const setOnboardMethod = (ok) => {
  els.obMethod.textContent = ok ? T.onboard.method_ok : T.onboard.method_none;
  els.obPasskey.hidden = ok;
};

els.obCreate.addEventListener('click', async () => {
  const name = (els.obName.value || '').trim().slice(0, 32);
  if (!name) { els.obErr.hidden = false; els.obErr.textContent = T.onboard.err_name; els.obName.focus(); return; }
  els.obErr.hidden = true;
  els.obCreate.disabled = true;
  const prevLabel = els.obCreate.textContent;
  els.obCreate.textContent = T.onboard.setting_up;
  try {
    if (KR_WANTED && bootUnlock) await bootUnlock;
    if (KR_WANTED && !krOn() && krLateP && krRingHasIdentity() && !window.MentriaIdentity.isSetUp()) {
      const left = Math.max(0, KR_GIVE_UP_MS - (Date.now() - krBootAt));
      await Promise.race([krLateP, new Promise((resolve) => setTimeout(resolve, left))]);
      if (!krOn()) {
        els.obErr.hidden = false;
        els.obErr.textContent = TU.loadFailed;
        return;
      }
    }
    if (krOn() && !krDeclined) {
      if (!cryptoOk()) throw new Error('insecure-context');
      const made = await krCreateIdentity();
      if (made) {
        if (made !== 'rebuilt' || !CID.getProfile().name) CID.setProfile({ name });
        onboardDone = true;
        onboardActive = false;
        await initIdentity();
        refreshIdUI();
        if (!hasRoomHash()) els.contactIn.focus();
        return;
      }
      if (!krDeclined) return;
    }
    const code = makeRecoveryCode();
    await window.MentriaIdentity.setup(code);
    CID.setProfile({ name });
    let passkeyOk = false;
    try { await window.MentriaIdentity.enrollPasskey(); passkeyOk = true; } catch (_) { passkeyOk = false; }
    els.obCode.textContent = code;
    setOnboardMethod(passkeyOk);
    showOnboardStep('done');
    await initIdentity();
  } catch (err) {
    const code = err && err.message;
    els.obErr.hidden = false;
    els.obErr.textContent = code === 'insecure-context'
      ? fmt(T.onboard.err_insecure, { url: COMMS_HTTPS })
      : fmt(T.onboard.err_setup, { reason: code ? why(err) : String(err) });
    if (code === 'insecure-context') showOnboardStep('insecure');
  } finally {
    els.obCreate.disabled = false;
    els.obCreate.textContent = prevLabel;
  }
});

els.obPasskey.addEventListener('click', async () => {
  els.obPasskey.disabled = true;
  try {
    await window.MentriaIdentity.enrollPasskey();
    setOnboardMethod(true);
  } catch (err) {
    const code = err && err.message;
    els.obMethod.textContent = code === 'prf-unsupported' ? T.onboard.method_none : T.onboard.method_failed;
    els.obPasskey.hidden = true;
  } finally {
    els.obPasskey.disabled = false;
  }
});

els.obCopy.addEventListener('click', async () => {
  try {
    await navigator.clipboard.writeText(els.obCode.textContent || '');
    els.obCopy.textContent = T.onboard.copied;
    setTimeout(() => { els.obCopy.textContent = T.onboard.copy_code; }, 1600);
  } catch (_) {}
});

els.obContinue.addEventListener('click', () => {
  onboardDone = true;
  onboardActive = false;
  refreshIdUI();
  if (!hasRoomHash()) els.contactIn.focus();
});

els.setupHere.addEventListener('click', () => {
  onboardDone = false;
  onboardActive = true;
  refreshIdUI();
  showOnboardStep('intro');
  els.onboard.scrollIntoView({ block: 'center', behavior: 'smooth' });
});

els.advToggle.addEventListener('click', () => {
  const open = els.adv.hidden;
  if (open) updatePushStatus();
  els.adv.hidden = !open;
  els.advToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  if (open) els.adv.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
});

const closeAdv = () => {
  els.adv.hidden = true;
  els.advToggle.setAttribute('aria-expanded', 'false');
};

els.newRoom.addEventListener('click', async () => {
  const name = EPHEMERAL_PREFIX + randomRoomSlug();
  const key = b64urlEncode(crypto.getRandomValues(new Uint8Array(32)));
  els.room.value = name;
  closeAdv();
  await joinNew(name, key, { kv: 2 });
});

els.newSaved.addEventListener('click', async () => {
  const name = randomRoomSlug() + randomRoomSlug();
  const key = b64urlEncode(crypto.getRandomValues(new Uint8Array(32)));
  els.room.value = name;
  closeAdv();
  await joinNew(name, key, { kv: 2 });
  if (currentRoomName === name) sys(T.log.saved_room);
});

refreshIdUI();
let bootUnlock = null;
const legacyBoot = () => {
  if (CID.idState() === 'unlocked') initIdentity();
  else if (CID.idState() === 'locked' && window.MentriaIdentity && MentriaIdentity.tryDeviceUnlock) {
    return MentriaIdentity.tryDeviceUnlock().then((ok) => { if (ok) initIdentity(); else refreshIdUI(); }, () => { refreshIdUI(); });
  }
  return null;
};
const krAttach = (mods) => {
  KR = mods[0];
  KRC = mods[1];
  krMigrateRemember();
  krEpoch = KR.state().epoch;
  KR.onChange(krChanged);
  if (!KR.state().unlocked) krSawLocked = true;
};
const krLate = async (start, fallback) => {
  const mods = await start;
  try { await fallback; } catch (_) {}
  if (!Array.isArray(mods) || KR) return;
  if (krTyping()) krOldOpen = true;
  krAttach(mods);
  if (els.obErr.textContent === TU.loadFailed) {
    els.obErr.hidden = true;
    els.obErr.textContent = '';
  }
  const I = window.MentriaIdentity;
  if (I && I.isUnlocked()) await krAfterLegacy({ auto: true, verify: true });
  else if (krLinked() && KR.state().unlocked) await krOpen();
  refreshIdUI();
};
const krBootSteps = async () => {
  const start = (async () => {
    const mods = await Promise.all([import('/assets/js/mentria-unlock.js'), import('/assets/js/mentria-unlock-core.js')]);
    try { await mods[0].ready(); } catch (_) {}
    return mods[0].enabled() ? mods : null;
  })().catch(() => 'failed');
  const mods = await Promise.race([start, new Promise((resolve) => setTimeout(() => resolve(false), KR_WAIT_MS))]);
  if (mods === false) {
    krPending = false;
    refreshIdUI();
    const fallback = legacyBoot();
    krLateP = krLate(start, fallback).catch(() => {});
    return fallback;
  }
  if (mods === 'failed') {
    krPending = false;
    refreshIdUI();
    krLateP = Promise.resolve();
    return legacyBoot();
  }
  if (!mods) {
    krPending = false;
    refreshIdUI();
    return legacyBoot();
  }
  krAttach(mods);
  if (krLinked() && KR.state().unlocked) await krOpen();
  krPending = false;
  refreshIdUI();
  const I = window.MentriaIdentity;
  if (krLinked() || !I) return null;
  if (CID.idState() === 'unlocked') { initIdentity(); return null; }
  if (CID.idState() === 'locked' && I.tryDeviceUnlock) {
    const ok = await I.tryDeviceUnlock().catch(() => false);
    if (ok) {
      await initIdentity();
      krAfterLegacy({ auto: true, verify: true });
    } else {
      refreshIdUI();
    }
  }
  return null;
};
const krBoot = async () => {
  try {
    return await krBootSteps();
  } catch (_) {
    return null;
  } finally {
    if (krPending) {
      krPending = false;
      try { refreshIdUI(); } catch (_) {}
    }
  }
};
bootUnlock = KR_WANTED ? krBoot() : legacyBoot();

function randomRoomSlug() {
  const bytes = crypto.getRandomValues(new Uint8Array(5));
  const alpha = 'abcdefghijklmnopqrstuvwxyz234567';
  let bits = 0, value = 0, out = '';
  for (let i = 0; i < bytes.length; i++) {
    value = (value << 8) | bytes[i]; bits += 8;
    while (bits >= 5) { out += alpha[(value >>> (bits - 5)) & 0x1f]; bits -= 5; }
  }
  return out;
}

const bootHash = window.location.hash && window.location.hash !== '#' ? parseHash(window.location.hash) : null;
if (bootHash && isDmRoom(bootHash.room)) {
  window.history.replaceState(null, '', window.location.pathname + window.location.search);
}
const bootInvite = parseInvite(window.location.hash);
if (bootInvite) {
  window.history.replaceState(null, '', window.location.pathname + window.location.search);
  window.addEventListener('load', async () => {
    if (bootUnlock) await Promise.race([bootUnlock, new Promise((r) => setTimeout(r, 4000))]);
    openInviteLink(bootInvite);
  });
}
const bootTarget = bootHash && !bootInvite && !isDmRoom(bootHash.room) ? resolveHash(window.location.hash, savedRooms(), eph) : null;
const bootConflict = !!(bootTarget && bootTarget.imported && importRoomLink(bootTarget) === 'conflict');
const hasHash = !!bootTarget;
if (hasHash) {
  els.room.value = bootTarget.room;
  refreshShareUrl(bootTarget.room);
  window.addEventListener('load', async () => {
    if (bootUnlock) await Promise.race([bootUnlock, new Promise((r) => setTimeout(r, 4000))]);
    if (joinTarget) return;
    if (bootConflict) { openConflictLink(bootTarget); return; }
    joinNew(bootTarget.room, bootTarget.key, { kv: bootTarget.kv });
  });
}
window.addEventListener('hashchange', () => {
  const invite = parseInvite(window.location.hash);
  if (invite) { openInviteLink(invite); return; }
  const raw = parseHash(window.location.hash);
  if (isDmRoom(raw.room)) {
    window.history.replaceState(null, '', window.location.pathname + window.location.search);
    refreshIdUI();
    return;
  }
  const next = resolveHash(window.location.hash, savedRooms(), eph);
  if (next && next.imported && importRoomLink(next) === 'conflict') { openConflictLink(next); refreshIdUI(); return; }
  const same = next
    ? !!joinTarget && joinTarget.room === next.room && joinTarget.key === next.key
    : !joinTarget;
  if (!same) {
    els.room.value = next ? next.room : '';
    if (next) joinNew(next.room, next.key, { kv: next.kv });
    else joinNew(null);
  }
  refreshIdUI();
});
</script>
