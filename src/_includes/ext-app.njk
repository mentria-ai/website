<!DOCTYPE html>
{% set siteLocale = (lang or "en") | findLocale %}{% set siteCode = (siteLocale.code | lower) if siteLocale else "en" %}<html lang="{{ lang or 'en' }}" class="ext-app" data-release="{{ releaseTag }}" data-site-code="{{ siteCode }}"{% if unlockTool %} data-unlock-tool{% endif %}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    {% include "site/csp.njk" %}
    {%- if usesThree %}
    {% include "site/importmap.njk" %}
    {%- endif %}
    <meta name="robots" content="noindex, nofollow">
    <title>{{ title }}</title>
    <link rel="icon" href="/assets/img/favicon-96x96.png" type="image/png">
    <link rel="apple-touch-icon" href="/assets/img/icon-192x192.png">
    <link rel="stylesheet" href="/assets/css/style.css?v={{ buildHash }}">
    <link rel="stylesheet" href="/assets/css/terminal.css?v={{ buildHash }}">
    <script src="/assets/js/mentria-store.js?v={{ buildHash }}"></script>
    {%- if releaseTag == "beta" %}
    <script>
      (function () {
        try {
          var l = JSON.parse(localStorage.getItem('mentria.keyring.local') || 'null');
          if (l && l.enabled === true && localStorage.getItem('mentria.store.keyring.vault')) import('/assets/js/mentria-unlock.js').then(function (m) { return m.ready(); }).catch(function () {});
        } catch (e) {}
      })();
    </script>
    {%- endif %}
    {%- if not appPlain %}
    <script src="/assets/js/mentria-gamepad.js?v={{ buildHash }}" defer></script>
    <script src="/assets/js/mentria-input-help.js?v={{ buildHash }}" defer></script>
    {%- endif %}
    <style>
      html.ext-app, html.ext-app body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #04060a; }
      html.ext-app body::before, html.ext-app body::after { content: none; display: none; }
    </style>
</head>
<body>
{{ content | safe }}
</body>
</html>
