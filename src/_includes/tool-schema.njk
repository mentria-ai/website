{%- set _entry = ((toolCatalog | groupby("slug"))[page.fileSlug] or [{}])[0] -%}
{%- set _categories = { "Game": "GameApplication", "Developer": "DeveloperApplication", "Security": "SecurityApplication", "Design": "DesignApplication", "Media": "MultimediaApplication", "Health": "HealthApplication" } -%}
{%- set _needsWebGPU = _entry.offline == "model" -%}
{%- set _category = toolSchemaCategory | default(_categories[_entry.category] or "UtilitiesApplication") -%}
{%- set _browserReq = toolSchemaBrowserReq | default(("tools_page.schema.requires_webgpu" if _needsWebGPU else "tools_page.schema.requires_js") | traw) -%}
{%- set _toolUrl = site.siteUrl ~ page.url -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": {{ (title | htmlDecode | striptags) | dump | safe }},
  "url": "{{ _toolUrl }}",
  "description": {{ (description | htmlDecode | striptags) | dump | safe }},
  "applicationCategory": "{{ _category }}",
  "operatingSystem": "Any (modern web browser)",
  "browserRequirements": {{ _browserReq | dump | safe }},
  {%- if _needsWebGPU %}
  "softwareRequirements": "WebGPU",
  {%- endif %}
  "softwareVersion": "{{ buildHash | default('1.0') }}",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "featureList": [
    {{ ("tools_page.schema.feature_browser" | traw) | dump | safe }},
    {{ ("tools_page.schema.feature_private" | traw) | dump | safe }},
    {{ ("tools_page.schema.feature_no_key" | traw) | dump | safe }}
    {%- if _entry.offline != "network" %},
    {{ ("tools_page.schema.feature_offline" | traw) | dump | safe }}
    {%- endif %}
  ],
  "publisher": { "@id": "{{ site.siteUrl }}/#organization" },
  "inLanguage": "{{ lang | default('en') }}"
}
</script>
