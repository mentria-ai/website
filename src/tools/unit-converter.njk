  const sym = (id) => COPY['s_' + id] || id;
  const unitName = (id) => COPY['u_' + id] || id;
  const fill = (template, map) => Object.keys(map).reduce((s, key) => s.split('{' + key + '}').join(map[key]), template);
  const isTight = (s) => TIGHT.indexOf(s) !== -1 || CJK.test(s.charAt(0));
  const withUnit = (num, id) => {
    const s = sym(id);
    return isTight(s) ? num + s : num + NBSP + s;
  };
  const rel = (exact) => (exact ? ' = ' : ' ≈ ');
  const echo = (value) => String(value).replace('.', fmt.decimal);
  const optionLabel = (id) => {
    const n = unitName(id);
    const s = sym(id);
    if (n.toLowerCase() === s.toLowerCase() || (CJK.test(s) && n.indexOf(s) !== -1)) return n;
    return fill(COPY.opt_fmt, { name: n, sym: s });
  };

  const storeGet = () => {
    try { return window.MentriaStore ? window.MentriaStore.get('tools', STORE_KEY) : null; } catch (_) { return null; }
  };
  const persist = () => {
    try { if (window.MentriaStore) window.MentriaStore.set('tools', STORE_KEY, { cat: state.cat, units: state.units }); } catch (_) {}
  };
  const validPair = (catId, ids) => Array.isArray(ids) && ids.length === 2 && ids.every((id) => {
    const u = Units.unit(id);
    return !!u && u.cat === catId;
  });
  const restore = () => {
    const saved = storeGet();
    if (!saved || typeof saved !== 'object') return;
    const units = saved.units && typeof saved.units === 'object' ? saved.units : {};
    Units.CATEGORIES.forEach((cat) => {
      if (validPair(cat.id, units[cat.id])) state.units[cat.id] = units[cat.id].slice();
    });
    if (Units.category(saved.cat)) state.cat = saved.cat;
  };

  const fillSelect = (select, cat, selected) => {
    select.textContent = '';
    cat.sets.forEach((set) => {
      let parent = select;
      if (set.group) {
        parent = document.createElement('optgroup');
        parent.label = COPY['grp_' + set.group];
        select.appendChild(parent);
      }
      set.ids.forEach((id) => {
        const option = document.createElement('option');
        option.value = id;
        option.textContent = optionLabel(id);
        parent.appendChild(option);
      });
    });
    select.value = selected;
  };

  const renderSides = () => {
    SIDES.forEach((k) => {
      sides[k].name.textContent = unitName(unitOf(k));
      sides[k].sign.hidden = state.cat === 'fuel';
      sides[k].box.classList.toggle('is-anchor', state.anchor === k);
    });
  };

  const factorLine = (from, to, f, exact) => withUnit(fmt.format(1), from) + rel(exact) + withUnit(fmt.format(f), to);

  const renderFormula = () => {
    const a = unitOf('a');
    const b = unitOf('b');
    const d = Units.describe(a, b);
    const lines = [];
    let label = COPY.factor;
    if (d.type === 'same') {
      lines.push(factorLine(a, b, 1, true));
    } else if (d.type === 'factor') {
      lines.push(factorLine(a, b, d.f, d.exact));
      lines.push(factorLine(b, a, d.inverse, d.inverseExact));
    } else if (d.type === 'formula') {
      label = COPY.formula;
      lines.push(sym(b) + ' = ' + d.parts.map((p) => (p === '@' ? sym(a) : typeof p === 'number' ? fmt.format(p) : p)).join(''));
    } else {
      label = COPY.formula;
      lines.push(sym(b) + rel(d.exact) + fmt.format(d.k) + ' ÷ ' + sym(a));
    }
    formulaLabel.textContent = label;
    formulaText.textContent = '';
    lines.forEach((line) => {
      const span = document.createElement('span');
      span.className = 'uc__formula-line';
      span.textContent = line;
      formulaText.appendChild(span);
    });
  };

  const renderTable = () => {
    const a = unitOf('a');
    const b = unitOf('b');
    captionEl.textContent = fill(COPY.ref_caption, { a: sym(a), b: sym(b) });
    thA.textContent = sym(a);
    thB.textContent = sym(b);
    rowsEl.textContent = '';
    Units.rows(a).forEach((x) => {
      const r = Units.convert(a, b, x);
      const tr = document.createElement('tr');
      const th = document.createElement('th');
      th.scope = 'row';
      th.textContent = fmt.format(x);
      const td = document.createElement('td');
      td.textContent = fmt.format(r.value, Units.digits(r.value, r.scale));
      tr.appendChild(th);
      tr.appendChild(td);
      rowsEl.appendChild(tr);
    });
  };

  const showStatus = (text, tone, warn, immediate) => {
    const apply = () => {
      statusTimer = 0;
      sentenceEl.textContent = text;
      if (tone) statusEl.dataset.tone = tone;
      else delete statusEl.dataset.tone;
      warnEl.textContent = warn;
      warnEl.hidden = !warn;
    };
    if (statusTimer) clearTimeout(statusTimer);
    statusTimer = 0;
    if (immediate) apply();
    else statusTimer = setTimeout(apply, STATUS_DELAY);
  };

  const compute = (immediate) => {
    const src = state.anchor;
    const from = unitOf(src);
    const to = unitOf(other(src));
    const input = sides[src].input;
    const target = sides[other(src)].input;
    const parsed = Units.parse(input.value, fmt.decimal);
    let problem = '';
    if (parsed.state === 'invalid') problem = fill(COPY.invalid, { example: fmt.format(12.5) });
    else if (parsed.state === 'overflow') problem = COPY.too_big;
    else if (parsed.state === 'ok' && state.cat === 'fuel' && parsed.value < 0) problem = COPY.negative_fuel;
    if (problem) input.setAttribute('aria-invalid', 'true');
    else input.removeAttribute('aria-invalid');
    target.removeAttribute('aria-invalid');
    renderSides();
    if (problem || parsed.state !== 'ok') {
      target.value = '';
      copyText = '';
      copyBtn.disabled = true;
      showStatus(problem, problem ? 'err' : '', '', immediate);
      return;
    }
    const r = Units.convert(from, to, parsed.value);
    const d = Units.digits(r.value, r.scale);
    target.value = fmt.format(r.value, d, false);
    const sentence = withUnit(fmt.format(parsed.value), from) + rel(Units.isExact(r.value, r.scale)) + withUnit(fmt.format(r.value, d), to);
    const warn = state.cat === 'temperature' && Units.kelvin(from, parsed.value) < -1e-9 ? COPY.below_zero : '';
    copyText = sentence.split(NBSP).join(' ');
    copyBtn.disabled = false;
    showStatus(sentence, '', warn, immediate);
  };

  const refresh = () => {
    renderSides();
    renderFormula();
    renderTable();
    compute(true);
  };

  const setCategory = (id) => {
    const cat = Units.category(id);
    if (!cat) return;
    state.cat = id;
    fillSelect(sides.a.select, cat, unitOf('a'));
    fillSelect(sides.b.select, cat, unitOf('b'));
    refresh();
  };

  const flipSign = (k) => {
    const input = sides[k].input;
    const raw = input.value.trim();
    const head = raw.charAt(0);
    input.value = head === '-' || head === '\u2212' ? raw.slice(1) : '-' + (head === '+' ? raw.slice(1) : raw);
    state.anchor = k;
    compute(true);
    if (!raw) input.focus();
  };

  const nudge = (k, e) => {
    if (e.isComposing || e.keyCode === 229) return;
    if ((e.key !== 'ArrowUp' && e.key !== 'ArrowDown') || e.altKey || e.ctrlKey || e.metaKey) return;
    const input = sides[k].input;
    const p = Units.parse(input.value, fmt.decimal);
    if (p.state !== 'ok' && p.state !== 'empty') return;
    e.preventDefault();
    const step = (e.shiftKey ? 10 : 1) * (e.key === 'ArrowUp' ? 1 : -1);
    let next = Number(((p.state === 'ok' ? p.value : 0) + step).toPrecision(12));
    if (state.cat === 'fuel' && next < 0) next = 0;
    input.value = echo(next);
    state.anchor = k;
    compute(true);
  };

  const matchUnit = (cat, token) => {
    const raw = String(token == null ? '' : token).trim();
    if (!raw) return null;
    const low = raw.toLowerCase();
    const aka = Units.alias(raw);
    const tests = [
      (id) => id === low,
      (id) => sym(id) === raw,
      (id) => sym(id).toLowerCase() === low,
      (id) => unitName(id).toLowerCase() === low,
      (id) => id === aka
    ];
    for (let i = 0; i < tests.length; i++) {
      const hit = cat.ids.find(tests[i]);
      if (hit) return hit;
    }
    return null;
  };

  const resolvePair = (from, to) => {
    const order = [Units.category(state.cat)].concat(Units.CATEGORIES.filter((c) => c.id !== state.cat));
    for (let i = 0; i < order.length; i++) {
      const a = matchUnit(order[i], from);
      const b = a ? matchUnit(order[i], to) : null;
      if (a && b) return { cat: order[i].id, from: a, to: b };
    }
    return null;
  };

  restore();

  const catSeg = MentriaUI.segmented(catsEl, (value) => {
    setCategory(value);
    persist();
  });

  const load = (found, value) => {
    state.units[found.cat] = [found.from, found.to];
    state.anchor = 'a';
    if (typeof value === 'number') sides.a.input.value = echo(value);
    catSeg.set(found.cat);
    setCategory(found.cat);
    persist();
  };

  SIDES.forEach((k) => {
    const s = sides[k];
    s.input.addEventListener('input', () => {
      state.anchor = k;
      compute(false);
    });
    s.input.addEventListener('keydown', (e) => nudge(k, e));
    s.select.addEventListener('change', () => {
      if (!Units.unit(s.select.value)) return;
      pair()[k === 'a' ? 0 : 1] = s.select.value;
      refresh();
      persist();
    });
    s.sign.addEventListener('click', () => flipSign(k));
  });

  swapBtn.addEventListener('click', () => {
    pair().reverse();
    sides.a.select.value = unitOf('a');
    sides.b.select.value = unitOf('b');
    swapBtn.classList.toggle('is-flipped');
    refresh();
    persist();
  });

  MentriaUI.copyButton(copyBtn, () => copyText, { copiedText: COPY.copied, failedText: COPY.copy_failed });

  document.addEventListener('mentria:localechange', () => {
    const lookup = window.MentriaI18n && window.MentriaI18n.t;
    if (typeof lookup === 'function') {
      Object.keys(COPY).forEach((key) => {
        const v = lookup('tool.unit-converter.' + key);
        if (typeof v === 'string') COPY[key] = v;
      });
    }
    const anchorInput = sides[state.anchor].input;
    const p = Units.parse(anchorInput.value, fmt.decimal);
    fmt = Units.formatter(pageLang());
    if (p.state === 'ok') anchorInput.value = echo(p.value);
    copyBtn.textContent = COPY.copy;
    setCategory(state.cat);
  });

  catSeg.set(state.cat);
  setCategory(state.cat);

  (() => {
    let q;
    try { q = new URLSearchParams(location.search); } catch (_) { return; }
    if (!q.has('from') && !q.has('to') && !q.has('v')) return;
    const found = resolvePair(q.get('from'), q.get('to'));
    const p = q.has('v') ? Units.parse(q.get('v'), '.') : null;
    const value = p && p.state === 'ok' ? p.value : undefined;
    try { history.replaceState(history.state, '', location.pathname + location.hash); } catch (_) {}
    if (found) {
      load(found, value);
    } else if (typeof value === 'number') {
      sides.a.input.value = echo(value);
      state.anchor = 'a';
      compute(true);
    }
  })();

  import('/assets/js/mentria-bus.js').then(({ MentriaBus }) => {
    MentriaBus.provide('unit.convert', (args) => {
      const o = args || {};
      const value = Number(o.value);
      if (!Number.isFinite(value)) throw new Error('value must be a finite number');
      const found = resolvePair(o.from, o.to);
      if (!found) throw new Error('unknown or mismatched units; use ids such as km, mi, kg, lb, c, f, l, gal_us, m2, kmh, mph, hr, gb, gib, psi, kwh, l100km, mpg_us, deg, rad');
      if (found.cat === 'fuel' && value < 0) throw new Error('fuel economy cannot be negative');
      load(found, value);
      const r = Units.convert(found.from, found.to, value);
      const shown = isFinite(r.value) ? Number(r.value.toPrecision(Units.digits(r.value, r.scale))) : r.value;
      return { result: copyText, value: shown, from: found.from, to: found.to, category: found.cat };
    }, {
      description: 'Convert a number between units of length, weight, temperature, volume, area, speed, time, data size, pressure, energy, fuel economy or angle; the result is shown in the tool.',
      ai: true,
      parameters: {
        type: 'object',
        properties: {
          value: { type: 'number' },
          from: { type: 'string', description: 'unit id or symbol, e.g. km, °F, US gal, GiB, L/100 km' },
          to: { type: 'string', description: 'unit id or symbol in the same category' }
        },
        required: ['value', 'from', 'to']
      }
    });
  }).catch(() => {});
})();
</script>

