---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/tools/unit-converter/index.html"
eleventyComputed:
  lang: "{{ locale.code }}"
  title: "{{ 'tools.unit-converter.title' | t }}"
  description: "{{ 'tools.unit-converter.lede' | t }}"
---
<section class="hero" style="padding-top:1rem;">
  <p class="eyebrow eyebrow--crumbs"><a class="eyebrow__link" href="{{ locale.pathPrefix }}/" aria-label="{{ 'nav.home' | t }}">~</a><span class="eyebrow__sep">/</span><a class="eyebrow__link" href="{{ locale.pathPrefix }}/tools/">tools</a><span class="eyebrow__sep">/</span><span class="eyebrow__current">unit-converter</span></p>
  <h1>{{ "tools.unit-converter.title" | t }}</h1>
  <p>{{ "tools.unit-converter.lede" | t }}</p>
  {% include "tldr.njk" %}
</section>

{% set terminalTitle = "unit-converter.js" %}
{% include "terminal-frame-open.njk" %}
<section class="uc" id="uc">

  <div class="m-seg uc__cats" id="uc-cats" aria-label="{{ 'tool.unit-converter.cats_label' | t }}">
    <button type="button" data-value="length">{{ "tool.unit-converter.cat_length" | t }}</button>
    <button type="button" data-value="mass">{{ "tool.unit-converter.cat_mass" | t }}</button>
    <button type="button" data-value="temperature">{{ "tool.unit-converter.cat_temperature" | t }}</button>
    <button type="button" data-value="volume">{{ "tool.unit-converter.cat_volume" | t }}</button>
    <button type="button" data-value="area">{{ "tool.unit-converter.cat_area" | t }}</button>
    <button type="button" data-value="speed">{{ "tool.unit-converter.cat_speed" | t }}</button>
    <button type="button" data-value="time">{{ "tool.unit-converter.cat_time" | t }}</button>
    <button type="button" data-value="data">{{ "tool.unit-converter.cat_data" | t }}</button>
    <button type="button" data-value="pressure">{{ "tool.unit-converter.cat_pressure" | t }}</button>
    <button type="button" data-value="energy">{{ "tool.unit-converter.cat_energy" | t }}</button>
    <button type="button" data-value="fuel">{{ "tool.unit-converter.cat_fuel" | t }}</button>
    <button type="button" data-value="angle">{{ "tool.unit-converter.cat_angle" | t }}</button>
  </div>

  <div class="uc__pair">
    <div class="uc__side is-anchor" id="uc-side-a">
      <label class="uc__cap" id="uc-cap-a" for="uc-val-a">{{ "tool.unit-converter.from" | t }}</label>
      <div class="uc__field">
        <input class="m-input uc__num" id="uc-val-a" type="text" inputmode="decimal" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" enterkeyhint="done" value="1" aria-labelledby="uc-cap-a uc-name-a" aria-describedby="uc-status">
        <button class="m-btn m-btn--ghost uc__sign" id="uc-sign-a" type="button" aria-label="{{ 'tool.unit-converter.sign_a' | t }}" title="{{ 'tool.unit-converter.sign_a' | t }}">±</button>
      </div>
      <span class="sr-only" id="uc-name-a"></span>
      <select class="m-input uc__unit" id="uc-unit-a" aria-label="{{ 'tool.unit-converter.unit_from' | t }}"></select>
    </div>

    <button class="m-btn m-btn--ghost m-btn--icon uc__swap" id="uc-swap" type="button" aria-label="{{ 'tool.unit-converter.swap' | t }}" title="{{ 'tool.unit-converter.swap' | t }}">
      <svg class="uc__swap-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 8h15m-4-4 4 4-4 4M20 16H5m4-4-4 4 4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <div class="uc__side" id="uc-side-b">
      <label class="uc__cap" id="uc-cap-b" for="uc-val-b">{{ "tool.unit-converter.to" | t }}</label>
      <div class="uc__field">
        <input class="m-input uc__num" id="uc-val-b" type="text" inputmode="decimal" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" enterkeyhint="done" aria-labelledby="uc-cap-b uc-name-b" aria-describedby="uc-status">
        <button class="m-btn m-btn--ghost uc__sign" id="uc-sign-b" type="button" aria-label="{{ 'tool.unit-converter.sign_b' | t }}" title="{{ 'tool.unit-converter.sign_b' | t }}">±</button>
      </div>
      <span class="sr-only" id="uc-name-b"></span>
      <select class="m-input uc__unit" id="uc-unit-b" aria-label="{{ 'tool.unit-converter.unit_to' | t }}"></select>
    </div>
  </div>

  <div class="uc__out">
    <div class="uc__status" id="uc-status" role="status" aria-live="polite" aria-atomic="true">
      <span class="uc__sentence" id="uc-sentence"></span>
      <span class="uc__warn" id="uc-warn" hidden></span>
    </div>
    <button class="m-btn m-btn--ghost uc__copy" id="uc-copy" type="button" disabled>{{ "tool.unit-converter.copy" | t }}</button>
  </div>

  <p class="uc__formula"><span class="uc__formula-label" id="uc-formula-label"></span><span class="uc__formula-text" id="uc-formula-text"></span></p>

  <table class="uc__table">
    <caption class="uc__caption" id="uc-caption"></caption>
    <thead><tr><th scope="col" id="uc-th-a"></th><th scope="col" id="uc-th-b"></th></tr></thead>
    <tbody id="uc-rows"></tbody>
  </table>

  <p class="uc__note">{{ "tool.unit-converter.privacy_note" | t }}</p>

</section>
{% include "terminal-frame-close.njk" %}
{% include "tool-schema.njk" %}

