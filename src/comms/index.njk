const initIdentity = async () => {
  try {
    myId = await CID.ensureKeypair();
    myFp = await CID.fingerprint(myId.publicJwk);
    myLegacyFp = await CID.legacyFingerprint(myId.publicJwk);
    try { mySign = await CID.ensureSigningKey(); } catch (_) { mySign = null; }
    if (mySign) { try { mySign.link = { spub: mySign.spub, s: await signLink(mySign.signKey, myId.publicJwk) }; } catch (_) { mySign.link = null; } }
    startBridge().catch(() => {});
    if (els.idSig) { els.idSig.hidden = !mySign; els.idSig.textContent = mySign ? fmt(T.sign.my_key, { fp: mySign.sigFp }) : ''; }
    openHistory();
    try { await CID.migrateFingerprints(); } catch (_) {}
    myProfile = CID.getProfile();
    els.idName.value = myProfile.name;
    els.idFp.textContent = myFp;
    paintAvatar(els.profAvatar, (myProfile && myProfile.name) || '', myFp);
    refreshIdUI();
    try { unreadMap = CID.getUnread(); } catch (_) { unreadMap = {}; }
    renderContacts();
    syncOsBadge();
    broadcastProfile();
    if (joinedLocked && joinTarget && currentRoomName === joinTarget.room && !isDmRoom(currentRoomName)) {
      joinedLocked = false;
      joinNew(joinTarget.room, joinTarget.key, { kv: joinTarget.kv });
    }
    await initRingToken();
    refreshNotifBanner();
    subscribeInbox();
    subscribeUnread();
    refreshPasskeyOffer(false);
  } catch (err) {
    notice(fmt(T.log.identity_err, { reason: why(err) }));
  }
};

const krOpen = () => {
  if (krOpening) return krOpening;
  krOpening = (async () => {
    const I = window.MentriaIdentity;
    if (!krLinked() || (krOpened && I.isUnlocked())) return false;
    let list = [];
    try {
      list = await KR.secrets('identity');
      if (!list.length) {
        if (KR.state().unlocked) { krBroken = true; refreshIdUI(); }
        return false;
      }
      await I.openLinked(list.map((x) => x.bytes));
    } catch (_) {
      krBroken = true;
      refreshIdUI();
      return false;
    } finally {
      list.forEach((x) => { try { x.bytes.fill(0); } catch (_) {} });
    }
    krOpened = true;
    await initIdentity();
    refreshPasskeyOffer(krSawLocked);
    await krSettleRemember();
    krRetire();
    return true;
  })().finally(() => { krOpening = null; });
  return krOpening;
};

let krAdopting = null;
const krAdopt = () => {
  if (!krAdopting) krAdopting = krAdoptOnce().finally(() => { krAdopting = null; });
  return krAdopting;
};
const krAdoptOnce = async () => {
  const I = window.MentriaIdentity;
  if (!krLinked() || krOpened || !I.isUnlocked()) return false;
  let list = [];
  let hit = false;
  try {
    list = await KR.secrets('identity');
    for (const x of list) {
      if (await I.matchesVault(x.bytes)) { hit = true; break; }
    }
  } catch (_) {
    hit = false;
  } finally {
    list.forEach((x) => { try { x.bytes.fill(0); } catch (_) {} });
  }
  krLinkMode = null;
  if (!hit || !I.isUnlocked()) {
    if (KR.state().unlocked) krBroken = true;
    refreshIdUI();
    return false;
  }
  krOpened = true;
  refreshIdUI();
  refreshPasskeyOffer(false);
  await krSettleRemember();
  krRetire();
  return true;
};

const krRetire = async () => {
  const I = window.MentriaIdentity;
  if (krRetiring || !krOn() || !krOpened || !krHas()) return;
  const r = KR.retirement('identity');
  if (!r || !r.ready) return;
  krRetiring = true;
  let cur = null;
  try {
    cur = await KR.secret('identity');
    const kcv = cur ? await I.matchesVault(cur) : '';
    if (!kcv) return;
    const id = I.legacyPasskeyId();
    if (!I.retireLegacy(kcv, { dropDevice: !!KR.state().hasDevice || KR.rememberDecision() === 'off' })) return;
    if (id && window.PublicKeyCredential && typeof PublicKeyCredential.signalUnknownCredential === 'function') {
      try { await PublicKeyCredential.signalUnknownCredential({ rpId: location.hostname, credentialId: id }); } catch (_) {}
    }
    await KR.markRetired('identity');
  } catch (_) {
  } finally {
    if (cur) cur.fill(0);
    krRetiring = false;
  }
};

const krDropRetiredDevice = async () => {
  const I = window.MentriaIdentity;
  if (!I.hasDeviceUnlock() || !KR.state().hasDevice) return;
  const r = KR.retirement('identity');
  if (!r || !r.blockers || !r.blockers.includes('already-retired')) return;
  let cur = null;
  try {
    cur = await KR.secret('identity');
    const kcv = cur ? await I.matchesVault(cur) : '';
    if (kcv) I.retireLegacy(kcv, { dropDevice: true });
  } catch (_) {
  } finally {
    if (cur) cur.fill(0);
  }
};

const krKeepRemembered = async () => {
  const I = window.MentriaIdentity;
  if (!I || KR.rememberDecision() === 'off' || !(await I.deviceUnlockHere())) return;
  try {
    if (!KR.state().hasDevice) {
      await KR.setRemember(true, { decided: true });
    } else {
      KR.setRememberPending(false);
      KR.setRememberDecision('on');
    }
  } catch (e) {
    if (e && e.message === 'confirm-needed') KR.setRememberPending(true);
  }
};

const krSettleOnce = async () => {
  const I = window.MentriaIdentity;
  if (!I) return;
  if (KR.rememberDecision() === 'off') { KR.setRememberPending(false); return; }
  const pending = KR.rememberPending();
  if (!pending && (krNoDeviceHere || KR.rememberDecision() || !krHas())) return;
  if (!(await I.deviceUnlockHere())) {
    if (pending) KR.setRememberPending(false);
    else krNoDeviceHere = true;
    return;
  }
  if (KR.state().hasDevice) {
    KR.setRememberPending(false);
    KR.setRememberDecision('on');
    return;
  }
  if (!pending) KR.setRememberPending(true);
  if (!KR.hasRootBytes()) return;
  await KR.setRemember(true, { decided: true });
  await krDropRetiredDevice();
};

const krSettleRemember = () => {
  if (!krSettleP) krSettleP = krSettleOnce().catch(() => {}).then(() => { krSettleP = null; });
  return krSettleP;
};

const krLinkNow = async () => {
  const I = window.MentriaIdentity;
  if (!krOn() || krBroken || krHas() || !I.isUnlocked()) return false;
  const copy = new Uint8Array(I.getSecret());
  try {
    await KR.link('identity', copy);
  } catch (e) {
    krErr(e);
    return false;
  } finally {
    copy.fill(0);
  }
  krOpened = true;
  krLinkMode = null;
  await krKeepRemembered();
  refreshIdUI();
  refreshPasskeyOffer(false);
  return true;
};

const krChanged = (s) => {
  if (!KR) return;
  if (krOpened && !s.unlocked) { location.reload(); return; }
  if (s.epoch !== krEpoch) {
    if (krEpoch !== null) krBroken = false;
    krEpoch = s.epoch;
  }
  if (!s.unlocked) krSawLocked = true;
  if (krLinkMode === 'offer' && s.setUp) krLinkMode = 'card';
  const I = window.MentriaIdentity;
  if (s.unlocked && I && !krSetupBusy) {
    krSettleRemember();
    if (krLinked() && !I.isUnlocked()) krOpen();
    else if (krLinked() && !krOpened) krAdopt();
    else if (I.isSetUp() && I.isUnlocked() && !krHas() && !krBroken) krLinkNow();
  }
  refreshIdUI();
};

const krVerifyOld = async (code) => {
  try { await window.MentriaIdentity.unlock(code); return true; } catch (_) { return false; }
};

const krSetupLegacy = async ({ typed, verify } = {}) => {
  const I = window.MentriaIdentity;
  if (!krOn() || krBroken || !I.isUnlocked() || krHas()) return;
  const opts = { service: 'identity', secret: new Uint8Array(I.getSecret()) };
  let ok = false;
  try {
    const code = krSavedCode(typed);
    if (code) opts.knownCode = code;
    else if (typed) opts.knownPassphrase = typed;
    else if (verify) opts.verifyCode = krVerifyOld;
    if (KR.rememberDecision() !== 'off' && await I.deviceUnlockHere()) opts.remember = true;
    opts.onRemember = (on) => {
      KR.setRememberDecision(on ? 'on' : 'off');
      if (!on) KR.setRememberPending(false);
    };
    krSetupBusy = true;
    try { ok = await (await krUi()).showSetup(opts); } catch (_) { ok = false; }
  } finally {
    krSetupBusy = false;
    opts.secret.fill(0);
  }
  if (ok && krHas()) {
    krOpened = true;
    krLinkMode = null;
    await krKeepRemembered();
  } else if (KR.state().unlocked) await krLinkNow();
  refreshIdUI();
  refreshPasskeyOffer(false);
};

const krAfterLegacy = async (opts) => {
  const I = window.MentriaIdentity;
  if (!krOn() || krBroken || !I.isUnlocked() || krOpened) return;
  const s = KR.state();
  if (krHas()) {
    if (s.unlocked) { await krAdopt(); return; }
    krLinkMode = 'card';
    refreshIdUI();
    return;
  }
  if (s.unlocked) { await krLinkNow(); return; }
  if (s.setUp) { krLinkMode = 'card'; refreshIdUI(); return; }
  if (opts.auto) { krLinkMode = 'offer'; refreshIdUI(); return; }
  await krSetupLegacy(opts);
};

const krLegacyUnlock = async (typed) => {
  const I = window.MentriaIdentity;
  try {
    await I.unlock(typed);
    return typed;
  } catch (e) {
    const n = KRC ? KRC.normalizeCode(typed) : null;
    const alt = n && n.kind === 'c20' ? KRC.formatCode(n) : null;
    if (!alt || alt === typed) throw e;
    await I.unlock(alt);
    return alt;
  }
};

const krCreateIdentity = async () => {
  const I = window.MentriaIdentity;
  const s = KR.state();
  if (!s.setUp) {
    if (I.isSetUp()) throw new Error('already-set-up');
    const ui = await krUi();
    const bytes = await I.createLinked();
    let ok = false;
    try {
      krSetupBusy = true;
      try { ok = await ui.showSetup({ service: 'identity', secret: bytes }); } catch (_) { ok = false; }
      krSetupBusy = false;
      if (!ok || !krHas()) {
        if (!ok && !KR.state().setUp) krDeclined = true;
        return false;
      }
      await I.saveLinked(bytes);
    } finally {
      krSetupBusy = false;
      bytes.fill(0);
    }
    krOpened = true;
    return true;
  }
  if (!s.unlocked) {
    krSlot(els.obCard, true, () => { krSlot(els.obCard, false); els.obCreate.click(); });
    return false;
  }
  krSlot(els.obCard, false);
  if (krHas()) {
    const have = await KR.secrets('identity');
    try {
      if (!have.length) throw new Error('locked');
      await I.rebuildLinked(have.map((x) => x.bytes));
    } finally {
      have.forEach((x) => { try { x.bytes.fill(0); } catch (_) {} });
    }
    krOpened = true;
    return 'rebuilt';
  }
  const bytes = await I.createLinked();
  try {
    if (krHas()) return krCreateIdentity();
    await KR.link('identity', bytes);
    await I.saveLinked(bytes);
  } finally {
    bytes.fill(0);
  }
  krOpened = true;
  return true;
};

