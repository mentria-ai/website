---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/404.html"
eleventyComputed:
  lang: "{{ locale.code }}"
  title: "404"
robots: "noindex, nofollow"
notFound: true
eleventyExcludeFromCollections: true
eleventyExcludeFromSitemap: true
---
{%- if not locale.pathPrefix %}
<script>
  (function () {
    try {
      var locs = window.MENTRIA_LOCALES || [], path = location.pathname || '/', target = null, i;
      if (path.slice(-9) === '/404.html') return;
      for (i = 0; i < locs.length; i++) {
        var pre = locs[i].prefix;
        if (pre && (path === pre || path.indexOf(pre + '/') === 0)) target = locs[i];
      }
      if (target) {
        if ((window.MENTRIA_EN_ONLY || []).indexOf(path.slice(target.prefix.length) || '/') >= 0) return;
      } else {
        var pref = localStorage.getItem('mentria_lang');
        for (i = 0; i < locs.length; i++) if (locs[i].code === pref) target = locs[i];
      }
      if (!target || !target.prefix) return;
      sessionStorage.setItem('mentria_404_from', JSON.stringify({ path: path + location.search + location.hash, at: Date.now() }));
      document.documentElement.style.visibility = 'hidden';
      setTimeout(function () { document.documentElement.style.visibility = ''; }, 3000);
      location.replace(target.prefix + '/404.html');
    } catch (_) {}
  })();
</script>
{%- else %}
<script>
  (function () {
    try {
      var raw = sessionStorage.getItem('mentria_404_from');
      if (!raw) return;
      sessionStorage.removeItem('mentria_404_from');
      var from = JSON.parse(raw);
      if (!from || typeof from.path !== 'string' || !(Date.now() - from.at < 10000)) return;
      if (from.path.charAt(0) !== '/' || from.path.charAt(1) === '/') return;
      history.replaceState(history.state, '', from.path);
    } catch (_) {}
  })();
</script>
{%- endif %}
<section class="hero" style="padding-top:3rem;">
    <div style="font-family: var(--font-mono); text-align: center;">
        <p style="color: var(--syn-pink); font-size: 0.9rem;">{{ "errors.not_found_cmd_prefix" | t }} <span id="nf-path">{{ page.url | default('/unknown') }}</span></p>
<script>try { document.getElementById('nf-path').textContent = location.pathname + location.search; } catch (_) {}</script>
        <h1 style="font-size: clamp(3rem, 8vw, 5rem); margin: 1rem 0;">404</h1>
        <p style="color: var(--syn-amber);">{{ "errors.not_found_msg" | t }}<span class="cursor-blink"></span></p>
        <div style="margin-top: 2rem; font-size: 0.9rem; color: var(--term-muted);">
            <p>{{ "errors.try_these" | t }}</p>
            <p style="margin-top: 0.5rem;">
                <a href="{{ '/' | localeUrl(lang) }}" style="margin-right: 1.5rem;">~/home</a>
                <a href="{{ '/learn/' | localeUrl(lang) }}" style="margin-right: 1.5rem;">~/learn</a>
                <a href="{{ '/tools/' | localeUrl(lang) }}">~/tools</a>
            </p>
        </div>
    </div>
</section>
