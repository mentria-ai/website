        <button type="button" class="ph-btn ph-btn--sm" id="ph-share">{{ "tool.phosphor.ghost_share" | t }}</button>
        <button type="button" class="ph-btn ph-btn--sm" id="ph-import">{{ "tool.phosphor.ghost_import" | t }}</button>
