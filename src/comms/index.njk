};

const escapeHtml = (s) => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmtHtml = (tpl, vars) => escapeHtml(tpl).replace(/\{(\w+)\}/g, (m, k) => (own(vars, k) && vars[k] != null ? String(vars[k]) : m));
const fmtKB = (n) => fmt(T.files.kb, { n: num1(n / 1024) });
const fmtMB = (n) => fmt(T.files.mb, { n: num1(n / 1024 / 1024) });
const fmtSize = (n) => n >= 1024 * 1024 ? fmtMB(n) : fmtKB(n);
