---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/tools/json-formatter/index.html"
eleventyComputed:
  lang: "{{ locale.code }}"
  title: "{{ 'tools.json-formatter.title' | t }}"
  description: "{{ 'tools.json-formatter.lede' | t }}"
---
<section class="hero" style="padding-top:1rem;">
  <p class="eyebrow eyebrow--crumbs"><a class="eyebrow__link" href="{{ locale.pathPrefix }}/" aria-label="{{ 'nav.home' | t }}">~</a><span class="eyebrow__sep">/</span><a class="eyebrow__link" href="{{ locale.pathPrefix }}/tools/">tools</a><span class="eyebrow__sep">/</span><span class="eyebrow__current">json-formatter</span></p>
  <h1>{{ "tools.json-formatter.title" | t }}</h1>
  <p>{{ "tools.json-formatter.lede" | t }}</p>
  {% include "tldr.njk" %}
</section>

{% set terminalTitle = "json-formatter.js" %}
{% include "terminal-frame-open.njk" %}
<section class="jf" id="jf">

  <div class="jf__bar">
    <div class="jf__group">
      <span class="jf__label" id="jf-style-label">{{ "tool.json-formatter.label_output" | t }}</span>
      <div class="m-seg jf__seg" id="jf-style" aria-labelledby="jf-style-label">
        <button type="button" data-value="format">{{ "tool.json-formatter.style_format" | t }}</button>
        <button type="button" data-value="minify">{{ "tool.json-formatter.style_minify" | t }}</button>
      </div>
    </div>
    <div class="jf__group" id="jf-indent-group">
      <span class="jf__label" id="jf-indent-label">{{ "tool.json-formatter.label_indent" | t }}</span>
      <div class="m-seg jf__seg" id="jf-indent" aria-labelledby="jf-indent-label">
        <button type="button" data-value="2">{{ "tool.json-formatter.indent_2" | t }}</button>
        <button type="button" data-value="4">{{ "tool.json-formatter.indent_4" | t }}</button>
        <button type="button" data-value="tab">{{ "tool.json-formatter.indent_tab" | t }}</button>
      </div>
    </div>
    <button type="button" class="m-btn m-btn--ghost jf__sort" id="jf-sort" aria-pressed="false"><span class="jf__check" aria-hidden="true"></span><span>{{ "tool.json-formatter.btn_sort" | t }}</span></button>
  </div>

  <div class="jf__grid">
    <div class="jf__pane jf__pane--in">
      <div class="jf__head">
        <label class="jf__label" for="jf-input">{{ "tool.json-formatter.label_input" | t }}</label>
        <div class="jf__actions">
          <button type="button" class="m-btn m-btn--ghost jf__small" id="jf-open">{{ "tool.json-formatter.btn_open" | t }}</button>
          <button type="button" class="m-btn m-btn--ghost jf__small" id="jf-clear">{{ "tool.json-formatter.btn_clear" | t }}</button>
        </div>
      </div>
      <div class="jf__drop" id="jf-drop">
        <textarea class="jf__input" id="jf-input" spellcheck="false" autocomplete="off" autocapitalize="off" autocorrect="off" translate="no" dir="ltr" placeholder="{{ 'tool.json-formatter.input_placeholder' | t }}" aria-describedby="jf-state-text jf-error-msg"></textarea>
        <div class="jf__drop-hint" aria-hidden="true">{{ "tool.json-formatter.drop_hint" | t }}</div>
      </div>
      <input type="file" class="jf__file" id="jf-file" accept=".json,application/json,text/json,text/plain,.geojson,.webmanifest,.har" tabindex="-1" aria-hidden="true">
      <p class="jf__state" id="jf-state" data-state="empty">
        <span class="jf__state-dot" aria-hidden="true"></span>
        <span class="jf__state-text" id="jf-state-text">{{ "tool.json-formatter.state_empty" | t }}</span>
      </p>
      <div class="jf__box jf__box--err" id="jf-error" hidden>
        <p class="jf__box-msg" id="jf-error-msg"></p>
        <div class="jf__excerpt" id="jf-excerpt" translate="no" dir="ltr"></div>
        <button type="button" class="m-btn m-btn--ghost jf__small" id="jf-jump">{{ "tool.json-formatter.btn_jump" | t }}</button>
      </div>
      <div class="jf__box jf__box--warn" id="jf-warn" hidden>
        <p class="jf__box-msg" id="jf-warn-msg"></p>
        <button type="button" class="m-btn m-btn--ghost jf__small" id="jf-warn-jump">{{ "tool.json-formatter.btn_jump" | t }}</button>
      </div>
      <div class="jf__box jf__box--warn" id="jf-paused" hidden>
        <p class="jf__box-msg" id="jf-paused-msg"></p>
        <button type="button" class="m-btn m-btn--primary jf__small" id="jf-process">{{ "tool.json-formatter.btn_process" | t }}</button>
      </div>
    </div>

    <div class="jf__pane jf__pane--out" id="jf-out">
      <div class="jf__head">
        <div class="m-seg jf__seg" id="jf-view" aria-label="{{ 'tool.json-formatter.label_view' | t }}">
          <button type="button" data-value="text">{{ "tool.json-formatter.view_text" | t }}</button>
          <button type="button" data-value="tree">{{ "tool.json-formatter.view_tree" | t }}</button>
        </div>
        <div class="jf__actions">
          <button type="button" class="m-btn m-btn--ghost jf__small jf__copy" id="jf-copy" disabled><span class="jf__lbl">{{ "tool.json-formatter.btn_copy" | t }}</span><span class="jf__lbl-alt"></span></button>
          <button type="button" class="m-btn m-btn--ghost jf__small" id="jf-download" disabled>{{ "tool.json-formatter.btn_download" | t }}</button>
        </div>
      </div>
      <p class="jf__meta" id="jf-meta"></p>
      <p class="jf__empty" id="jf-empty">{{ "tool.json-formatter.output_empty" | t }}</p>
      <div class="jf__view" id="jf-textview" hidden>
        <pre class="jf__code" id="jf-code" role="region" tabindex="0" translate="no" dir="ltr" aria-label="{{ 'tool.json-formatter.label_code' | t }}"></pre>
        <p class="jf__note" id="jf-trunc" hidden></p>
      </div>
      <div class="jf__view" id="jf-treeview" hidden>
        <div class="jf__actions">
          <button type="button" class="m-btn m-btn--ghost jf__small" id="jf-expand">{{ "tool.json-formatter.btn_expand_all" | t }}</button>
          <button type="button" class="m-btn m-btn--ghost jf__small" id="jf-collapse">{{ "tool.json-formatter.btn_collapse_all" | t }}</button>
        </div>
        <div class="jf__pathbar">
          <span class="jf__label" id="jf-path-label">{{ "tool.json-formatter.label_path" | t }}</span>
          <code class="jf__path" id="jf-path" translate="no" dir="ltr" aria-labelledby="jf-path-label">$</code>
          <button type="button" class="m-btn m-btn--ghost jf__small jf__copy" id="jf-copy-path"><span class="jf__lbl">{{ "tool.json-formatter.btn_copy_path" | t }}</span><span class="jf__lbl-alt"></span></button>
        </div>
        <div class="jf__tree" id="jf-tree" role="region" translate="no" dir="ltr" aria-label="{{ 'tool.json-formatter.label_tree' | t }}" aria-describedby="jf-tree-hint"></div>
        <p class="jf__note jf__hint" id="jf-tree-hint">{{ "tool.json-formatter.tree_hint" | t }}</p>
      </div>
    </div>
  </div>

  <p class="m-status jf__status" id="jf-status" role="status" aria-live="polite"></p>
  <p class="jf-sr" id="jf-live" role="status" aria-live="polite"></p>
</section>
{% include "terminal-frame-close.njk" %}

