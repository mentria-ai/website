---
layout: deck-layout.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/learn/play/index.html"
eleventyExcludeFromSitemap: true
eleventyComputed:
  lang: "{{ locale.code }}"
  title: "{{ 'learn.play_title' | t }}"
  description: "{{ 'learn.lede' | t }}"
  robots: "noindex, nofollow"
---
<link rel="stylesheet" href="/assets/css/feed-deck.css?v={{ buildHash }}">
<link rel="stylesheet" href="/assets/css/pack.css?v={{ buildHash }}">

<h1 class="sr-only" id="packHeading">{{ "learn.play_title" | t }}</h1>
<div class="deck deck--pack" id="packRoot" data-prefix="{{ locale.pathPrefix }}" data-title-suffix=" · {{ 'learn.title' | traw }} | {{ site.title }}">
  <noscript><p class="pack-card pack-card--center">{{ "learn.no_js" | t }}</p></noscript>
</div>

{% include "pack-player-scripts.njk" %}
