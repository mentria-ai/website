---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/tools/breakout/index.html"
eleventyComputed:
  lang: "{{ locale.code }}"
  title: "{{ 'tools.breakout.title' | t }}"
  description: "{{ 'tools.breakout.lede' | t }}"
---
<div class="game-page">

<section class="hero" style="padding-top:1rem;">
  <p class="eyebrow eyebrow--crumbs"><a class="eyebrow__link" href="{{ locale.pathPrefix }}/">~</a><span class="eyebrow__sep">/</span><a class="eyebrow__link" href="{{ locale.pathPrefix }}/tools/">tools</a><span class="eyebrow__sep">/</span><span class="eyebrow__current">breakout</span></p>
  <h1>{{ "tools.breakout.title" | t }}<span style="color:var(--syn-cyan)">.</span>js</h1>
  <p>{{ "tools.breakout.lede" | t }}</p>
  {% include "tldr.njk" %}
</section>

{% set terminalTitle = "breakout.js" %}
{% set terminalHelpId = "breakout-help" %}
{% include "terminal-frame-open.njk" %}

<div id="breakout-help" popover class="game-help brk__help">
  <p class="game-help-title">{{ "tool.breakout.controls_title" | t }}</p>

  <div class="brk__method" data-brk-method="touch" data-input="touch">
    <p class="brk__method-head">
      <svg class="brk__glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 11.5V5.4a1.5 1.5 0 0 1 3 0v5.1"></path><path d="M12 8.9a1.5 1.5 0 0 1 3 0v2.6"></path><path d="M15 9.9a1.5 1.5 0 0 1 3 0V15a5 5 0 0 1-5 5h-1.2a5 5 0 0 1-4.1-2.1l-2.5-3.5a1.5 1.5 0 0 1 2.3-1.9L9 14.2"></path></svg>
      <span class="brk__method-name">{{ "tool.breakout.ctrl_touch" | t }}</span>
      <span class="brk__badge">{{ "tool.breakout.ctrl_last_used" | t }}</span>
    </p>
    <ul class="game-help-list">
      <li><span><span class="kbd">{{ "tool.breakout.chip_drag" | t }}</span></span><span class="game-help-label">{{ "tool.breakout.touch_move" | t }}</span></li>
      <li><span><span class="kbd">{{ "tool.breakout.chip_tap" | t }}</span></span><span class="game-help-label">{{ "tool.breakout.touch_launch" | t }}</span></li>
      <li><span><span class="kbd">❙❙</span></span><span class="game-help-label">{{ "tool.breakout.touch_pause" | t }}</span></li>
    </ul>
  </div>

  <div class="brk__method" data-brk-method="keyboard" data-input="keyboard">
    <p class="brk__method-head">
      <svg class="brk__glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2.6" y="6" width="18.8" height="12" rx="2.2"></rect><path d="M6.4 10h1.1M10 10h1.1M13.6 10h1.1M17.2 10h1.1M7.6 14h8.8"></path></svg>
      <span class="brk__method-name">{{ "tool.breakout.ctrl_keyboard" | t }}</span>
      <span class="brk__badge">{{ "tool.breakout.ctrl_last_used" | t }}</span>
    </p>
    <ul class="game-help-list">
      <li><span><span class="kbd">←</span><span class="kbd">→</span><span class="kbd">A</span><span class="kbd">D</span></span><span class="game-help-label">{{ "tool.breakout.kb_move" | t }}</span></li>
      <li><span><span class="kbd">SPACE</span></span><span class="game-help-label">{{ "tool.breakout.kb_launch" | t }}</span></li>
      <li><span><span class="kbd">P</span><span class="kbd">ESC</span></span><span class="game-help-label">{{ "tool.breakout.kb_pause" | t }}</span></li>
    </ul>
  </div>

  <div class="brk__method" data-brk-method="gamepad" data-input="gamepad">
    <p class="brk__method-head">
      <svg class="brk__glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6.6 6.6h10.8a3.6 3.6 0 0 1 3.5 2.8l1 4.5a2.7 2.7 0 0 1-2.7 3.3c-1 0-1.9-.5-2.4-1.4l-.8-1.3H8l-.8 1.3c-.5.9-1.4 1.4-2.4 1.4a2.7 2.7 0 0 1-2.7-3.3l1-4.5a3.6 3.6 0 0 1 3.5-2.8Z"></path><path d="M6.6 11.4h2.8M8 10v2.8"></path><circle cx="15.6" cy="10.6" r="0.9" fill="currentColor" stroke="none"></circle><circle cx="17.9" cy="12.6" r="0.9" fill="currentColor" stroke="none"></circle></svg>
      <span class="brk__method-name">{{ "tool.breakout.ctrl_gamepad" | t }}</span>
      <span class="brk__badge">{{ "tool.breakout.ctrl_last_used" | t }}</span>
    </p>
    <ul class="game-help-list">
      <li><span><span class="kbd">D-PAD</span><span class="kbd">L-STICK</span></span><span class="game-help-label">{{ "tool.breakout.pad_move" | t }}</span></li>
      <li><span><span class="kbd">A</span></span><span class="game-help-label">{{ "tool.breakout.pad_launch" | t }}</span></li>
      <li><span><span class="kbd">START</span></span><span class="game-help-label">{{ "tool.breakout.pad_pause" | t }}</span></li>
    </ul>
  </div>

  <p class="brk__help-foot">{{ "tool.breakout.help_hint" | t }}</p>
</div>

<div class="stats">
  <div class="stat">
    <span class="stat-label">{{ "tool.breakout.score" | t }}</span>
    <span class="stat-value v-cyan" id="stat-score">0</span>
  </div>
  <div class="stat">
    <span class="stat-label">{{ "tool.breakout.level" | t }}</span>
    <span class="stat-value v-purple" id="stat-level">1</span>
  </div>
  <div class="stat">
    <span class="stat-label">{{ "tool.breakout.lives" | t }}</span>
    <span class="stat-value v-pink" id="stat-lives">♥ ♥ ♥</span>
  </div>
  <div class="stat">
    <span class="stat-label">{{ "tool.breakout.high_score" | t }}</span>
    <span class="stat-value v-amber" id="stat-high">0</span>
  </div>
</div>

<div class="tray" id="tray">
  <span class="tray-label">{{ "tool.breakout.active" | t }}</span>
  <span class="tray-empty" id="tray-empty">{{ "tool.breakout.empty_powerups" | t }}</span>
</div>

<div class="canvas-wrap" id="canvasWrap">
  <canvas id="game" width="900" height="640" role="img" aria-label="{{ 'tool.breakout.canvas_label' | t }}"></canvas>

  <div class="toast" id="toast"></div>

  <button type="button" class="brk__touchbtn brk__touchbtn--launch" id="brk-launch" hidden>
    <span aria-hidden="true">▲</span><span>{{ "tool.breakout.btn_launch" | t }}</span>
  </button>
  <button type="button" class="brk__touchbtn brk__touchbtn--pause" id="brk-pause" hidden aria-label="{{ 'tool.breakout.btn_pause_label' | t }}">
    <span aria-hidden="true">❙❙</span>
  </button>

  <div class="overlay" id="overlay">
    <div class="modal" id="modal-start">
      <p class="eyebrow">&gt; {{ "tool.breakout.eyebrow_ready" | t }}</p>
      <h2>breakout.js</h2>
      <p>{{ "tool.breakout.modal_intro" | t }}</p>

      <div class="key-hints">
        <div class="row"><span>{{ "tool.breakout.key_move_paddle" | t }}</span><span>← → · A D · {{ "tool.breakout.chip_drag" | t }}</span></div>
        <div class="row"><span>{{ "tool.breakout.key_launch" | t }}</span><span>SPACE · A · {{ "tool.breakout.chip_tap" | t }}</span></div>
        <div class="row"><span>{{ "tool.breakout.key_pause" | t }}</span><span>P · ESC · START</span></div>
      </div>

      <div class="legend">
        <div class="li"><span class="swatch" style="background:var(--syn-cyan); box-shadow: var(--glow-cyan-soft)"></span>{{ "tool.breakout.legend_wide" | t }}</div>
        <div class="li"><span class="swatch" style="background:var(--syn-purple); box-shadow: var(--glow-purple)"></span>{{ "tool.breakout.legend_slow" | t }}</div>
        <div class="li"><span class="swatch" style="background:var(--syn-green); box-shadow: var(--glow-green)"></span>{{ "tool.breakout.legend_multi" | t }}</div>
        <div class="li"><span class="swatch" style="background:var(--syn-amber); box-shadow: var(--glow-amber)"></span>{{ "tool.breakout.legend_life" | t }}</div>
        <div class="li"><span class="swatch" style="background:var(--syn-pink); box-shadow: var(--glow-pink)"></span>{{ "tool.breakout.legend_shrink" | t }}</div>
        <div class="li"><span class="swatch" style="background:var(--term-subtle)"></span>{{ "tool.breakout.legend_brick" | t }}</div>
      </div>

      <button class="m-btn m-btn--primary" id="btn-start">$ {{ "tool.breakout.btn_start" | t }}</button>
      <div style="height:8px"></div>
      <button class="m-btn m-btn--ghost" id="btn-help" popovertarget="breakout-help">? {{ "tool.breakout.controls_title" | t }}</button>
    </div>

    <div class="modal is-off" id="modal-dyn"></div>
  </div>
</div>

<div class="footer-controls">
  <div class="keys">
    <span><span class="kbd">←</span><span class="kbd">→</span> {{ "tool.breakout.footer_move" | t }}</span>
    <span><span class="kbd">SPACE</span> {{ "tool.breakout.footer_launch" | t }}</span>
    <span><span class="kbd">P</span> {{ "tool.breakout.footer_pause" | t }}</span>
    <span id="brk-padhint" hidden><span class="kbd">A</span> {{ "tool.breakout.footer_launch" | t }} <span class="kbd">START</span> {{ "tool.breakout.footer_pause" | t }}</span>
  </div>
  <div>
    <span style="display:inline-block; width:7px; height:7px; border-radius:50%; background:var(--syn-green); box-shadow:var(--glow-green); margin-right:6px"></span>
    {{ "tool.breakout.offline" | t }}
  </div>
</div>

{% include "terminal-frame-close.njk" %}

</div>

{% include "tool-schema.njk" %}

<style>
html, body { overscroll-behavior: none; }
main { max-width: 1100px; }

.game-page .hero { text-align: center; padding: 0; margin-bottom: 32px; position: relative; z-index: 1; }
.game-page .hero .eyebrow { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--term-muted); letter-spacing: 0.1em; margin: 0 0 12px; }
.game-page .hero h1 { font-family: var(--font-mono); font-weight: 700; font-size: clamp(2rem, 4vw, 2.6rem); color: var(--term-fg-strong); margin: 0 0 12px; letter-spacing: -0.005em; line-height: 1.2; }
.game-page .hero p { font-family: var(--font-mono); color: var(--term-muted); font-size: var(--text-sm); margin: 0 auto; max-width: 56ch; line-height: 1.6; }

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-bottom: 1px solid var(--term-border);
}
.stat {
  padding: 12px 16px;
  border-right: 1px solid var(--term-border);
  display: flex; flex-direction: column; gap: 4px;
}
.stat:last-child { border-right: none; }
.stat-label {
  font-family: var(--font-mono);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--term-muted);
  font-weight: 500;
}
.stat-value {
  font-family: var(--font-mono);
  font-size: 18px;
  font-weight: 700;
  color: var(--term-fg-strong);
  font-variant-numeric: tabular-nums;
  transform-origin: left center;
}
.stat-value.is-bump { animation: brk-bump 340ms cubic-bezier(.22,1,.36,1); }
@keyframes brk-bump {
  0% { transform: scale(1); }
  35% { transform: scale(1.16); }
  100% { transform: scale(1); }
}
.v-cyan   { color: var(--syn-cyan); text-shadow: 0 0 8px rgba(34,211,238,0.4); }
.v-pink   { color: var(--syn-pink); }
.v-purple { color: var(--syn-purple); }
.v-amber  { color: var(--syn-amber); }

.tray {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 16px;
  border-bottom: 1px solid var(--term-border);
  background: rgba(255,255,255,0.01);
  min-height: 40px;
  flex-wrap: wrap;
}
.tray-label {
  font-family: var(--font-mono);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--term-muted);
  font-weight: 500;
}
.pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 4px 12px;
  border-radius: var(--radius-pill);
  font-family: var(--font-mono);
  font-size: 11px;
  background: var(--purple-8);
  border: 1px solid var(--purple-20);
  color: var(--syn-purple);
  letter-spacing: 0.05em;
  position: relative;
  overflow: hidden;
}
.pill .pill-fill {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  background: var(--purple-8);
  pointer-events: none;
  z-index: 0;
}
.pill > span { position: relative; z-index: 1; }
.pill.cyan  { background: var(--cyan-8); border-color: var(--cyan-15); color: var(--syn-cyan); }
.pill.cyan .pill-fill { background: var(--cyan-8); }
.pill.green { background: var(--green-8); border-color: rgba(74,222,128,0.20); color: var(--syn-green); }
.pill.green .pill-fill { background: var(--green-8); }
.pill.amber { background: var(--amber-8); border-color: rgba(251,191,36,0.20); color: var(--syn-amber); }
.pill.amber .pill-fill { background: var(--amber-8); }
.tray-empty { color: var(--term-subtle); font-size: 12px; font-family: var(--font-mono); }

.canvas-wrap {
  position: relative;
  background: #050507;
  background-image:
    linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
  background-size: 40px 40px;
  -webkit-user-select: none;
  user-select: none;
}
canvas {
  display: block;
  width: 100%;
  height: auto;
  touch-action: none;
  cursor: none;
}

.brk__touchbtn {
  position: absolute;
  z-index: 4;
  display: none;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-width: 44px;
  min-height: 44px;
  padding: 0 18px;
  border-radius: var(--radius-pill);
  border: 1px solid var(--cyan-30);
  background: rgba(5,5,7,0.72);
  color: var(--syn-cyan);
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  box-shadow: var(--glow-cyan-soft);
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
  touch-action: manipulation;
  cursor: pointer;
}
.brk__touchbtn--launch { left: 50%; bottom: 13%; transform: translateX(-50%); }
.brk__touchbtn--pause { top: 12px; right: 12px; width: 44px; padding: 0; font-size: 13px; }
@media (pointer: coarse) {
  .brk__touchbtn { display: inline-flex; }
  .brk__touchbtn[hidden] { display: none; }
}

.overlay {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
  background: rgba(5,5,7,0.75);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 5;
}
.overlay.hidden { display: none; }
.modal {
  background: var(--term-surface-2);
  border: 1px solid var(--term-border-strong);
  border-radius: var(--radius-lg);
  padding: 28px 32px;
  max-width: 480px;
  text-align: center;
  box-shadow: var(--elev-3), var(--glow-cyan-soft);
}
.modal.is-off { display: none; }
.modal .eyebrow {
  color: var(--syn-pink);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  letter-spacing: 0.15em;
  margin: 0 0 8px;
  text-transform: uppercase;
}
.modal h2 {
  font-family: var(--font-mono);
  font-size: 24px;
  font-weight: 700;
  color: var(--term-fg-strong);
  margin: 0 0 12px;
}
.modal p {
  font-family: var(--font-mono);
  color: var(--term-muted);
  font-size: 13px;
  line-height: 1.6;
  margin: 0 0 20px;
  text-align: center;
}
.modal .key-hints {
  display: flex;
  flex-direction: column;
  gap: 6px;
  text-align: left;
  background: rgba(0,0,0,0.3);
  border: 1px solid var(--term-border);
  border-radius: var(--radius-md);
  padding: 12px 14px;
  margin-bottom: 20px;
  font-size: 12px;
  font-family: var(--font-mono);
}
.key-hints .row {
  display: flex; justify-content: space-between; gap: 12px;
}
.key-hints .row span:first-child { color: var(--term-muted); }
.key-hints .row span:last-child { color: var(--syn-cyan); font-weight: 600; }
.legend {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px 14px;
  text-align: left;
  font-size: 11px;
  margin-bottom: 20px;
  font-family: var(--font-mono);
}
.legend .li {
  display: flex; align-items: center; gap: 8px;
  color: var(--term-muted);
}
.legend .swatch {
  width: 12px; height: 12px; border-radius: 3px;
  flex-shrink: 0;
}

.brk__help { max-width: min(400px, calc(100vw - 1.5rem)); }
.brk__method + .brk__method { margin-top: 0.9rem; }
.brk__method-head {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0 0 0.45rem;
  font-size: 0.7rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--term-fg-strong);
}
.brk__glyph { width: 16px; height: 16px; flex: none; color: var(--syn-cyan); }
.brk__badge {
  display: none;
  margin-left: auto;
  padding: 1px 8px;
  border-radius: var(--radius-pill);
  border: 1px solid var(--cyan-30);
  background: var(--cyan-8);
  color: var(--syn-cyan);
  font-size: 9px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.brk__method.is-last .brk__badge { display: inline-block; }
.brk__help-foot { margin: 0.9rem 0 0; font-size: 0.7rem; line-height: 1.5; color: var(--term-subtle); }
.brk__help .game-help-list .kbd { font-size: 0.68rem; }

.footer-controls {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 16px;
  border-top: 1px solid var(--term-border);
  font-size: 11px;
  color: var(--term-muted);
  font-family: var(--font-mono);
}
.footer-controls .keys { display: flex; gap: 14px; flex-wrap: wrap; }
.kbd {
  display: inline-block;
  padding: 1px 6px;
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--term-border);
  border-radius: 3px;
  color: var(--term-fg);
  font-family: var(--font-mono);
  font-size: 10px;
  margin-right: 4px;
}

.toast {
  position: absolute;
  top: 24px;
  left: 50%;
  transform: translateX(-50%);
  padding: 8px 16px;
  border-radius: var(--radius-pill);
  background: var(--cyan-15);
  border: 1px solid var(--cyan-30);
  color: var(--syn-cyan);
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  box-shadow: var(--glow-cyan);
  z-index: 4;
  opacity: 0;
  transition: opacity 300ms ease;
  pointer-events: none;
}
.toast.show { opacity: 1; }

@media (prefers-reduced-motion: reduce) {
  .stat-value.is-bump { animation: none; }
  .toast { transition: none; }
}

@media (max-width: 600px) {
  .stats { grid-template-columns: repeat(2, 1fr); }
  .stat { padding: 10px 12px; }
  .stat-value { font-size: 16px; }
  .stat:nth-child(2) { border-right: none; }
  .stat:nth-child(1), .stat:nth-child(2) { border-bottom: 1px solid var(--term-border); }
  .game-page .hero { margin-bottom: 18px; }
  .game-page .hero h1 { font-size: 1.6rem; }
  .game-page .hero p { font-size: 12px; }
  canvas { cursor: default; }
  .modal { padding: 20px 18px; max-width: 92vw; }
  .modal h2 { font-size: 20px; }
  .modal p { font-size: 12px; }
  .modal .key-hints { font-size: 11px; padding: 10px; }
  .legend { font-size: 10px; gap: 4px 10px; }
  .footer-controls { flex-direction: column; align-items: flex-start; gap: 6px; font-size: 10px; }
  .tray { padding: 8px 12px; gap: 8px; }
  .pill { font-size: 10px; padding: 3px 10px; }
}
</style>

<script>
(() => {
  'use strict';

  const T = {
    powerWide:    {{ ("tool.breakout.power_wide"        | t) | dump | safe }},
    powerSlow:    {{ ("tool.breakout.power_slow"        | t) | dump | safe }},
    powerMulti:   {{ ("tool.breakout.power_multi"       | t) | dump | safe }},
    powerLife:    {{ ("tool.breakout.power_life"        | t) | dump | safe }},
    powerShrink:  {{ ("tool.breakout.power_shrink"      | t) | dump | safe }},
    levelInit:    {{ ("tool.breakout.toast_level_init"  | t) | dump | safe }},
    wallRebuilt:  {{ ("tool.breakout.toast_wall_rebuilt"| t) | dump | safe }},
    toastPowerup: {{ ("tool.breakout.toast_powerup"     | t) | dump | safe }},
    newHigh:      {{ ("tool.breakout.new_high"          | t) | dump | safe }},
    launchHint:   {{ ("tool.breakout.launch_hint"       | t) | dump | safe }},
    paused:       {{ ("tool.breakout.paused"            | t) | dump | safe }},
    pauseDesc:    {{ ("tool.breakout.pause_desc"        | t) | dump | safe }},
    gameOver:     {{ ("tool.breakout.game_over"         | t) | dump | safe }},
    gameoverDesc: {{ ("tool.breakout.gameover_desc"     | t) | dump | safe }},
    eyebrowPaused:{{ ("tool.breakout.eyebrow_paused"    | t) | dump | safe }},
    eyebrowOver:  {{ ("tool.breakout.eyebrow_over"      | t) | dump | safe }},
    btnResume:    {{ ("tool.breakout.btn_resume"        | t) | dump | safe }},
    btnRestart:   {{ ("tool.breakout.btn_restart"       | t) | dump | safe }},
    btnAgain:     {{ ("tool.breakout.btn_again"         | t) | dump | safe }}
  };

  const $ = (id) => document.getElementById(id);
  const canvas = $('game');
  if (window.innerWidth <= 720) {
    canvas.width = 640;
    canvas.height = 1100;
  }
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;

  const dpr = Math.min(window.devicePixelRatio || 1, 3);
  canvas.width = W * dpr;
  canvas.height = H * dpr;
  canvas.style.aspectRatio = `${W} / ${H}`;
  ctx.scale(dpr, dpr);

  const C = {
    bg: '#050507',
    paddle: '#22D3EE',
    paddleGlow: 'rgba(34,211,238,0.5)',
    ball: '#F8FAFC',
    brick: '#E2E8F0',
    cyan: '#22D3EE',
    purple: '#A78BFA',
    pink: '#F472B6',
    green: '#4ADE80',
    amber: '#FBBF24',
    muted: '#475569',
    fg: '#E2E8F0'
  };

  const LEGACY_HIGH = 'mentria_breakout_high';
  function readLegacyHigh() {
    try { return parseInt(localStorage.getItem(LEGACY_HIGH) || '0', 10) || 0; } catch (_) { return 0; }
  }
  function readHigh() {
    if (window.MentriaStore) {
      const v = window.MentriaStore.get('games', 'breakout_high');
      if (v != null) return v;
      const legacy = readLegacyHigh();
      if (legacy > 0) { window.MentriaStore.set('games', 'breakout_high', legacy); try { localStorage.removeItem(LEGACY_HIGH); } catch (_) {} }
      return legacy;
    }
    return readLegacyHigh();
  }
  function writeHigh(v) {
    if (window.MentriaStore) window.MentriaStore.set('games', 'breakout_high', v);
    else try { localStorage.setItem(LEGACY_HIGH, String(v)); } catch (_) {}
  }
  function prefGet(key) {
    try { return window.MentriaStore ? window.MentriaStore.get('tools', key) : null; } catch (_) { return null; }
  }
  function prefSet(key, value) {
    try { if (window.MentriaStore) window.MentriaStore.set('tools', key, value); } catch (_) {}
  }

  const State = {
    running: false,
    paused: false,
    awaitingLaunch: true,
    score: 0,
    level: 1,
    lives: 3,
    high: readHigh()
  };

  const paddle = {
    w: 110, h: 12,
    x: W / 2 - 55,
    y: H - 32,
    speed: 9,
    baseW: 110,
    flash: 0
  };

  const balls = [];
  const bricks = [];
  const powerups = [];
  const particles = [];
  const activeEffects = [];

  const POWER_KINDS = [
    { id: 'wide',   label: T.powerWide,   color: C.cyan,   pclass: 'cyan',  weight: 22, dur: 10000 },
    { id: 'slow',   label: T.powerSlow,   color: C.purple, pclass: '',      weight: 20, dur: 8000  },
    { id: 'multi',  label: T.powerMulti,  color: C.green,  pclass: 'green', weight: 14, dur: 0     },
    { id: 'life',   label: T.powerLife,   color: C.amber,  pclass: 'amber', weight: 8,  dur: 0     },
    { id: 'shrink', label: T.powerShrink, color: C.pink,   pclass: '',      weight: 14, dur: 7000  }
  ];

  const SPEED_CAP = 9.6;
  const MAX_BALLS = 6;
  const MAX_PARTICLES = 220;
  const PAD_DEAD = 0.18;
  const KEY_ACCEL = 1.9;
  const PATTERNS = ['solid', 'checker', 'wedge', 'pyramid', 'diamond', 'columns'];

  const elScore = $('stat-score');
  const elLevel = $('stat-level');
  const elLives = $('stat-lives');
  const elHigh = $('stat-high');
  const elTray = $('tray');
  const elTrayEmpty = $('tray-empty');
  const elOverlay = $('overlay');
  const elModalStart = $('modal-start');
  const elModalDyn = $('modal-dyn');
  const elToast = $('toast');
  const elHelp = $('breakout-help');
  const btnLaunch = $('brk-launch');
  const btnPause = $('brk-pause');
  const elPadHint = $('brk-padhint');

  const keys = { left: false, right: false };
  let keyVel = 0;
  let padAxis = 0;
  let pointerX = null;

  const coarse = !!(window.matchMedia && window.matchMedia('(pointer: coarse)').matches);
  let lastInput = coarse ? 'touch' : 'keyboard';

  function renderBadges() {
    const nodes = document.querySelectorAll('[data-brk-method]');
    for (let i = 0; i < nodes.length; i++) {
      nodes[i].classList.toggle('is-last', nodes[i].getAttribute('data-brk-method') === lastInput);
    }
  }
  function setLastInput(kind) {
    if (lastInput === kind) return;
    lastInput = kind;
    renderBadges();
  }

  let lastVibe = 0;
  function vibrate(ms) {
    if (!navigator.vibrate) return;
    const now = performance.now();
    if (now - lastVibe < 45) return;
    lastVibe = now;
    try { navigator.vibrate(ms); } catch (_) {}
  }

  function esc(s) {
    return String(s).split('&').join('&amp;').split('<').join('&lt;').split('>').join('&gt;');
  }

  function levelSpeed(n) {
    return Math.min(5 + (n - 1) * 0.55, SPEED_CAP);
  }

  function patternCell(name, r, c, rows, cols) {
    const mid = (cols - 1) / 2;
    const dc = Math.abs(c - mid);
    if (name === 'checker') return r === 0 || ((r + c) % 2) === 0;
    if (name === 'wedge') return dc <= mid - Math.max(0, r - 1) * 0.9;
    if (name === 'pyramid') return dc <= r + 1;
    if (name === 'diamond') {
      const midR = (rows - 1) / 2;
      return (dc / mid) + (Math.abs(r - midR) / Math.max(midR, 1)) <= 1.15;
    }
    if (name === 'columns') return r === 0 || r === rows - 1 || ((c % 3) !== 2);
    return true;
  }

  function buildLevel(n) {
    bricks.length = 0;
    powerups.length = 0;
    particles.length = 0;
    activeEffects.length = 0;
    paddle.w = paddle.baseW;

    const cols = 11;
    const rows = Math.min(4 + Math.floor((n - 1) / 2), 8);
    const pattern = PATTERNS[(n - 1) % PATTERNS.length];
    const padTop = 70;
    const padSide = 30;
    const gap = 6;
    const bw = (W - padSide * 2 - gap * (cols - 1)) / cols;
    const bh = 20;

    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        let on = patternCell(pattern, r, c, rows, cols);
        if (!on && n >= 7 && ((r + c + n) % 3) === 0) on = true;
        if (!on && n >= 13 && ((r * 2 + c + n) % 4) === 0) on = true;
        if (!on) continue;
        let hp = 1;
        if (n >= 3 && r === 0) hp = 2;
        if (n >= 6 && r <= 1) hp = 2;
        if (n >= 9 && r === 0) hp = 3;
        bricks.push({
          x: padSide + c * (bw + gap),
          y: padTop + r * (bh + gap),
          w: bw,
          h: bh,
          hp,
          row: r,
          flash: 0
        });
      }
    }
    if (bricks.length === 0) {
      for (let c = 0; c < cols; c++) {
        bricks.push({ x: padSide + c * (bw + gap), y: padTop, w: bw, h: bh, hp: 1, row: 0, flash: 0 });
      }
    }
    resetBall();
  }

  function resetBall() {
    balls.length = 0;
    balls.push({
      x: paddle.x + paddle.w / 2,
      y: paddle.y - 10,
      vx: 0,
      vy: 0,
      r: 7,
      speed: levelSpeed(State.level),
      stuck: true,
      trail: []
    });
    State.awaitingLaunch = true;
  }

  function clampBall(b) {
    const m = Math.hypot(b.vx, b.vy);
    if (m === 0) return;
    let ux = b.vx / m;
    let uy = b.vy / m;
    const minY = 0.3;
    if (Math.abs(uy) < minY) {
      uy = (uy < 0 ? -1 : 1) * minY;
      ux = (ux < 0 ? -1 : 1) * Math.sqrt(Math.max(0, 1 - minY * minY));
    }
    b.vx = ux * b.speed;
    b.vy = uy * b.speed;
  }

  function launchBall() {
    let launched = false;
    for (const b of balls) {
      if (!b.stuck) continue;
      b.stuck = false;
      const angle = (-Math.PI / 2) + (Math.random() * 0.6 - 0.3);
      b.vx = Math.cos(angle) * b.speed;
      b.vy = Math.sin(angle) * b.speed;
      launched = true;
    }
    if (launched) State.awaitingLaunch = false;
  }

  function helpOpen() {
    if (!elHelp) return false;
    try { return elHelp.matches(':popover-open'); } catch (_) { return false; }
  }

  function primaryAction() {
    if (helpOpen()) return;
    if (!State.running) { startGame(); return; }
    if (State.paused) { togglePause(); return; }
    if (State.awaitingLaunch) { launchBall(); return; }
    togglePause();
  }

  document.addEventListener('keydown', (e) => {
    if (e.target && e.target.closest && e.target.closest('input, textarea, select, [contenteditable="true"]')) return;
    const k = e.key;
    if (k === 'ArrowLeft' || k === 'a' || k === 'A') {
      keys.left = true; pointerX = null; setLastInput('keyboard');
    } else if (k === 'ArrowRight' || k === 'd' || k === 'D') {
      keys.right = true; pointerX = null; setLastInput('keyboard');
    } else if (e.code === 'Space') {
      e.preventDefault();
      setLastInput('keyboard');
      primaryAction();
    } else if (k === 'p' || k === 'P') {
      setLastInput('keyboard');
      if (State.running && !helpOpen()) togglePause();
    } else if (k === 'Escape') {
      if (helpOpen()) return;
      if (State.running && !State.paused) togglePause();
    }
  });
  document.addEventListener('keyup', (e) => {
    const k = e.key;
    if (k === 'ArrowLeft' || k === 'a' || k === 'A') keys.left = false;
    else if (k === 'ArrowRight' || k === 'd' || k === 'D') keys.right = false;
  });

  function canvasX(clientX) {
    const rect = canvas.getBoundingClientRect();
    return (clientX - rect.left) * (W / rect.width);
  }

  canvas.addEventListener('mousemove', (e) => { pointerX = canvasX(e.clientX); });
  canvas.addEventListener('mouseleave', () => { pointerX = null; });

  function trackTouch(e) {
    if (e.touches && e.touches.length) pointerX = canvasX(e.touches[0].clientX);
    setLastInput('touch');
    e.preventDefault();
  }
  canvas.addEventListener('touchstart', (e) => {
    trackTouch(e);
    if (!State.running) { startGame(); return; }
    if (State.paused) { togglePause(); return; }
    if (State.awaitingLaunch) launchBall();
  }, { passive: false });
  canvas.addEventListener('touchmove', trackTouch, { passive: false });
  canvas.addEventListener('touchend', (e) => { pointerX = null; e.preventDefault(); }, { passive: false });
  canvas.addEventListener('touchcancel', () => { pointerX = null; });
  canvas.addEventListener('click', () => {
    if (State.awaitingLaunch && State.running && !State.paused) launchBall();
  });

  btnLaunch.addEventListener('click', () => {
    setLastInput('touch');
    if (!State.running) { startGame(); return; }
    if (!State.paused && State.awaitingLaunch) launchBall();
  });
  btnPause.addEventListener('click', () => {
    setLastInput('touch');
    if (State.running) togglePause();
  });

  $('btn-start').addEventListener('click', startGame);

  window.addEventListener('mentria:gamepad:button', (e) => {
    const d = e.detail || {};
    if (!d.pressed) return;
    setLastInput('gamepad');
    if (d.name === 'a') primaryAction();
    else if (d.name === 'start') {
      if (helpOpen()) return;
      if (State.running) togglePause();
      else startGame();
    } else if (d.name === 'b') {
      if (State.paused) togglePause();
    }
  });
  window.addEventListener('mentria:gamepad:direction', () => setLastInput('gamepad'));

  function syncPadHint() {
    const on = !!(window.MentriaGamepad && window.MentriaGamepad.isConnected());
    elPadHint.hidden = !on;
  }
  window.addEventListener('mentria:gamepad:connect', syncPadHint);
  window.addEventListener('mentria:gamepad:disconnect', syncPadHint);

  function pollPad() {
    requestAnimationFrame(pollPad);
    const gp = window.MentriaGamepad;
    if (!gp || !gp.isConnected()) { padAxis = 0; return; }
    const pads = gp.getPads();
    let x = 0;
    for (let i = 0; i < pads.length; i++) {
      const p = pads[i];
      if (p.buttons[14] && p.buttons[14].pressed) x = -1;
      else if (p.buttons[15] && p.buttons[15].pressed) x = 1;
      else if (p.axes.length >= 1 && Math.abs(p.axes[0]) > PAD_DEAD) {
        const raw = p.axes[0];
        const mag = (Math.abs(raw) - PAD_DEAD) / (1 - PAD_DEAD);
        x = (raw < 0 ? -1 : 1) * Math.min(1, mag);
      }
      if (x !== 0) break;
    }
    if (x !== 0 && padAxis === 0) setLastInput('gamepad');
    padAxis = x;
  }
  requestAnimationFrame(pollPad);

  document.addEventListener('visibilitychange', () => {
    if (document.hidden && State.running && !State.paused) togglePause();
  });

  if (elHelp) {
    elHelp.addEventListener('toggle', (e) => {
      if (e.newState !== 'open') return;
      renderBadges();
      if (State.running && !State.paused) togglePause();
    });
  }

  function togglePause() {
    State.paused = !State.paused;
    showOverlay(State.paused ? 'paused' : null);
    syncTouchUI();
  }

  function startGame() {
    State.running = true;
    State.paused = false;
    State.score = 0;
    State.level = 1;
    State.lives = 3;
    keyVel = 0;
    paddle.w = paddle.baseW;
    paddle.x = W / 2 - paddle.w / 2;
    buildLevel(State.level);
    showOverlay(null);
    showToast(T.levelInit.replace('{n}', String(State.level)));
    updateHUD();
    syncTouchUI();
  }

  function loseLife() {
    State.lives--;
    activeEffects.length = 0;
    paddle.w = paddle.baseW;
    vibrate(35);
    if (State.lives <= 0) {
      gameOver();
    } else {
      resetBall();
      flash(C.pink, 0.2);
    }
    bump(elLives);
    updateHUD();
    syncTouchUI();
  }

  function gameOver() {
    State.running = false;
    const beat = State.score > State.high;
    if (beat) {
      State.high = State.score;
      writeHigh(State.high);
      bump(elHigh);
    }
    showOverlay('gameover');
    if (beat) showToast(T.newHigh);
    updateHUD();
  }

  function nextLevel() {
    State.level++;
    buildLevel(State.level);
    showToast(T.wallRebuilt.replace('{n}', String(State.level)));
    flash(C.cyan, 0.16);
    bump(elLevel);
    updateHUD();
    syncTouchUI();
  }

  function maybeSpawnPowerup(brick) {
    if (Math.random() > 0.22) return;
    const total = POWER_KINDS.reduce((s, k) => s + k.weight, 0);
    let r = Math.random() * total;
    let chosen = POWER_KINDS[0];
    for (const k of POWER_KINDS) { r -= k.weight; if (r <= 0) { chosen = k; break; } }
    powerups.push({
      x: brick.x + brick.w / 2,
      y: brick.y + brick.h / 2,
      vy: 2.2,
      r: 11,
      kind: chosen
    });
  }

  function applyPowerup(kind) {
    const now = performance.now();
    if (kind.id === 'multi') {
      const copies = balls.slice();
      for (const b of copies) {
        if (b.stuck) continue;
        for (let i = 0; i < 2; i++) {
          if (balls.length >= MAX_BALLS) break;
          const angle = Math.atan2(b.vy, b.vx) + (i === 0 ? 0.4 : -0.4);
          balls.push({
            x: b.x, y: b.y, r: b.r, speed: b.speed,
            vx: Math.cos(angle) * b.speed,
            vy: Math.sin(angle) * b.speed,
            stuck: false,
            trail: []
          });
        }
      }
      flashEffect(kind);
      return;
    }
    if (kind.id === 'life') {
      State.lives = Math.min(State.lives + 1, 6);
      flashEffect(kind);
      bump(elLives);
      updateHUD();
      return;
    }
    const existing = activeEffects.findIndex((e) => e.kind.id === kind.id);
    if (kind.id === 'wide') {
      const other = activeEffects.findIndex((e) => e.kind.id === 'shrink');
      if (other >= 0) activeEffects.splice(other, 1);
      paddle.w = paddle.baseW * 1.6;
      paddle.x = Math.max(0, Math.min(W - paddle.w, paddle.x - (paddle.baseW * 0.3)));
    }
    if (kind.id === 'shrink') {
      const other = activeEffects.findIndex((e) => e.kind.id === 'wide');
      if (other >= 0) activeEffects.splice(other, 1);
      paddle.w = paddle.baseW * 0.6;
    }
    if (kind.id === 'slow' && existing < 0) {
      for (const b of balls) {
        b.speed *= 0.65;
        const m = Math.hypot(b.vx, b.vy);
        if (m > 0) { b.vx = b.vx / m * b.speed; b.vy = b.vy / m * b.speed; }
      }
    }
    const eff = { kind, until: now + kind.dur, total: kind.dur };
    if (existing >= 0) activeEffects[existing] = eff;
    else activeEffects.push(eff);
    flashEffect(kind);
  }

  function expireEffect(eff) {
    if (eff.kind.id === 'wide' || eff.kind.id === 'shrink') {
      paddle.w = paddle.baseW;
    }
    if (eff.kind.id === 'slow') {
      const base = levelSpeed(State.level);
      for (const b of balls) {
        b.speed = base;
        const m = Math.hypot(b.vx, b.vy);
        if (m > 0) { b.vx = b.vx / m * b.speed; b.vy = b.vy / m * b.speed; }
      }
    }
  }

  function flashEffect(kind) {
    flash(kind.color, 0.14);
    showToast(T.toastPowerup.replace('{label}', kind.label.toLowerCase()));
    vibrate(12);
  }

  let flashColor = null, flashAlpha = 0;
  function flash(color, a) { flashColor = color; flashAlpha = a; }

  function spawnParticles(x, y, color, n) {
    if (particles.length > MAX_PARTICLES) return;
    const count = n || 8;
    for (let i = 0; i < count; i++) {
      const a = Math.random() * Math.PI * 2;
      const s = 1 + Math.random() * 2.5;
      particles.push({
        x, y,
        vx: Math.cos(a) * s,
        vy: Math.sin(a) * s,
        life: 1,
        color
      });
    }
  }

  function movePaddle() {
    const speed = paddle.speed;
    if (Math.abs(padAxis) > 0.001) {
      paddle.x += padAxis * speed;
      keyVel = 0;
    } else if (pointerX !== null) {
      const target = pointerX - paddle.w / 2;
      paddle.x += (target - paddle.x) * 0.4;
      keyVel = 0;
    } else {
      const dir = (keys.right ? 1 : 0) - (keys.left ? 1 : 0);
      if (dir !== 0) keyVel = Math.max(-speed, Math.min(speed, keyVel + dir * KEY_ACCEL));
      else keyVel *= 0.55;
      if (Math.abs(keyVel) < 0.06) keyVel = 0;
      paddle.x += keyVel;
    }
    paddle.x = Math.max(0, Math.min(W - paddle.w, paddle.x));
  }

  function update() {
    if (!State.running || State.paused) return;

    movePaddle();

    const now = performance.now();
    for (let i = activeEffects.length - 1; i >= 0; i--) {
      if (activeEffects[i].kind.dur > 0 && now > activeEffects[i].until) {
        expireEffect(activeEffects[i]);
        activeEffects.splice(i, 1);
      }
    }

    for (let i = balls.length - 1; i >= 0; i--) {
      const b = balls[i];
      if (b.stuck) {
        b.x = paddle.x + paddle.w / 2;
        b.y = paddle.y - b.r - 2;
        b.trail.length = 0;
        continue;
      }
      b.x += b.vx;
      b.y += b.vy;

      b.trail.push(b.x, b.y);
      if (b.trail.length > 16) b.trail.splice(0, 2);

      if (b.x - b.r < 0) { b.x = b.r; b.vx *= -1; }
      else if (b.x + b.r > W) { b.x = W - b.r; b.vx *= -1; }
      if (b.y - b.r < 0) { b.y = b.r; b.vy *= -1; }

      if (b.y - b.r > H) {
        balls.splice(i, 1);
        if (balls.length === 0) loseLife();
        continue;
      }

      if (b.vy > 0
          && b.y + b.r >= paddle.y
          && b.y - b.r <= paddle.y + paddle.h
          && b.x >= paddle.x
          && b.x <= paddle.x + paddle.w) {
        b.y = paddle.y - b.r;
        const hit = (b.x - (paddle.x + paddle.w / 2)) / (paddle.w / 2);
        const angle = (-Math.PI / 2) + Math.max(-1, Math.min(1, hit)) * (Math.PI / 3);
        b.vx = Math.cos(angle) * b.speed;
        b.vy = Math.sin(angle) * b.speed;
        clampBall(b);
        paddle.flash = 1;
        spawnParticles(b.x, paddle.y, C.cyan, 5);
      }

      for (let j = bricks.length - 1; j >= 0; j--) {
        const br = bricks[j];
        if (b.x + b.r < br.x || b.x - b.r > br.x + br.w
         || b.y + b.r < br.y || b.y - b.r > br.y + br.h) continue;

        const overlapX = Math.min(b.x + b.r - br.x, br.x + br.w - (b.x - b.r));
        const overlapY = Math.min(b.y + b.r - br.y, br.y + br.h - (b.y - b.r));
        if (overlapX < overlapY) b.vx *= -1;
        else b.vy *= -1;
        clampBall(b);

        br.hp -= 1;
        if (br.hp <= 0) {
          spawnParticles(br.x + br.w / 2, br.y + br.h / 2, br.row === 0 ? C.purple : C.cyan, 10);
          maybeSpawnPowerup(br);
          bricks.splice(j, 1);
          State.score += 10 * State.level;
          vibrate(8);
        } else {
          br.flash = 1;
          spawnParticles(b.x, b.y, C.purple, 4);
          State.score += 2;
        }
        updateHUD();
        break;
      }
    }

    for (let i = powerups.length - 1; i >= 0; i--) {
      const p = powerups[i];
      p.y += p.vy;
      if (p.y + p.r >= paddle.y
          && p.y - p.r <= paddle.y + paddle.h
          && p.x >= paddle.x && p.x <= paddle.x + paddle.w) {
        applyPowerup(p.kind);
        powerups.splice(i, 1);
        continue;
      }
      if (p.y - p.r > H) powerups.splice(i, 1);
    }

    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.x += p.vx; p.y += p.vy;
      p.vx *= 0.96; p.vy *= 0.96; p.vy += 0.05;
      p.life -= 0.02;
      if (p.life <= 0) particles.splice(i, 1);
    }

    for (let i = 0; i < bricks.length; i++) {
      if (bricks[i].flash > 0) bricks[i].flash = Math.max(0, bricks[i].flash - 0.08);
    }
    if (paddle.flash > 0) paddle.flash = Math.max(0, paddle.flash - 0.07);
    if (flashAlpha > 0) flashAlpha = Math.max(0, flashAlpha - 0.012);

    if (bricks.length === 0 && State.running) {
      nextLevel();
    }

    renderTray();
  }

  function brickStroke(hp) {
    if (hp >= 3) return C.pink;
    if (hp === 2) return C.purple;
    return C.cyan;
  }
  function brickFill(hp) {
    if (hp >= 3) return 'rgba(244,114,182,0.20)';
    if (hp === 2) return 'rgba(167,139,250,0.18)';
    return 'rgba(34,211,238,0.12)';
  }

  function render() {
    syncTouchUI();

    ctx.fillStyle = C.bg;
    ctx.fillRect(0, 0, W, H);

    ctx.strokeStyle = 'rgba(167,139,250,0.12)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(0, 60);
    ctx.lineTo(W, 60);
    ctx.stroke();

    for (const br of bricks) {
      ctx.fillStyle = brickFill(br.hp);
      ctx.strokeStyle = brickStroke(br.hp);
      ctx.lineWidth = 1;
      ctx.fillRect(br.x, br.y, br.w, br.h);
      ctx.strokeRect(br.x + 0.5, br.y + 0.5, br.w - 1, br.h - 1);
      if (br.flash > 0) {
        ctx.globalAlpha = br.flash * 0.5;
        ctx.fillStyle = '#FFFFFF';
        ctx.fillRect(br.x, br.y, br.w, br.h);
        ctx.globalAlpha = 1;
      }
      ctx.fillStyle = br.hp >= 2 ? 'rgba(167,139,250,0.45)' : 'rgba(34,211,238,0.45)';
      ctx.fillRect(br.x + 4, br.y + 3, 3, 3);
    }

    ctx.shadowBlur = 18;
    ctx.shadowColor = C.paddleGlow;
    ctx.fillStyle = C.paddle;
    roundRect(ctx, paddle.x, paddle.y, paddle.w, paddle.h, 4, true);
    ctx.shadowBlur = 0;
    ctx.fillStyle = 'rgba(255,255,255,' + (0.35 + paddle.flash * 0.5).toFixed(2) + ')';
    ctx.fillRect(paddle.x + 6, paddle.y + 2, paddle.w - 12, 1 + paddle.flash * 2);

    for (const b of balls) {
      const pts = b.trail.length / 2;
      for (let i = 0; i < pts; i++) {
        const f = (i + 1) / pts;
        ctx.globalAlpha = f * 0.22;
        ctx.fillStyle = C.cyan;
        ctx.beginPath();
        ctx.arc(b.trail[i * 2], b.trail[i * 2 + 1], b.r * (0.3 + 0.5 * f), 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      ctx.shadowBlur = 10;
      ctx.shadowColor = 'rgba(34,211,238,0.6)';
      ctx.fillStyle = C.ball;
      ctx.beginPath();
      ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2);
      ctx.fill();
      ctx.shadowBlur = 0;
    }

    for (const p of powerups) {
      ctx.shadowBlur = 14;
      ctx.shadowColor = p.kind.color;
      ctx.fillStyle = 'rgba(0,0,0,0.6)';
      ctx.strokeStyle = p.kind.color;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
      ctx.shadowBlur = 0;
      ctx.fillStyle = p.kind.color;
      ctx.font = '600 11px JetBrains Mono, monospace';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      const glyph = { wide: 'W', slow: 'S', multi: 'x', life: '+', shrink: '-' }[p.kind.id];
      ctx.fillText(glyph, p.x, p.y + 0.5);
    }

    for (const pa of particles) {
      ctx.globalAlpha = pa.life;
      ctx.fillStyle = pa.color;
      ctx.fillRect(pa.x - 1, pa.y - 1, 2, 2);
    }
    ctx.globalAlpha = 1;

    if (State.awaitingLaunch && State.running && !State.paused) {
      ctx.fillStyle = 'rgba(34,211,238,0.7)';
      ctx.font = '600 12px JetBrains Mono, monospace';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'alphabetic';
      ctx.fillText(T.launchHint, W / 2, paddle.y - 40);
    }

    if (flashAlpha > 0 && flashColor) {
      ctx.fillStyle = flashColor;
      ctx.globalAlpha = flashAlpha;
      ctx.fillRect(0, 0, W, H);
      ctx.globalAlpha = 1;
    }
  }

  function roundRect(c2, x, y, w, h, r, fill) {
    c2.beginPath();
    c2.moveTo(x + r, y);
    c2.lineTo(x + w - r, y);
    c2.quadraticCurveTo(x + w, y, x + w, y + r);
    c2.lineTo(x + w, y + h - r);
    c2.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    c2.lineTo(x + r, y + h);
    c2.quadraticCurveTo(x, y + h, x, y + h - r);
    c2.lineTo(x, y + r);
    c2.quadraticCurveTo(x, y, x + r, y);
    c2.closePath();
    if (fill) c2.fill();
  }

  function bump(el) {
    if (!el) return;
    el.classList.remove('is-bump');
    void el.offsetWidth;
    el.classList.add('is-bump');
  }

  function updateHUD() {
    elScore.textContent = State.score.toLocaleString();
    elLevel.textContent = String(State.level).padStart(2, '0');
    elLives.textContent = State.lives > 0 ? '♥ '.repeat(State.lives).trim() : '—';
    elHigh.textContent = State.high.toLocaleString();
  }

  let touchUIKey = '';
  function syncTouchUI() {
    const key = (State.running ? '1' : '0') + (State.paused ? '1' : '0') + (State.awaitingLaunch ? '1' : '0');
    if (key === touchUIKey) return;
    touchUIKey = key;
    btnLaunch.hidden = !(State.running && !State.paused && State.awaitingLaunch);
    btnPause.hidden = !(State.running && !State.paused);
  }

  let trayKey = '';
  let trayAt = 0;
  function renderTray() {
    const now = performance.now();
    let key = '';
    for (let i = 0; i < activeEffects.length; i++) key += activeEffects[i].kind.id + ',';
    if (key === trayKey && now - trayAt < 150) return;
    trayKey = key;
    trayAt = now;

    const pills = elTray.querySelectorAll('.pill');
    for (let i = 0; i < pills.length; i++) pills[i].remove();
    if (activeEffects.length === 0) {
      elTrayEmpty.style.display = '';
      return;
    }
    elTrayEmpty.style.display = 'none';
    for (const eff of activeEffects) {
      const pill = document.createElement('span');
      pill.className = 'pill ' + (eff.kind.pclass || '');
      const remaining = eff.kind.dur > 0 ? Math.max(0, eff.until - now) : 0;
      const pct = eff.kind.dur > 0 ? (remaining / eff.total) : 1;
      const fill = document.createElement('span');
      fill.className = 'pill-fill';
      fill.style.width = (pct * 100).toFixed(1) + '%';
      pill.appendChild(fill);
      const txt = document.createElement('span');
      const secs = eff.kind.dur > 0 ? ` ${(remaining / 1000).toFixed(1)}s` : '';
      txt.textContent = eff.kind.label + secs;
      pill.appendChild(txt);
      elTray.appendChild(pill);
    }
  }

  function showOverlay(kind) {
    if (!kind) { elOverlay.classList.add('hidden'); return; }
    if (kind === 'start') {
      elModalDyn.classList.add('is-off');
      elModalStart.classList.remove('is-off');
      elOverlay.classList.remove('hidden');
      return;
    }
    elModalStart.classList.add('is-off');
    elModalDyn.classList.remove('is-off');
    if (kind === 'paused') {
      elModalDyn.innerHTML =
        '<p class="eyebrow">&gt; ' + esc(T.eyebrowPaused) + '</p>' +
        '<h2>' + esc(T.paused) + '</h2>' +
        '<p>' + esc(T.pauseDesc) + '</p>' +
        '<button class="m-btn m-btn--primary" id="btn-resume">$ ' + esc(T.btnResume) + '</button>' +
        '<div style="height:8px"></div>' +
        '<button class="m-btn m-btn--ghost" id="btn-restart">$ ' + esc(T.btnRestart) + '</button>';
      elOverlay.classList.remove('hidden');
      $('btn-resume').onclick = () => togglePause();
      $('btn-restart').onclick = () => startGame();
    } else if (kind === 'gameover') {
      const desc = T.gameoverDesc
        .replace('{level}', String(State.level))
        .replace('{score}', State.score.toLocaleString())
        .replace('{high}', State.high.toLocaleString());
      elModalDyn.innerHTML =
        '<p class="eyebrow" style="color:var(--syn-pink)">&gt; ' + esc(T.eyebrowOver) + '</p>' +
        '<h2>' + esc(T.gameOver) + '</h2>' +
        '<p>' + desc + '</p>' +
        '<button class="m-btn m-btn--primary" id="btn-again">$ ' + esc(T.btnAgain) + '</button>';
      elOverlay.classList.remove('hidden');
      $('btn-again').onclick = () => startGame();
    }
  }

  let toastTimer = null;
  function showToast(msg) {
    elToast.textContent = msg;
    elToast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => elToast.classList.remove('show'), 1600);
  }

  let last = performance.now();
  let acc = 0;
  const STEP = 1000 / 60;
  function loop(now) {
    acc += now - last;
    last = now;
    if (acc > 250) acc = STEP;
    let steps = 0;
    while (acc >= STEP && steps < 6) { update(); acc -= STEP; steps++; }
    render();
    requestAnimationFrame(loop);
  }
  requestAnimationFrame(loop);

  function autoHelp() {
    if (prefGet('breakout_help_seen') === true) return;
    prefSet('breakout_help_seen', true);
    if (!elHelp || typeof elHelp.showPopover !== 'function') return;
    setTimeout(() => { try { elHelp.showPopover(); } catch (_) {} }, 700);
  }

  renderBadges();
  syncPadHint();
  updateHUD();
  syncTouchUI();
  autoHelp();
})();
</script>
