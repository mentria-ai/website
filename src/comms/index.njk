const knockWhy = (reason) => (reason === 'network' ? T.test.no_server : reason ? T.test.server_error : T.push.failed);
const subscribeWhy = (err) => {
  if (!err) return T.test.unknown_error;
  if (err.name === 'TypeError' || err.name === 'SyntaxError') return T.test.no_server;
  if (err.name === 'NotAllowedError') return T.test.push_blocked;
