<script>
(() => {
  document.addEventListener('DOMContentLoaded', () => {
    const codeEl = document.getElementById('sdk-starter-code');
    const source = () => codeEl.textContent;
    MentriaUI.copyButton(document.getElementById('sdk-copy'), source, { copiedText: 'copied', failedText: 'copy failed' });
    document.getElementById('sdk-download').addEventListener('click', () => {
      MentriaUI.downloadFile('starter.html', new Blob([source()], { type: 'text/html' }));
      MentriaUI.toast('starter.html downloaded');
    });
  });
})();
</script>

