    strength_strong:       {{ ("tool.password-generator.strength_strong"       | t) | dump | safe }},
    strength_very_strong:  {{ ("tool.password-generator.strength_very_strong"  | t) | dump | safe }},
    calc_password:         {{ ("tool.password-generator.calc_password"         | t) | dump | safe }},
    calc_guarantee:        {{ ("tool.password-generator.calc_guarantee"        | t) | dump | safe }},
    calc_passphrase:       {{ ("tool.password-generator.calc_passphrase"       | t) | dump | safe }},
    calc_number:           {{ ("tool.password-generator.calc_number"           | t) | dump | safe }},
    calc_caps:             {{ ("tool.password-generator.calc_caps"             | t) | dump | safe }},
    symbols_hint:          {{ ("tool.password-generator.symbols_hint"          | t) | dump | safe }},
    lookalike_hint:        {{ ("tool.password-generator.lookalike_hint"        | t) | dump | safe }},
    status_new_password:   {{ ("tool.password-generator.status_new_password"   | t) | dump | safe }},
    status_new_passphrase: {{ ("tool.password-generator.status_new_passphrase" | t) | dump | safe }},
    status_more:           {{ ("tool.password-generator.status_more"           | t) | dump | safe }},
    status_copied:         {{ ("tool.password-generator.status_copied"         | t) | dump | safe }},
    status_copy_failed:    {{ ("tool.password-generator.status_copy_failed"    | t) | dump | safe }},
    status_need_set:       {{ ("tool.password-generator.status_need_set"       | t) | dump | safe }},
    status_no_crypto:      {{ ("tool.password-generator.status_no_crypto"      | t) | dump | safe }}
  };

  const CHARSETS = Object.freeze({
    lower: 'abcdefghijklmnopqrstuvwxyz',
    upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
    digits: '0123456789',
    symbols: '!#$%&()*+,-./:;<=>?@[]^_{|}~'
  });
  const SET_KEYS = Object.freeze(['lower', 'upper', 'digits', 'symbols']);
  const LOOKALIKES = '0Oo1lI|';
  const SEPARATORS = Object.freeze({ space: ' ', hyphen: '-', period: '.', underscore: '_' });
  const LENGTH_MIN = 8;
  const LENGTH_MAX = 128;
  const WORDS_MIN = 3;
  const WORDS_MAX = 10;
  const NUMBER_RANGE = 100;
  const ALTERNATIVE_COUNT = 5;
  const UINT32_RANGE = 4294967296;
  const WORDLIST = Object.freeze('acid acorn acre acts afar affix aged agent agile aging agony ahead aide aids aim ajar alarm alias alibi alien alike alive aloe aloft aloha alone amend amino ample amuse angel anger angle ankle apple april apron aqua area arena argue arise armed armor army aroma array arson art ashen ashes atlas atom attic audio avert avoid awake award awoke axis bacon badge bagel baggy baked baker balmy banjo barge barn bash basil bask batch bath baton bats blade blank blast blaze bleak blend bless blimp blink bloat blob blog blot blunt blurt blush boast boat body boil bok bolt boned boney bonus bony book booth boots boss botch both boxer breed bribe brick bride brim bring brink brisk broad broil broke brook broom brush buck bud buggy bulge bulk bully bunch bunny bunt bush bust busy buzz cable cache cadet cage cake calm cameo canal candy cane canon cape card cargo carol carry carve case cash cause cedar chain chair chant chaos charm chase cheek cheer chef chess chest chew chief chili chill chip chomp chop chow chuck chump chunk churn chute cider cinch city civic civil clad claim clamp clap clash clasp class claw clay clean clear cleat cleft clerk click cling clink clip cloak clock clone cloth cloud clump coach coast coat cod coil coke cola cold colt coma come comic comma cone cope copy coral cork cost cot couch cough cover cozy craft cramp crane crank crate crave crawl crazy creme crepe crept crib cried crisp crook crop cross crowd crown crumb crush crust cub cult cupid cure curl curry curse curve curvy cushy cut cycle dab dad daily dairy daisy dance dandy darn dart dash data date dawn deaf deal dean debit debt debug decaf decal decay deck decor decoy deed delay denim dense dent depth derby desk dial diary dice dig dill dime dimly diner dingy disco dish disk ditch ditzy dizzy dock dodge doing doll dome donor donut dose dot dove down dowry doze drab drama drank draw dress dried drift drill drive drone droop drove drown drum dry duck duct dude dug duke duo dusk dust duty dwarf dwell eagle early earth easel east eaten eats ebay ebony ebook echo edge eel eject elbow elder elf elk elm elope elude elves email emit empty emu enter entry envoy equal erase error erupt essay etch evade even evict evil evoke exact exit fable faced fact fade fall false fancy fang fax feast feed femur fence fend ferry fetal fetch fever fiber fifth fifty film filth final finch fit five flag flaky flame flap flask fled flick fling flint flip flirt float flock flop floss flyer foam foe fog foil folic folk food fool found fox foyer frail frame fray fresh fried frill frisk from front frost froth frown froze fruit gag gains gala game gap gas gave gear gecko geek gem genre gift gig gills given giver glad glass glide gloss glove glow glue goal going golf gong good gooey goofy gore gown grab grain grant grape graph grasp grass grave gravy gray green greet grew grid grief grill grip grit groom grope growl grub grunt guide gulf gulp gummy guru gush gut guy habit half halo halt happy harm hash hasty hatch hate haven hazel hazy heap heat heave hedge hefty help herbs hers hub hug hula hull human humid hump hung hunk hunt hurry hurt hush hut ice icing icon icy igloo image ion iron islam issue item ivory ivy jab jam jaws jazz jeep jelly jet jiffy job jog jolly jolt jot joy judge juice juicy july jumbo jump junky juror jury keep keg kept kick kilt king kite kitty kiwi knee knelt koala kung ladle lady lair lake lance land lapel large lash lasso last latch late lazy left legal lemon lend lens lent level lever lid life lift lilac lily limb limes line lint lion lip list lived liver lunar lunch lung lurch lure lurk lying lyric mace maker malt mama mango manor many map march mardi marry mash match mate math moan mocha moist mold mom moody mop morse most motor motto mount mouse mousy mouth move movie mower mud mug mulch mule mull mumbo mummy mural muse music musky mute nacho nag nail name nanny nap navy near neat neon nerd nest net next niece ninth nutty oak oasis oat ocean oil old olive omen onion only ooze opal open opera opt otter ouch ounce outer oval oven owl ozone pace pagan pager palm panda panic pants panty paper park party pasta patch path patio payer pecan penny pep perch perky perm pest petal petri petty photo plank plant plaza plead plot plow pluck plug plus poach pod poem poet pogo point poise poker polar polio polka polo pond pony poppy pork poser pouch pound pout power prank press print prior prism prize probe prong proof props prude prune pry pug pull pulp pulse puma punch punk pupil puppy purr purse push putt quack quake query quiet quill quilt quit quota quote rabid race rack radar radio raft rage raid rail rake rally ramp ranch range rank rant rash raven reach react ream rebel recap relax relay relic remix repay repel reply rerun reset rhyme rice rich ride rigid rigor rinse riot ripen rise risk ritzy rival river roast robe robin rock rogue roman romp rope rover royal ruby rug ruin rule runny rush rust rut sadly sage said saint salad salon salsa salt same sandy santa satin sauna saved savor sax say scale scam scan scare scarf scary scoff scold scoop scoot scope score scorn scout scowl scrap scrub scuba scuff sect sedan self send sepia serve set seven shack shade shady shaft shaky sham shape share sharp shed sheep sheet shelf shell shine shiny ship shirt shock shop shore shout shove shown showy shred shrug shun shush shut shy sift silk silly silo sip siren sixth size skate skew skid skier skies skip skirt skit sky slab slack slain slam slang slash slate slaw sled sleek sleep sleet slept slice slick slimy sling slip slit slob slot slug slum slurp slush small smash smell smile smirk smog snack snap snare snarl sneak sneer sniff snore snort snout snowy snub snuff speak speed spend spent spew spied spill spiny spoil spoke spoof spool spoon sport spot spout spray spree spur squad squat squid stack staff stage stain stall stamp stand stank stark start stash state stays steam steep stem step stew stick sting stir stock stole stomp stony stood stool stoop stop storm stout stove straw stray strut stuck stud stuff stump stung stunt suds sugar sulk surf sushi swab swan swarm sway swear sweat sweep swell swept swim swing swipe swirl swoop swore syrup tacky taco tag take tall talon tamer tank taper taps tarot tart task taste tasty taunt thank thaw theft theme thigh thing think thong thorn those throb thud thumb thump thus tiara tidal tidy tiger tile tilt tint tiny trace track trade train trait trap trash tray treat tree trek trend trial tribe trick trio trout truce truck trump trunk try tug tulip tummy turf tusk tutor tutu tux tweak tweet twice twine twins twirl twist uncle uncut undo unify union unit untie upon upper urban used user usher utter value vapor vegan venue verse vest veto vice video view viral virus visa visor vixen vocal voice void volt voter vowel wad wafer wager wages wagon wake walk wand wasp watch water wavy wheat whiff whole whoop wick widen widow width wife wifi wilt wimp wind wing wink wipe wired wiry wise wish wispy wok wolf womb wool woozy word work worry wound woven wrath wreck wrist xerox yahoo yam yard year yeast yelp yield yo-yo yodel yoga yoyo yummy zebra zero zesty zippy zone zoom'.split(' '));
  const DEFAULTS = Object.freeze({
    mode: 'password',
    length: 20,
    lower: true,
    upper: true,
    digits: true,
    symbols: true,
    avoidLookalikes: false,
    words: 7,
    separator: 'hyphen',
    capitalize: false,
    number: false
  });

  const cryptoSource = typeof crypto !== 'undefined' && crypto && typeof crypto.getRandomValues === 'function' ? crypto : null;
  const randomCell = new Uint32Array(1);

  function secureUint32() {
    cryptoSource.getRandomValues(randomCell);
    return randomCell[0];
  }

  function randomBelow(bound, source) {
    const next = source || secureUint32;
    const limit = UINT32_RANGE - (UINT32_RANGE % bound);
    let value = next();
    while (value >= limit) value = next();
    return value % bound;
  }

  function shuffleInPlace(items, source) {
    for (let i = items.length - 1; i > 0; i -= 1) {
      const j = randomBelow(i + 1, source);
      const held = items[i];
      items[i] = items[j];
      items[j] = held;
    }
    return items;
  }

  function withoutLookalikes(chars) {
    return Array.from(chars).filter((ch) => !LOOKALIKES.includes(ch)).join('');
  }

  function passwordPools(settings) {
    return SET_KEYS
      .filter((key) => settings[key])
      .map((key) => (settings.avoidLookalikes ? withoutLookalikes(CHARSETS[key]) : CHARSETS[key]));
  }

  function generateFromPools(pools, length, source) {
    const alphabet = pools.join('');
    const chars = pools.map((pool) => pool[randomBelow(pool.length, source)]);
    while (chars.length < length) chars.push(alphabet[randomBelow(alphabet.length, source)]);
    return shuffleInPlace(chars, source).join('');
  }

  function poolsMinEntropy(pools, length) {
    const count = pools.length;
    if (!count || length < count) return 0;
    const alphabet = pools.reduce((sum, pool) => sum + pool.length, 0);
    const share = Math.floor(length / count);
    const remainder = length % count;
    let bits = (length - count) * Math.log2(alphabet);
    pools.forEach((pool, index) => {
      bits += Math.log2(pool.length) + Math.log2(length - index);
    });
    bits -= remainder * Math.log2(share + 1) + (count - remainder) * Math.log2(share);
    return bits;
  }

  function generatePassword(settings, source) {
    return generateFromPools(passwordPools(settings), settings.length, source);
  }

  function passwordEntropy(settings) {
    return poolsMinEntropy(passwordPools(settings), settings.length);
  }

  function capitalizeWord(word) {
    return word.charAt(0).toUpperCase() + word.slice(1);
  }

  function generatePassphrase(settings, source) {
    const parts = [];
    for (let i = 0; i < settings.words; i += 1) {
      const word = WORDLIST[randomBelow(WORDLIST.length, source)];
      parts.push(settings.capitalize ? capitalizeWord(word) : word);
    }
    if (settings.number) parts.push(String(randomBelow(NUMBER_RANGE, source)).padStart(2, '0'));
    return parts.join(SEPARATORS[settings.separator]);
  }

  function passphraseEntropy(settings) {
    return settings.words * Math.log2(WORDLIST.length) + (settings.number ? Math.log2(NUMBER_RANGE) : 0);
  }

  function strengthLevel(bits) {
    if (bits >= 100) return 4;
    if (bits >= 70) return 3;
    if (bits >= 50) return 2;
    return 1;
  }

  function clampInteger(value, min, max, fallback) {
    const number = typeof value === 'number' ? value : parseInt(value, 10);
    if (!Number.isFinite(number)) return fallback;
    return Math.min(max, Math.max(min, Math.round(number)));
  }

  function pickBoolean(value, fallback) {
    return typeof value === 'boolean' ? value : fallback;
  }

  function sanitizeSettings(raw) {
    const source = raw && typeof raw === 'object' ? raw : {};
    const clean = {
      mode: source.mode === 'passphrase' ? 'passphrase' : 'password',
      length: clampInteger(source.length, LENGTH_MIN, LENGTH_MAX, DEFAULTS.length),
      lower: pickBoolean(source.lower, DEFAULTS.lower),
      upper: pickBoolean(source.upper, DEFAULTS.upper),
      digits: pickBoolean(source.digits, DEFAULTS.digits),
      symbols: pickBoolean(source.symbols, DEFAULTS.symbols),
      avoidLookalikes: pickBoolean(source.avoidLookalikes, DEFAULTS.avoidLookalikes),
      words: clampInteger(source.words, WORDS_MIN, WORDS_MAX, DEFAULTS.words),
      separator: Object.prototype.hasOwnProperty.call(SEPARATORS, source.separator) ? source.separator : DEFAULTS.separator,
      capitalize: pickBoolean(source.capitalize, DEFAULTS.capitalize),
      number: pickBoolean(source.number, DEFAULTS.number)
    };
    if (!SET_KEYS.some((key) => clean[key])) SET_KEYS.forEach((key) => { clean[key] = true; });
    return clean;
  }

  const STORE_NS = 'tools';
  const STORE_KEY = 'password_generator_settings';
  const byId = (id) => document.getElementById(id);
  const ui = {
    mode: byId('pwg-mode'),
    labelPassword: byId('pwg-label-password'),
    labelPassphrase: byId('pwg-label-passphrase'),
    secret: byId('pwg-secret'),
    meter: byId('pwg-meter'),
    strength: byId('pwg-strength'),
    bits: byId('pwg-bits'),
    calc: byId('pwg-calc'),
    copy: byId('pwg-copy'),
    regenerate: byId('pwg-regenerate'),
    more: byId('pwg-more'),
    moreWrap: byId('pwg-more-wrap'),
    alternatives: byId('pwg-alternatives'),
    status: byId('pwg-status'),
    panelPassword: byId('pwg-panel-password'),
    panelPassphrase: byId('pwg-panel-passphrase'),
    length: byId('pwg-length'),
    lengthRange: byId('pwg-length-range'),
    symbolsHint: byId('pwg-symbols-hint'),
    lookalike: byId('pwg-lookalike'),
    lookalikeHint: byId('pwg-lookalike-hint'),
    words: byId('pwg-words'),
    wordsRange: byId('pwg-words-range'),
    separator: byId('pwg-separator'),
    capitalize: byId('pwg-capitalize'),
    number: byId('pwg-number')
  };
  const setBoxes = SET_KEYS.reduce((boxes, key) => {
    boxes[key] = byId('pwg-set-' + key);
    return boxes;
  }, {});

  const status = MentriaUI.status(ui.status);
  const saver = MentriaUI.debouncedSaver(saveSettings, 400);
  const feedbackTimers = new WeakMap();
  const settings = sanitizeSettings(readStoredSettings());
  let settingsDirty = false;
  let current = '';
  let alternatives = [];
  let statusTimer = 0;
  let announceTimer = 0;

  function readStoredSettings() {
    if (!window.MentriaStore) return null;
    try {
      return window.MentriaStore.get(STORE_NS, STORE_KEY);
    } catch (_) {
      return null;
    }
  }

  function saveSettings() {
    if (!settingsDirty || !window.MentriaStore) return;
    settingsDirty = false;
    try {
      window.MentriaStore.set(STORE_NS, STORE_KEY, sanitizeSettings(settings));
    } catch (_) {
      settingsDirty = true;
    }
  }

  function fill(template, values) {
    return Object.keys(values).reduce((text, key) => text.split('{' + key + '}').join(String(values[key])), template);
  }

  function formatNumber(value, fractionDigits) {
    try {
      return new Intl.NumberFormat(document.documentElement.lang || undefined, {
        minimumFractionDigits: fractionDigits,
        maximumFractionDigits: fractionDigits
      }).format(value);
    } catch (_) {
      return value.toFixed(fractionDigits);
    }
  }

  function charClass(ch, mode) {
    if ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')) return '';
    if (ch >= '0' && ch <= '9') return 'pwg__ch--digit';
    return mode === 'passphrase' ? 'pwg__ch--sep' : 'pwg__ch--symbol';
  }

  function paint(target, text, mode) {
    const fragment = document.createDocumentFragment();
    let run = '';
    let runClass = null;
    const flush = () => {
      if (!run) return;
      if (runClass) {
        const span = document.createElement('span');
        span.className = runClass;
        span.textContent = run;
        fragment.appendChild(span);
      } else {
        fragment.appendChild(document.createTextNode(run));
      }
      run = '';
    };
    for (const ch of text) {
      const nextClass = charClass(ch, mode);
      if (nextClass !== runClass) {
        flush();
        runClass = nextClass;
      }
      run += ch;
    }
    flush();
    target.replaceChildren(fragment);
  }

  function replay(element) {
    element.classList.remove('is-fresh');
    void element.offsetWidth;
    element.classList.add('is-fresh');
  }

  function generateSecret() {
    return settings.mode === 'passphrase' ? generatePassphrase(settings) : generatePassword(settings);
  }

  function currentEntropy() {
    return settings.mode === 'passphrase' ? passphraseEntropy(settings) : passwordEntropy(settings);
  }

  function makeAlternatives() {
    const list = [];
    for (let i = 0; i < ALTERNATIVE_COUNT; i += 1) list.push(generateSecret());
    return list;
  }

  function strengthLabel(level) {
    return [COPY.strength_weak, COPY.strength_fair, COPY.strength_strong, COPY.strength_very_strong][level - 1];
  }

  function bitsText(bits) {
    return fill(COPY.bits_value, { bits: formatNumber(Math.floor(bits), 0) });
  }

  function describeCalculation() {
    if (settings.mode === 'passphrase') {
      let text = fill(COPY.calc_passphrase, {
        words: formatNumber(settings.words, 0),
        per: formatNumber(Math.log2(WORDLIST.length), 1)
      });
      if (settings.number) text += ' ' + fill(COPY.calc_number, { bits: formatNumber(Math.log2(NUMBER_RANGE), 1) });
      if (settings.capitalize) text += ' · ' + COPY.calc_caps;
      return text;
    }
    const pools = passwordPools(settings);
    const poolSize = pools.reduce((sum, pool) => sum + pool.length, 0);
    let text = fill(COPY.calc_password, {
      length: formatNumber(settings.length, 0),
      pool: formatNumber(poolSize, 0)
    });
    if (pools.length > 1) text += ' · ' + COPY.calc_guarantee;
    return text;
  }

  function renderMeter() {
    const bits = currentEntropy();
    const level = strengthLevel(bits);
    ui.meter.dataset.level = String(level);
    ui.strength.textContent = strengthLabel(level);
    ui.bits.textContent = bitsText(bits);
    ui.calc.textContent = describeCalculation();
  }

  function renderGlyphHint(target, template, chars) {
    const [before, after = ''] = template.split('{chars}');
    const glyphs = document.createElement('code');
    glyphs.className = 'pwg__glyphs';
    glyphs.setAttribute('translate', 'no');
    glyphs.textContent = chars;
    target.replaceChildren(document.createTextNode(before), glyphs, document.createTextNode(after));
  }

  function renderHints() {
    renderGlyphHint(ui.lookalikeHint, COPY.lookalike_hint, Array.from(LOOKALIKES).join(' '));
    renderGlyphHint(ui.symbolsHint, COPY.symbols_hint, settings.avoidLookalikes ? withoutLookalikes(CHARSETS.symbols) : CHARSETS.symbols);
  }

  function createCopyButton(label) {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'm-btn m-btn--ghost pwg__btn pwg__alt-copy';
    button.setAttribute('aria-label', label);
    const swap = document.createElement('span');
    swap.className = 'pwg__swap';
    const idle = document.createElement('span');
    idle.className = 'pwg__swap-idle';
    idle.textContent = COPY.btn_copy;
    const done = document.createElement('span');
    done.className = 'pwg__swap-done';
    done.textContent = COPY.btn_copied;
    swap.append(idle, done);
    button.appendChild(swap);
    return button;
  }

  function renderAlternatives() {
    ui.alternatives.dataset.mode = settings.mode;
    const items = alternatives.map((value, index) => {
      const item = document.createElement('li');
      item.className = 'pwg__alt';
      item.style.setProperty('--pwg-i', String(index));
      const text = document.createElement('span');
      text.className = 'pwg__alt-text';
      text.setAttribute('translate', 'no');
      paint(text, value, settings.mode);
      const button = createCopyButton(fill(COPY.copy_option, { n: formatNumber(index + 1, 0) }));
      button.addEventListener('click', () => copySecret(value, button, text));
      item.append(text, button);
      return item;
    });
    ui.alternatives.replaceChildren(...items);
  }

  function refresh(withAlternatives) {
    if (!cryptoSource) return;
    current = generateSecret();
    ui.secret.dataset.mode = settings.mode;
    paint(ui.secret, current, settings.mode);
    replay(ui.secret);
    if (withAlternatives && alternatives.length) {
      alternatives = makeAlternatives();
      renderAlternatives();
    }
    renderMeter();
  }

  function announce(message, tone) {
    clearTimeout(statusTimer);
    clearTimeout(announceTimer);
    status.clear();
    statusTimer = setTimeout(() => {
      status.set(message, tone);
      if (tone !== 'err') statusTimer = setTimeout(() => status.clear(), 4000);
    }, 60);
  }

  function announceFresh() {
    const bits = currentEntropy();
    announce([
      settings.mode === 'passphrase' ? COPY.status_new_passphrase : COPY.status_new_password,
      bitsText(bits),
      strengthLabel(strengthLevel(bits))
    ].join(' · '));
  }

  function announceSoon() {
    clearTimeout(announceTimer);
    announceTimer = setTimeout(announceFresh, 700);
  }

  function settingsChanged() {
    settingsDirty = true;
    saver.schedule();
    refresh(true);
    announceSoon();
  }

  function applyMode() {
    const passphrase = settings.mode === 'passphrase';
    ui.panelPassword.hidden = passphrase;
    ui.panelPassphrase.hidden = !passphrase;
    ui.labelPassword.hidden = passphrase;
    ui.labelPassphrase.hidden = !passphrase;
  }

  function selectText(element) {
    try {
      const range = document.createRange();
      range.selectNodeContents(element);
      const selection = window.getSelection();
      selection.removeAllRanges();
      selection.addRange(range);
    } catch (_) {}
  }

  function flashCopied(button) {
    clearTimeout(feedbackTimers.get(button));
    button.classList.add('is-copied');
    feedbackTimers.set(button, setTimeout(() => button.classList.remove('is-copied'), 1500));
  }

  async function copySecret(text, button, source) {
    if (!text) return;
    try {
      if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') throw new Error('clipboard');
      await navigator.clipboard.writeText(text);
      flashCopied(button);
      announce(COPY.status_copied, 'ok');
    } catch (_) {
      selectText(source);
      announce(COPY.status_copy_failed, 'err');
    }
  }

  function bindNumberPair(numberInput, rangeInput, key, min, max) {
    const update = (value) => {
      if (value === settings[key]) return;
      settings[key] = value;
      settingsChanged();
    };
    rangeInput.addEventListener('input', () => {
      const value = clampInteger(rangeInput.value, min, max, settings[key]);
      numberInput.value = String(value);
      update(value);
    });
    numberInput.addEventListener('input', () => {
      const value = parseInt(numberInput.value, 10);
      if (!Number.isFinite(value) || value < min || value > max) return;
      rangeInput.value = String(value);
      update(value);
    });
    numberInput.addEventListener('change', () => {
      const value = clampInteger(numberInput.value, min, max, settings[key]);
      numberInput.value = String(value);
      rangeInput.value = String(value);
      update(value);
    });
  }

  function onModeChange(value) {
    const next = value === 'passphrase' ? 'passphrase' : 'password';
    if (next === settings.mode) return;
    settings.mode = next;
    applyMode();
    settingsChanged();
  }

  function onSeparatorChange(value) {
    if (!Object.prototype.hasOwnProperty.call(SEPARATORS, value) || value === settings.separator) return;
    settings.separator = value;
    settingsChanged();
  }

  function refreshCopy() {
    const i18n = window.MentriaI18n;
    if (!i18n || typeof i18n.t !== 'function') return;
    Object.keys(COPY).forEach((key) => {
      const value = i18n.t('tool.password-generator.' + key);
      if (typeof value === 'string' && value) COPY[key] = value;
    });
  }

  const modeControl = MentriaUI.segmented(ui.mode, onModeChange);
  const separatorControl = MentriaUI.segmented(ui.separator, onSeparatorChange);

  function syncControls() {
    ui.length.value = String(settings.length);
    ui.lengthRange.value = String(settings.length);
    SET_KEYS.forEach((key) => { setBoxes[key].checked = settings[key]; });
    ui.lookalike.checked = settings.avoidLookalikes;
    ui.words.value = String(settings.words);
    ui.wordsRange.value = String(settings.words);
    ui.capitalize.checked = settings.capitalize;
    ui.number.checked = settings.number;
    modeControl.set(settings.mode);
    separatorControl.set(settings.separator);
    applyMode();
  }

  bindNumberPair(ui.length, ui.lengthRange, 'length', LENGTH_MIN, LENGTH_MAX);
  bindNumberPair(ui.words, ui.wordsRange, 'words', WORDS_MIN, WORDS_MAX);

  SET_KEYS.forEach((key) => {
    setBoxes[key].addEventListener('change', () => {
      if (!SET_KEYS.some((name) => setBoxes[name].checked)) {
        setBoxes[key].checked = true;
        announce(COPY.status_need_set, 'err');
        return;
      }
      settings[key] = setBoxes[key].checked;
      settingsChanged();
    });
  });

  ui.lookalike.addEventListener('change', () => {
    settings.avoidLookalikes = ui.lookalike.checked;
    renderHints();
    settingsChanged();
  });

  ui.capitalize.addEventListener('change', () => {
    settings.capitalize = ui.capitalize.checked;
    settingsChanged();
  });

  ui.number.addEventListener('change', () => {
    settings.number = ui.number.checked;
    settingsChanged();
  });

  ui.copy.addEventListener('click', () => copySecret(current, ui.copy, ui.secret));

  ui.regenerate.addEventListener('click', () => {
    refresh(false);
    announceFresh();
  });

  ui.more.addEventListener('click', () => {
    alternatives = makeAlternatives();
    renderAlternatives();
    ui.moreWrap.hidden = false;
    announce(COPY.status_more);
  });

  document.addEventListener('mentria:localechange', () => {
    refreshCopy();
    renderHints();
    if (!cryptoSource) {
      status.set(COPY.status_no_crypto, 'err');
      return;
    }
    renderMeter();
    if (alternatives.length) renderAlternatives();
    clearTimeout(statusTimer);
    clearTimeout(announceTimer);
    status.clear();
  });

  syncControls();
  renderHints();
  if (cryptoSource) {
    refresh(false);
  } else {
    [ui.copy, ui.regenerate, ui.more].forEach((button) => { button.disabled = true; });
    ui.meter.hidden = true;
    status.set(COPY.status_no_crypto, 'err');
  }
})();
</script>

