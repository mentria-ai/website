---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/tools/quote/index.html"
eleventyComputed:
  lang: "{{ locale.code }}"
  title: "{{ 'tools.quote.title' | t }}"
  description: "{{ 'tools.quote.lede' | t }}"
---
<section class="hero" style="padding-top:1rem;">
  <p class="eyebrow eyebrow--crumbs"><a class="eyebrow__link" href="{{ locale.pathPrefix }}/" aria-label="{{ 'nav.home' | t }}">~</a><span class="eyebrow__sep">/</span><a class="eyebrow__link" href="{{ locale.pathPrefix }}/tools/">tools</a><span class="eyebrow__sep">/</span><span class="eyebrow__current">quote</span></p>
  <h1>{{ "tools.quote.title" | t }}</h1>
  <p>{{ "tools.quote.lede" | t }}</p>
  {% include "tldr.njk" %}
</section>

{% set terminalTitle = "quote.js" %}
{% include "terminal-frame-open.njk" %}
<section class="mq">
  <div class="mq__status">
    <span class="mq__status-dot" id="mq-status-dot"></span>
    <span class="mq__status-text" id="mq-status-text" role="status" aria-live="polite">{{ "tool.quote.status_initializing" | t }}</span>
  </div>

  <div class="mq__activity" id="mq-activity"></div>

  <div class="mq__quote-area">
    <div class="mq__quote" id="mq-quote"></div>
  </div>

  <div class="mq__actions">
    <button class="mq__btn mq__btn--primary" id="mq-new" disabled>{{ "tool.quote.btn_new" | t }}</button>
    <button class="mq__btn mq__btn--secondary" id="mq-copy" style="display:none;">{{ "tool.quote.btn_copy" | t }}</button>
    <button class="mq__btn mq__btn--secondary" id="mq-share" style="display:none;">{{ "common.share" | t }}</button>
  </div>
</section>
{% include "terminal-frame-close.njk" %}

{% include "tool-schema.njk" %}

<script src="/assets/js/markdown.js?v={{ buildHash }}"></script>

<script type="module">
const COPY = {
  statusLoadingModel: {{ ("tool.quote.status_loading_model" | t) | dump | safe }},
  statusReady:        {{ ("tool.quote.status_ready"         | t) | dump | safe }},
  statusGenerating:   {{ ("tool.quote.status_generating"    | t) | dump | safe }},
  btnCopy:            {{ ("tool.quote.btn_copy"             | t) | dump | safe }},
  btnCopied:          {{ ("tool.quote.btn_copied"           | t) | dump | safe }},
  btnFailed:          {{ ("tool.quote.btn_failed"           | t) | dump | safe }},
  errNoWebGpu:        {{ ("tool.quote.err_no_webgpu"        | t) | dump | safe }},
  errUnsupportedBody: {{ ("tool.quote.err_unsupported_body" | t) | dump | safe }},
  errLoadRuntime:     {{ ("tool.quote.err_load_runtime"     | t) | dump | safe }},
  engineOffline:      {{ ("common.ai_engine_offline"        | t) | dump | safe }},
  engineFailed:       {{ ("common.ai_engine_failed"         | t) | dump | safe }},
  modelOffline:       {{ ("common.ai_model_offline"         | t) | dump | safe }},
  offline:            {{ ("common.offline_title"            | t) | dump | safe }},
  errDeviceLost:      {{ ("tool.quote.err_device_lost"      | t) | dump | safe }},
  errLoadPrefix:      {{ ("tool.quote.err_load_prefix"      | t) | dump | safe }},
  errNoQuote:         {{ ("tool.quote.err_no_quote"         | t) | dump | safe }},
  errGeneration:      {{ ("tool.quote.err_generation"       | t) | dump | safe }},
  downloadPostponed:  {{ ("common.download_postponed"       | t) | dump | safe }}
};
const COPY_KEYS = {
  statusLoadingModel: 'tool.quote.status_loading_model',
  statusReady: 'tool.quote.status_ready',
  statusGenerating: 'tool.quote.status_generating',
  btnCopy: 'tool.quote.btn_copy',
  btnCopied: 'tool.quote.btn_copied',
  btnFailed: 'tool.quote.btn_failed',
  errNoWebGpu: 'tool.quote.err_no_webgpu',
  errUnsupportedBody: 'tool.quote.err_unsupported_body',
  errLoadRuntime: 'tool.quote.err_load_runtime',
  engineOffline: 'common.ai_engine_offline',
  engineFailed: 'common.ai_engine_failed',
  modelOffline: 'common.ai_model_offline',
  offline: 'common.offline_title',
  errDeviceLost: 'tool.quote.err_device_lost',
  errLoadPrefix: 'tool.quote.err_load_prefix',
  errNoQuote: 'tool.quote.err_no_quote',
  errGeneration: 'tool.quote.err_generation',
  downloadPostponed: 'common.download_postponed'
};

const MENTRIA_DIST_BASE  = '/assets/mentria/dist/';

const SYSTEM_PROMPT =
  'You are a poetic thinker. Write one short, original motivational quote ' +
  '(1-2 sentences). Do not attribute it to anyone. No preamble, no ' +
  'quotation marks \u2014 just the quote itself.';
const MAX_TOKENS = 128;
const THEMES = ['patience', 'courage', 'starting over', 'small steps', 'failure', 'curiosity', 'rest', 'discipline',
  'kindness', 'change', 'focus', 'learning', 'hope', 'gratitude', 'friendship', 'fear', 'growth', 'time',
  'creativity', 'resilience', 'honesty', 'balance', 'ambition', 'letting go'];
const ANCHORS = ['a kettle coming to the boil', 'a key that no longer fits its lock', 'frost on a window', 'a paper boat in a gutter',
  'moss on the north side of a tree', "a lighthouse keeper's log", 'a borrowed ladder', 'a seed packet in a drawer',
  'a bicycle with one flat tyre', 'a bridge half built', 'a candle in a power cut', 'bread rising under a cloth',
  'a compass in a coat pocket', 'a garden after rain', 'a map with folds worn white', 'a violin left out of its case',
  'a tide coming in', 'a kite caught in a tree', 'footprints in fresh snow', 'a jar of buttons', 'an unfinished letter',
  'a train platform at dawn', 'a sourdough starter', 'a sprained ankle healing', 'a river stone worn smooth',
  'a cracked teacup mended with gold', 'a night bus', 'a pencil worn to a stub', 'a beehive in winter',
  'a sailboat waiting for wind', 'a chess pawn reaching the last row', 'a lantern on a hill path', 'a dog-eared library book',
  'roots splitting a pavement', 'a clock with a missing hand', 'a fishing line in still water', 'a scarf being knitted',
  'a staircase in the dark', 'a puddle reflecting the sky', 'a door left ajar', 'a mountain hut with one bed',
  'a recipe card stained with flour', 'a bird testing a branch', 'a quiet street after a parade', 'a pair of muddy boots',
  'an orchard in blossom', 'a rowing boat with one oar', 'a first draft full of crossings-out', 'a well with a long rope',
  'a sunflower turning', 'a tent pitched in wind', 'a radio finding a station', 'a glass of water on a bedside table',
  'a swing still moving', 'a mapmaker at a coastline', 'a snail crossing a path', 'a pottery wheel spinning',
  'a ship in a bottle', 'a field after the harvest', 'a balcony full of herbs'];
const REJECT = [/^\W*true\b/i, /\bis not\b[\s\S]*\b(but|it's)\b/i, /absence of fear|great work is to love|thousand miles/i];
let lastTheme = -1;
function quoteRequest() {
  const theme = nextTheme();
  const anchor = ANCHORS[Math.floor(Math.random() * ANCHORS.length)];
  return 'Write one original motivational line of at most 22 words. Build it on this image: ' + anchor + '. ' +
    'Let it quietly be about ' + theme + ' without using the word "' + theme + '" or its forms. ' +
    'Do not use the shape "X is not Y, but Z". Do not begin with "True". ' +
    'No famous sayings, no attribution, no quotation marks. Only the line.';
}
function nextTheme() {
  let i = Math.floor(Math.random() * THEMES.length);
  if (i === lastTheme) i = (i + 1) % THEMES.length;
  lastTheme = i;
  return THEMES[i];
}

/* \u2500\u2500 Status helpers \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */
const statusDot  = document.getElementById('mq-status-dot');
const statusText = document.getElementById('mq-status-text');
const noteEl     = document.getElementById('mq-quote');
const copyEl     = document.getElementById('mq-copy');
let shownStatus = null;
let shownNote = null;
function setStatus(state, name, extra) {
  statusDot.className = 'mq__status-dot mq__status-dot--' + state;
  shownStatus = { name, extra: extra || '' };
  statusText.textContent = COPY[name] + shownStatus.extra;
}
function showNote(name) {
  shownNote = name;
  noteEl.textContent = COPY[name];
}
document.addEventListener('mentria:localechange', () => {
  const I = window.MentriaI18n;
  if (!I || typeof I.t !== 'function') return;
  const before = Object.assign({}, COPY);
  for (const name of Object.keys(COPY_KEYS)) {
    const v = I.t(COPY_KEYS[name]);
    if (typeof v === 'string' && v !== COPY_KEYS[name]) COPY[name] = v;
  }
  if (shownStatus) statusText.textContent = COPY[shownStatus.name] + shownStatus.extra;
  if (shownNote && noteEl.textContent === before[shownNote]) noteEl.textContent = COPY[shownNote];
  if (!copyEl.querySelector('i18n-t')) {
    for (const name of ['btnCopy', 'btnCopied', 'btnFailed']) {
      if (copyEl.textContent === before[name]) { copyEl.textContent = COPY[name]; break; }
    }
  }
});

/* \u2500\u2500 WebGPU gate \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */
function showUnsupportedError(reason, note) {
  setStatus('error', reason);
  showNote(note || 'errUnsupportedBody');
  document.getElementById('mq-new').disabled = true;
}

if (!navigator.gpu) {
  showUnsupportedError('errNoWebGpu');
} else {
  let MentriaEngine;
  try {
    ({ MentriaEngine } = await import(MENTRIA_DIST_BASE + 'mentria.mjs'));
  } catch (err) {
    console.error('Failed to load mentria-engine bundle:', err);
    if (navigator.onLine) showUnsupportedError('errLoadRuntime', 'engineFailed');
    else showUnsupportedError('offline', 'engineOffline');
  }
  if (MentriaEngine) runApp(MentriaEngine);
}

function runApp(MentriaEngine) {
  /* DOM refs */
  const activityHost   = document.getElementById('mq-activity');
  let strip = null;
  let Activity = null;
  async function ensureStrip() {
    if (strip) return strip;
    Activity = await import('/assets/js/mentria-activity.js');
    strip = Activity.createActivityStrip(activityHost);
    return strip;
  }
  const quoteEl        = document.getElementById('mq-quote');
  const newBtn         = document.getElementById('mq-new');
  const copyBtn        = document.getElementById('mq-copy');
  const shareBtn       = document.getElementById('mq-share');

  let engine = null;
  let stripThink = (s) => s;
  let generating = false;
  let loading = null;
  let blocked = false;
  let onlineRetry = false;


  function onEngineProgress(p) { if (strip) strip.onProgress(p); }

  function onDeviceLost(info) {
    const dead = engine;
    engine = null;
    if (dead) { try { dead.terminate(); } catch (_) {} }
    setStatus('error', 'errDeviceLost');
    if (!generating && !loading) newBtn.disabled = false;
    console.error('WebGPU device lost:', info);
  }

  function loadModel() {
    if (!loading) loading = startModel().finally(() => { loading = null; });
    return loading;
  }

  function retryWhenOnline() {
    if (onlineRetry) return;
    onlineRetry = true;
    window.addEventListener('online', () => {
      onlineRetry = false;
      if (engine || loading || generating) return;
      loadModel().then(() => { if (engine && !generating) generateQuote(); });
    }, { once: true });
  }

  /* Load engine + model */
  async function startModel() {
    blocked = false;
    setStatus('loading', 'statusLoadingModel');
    await ensureStrip();
    try {
      const Model = await import('/assets/js/mentria-model.js');
      stripThink = Model.stripThink;
      const createEngine = () => {
        const e = new MentriaEngine(MENTRIA_DIST_BASE + 'worker.mjs');
        window.mentriaWrapEngine && window.mentriaWrapEngine(e);
        return e;
      };
      const res = await Model.ensureModel(createEngine, {
        vision: false,
        offerUpgrade: true,
        onProgress: onEngineProgress,
        onTier: (info) => strip.setTier(info),
        onDeviceLost
      });
      engine = res.engine;
      strip.done({ prime: COPY.statusReady, linger: 1200 });
      setStatus('ready', 'statusReady');
      newBtn.disabled = false;
    } catch (err) {
      if (strip) strip.hide();
      console.error('Model load error:', err);
      if (err && err.message === 'download-postponed') { blocked = true; setStatus('idle', 'downloadPostponed'); }
      else if (err && (err.message === 'no-webgpu' || err.name === 'NoWebGpuError' || err.name === 'WebGPUUnsupportedError')) { blocked = true; showUnsupportedError('errNoWebGpu'); }
      else {
        const offline = navigator.onLine === false;
        if (offline) setStatus('error', 'modelOffline');
        else setStatus('error', 'errLoadPrefix', String(err.message || err));
        newBtn.disabled = generating;
        if (offline) retryWhenOnline();
      }
    }
  }

  /* Generate quote */
  async function generateQuote() {
    if (generating) return;
    generating = true;
    newBtn.disabled = true;
    if (!engine) await loadModel();
    const eng = engine;
    if (!eng) {
      generating = false;
      newBtn.disabled = blocked;
      return;
    }
    copyBtn.style.display = 'none';
    shareBtn.style.display = 'none';
    shownNote = null;
    quoteEl.textContent = '';
    quoteEl.classList.add('mq__quote--typing');
    setStatus('generating', 'statusGenerating');

    let fullText = '';

    let nTok = 0;
    let frame = 0;
    let open = true;

    function paintToken() {
      frame = 0;
      if (!open) return;
      const display = stripWrapQuotes(stripThink(fullText.replace(/<think>[\s\S]*?<\/think>/g, '')).trim());
      // Markdown-rendered output (escapes html first → safe). Falls back to text.
      if (window.renderMarkdown) quoteEl.innerHTML = renderMarkdown(display) || '<p>…</p>';
      else quoteEl.textContent = display || '…';
    }
    const close = () => { open = false; if (frame) { cancelAnimationFrame(frame); frame = 0; } };

    try {
      let display = '';
      for (let attempt = 0; attempt < 3; attempt++) {
        const messages = [
          { role: 'system', content: SYSTEM_PROMPT },
          { role: 'user',   content: quoteRequest() },
        ];
        fullText = '';
        open = true;
        await eng.generate({
          messages,
          maxTokens: MAX_TOKENS,
          // Match the original transformers.js sampling for similar
          // creative variance: do_sample=true, temp=0.9, top_p=0.95.
          temperature: 0.9,
          topP: 0.95,
          topK: 50,
          repetitionPenalty: 1.0,
          enableThinking: false,
        }, (event) => {
          if (!open) return;
          if (typeof event.token === 'string' && event.token.length > 0) {
            // Skip Qwen special tokens (<|im_end|>, <|endoftext|>, etc) from the visible stream
            if (/^<\|[^|]*\|>$/.test(event.token)) return;
            fullText += event.token;
            if (strip) strip.token(++nTok);
            if (!frame) frame = requestAnimationFrame(paintToken);
          }
        });

        close();
        display = stripWrapQuotes(stripThink(fullText
          .replace(/<think>[\s\S]*?<\/think>/g, ''))
          .replace(/<\|[^|]*\|>/g, '')
          .trim());
        if (!display || !REJECT.some((re) => re.test(display))) break;
      }
      if (strip) strip.done({ tokens: nTok });
      const html = display && window.renderMarkdown ? renderMarkdown(display) : '';
      if (!display || (window.renderMarkdown && !html)) showNote('errNoQuote');
      else if (window.renderMarkdown) quoteEl.innerHTML = html;
      else quoteEl.textContent = display;
      quoteEl.classList.remove('mq__quote--typing');
      if (display) copyBtn.style.display = '';
      if (display && navigator.share) shareBtn.style.display = '';
    } catch (err) {
      close();
      console.error('Generation error:', err);
      const lost = engine !== eng;
      if (strip) strip.error(String(err && err.message || err), lost ? { phase: 'answering', prime: COPY.errDeviceLost, onRetry: generateQuote } : { phase: 'answering' });
      showNote('errGeneration');
      quoteEl.classList.remove('mq__quote--typing');
    }

    generating = false;
    newBtn.disabled = false;
    if (engine === eng) setStatus('ready', 'statusReady');
  }

  function stripWrapQuotes(text) {
    return text
      .replace(/^[\s"'\u201C\u201D\u2018\u2019]+/, '')
      .replace(/[\s"'\u201C\u201D\u2018\u2019]+$/, '');
  }

  /* Copy to clipboard */
  async function copyQuote() {
    const text = quoteEl.textContent;
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      copyBtn.textContent = COPY.btnCopied;
      setTimeout(() => { copyBtn.textContent = COPY.btnCopy; }, 1500);
    } catch {
      copyBtn.textContent = COPY.btnFailed;
      setTimeout(() => { copyBtn.textContent = COPY.btnCopy; }, 1500);
    }
  }

  async function shareQuote() {
    const text = quoteEl.textContent;
    if (!text) return;
    try {
      await navigator.share({ title: document.title, text: text, url: location.href });
    } catch (_) {}
  }

  /* Events */
  newBtn.addEventListener('click', generateQuote);
  copyBtn.addEventListener('click', copyQuote);
  shareBtn.addEventListener('click', shareQuote);

  /* Init */
  (async () => {
    await loadModel();
    if (engine) generateQuote();
  })();
}
</script>

<style>
.mq {
  display: flex;
  flex-direction: column;
  font-family: var(--font-mono);
  min-height: min(420px, 55vh);
}

/* Status bar */
.mq__status {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 0.75rem;
  border-bottom: 1px solid var(--term-border);
  font-size: 0.75rem;
  color: var(--term-muted);
  flex-shrink: 0;
}

.mq__status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--term-muted);
  flex-shrink: 0;
}
.mq__status-dot--idle     { background: var(--term-muted); }
.mq__status-dot--loading  { background: var(--syn-amber); box-shadow: 0 0 6px var(--syn-amber); animation: mq-pulse 1.5s ease-in-out infinite; }
.mq__status-dot--ready    { background: var(--syn-green); box-shadow: 0 0 6px var(--syn-green); }
.mq__status-dot--generating { background: var(--syn-cyan); box-shadow: 0 0 6px var(--syn-cyan); animation: mq-pulse 1s ease-in-out infinite; }
.mq__status-dot--error    { background: var(--syn-pink); box-shadow: 0 0 6px var(--syn-pink); }

@keyframes mq-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* Progress bar */

/* Quote area */
.mq__quote-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2.5rem 2rem;
}

.mq__quote {
  font-size: 1.15rem;
  line-height: 1.7;
  color: var(--term-fg);
  text-align: center;
  max-width: 540px;
  word-wrap: break-word;
  overflow-wrap: break-word;
  /* white-space: pre-wrap dropped; markdown render now owns whitespace */
  min-height: 1.7em;
}
/* ── Markdown-rendered quote: tight, centered ─────────────────── */
.mq__quote p              { margin: 0 0 0.4rem; }
.mq__quote p:last-child   { margin-bottom: 0; }
.mq__quote ol,
.mq__quote ul             { margin: 0.3rem auto; padding-left: 0; list-style-position: inside; display: inline-block; text-align: left; }
.mq__quote li             { margin: 0.05rem 0; }
.mq__quote li > p         { margin: 0; }
.mq__quote h1,
.mq__quote h2,
.mq__quote h3             { margin: 0.4rem 0 0.25rem; font-family: var(--font-mono); color: var(--syn-cyan); }
.mq__quote strong         { font-weight: 700; }
.mq__quote em             { font-style: italic; }
.mq__quote code           { font-family: var(--font-mono); background: rgba(255,255,255,0.06); padding: 0.05em 0.3em; border-radius: 3px; }

.mq__quote--typing::after {
  content: '';
  display: inline-block;
  width: 2px;
  height: 1.15em;
  background: var(--syn-cyan);
  margin-left: 2px;
  vertical-align: text-bottom;
  animation: mq-blink 0.6s step-end infinite;
}

@keyframes mq-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* Buttons */
.mq__actions {
  display: flex;
  justify-content: center;
  gap: 0.75rem;
  padding: 1rem 0.75rem 1.5rem;
  flex-shrink: 0;
}

.mq__btn {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  padding: 0.5rem 1.2rem;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.mq__btn--primary {
  background: var(--syn-cyan);
  color: #000;
  border: none;
}
.mq__btn--primary:hover:not(:disabled) {
  background: #67e8f9;
  box-shadow: 0 0 12px rgba(34, 211, 238, 0.3);
}
.mq__btn--primary:disabled {
  opacity: 0.3;
  cursor: not-allowed;
}

.mq__btn--secondary {
  background: none;
  border: 1px solid var(--term-border);
  color: var(--term-muted);
}
.mq__btn--secondary:hover {
  border-color: var(--syn-cyan);
  color: var(--syn-cyan);
}

/* Responsive */
@media (max-width: 480px) {
  .mq__quote-area {
    padding: 1.5rem 1rem;
  }
  .mq__quote {
    font-size: 1rem;
  }
}
</style>
