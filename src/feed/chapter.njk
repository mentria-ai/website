---
layout: deck-layout.njk
pagination:
  data: chaptersLocalized
  size: 1
  alias: pair
permalink: "{{ pair.locale.pathPrefix }}/feed/chapter/{{ pair.chapter.id }}/"
eleventyExcludeFromSitemap: true
eleventyComputed:
  lang: "{{ pair.locale.code }}"
  title: "{{ pair.chapter.title }} · Chapter {{ pair.chapter.order }}"
  description: "{{ pair.chapter.subtitle }}"
---
<link rel="stylesheet" href="/assets/css/feed-deck.css?v={{ buildHash }}">

<div class="deck"
     id="deckRoot"
     style="view-transition-name: deck-{{ pair.chapter.id }}"
     data-chapter-id="{{ pair.chapter.id }}"
     data-chapter-title="{{ pair.chapter.title }}"
     data-slide-count="{{ pair.chapter.slides.length }}">
  <h1 class="sr-only">{{ pair.chapter.subtitle | tloc(pair.locale.code) }}</h1>

  <div class="deck__progress" role="progressbar" aria-label="{{ 'feed_deck.progress_label' | t }}" aria-valuemin="1" aria-valuemax="{{ pair.chapter.slides.length }}" aria-valuenow="1" data-announce="{{ 'feed_deck.slide_of' | t }}">
    {% for slide in pair.chapter.slides %}
    <div class="deck__progress-seg{% if loop.first %} is-active{% endif %}" data-idx="{{ loop.index0 }}">
      <span class="deck__progress-fill"></span>
    </div>
    {% endfor %}
  </div>

  <button class="deck__close" id="deckClose" aria-label="{{ 'feed_deck.exit' | t }}">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>

  <button class="deck__share" id="deckShare" aria-label="{{ 'feed_deck.share_slide' | t }}" data-share-title="{{ pair.chapter.subtitle | tloc(pair.locale.code) }}">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.6" y1="10.7" x2="15.4" y2="6.3"/><line x1="8.6" y1="13.3" x2="15.4" y2="17.7"/></svg>
  </button>

  <div class="deck__chapter-meta">
    <span class="deck__chapter-num">CH·{% if pair.chapter.order < 10 %}0{% endif %}{{ pair.chapter.order }}</span>
    <span class="deck__chapter-title">{{ pair.chapter.title }}</span>
  </div>

  <button class="deck__tap deck__tap--prev" aria-label="{{ 'feed_deck.prev_slide' | t }}"></button>
  <button class="deck__tap deck__tap--next" aria-label="{{ 'feed_deck.next_slide' | t }}"></button>

  {% for slide in pair.chapter.slides %}
  <article class="deck__slide{% if loop.first %} is-active{% endif %}"
           data-idx="{{ loop.index0 }}"
           data-slide-id="{{ slide.id }}"
           data-story-type="{{ slide.story_type }}"
           {% if slide.image and slide.image_status != "pending" %}style="--slide-bg: url('{{ slide.image }}')"{% endif %}>
    {% if slide.image_status == "pending" %}
    <div class="deck__slide-img deck__slide-img--placeholder">
      <span class="deck__placeholder-tag">{{ slide.story_type }}</span>
    </div>
    {% else %}
    <img class="deck__slide-img" src="{{ slide.image }}" alt="{{ slide.caption | tloc(pair.locale.code) }}" loading="lazy">
    {% endif %}

    <div class="deck__slide-overlay">
      <p class="deck__caption">{{ slide.caption | tloc(pair.locale.code) }}</p>

      {% if slide.long_press %}
      <div class="deck__body">{{ slide.long_press | tloc(pair.locale.code) | safe }}</div>
      {% endif %}

      {% if slide.actions.length %}
      <div class="deck__actions">
        {% for action in slide.actions %}
          {% if action.type == "open_url" %}
          <a class="deck__action deck__action--link" href="{{ action.url }}" target="_blank" rel="noopener">
            {{ action.label }} →
          </a>
          {% elif action.type == "goto_chapter" %}
          {%- if action.to | chapterExists %}
          <a class="deck__action deck__action--next" href="/feed/chapter/{{ action.to }}/">
            {{ action.label }}
          </a>
          {%- else %}
          <span class="deck__action deck__action--soon">{{ "feed_deck.coming_soon" | t }}</span>
          {%- endif %}
          {% elif action.type == "goto_slide" %}
          <button class="deck__action" data-action="goto_slide" data-target="{{ action.to }}">
            {{ action.label }}
          </button>
          {% elif action.type == "share" %}
          <button class="deck__action deck__action--share" data-action="share">
            {{ action.label }}
          </button>
          {% endif %}
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </article>
  {% endfor %}

  <div class="deck__hint" id="deckHint">
    <span>{{ "feed_deck.hint_tap" | t }}</span><span>{{ "feed_deck.hint_depth" | t }}</span><span>{{ "feed_deck.hint_exit" | t }}</span>
  </div>
  <div class="sr-only" id="deckLive" role="status" aria-live="polite"></div>

{% if devMode %}{% include "dev-feedback.njk" %}{% endif %}
</div>

<script src="/assets/js/feed-deck.js?v={{ buildHash }}" defer></script>
