    hideBoxes();
    if (!r || r.empty) {
      setState('empty', COPY.state_empty);
      announce('', '');
      return;
    }
    if (r.tooLarge) {
      setState('invalid', COPY.too_large_input);
      announce(COPY.too_large_input, 'big');
      return;
    }
    if (r.error) {
      const x = Core.excerpt(lastText, r.error.offset);
      const where = fill(COPY.line_col, { line: fmtInt(x.line), col: fmtInt(x.col) });
      const message = errorMessage(r.error);
      setState('invalid', COPY.state_invalid + ' · ' + where);
      errorMsg.textContent = message;
      renderExcerpt(x);
      errorOffset = r.error.offset;
      errorBox.hidden = false;
      input.setAttribute('aria-invalid', 'true');
      announce(fill(COPY.invalid_announce, { where: where, message: message }), 'e|' + r.error.code + '|' + x.line);
      return;
    }
    const d = r.doc;
    const t = d.type[0];
    const parts = [COPY.state_valid, typeLabel(t)];
    if (t === T.OBJ || t === T.ARR) parts.push(countLabel(t, d.size[0]));
    parts.push(fmtSize(Core.utf8Length(lastText)));
    setState('valid', parts.join(' · '));
    paintLossy(d);
    announce(COPY.state_valid, 'valid');
  }

  function showPaused(text) {
    hideBoxes();
    setState('paused', COPY.state_paused);
    pausedMsg.textContent = fill(COPY.paused_msg, { size: fmtSize(Core.utf8Length(text)) });
    pausedBox.hidden = false;
    valid = false;
    refreshOutput();
  }

  function analyze(text) {
    let result;
    try {
      result = Core.scan(text);
    } catch (_) {
      result = { tooLarge: true };
    }
    lastText = text;
    lastResult = result;
    if (result.empty) {
      doc = null;
      valid = false;
      version++;
      fileBase = '';
      expanded.clear();
      selectedPath = '$';
    } else if (result.doc) {
      if (freshSource) {
        freshSource = false;
        expanded.clear();
        selectedPath = '$';
      }
      doc = result.doc;
      valid = true;
      version++;
    } else {
      valid = false;
    }
    paintValidation();
    refreshOutput();
  }

  function nextPaint() {
    return new Promise(function (resolve) {
      if (typeof requestAnimationFrame === 'function') requestAnimationFrame(function () { setTimeout(resolve, 0); });
      else setTimeout(resolve, 0);
    });
  }

  function confirmBig(bytes) {
    const message = fill(COPY.big_confirm, { size: fmtSize(bytes) });
    if (typeof window.mentriaConfirm !== 'function') return Promise.resolve(true);
    return Promise.resolve(window.mentriaConfirm(message)).then(function (ok) { return !!ok; }, function () { return false; });
  }

  async function run() {
    runTimer = 0;
    const text = input.value;
    if (overBig(text)) {
      if (!bigApproved) {
        if (bigDeclined) {
          showPaused(text);
          return;
        }
        if (asking) return;
        asking = true;
        let ok = false;
        try {
          ok = await confirmBig(Core.utf8Length(text));
        } finally {
          asking = false;
        }
        if (!ok) {
          bigDeclined = true;
          showPaused(input.value);
          return;
        }
        bigApproved = true;
        return run();
      }
    } else {
      bigApproved = false;
      bigDeclined = false;
    }
    if (text.length > BUSY_AT) {
      hideBoxes();
      setState('busy', COPY.state_busy);
      await nextPaint();
      if (input.value !== text) return;
    }
    analyze(text);
  }

  function schedule() {
    clearTimeout(runTimer);
    const n = input.value.length;
    runTimer = setTimeout(run, n < 50000 ? 150 : n < 2000000 ? 400 : 900);
  }

  function runNow() {
    clearTimeout(runTimer);
    return run();
  }

  function outputKey() {
    return version + '|' + state.style + '|' + state.indent + '|' + (state.sort ? 1 : 0);
  }

  function outputOptions(html) {
    return { minify: state.style === 'minify', indent: INDENTS[state.indent], sort: state.sort, html: !!html, limit: OUTPUT_LIMIT };
  }

  function currentOutput() {
    const key = outputKey();
    if (key !== outKey) {
      outKey = key;
      outText = null;
      outBytes = 0;
      try {
        outText = Core.render(doc, outputOptions(false));
      } catch (_) {
        outText = null;
      }
      if (outText !== null) outBytes = Core.utf8Length(outText);
    }
    return outText;
  }

  function cutPoint(s, max) {
    const nl = s.lastIndexOf('\n', max);
    let cut = nl > max * 0.9 ? nl : max;
    if ((s.charCodeAt(cut - 1) & 0xFC00) === 0xD800) cut--;
    return cut;
  }

  function renderText() {
    const out = currentOutput();
    if (textKey === outKey) return;
    textKey = outKey;
    truncEl.hidden = true;
    if (out === null) {
      codeEl.textContent = '';
      truncEl.textContent = COPY.too_large_output;
      truncEl.hidden = false;
      return;
    }
    if (out.length <= HIGHLIGHT_MAX) {
      codeEl.innerHTML = Core.render(doc, outputOptions(true));
    } else if (out.length <= DISPLAY_MAX) {
      codeEl.textContent = out;
    } else {
      const cut = cutPoint(out, DISPLAY_MAX);
      codeEl.textContent = out.slice(0, cut);
      truncEl.textContent = fill(COPY.trunc_note, { shown: fmtSize(Core.utf8Length(out.slice(0, cut))), total: fmtSize(outBytes) });
      truncEl.hidden = false;
    }
  }

  function renderMeta() {
    if (!valid) {
      metaEl.textContent = COPY.meta_stale;
      return;
    }
    const out = currentOutput();
    if (out === null) {
      metaEl.textContent = COPY.too_large_output;
      return;
    }
    const parts = [fill(state.style === 'minify' ? COPY.meta_minify : COPY.meta_format, { size: fmtSize(outBytes) })];
    if (state.sort) parts.push(COPY.meta_sorted);
    metaEl.textContent = parts.join(' · ');
  }

  function refreshOutput() {
    const has = !!doc;
    outPane.classList.toggle('is-stale', has && !valid);
    emptyEl.hidden = has;
    textView.hidden = !has || state.view !== 'text';
    treeView.hidden = !has || state.view !== 'tree';
    if (!has) {
      codeEl.textContent = '';
      truncEl.hidden = true;
      metaEl.textContent = '';
      outKey = '';
      outText = null;
      textKey = '';
      clearTree();
      copyBtn.disabled = true;
      downloadBtn.disabled = true;
      return;
    }
    if (state.view === 'text') renderText();
    else renderTree(false);
    renderMeta();
    const usable = valid && currentOutput() !== null;
    copyBtn.disabled = !usable;
    downloadBtn.disabled = !usable;
  }

  function clearTree() {
    treeEl.textContent = '';
    treeKey = '';
    treeDoc = null;
    rootRow = null;
    activeRow = null;
    selectedRow = null;
    pathEl.textContent = '$';
  }

  function isContainerRow(btn) {
    return btn.hasAttribute('aria-expanded');
  }

  function makeRow(tok, seg, path, depth) {
    const d = treeDoc;
    const t = d.type[tok];
    const box = t === T.OBJ || t === T.ARR;
    const container = box && d.size[tok] > 0;
    const li = el('li', 'jf-li');
    const btn = el('button', 'jf-row');
    btn.type = 'button';
    btn.tabIndex = -1;
    const twisty = el('span', container ? 'jf-tw' : 'jf-tw jf-tw--leaf');
    twisty.setAttribute('aria-hidden', 'true');
    btn.appendChild(twisty);
    if (container) btn.setAttribute('aria-expanded', 'false');
    if (seg === null) btn.appendChild(el('span', 'jf-root', '$'));
    else if (typeof seg === 'number') btn.appendChild(el('span', 'jf-idx', String(seg)));
    else btn.appendChild(el('span', 'jf-key', keyLabel(seg)));
    const colon = el('span', 'jf-punct', ':');
    colon.setAttribute('aria-hidden', 'true');
    btn.appendChild(colon);
    if (box) {
      const brace = el('span', 'jf-punct', t === T.OBJ ? (container ? '{…}' : '{}') : (container ? '[…]' : '[]'));
      brace.setAttribute('aria-hidden', 'true');
      btn.appendChild(brace);
      btn.appendChild(el('span', 'jf-sr', typeLabel(t)));
      btn.appendChild(el('span', 'jf-count', countLabel(t, d.size[tok])));
    } else {
      btn.appendChild(el('span', VALUE_CLASS[t], clip(d.text, d.start[tok], d.end[tok], VALUE_SHOW)));
      if (t === T.NUM_LOSSY) btn.appendChild(el('span', 'jf-flag', COPY.lossy_badge));
    }
    li.appendChild(btn);
    rows.set(btn, { tok: tok, path: path, depth: depth, li: li, ul: null, kids: null, shown: 0, more: null });
    return li;
  }

  function moreLabel(info) {
    const left = info.kids.length - info.shown;
    return fill(COPY.show_more, { n: fmtInt(Math.min(PAGE, left)), left: fmtInt(left) });
  }

  function renderPage(btn, info, budget) {
    const d = treeDoc;
    const obj = d.type[info.tok] === T.OBJ;
    const from = info.shown;
    const to = Math.min(info.kids.length, from + PAGE);
    const frag = document.createDocumentFragment();
    const again = [];
    for (let k = from; k < to; k++) {
      const c = info.kids[k];
      const seg = obj ? Core.decodeString(d.text.slice(d.start[c], d.end[c])) : k;
      const v = obj ? c + 1 : c;
      const path = Core.appendPath(info.path, seg);
      const li = makeRow(v, seg, path, info.depth + 1);
      frag.appendChild(li);
      if ((d.type[v] === T.OBJ || d.type[v] === T.ARR) && expanded.has(path)) again.push(li.firstElementChild);
    }
    info.shown = to;
    if (info.more) {
      info.more.remove();
      info.more = null;
    }
    info.ul.appendChild(frag);
    if (to < info.kids.length) {
      const li = el('li', 'jf-li jf-li--more');
      const more = el('button', 'jf-more', moreLabel(info));
      more.type = 'button';
      more.tabIndex = -1;
      li.appendChild(more);
      info.ul.appendChild(li);
      info.more = li;
      moreOwner.set(more, btn);
    }
    budget.left -= to - from;
    for (let q = 0; q < again.length && budget.left > 0; q++) expand(again[q], budget);
  }

  function expand(btn, budget) {
    const info = rows.get(btn);
    if (!info || btn.getAttribute('aria-expanded') !== 'false') return;
    btn.setAttribute('aria-expanded', 'true');
    expanded.add(info.path);
    if (info.ul) {
      info.ul.hidden = false;
      return;
    }
    info.kids = Core.children(treeDoc, info.tok, treeSort);
    info.ul = el('ul', 'jf-ul');
    info.ul.setAttribute('role', 'list');
    info.li.appendChild(info.ul);
    renderPage(btn, info, budget || { left: Infinity });
  }

  function collapse(btn) {
    const info = rows.get(btn);
    if (!info || btn.getAttribute('aria-expanded') !== 'true') return;
    btn.setAttribute('aria-expanded', 'false');
    expanded.delete(info.path);
    if (info.ul) info.ul.hidden = true;
    if (activeRow && activeRow !== btn && info.li.contains(activeRow)) {
      const hadFocus = document.activeElement === activeRow;
      setActive(btn, hadFocus);
      select(btn);
    }
  }

  function setActive(btn, focus) {
    if (activeRow && activeRow !== btn) activeRow.tabIndex = -1;
    activeRow = btn;
    btn.tabIndex = 0;
    if (focus) btn.focus();
  }

  function select(btn) {
    const info = rows.get(btn);
    if (!info) return;
    if (selectedRow && selectedRow !== btn) selectedRow.classList.remove('is-selected');
    selectedRow = btn;
    btn.classList.add('is-selected');
    selectedPath = info.path;
    pathEl.textContent = info.path;
  }

  function childRows(btn) {
    const info = rows.get(btn);
    const list = [];
    if (!info || !info.ul) return list;
    for (let li = info.ul.firstElementChild; li; li = li.nextElementSibling) {
      const b = li.firstElementChild;
      if (b && rows.has(b)) list.push(b);
    }
    return list;
  }

  function visibleKids(btn) {
    const info = rows.get(btn);
    return info && info.ul && btn.getAttribute('aria-expanded') === 'true' ? info.ul : null;
  }

  function rowOf(li) {
    return li ? li.firstElementChild : null;
  }

  function parentRow(btn) {
    const ul = btn.parentElement ? btn.parentElement.parentElement : null;
    if (!ul || ul.classList.contains('jf-ul--root')) return null;
    return rowOf(ul.parentElement);
  }

  function nextRow(btn) {
    const ul = visibleKids(btn);
    if (ul && ul.firstElementChild) return rowOf(ul.firstElementChild);
    let cur = btn;
    while (cur) {
      const li = cur.parentElement;
      if (li && li.nextElementSibling) return rowOf(li.nextElementSibling);
      cur = parentRow(cur);
    }
    return null;
  }

  function lastVisible(btn) {
    let b = btn;
    for (;;) {
      const ul = visibleKids(b);
      if (!ul || !ul.lastElementChild) return b;
      b = rowOf(ul.lastElementChild);
    }
  }

  function prevRow(btn) {
    const li = btn.parentElement;
    if (li && li.previousElementSibling) return lastVisible(rowOf(li.previousElementSibling));
    return parentRow(btn);
  }

  function findRow(path) {
    const all = treeEl.querySelectorAll('.jf-row');
    for (let i = 0; i < all.length; i++) {
      const info = rows.get(all[i]);
      if (info && info.path === path) return all[i];
    }
    return null;
  }

  function autoExpand(budget) {
    const queue = childRows(rootRow);
    for (let q = 0; q < queue.length && budget.left > 0; q++) {
      const b = queue[q];
      if (!isContainerRow(b) || rows.get(b).depth > AUTO_DEPTH) continue;
      if (b.getAttribute('aria-expanded') === 'false') expand(b, budget);
      const kids = childRows(b);
      for (let k = 0; k < kids.length; k++) queue.push(kids[k]);
    }
  }

  function renderTree(force) {
    const key = version + '|' + (state.sort ? 1 : 0);
    if (!force && key === treeKey && rootRow) return;
    treeKey = key;
    const hadFocus = treeEl.contains(document.activeElement);
    const scrollTop = treeEl.scrollTop;
    const fresh = expanded.size === 0;
    treeEl.textContent = '';
    treeDoc = doc;
    treeSort = state.sort;
    activeRow = null;
    selectedRow = null;
    const ul = el('ul', 'jf-ul jf-ul--root');
    ul.setAttribute('role', 'list');
    const li = makeRow(0, null, '$', 0);
    ul.appendChild(li);
    treeEl.appendChild(ul);
    rootRow = li.firstElementChild;
    if (isContainerRow(rootRow)) {
      const budget = { left: fresh ? AUTO_BUDGET : EXPAND_ALL_BUDGET };
      expand(rootRow, budget);
      if (fresh) autoExpand(budget);
    }
    const target = findRow(selectedPath) || rootRow;
    setActive(target, hadFocus);
    select(target);
    treeEl.scrollTop = scrollTop;
  }

  function showMore(moreBtn) {
    const owner = moreOwner.get(moreBtn);
    const info = owner ? rows.get(owner) : null;
    if (!info) return;
    const hadFocus = document.activeElement === moreBtn;
    const first = info.shown;
    renderPage(owner, info, { left: Infinity });
    const target = childRows(owner)[first];
    if (target) {
      setActive(target, hadFocus);
      select(target);
    }
  }

  function expandAll() {
    if (!rootRow) return;
    const budget = { left: EXPAND_ALL_BUDGET };
    const queue = [rootRow];
    let capped = false;
    for (let q = 0; q < queue.length; q++) {
      const b = queue[q];
      if (!isContainerRow(b)) continue;
      const info = rows.get(b);
      if (b.getAttribute('aria-expanded') === 'false') {
        if (budget.left <= 0 || info.depth >= EXPAND_ALL_DEPTH) {
          capped = true;
          continue;
        }
        expand(b, budget);
      }
      if (info.more) capped = true;
      const kids = childRows(b);
      for (let k = 0; k < kids.length; k++) queue.push(kids[k]);
    }
    if (capped) flash(fill(COPY.expand_capped, { n: fmtInt(treeEl.querySelectorAll('.jf-row').length) }));
  }

  function collapseAll() {
    if (!doc) return;
    expanded.clear();
    expanded.add('$');
    selectedPath = '$';
    renderTree(true);
    treeEl.scrollTop = 0;
  }

  function onTreeKey(e) {
    const b = e.target;
    if (!b || b.tagName !== 'BUTTON' || !treeEl.contains(b)) return;
    const exp = b.getAttribute('aria-expanded');
    let next = null;
    switch (e.key) {
      case 'ArrowDown':
        next = nextRow(b);
        break;
      case 'ArrowUp':
        next = prevRow(b);
        break;
      case 'ArrowRight':
        if (exp === 'false') {
          e.preventDefault();
          expand(b, { left: Infinity });
          return;
        }
        if (exp === 'true') {
          const ul = visibleKids(b);
          next = ul && ul.firstElementChild ? rowOf(ul.firstElementChild) : null;
        }
        break;
      case 'ArrowLeft':
        if (exp === 'true') {
          e.preventDefault();
          collapse(b);
          return;
        }
        next = parentRow(b);
        break;
      case 'Home':
        next = rootRow;
        break;
      case 'End':
        next = rootRow ? lastVisible(rootRow) : null;
        break;
      default:
        return;
    }
    e.preventDefault();
    if (next) {
      setActive(next, true);
      select(next);
    }
  }

  function selectInInput(offset, length) {
    const text = input.value;
    const from = Math.min(offset, text.length);
    input.focus();
    try {
      input.setSelectionRange(from, Math.min(text.length, from + length));
    } catch (_) {}
    const lc = Core.lineCol(text, from);
    const cs = window.getComputedStyle(input);
    const lineHeight = parseFloat(cs.lineHeight) || 20;
    const charWidth = (parseFloat(cs.fontSize) || 13) * 0.6;
    input.scrollTop = Math.max(0, (lc.line - 1) * lineHeight - input.clientHeight / 3);
    input.scrollLeft = Math.max(0, (lc.col - 1) * charWidth - input.clientWidth / 2);
  }

  function readText(file) {
    if (typeof file.text === 'function') return file.text();
    return new Promise(function (resolve, reject) {
      const reader = new FileReader();
      reader.onload = function () { resolve(String(reader.result)); };
      reader.onerror = function () { reject(reader.error); };
      reader.readAsText(file);
    });
  }

  async function openFile(file) {
    if (!file || asking) return;
    if (file.size > MAX_FILE) {
      flash(fill(COPY.file_too_large, { name: file.name, size: fmtSize(file.size), limit: fmtSize(MAX_FILE) }), 'err');
      return;
    }
    if (file.size > BIG_INPUT) {
      asking = true;
      let ok = false;
      try {
        ok = await confirmBig(file.size);
      } finally {
        asking = false;
      }
      if (!ok) return;
    }
    let text;
    try {
      text = await readText(file);
    } catch (_) {
      flash(fill(COPY.file_read_failed, { name: file.name }), 'err');
      return;
    }
    bigApproved = overBig(text);
    bigDeclined = false;
    input.value = text;
    expanded.clear();
    selectedPath = '$';
    await runNow();
    fileBase = baseName(file.name);
    flash(fill(COPY.file_opened, { name: file.name, size: fmtSize(file.size) }), 'ok');
  }

  function hasFiles(e) {
    const types = e.dataTransfer ? e.dataTransfer.types : null;
    if (!types) return false;
    for (let i = 0; i < types.length; i++) {
      if (types[i] === 'Files') return true;
    }
    return false;
  }

  function bindCopy(btn, getText, describe) {
    const alt = btn.querySelector('.jf__lbl-alt');
    let timer = 0;
    btn.addEventListener('click', function () {
      const text = getText();
      if (text == null || text === '') return;
      const settle = function (ok) {
        alt.textContent = ok ? COPY.copied : COPY.copy_failed;
        btn.classList.add('is-alt');
        btn.classList.toggle('is-copied', ok);
        btn.classList.toggle('is-failed', !ok);
        clearTimeout(timer);
        timer = setTimeout(function () { btn.classList.remove('is-alt', 'is-copied', 'is-failed'); }, 1400);
        flash(ok ? describe(text) : COPY.copy_failed, ok ? 'ok' : 'err');
      };
      let pending;
      try {
        pending = navigator.clipboard && navigator.clipboard.writeText ? navigator.clipboard.writeText(text) : Promise.reject(new Error('clipboard'));
      } catch (err) {
        pending = Promise.reject(err);
      }
      pending.then(function () { settle(true); }, function () { settle(false); });
    });
  }

  const styleSeg = MentriaUI.segmented($('jf-style'), function (value) {
    state.style = value === 'minify' ? 'minify' : 'format';
    syncIndent();
    refreshOutput();
  });
  const indentSeg = MentriaUI.segmented(indentSegEl, function (value) {
    if (!Object.prototype.hasOwnProperty.call(INDENTS, value)) return;
    state.indent = value;
    saveSettings();
    refreshOutput();
  });
  const viewSeg = MentriaUI.segmented($('jf-view'), function (value) {
    state.view = value === 'tree' ? 'tree' : 'text';
    saveSettings();
    refreshOutput();
  });

  function syncIndent() {
    const off = state.style === 'minify';
    indentGroup.classList.toggle('is-off', off);
    const buttons = indentSegEl.querySelectorAll('button');
    for (let i = 0; i < buttons.length; i++) buttons[i].disabled = off;
  }

  sortBtn.addEventListener('click', function () {
    state.sort = !state.sort;
    sortBtn.setAttribute('aria-pressed', state.sort ? 'true' : 'false');
    refreshOutput();
  });

  input.addEventListener('input', schedule);

  input.addEventListener('paste', function () {
    if (input.selectionStart === 0 && input.selectionEnd === input.value.length) freshSource = true;
  });

  openBtn.addEventListener('click', function () {
    fileInput.click();
  });

  fileInput.addEventListener('change', function () {
    const file = fileInput.files && fileInput.files[0];
    fileInput.value = '';
    if (file) openFile(file);
  });

  let dragDepth = 0;
  dropEl.addEventListener('dragenter', function (e) {
    if (!hasFiles(e)) return;
    e.preventDefault();
    dragDepth++;
    dropEl.classList.add('is-drag');
  });
  dropEl.addEventListener('dragover', function (e) {
    if (!hasFiles(e)) return;
    e.preventDefault();
    if (e.dataTransfer) e.dataTransfer.dropEffect = 'copy';
    dropEl.classList.add('is-drag');
  });
  dropEl.addEventListener('dragleave', function (e) {
    if (!hasFiles(e)) return;
    dragDepth = Math.max(0, dragDepth - 1);
    if (!dragDepth) dropEl.classList.remove('is-drag');
  });
  dropEl.addEventListener('drop', function (e) {
    dragDepth = 0;
    dropEl.classList.remove('is-drag');
    if (!hasFiles(e)) return;
    e.preventDefault();
    const file = e.dataTransfer.files && e.dataTransfer.files[0];
    if (file) openFile(file);
  });

  clearBtn.addEventListener('click', function () {
    clearTimeout(runTimer);
    input.value = '';
    bigApproved = false;
    bigDeclined = false;
    analyze('');
    flash(COPY.cleared);
    input.focus();
  });

  processBtn.addEventListener('click', function () {
    bigApproved = true;
    bigDeclined = false;
    runNow();
  });

  jumpBtn.addEventListener('click', function () {
    selectInInput(errorOffset, errorOffset < input.value.length ? 1 : 0);
  });

  warnJump.addEventListener('click', function () {
    if (lossyAt) selectInInput(lossyAt.offset, lossyAt.length);
  });

  bindCopy(copyBtn, function () {
    if (!valid || !doc) return null;
    const out = currentOutput();
    if (out === null) flash(COPY.too_large_output, 'err');
    return out;
  }, function () {
    return COPY.copied_output;
  });

  bindCopy(copyPathBtn, function () {
    return rootRow ? selectedPath : null;
  }, function (path) {
    return fill(COPY.copied_path, { path: path });
  });

  downloadBtn.addEventListener('click', function () {
    if (!valid || !doc) return;
    const out = currentOutput();
    if (out === null) {
      flash(COPY.too_large_output, 'err');
      return;
    }
    const minify = state.style === 'minify';
    const name = (fileBase || COPY.download_base || 'data') + (minify ? '.min' : '') + '.json';
    MentriaUI.downloadFile(name, new Blob([minify ? out : out + '\n'], { type: 'application/json' }));
    flash(fill(COPY.downloaded, { name: name }), 'ok');
  });

  expandBtn.addEventListener('click', expandAll);
  collapseBtn.addEventListener('click', collapseAll);

  treeEl.addEventListener('click', function (e) {
    const target = e.target && e.target.closest ? e.target.closest('button') : null;
    if (!target || !treeEl.contains(target)) return;
    if (target.classList.contains('jf-more')) {
      showMore(target);
      return;
    }
    if (!rows.has(target)) return;
    const exp = target.getAttribute('aria-expanded');
    if (exp === 'false') expand(target, { left: Infinity });
    else if (exp === 'true') collapse(target);
    setActive(target, false);
    select(target);
  });

  treeEl.addEventListener('focusin', function (e) {
    const b = e.target;
    if (!b || b.tagName !== 'BUTTON') return;
    setActive(b, false);
    select(b);
  });

  treeEl.addEventListener('keydown', onTreeKey);

  document.addEventListener('mentria:localechange', function () {
    const I18n = window.MentriaI18n;
    if (I18n && typeof I18n.t === 'function') {
      Object.keys(COPY).forEach(function (k) {
        const v = I18n.t('tool.json-formatter.' + k);
        if (typeof v === 'string' && v) COPY[k] = v;
      });
    }
    Object.keys(intl).forEach(function (k) { delete intl[k]; });
    liveKey = '';
    if (!pausedBox.hidden) showPaused(input.value);
    else paintValidation();
    textKey = '';
    treeKey = '';
    refreshOutput();
  });

  loadSettings();
  styleSeg.set(state.style);
  indentSeg.set(state.indent);
  viewSeg.set(state.view);
  syncIndent();
  paintValidation();
  refreshOutput();
  if (input.value) runNow();
})();
</script>

