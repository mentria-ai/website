---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/tools/ai-chat/index.html"
eleventyComputed:
  lang: "{{ locale.code }}"
  title: "{{ 'tools.ai-chat.title' | t }}"
  description: "{{ 'tools.ai-chat.lede' | t }}"
---
<section class="hero" style="padding-top:1rem;">
  <p class="eyebrow eyebrow--crumbs"><a class="eyebrow__link" href="{{ locale.pathPrefix }}/" aria-label="{{ 'nav.home' | t }}">~</a><span class="eyebrow__sep">/</span><a class="eyebrow__link" href="{{ locale.pathPrefix }}/tools/">tools</a><span class="eyebrow__sep">/</span><span class="eyebrow__current">ai-chat</span></p>
  <h1>{{ "tools.ai-chat.title" | t }}</h1>
  <p>{{ "tools.ai-chat.lede" | t }}</p>
  {% include "tldr.njk" %}
</section>

{% set terminalTitle = "ai-chat.js" %}
{% include "terminal-frame-open.njk" %}
<section class="ac">
  <div class="ac__status" id="ac-status">
    <span class="ac__status-dot" id="ac-status-dot"></span>
    <span class="ac__status-text" id="ac-status-text" role="status" aria-live="polite">{{ "tool.ai-chat.status_checking_webgpu" | t }}</span>
    <span class="ac__counter" id="ac-counter" hidden></span>
    <select class="ac__tier" id="ac-tier" aria-label="{{ 'tool.ai-chat.tier_label' | t }}" hidden></select>
    <button type="button" class="ac__adapter-chip" id="ac-adapter-chip" hidden></button>
    <button class="ac__delete-btn" id="ac-clear-chat" title="{{ 'tool.ai-chat.btn_new_chat' | t }}" style="display:none;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      <span>{{ "tool.ai-chat.btn_new_chat" | t }}</span>
    </button>
    <button class="ac__delete-btn" id="ac-delete-model" title="{{ 'tool.ai-chat.btn_delete_model_title' | t }}" style="display:none;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
      <span>{{ "tool.ai-chat.btn_delete_model" | t }}</span>
    </button>
  </div>

  <div class="ac__activity" id="ac-activity"></div>

  <div class="ac__search-cfg" id="ac-search-cfg" hidden>
    <div class="ac__search-cfg-title">{{ "tool.ai-chat.search_panel_title" | t }}</div>
    <label class="ac__search-cfg-field">
      <span>{{ "tool.ai-chat.search_url_label" | t }}</span>
      <input type="url" id="ac-search-url" placeholder="http://localhost:8888" spellcheck="false" autocomplete="off">
    </label>
    <div class="ac__search-cfg-row">
      <button type="button" class="ac__search-cfg-btn" id="ac-search-test">{{ "tool.ai-chat.search_test" | t }}</button>
      <button type="button" class="ac__search-cfg-btn ac__search-cfg-btn--primary" id="ac-search-save">{{ "tool.ai-chat.search_save" | t }}</button>
      <button type="button" class="ac__search-cfg-btn ac__search-cfg-btn--ghost" id="ac-search-remove" hidden>{{ "tool.ai-chat.search_remove" | t }}</button>
    </div>
    <div class="ac__search-cfg-status" id="ac-search-status" aria-live="polite"></div>
  </div>

  <div class="ac__adapters" id="ac-adapters" hidden>
    <div class="ac__adapters-head">
      <span class="ac__adapters-title">{{ "tool.ai-chat.adapters_title" | t }}</span>
      <button type="button" class="ac__adapters-close" id="ac-adapters-close" aria-label="{{ 'tool.ai-chat.adapters_close' | t }}">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="ac__adapters-list" id="ac-adapters-list"></div>
    <div class="ac__adapters-note" id="ac-adapters-note" aria-live="polite"></div>
  </div>

  <div class="ac__messages" id="ac-messages">
    <div class="ac__empty" id="ac-empty">
      <div class="ac__empty-icon">&#9670;</div>
      <p>{{ "tool.ai-chat.empty_msg" | t }}</p>
      <p class="ac__empty-sub">{{ "tool.ai-chat.empty_sub" | t }}</p>
    </div>
  </div>

  <div class="ac__img-preview" id="ac-img-preview" style="display:none;">
    <img id="ac-img-thumb" alt="{{ 'tool.ai-chat.img_alt_attached' | t }}" />
    <button class="ac__img-remove" id="ac-img-remove" title="{{ 'tool.ai-chat.btn_remove_image' | t }}">{% include "icon-x.njk" %}</button>
  </div>

  <div class="ac__input-wrap">
    <button type="button" class="ac__grip" id="ac-grip" tabindex="-1" aria-hidden="true" hidden><span class="ac__grip-line"></span></button>
    <label class="ac__attach-btn" id="ac-attach-label" title="{{ 'tool.ai-chat.btn_attach_image' | t }}">
      <input type="file" id="ac-file-input" accept="image/*" hidden />
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
    </label>
    <button class="ac__think-btn" id="ac-think-toggle" title="{{ 'tool.ai-chat.think_toggle' | t }}" aria-label="{{ 'tool.ai-chat.think_toggle' | t }}" aria-pressed="false" hidden>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a7 7 0 0 0-4.9 12A6.5 6.5 0 0 1 9 17h6a6.5 6.5 0 0 1 1.9-3A7 7 0 0 0 12 2z"/><line x1="9" y1="21" x2="15" y2="21"/></svg>
    </button>
    <button class="ac__think-btn" id="ac-search-toggle" title="{{ 'tool.ai-chat.search_toggle' | t }}" aria-label="{{ 'tool.ai-chat.search_toggle' | t }}" aria-pressed="false" hidden>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14.5 14.5 0 0 1 0 18M12 3a14.5 14.5 0 0 0 0 18"/></svg>
    </button>
    <textarea class="ac__input" id="ac-input" rows="1" enterkeyhint="send" placeholder="{{ 'tool.ai-chat.input_placeholder' | t }}" disabled></textarea>
    <button class="ac__send-btn" id="ac-send" title="{{ 'tool.ai-chat.btn_send' | t }}" disabled>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
    </button>
  </div>
</section>
{% include "terminal-frame-close.njk" %}

{% include "tool-schema.njk" %}

<script src="/assets/js/markdown.js?v={{ buildHash }}"></script>

<script type="module">
const COPY = {
