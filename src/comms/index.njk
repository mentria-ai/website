<script type="module">
import { joinRoom, selfId, createPersistentEvent, getRelaySockets } from '/assets/vendor/trystero-nostr.js';
import { MentriaBus } from '/assets/js/mentria-bus.js';
import { confirmInstall } from '/assets/js/mentria-ext-install-ui.js';
import * as CID from '/assets/js/mentria-comms-id.js';

const RELAY = 'wss://relay.mentria.ai';
const TURN_CRED_URL = 'https://relay.mentria.ai/turn-cred';

let cachedIce = null;
let iceExpiry = 0;
const REFRESH_LEAD = 60;
const FALLBACK_ICE = [{ urls: 'stun:turn.mentria.ai:3478' }];

const getIce = async () => {
  const nowS = Date.now() / 1000;
  if (cachedIce && nowS < iceExpiry - REFRESH_LEAD) return cachedIce;
  try {
    const r = await fetch(TURN_CRED_URL, { cache: 'no-store' });
    if (!r.ok) throw new Error(`status ${r.status}`);
    const data = await r.json();
    iceExpiry = nowS + (data.ttl || 3600);
    cachedIce = data.iceServers || FALLBACK_ICE;
    return cachedIce;
  } catch (err) {
    console.warn('turn-cred fetch failed, using STUN-only fallback:', err);
    return FALLBACK_ICE;
  }
};

const $ = (id) => document.getElementById(id);
const els = {
  room: $('comms-room'), join: $('comms-join'),
  status: $('comms-status'), peers: $('comms-peers'), mute: $('comms-mute'), eph: $('comms-eph'), enc: $('comms-enc'),
  share: $('comms-share'), url: $('comms-url'), copy: $('comms-copy'), genkey: $('comms-genkey'),
  peerlist: $('comms-peerlist'),
  log: $('comms-log'), drop: $('comms-drop'), file: $('comms-file'),
  send: $('comms-send'), msg: $('comms-msg'), go: $('comms-go'),
  idNone: $('comms-id-none'), idLocked: $('comms-id-locked'), idOn: $('comms-id-on'),
  idPass: $('comms-id-pass'), idUnlock: $('comms-id-unlock'), idErr: $('comms-id-err'), idPasskey: $('comms-id-passkey'),
  idName: $('comms-id-name'), idFp: $('comms-id-fp'), idShare: $('comms-id-share'), idContacts: $('comms-id-contacts'),
  idCard: $('comms-id-card'), idQr: $('comms-id-qr'), idCode: $('comms-id-code'), idCopy: $('comms-id-copy'),
  contacts: $('comms-contacts'), contactIn: $('comms-contact-in'), contactAdd: $('comms-contact-add'), contactList: $('comms-contacts-list'),
  callStart: $('comms-call-start'), callCam: $('comms-call-cam'), callMic: $('comms-call-mic'), callHangup: $('comms-call-hangup'),
  ring: $('comms-ring'), ringText: $('comms-ring-text'), ringAccept: $('comms-ring-accept'), ringDecline: $('comms-ring-decline'),
  media: $('comms-media'),
  app: $('comms-app'), adv: $('comms-adv'), advToggle: $('comms-adv-toggle'), newRoom: $('comms-newroom'),
  onboard: $('comms-onboard'), obPasskey: $('comms-onboard-passkey'), obIntro: $('comms-onboard-intro'), obForm: $('comms-onboard-form'), obDone: $('comms-onboard-done'),
  obStart: $('comms-onboard-start'), obName: $('comms-onboard-name'), obCreate: $('comms-onboard-create'),
  obErr: $('comms-onboard-err'), obHint: $('comms-onboard-hint'), obMethod: $('comms-onboard-method'),
  obCode: $('comms-onboard-code'), obCopy: $('comms-onboard-copy'), obContinue: $('comms-onboard-continue'),
  setupHere: $('comms-id-setup-here'), lockAlt: $('comms-lock-alt')
};

const MAX_FILE = 50 * 1024 * 1024;
const MAX_TOTAL_WARN = 100 * 1024 * 1024;

let room = null;
let chatAction = null;
let metaAction = null;
let chunkAction = null;
let profAction = null;
let callAction = null;
const call = { active: false, local: null, videoOn: false, micOff: false, ringTimer: null, ringDeadline: 0 };
const callTiles = new Map();
const pendingStreams = new Map();
let myId = null;
let myFp = null;
let ringToken = null;
let currentDmContact = null;
let lastRingSentAt = 0;
let unreadCount = 0;
let myProfile = { name: '' };
const peerProfiles = new Map();
const peers = new Set();
const objectUrls = new Set();
const trackObjectUrl = (blob) => { const u = URL.createObjectURL(blob); objectUrls.add(u); return u; };
const revokeObjectUrls = () => { objectUrls.forEach((u) => { try { URL.revokeObjectURL(u); } catch {} }); objectUrls.clear(); };
let muted = false;
try { muted = localStorage.getItem('comms.muted') === '1'; } catch (_) {}
let audioCtx = null;

const CHAT_TOPIC_PREFIX = 'mentria.chat.v1.';
const CHAT_KIND = 3838;
const EPHEMERAL_PREFIX = '!';
const HISTORY_LOOKBACK_SEC = 7 * 24 * 60 * 60;
const HISTORY_LIMIT = 100;
const HISTORY_FLUSH_TIMEOUT_MS = 4000;

let chatSubId = null;
let chatTopic = null;
let chatPersist = true;
let historyBuffered = false;
let historyBuffer = [];
let historyTimer = null;
let seenCmids = new Set();
const socketListenersAttached = new WeakSet();

const isEphemeralRoom = (name) => typeof name === 'string' && name.startsWith(EPHEMERAL_PREFIX);
const isDmRoom = (name) => typeof name === 'string' && (name.startsWith('!dm-') || name.startsWith('dm-'));
const newCmid = () => selfId + ':' + Math.random().toString(36).slice(2);

let chatKey = null;

const b64encode = (bytes) => btoa(String.fromCharCode(...bytes));
const b64decode = (str) => Uint8Array.from(atob(str), c => c.charCodeAt(0));
const b64urlEncode = (bytes) => b64encode(bytes).replaceAll('+','-').replaceAll('/','_').replaceAll('=','');
const b64urlDecode = (str) => {
  const b64 = str.replaceAll('-','+').replaceAll('_','/');
  const padded = b64 + '='.repeat((4 - b64.length % 4) % 4);
  return b64decode(padded);
};

const parseHash = (hash) => {
  const raw = (hash || '').slice(1).trim();
  if (!raw) return { room: null, b64Key: null };
  const colonIdx = raw.indexOf(':');
  if (colonIdx === -1) return { room: raw, b64Key: null };
  return { room: raw.slice(0, colonIdx), b64Key: raw.slice(colonIdx + 1) || null };
};

const formatHash = (room, b64Key) => '#' + room + (b64Key ? ':' + b64Key : '');

const deriveKey = async (b64Key) => {
  try {
    const raw = b64urlDecode(b64Key);
    if (raw.length !== 32) throw new Error('key must be 32 bytes');
    return await crypto.subtle.importKey('raw', raw, { name: 'AES-GCM' }, false, ['encrypt', 'decrypt']);
  } catch (err) {
    console.warn('key parse failed:', err);
    return null;
  }
};

const encryptText = async (key, plaintext) => {
  const iv = crypto.getRandomValues(new Uint8Array(12));
  const ct = await crypto.subtle.encrypt({ name: 'AES-GCM', iv }, key, new TextEncoder().encode(plaintext));
  return { v: 1, iv: b64encode(iv), ct: b64encode(new Uint8Array(ct)) };
};

const decryptText = async (key, payload) => {
  if (!payload || payload.v !== 1) throw new Error('bad payload');
  const iv = b64decode(payload.iv);
  const ct = b64decode(payload.ct);
  const pt = await crypto.subtle.decrypt({ name: 'AES-GCM', iv }, key, ct);
  return new TextDecoder().decode(pt);
};

const short = (id) => id ? id.slice(0, 6) : 'unknown';

const displayName = (peerId) => {
  const prof = peerProfiles.get(peerId);
  if (prof && prof.fp) {
    const contact = CID.getContacts().find((c) => c.fp === prof.fp);
    if (contact && contact.name) return contact.name;
  }
  if (prof && prof.name) return prof.name;
  return short(peerId);
};

const peerColor = (id) => {
  let h = 0;
  for (let i = 0; i < (id || '').length; i++) h = (h * 31 + id.charCodeAt(i)) >>> 0;
  return `hsl(${h % 360}, 55%, 65%)`;
};

const escapeHtml = (s) => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmtKB = (n) => (n / 1024).toFixed(1) + ' KB';
const fmtMB = (n) => (n / 1024 / 1024).toFixed(1) + ' MB';
const fmtSize = (n) => n >= 1024 * 1024 ? fmtMB(n) : fmtKB(n);
const nowHHMM = () => { const d = new Date(); return String(d.getHours()).padStart(2,'0') + ':' + String(d.getMinutes()).padStart(2,'0'); };

const playPing = (freq = 880) => {
  if (muted) return;
  try {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    const ctx = audioCtx;
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.frequency.value = freq;
    osc.type = 'sine';
    const t = ctx.currentTime;
    gain.gain.setValueAtTime(0.0001, t);
    gain.gain.exponentialRampToValueAtTime(0.12, t + 0.01);
    gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.18);
    osc.connect(gain).connect(ctx.destination);
    osc.start(t);
    osc.stop(t + 0.22);
  } catch {}
};

const renderPeerList = () => {
  if (!peers.size) { els.peerlist.hidden = true; els.peerlist.innerHTML = ''; return; }
  els.peerlist.hidden = false;
  els.peerlist.innerHTML = '';
  peers.forEach(p => {
    const chip = document.createElement('span');
    chip.className = 'comms__chip';
    chip.style.color = peerColor(p);
    chip.textContent = displayName(p);
    const prof = peerProfiles.get(p);
    chip.title = prof && prof.fp ? 'fingerprint ' + prof.fp : p;
    if (prof && prof.pub && prof.fp && !CID.getContacts().some((c) => c.fp === prof.fp)) {
      const add = document.createElement('button');
      add.type = 'button';
      add.className = 'comms__chip-add';
      add.textContent = '+';
      add.title = 'add ' + (prof.name || short(p)) + ' as a contact';
      add.addEventListener('click', async () => {
        await CID.addContact({ name: prof.name, pub: prof.pub, ring: prof.ring });
        sys(`${displayName(p)} added to contacts.`);
        renderPeerList();
        renderContacts();
      });
      chip.append(add);
    }
    els.peerlist.append(chip);
  });
};

const renderLine = (who, what, opts = {}) => {
  const line = document.createElement('div');
  line.className = 'comms__line';
  const w = document.createElement('span');
  w.className = 'comms__who' + (opts.sys ? ' comms__who--sys' : opts.me ? ' comms__who--me' : '');
  w.textContent = who;
  if (opts.peerId) w.style.color = peerColor(opts.peerId);
  if (!opts.sys && !opts.me) {
    const time = document.createElement('span');
    time.className = 'comms__time';
    time.textContent = nowHHMM();
    w.append(time);
  }
  const t = document.createElement('span');
  t.className = 'comms__what' + (opts.sys ? ' comms__what--sys' : '');
  if (opts.html) t.innerHTML = opts.html; else t.textContent = what;
  if (opts.quiet) line.setAttribute('aria-live', 'off');
  line.append(w, t);
  els.log.append(line);
  els.log.scrollTop = els.log.scrollHeight;
  return { line, what: t };
};

const sys = (text) => renderLine('--', text, { sys: true });

const progressHTML = (verb, name, size, transferred) => {
  const pct = size > 0 ? Math.min(100, Math.round((transferred / size) * 100)) : 0;
  return `${verb} <strong>${escapeHtml(name)}</strong>` +
    ` <span class="comms__prog"><span class="comms__prog-fill" style="width:${pct}%"></span></span>` +
    ` <span class="comms__prog-text">${pct}% (${fmtKB(transferred)} / ${fmtKB(size)})</span>`;
};

const completeHTML = (name, size, type, url) => {
  const isImg = type && type.startsWith('image/');
  const preview = isImg ? `<br><a href="${url}" target="_blank" rel="noopener"><img class="comms__thumb" src="${url}" alt="${escapeHtml(name)}"></a>` : '';
  return `<a href="${url}" download="${escapeHtml(name)}">${escapeHtml(name)}</a> (${fmtKB(size)})${preview}`;
};

const updatePeers = () => {
  els.peers.textContent = `peers: ${peers.size}`;
  els.peers.hidden = false;
};

let currentRoomName = null;
let pendingResends = 0;
const setConnUI = () => {
  const offline = !navigator.onLine;
  els.send.classList.toggle('comms__send--offline', offline);
  els.status.classList.toggle('comms__badge--offline', offline);
  if (currentRoomName) {
    els.status.textContent = offline ? 'reconnecting…' : `room: ${currentRoomName}`;
  }
};
window.addEventListener('offline', setConnUI);
window.addEventListener('online', () => {
  setConnUI();
  if (pendingResends > 0) sys(`back online — ${pendingResends} message${pendingResends === 1 ? '' : 's'} awaiting resend.`);
});

const renderPendingLine = (text, payload, cmid) => {
  const line = renderLine('you', text, { me: true, quiet: true });
  line.line.classList.add('comms__line--pending');
  const note = document.createElement('span');
  note.className = 'comms__pending-note';
  note.textContent = 'not delivered — no connection';
  const btn = document.createElement('button');
  btn.type = 'button';
  btn.className = 'comms__resend';
  btn.textContent = 'resend';
  btn.addEventListener('click', () => {
    if (!navigator.onLine) { sys('still offline — try again when the connection returns.'); return; }
    if (!chatAction) { sys('not connected to a room — rejoin to send.'); return; }
    chatAction.send(payload);
    publishChat(text, cmid);
    line.line.classList.remove('comms__line--pending');
    note.remove();
    btn.remove();
    pendingResends = Math.max(0, pendingResends - 1);
  });
  line.what.append(note, btn);
  pendingResends++;
};

const refreshShareUrl = (roomName, b64Key) => {
  if (isDmRoom(roomName)) { els.share.hidden = true; els.url.textContent = ''; return; }
  const u = new URL(window.location.href);
  u.hash = formatHash(roomName, b64Key);
  els.url.textContent = u.toString();
  els.share.hidden = false;
};

const renderRemoteChat = (item, opts = {}) => {
  renderLine(displayName(item.senderId), item.text, { peerId: item.senderId, quiet: !!opts.silent });
  if (!opts.silent) playPing(880);
};

const flushHistory = () => {
  if (!historyBuffered) return;
  historyBuffered = false;
  if (historyTimer) { clearTimeout(historyTimer); historyTimer = null; }
  historyBuffer.sort((a, b) => a.ts - b.ts);
  if (historyBuffer.length) {
    sys(`— recent history (${historyBuffer.length}) —`);
    historyBuffer.forEach(item => renderRemoteChat(item, { silent: true }));
    sys('— live —');
  }
  historyBuffer = [];
};

const handleNostrMsg = async (msgEvent) => {
  let msg;
  try { msg = JSON.parse(msgEvent.data); } catch { return; }
  if (!Array.isArray(msg)) return;
  if (msg[0] === 'EVENT' && msg[1] === chatSubId && msg[2]) {
    const ev = msg[2];
    let content;
    try { content = JSON.parse(ev.content); } catch { return; }
    if (!content || !content.cmid || seenCmids.has(content.cmid)) return;
    let text;
    if (content.enc) {
      if (!chatKey) return;
      try { text = await decryptText(chatKey, content.enc); } catch { return; }
    } else if (typeof content.text === 'string') {
      text = content.text;
    } else {
      return;
    }
    seenCmids.add(content.cmid);
    const senderId = (content.cmid.split(':')[0]) || ev.pubkey;
    const ts = (typeof content.ts === 'number' && content.ts > 0) ? content.ts : ((ev.created_at || 0) * 1000);
    const item = { senderId, text, ts };
    if (historyBuffered) historyBuffer.push(item);
    else renderRemoteChat(item);
  } else if (msg[0] === 'EOSE' && msg[1] === chatSubId) {
    flushHistory();
  }
};

const closeChatSub = () => {
  if (!chatSubId) return;
  const closeMsg = JSON.stringify(['CLOSE', chatSubId]);
  const sockets = getRelaySockets() || {};
  for (const ws of Object.values(sockets)) {
    try { ws.send(closeMsg); } catch {}
  }
};

const setupChatPersistence = async (roomName) => {
  chatTopic = CHAT_TOPIC_PREFIX + roomName;
  chatPersist = !isEphemeralRoom(roomName);
  seenCmids = new Set();

  if (!chatPersist) {
    historyBuffered = false;
    historyBuffer = [];
    chatSubId = null;
    sys('ephemeral room — messages aren\'t saved. drop the leading ! to persist.');
    return;
  }

  chatSubId = 'mc-' + Math.random().toString(36).slice(2);
  historyBuffered = true;
  historyBuffer = [];

  const deadline = Date.now() + 8000;
  let openSockets = [];
  while (Date.now() < deadline) {
    const socketsMap = getRelaySockets() || {};
    openSockets = Object.values(socketsMap).filter(ws => ws && ws.readyState === 1);
    if (openSockets.length > 0) break;
    await new Promise(r => setTimeout(r, 200));
  }
  if (!openSockets.length) {
    sys('relay unreachable — history disabled this session.');
    historyBuffered = false;
    return;
  }

  const sinceSec = Math.floor(Date.now() / 1000) - HISTORY_LOOKBACK_SEC;
  const req = JSON.stringify(['REQ', chatSubId, {
    kinds: [CHAT_KIND],
    '#x': [chatTopic],
    since: sinceSec,
    limit: HISTORY_LIMIT
  }]);

  for (const ws of openSockets) {
    try {
      if (!socketListenersAttached.has(ws)) {
        ws.addEventListener('message', handleNostrMsg);
        socketListenersAttached.add(ws);
      }
      ws.send(req);
    } catch (err) {
      console.warn('chat history setup failed for socket:', err);
    }
  }

  historyTimer = setTimeout(flushHistory, HISTORY_FLUSH_TIMEOUT_MS);
};

const publishChat = async (text, cmid) => {
  if (!chatTopic || !chatPersist) return;
  try {
    let payload;
    if (chatKey) {
      const enc = await encryptText(chatKey, text);
      payload = { cmid, ts: Date.now(), enc };
    } else {
      payload = { text, cmid, ts: Date.now() };
    }
    const eventStr = await createPersistentEvent(CHAT_KIND, chatTopic, JSON.stringify(payload));
    const sockets = getRelaySockets() || {};
    for (const ws of Object.values(sockets)) {
      if (ws && ws.readyState === 1) {
        try { ws.send(eventStr); } catch {}
      }
    }
  } catch (err) {
    console.warn('chat publish failed:', err);
  }
};

const joinNew = async (roomName, b64Key = null, opts = {}) => {
  MentriaBus.unprovide('comms.peers');
  MentriaBus.unprovide('comms.share');
  MentriaBus.unprovide('extensions.requestInstall');
  endCall(true);
  if (room) {
    closeChatSub();
    try { await room.leave(); } catch {}
    room = null;
    chatAction = metaAction = chunkAction = profAction = callAction = null;
    peers.clear();
    peerProfiles.clear();
    if (historyTimer) { clearTimeout(historyTimer); historyTimer = null; }
    historyBuffered = false;
    historyBuffer = [];
    chatSubId = null;
    chatTopic = null;
    chatKey = null;
  }
  revokeObjectUrls();
  currentDmContact = null;
  els.log.innerHTML = '';
  els.status.textContent = 'connecting…';
  els.peers.hidden = true;
  els.enc.hidden = true;

  chatKey = b64Key ? await deriveKey(b64Key) : null;
  if (b64Key && !chatKey) sys('encryption key in URL is invalid — chat will appear unreadable.');

  if (opts.share === false || isDmRoom(roomName)) {
    if (window.location.hash) window.history.replaceState(null, '', window.location.pathname + window.location.search);
  } else {
    window.location.hash = formatHash(roomName, b64Key);
  }
  refreshShareUrl(roomName, b64Key);

  let iceServers;
  try {
    iceServers = await getIce();
  } catch {
    iceServers = FALLBACK_ICE;
  }

  try {
    room = joinRoom(
      {
        appId: 'mentria',
        relayConfig: { urls: [RELAY] },
        rtcConfig: { iceServers }
      },
      roomName
    );
  } catch (err) {
    sys(`failed to join: ${err.message}`);
    els.status.textContent = 'error';
    return;
  }

  currentRoomName = roomName;
  els.status.textContent = `room: ${roomName}`;
  setConnUI();
  els.eph.hidden = !isEphemeralRoom(roomName);
  els.enc.hidden = !chatKey;
  els.msg.disabled = false;
  els.go.disabled = false;
  updatePeers();
  updateCallUI();
  sys(`you are ${myProfile.name ? myProfile.name + ' (' + short(selfId) + ')' : short(selfId)} — alone in "${roomName}". share the URL to invite someone.`);
  if (chatKey) sys('end-to-end encrypted. anyone with the full URL (including the key after the colon) can decrypt.');

  callAction = room.makeAction('call');
  callAction.onMessage = (data, ctx) => {
    const kind = data && data.kind;
    if (kind === 'ring') {
      if (call.active) return;
      els.ringText.textContent = `${displayName(ctx.peerId)} is calling`;
      els.ring.hidden = false;
      call.ringDeadline = Date.now() + 30000;
      if (call.ringTimer) clearInterval(call.ringTimer);
      call.ringTimer = setInterval(() => {
        if (Date.now() > call.ringDeadline) { stopRinging(); return; }
        playPing(660);
      }, 1400);
      playPing(660);
    } else if (kind === 'decline') {
      sys(`${displayName(ctx.peerId)} declined the call.`);
    } else if (kind === 'leave') {
      removeTile(ctx.peerId);
      sys(`${displayName(ctx.peerId)} left the call.`);
    } else if (kind === 'join') {
      sys(`${displayName(ctx.peerId)} joined the call.`);
    }
  };

  room.onPeerStream = (stream, peerId) => {
    if (call.active) addTile(peerId, stream, { label: displayName(peerId) });
    else pendingStreams.set(peerId, stream);
  };

  profAction = room.makeAction('prof');
  profAction.onMessage = async (data, ctx) => {
    if (!data || typeof data !== 'object') return;
    const prof = { name: String(data.name || '').slice(0, 32) };
    if (data.pub && typeof data.pub.x === 'string' && typeof data.pub.y === 'string') {
      prof.pub = { x: data.pub.x, y: data.pub.y };
      try { prof.fp = await CID.fingerprint(prof.pub); } catch {}
    }
    if (typeof data.ring === 'string') prof.ring = data.ring.slice(0, 64);
    const known = peerProfiles.get(ctx.peerId);
    peerProfiles.set(ctx.peerId, prof);
    renderPeerList();
    if (!known && prof.name) sys(`${short(ctx.peerId)} is ${prof.name}${prof.fp ? ' (' + prof.fp + ')' : ''}`);
  };

  chatAction = room.makeAction('chat');
  chatAction.onMessage = async (data, ctx) => {
    const cmid = data && data.cmid;
    if (cmid && seenCmids.has(cmid)) return;
    let text;
    if (data && data.enc) {
      if (!chatKey) return;
      try { text = await decryptText(chatKey, data.enc); } catch { return; }
    } else {
      text = String(data && data.text || '');
    }
    if (cmid) seenCmids.add(cmid);
    if (historyBuffered) {
      historyBuffer.push({ senderId: ctx.peerId, text, ts: Date.now() });
      return;
    }
    renderLine(displayName(ctx.peerId), text, { peerId: ctx.peerId });
    playPing(880);
    bumpUnread();
  };

  const incoming = new Map();
  metaAction = room.makeAction('fmeta');
  metaAction.onMessage = (meta, ctx) => {
    const line = renderLine(displayName(ctx.peerId), '', { peerId: ctx.peerId, quiet: true, html: progressHTML('receiving', meta.name, meta.size, 0) });
    incoming.set(ctx.peerId + ':' + meta.id, { meta, chunks: [], received: 0, line });
  };

  chunkAction = room.makeAction('fchunk');
  chunkAction.onMessage = async (data, ctx) => {
    const m = ctx.metadata || {};
    const key = ctx.peerId + ':' + m.id;
    const entry = incoming.get(key);
    if (!entry) return;
    entry.chunks.push(data);
    entry.received += (data.byteLength || data.size || 0);
    entry.line.what.innerHTML = progressHTML('receiving', entry.meta.name, entry.meta.size, entry.received);
    if (m.done) {
      entry.line.line.removeAttribute('aria-live');
      const blob = new Blob(entry.chunks, { type: entry.meta.type || 'application/octet-stream' });
      if (entry.meta.kind === 'mentria-ext') {
        const html = await blob.text();
        const who = short(ctx.peerId);
        const label = document.createElement('span');
        label.textContent = 'extension from ' + who + ': ' + (entry.meta.extName || entry.meta.name) + ' ';
        const installBtn = document.createElement('button');
        installBtn.type = 'button';
        installBtn.className = 'comms__btn comms__btn--ghost';
        installBtn.textContent = 'install';
        installBtn.addEventListener('click', async () => {
          installBtn.disabled = true;
          try {
            const installed = await MentriaBus.invoke('extensions.requestInstall', { html, from: who });
            if (installed) {
              installBtn.replaceWith(Object.assign(document.createElement('a'), { href: '/tools/extensions/run/?id=' + encodeURIComponent(installed.manifest.id), textContent: 'open' }));
              label.textContent = 'installed ✓ ';
            } else { installBtn.disabled = false; }
          } catch (e) { sys('install failed: ' + e.message); installBtn.disabled = false; }
        });
        entry.line.what.innerHTML = '';
        entry.line.what.append(label, installBtn);
      } else {
        const url = trackObjectUrl(blob);
        entry.line.what.innerHTML = 'received ' + completeHTML(entry.meta.name, entry.meta.size, entry.meta.type, url);
      }
      incoming.delete(key);
      playPing(660);
    }
  };

  room.onPeerJoin = (peerId) => {
    peers.add(peerId);
    updatePeers();
    renderPeerList();
    sys(`${short(peerId)} joined`);
    sendProfileTo(peerId);
  };
  room.onPeerLeave = (peerId) => {
    const who = displayName(peerId);
    for (const [key, entry] of incoming) {
      if (key.startsWith(peerId + ':')) {
        entry.line.line.removeAttribute('aria-live');
        entry.line.what.innerHTML = `transfer interrupted — <strong>${escapeHtml(entry.meta.name)}</strong> (${escapeHtml(who)} left before finishing)`;
        incoming.delete(key);
      }
    }
    peers.delete(peerId);
    peerProfiles.delete(peerId);
    removeTile(peerId);
    pendingStreams.delete(peerId);
    updatePeers();
    renderPeerList();
    sys(`${displayName(peerId)} left`);
  };

  setupChatPersistence(roomName);

  MentriaBus.provide('comms.peers', () => ({ count: peers.size }), { description: 'Number of connected comms peers.', parameters: { type: 'object', properties: {} }, ai: false });
  MentriaBus.provide('comms.share', async ({ filename, html, name }) => {
    if (!metaAction || !chunkAction) throw new Error('comms not connected');
    if (peers.size === 0) throw new Error('no peers to send to');
    if (new Blob([html]).size > MAX_FILE) throw new Error('extension too large to send');
    const file = new File([html], filename || 'extension.html', { type: 'text/html' });
    await sendOne(file, { kind: 'mentria-ext', extName: name });
    return { sentTo: peers.size };
  }, { description: 'Send an extension to connected comms peers.', parameters: { type: 'object', properties: { filename: { type: 'string' }, html: { type: 'string' }, name: { type: 'string' } }, required: ['html'] }, ai: false });
  MentriaBus.provide('extensions.requestInstall', ({ html, from }) => confirmInstall(html, { from }), { description: 'Install a received extension after a human trust prompt.', parameters: { type: 'object', properties: { html: { type: 'string' }, from: { type: 'string' } }, required: ['html'] }, ai: false });
};

