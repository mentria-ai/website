<style>
.ph-wrap { margin: 1.25rem 0 2rem; }
.ph-stage {
  position: relative; width: 100%; aspect-ratio: 16 / 9;
  max-height: 76vh; max-height: 76svh;
  overflow: hidden; background: #04060a;
  border: 1px solid var(--term-border-strong); border-radius: var(--radius-lg);
  font-family: var(--font-mono); touch-action: none;
  -webkit-user-select: none; user-select: none;
}
.ph-stage.is-playing { cursor: none; }
.ph-stage:fullscreen { aspect-ratio: auto; width: 100vw; height: 100vh; height: 100svh; max-height: none; border: 0; border-radius: 0; }
.ph-stage:-webkit-full-screen { aspect-ratio: auto; width: 100vw; height: 100vh; max-height: none; border: 0; border-radius: 0; }
.ph-canvas { display: block; width: 100%; height: 100%; }

.ph-hud {
  position: absolute; inset: 0; z-index: 10; pointer-events: none;
  font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em;
}
.ph-hud[hidden] { display: none; }
.ph-hud__tl { position: absolute; top: 0.6rem; left: 0.75rem; display: flex; gap: 1.2rem; }
.ph-hud__tr { position: absolute; top: 0.6rem; right: 0.75rem; display: flex; gap: 0.4rem; align-items: center; pointer-events: auto; }
.ph-hud__bl { position: absolute; bottom: 0.8rem; left: 0.75rem; }
.ph-hud__br { position: absolute; bottom: 0.8rem; right: 0.75rem; text-align: right; }
.ph-stat { display: flex; flex-direction: column; gap: 0.1rem; }
.ph-stat--row { flex-direction: row; align-items: baseline; gap: 0.35rem; }
.ph-stat__k { color: var(--term-muted); font-size: var(--text-2xs); }
.ph-stat__v {
  font-variant-numeric: tabular-nums; font-size: var(--text-md);
  color: var(--accent); text-shadow: 0 0 10px rgba(110, 243, 197, 0.35);
}
.ph-stat--big .ph-stat__v { font-size: var(--text-2xl); }
.ph-stat__v--sub { font-size: var(--text-sm); color: var(--term-muted); text-shadow: none; }

.ph-cross { position: absolute; left: 50%; top: 50%; width: 0; height: 0; }
.ph-cross[hidden] { display: none; }
.ph-cross__l {
  position: absolute; left: 0; top: 0; border-radius: 1px;
  background: var(--accent); box-shadow: 0 0 6px rgba(110, 243, 197, 0.6);
}
.ph-cross__l--t, .ph-cross__l--b { width: 2px; height: 8px; }
.ph-cross__l--l, .ph-cross__l--r { width: 8px; height: 2px; }

.ph-hit { position: absolute; left: 50%; top: 50%; width: 0; height: 0; opacity: 0; transition: opacity 60ms linear; }
.ph-hit.is-on { opacity: 1; }
.ph-hit i { position: absolute; width: 2px; height: 10px; background: #ffffff; box-shadow: 0 0 6px rgba(255, 255, 255, 0.8); }
.ph-hit i:nth-child(1) { transform: translate(-50%, -50%) translate(-9px, -9px) rotate(45deg); }
.ph-hit i:nth-child(2) { transform: translate(-50%, -50%) translate(9px, -9px) rotate(-45deg); }
.ph-hit i:nth-child(3) { transform: translate(-50%, -50%) translate(-9px, 9px) rotate(-45deg); }
.ph-hit i:nth-child(4) { transform: translate(-50%, -50%) translate(9px, 9px) rotate(45deg); }
.ph-kill {
  position: absolute; left: 50%; top: 50%; width: 34px; height: 34px; margin: -17px 0 0 -17px;
  border: 2px solid var(--syn-amber); border-radius: 50%; opacity: 0; transform: scale(0.6);
  transition: opacity 120ms ease, transform 220ms ease;
}
.ph-kill.is-on { opacity: 0.95; transform: scale(1); }

.ph-ov {
  position: absolute; inset: 0; z-index: 30;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 0.7rem; padding: 1.5rem; text-align: center;
  background: rgba(4, 6, 10, 0.74); font-family: var(--font-mono);
}
.ph-ov[hidden] { display: none; }
.ph-ov p { margin: 0; }
.ph-ov__title {
  margin: 0; font-size: clamp(2.2rem, 9vw, 4.5rem); letter-spacing: 0.22em;
  color: var(--accent); text-shadow: 0 0 24px rgba(110, 243, 197, 0.4);
}
.ph-ov__title--sm { font-size: clamp(1.3rem, 4vw, 2rem); letter-spacing: 0.16em; }
.ph-ov__sub { color: var(--term-fg); font-size: var(--text-sm); letter-spacing: 0.1em; text-transform: uppercase; }
.ph-ov__cta { color: var(--syn-amber); font-size: var(--text-sm); }
.ph-ov__cta[hidden] { display: none; }
.ph-ov__hint { color: var(--term-muted); font-size: var(--text-xs); max-width: 52ch; line-height: 1.8; }
.ph-ov__note { color: var(--term-subtle); font-size: var(--text-2xs); }
.ph-ov__row { display: flex; gap: 0.6rem; flex-wrap: wrap; justify-content: center; }
.ph-ov__time { font-size: var(--text-xl); color: var(--accent); font-variant-numeric: tabular-nums; }
.ph-ov__code { display: block; max-width: 60ch; color: var(--syn-pink); font-size: var(--text-2xs); word-break: break-word; }
.ph-ov--fail .ph-ov__title--sm { color: var(--syn-amber); }
.ph-ov--ready, .ph-ov--complete { justify-content: flex-start; overflow-y: auto; gap: 0.4rem; padding: 0.9rem 1rem 1.4rem; }
.ph-ov--ready .ph-ov__title { font-size: clamp(1.1rem, 3.4vw, 1.7rem); }
.ph-ov--ready .ph-ov__hint { font-size: var(--text-2xs); line-height: 1.6; max-width: 62ch; }

.ph-sel__wrap { width: min(540px, 100%); display: flex; flex-direction: column; gap: 0.3rem; }
.ph-sel__title { margin: 0; color: var(--term-muted); font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.16em; }
.ph-sel { display: flex; flex-direction: column; gap: 0.25rem; }
.ph-sel__row {
  display: grid; grid-template-columns: 2rem minmax(0, 1fr) auto auto; align-items: center; gap: 0.5rem;
  pointer-events: auto; cursor: pointer; text-align: left; min-height: 42px;
  font-family: var(--font-mono); font-size: var(--text-xs); color: var(--term-fg);
  background: rgba(6, 9, 14, 0.66); border: 1px solid var(--term-border);
  border-radius: var(--radius-md); padding: 0.3rem 0.65rem;
}
.ph-sel__row:hover { border-color: var(--term-border-strong); background: rgba(12, 18, 24, 0.8); }
.ph-sel__row.is-sel { border-color: var(--accent); background: rgba(14, 42, 34, 0.82); }
.ph-sel__n { color: var(--term-subtle); font-size: var(--text-2xs); font-variant-numeric: tabular-nums; }
.ph-sel__name { text-transform: uppercase; letter-spacing: 0.1em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ph-sel__best { display: flex; gap: 0.35rem; align-items: baseline; }
.ph-sel__k { color: var(--term-subtle); font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.1em; }
.ph-sel__bv { color: var(--accent); font-size: var(--text-2xs); font-variant-numeric: tabular-nums; }
.ph-sel__err { display: flex; flex-direction: column; gap: 0.2rem; }
.ph-sel__err[hidden] { display: none; }

.ph-medal {
  display: inline-block; margin: 0; border-radius: var(--radius-pill);
  border: 1px solid currentColor; padding: 0.12rem 0.5rem;
  font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.12em; white-space: nowrap;
}
.ph-medal[hidden] { display: none; }
.ph-medal--bronze { color: #d08a4e; background: rgba(205, 127, 50, 0.12); }
.ph-medal--silver { color: #c0c0c8; background: rgba(192, 192, 200, 0.12); }
.ph-medal--gold { color: #e8c547; background: rgba(232, 197, 71, 0.12); }
.ph-medal--signal {
  color: var(--accent); background: rgba(110, 243, 197, 0.14);
  box-shadow: 0 0 16px rgba(110, 243, 197, 0.4); text-shadow: 0 0 10px rgba(110, 243, 197, 0.6);
}
.ph-medal--none { color: var(--term-subtle); background: none; }
.ph-medal--lg { font-size: var(--text-sm); padding: 0.3rem 0.9rem; letter-spacing: 0.2em; }

.ph-par { width: min(320px, 100%); display: flex; flex-direction: column; gap: 0.25rem; }
.ph-par__title { margin: 0; color: var(--term-muted); font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.16em; }
.ph-par__body { display: flex; flex-direction: column; gap: 0.2rem; }
.ph-par__row { display: grid; grid-template-columns: 5.8rem minmax(0, 1fr) 5rem; align-items: center; gap: 0.5rem; font-size: var(--text-2xs); }
.ph-par__t { color: var(--term-fg); font-variant-numeric: tabular-nums; text-align: right; }
.ph-par__d { color: var(--syn-amber); font-variant-numeric: tabular-nums; text-align: right; }
.ph-par__d.is-good { color: var(--accent); }
.ph-best { margin: 0; color: var(--term-muted); font-size: var(--text-xs); }
.ph-flair { color: var(--accent); text-transform: uppercase; letter-spacing: 0.14em; text-shadow: 0 0 12px rgba(110, 243, 197, 0.5); }
.ph-flair[hidden] { display: none; }

.ph-btn {
  pointer-events: auto; cursor: pointer;
  font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.1em;
  color: var(--term-fg); background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--term-border-strong); border-radius: var(--radius-pill);
  padding: 0.6rem 1.1rem; min-height: 44px;
}
.ph-btn:hover { border-color: var(--accent); color: var(--accent); }
.ph-btn[hidden] { display: none; }
.ph-btn--primary { background: var(--accent); color: #04120c; border-color: var(--accent); min-height: 56px; padding: 0.9rem 2rem; font-size: var(--text-sm); }
.ph-btn--primary:hover, .ph-btn--primary:active { background: #9df8dc; border-color: #9df8dc; color: #04120c; }
.ph-btn--icon { min-width: 44px; min-height: 44px; padding: 0.35rem 0.55rem; border-radius: var(--radius-md); }
.ph-btn--sm { min-height: 38px; padding: 0.4rem 0.8rem; font-size: var(--text-2xs); }
.ph-btn:disabled { opacity: 0.4; cursor: default; }
.ph-btn:disabled:hover { border-color: var(--term-border-strong); color: var(--term-fg); }
.ph-chip {
  background: rgba(0, 0, 0, 0.45); border: 1px solid var(--term-border); border-radius: var(--radius-pill);
  padding: 0.25rem 0.6rem; color: var(--term-muted); font-size: var(--text-2xs);
}
.ph-gyro { position: absolute; left: 50%; bottom: 1.1rem; transform: translateX(-50%); z-index: 40; min-height: 56px; }

.ph-dev {
  position: absolute; top: 0; right: 0; bottom: 0; width: min(360px, 88%); z-index: 60;
  display: flex; flex-direction: column;
  background: rgba(6, 8, 12, 0.95); border-left: 1px solid var(--term-border-strong);
  font-family: var(--font-mono); color: var(--term-fg);
}
.ph-dev[hidden] { display: none; }
.ph-dev__head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0.5rem 0.7rem; border-bottom: 1px solid var(--term-border);
  font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.14em; color: var(--accent);
}
.ph-dev__x { background: none; border: 0; color: var(--term-muted); font-family: inherit; font-size: var(--text-sm); cursor: pointer; min-width: 32px; min-height: 32px; }
.ph-dev__body { flex: 1; overflow-y: auto; padding: 0.4rem 0.7rem 1rem; }
.ph-dev__sec { margin: 0.9rem 0 0.35rem; color: var(--syn-cyan); font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.14em; }
.ph-dev__row { display: grid; grid-template-columns: 8rem 1fr 4.4rem; align-items: center; gap: 0.4rem; margin-bottom: 0.3rem; }
.ph-dev__row--wide { grid-template-columns: 4rem 1fr; }
.ph-dev__sel { min-height: 30px; }
.ph-dev__k { font-size: var(--text-2xs); color: var(--term-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ph-dev__range { width: 100%; accent-color: var(--accent); }
.ph-dev__num {
  width: 100%; background: #0b0e14; border: 1px solid var(--term-border-strong);
  border-radius: var(--radius-sm); color: var(--term-fg);
  font-family: inherit; font-size: var(--text-2xs); padding: 0.2rem 0.3rem;
}
.ph-dev__foot { display: flex; align-items: center; gap: 0.4rem; padding: 0.5rem 0.7rem; border-top: 1px solid var(--term-border); }
.ph-dev__btn {
  font-family: inherit; font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.08em;
  background: rgba(255, 255, 255, 0.06); border: 1px solid var(--term-border-strong);
  border-radius: var(--radius-sm); color: var(--term-fg); padding: 0.4rem 0.6rem; cursor: pointer; min-height: 34px;
}
.ph-dev__status { font-size: var(--text-2xs); color: var(--accent); }
.ph-devchip {
  position: absolute; right: 0.75rem; top: 3.1rem; z-index: 50; cursor: pointer;
  font-family: var(--font-mono); font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.12em;
  background: rgba(0, 0, 0, 0.5); border: 1px solid var(--term-border-strong);
  border-radius: var(--radius-pill); color: var(--term-muted); padding: 0.3rem 0.6rem;
}

@media (max-width: 720px) {
  .ph-stage { aspect-ratio: auto; height: 70vh; height: 70svh; max-height: none; }
  .ph-hud__tl { gap: 0.8rem; }
  .ph-stat--big .ph-stat__v { font-size: var(--text-xl); }
}
</style>

<section class="hero" style="padding-top:1rem;">
  <p class="eyebrow eyebrow--crumbs"><a class="eyebrow__link" href="/">~</a><span class="eyebrow__sep">/</span><a class="eyebrow__link" href="/tools/">tools</a><span class="eyebrow__sep">/</span><span class="eyebrow__current">phosphor</span></p>
