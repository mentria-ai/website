      const spec = { name: SEARCH_ADAPTER.name, configUrl: base + SEARCH_ADAPTER.path + 'adapter_config.json', weightsUrl: base + SEARCH_ADAPTER.path + 'adapter_model.safetensors' };
      const head = await fetch(spec.configUrl, { method: 'HEAD' });
      searchAdapterSpecState = head.ok ? spec : false;
    } catch (_) { searchAdapterSpecState = false; }
    return searchAdapterSpecState;
  }

  async function setSearchAdapter(on) {
