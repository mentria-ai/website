---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/tools/password-generator/index.html"
eleventyComputed:
  lang: "{{ locale.code }}"
  title: "{{ 'tools.password-generator.title' | t }}"
  description: "{{ 'tools.password-generator.lede' | t }}"
---
<section class="hero" style="padding-top:1rem;">
  <p class="eyebrow eyebrow--crumbs"><a class="eyebrow__link" href="{{ locale.pathPrefix }}/" aria-label="{{ 'nav.home' | t }}">~</a><span class="eyebrow__sep">/</span><a class="eyebrow__link" href="{{ locale.pathPrefix }}/tools/">tools</a><span class="eyebrow__sep">/</span><span class="eyebrow__current">password-generator</span></p>
  <h1>{{ "tools.password-generator.title" | t }}</h1>
  <p>{{ "tools.password-generator.lede" | t }}</p>
  {% include "tldr.njk" %}
</section>

{% set terminalTitle = "password-generator.js" %}
{% include "terminal-frame-open.njk" %}
<section class="pwg" id="pwg">
  <div class="m-seg pwg__mode" id="pwg-mode" aria-label="{{ 'tool.password-generator.mode_label' | t }}">
    <button type="button" data-value="password">{{ "tool.password-generator.mode_password" | t }}</button>
    <button type="button" data-value="passphrase">{{ "tool.password-generator.mode_passphrase" | t }}</button>
  </div>

  <div class="pwg__card">
    <h2 class="pwg__label">
      <span id="pwg-label-password">{{ "tool.password-generator.output_password" | t }}</span>
      <span id="pwg-label-passphrase" hidden>{{ "tool.password-generator.output_passphrase" | t }}</span>
    </h2>
    <div class="pwg__secret" id="pwg-secret" translate="no" data-mode="password"></div>

    <div class="pwg__meter" id="pwg-meter" data-level="0">
      <div class="pwg__bars" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
      <p class="pwg__score"><span class="pwg__strength" id="pwg-strength"></span><span class="pwg__bits" id="pwg-bits"></span></p>
      <p class="pwg__calc" id="pwg-calc"></p>
      <p class="pwg__note">{{ "tool.password-generator.entropy_note" | t }}</p>
    </div>

    <div class="pwg__actions">
      <button type="button" class="m-btn m-btn--primary pwg__btn pwg__copy" id="pwg-copy">
        <svg class="pwg__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        <span class="pwg__swap">
          <span class="pwg__swap-idle">{{ "tool.password-generator.btn_copy" | t }}</span>
          <span class="pwg__swap-done">{{ "tool.password-generator.btn_copied" | t }}</span>
        </span>
      </button>
      <button type="button" class="m-btn m-btn--ghost pwg__btn" id="pwg-regenerate">
        <svg class="pwg__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>
        <span>{{ "tool.password-generator.btn_regenerate" | t }}</span>
      </button>
      <button type="button" class="m-btn m-btn--ghost pwg__btn" id="pwg-more">
        <svg class="pwg__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 6h11M4 12h11M4 18h7"/><path d="M18 15v6M15 18h6"/></svg>
        <span>{{ "tool.password-generator.btn_more" | t }}</span>
      </button>
    </div>

    <div class="pwg__more" id="pwg-more-wrap" hidden>
      <h2 class="pwg__label" id="pwg-more-title">{{ "tool.password-generator.more_heading" | t }}</h2>
      <ol class="pwg__alts" id="pwg-alternatives" role="list" aria-labelledby="pwg-more-title" data-mode="password"></ol>
    </div>

    <p class="pwg__status" id="pwg-status" role="status" aria-live="polite"></p>
  </div>

  <div class="pwg__options">
    <div class="pwg__panel" id="pwg-panel-password">
      <div class="pwg__field">
        <div class="pwg__field-head">
          <label class="pwg__field-label" id="pwg-length-label" for="pwg-length">{{ "tool.password-generator.length_label" | t }}</label>
          <input class="m-input pwg__num" type="number" id="pwg-length" min="8" max="128" step="1" value="20" inputmode="numeric">
        </div>
        <input class="pwg__range" type="range" id="pwg-length-range" min="8" max="128" step="1" value="20" aria-labelledby="pwg-length-label">
      </div>

      <fieldset class="pwg__sets">
        <legend class="pwg__field-label">{{ "tool.password-generator.sets_legend" | t }}</legend>
        <label class="pwg__check"><input type="checkbox" id="pwg-set-lower" checked><span>{{ "tool.password-generator.set_lower" | t }}</span></label>
        <label class="pwg__check"><input type="checkbox" id="pwg-set-upper" checked><span>{{ "tool.password-generator.set_upper" | t }}</span></label>
        <label class="pwg__check"><input type="checkbox" id="pwg-set-digits" checked><span>{{ "tool.password-generator.set_digits" | t }}</span></label>
        <label class="pwg__check"><input type="checkbox" id="pwg-set-symbols" checked aria-describedby="pwg-symbols-hint"><span>{{ "tool.password-generator.set_symbols" | t }}</span></label>
      </fieldset>
      <p class="pwg__hint" id="pwg-symbols-hint"></p>

      <div class="pwg__option">
        <label class="pwg__check"><input type="checkbox" id="pwg-lookalike" aria-describedby="pwg-lookalike-hint"><span>{{ "tool.password-generator.lookalike_label" | t }}</span></label>
        <p class="pwg__hint" id="pwg-lookalike-hint"></p>
      </div>
    </div>

    <div class="pwg__panel" id="pwg-panel-passphrase" hidden>
      <div class="pwg__field">
        <div class="pwg__field-head">
          <label class="pwg__field-label" id="pwg-words-label" for="pwg-words">{{ "tool.password-generator.words_label" | t }}</label>
          <input class="m-input pwg__num" type="number" id="pwg-words" min="3" max="10" step="1" value="7" inputmode="numeric">
        </div>
        <input class="pwg__range" type="range" id="pwg-words-range" min="3" max="10" step="1" value="7" aria-labelledby="pwg-words-label">
      </div>

      <div class="pwg__field">
        <span class="pwg__field-label" id="pwg-separator-label">{{ "tool.password-generator.separator_label" | t }}</span>
        <div class="m-seg pwg__seps" id="pwg-separator" aria-labelledby="pwg-separator-label">
          <button type="button" data-value="space">{{ "tool.password-generator.sep_space" | t }}</button>
          <button type="button" data-value="hyphen" class="pwg__glyph" aria-label="{{ 'tool.password-generator.sep_hyphen' | t }}" title="{{ 'tool.password-generator.sep_hyphen' | t }}">-</button>
          <button type="button" data-value="period" class="pwg__glyph" aria-label="{{ 'tool.password-generator.sep_period' | t }}" title="{{ 'tool.password-generator.sep_period' | t }}">.</button>
          <button type="button" data-value="underscore" class="pwg__glyph" aria-label="{{ 'tool.password-generator.sep_underscore' | t }}" title="{{ 'tool.password-generator.sep_underscore' | t }}">_</button>
        </div>
      </div>

      <div class="pwg__toggles">
        <label class="pwg__check"><input type="checkbox" id="pwg-capitalize"><span>{{ "tool.password-generator.capitalize_label" | t }}</span></label>
        <label class="pwg__check"><input type="checkbox" id="pwg-number"><span>{{ "tool.password-generator.number_label" | t }}</span></label>
      </div>

      <p class="pwg__credit">{{ "tool.password-generator.attribution" | t | safe }}</p>
    </div>
  </div>

  <p class="pwg__privacy">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
    <span>{{ "tool.password-generator.privacy_note" | t }}</span>
  </p>
</section>
{% include "terminal-frame-close.njk" %}

{% set toolSchemaCategory = "SecurityApplication" %}
{% include "tool-schema.njk" %}

<script>
(() => {
  'use strict';

  const COPY = {
