<script>
  window.SKYRUSH_COPY = {
    {%- for k in skKeys %}
    {{ k | dump | safe }}: {{ (k | t) | dump | safe }}{% if not loop.last %},{% endif %}
    {%- endfor %}
  };
</script>
<script type="module" id="sk-mod" src="/assets/games/drone/game.js?v={{ buildHash }}"></script>
<script>
  (function () {
    var s = document.getElementById('sk-mod');
    if (!s) return;
    s.addEventListener('error', function () {
      var boot = document.getElementById('sk-boot');
      var panel = document.getElementById('sk-fail');
      var detail = document.getElementById('sk-fail-detail');
      if (detail) detail.textContent = 'game.js failed to load';
      if (boot) boot.hidden = true;
      if (panel) panel.hidden = false;
      try { console.error('[skyrush] module script failed to load'); } catch (e) {}
    });
    window.addEventListener('error', function (e) {
      var boot = document.getElementById('sk-boot');
      if (!boot || boot.hidden) return;
      var src = e && e.filename ? String(e.filename) : '';
      if (src.indexOf('/assets/games/') === -1) return;
      var panel = document.getElementById('sk-fail');
      var detail = document.getElementById('sk-fail-detail');
      if (detail) detail.textContent = String(e.message || 'error');
      boot.hidden = true;
      if (panel) panel.hidden = false;
    });
  })();
</script>
