    arr.push(cmid);
    log[currentDmContact.fp] = arr.slice(-300);
    MentriaStore.set('comms', 'sentlog', log);
  } catch (_) {}
};

const savedRooms = () => { try { const v = MentriaStore.get('comms', 'rooms'); return Array.isArray(v) ? v : []; } catch (_) { return []; } };
const setSavedRooms = (list) => { try { MentriaStore.set('comms', 'rooms', list); } catch (_) {} };
const roomUnreadKey = (roomName) => 'room:' + roomName;
const rememberRoom = (roomName, b64Key) => {
  if (!roomName || !b64Key || isDmRoom(roomName) || isEphemeralRoom(roomName)) return;
  const list = savedRooms();
  const i = list.findIndex((r) => r.room === roomName);
  const prev = i >= 0 ? list[i] : null;
  const entry = Object.assign({}, prev || {}, { room: roomName, key: b64Key, label: (prev && prev.label) || roomName, joinedAt: (prev && prev.joinedAt) || Date.now(), lastSeen: Date.now() });
  if (i >= 0) list[i] = entry; else list.unshift(entry);
  setSavedRooms(list.slice(0, 50));
};
const forgetRoom = (roomName) => setSavedRooms(savedRooms().filter((r) => r.room !== roomName));
const touchRoom = (roomName) => { const list = savedRooms(); const r = list.find((x) => x.room === roomName); if (r) { r.lastSeen = Date.now(); setSavedRooms(list); } };
const renameRoom = (roomName, label) => { const list = savedRooms(); const r = list.find((x) => x.room === roomName); if (r) { r.label = String(label || '').trim().slice(0, 40) || r.room; setSavedRooms(list); } };
const roomNotifyEntry = (roomName) => savedRooms().find((r) => r.room === roomName) || null;
const roomRings = (entry) => (entry && entry.rings && typeof entry.rings === 'object') ? entry.rings : {};
const RING_TOKEN_RE = /^[A-Za-z0-9_-]{20,64}$/;

const roomKeyCache = new Map();
const roomCryptoKey = (entry) => {
  if (!entry || !entry.key) return Promise.resolve(null);
  if (!roomKeyCache.has(entry.key)) roomKeyCache.set(entry.key, deriveKey(entry.key).catch(() => null));
  return roomKeyCache.get(entry.key);
};

const notifAllowed = () => 'Notification' in window && Notification.permission === 'granted' && !!navigator.serviceWorker;
const pageAway = () => document.hidden || !document.hasFocus();
const notifyLocal = async (spec) => {
  if (!spec || !pageAway() || !notifAllowed()) return;
  try {
    const reg = await navigator.serviceWorker.ready;
    await reg.showNotification(spec.title || 'comms', {
      body: spec.body || T.notif.new_message,
