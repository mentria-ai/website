layout: base.njk
permalink: /comms/index.html
eleventyExcludeFromCollections: true
englishOnly: true
title: comms
description: Peer-to-peer chat, calls and file drop — end-to-end encrypted, no accounts, no server in the middle.
---
<section class="hero" style="padding-top:1rem;">
  <p class="eyebrow eyebrow--crumbs"><a class="eyebrow__link" href="/">~</a><span class="eyebrow__sep">/</span><span class="eyebrow__current">comms</span></p>
  <h1>comms</h1>
  <p>Peer-to-peer chat, voice and video calls, and file drop. End-to-end encrypted, no accounts, no server in the middle. Share a room URL, or trade contact codes and message people directly.</p>
</section>

{% set terminalTitle = "comms.js" %}
{% include "terminal-frame-open.njk" %}

<section class="comms">
  <div class="comms__onboard" id="comms-onboard" hidden>
    <div class="comms__onboard-step" id="comms-onboard-intro">
      <h2 class="comms__onboard-h">Private chat that runs on your devices</h2>
      <p class="comms__onboard-p">Messages, calls and files go straight to the other person — encrypted end to end. No account, no phone number, and no server that can read them.</p>
      <button class="comms__btn comms__btn--big" id="comms-onboard-start" type="button">get started</button>
      <p class="comms__onboard-fine">Takes about ten seconds. Everything stays on your device.</p>
    </div>
    <div class="comms__onboard-step" id="comms-onboard-form" hidden>
      <h2 class="comms__onboard-h">What should people call you?</h2>
      <input class="comms__input comms__input--big" id="comms-onboard-name" type="text" maxlength="32" placeholder="your name" autocomplete="nickname" enterkeyhint="done">
      <button class="comms__btn comms__btn--big" id="comms-onboard-create" type="button">create my identity</button>
      <p class="comms__onboard-fine" id="comms-onboard-hint">Your device will ask for Face&nbsp;ID, Touch&nbsp;ID or your screen lock to protect it.</p>
      <p class="comms__onboard-err" id="comms-onboard-err" hidden></p>
    </div>
    <div class="comms__onboard-step" id="comms-onboard-done" hidden>
      <h2 class="comms__onboard-h">You're set up</h2>
      <p class="comms__onboard-p" id="comms-onboard-method"></p>
      <p class="comms__onboard-p">Save this recovery code somewhere safe. It's the only way back in if you lose your devices — you won't need it day to day.</p>
      <code class="comms__recovery" id="comms-onboard-code"></code>
      <div class="comms__onboard-actions">
        <button class="comms__btn comms__btn--ghost" id="comms-onboard-copy" type="button">copy code</button>
        <button class="comms__btn" id="comms-onboard-passkey" type="button" hidden>protect with face id / touch id</button>
        <button class="comms__btn comms__btn--big" id="comms-onboard-continue" type="button">start chatting</button>
      </div>
    </div>
  </div>

  <div class="comms__lock" id="comms-id-locked" hidden>
    <p class="comms__lock-h">Welcome back</p>
    <button class="comms__btn comms__btn--big" id="comms-id-passkey" type="button" hidden>unlock</button>
    <details class="comms__lock-alt" id="comms-lock-alt">
      <summary>use my recovery code instead</summary>
      <div class="comms__lock-row">
        <input class="comms__input" id="comms-id-pass" type="password" placeholder="recovery code or passphrase" autocomplete="current-password">
        <button class="comms__btn" id="comms-id-unlock" type="button">unlock</button>
      </div>
    </details>
    <span class="comms__id-note" id="comms-id-err"></span>
  </div>

  <div class="comms__app" id="comms-app" hidden>
    <div class="comms__topline">
      <div class="comms__id-row comms__id-row--you" id="comms-id-on" hidden>
        <span class="comms__lbl">you</span>
        <input class="comms__input comms__input--short" id="comms-id-name" type="text" maxlength="32" placeholder="display name" autocomplete="nickname">
        <span class="comms__badge" id="comms-id-fp" title="your identity fingerprint"></span>
      </div>
      <div class="comms__meta">
        <span class="comms__badge" id="comms-status">disconnected</span>
        <span class="comms__badge comms__badge--peers" id="comms-peers" hidden>peers: 0</span>
        <span class="comms__badge comms__badge--eph" id="comms-eph" title="messages aren't saved (room starts with !)" hidden>ephemeral</span>
        <span class="comms__badge comms__badge--enc" id="comms-enc" title="end-to-end encrypted; the key is in the URL after the colon" hidden>encrypted</span>
        <button class="comms__btn" id="comms-call-start" type="button" hidden>call</button>
        <button class="comms__btn comms__btn--ghost" id="comms-call-cam" type="button" hidden aria-pressed="false">camera: off</button>
        <button class="comms__btn comms__btn--ghost" id="comms-call-mic" type="button" hidden aria-pressed="false">mic: on</button>
        <button class="comms__btn comms__btn--danger" id="comms-call-hangup" type="button" hidden>hang up</button>
        <button class="comms__btn comms__btn--ghost comms__btn--gear" id="comms-adv-toggle" type="button" aria-expanded="false" title="settings and rooms">⚙</button>
      </div>
    </div>

    <div class="comms__id-row" id="comms-id-none" hidden>
      <span class="comms__id-note">you're in a shared room as a guest. set up an identity to use your name, contacts and direct messages.</span>
      <button class="comms__btn comms__btn--ghost" id="comms-id-setup-here" type="button">set up</button>
    </div>

    <div class="comms__contacts" id="comms-contacts" hidden>
      <div class="comms__contacts-head">
        <span class="comms__lbl">people</span>
        <button class="comms__btn comms__btn--ghost" id="comms-id-share" type="button" aria-expanded="false">my code</button>
        <button class="comms__btn comms__btn--ghost" id="comms-id-contacts" type="button" aria-expanded="false" hidden>contacts</button>
      </div>
      <div class="comms__contacts-list" id="comms-contacts-list"></div>
      <div class="comms__contacts-add">
        <input class="comms__input" id="comms-contact-in" type="text" enterkeyhint="done" placeholder="paste a contact code (MC1.…)" spellcheck="false" autocapitalize="off">
        <button class="comms__btn comms__btn--ghost" id="comms-contact-add" type="button">add</button>
      </div>
    </div>

    <div class="comms__id-card" id="comms-id-card" hidden>
      <canvas class="comms__id-qr" id="comms-id-qr" width="0" height="0"></canvas>
      <div class="comms__id-card-side">
        <p class="comms__id-note">scan or paste this code on another person's device to become contacts. it contains your public key, never your secrets.</p>
        <code class="comms__url comms__url--wrap" id="comms-id-code"></code>
        <button class="comms__btn comms__btn--ghost" id="comms-id-copy" type="button">copy code</button>
      </div>
    </div>

    <div class="comms__ring" id="comms-ring" hidden>
      <span class="comms__ring-text" id="comms-ring-text">incoming call</span>
      <button class="comms__btn" id="comms-ring-accept" type="button">accept</button>
      <button class="comms__btn comms__btn--ghost" id="comms-ring-decline" type="button">decline</button>
    </div>

    <div class="comms__media" id="comms-media" hidden></div>
    <div class="comms__peerlist" id="comms-peerlist" hidden></div>
    <div class="comms__log" id="comms-log" aria-live="polite" aria-relevant="additions"></div>

    <label class="comms__drop" id="comms-drop">
      <input type="file" id="comms-file" multiple hidden>
      drop files here, or tap to pick — they go straight to the other person
    </label>

    <form class="comms__send" id="comms-send" autocomplete="off">
      <input class="comms__input comms__input--msg" id="comms-msg" type="text" enterkeyhint="send" placeholder="message…" disabled>
      <button class="comms__btn" id="comms-go" type="submit" disabled>send</button>
    </form>

    <div class="comms__adv" id="comms-adv" hidden>
      <div class="comms__adv-sec">
        <span class="comms__lbl">room</span>
        <div class="comms__room">
          <input class="comms__input" id="comms-room" type="text" enterkeyhint="go" autocomplete="off" spellcheck="false" lang="en" dir="ltr" autocapitalize="off" placeholder="!ephemeral">
          <button class="comms__btn" id="comms-join" type="button">join</button>
          <button class="comms__btn comms__btn--ghost" id="comms-newroom" type="button">new room link</button>
        </div>
      </div>
      <div class="comms__share" id="comms-share" hidden>
        <span class="comms__lbl">share</span>
        <code class="comms__url" id="comms-url"></code>
        <button class="comms__btn comms__btn--ghost" id="comms-copy" type="button">copy</button>
        <button class="comms__btn comms__btn--ghost" id="comms-genkey" type="button" title="generate a fresh encryption key and append it to the URL">+ key</button>
      </div>
      <div class="comms__adv-sec">
        <span class="comms__lbl">this device</span>
        <button class="comms__btn comms__btn--ghost comms__btn--mute" id="comms-mute" type="button" aria-pressed="false">sound: on</button>
        <button class="comms__btn comms__btn--ghost" id="comms-attach-ext" type="button">attach extension</button>
        <a class="comms__btn comms__btn--ghost" href="/about/">identity settings</a>
      </div>
    </div>
  </div>

  <div class="comms__picker" id="comms-picker" hidden>
    <div class="comms__picker-backdrop" data-picker-close></div>
    <div class="comms__picker-card" role="dialog" aria-modal="true" aria-label="share extension">
      <h3 class="comms__picker-h">share extension</h3>
      <div class="comms__picker-list" id="comms-picker-list"></div>
      <div class="comms__picker-actions">
        <button type="button" class="comms__btn comms__btn--ghost" data-picker-close>cancel</button>
      </div>
    </div>
  </div>
</section>

{% include "terminal-frame-close.njk" %}

<style>
.comms{display:flex;flex-direction:column;gap:.75rem;font-family:var(--font-mono);font-size:.9rem}
.comms [hidden]{display:none !important}
.comms__onboard{display:flex;flex-direction:column;align-items:center;text-align:center;gap:0;padding:2.5rem 1.25rem;background:#0d1115;border:1px solid #1a1f24;border-radius:10px}
.comms__onboard[hidden]{display:none}
.comms__onboard-step{display:flex;flex-direction:column;align-items:center;gap:.9rem;width:100%;max-width:30rem}
.comms__onboard-step[hidden]{display:none}
.comms__onboard-h{margin:0;font-size:1.05rem;color:var(--accent,#6ef3c5);letter-spacing:.02em;line-height:1.4;text-transform:none}
.comms__onboard-p{margin:0;color:#c3ccd6;font-size:.85rem;line-height:1.65;max-width:26rem}
.comms__onboard-fine{margin:0;color:#7a838d;font-size:.75rem;line-height:1.5}
.comms__onboard-err{margin:0;color:#e5534b;font-size:.78rem;line-height:1.5}
.comms__onboard-err[hidden]{display:none}
.comms__onboard-actions{display:flex;gap:.6rem;flex-wrap:wrap;justify-content:center}
.comms__btn--big{padding:.7rem 1.6rem;font-size:.92rem;min-height:44px}
.comms__input--big{max-width:18rem;text-align:center;padding:.6rem .8rem;font-size:.95rem;flex:none;width:100%}
.comms__recovery{display:block;width:100%;max-width:24rem;background:#0a0d10;border:1px dashed var(--accent,#6ef3c5);border-radius:6px;padding:.7rem;color:var(--accent,#6ef3c5);font-size:.95rem;letter-spacing:.12em;word-break:break-all;line-height:1.6}
.comms__lock{display:flex;flex-direction:column;align-items:center;gap:.75rem;padding:2rem 1.25rem;background:#0d1115;border:1px solid #1a1f24;border-radius:10px;text-align:center}
.comms__lock[hidden]{display:none}
.comms__lock-h{margin:0;color:#c3ccd6;font-size:.95rem}
.comms__lock-alt{width:100%;max-width:24rem;color:#7a838d;font-size:.78rem}
.comms__lock-alt summary{cursor:pointer;list-style:none;padding:.3rem}
.comms__lock-alt summary::-webkit-details-marker{display:none}
.comms__lock-alt summary:hover{color:#9ba6b1}
.comms__lock-row{display:none;gap:.5rem;margin-top:.6rem}
.comms__lock-alt[open] .comms__lock-row{display:flex}
.comms__app{display:flex;flex-direction:column;gap:.75rem}
.comms__app[hidden]{display:none}
.comms__topline{display:flex;gap:.75rem;align-items:center;flex-wrap:wrap;justify-content:space-between}
.comms__id-row--you{flex:1;min-width:13rem}
.comms__btn--gear{min-width:2.4rem;padding:.4rem .6rem;font-size:1rem;line-height:1}
.comms__contacts-head{display:flex;gap:.5rem;align-items:center}
.comms__contacts-head .comms__lbl{flex:1}
.comms__adv{display:flex;flex-direction:column;gap:.75rem;background:#0a0d10;border:1px dashed #2a3138;border-radius:8px;padding:.85rem}
.comms__adv[hidden]{display:none}
.comms__adv-sec{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap}
.comms__contact{cursor:pointer}
@media (max-width:640px){
  .comms__onboard{padding:1.75rem 1rem}
  .comms__onboard-h{font-size:1rem}
  .comms__topline{gap:.5rem}
}
.comms__bar{display:flex;gap:1rem;align-items:center;flex-wrap:wrap;justify-content:space-between}
.comms__room{display:flex;gap:.5rem;align-items:center;flex:1;min-width:14rem}
.comms__meta{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center}
.comms__lbl{color:var(--muted);text-transform:lowercase;letter-spacing:.05em;font-size:.78rem}
.comms__input{background:#0a0d10;border:1px solid #2a3138;color:#e6edf3;padding:.45rem .6rem;border-radius:6px;font-family:inherit;font-size:.9rem;flex:1;min-width:6rem}
.comms__input:focus{outline:none;border-color:var(--accent,#6ef3c5)}
.comms__btn{background:transparent;border:1px solid var(--accent,#6ef3c5);color:var(--accent,#6ef3c5);padding:.4rem .8rem;border-radius:6px;font-family:inherit;font-size:.85rem;cursor:pointer;text-transform:lowercase;letter-spacing:.05em}
.comms__btn:hover:not(:disabled){background:var(--accent,#6ef3c5);color:#0a0d10}
.comms__btn:disabled{opacity:.4;cursor:not-allowed}
.comms__btn--ghost{border-color:#3a4148;color:#9ba6b1}
.comms__btn--ghost:hover{background:#3a4148;color:#e6edf3}
.comms__badge{background:#1a1f24;border:1px solid #2a3138;color:#9ba6b1;padding:.3rem .55rem;border-radius:4px;font-size:.75rem;text-transform:lowercase;letter-spacing:.05em}
.comms__badge--peers{border-color:var(--accent,#6ef3c5);color:var(--accent,#6ef3c5)}
.comms__badge--offline{border-color:#e05c5c;color:#e05c5c}
.comms__send--offline{opacity:.55}
.comms__line--pending .comms__what{color:#9ba6b1}
.comms__pending-note{color:#d9a84e;font-style:italic;font-size:.75rem;margin-left:.45rem}
.comms__resend{margin-left:.5rem;background:none;border:1px solid #2a3138;color:var(--accent,#6ef3c5);border-radius:4px;padding:.1rem .5rem;font:inherit;font-size:.72rem;cursor:pointer;text-transform:lowercase}
.comms__resend:hover{border-color:var(--accent,#6ef3c5)}
.comms__share{display:flex;gap:.5rem;align-items:center;background:#0d1115;border:1px dashed #2a3138;border-radius:6px;padding:.5rem .75rem;flex-wrap:wrap}
.comms__url{color:#e6edf3;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.82rem}
.comms__log{min-height:14rem;max-height:24rem;overflow-y:auto;background:#0a0d10;border:1px solid #1a1f24;border-radius:6px;padding:.75rem;display:flex;flex-direction:column;gap:.4rem}
.comms__line{display:flex;gap:.5rem;align-items:baseline;line-height:1.4}
.comms__who{color:var(--accent,#6ef3c5);font-size:.72rem;min-width:5.5rem;text-transform:lowercase;letter-spacing:.05em}
.comms__who--sys{color:#7a838d}
.comms__who--me{color:#a8b6c5}
.comms__what{color:#e6edf3;word-break:break-word;flex:1}
.comms__what--sys{color:#7a838d;font-style:italic}
.comms__what a{color:var(--accent,#6ef3c5);text-decoration:underline}
.comms__drop{display:block;border:1px dashed #2a3138;border-radius:6px;padding:.75rem;text-align:center;color:#7a838d;font-size:.82rem;cursor:pointer;transition:border-color .15s,color .15s,background .15s}
.comms__drop:hover{border-color:#3a424a;color:#9ba6b1}
.comms__drop--hot{border-color:var(--accent,#6ef3c5);color:var(--accent,#6ef3c5);background:rgba(110,243,197,.04)}
.comms__prog{display:inline-block;width:96px;height:6px;background:#1a1f24;border-radius:3px;overflow:hidden;margin:0 .4rem;vertical-align:middle}
.comms__prog-fill{display:block;height:100%;background:var(--accent,#6ef3c5);width:0%;transition:width .12s linear}
.comms__thumb{display:block;margin-top:.4rem;max-width:240px;max-height:180px;border:1px solid #2a3138;border-radius:4px;cursor:zoom-in}
.comms__peerlist{display:flex;gap:.35rem;align-items:center;flex-wrap:wrap;padding:.2rem 0}
.comms__chip{font-family:var(--font-mono);font-size:.7rem;padding:.2rem .5rem;border-radius:3px;border:1px solid currentColor;line-height:1;letter-spacing:.05em;text-transform:lowercase}
.comms__time{color:#5a636d;font-size:.66rem;margin-left:.3rem;font-variant-numeric:tabular-nums}
.comms__btn--mute{min-width:5.5rem}
.comms__btn--mute[aria-pressed="true"]{color:#7a838d;border-color:#3a4148}
.comms__badge--eph{border-color:#d9a84e;color:#d9a84e;cursor:help}
.comms__badge--enc{border-color:#9b6fd4;color:#9b6fd4;cursor:help}
.comms__send{display:flex;gap:.5rem;align-items:center}
.comms__input--msg{min-width:0}
.comms__picker{position:fixed;inset:0;z-index:60;display:flex;align-items:center;justify-content:center;padding:1rem}
.comms__picker[hidden]{display:none}
.comms__picker-backdrop{position:absolute;inset:0;background:rgba(0,0,0,.6);backdrop-filter:blur(4px)}
.comms__picker-card{position:relative;z-index:1;background:#0d1014;border:1px solid #2a3138;border-radius:8px;padding:1rem;width:100%;max-width:24rem;max-height:80vh;overflow:auto;display:flex;flex-direction:column;gap:.7rem}
.comms__picker-h{margin:0;font-size:.9rem;color:var(--accent,#6ef3c5);text-transform:lowercase;letter-spacing:.05em}
.comms__picker-list{display:flex;flex-direction:column;gap:.4rem}
.comms__picker-item{display:flex;justify-content:space-between;align-items:center;gap:.7rem;width:100%;text-align:left;background:#0a0d10;border:1px solid #2a3138;color:#e6edf3;padding:.5rem .7rem;border-radius:6px;font-family:inherit;font-size:.85rem;cursor:pointer}
.comms__picker-item:hover{border-color:var(--accent,#6ef3c5);color:var(--accent,#6ef3c5)}
.comms__picker-ver{color:var(--muted);font-size:.75rem;flex:none}
.comms__picker-actions{display:flex;justify-content:flex-end}
.comms__id-row{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;background:#0d1115;border:1px solid #1a1f24;border-radius:6px;padding:.5rem .75rem}
.comms__id-note{color:#7a838d;font-size:.78rem}
.comms__input--short{max-width:13rem;flex:0 1 auto}
.comms__id-card{display:flex;gap:1rem;align-items:flex-start;background:#0d1115;border:1px dashed #2a3138;border-radius:6px;padding:.75rem;flex-wrap:wrap}
.comms__id-qr{border-radius:4px;flex:none}
.comms__id-card-side{display:flex;flex-direction:column;gap:.5rem;flex:1;min-width:12rem}
.comms__url--wrap{white-space:normal;word-break:break-all;font-size:.7rem;max-height:5.5rem;overflow:auto}
.comms__contacts{display:flex;flex-direction:column;gap:.5rem;background:#0d1115;border:1px solid #1a1f24;border-radius:6px;padding:.6rem .75rem}
.comms__contacts-add{display:flex;gap:.5rem;align-items:center}
.comms__contacts-list{display:flex;flex-direction:column;gap:.3rem}
.comms__contact{display:flex;gap:.6rem;align-items:center;flex-wrap:wrap;padding:.3rem 0;border-bottom:1px solid #14181d}
.comms__contact--req{background:rgba(110,243,197,.05);border-left:2px solid var(--accent,#6ef3c5);padding-left:.5rem;border-radius:4px}
.comms__unread{display:inline-block;min-width:1.15rem;padding:0 .3rem;border-radius:999px;background:var(--accent,#6ef3c5);color:#0a0d10;font-size:.68rem;text-align:center;line-height:1.15rem;font-weight:700}
.comms__contact:last-child{border-bottom:none}
.comms__contact-name{color:#e6edf3;font-size:.85rem}
.comms__contact-fp{color:#5a636d;font-size:.7rem}
.comms__contact-spacer{flex:1}
.comms__chip-add{margin-left:.3rem;border:none;background:none;color:inherit;cursor:pointer;font-size:.75rem;padding:0}
.comms__btn--danger{border-color:#e5534b;color:#e5534b}
.comms__btn--danger:hover:not(:disabled){background:#e5534b;color:#0a0d10}
.comms__ring{display:flex;gap:.6rem;align-items:center;background:#141a12;border:1px solid var(--accent,#6ef3c5);border-radius:6px;padding:.55rem .75rem}
.comms__ring-text{color:var(--accent,#6ef3c5);flex:1;font-size:.85rem}
.comms__media{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:.5rem;background:#0a0d10;border:1px solid #1a1f24;border-radius:6px;padding:.5rem}
.comms__tile{position:relative;background:#0d1115;border:1px solid #2a3138;border-radius:6px;overflow:hidden;min-height:72px;display:flex;align-items:center;justify-content:center}
.comms__tile video{width:100%;height:100%;max-height:200px;object-fit:cover;display:block}
.comms__tile-label{position:absolute;left:.4rem;bottom:.3rem;background:rgba(0,0,0,.55);color:#e6edf3;font-size:.68rem;padding:.1rem .4rem;border-radius:3px;letter-spacing:.05em}
.comms__tile-voice{color:var(--accent,#6ef3c5);font-size:1.3rem}
</style>

