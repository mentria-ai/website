<script type="module" id="ph-mod" src="/assets/phosphor/game.js?v={{ buildHash }}"></script>
<script>
  (function () {
    var s = document.getElementById('ph-mod');
    if (!s) return;
    s.addEventListener('error', function () {
      var boot = document.getElementById('ph-boot');
      var panel = document.getElementById('ph-unsup');
      var detail = document.getElementById('ph-unsup-detail');
      if (detail) detail.textContent = 'game.js failed to load';
      if (boot) boot.hidden = true;
      if (panel) panel.hidden = false;
      try { console.error('[phosphor] module script failed to load'); } catch (e) {}
    });
  })();
</script>
