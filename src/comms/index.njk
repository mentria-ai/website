const sendProfileTo = (peerId) => {
  if (!profAction || !myId) return;
  const payload = { name: myProfile.name, pub: { x: myId.publicJwk.x, y: myId.publicJwk.y } };
  if (ringToken) payload.ring = ringToken;
  try { profAction.send(payload, peerId || undefined); } catch {}
};

const broadcastProfile = () => sendProfileTo(null);

let onboardDone = false;
let onboardActive = false;

const INBOX_KIND = 3839;
const INBOX_LOOKBACK_SEC = 14 * 24 * 60 * 60;
let sideWs = null;
let sideOpen = null;
let inboxSubId = null;
let unreadSubId = null;
let myInboxTopic = null;
const topicToFp = new Map();
const seenInboxIds = new Set();
let unreadMap = {};

let sideOpens = 0;

const ensureSideSocket = () => {
  if (sideWs && sideWs.readyState === 1) return Promise.resolve(sideWs);
  if (sideOpen) return sideOpen;
  sideOpen = new Promise((resolve) => {
    let ws;
    try { ws = new WebSocket(RELAY); } catch (_) { sideOpen = null; resolve(null); return; }
    const done = (val) => { sideOpen = null; resolve(val); };
    ws.addEventListener('open', () => {
      sideWs = ws;
      const isReconnect = sideOpens++ > 0;
      done(ws);
      if (isReconnect && myId) { subscribeInbox(); subscribeUnread(); }
    });
    ws.addEventListener('error', () => { done(null); });
    ws.addEventListener('close', () => {
      if (sideWs === ws) {
        sideWs = null;
        setTimeout(() => { if (myId && !document.hidden && !sideWs) ensureSideSocket(); }, 4000 + Math.random() * 4000);
      }
    });
    ws.addEventListener('message', handleSideMsg);
  });
  return sideOpen;
};

const sideSend = async (str) => {
  const ws = await ensureSideSocket();
  if (!ws || ws.readyState !== 1) return false;
  try { ws.send(str); return true; } catch (_) { return false; }
};

const publishToInbox = async (theirPub, payload) => {
  try {
    const env = await CID.sealToInbox(theirPub, payload);
    const topic = await CID.inboxTopic(theirPub);
    const evt = await createPersistentEvent(INBOX_KIND, topic, JSON.stringify(env));
    let sent = await sideSend(evt);
    const sockets = getRelaySockets() || {};
    for (const ws of Object.values(sockets)) {
      if (ws && ws.readyState === 1) { try { ws.send(evt); sent = true; } catch (_) {} }
    }
    return sent;
  } catch (_) { return false; }
};

const announceToContact = async (contact) => {
  if (!myId || !contact || !contact.pub) return;
  const payload = { v: 1, name: (myProfile && myProfile.name) || '', pub: { x: myId.publicJwk.x, y: myId.publicJwk.y } };
  if (ringToken) payload.ring = ringToken;
  await publishToInbox(contact.pub, payload);
};

const subscribeInbox = async () => {
  if (!myId) return;
  myInboxTopic = await CID.inboxTopic(myId.publicJwk);
  inboxSubId = 'mi-' + Math.random().toString(36).slice(2);
  const since = Math.floor(Date.now() / 1000) - INBOX_LOOKBACK_SEC;
  await sideSend(JSON.stringify(['REQ', inboxSubId, { kinds: [INBOX_KIND], '#x': [myInboxTopic], since, limit: 50 }]));
};

const subscribeUnread = async () => {
  if (!myId) return;
  const contacts = CID.getContacts();
  topicToFp.clear();
  const topics = [];
  for (const c of contacts) {
    try {
      const { roomName } = await CID.deriveDm(myId.privateKey, c.pub);
      const topic = CHAT_TOPIC_PREFIX + roomName;
      topicToFp.set(topic, c.fp);
      topics.push(topic);
    } catch (_) {}
  }
  if (unreadSubId) await sideSend(JSON.stringify(['CLOSE', unreadSubId]));
  if (!topics.length) { unreadSubId = null; return; }
  unreadSubId = 'mu-' + Math.random().toString(36).slice(2);
  const since = Math.floor(Date.now() / 1000) - HISTORY_LOOKBACK_SEC;
  await sideSend(JSON.stringify(['REQ', unreadSubId, { kinds: [CHAT_KIND], '#x': topics, since, limit: 300 }]));
};

const handleSideMsg = async (msgEvent) => {
  let msg;
  try { msg = JSON.parse(msgEvent.data); } catch { return; }
  if (!Array.isArray(msg) || msg[0] !== 'EVENT' || !msg[2]) return;
  const ev = msg[2];
  if (seenInboxIds.has(ev.id)) return;
  seenInboxIds.add(ev.id);

  if (msg[1] === inboxSubId) {
    if (!myId) return;
    let envelope;
    try { envelope = JSON.parse(ev.content); } catch { return; }
    const payload = await CID.openInboxEnvelope(myId.privateKey, envelope);
    if (!payload) return;
    let existingFp = null;
    try { existingFp = await CID.fingerprint(payload.pub); } catch (_) {}
    if (existingFp && CID.getContacts().some((c) => c.fp === existingFp)) {
      try {
        await CID.addContact(payload);
        if (currentDmContact && currentDmContact.fp === existingFp) {
          const fresh = freshContact(existingFp);
          if (fresh) currentDmContact = fresh;
        }
        renderContacts();
        updatePushStatus();
      } catch (_) {}
      return;
    }
    const saved = await CID.saveRequest(payload);
    if (saved) {
      renderContacts();
      sys(`${saved.name || 'someone'} wants to connect — accept them in your people list.`);
      playPing(660);
    }
    return;
  }

  if (msg[1] === unreadSubId) {
    const tag = (ev.tags || []).find((t) => t && t[0] === 'x');
    const fp = tag && topicToFp.get(tag[1]);
    if (!fp) return;
    let content;
    try { content = JSON.parse(ev.content); } catch { return; }
    const ts = (content && typeof content.ts === 'number') ? content.ts : (ev.created_at || 0) * 1000;
    if (currentDmContact && currentDmContact.fp === fp) {
      const seen = unreadMap[fp] || { n: 0, lastTs: 0 };
      seen.n = 0;
      seen.lastTs = Math.max(seen.lastTs || 0, ts, Date.now());
      unreadMap[fp] = seen;
      try { CID.setUnread(unreadMap); } catch (_) {}
      return;
    }
    if (content && typeof content.cmid === 'string') {
      if (content.cmid.startsWith(selfId + ':')) return;
      if (sentCmidsFor(fp).includes(content.cmid)) return;
    }
    const entry = unreadMap[fp] || { n: 0, lastTs: 0 };
    if (ts <= entry.lastTs) return;
    entry.n = (entry.n || 0) + 1;
    unreadMap[fp] = entry;
    try { CID.setUnread(unreadMap); } catch (_) {}
    renderContacts();
    syncOsBadge();
  }
};

const clearUnreadFor = (fp) => {
  unreadMap[fp] = { n: 0, lastTs: Date.now() };
  try { CID.setUnread(unreadMap); } catch (_) {}
  syncOsBadge();
};

const hasRoomHash = () => {
  const h = window.location.hash;
  return !!(h && h !== '#' && h.length > 2);
};

const refreshIdUI = () => {
  const state = CID.idState();
  const guest = hasRoomHash();
  if ((state === 'none' || state === 'unavailable') && !guest && !onboardDone) onboardActive = true;
  els.onboard.hidden = !onboardActive;
  if (onboardActive && !cryptoOk()) showOnboardStep('insecure');
  els.idLocked.hidden = state !== 'locked' || onboardActive;
  if (state === 'locked' && !onboardActive) updateLockWaiting();
  els.app.hidden = onboardActive || (state === 'locked' && !guest);
  els.idOn.hidden = state !== 'unlocked';
  els.idNone.hidden = state === 'unlocked' || !guest;
  els.idPasskey.hidden = state !== 'locked' || !(window.MentriaIdentity && MentriaIdentity.hasPasskey());
  els.lockAlt.open = state === 'locked' && !(window.MentriaIdentity && MentriaIdentity.hasPasskey());
  els.contacts.hidden = state !== 'unlocked';
  if (state !== 'unlocked') els.idCard.hidden = true;
};

const refreshNotifBanner = () => {
  const dismissed = !!(window.MentriaStore && MentriaStore.get('comms', 'notif_dismissed'));
  const unlocked = CID.idState() === 'unlocked';
  const supported = !!(window.MentriaPush && MentriaPush.isSupported());
  const isIosBrowser = /iPhone|iPad|iPod/.test(navigator.userAgent) && !navigator.standalone;
  if (unlocked && !dismissed && !supported && isIosBrowser) {
    els.notif.querySelector('.comms__notif-text').textContent = 'to get message notifications on iPhone, install comms: share button → add to home screen';
    els.notifEnable.hidden = true;
    els.notif.hidden = false;
    return;
  }
  els.notifEnable.hidden = false;
  const show = supported && MentriaPush.permission() === 'default' && unlocked && !dismissed;
  els.notif.hidden = !show;
};

els.notifDismiss.addEventListener('click', () => {
  try { MentriaStore.set('comms', 'notif_dismissed', true); } catch (_) {}
  els.notif.hidden = true;
});

els.notifEnable.addEventListener('click', async () => {
  els.notifEnable.disabled = true;
  try {
    const ok = await MentriaPush.requestPermission();
    if (ok) {
      await initRingToken();
      const contacts = CID.getContacts();
      for (const c of contacts) { try { await announceToContact(c); } catch (_) {} }
      sys('notifications on — your contacts can now reach you when comms is closed.');
    } else {
      sys('notifications stayed off. you can enable them from your browser settings later.');
    }
  } finally {
    els.notifEnable.disabled = false;
    refreshNotifBanner();
  }
});

const initRingToken = async () => {
  if (!window.MentriaPush || !MentriaPush.isSupported() || MentriaPush.permission() !== 'granted') return;
  let token = window.MentriaStore && MentriaStore.get('comms', 'ring_token');
  if (!token || !/^[A-Za-z0-9_-]{20,64}$/.test(token)) {
    const bytes = crypto.getRandomValues(new Uint8Array(18));
    token = btoa(String.fromCharCode(...bytes)).replaceAll('+', '-').replaceAll('/', '_').replaceAll('=', '');
  }
  const ok = await MentriaPush.ringRegister(token);
  if (ok) {
    ringToken = token;
    if (window.MentriaStore) MentriaStore.set('comms', 'ring_token', token);
    refreshMyCode();
    broadcastProfile();
    try {
      const announced = MentriaStore.get('comms', 'ring_announced');
      if (announced !== token) {
        const contacts = CID.getContacts();
        await Promise.all(contacts.map((c) => announceToContact(c).catch(() => {})));
        MentriaStore.set('comms', 'ring_announced', token);
      }
    } catch (_) {}
  }
  updatePushStatus();
};

const freshContact = (fp) => CID.getContacts().find((x) => x.fp === fp) || null;

const maybeRingContact = () => {
  if (!currentDmContact || peers.size > 0) return;
  const fresh = freshContact(currentDmContact.fp);
  const ring = (fresh && fresh.ring) || currentDmContact.ring;
  if (fresh) currentDmContact = fresh;
  if (!ring) { noticeNoToken(); return; }
  if (Date.now() - lastRingSentAt < 30000) return;
  lastRingSentAt = Date.now();
  if (window.MentriaPush && MentriaPush.ring) {
    MentriaPush.ring(ring, 'comms-msg').then((res) => {
      const ok = !!(res && res.ok);
      try { MentriaStore.set('comms', 'last_knock', { t: Date.now(), ok, reason: (res && res.reason) || null }); } catch (_) {}
      if (!ok && res && res.reason === 'unknown-token' && currentDmContact) {
        sys(`${currentDmContact.name || 'they'} can't be reached by notification — their device needs to reopen comms once.`);
      }
    });
  }
};

let noTokenNoticeShown = false;
const noticeNoToken = () => {
  if (noTokenNoticeShown || !currentDmContact) return;
  noTokenNoticeShown = true;
  sys(`${currentDmContact.name || 'they'} can't be notified yet — they haven't enabled notifications on their device.`);
};

const syncOsBadge = async () => {
  let total = 0;
  for (const fp of Object.keys(unreadMap)) total += (unreadMap[fp] && unreadMap[fp].n) || 0;
  try { window.dispatchEvent(new CustomEvent('mentria:comms:unread', { detail: { total } })); } catch (_) {}
  try {
    if (window.MentriaPushDB) MentriaPushDB.kvSet('comms-msg-count', total).catch(() => {});
    if (total > 0) {
      if (navigator.setAppBadge) await navigator.setAppBadge(total);
      return;
    }
    if (navigator.clearAppBadge) await navigator.clearAppBadge();
    if ('serviceWorker' in navigator) {
      const reg = await navigator.serviceWorker.ready;
      const notes = await reg.getNotifications();
      notes.forEach((note) => {
        if (note.tag === 'comms-msg' || note.tag === 'comms-ring') note.close();
      });
    }
  } catch (_) {}
};

document.addEventListener('visibilitychange', () => {
  if (!document.hidden) {
    syncOsBadge();
    if (myId && !sideWs) ensureSideSocket();
  }
});

if (navigator.serviceWorker) {
  navigator.serviceWorker.addEventListener('message', (e) => {
    const d = e && e.data;
    if (!d || !d.type) return;
    if (d.type === 'comms-unread') {
      updateLockWaiting();
      if (window.MentriaCommsNav) MentriaCommsNav.refresh();
    } else if (d.type === 'push-resubscribed') {
      MentriaStore.remove('comms', 'ring_announced');
      initRingToken();
    }
  });
}

