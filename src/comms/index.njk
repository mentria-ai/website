const broadcastProfile = () => sendProfileTo(null);

let onboardDone = false;
let onboardActive = false;

const INBOX_KIND = 3839;
const INBOX_LOOKBACK_SEC = 14 * 24 * 60 * 60;
let sideWs = null;
let sideOpen = null;
let inboxSubId = null;
let unreadSubId = null;
let myInboxTopic = null;
const topicToFp = new Map();
const seenInboxIds = new Set();
let unreadMap = {};

const ensureSideSocket = () => {
  if (sideWs && sideWs.readyState === 1) return Promise.resolve(sideWs);
  if (sideOpen) return sideOpen;
  sideOpen = new Promise((resolve) => {
    let ws;
    try { ws = new WebSocket(RELAY); } catch (_) { sideOpen = null; resolve(null); return; }
    const done = (val) => { sideOpen = null; resolve(val); };
    ws.addEventListener('open', () => { sideWs = ws; done(ws); });
    ws.addEventListener('error', () => { done(null); });
    ws.addEventListener('close', () => { if (sideWs === ws) sideWs = null; });
    ws.addEventListener('message', handleSideMsg);
  });
  return sideOpen;
};

const sideSend = async (str) => {
  const ws = await ensureSideSocket();
  if (!ws || ws.readyState !== 1) return false;
  try { ws.send(str); return true; } catch (_) { return false; }
};

const publishToInbox = async (theirPub, payload) => {
  try {
    const env = await CID.sealToInbox(theirPub, payload);
    const topic = await CID.inboxTopic(theirPub);
    const evt = await createPersistentEvent(INBOX_KIND, topic, JSON.stringify(env));
    let sent = await sideSend(evt);
    const sockets = getRelaySockets() || {};
    for (const ws of Object.values(sockets)) {
      if (ws && ws.readyState === 1) { try { ws.send(evt); sent = true; } catch (_) {} }
    }
    return sent;
  } catch (_) { return false; }
};

const announceToContact = async (contact) => {
  if (!myId || !contact || !contact.pub) return;
  const payload = { v: 1, name: (myProfile && myProfile.name) || '', pub: { x: myId.publicJwk.x, y: myId.publicJwk.y } };
  if (ringToken) payload.ring = ringToken;
  await publishToInbox(contact.pub, payload);
};

const subscribeInbox = async () => {
  if (!myId) return;
  myInboxTopic = await CID.inboxTopic(myId.publicJwk);
  inboxSubId = 'mi-' + Math.random().toString(36).slice(2);
  const since = Math.floor(Date.now() / 1000) - INBOX_LOOKBACK_SEC;
  await sideSend(JSON.stringify(['REQ', inboxSubId, { kinds: [INBOX_KIND], '#x': [myInboxTopic], since, limit: 50 }]));
};

const subscribeUnread = async () => {
  if (!myId) return;
  const contacts = CID.getContacts();
  topicToFp.clear();
  const topics = [];
  for (const c of contacts) {
    try {
      const { roomName } = await CID.deriveDm(myId.privateKey, c.pub);
      const topic = CHAT_TOPIC_PREFIX + roomName;
      topicToFp.set(topic, c.fp);
      topics.push(topic);
    } catch (_) {}
  }
  if (unreadSubId) await sideSend(JSON.stringify(['CLOSE', unreadSubId]));
  if (!topics.length) { unreadSubId = null; return; }
  unreadSubId = 'mu-' + Math.random().toString(36).slice(2);
  const since = Math.floor(Date.now() / 1000) - HISTORY_LOOKBACK_SEC;
  await sideSend(JSON.stringify(['REQ', unreadSubId, { kinds: [CHAT_KIND], '#x': topics, since, limit: 300 }]));
};

const handleSideMsg = async (msgEvent) => {
  let msg;
  try { msg = JSON.parse(msgEvent.data); } catch { return; }
  if (!Array.isArray(msg) || msg[0] !== 'EVENT' || !msg[2]) return;
  const ev = msg[2];
  if (seenInboxIds.has(ev.id)) return;
  seenInboxIds.add(ev.id);

  if (msg[1] === inboxSubId) {
    if (!myId) return;
    let envelope;
    try { envelope = JSON.parse(ev.content); } catch { return; }
    const payload = await CID.openInboxEnvelope(myId.privateKey, envelope);
    if (!payload) return;
    const saved = await CID.saveRequest(payload);
    if (saved) {
      renderContacts();
      sys(`${saved.name || 'someone'} wants to connect — accept them in your people list.`);
      playPing(660);
    }
    return;
  }

  if (msg[1] === unreadSubId) {
    const tag = (ev.tags || []).find((t) => t && t[0] === 'x');
    const fp = tag && topicToFp.get(tag[1]);
    if (!fp) return;
    if (currentDmContact && currentDmContact.fp === fp) return;
    let content;
    try { content = JSON.parse(ev.content); } catch { return; }
    if (content && typeof content.cmid === 'string' && content.cmid.startsWith(selfId + ':')) return;
    const ts = (content && typeof content.ts === 'number') ? content.ts : (ev.created_at || 0) * 1000;
    const entry = unreadMap[fp] || { n: 0, lastTs: 0 };
    if (ts <= entry.lastTs) return;
    entry.n = (entry.n || 0) + 1;
    unreadMap[fp] = entry;
    try { CID.setUnread(unreadMap); } catch (_) {}
    renderContacts();
    bumpUnread();
  }
};

const clearUnreadFor = (fp) => {
  unreadMap[fp] = { n: 0, lastTs: Date.now() };
  try { CID.setUnread(unreadMap); } catch (_) {}
};

const hasRoomHash = () => {
  const h = window.location.hash;
  return !!(h && h !== '#' && h.length > 2);
};

const refreshIdUI = () => {
  const state = CID.idState();
  const guest = hasRoomHash();
  if ((state === 'none' || state === 'unavailable') && !guest && !onboardDone) onboardActive = true;
  els.onboard.hidden = !onboardActive;
  els.idLocked.hidden = state !== 'locked' || onboardActive;
  els.app.hidden = onboardActive || (state === 'locked' && !guest);
  els.idOn.hidden = state !== 'unlocked';
  els.idNone.hidden = state === 'unlocked' || !guest;
  els.idPasskey.hidden = state !== 'locked' || !(window.MentriaIdentity && MentriaIdentity.hasPasskey());
  els.lockAlt.open = state === 'locked' && !(window.MentriaIdentity && MentriaIdentity.hasPasskey());
  els.contacts.hidden = state !== 'unlocked';
  if (state !== 'unlocked') els.idCard.hidden = true;
};

const initRingToken = async () => {
  if (!window.MentriaPush || !MentriaPush.isSupported() || MentriaPush.permission() !== 'granted') return;
  let token = window.MentriaStore && MentriaStore.get('comms', 'ring_token');
  if (!token || !/^[A-Za-z0-9_-]{20,64}$/.test(token)) {
    const bytes = crypto.getRandomValues(new Uint8Array(18));
    token = btoa(String.fromCharCode(...bytes)).replaceAll('+', '-').replaceAll('/', '_').replaceAll('=', '');
  }
  const ok = await MentriaPush.ringRegister(token);
  if (ok) {
    ringToken = token;
    if (window.MentriaStore) MentriaStore.set('comms', 'ring_token', token);
    refreshMyCode();
    broadcastProfile();
  }
};

const maybeRingContact = () => {
  if (!currentDmContact || !currentDmContact.ring || peers.size > 0) return;
  if (Date.now() - lastRingSentAt < 30000) return;
  lastRingSentAt = Date.now();
  if (window.MentriaPush && MentriaPush.ring) {
    MentriaPush.ring(currentDmContact.ring).then((ok) => {
      if (ok) sys(`${currentDmContact.name || 'they'} seem${currentDmContact.name ? 's' : ''} offline — sent a wake-up ping to their device.`);
    });
  }
};

const bumpUnread = () => {
  if (!document.hidden) return;
  unreadCount++;
  if (navigator.setAppBadge) { try { navigator.setAppBadge(unreadCount); } catch {} }
};
document.addEventListener('visibilitychange', () => {
  if (!document.hidden && unreadCount) {
    unreadCount = 0;
    if (navigator.clearAppBadge) { try { navigator.clearAppBadge(); } catch {} }
  }
});

const initIdentity = async () => {
  try {
    myId = await CID.ensureKeypair();
    myFp = await CID.fingerprint(myId.publicJwk);
    myProfile = CID.getProfile();
    els.idName.value = myProfile.name;
    els.idFp.textContent = myFp;
    refreshIdUI();
    try { unreadMap = CID.getUnread(); } catch (_) { unreadMap = {}; }
    renderContacts();
    broadcastProfile();
    initRingToken();
    subscribeInbox();
    subscribeUnread();
  } catch (err) {
    sys('identity error: ' + err.message);
  }
};

els.idUnlock.addEventListener('click', async () => {
  els.idErr.textContent = '';
  els.idUnlock.disabled = true;
  try {
    await window.MentriaIdentity.unlock(els.idPass.value);
    els.idPass.value = '';
    await initIdentity();
  } catch {
    els.idErr.textContent = 'wrong passphrase';
  } finally {
    els.idUnlock.disabled = false;
  }
});
els.idPass.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); els.idUnlock.click(); } });

els.idPasskey.addEventListener('click', async () => {
  els.idErr.textContent = '';
  els.idPasskey.disabled = true;
  try {
    await window.MentriaIdentity.unlockWithPasskey();
    await initIdentity();
  } catch {
    els.idErr.textContent = 'passkey unlock failed — use your passphrase';
  } finally {
    els.idPasskey.disabled = false;
  }
});

els.idName.addEventListener('change', () => {
  myProfile = CID.setProfile({ name: els.idName.value });
  els.idName.value = myProfile.name;
  broadcastProfile();
  refreshMyCode();
});

const refreshMyCode = () => {
  if (els.idCard.hidden || !myId) return;
  const code = CID.encodeContactCode(myProfile, myId.publicJwk, ringToken);
  els.idCode.textContent = code;
  try {
    const qr = qrcodegen.QrCode.encodeText(code, qrcodegen.QrCode.Ecc.LOW);
    const border = 2, px = 4, dim = qr.size + border * 2;
    els.idQr.width = dim * px; els.idQr.height = dim * px;
    const ctx = els.idQr.getContext('2d');
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, els.idQr.width, els.idQr.height);
    ctx.fillStyle = '#000000';
    for (let y = 0; y < qr.size; y++) {
      for (let x = 0; x < qr.size; x++) {
        if (qr.getModule(x, y)) ctx.fillRect((x + border) * px, (y + border) * px, px, px);
      }
    }
  } catch {}
};

els.idShare.addEventListener('click', () => {
  els.idCard.hidden = !els.idCard.hidden;
  els.idShare.setAttribute('aria-expanded', String(!els.idCard.hidden));
  refreshMyCode();
});

els.idCopy.addEventListener('click', async () => {
  try {
    await navigator.clipboard.writeText(els.idCode.textContent);
    els.idCopy.textContent = 'copied';
    setTimeout(() => { els.idCopy.textContent = 'copy code'; }, 1200);
  } catch {}
});

els.idContacts.addEventListener('click', () => {
  els.contacts.hidden = !els.contacts.hidden;
  els.idContacts.setAttribute('aria-expanded', String(!els.contacts.hidden));
  renderContacts();
});

const renderContacts = () => {
  if (!els.contactList) return;
  els.contactList.innerHTML = '';

  const requests = CID.getRequests();
  requests.forEach((r) => {
    const row = document.createElement('div');
    row.className = 'comms__contact comms__contact--req';
    const name = document.createElement('span');
    name.className = 'comms__contact-name';
    name.textContent = (r.name || '(unnamed)') + ' wants to connect';
    const fp = document.createElement('span');
    fp.className = 'comms__contact-fp';
    fp.textContent = r.fp;
    const spacer = document.createElement('span');
    spacer.className = 'comms__contact-spacer';
    const ok = document.createElement('button');
    ok.type = 'button';
    ok.className = 'comms__btn';
    ok.textContent = 'accept';
    ok.addEventListener('click', async () => {
      try {
        const added = await CID.addContact(r);
        CID.dropRequest(r.fp);
        renderContacts();
        subscribeUnread();
        if (added) announceToContact(added);
        sys(`${added && added.name ? added.name : 'contact'} added — you can message each other now.`);
      } catch (err) {
        sys('could not accept: ' + err.message);
      }
    });
    const no = document.createElement('button');
    no.type = 'button';
    no.className = 'comms__btn comms__btn--ghost';
    no.textContent = 'ignore';
    no.addEventListener('click', () => { CID.dropRequest(r.fp); renderContacts(); });
    row.append(name, fp, spacer, ok, no);
    els.contactList.append(row);
  });

  const contacts = CID.getContacts();
  if (!contacts.length && !requests.length) {
    const empty = document.createElement('div');
    empty.className = 'comms__id-note';
    empty.textContent = 'no one here yet — tap “my code” to share yours, or paste someone else\'s code below.';
    els.contactList.append(empty);
    return;
  }
  contacts.forEach((c) => {
    const row = document.createElement('div');
    row.className = 'comms__contact';
    const name = document.createElement('span');
    name.className = 'comms__contact-name';
    name.textContent = c.name || '(unnamed)';
    const unread = (unreadMap[c.fp] && unreadMap[c.fp].n) || 0;
    if (unread > 0) {
      const badge = document.createElement('span');
      badge.className = 'comms__unread';
      badge.textContent = unread > 99 ? '99+' : String(unread);
      badge.title = unread + ' unread';
      name.append(' ', badge);
    }
    const fp = document.createElement('span');
    fp.className = 'comms__contact-fp';
    fp.textContent = c.fp;
    const spacer = document.createElement('span');
    spacer.className = 'comms__contact-spacer';
    const dm = document.createElement('button');
    dm.type = 'button';
    dm.className = 'comms__btn comms__btn--ghost';
    dm.textContent = 'message';
    dm.addEventListener('click', async () => {
      if (!myId) return;
      try {
        const { roomName, b64Key } = await CID.deriveDm(myId.privateKey, c.pub);
        els.room.value = roomName;
        clearUnreadFor(c.fp);
        renderContacts();
        await joinNew(roomName, b64Key, { share: false });
        currentDmContact = c;
        sys(`private room with ${c.name || c.fp} — only your two identities can derive it.`);
      } catch (err) {
        sys('could not derive DM room: ' + err.message);
      }
    });
    const rm = document.createElement('button');
    rm.type = 'button';
    rm.className = 'comms__btn comms__btn--ghost';
    rm.textContent = 'remove';
    rm.addEventListener('click', async () => {
      const ok = await (typeof mentriaConfirm === 'function' ? mentriaConfirm('Remove ' + (c.name || c.fp) + ' from contacts?') : Promise.resolve(true));
      if (!ok) return;
      CID.removeContact(c.fp);
      renderContacts();
      renderPeerList();
    });
    row.append(name, fp, spacer, dm, rm);
    els.contactList.append(row);
  });
};

els.contactAdd.addEventListener('click', async () => {
  try {
    const payload = CID.decodeContactCode(els.contactIn.value);
    const saved = await CID.addContact(payload);
    els.contactIn.value = '';
    renderContacts();
    subscribeUnread();
    const reached = await announceToContact(saved);
    sys(reached
      ? `contact added: ${saved.name || saved.fp} — they'll see your request next time they open comms.`
      : `contact added: ${saved.name || saved.fp}`);
  } catch (err) {
    sys('could not add contact: ' + err.message);
  }
});
els.contactIn.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); els.contactAdd.click(); } });

const RECOVERY_ALPHA = 'abcdefghjkmnpqrstuvwxyz23456789';
const makeRecoveryCode = () => {
  const bytes = crypto.getRandomValues(new Uint8Array(20));
  let out = '';
  for (let i = 0; i < 20; i++) {
    if (i && i % 5 === 0) out += '-';
    out += RECOVERY_ALPHA[bytes[i] % RECOVERY_ALPHA.length];
  }
  return out;
};

const showOnboardStep = (which) => {
  els.obIntro.hidden = which !== 'intro';
  els.obForm.hidden = which !== 'form';
  els.obDone.hidden = which !== 'done';
};

els.obStart.addEventListener('click', () => {
  showOnboardStep('form');
  els.obName.focus();
});

els.obName.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); els.obCreate.click(); } });

const setOnboardMethod = (ok) => {
  els.obMethod.textContent = ok
    ? 'Your device lock now unlocks comms — no password to remember.'
    : 'This device can\'t use a passkey for encryption yet, so your recovery code is how you unlock.';
  els.obPasskey.hidden = ok;
};

els.obCreate.addEventListener('click', async () => {
  const name = (els.obName.value || '').trim().slice(0, 32);
  if (!name) { els.obErr.hidden = false; els.obErr.textContent = 'pick a name first — it\'s only shared with people you add.'; els.obName.focus(); return; }
  els.obErr.hidden = true;
  els.obCreate.disabled = true;
  const prevLabel = els.obCreate.textContent;
  els.obCreate.textContent = 'setting up…';
  try {
    const code = makeRecoveryCode();
    await window.MentriaIdentity.setup(code);
    CID.setProfile({ name });
    let passkeyOk = false;
    try { await window.MentriaIdentity.enrollPasskey(); passkeyOk = true; } catch (_) { passkeyOk = false; }
    els.obCode.textContent = code;
    setOnboardMethod(passkeyOk);
    showOnboardStep('done');
    await initIdentity();
  } catch (err) {
    els.obErr.hidden = false;
    els.obErr.textContent = 'could not set up: ' + (err && err.message ? err.message : err);
  } finally {
    els.obCreate.disabled = false;
    els.obCreate.textContent = prevLabel;
  }
});

els.obPasskey.addEventListener('click', async () => {
  els.obPasskey.disabled = true;
  try {
    await window.MentriaIdentity.enrollPasskey();
    setOnboardMethod(true);
  } catch (err) {
    const code = err && err.message;
    els.obMethod.textContent = code === 'prf-unsupported'
      ? 'This device can\'t use a passkey for encryption yet, so your recovery code is how you unlock.'
      : 'That didn\'t work — your recovery code still unlocks everything. You can try again in identity settings.';
    els.obPasskey.hidden = true;
  } finally {
    els.obPasskey.disabled = false;
  }
});

els.obCopy.addEventListener('click', async () => {
  try {
    await navigator.clipboard.writeText(els.obCode.textContent || '');
    els.obCopy.textContent = 'copied';
    setTimeout(() => { els.obCopy.textContent = 'copy code'; }, 1600);
  } catch (_) {}
});

els.obContinue.addEventListener('click', () => {
  onboardDone = true;
  onboardActive = false;
  refreshIdUI();
  if (!hasRoomHash()) els.contactIn.focus();
});

els.setupHere.addEventListener('click', () => {
  onboardDone = false;
  onboardActive = true;
  refreshIdUI();
  showOnboardStep('intro');
  els.onboard.scrollIntoView({ block: 'center', behavior: 'smooth' });
});

els.advToggle.addEventListener('click', () => {
  const open = els.adv.hidden;
  els.adv.hidden = !open;
  els.advToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  if (open) els.adv.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
});

els.newRoom.addEventListener('click', async () => {
  const name = EPHEMERAL_PREFIX + randomRoomSlug();
  const key = b64urlEncode(crypto.getRandomValues(new Uint8Array(32)));
  els.room.value = name;
  await joinNew(name, key);
  try {
    await navigator.clipboard.writeText(window.location.href);
    els.newRoom.textContent = 'link copied';
    setTimeout(() => { els.newRoom.textContent = 'new room link'; }, 2000);
  } catch (_) {}
});

refreshIdUI();
if (CID.idState() === 'unlocked') initIdentity();
else if (CID.idState() === 'locked' && window.MentriaIdentity && MentriaIdentity.tryDeviceUnlock) {
  MentriaIdentity.tryDeviceUnlock().then((ok) => { if (ok) initIdentity(); else refreshIdUI(); });
}

function randomRoomSlug() {
  const bytes = crypto.getRandomValues(new Uint8Array(5));
  const alpha = 'abcdefghijklmnopqrstuvwxyz234567';
  let bits = 0, value = 0, out = '';
  for (let i = 0; i < bytes.length; i++) {
    value = (value << 8) | bytes[i]; bits += 8;
    while (bits >= 5) { out += alpha[(value >>> (bits - 5)) & 0x1f]; bits -= 5; }
  }
  return out;
}

const bootHash = window.location.hash && window.location.hash !== '#' ? parseHash(window.location.hash) : null;
if (bootHash && isDmRoom(bootHash.room)) {
  window.history.replaceState(null, '', window.location.pathname + window.location.search);
}
const hasHash = !!bootHash && !isDmRoom(bootHash.room);
if (hasHash) {
  const parsed = bootHash;
  els.room.value = parsed.room;
  refreshShareUrl(parsed.room, parsed.b64Key);
  window.addEventListener('load', () => joinNew(parsed.room, parsed.b64Key));
} else {
  window.addEventListener('load', () => {
    if (CID.idState() === 'unlocked') sys('pick someone below to start a private chat — or open ⚙ for a shareable room link.');
  });
}
window.addEventListener('hashchange', () => {
  const next = parseHash(window.location.hash);
  if (isDmRoom(next.room)) {
    window.history.replaceState(null, '', window.location.pathname + window.location.search);
    refreshIdUI();
    return;
  }
  const sameRoom = next.room === (els.room.value || '').trim();
  const sameKey = next.b64Key === (chatKey ? next.b64Key : null);
  if (!sameRoom || !sameKey) {
    els.room.value = next.room;
    joinNew(next.room, next.b64Key);
  }
  refreshIdUI();
});
</script>
