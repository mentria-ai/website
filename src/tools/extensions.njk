---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/tools/extensions/index.html"
eleventyComputed:
  lang: "{{ locale.code }}"
  title: "{{ 'tools.extensions.title' | t }}"
  description: "{{ 'tools.extensions.lede' | t }}"
---
<section class="hero" style="padding-top:1rem;">
  <p class="eyebrow eyebrow--crumbs"><a class="eyebrow__link" href="{{ locale.pathPrefix }}/">~</a><span class="eyebrow__sep">/</span><a class="eyebrow__link" href="{{ locale.pathPrefix }}/tools/">tools</a><span class="eyebrow__sep">/</span><span class="eyebrow__current">extensions</span></p>
  <h1>{{ "tools.extensions.title" | t }}</h1>
  <p>{{ "tools.extensions.lede" | t }}</p>
  {% include "tldr.njk" %}
  <p style="margin-top:0.85rem;font-family:var(--font-mono);font-size:0.85rem;"><a href="{{ locale.pathPrefix }}/tools/extensions/sdk/">{{ "tools.extensions-sdk.title" | t }} →</a></p>
</section>

{% set terminalTitle = "extensions.js" %}
{% include "terminal-frame-open.njk" %}
<section class="xt">
  <h2 class="xt__heading">{{ "tool.ext_gallery.title" | t }}</h2>
  <p class="xt__lede">{{ "tool.ext_gallery.lede" | t }}</p>
  <div class="exg" id="exg-grid"></div>

  <h2 class="xt__heading">{{ "tool.extensions.install_heading" | t }}</h2>
  <div class="xt__drop" id="xt-drop">
    <input type="file" id="xt-file" accept=".html,text/html" hidden>
    <span class="xt__drop-hint">{{ "tool.extensions.drop_hint" | t }}</span>
    <button type="button" class="xt__btn xt__btn--small xt__choose" id="xt-choose">{{ "tool.extensions.choose_file" | t }}</button>
  </div>
  <details class="xt__paste">
    <summary>{{ "tool.extensions.paste_hint" | t }}</summary>
    <textarea id="xt-paste" rows="6" spellcheck="false"></textarea>
    <button class="xt__btn" id="xt-paste-install" type="button">{{ "tool.extensions.btn_install" | t }}</button>
  </details>
  <p class="xt__error" id="xt-error" hidden></p>

  <h2 class="xt__heading">{{ "tool.extensions.installed_heading" | t }}</h2>
  <div class="xt__list" id="xt-list"></div>
  <p class="xt__empty" id="xt-empty">{{ "tool.extensions.empty_list" | t }}</p>

  <h2 class="xt__heading">{{ "tool.extensions.sample_heading" | t }}</h2>
  <div class="xt__sample">
    <button class="xt__btn" id="xt-sample-install" type="button">{{ "tool.extensions.sample_install" | t }}</button>
    <a class="xt__link" href="/assets/extensions/hello-world.html" download="hello-world.html">{{ "tool.extensions.sample_download" | t }}</a>
  </div>
</section>
{% include "terminal-frame-close.njk" %}

{% include "tool-schema.njk" %}

<script type="module">
const COPY = {
  trustPrompt:   {{ ("tool.extensions.trust_prompt"   | t) | dump | safe }},
  updatePrompt:  {{ ("tool.extensions.update_prompt"  | t) | dump | safe }},
  downgradePrompt: {{ ("tool.extensions.downgrade_prompt" | t) | dump | safe }},
  permsAdded:    {{ ("tool.extensions.update_perms_added" | t) | dump | safe }},
  permsRemoved:  {{ ("tool.extensions.update_perms_removed" | t) | dump | safe }},
  confirmRemove: {{ ("tool.extensions.confirm_remove" | t) | dump | safe }},
  installedOk:   {{ ("tool.extensions.installed_ok"   | t) | dump | safe }},
  errPrefix:     {{ ("tool.extensions.err_prefix"     | t) | dump | safe }},
  btnOpen:       {{ ("tool.extensions.btn_open"       | t) | dump | safe }},
  btnExport:     {{ ("tool.extensions.btn_export"     | t) | dump | safe }},
  btnRemove:     {{ ("tool.extensions.btn_remove"     | t) | dump | safe }},
  btnShare:      {{ ("tool.extensions.btn_share"      | t) | dump | safe }},
  shareOk:       {{ ("tool.extensions.share_ok"       | t) | dump | safe }},
  shareOpenComms:{{ ("tool.extensions.share_open_comms"| t) | dump | safe }},
  toggleLabel:   {{ ("tool.extensions.toggle_label"   | t) | dump | safe }},
  galInstall:    {{ ("tool.ext_gallery.btn_install" | t) | dump | safe }},
  galInstalled:  {{ ("tool.ext_gallery.installed"   | t) | dump | safe }},
  galOpen:       {{ ("tool.ext_gallery.btn_open"    | t) | dump | safe }},
  galErrLoad:    {{ ("tool.ext_gallery.err_load"    | t) | dump | safe }}
};
const CATALOG = [
  { id: "unit-converter", desc: {{ ("tool.ext_gallery.desc.unit-converter" | t) | dump | safe }} },
  { id: "pomodoro-timer", desc: {{ ("tool.ext_gallery.desc.pomodoro-timer" | t) | dump | safe }} },
  { id: "dice-roller",    desc: {{ ("tool.ext_gallery.desc.dice-roller"    | t) | dump | safe }} },
  { id: "image-gen",      desc: {{ ("tool.ext_gallery.desc.image-gen"      | t) | dump | safe }} }
];

const PREFIX = {{ locale.pathPrefix | dump | safe }};
const X = await import('/assets/js/mentria-extensions.js');
const { confirmInstall } = await import('/assets/js/mentria-ext-install-ui.js');
const { MentriaBus } = await import('/assets/js/mentria-bus.js');
const drop = document.getElementById('xt-drop');
const fileInput = document.getElementById('xt-file');
const chooseBtn = document.getElementById('xt-choose');
const pasteTa = document.getElementById('xt-paste');
const errEl = document.getElementById('xt-error');
const listEl = document.getElementById('xt-list');
const emptyEl = document.getElementById('xt-empty');

function showError(msg) { errEl.classList.remove('xt__error--ok'); errEl.textContent = COPY.errPrefix + ' ' + msg; errEl.hidden = false; }
function showOk(msg) { errEl.classList.add('xt__error--ok'); errEl.textContent = msg; errEl.hidden = false; }
function clearError() { errEl.hidden = true; }

function fmt(tpl, vars) {
  return tpl.replace(/\{(\w+)\}/g, (s, k) => (vars[k] != null ? vars[k] : s));
}

async function installFlow(html) {
  clearError();
  try {
    const entry = await confirmInstall(html, { copy: { trust: COPY.trustPrompt, update: COPY.updatePrompt, downgrade: COPY.downgradePrompt, permsAdded: COPY.permsAdded, permsRemoved: COPY.permsRemoved } });
    if (!entry) return;
    showOk(entry.manifest.name + ' ' + COPY.installedOk);
    render();
  } catch (e) { showError(e.message); }
}

function row(entry) {
  const m = entry.manifest;
  const div = document.createElement('div');
  div.className = 'xt__row';
  const icon = document.createElement('span');
  icon.className = 'xt__icon';
  if (/^data:image\//.test(m.icon || '')) {
    const img = document.createElement('img'); img.src = m.icon; img.alt = ''; icon.appendChild(img);
  } else { icon.textContent = m.icon || '🧩'; }
  const meta = document.createElement('div');
  meta.className = 'xt__meta';
  const title = document.createElement('div');
  title.className = 'xt__name';
  title.textContent = m.name;
  const sub = document.createElement('div');
  sub.className = 'xt__sub';
  sub.textContent = 'v' + m.version + (m.author ? ' · ' + m.author : '');
  const perms = document.createElement('div');
  perms.className = 'xt__perms';
  perms.textContent = (m.permissions || []).join(' · ') + '  (' + Math.round(entry.size / 1024) + ' KB)';
  meta.appendChild(title); meta.appendChild(sub); meta.appendChild(perms);
  const actions = document.createElement('div');
  actions.className = 'xt__actions';
  const toggle = document.createElement('input');
  toggle.type = 'checkbox'; toggle.checked = entry.enabled;
  toggle.setAttribute('aria-label', fmt(COPY.toggleLabel, { name: m.name }));
  toggle.title = fmt(COPY.toggleLabel, { name: m.name });
  const open = btn(COPY.btnOpen, () => { location.href = PREFIX + '/tools/extensions/run/?id=' + encodeURIComponent(m.id); });
  open.disabled = !entry.enabled || !(m.mounts && m.mounts.tool);
  toggle.addEventListener('change', () => {
    X.setEnabled(m.id, toggle.checked);
    open.disabled = !toggle.checked || !(m.mounts && m.mounts.tool);
  });
  const exp = btn(COPY.btnExport, () => {
    const src = X.getSource(m.id);
    if (!src) { showError(m.id); return; }
    const blob = new Blob([src], { type: 'text/html' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob); a.download = m.id + '.html';
    document.body.appendChild(a); a.click(); URL.revokeObjectURL(a.href); a.remove();
  });
  const share = btn(COPY.btnShare, async () => {
    const src = X.getSource(m.id);
    if (!src) { showError(m.id); return; }
    if (await MentriaBus.has('comms.share')) {
      try {
        const r = await MentriaBus.invoke('comms.share', { filename: m.id + '.html', html: src, name: m.name });
        showOk(fmt(COPY.shareOk, { n: (r && r.sentTo) || 0 }));
      } catch (e) { showError(e.message); }
    } else {
      showOk(COPY.shareOpenComms);
      if (document.documentElement.classList.contains('is-standalone')) {
        setTimeout(() => { location.href = '/comms/'; }, 700);
      } else {
        window.open('/comms/', '_blank');
      }
    }
  });
  const rem = btn(COPY.btnRemove, async () => {
    if (!(await window.mentriaConfirm(fmt(COPY.confirmRemove, { name: m.name })))) return;
    X.remove(m.id); render();
  });
  actions.append(toggle, open, exp, share, rem);
  div.append(icon, meta, actions);
  return div;
}

function btn(label, fn) {
  const b = document.createElement('button');
  b.type = 'button'; b.className = 'xt__btn xt__btn--small'; b.textContent = label;
  b.addEventListener('click', fn);
  return b;
}

let refreshGallery = () => {};

function render() {
  const reg = X.getRegistry();
  listEl.innerHTML = '';
  reg.forEach((e) => listEl.appendChild(row(e)));
  emptyEl.hidden = reg.length > 0;
  refreshGallery();
}

['dragenter', 'dragover'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.add('xt__drop--hot'); }));
['dragleave', 'drop'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.remove('xt__drop--hot'); }));
drop.addEventListener('drop', (e) => {
  const f = e.dataTransfer.files && e.dataTransfer.files[0];
  if (f) f.text().then(installFlow).catch((e) => showError(e.message));
});
chooseBtn.addEventListener('click', () => fileInput.click());
drop.addEventListener('click', (e) => {
  if (e.target === fileInput || e.target === chooseBtn || chooseBtn.contains(e.target)) return;
  fileInput.click();
});
fileInput.addEventListener('change', (e) => {
  const f = e.target.files && e.target.files[0];
  if (f) f.text().then(installFlow).catch((e) => showError(e.message));
  e.target.value = '';
});
document.getElementById('xt-paste-install').addEventListener('click', () => {
  if (pasteTa.value.trim()) installFlow(pasteTa.value);
});
document.getElementById('xt-sample-install').addEventListener('click', async () => {
  try {
    const html = await fetch('/assets/extensions/hello-world.html').then((r) => r.text());
    installFlow(html);
  } catch (e) { showError(e.message); }
});

const galGrid = document.getElementById('exg-grid');
const galCards = [];

function galChip(text, mod) {
  const c = document.createElement('span');
  c.className = 'exg__chip' + (mod ? ' exg__chip--' + mod : '');
  c.textContent = text;
  return c;
}

function galStatus(card, msg) {
  card._parts.status.textContent = msg || '';
  card._parts.status.hidden = !msg;
}

function galMakeCard(entry) {
  const card = document.createElement('article');
  card.className = 'exg__card';
  card.dataset.id = entry.id;
  const head = document.createElement('div');
  head.className = 'exg__head';
  const icon = document.createElement('span');
  icon.className = 'exg__icon';
  icon.setAttribute('aria-hidden', 'true');
  const name = document.createElement('h3');
  name.className = 'exg__name';
  name.textContent = entry.id;
  head.append(icon, name);
  const desc = document.createElement('p');
  desc.className = 'exg__desc';
  desc.textContent = entry.desc;
  const badges = document.createElement('div');
  badges.className = 'exg__badges';
  const status = document.createElement('p');
  status.className = 'exg__status';
  status.setAttribute('role', 'status');
  status.hidden = true;
  const actions = document.createElement('div');
  actions.className = 'exg__actions';
  card.append(head, desc, badges, status, actions);
  card._parts = { icon, name, badges, status, actions };
  galGrid.appendChild(card);
  return card;
}

function galActions(entry, card) {
  const p = card._parts;
  p.actions.innerHTML = '';
  if (X.getEntry(entry.id)) {
    const done = document.createElement('span');
    done.className = 'exg__done';
    done.textContent = COPY.galInstalled;
    const open = document.createElement('a');
    open.className = 'xt__btn xt__btn--small exg__btn';
    open.textContent = COPY.galOpen;
    open.href = PREFIX + '/tools/extensions/run/?id=' + encodeURIComponent(entry.id);
    p.actions.append(done, open);
  } else {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'xt__btn xt__btn--small exg__btn';
    b.textContent = COPY.galInstall;
    b.addEventListener('click', () => galInstall(entry, card, b));
    p.actions.append(b);
  }
}

async function galInstall(entry, card, b) {
  galStatus(card, '');
  b.disabled = true;
  try {
    const html = entry.html || await fetch('/assets/extensions/' + entry.id + '.html').then((r) => r.text());
    const result = await confirmInstall(html, { copy: { trust: COPY.trustPrompt, update: COPY.updatePrompt, downgrade: COPY.downgradePrompt, permsAdded: COPY.permsAdded, permsRemoved: COPY.permsRemoved } });
    if (!result) { b.disabled = false; return; }
    render();
  } catch (e) {
    b.disabled = false;
    galStatus(card, e.message);
  }
}

async function galLoad(entry, card) {
  const p = card._parts;
  let html;
  try {
    html = await fetch('/assets/extensions/' + entry.id + '.html').then((r) => {
      if (!r.ok) throw new Error(String(r.status));
      return r.text();
    });
  } catch (e) {
    galStatus(card, COPY.galErrLoad);
    return;
  }
  entry.html = html;
  let ins;
  try {
    ins = X.inspect(html);
  } catch (e) {
    galStatus(card, COPY.galErrLoad + ' ' + e.message);
    return;
  }
  entry.ready = true;
  const m = ins.manifest;
  p.icon.textContent = m.icon && !/^data:/.test(m.icon) ? m.icon : '🧩';
  p.name.textContent = m.name;
  p.badges.innerHTML = '';
  p.badges.append(galChip('v' + m.version));
  if (m.author) p.badges.append(galChip(m.author));
  (m.permissions || []).forEach((perm) => p.badges.append(galChip(perm, 'perm')));
  p.badges.append(galChip(Math.max(1, Math.round(ins.size / 1024)) + ' KB'));
  galActions(entry, card);
}

refreshGallery = () => {
  galCards.forEach(({ entry, card }) => { if (entry.ready) galActions(entry, card); });
};

CATALOG.forEach((entry) => {
  const card = galMakeCard(entry);
  galCards.push({ entry, card });
  galLoad(entry, card);
});

document.addEventListener('visibilitychange', () => {
  if (document.visibilityState === 'visible') { render(); }
});
window.addEventListener('pageshow', (e) => { if (e.persisted) render(); });

render();
</script>

<style>
.xt { font-family: var(--font-mono); padding: 1rem 0.75rem; }
.xt__heading { font-size: 0.85rem; text-transform: lowercase; letter-spacing: 0.08em; color: var(--term-muted); margin: 1.2rem 0 0.6rem; }
.xt__drop { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; border: 1px dashed var(--term-border-strong, #2a3138); border-radius: 8px; padding: 1.2rem; text-align: center; color: var(--term-muted); cursor: pointer; font-size: 0.85rem; transition: border-color 0.15s, color 0.15s; }
.xt__drop-hint { margin: 0; }
.xt__drop--hot, .xt__drop:hover { border-color: var(--accent, #6ef3c5); color: var(--accent, #6ef3c5); }
.xt__paste { margin-top: 0.6rem; font-size: 0.8rem; color: var(--term-muted); }
@media (prefers-reduced-motion: no-preference) {
  .xt__paste::details-content {
    opacity: 0;
    block-size: 0;
    overflow-y: clip;
    interpolate-size: allow-keywords;
    transition: content-visibility 0.22s allow-discrete, opacity 0.22s ease, block-size 0.22s ease;
  }
  .xt__paste[open]::details-content {
    opacity: 1;
    block-size: auto;
  }
}
.xt__paste textarea { width: 100%; margin: 0.5rem 0; background: var(--term-bg-raised, #0d0f12); border: 1px solid var(--term-border, #2a3138); color: var(--term-fg); border-radius: 6px; font-family: inherit; font-size: 0.75rem; padding: 0.5rem; }
.xt__btn { background: transparent; border: 1px solid var(--accent, #6ef3c5); color: var(--accent, #6ef3c5); border-radius: 6px; padding: 0.35rem 0.9rem; font-family: inherit; font-size: 0.8rem; cursor: pointer; }
.xt__btn--small { padding: 0.2rem 0.6rem; font-size: 0.7rem; }
.xt__btn:hover { background: var(--accent, #6ef3c5); color: #0b0e11; }
.xt__btn:disabled { opacity: 0.4; cursor: not-allowed; }
.xt__error { color: var(--syn-pink, #f472b6); font-size: 0.8rem; }
.xt__error--ok { color: var(--accent, #6ef3c5); }
.xt__row { display: flex; align-items: center; flex-wrap: wrap; gap: 0.6rem 0.8rem; border: 1px solid var(--term-border, #2a3138); border-radius: 8px; padding: 0.6rem 0.8rem; margin-bottom: 0.5rem; }
.xt__icon { font-size: 1.6rem; width: 2.2rem; flex: none; text-align: center; }
.xt__icon img { width: 28px; height: 28px; }
.xt__meta { flex: 1 1 12rem; min-width: 0; }
.xt__name { font-size: 0.85rem; color: var(--term-fg); overflow-wrap: anywhere; }
.xt__sub { font-size: 0.7rem; color: var(--term-muted); overflow-wrap: anywhere; }
.xt__perms { font-size: 0.7rem; color: var(--term-muted); overflow-wrap: anywhere; }
.xt__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0.4rem; margin-left: auto; }
.xt__actions input[type="checkbox"] { margin: 0 0.2rem 0 0; flex: none; }
@media (max-width: 640px) {
  .xt__row { align-items: flex-start; }
  .xt__actions { flex-basis: 100%; margin-left: 0; padding-left: calc(2.2rem + 0.8rem); }
  .xt__btn--small { padding: 0.35rem 0.7rem; font-size: 0.75rem; }
}
@media (max-width: 400px) {
  .xt__actions { padding-left: 0; }
}
.xt__empty { color: var(--term-muted); font-size: 0.8rem; }
.xt__empty[hidden] { display: none; }
.xt__error[hidden] { display: none; }
.xt__sample { display: flex; align-items: center; flex-wrap: wrap; gap: 0.6rem 1rem; }
.xt__link { color: var(--term-muted); font-size: 0.8rem; }
.xt__lede { font-size: 0.8rem; color: var(--term-muted); margin: 0 0 0.8rem; }
.exg { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 0.8rem; margin-bottom: 0.5rem; }
.exg__card { display: flex; flex-direction: column; gap: 0.55rem; border: 1px solid var(--term-border, #2a3138); border-radius: 8px; padding: 0.8rem; }
.exg__head { display: flex; align-items: center; gap: 0.55rem; }
.exg__icon { font-size: 1.4rem; line-height: 1; }
.exg__name { font-size: 0.85rem; margin: 0; color: var(--term-fg); overflow-wrap: anywhere; }
.exg__desc { margin: 0; font-size: 0.75rem; color: var(--term-muted); line-height: 1.5; flex: 1; }
.exg__badges { display: flex; flex-wrap: wrap; gap: 0.25rem; }
.exg__chip { font-size: 0.62rem; padding: 2px 8px; border-radius: 999px; border: 1px solid var(--term-border, #2a3138); color: var(--term-muted); }
.exg__chip--perm { border-color: var(--syn-cyan, #7dd3fc); color: var(--syn-cyan, #7dd3fc); }
.exg__actions { display: flex; align-items: center; gap: 0.6rem; min-height: 1.8rem; }
.exg__btn { text-decoration: none; }
.exg__done { font-size: 0.7rem; color: var(--accent, #6ef3c5); }
.exg__status { font-size: 0.7rem; color: var(--syn-pink, #f472b6); margin: 0; }
.exg__status[hidden] { display: none; }
</style>
