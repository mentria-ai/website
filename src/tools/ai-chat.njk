  function searchUrlFor(base, query) {
    const q = encodeURIComponent(query);
    if (base.includes('{query}')) return base.replace('{query}', q);
    return base.replace(/\/+$/, '') + '/search?q=' + q + '&format=json&safesearch=1';
  }

  function mapSearchResults(data) {
    const out = [];
    for (const a of (data && data.answers) || []) {
      const text = typeof a === 'string' ? a : (a && a.answer);
      if (text) out.push({ title: 'Direct answer', url: (a && a.url) || '', snippet: String(text).slice(0, 300), answer: true });
      if (out.length >= 2) break;
    }
    for (const ib of (data && data.infoboxes) || []) {
      if (ib && ib.content) out.push({ title: String(ib.infobox || 'Info').slice(0, 120), url: (ib.id || ''), snippet: String(ib.content).slice(0, 300), answer: true });
      break;
    }
    const list = (data && (data.results || data.organic_results || data.items)) || [];
    for (const r of list) {
      if (out.length >= 8) break;
      const url = String(r.url || r.link || '');
      if (!url) continue;
      const item = {
        title: String(r.title || r.name || '').slice(0, 120),
        url,
        snippet: String(r.content || r.snippet || r.description || '').slice(0, 300)
      };
      const d = r.publishedDate || r.published_date || r.date;
      if (d) item.date = String(d).slice(0, 10);
      out.push(item);
    }
    return out;
  }

  async function runWebSearch(query, opts) {
    const cfg = getSearchCfg();
    if (!cfg || !cfg.url) throw new Error('not configured');
    const ctrl = new AbortController();
    const t = setTimeout(() => ctrl.abort(), 12000);
    try {
      const res = await fetch(searchUrlFor(cfg.url, query), { signal: ctrl.signal, headers: { 'Accept': 'application/json' } });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const results = mapSearchResults(await res.json());
      if (!results.length && !(opts && opts.allowEmpty)) throw new Error('no results');
      return results;
    } finally { clearTimeout(t); }
  }

  const SEARCH_TOOL_PROMPT = "\\n\\n# Tool: web search\\nYou can search the web with the web_search tool. The client runs your search and sends you the results in a <tool_response> message — you never need to imagine results or wait; just emit the call and stop.\\nHow to call: end your reply (after any thinking) with exactly this on its own, then stop:\\n<tool_call>{\\\"name\\\": \\\"web_search\\\", \\\"arguments\\\": {\\\"query\\\": \\\"your search terms\\\"}}</tool_call>\\nThe call must appear in your final reply, not only inside your thinking.\\nWhen to call: ALWAYS when the user asks you to search, look something up online, check a manual or documentation, or verify something on the web. Also when the answer needs current or uncertain facts: news, prices, weather, versions, schedules, results.\\nAfter a <tool_response> arrives, answer the question using those results, briefly, and mention the source domains. At most 2 searches per question.";

  const ROUTER_SYSTEM = 'You route messages for a chat assistant that has one tool, web search. Answer with exactly one word. Answer tool when the user asks to look something up, asks whether something is true or has happened, asks about current prices, news, weather, schedules, releases or anything that changes over time, or asks for facts about a specific product, place, document or organisation. Answer chat when the user wants writing, code, math, explanation of a stable concept, advice, or a reply about this conversation. Only the word.';
  const ROUTER_LABELS = ['tool', 'chat'];
  const SEARCH_ADAPTER = { name: 'aichat-search', path: 'loras/aichat-search/v1/' };
  let routerIds = null;
  let searchAdapterSpecState = null;
  let searchAdapterLoaded = false;
  let searchAdapterActive = false;

  async function routerLabelIds() {
    if (routerIds && routerIds.tier === currentTier) return routerIds;
    if (!engine || typeof engine.encodeChat !== 'function') return null;
    const messages = [{ role: 'system', content: ROUTER_SYSTEM }, { role: 'user', content: 'probe' }];
    const base = await engine.encodeChat(messages, { enableThinking: false });
    const ids = {};
    for (const label of ROUTER_LABELS) {
      const enc = await engine.encodeChat(messages, { enableThinking: false, assistantPrefix: label });
      const first = enc.ids[base.ids.length];
      if (enc.assistantPrefix && enc.assistantPrefix.boundaryMerged) return null;
      if (!Number.isInteger(first) || Object.values(ids).includes(first)) return null;
      ids[label] = first;
    }
    routerIds = { tier: currentTier, ids };
    return routerIds;
  }

  async function routeTurn(userText) {
    let r = null;
    try { r = await routerLabelIds(); } catch (_) { return null; }
    if (!r) return null;
    const allowed = ROUTER_LABELS.map((l) => r.ids[l]).sort((a, b) => a - b);
    let picked = null;
    try {
      await engine.generate({
        messages: [{ role: 'system', content: ROUTER_SYSTEM }, { role: 'user', content: String(userText || '').slice(0, 2000) }],
        maxTokens: 1, temperature: 0, topK: 1, topP: 1, repetitionPenalty: 1.0, enableThinking: false, allowedTokenIds: allowed
      }, (ev) => { if (picked == null && typeof ev.tokenId === 'number') picked = ev.tokenId; });
    } catch (_) { return null; }
    return ROUTER_LABELS.find((l) => r.ids[l] === picked) || null;
  }

