let scanStream = null;
let scanRaf = null;
let scanDetector = null;
let scanCanvas = null;
let scanCtx = null;
let scanTrack = null;
let scanFocusCaps = null;
let scanFocusBusy = false;
let scanMisses = 0;
let scanTorchOn = false;

const setupScanTrack = () => {
  scanTrack = scanStream && scanStream.getVideoTracks ? scanStream.getVideoTracks()[0] : null;
  scanFocusCaps = null;
  els.scanZoomWrap.hidden = true;
  els.scanTorch.hidden = true;
  scanTorchOn = false;
  els.scanTorch.setAttribute('aria-pressed', 'false');
  els.scanTorch.classList.remove('is-on');
  if (!scanTrack || !scanTrack.getCapabilities) return;
  let caps;
  try { caps = scanTrack.getCapabilities(); } catch (_) { return; }
  const modes = caps.focusMode && caps.focusMode.indexOf ? caps.focusMode : [];
  scanFocusCaps = {
    continuous: modes.indexOf('continuous') >= 0,
    singleShot: modes.indexOf('single-shot') >= 0,
    manualNear: null
  };
  if (modes.indexOf('manual') >= 0 && caps.focusDistance &&
      typeof caps.focusDistance.min === 'number' && caps.focusDistance.max > caps.focusDistance.min) {
    scanFocusCaps.manualNear = caps.focusDistance.min + (caps.focusDistance.max - caps.focusDistance.min) * 0.08;
  }
  if (!scanFocusCaps.continuous && !scanFocusCaps.singleShot && scanFocusCaps.manualNear === null) scanFocusCaps = null;
  if (scanFocusCaps && scanFocusCaps.continuous) {
    scanTrack.applyConstraints({ advanced: [{ focusMode: 'continuous' }] }).catch(() => {});
  }
  if (caps.torch) els.scanTorch.hidden = false;
  if (caps.zoom && typeof caps.zoom.min === 'number' && caps.zoom.max > caps.zoom.min) {
    const settings = scanTrack.getSettings ? scanTrack.getSettings() : {};
    els.scanZoom.min = caps.zoom.min;
    els.scanZoom.max = Math.min(caps.zoom.max, caps.zoom.min * 5);
    els.scanZoom.step = 0.1;
    els.scanZoom.value = typeof settings.zoom === 'number' ? settings.zoom : caps.zoom.min;
    els.scanZoomWrap.hidden = false;
  }
};

const restoreScanFocus = () => {
  scanFocusBusy = false;
  if (scanTrack && scanFocusCaps && scanFocusCaps.continuous) {
    scanTrack.applyConstraints({ advanced: [{ focusMode: 'continuous' }] }).catch(() => {});
  }
};

const nudgeScanFocus = () => {
  if (!scanTrack || !scanFocusCaps || scanFocusBusy) return;
  if (scanFocusCaps.manualNear !== null) {
    scanFocusBusy = true;
    scanTrack.applyConstraints({ advanced: [{ focusMode: 'manual', focusDistance: scanFocusCaps.manualNear }] })
      .then(() => { setTimeout(restoreScanFocus, 900); })
      .catch(() => { scanFocusBusy = false; });
  } else if (scanFocusCaps.singleShot) {
    scanFocusBusy = true;
    scanTrack.applyConstraints({ advanced: [{ focusMode: 'single-shot' }] })
      .then(() => { setTimeout(restoreScanFocus, 900); })
      .catch(() => { scanFocusBusy = false; });
  } else if (scanFocusCaps.continuous) {
    scanTrack.applyConstraints({ advanced: [{ focusMode: 'continuous' }] }).catch(() => {});
  }
};

const loadJsQR = () => new Promise((resolve) => {
  if (window.jsQR) { resolve(true); return; }
  const s = document.createElement('script');
  s.src = '/assets/js/jsqr.js?v={{ buildHash }}';
  s.onload = () => resolve(!!window.jsQR);
  s.onerror = () => resolve(false);
  document.head.appendChild(s);
});

const stopScan = () => {
  els.scan.hidden = false;
  if (scanRaf) { cancelAnimationFrame(scanRaf); scanRaf = null; }
  if (scanStream) { scanStream.getTracks().forEach((t) => { try { t.stop(); } catch (_) {} }); scanStream = null; }
  scanTrack = null;
  scanFocusCaps = null;
  scanFocusBusy = false;
  try { els.scanVideo.srcObject = null; } catch (_) {}
  els.scanWrap.hidden = true;
};

const handleScanned = async (value) => {
  const raw = String(value || '').trim();
  const idx = raw.indexOf('MC1.');
  if (idx === -1) { els.scanNote.textContent = T.people.scan_not_code; return false; }
  stopScan();
  els.contactIn.value = raw.slice(idx);
  els.contactAdd.click();
  return true;
};

const scanTick = async () => {
  if (!scanStream) return;
  const v = els.scanVideo;
  if (v.readyState >= 2 && v.videoWidth) {
    scanMisses++;
    if (scanMisses % 48 === 0) nudgeScanFocus();
    try {
      if (scanDetector) {
        const found = await scanDetector.detect(v);
        if (found && found.length && await handleScanned(found[0].rawValue)) return;
      } else if (window.jsQR) {
        if (!scanCanvas) { scanCanvas = document.createElement('canvas'); scanCtx = scanCanvas.getContext('2d', { willReadFrequently: true }); }
        const w = Math.min(560, v.videoWidth), h = Math.round(v.videoHeight * (w / v.videoWidth));
        scanCanvas.width = w; scanCanvas.height = h;
        scanCtx.drawImage(v, 0, 0, w, h);
        const img = scanCtx.getImageData(0, 0, w, h);
        const r = window.jsQR(img.data, w, h, { inversionAttempts: 'dontInvert' });
        if (r && r.data && await handleScanned(r.data)) return;
      }
    } catch (_) {}
  }
  scanRaf = requestAnimationFrame(scanTick);
};

els.scan.addEventListener('click', async () => {
  if (scanStream) { stopScan(); return; }
  els.scan.hidden = true;
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    els.scanWrap.hidden = false;
    els.scanNote.textContent = T.people.scan_no_camera;
    return;
  }
  els.scanWrap.hidden = false;
  els.scanNote.textContent = T.people.scan_starting;
  try {
    scanStream = await navigator.mediaDevices.getUserMedia({
      video: { facingMode: 'environment', width: { ideal: 1920 }, height: { ideal: 1080 } }
    });
  } catch (_) {
    els.scanNote.textContent = T.people.scan_denied;
    return;
  }
  els.scanVideo.srcObject = scanStream;
  setupScanTrack();
  scanMisses = 0;
  try { await els.scanVideo.play(); } catch (_) {}
  scanDetector = null;
  if ('BarcodeDetector' in window) {
    try {
      const formats = await BarcodeDetector.getSupportedFormats();
      if (formats.includes('qr_code')) scanDetector = new BarcodeDetector({ formats: ['qr_code'] });
    } catch (_) {}
  }
  if (!scanDetector) await loadJsQR();
  els.scanNote.textContent = T.people.scan_hint;
  scanTick();
});

