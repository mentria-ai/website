const CHUNK = 32 * 1024;
let recvWake = null;
let recvTimer = 0;
const keepAwakeReceiving = () => {
  if (!recvWake) recvWake = holdAwake();
  clearTimeout(recvTimer);
  recvTimer = setTimeout(() => {
    if (recvWake) { recvWake(); recvWake = null; }
  }, 15000);
};
const sendOne = async (file, extra) => {
  const id = Math.random().toString(36).slice(2);
  const line = renderLine('you', '', { me: true, quiet: true, html: progressHTML(T.files.sending, file.name, file.size, 0) });
  await metaAction.send(Object.assign({ id, name: file.name, size: file.size, type: file.type }, extra || {}));
  const buf = await file.arrayBuffer();
  let sent = 0;
  let paint = 0;
  for (let offset = 0; offset < buf.byteLength; offset += CHUNK) {
    if (peers.size === 0) {
      if (paint) cancelAnimationFrame(paint);
      line.line.removeAttribute('aria-live');
      line.what.innerHTML = fmtHtml(T.files.send_interrupted, { name: strongName(file.name) });
      throw new Error(T.files.all_left);
    }
    const slice = buf.slice(offset, Math.min(offset + CHUNK, buf.byteLength));
    const done = offset + CHUNK >= buf.byteLength;
    await chunkAction.send(slice, { metadata: { id, done } });
    sent += slice.byteLength;
    if (!paint) paint = requestAnimationFrame(() => { paint = 0; line.what.innerHTML = progressHTML(T.files.sending, file.name, file.size, sent); });
  }
  if (paint) cancelAnimationFrame(paint);
  const previewUrl = trackObjectUrl(file);
  const n = peers.size;
  line.line.removeAttribute('aria-live');
  line.what.innerHTML = completeHTML(n > 0 ? (n === 1 ? T.files.sent_one : T.files.sent_many) : T.files.uncertain, { n }, file.name, file.size, file.type, previewUrl);
};

const storedChat = () => !!(currentRoomName && keepsHistory(currentRoomName) && chatKey && attach && attach.media);

const blobB64 = (blob) => new Promise((resolve) => {
  const r = new FileReader();
  r.onload = () => resolve(String(r.result || '').replace(/^data:[^,]*,/, ''));
  r.onerror = () => resolve(null);
  r.readAsDataURL(blob);
});

const smallJpeg = async (src) => {
  let best = null;
  for (let q = 7; q >= 3; q -= 1) {
    const r = await MentriaImage.renderJpeg(src, 320, q / 10);
    if (!r) break;
    if (!best || r.blob.size < best.blob.size) best = r;
    if (r.blob.size <= 12288) break;
  }
  return best && best.blob.size <= 12288 ? best : null;
};

const videoInfo = (file) => new Promise((resolve) => {
  let url = '';
  try { url = URL.createObjectURL(file); } catch (_) { resolve(null); return; }
  const v = document.createElement('video');
  v.muted = true;
  v.playsInline = true;
  v.preload = 'metadata';
  let done = false;
  const finish = (r) => {
    if (done) return;
    done = true;
    try { v.removeAttribute('src'); v.load(); } catch (_) {}
    URL.revokeObjectURL(url);
    resolve(r);
  };
  setTimeout(() => finish(null), 8000);
  v.onloadedmetadata = () => { try { v.currentTime = Math.min(0.1, (v.duration || 1) / 2); } catch (_) { finish({ duration: v.duration }); } };
  v.onseeked = async () => {
    const w = v.videoWidth;
    const h = v.videoHeight;
    if (!w || !h) { finish({ duration: v.duration }); return; }
    let poster = null;
    try { const r = await smallJpeg({ source: v, width: w, height: h, close() {} }); poster = r ? await blobB64(r.blob) : null; } catch (_) {}
    finish({ duration: Number.isFinite(v.duration) ? v.duration : undefined, w, h, poster });
  };
  v.onerror = () => finish(null);
  v.src = url;
});

const shortName = (name) => { const n = String(name || 'file'); return n.length > 200 ? n.slice(0, 190) + n.slice(n.lastIndexOf('.')).slice(0, 10) : n; };
const jpegName = (name) => String(name || 'photo').replace(/\.[^.]+$/, '') + '.jpg';
const newAid = () => Math.random().toString(36).slice(2, 12);

const sendAttachments = async ({ items, caption }) => {
  const roomName = currentRoomName;
  const key = chatKey;
  const list = Array.from(items || []);
  if (!list.length || !storedChat()) return;
  const total = list.reduce((a, it) => a + it.file.size, 0);
  const label = list.length === 1 ? list[0].file.name : fmt(T.files.offer_files, { n: list.length }).split('.')[0];
  const prep = renderLine('you', '', { me: true, quiet: true, html: progressHTML(T.files.sending, label, total, 0) });
  const media = [];
  const files = [];
  let done = 0;
  for (const item of list) {
    const f = item.file;
    const mime = f.type || '';
    let kind = /^video\//i.test(mime) ? 'video' : /^image\//i.test(mime) ? 'image' : 'file';
    let sendFile = f;
    let part = null;
    if (kind === 'image') {
      const prev = window.MentriaImage ? await MentriaImage.preview(f).catch(() => null) : null;
      if (!prev) {
        kind = 'file';
      } else {
        let w = prev.w;
        let h = prev.h;
        if (item.variant === 'standard') {
          const std = await MentriaImage.standard(f).catch(() => null);
          if (std) { sendFile = new File([std.blob], jpegName(f.name), { type: 'image/jpeg', lastModified: f.lastModified }); w = std.w; h = std.h; }
        }
        part = { type: 'image', mime: sendFile.type || mime, name: shortName(sendFile.name), w, h, thumb: prev.blob.size <= 12288 ? await blobB64(prev.blob) : undefined, hd: item.variant !== 'standard' };
      }
    }
    if (kind === 'video') {
      const info = await videoInfo(f);
      part = { type: 'video', mime, name: shortName(f.name), w: info && info.w, h: info && info.h, duration: info && info.duration, poster: info && info.poster };
    }
    if (kind === 'file') part = { type: 'file', mime: mime || 'application/octet-stream', name: shortName(f.name) };
    const base = done;
    const plan = importPlan(item, sendFile && sendFile !== f ? sendFile : null);
    sendFile = plan.file;
    const sent = await attach.sendFile(tidOf(roomName), sendFile, { ranges: plan.ranges, record: { thumb: part.thumb || part.poster || undefined, kind: part.type }, onProgress: (i) => { prep.what.innerHTML = progressHTML(T.files.sending, label, total, Math.min(total, base + i * PIECE_BYTES)); } });
    done += sendFile.size;
    part.ref = sent.id;
    part.mh = sent.mh;
    part.size = sendFile.size;
    (kind === 'file' ? files : media).push(part);
  }
  if (roomName !== currentRoomName || key !== chatKey) {
    prep.line.removeAttribute('aria-live');
    prep.what.innerHTML = fmtHtml(T.files.send_interrupted, { name: strongName(label) });
    return;
  }
  prep.line.remove();
  const parts = [];
  const cap = String(caption || '').trim();
  if (cap) parts.push({ type: 'text', text: cap.slice(0, 2000) });
  parts.push(...toAlbums(media, newAid));
  parts.push(...files);
  const ids = { fp: myFp, legacyFp: myLegacyFp };
  const measure = async (ps) => JSON.stringify(await encryptText(chatKey, packChatPlain(offerText(ps, T), ids, { p: ps }))).length + 1100;
  const msgs = await splitOffer(parts, measure, 60000);
  const ts = Date.now();
  renderAttachment('you', parts, { me: true, ts });
  for (const m of msgs) {
    const text = offerText(m, T);
    const cmid = newCmid();
    seenCmids.add(cmid);
    const enc = await encryptText(chatKey, await sealPlain(text, cmid, { p: m }));
    if (chatAction) chatAction.send({ cmid, enc });
    publishChat(text, cmid, { p: m });
    storeLine(cmid, 'self', text, ts, undefined, m);
  }
  maybeRingContact();
};

const deliver = async (items, caption) => {
  const oldPeers = Array.from(peers).filter((p) => { const pr = peerProfiles.get(p); return !(pr && pr.caps && pr.caps.files >= 2); });
  const fresh = [];
  const release = holdAwake();
  try {
    for (const it of items) {
      if (oldPeers.length && it.file.size <= MAX_FILE && metaAction && chunkAction) {
        try { await sendOne(await blankedCopy(it.file, it.ranges)); } catch (err) { sys(fmt(T.files.send_failed_for, { name: it.file.name, reason: why(err) })); }
        continue;
      }
      if (oldPeers.length) sys(fmt(T.files.needs_update, { name: displayName(oldPeers[0]) }));
      fresh.push(it);
    }
    if (fresh.length) await sendAttachments({ items: fresh, caption });
  } catch (err) {
    sys(fmt(T.files.send_failed_for, { name: items.map((x) => x.file.name).join(', '), reason: why(err) }));
  } finally {
    release();
  }
};

const sendFiles = async (fileList) => {
  if (storedChat()) {
    const all = Array.from(fileList || []);
    if (!all.length) return;
    openSheet({ files: all, self: inSelf(), T, onSend: ({ items, caption }) => { deliver(items, caption); } });
    return;
  }
  if (!metaAction || !chunkAction || peers.size === 0) {
    if (currentDmContact) {
      sys(fmt(T.files.dm_offline, { name: whoNow() }));
      knockNow('comms-msg').then((ok) => {
        if (ok) sys(T.files.pinged);
      });
    } else {
      sys(T.files.nobody);
    }
    return;
  }
  const all = Array.from(fileList || []);
  if (!all.length) return;
  const tooBig = all.filter(f => f.size > MAX_FILE);
  const ok = all.filter(f => f.size <= MAX_FILE);
  if (tooBig.length) {
    sys(fmt(T.files.skipped, { cap: fmtMB(MAX_FILE), files: tooBig.map(f => `${f.name} ${fmtSize(f.size)}`).join(', ') }));
  }
  if (!ok.length) return;
  const total = ok.reduce((s, f) => s + f.size, 0);
  if (ok.length > 1) sys(fmt(peers.size === 1 ? T.files.sending_to_one : T.files.sending_to_many, { n: ok.length, size: fmtSize(total), p: peers.size }));
  if (total > MAX_TOTAL_WARN) sys(fmt(T.files.heads_up, { size: fmtSize(total) }));
  const release = holdAwake();
  try {
    for (const file of ok) {
      try { await sendOne(file); } catch (err) { sys(fmt(T.files.send_failed_for, { name: file.name, reason: why(err) })); }
    }
  } finally {
    release();
  }
};

