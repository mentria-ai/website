---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/tools/extensions/run/index.html"
eleventyComputed:
  lang: "{{ locale.code }}"
  title: "{{ 'tools.extensions.title' | t }}"
  description: "{{ 'tools.extensions.lede' | t }}"
---
{% set terminalTitle = "…" %}
{% set terminalBackHref = locale.pathPrefix + "/tools/extensions/" %}
{% include "terminal-frame-open.njk" %}
<h1 class="sr-only" id="xr-h1">{{ "tools.extensions.title" | t }}</h1>
<section class="xr" data-prefix="{{ locale.pathPrefix }}" data-blocked="{{ 'tool.extensions.run_blocked' | t }}" data-install-quiet>
  <p class="xr__error" id="xr-error" hidden></p>
  <p class="xr__missing" id="xr-gone" role="status" hidden><span id="xr-gone-text"></span> <a id="xr-gone-link" href="{{ locale.pathPrefix }}/tools/extensions/"></a></p>
  <p class="xr__missing" id="xr-disabled" hidden>{{ "tool.extensions.run_disabled" | t }} <a href="{{ locale.pathPrefix }}/tools/extensions/">{{ "tool.extensions.run_manager_link" | t }}</a></p>
  <iframe class="xr__frame" id="xr-frame" title="{{ 'tools.extensions.title' | t }}" allow="bluetooth; usb; serial; camera; microphone; fullscreen; gamepad; accelerometer; gyroscope; autoplay"></iframe>
</section>
{% include "terminal-frame-close.njk" %}

<script type="application/json" id="xr-gallery">{ {%- for e in extensions %}{{ e.id | dump | safe }}: {{ e.name | dump | safe }}{% if not loop.last %}, {% endif %}{%- endfor %} }</script>
<script>
  window.XR_COPY = {
    gone: {{ ("tool.extensions.run_gone" | t) | dump | safe }},
    removed: {{ ("store.removed" | t) | dump | safe }},
    storeLink: {{ ("tool.extensions.run_store_link" | t) | dump | safe }},
    manageLink: {{ ("store.manage_link" | t) | dump | safe }}
  };
</script>
<script type="module">
const X = await import('/assets/js/mentria-extensions.js');
const H = await import('/assets/js/mentria-ext-host.js');
const root = document.querySelector('.xr');
const params = new URLSearchParams(location.search);
const id = params.get('id') || '';
const entry = X.getEntry(id);
const frame = document.getElementById('xr-frame');
const errEl = document.getElementById('xr-error');
let prefix = root.dataset.prefix || '';
let gallery = {};
try { gallery = JSON.parse(document.getElementById('xr-gallery').textContent) || {}; } catch (_) {}
const listed = Object.prototype.hasOwnProperty.call(gallery, id) ? gallery[id] : '';

function tr(key, fallback) {
  const I = window.MentriaI18n;
  const v = I && typeof I.t === 'function' ? I.t(key) : null;
  return typeof v === 'string' && v && v !== key ? v : fallback;
}

function setFilename(label) {
  const filename = document.querySelector('.terminal-frame__filename');
  if (filename) filename.textContent = label || 'extensions';
}

let goneState = null;
function renderGone() {
  if (!goneState) return;
  const C = window.XR_COPY || {};
  const text = goneState.removed ? tr('store.removed', C.removed) : tr('tool.extensions.run_gone', C.gone);
  document.getElementById('xr-gone-text').textContent = String(text || '').split('{name}').join(goneState.name);
  const link = document.getElementById('xr-gone-link');
  if (listed) {
    link.href = prefix + '/extensions/' + encodeURIComponent(id) + '/';
    link.textContent = tr('tool.extensions.run_store_link', C.storeLink);
  } else {
    link.href = prefix + '/tools/extensions/';
    link.textContent = tr('store.manage_link', C.manageLink);
  }
  document.getElementById('xr-gone').hidden = false;
}

function showGone(name, removed) {
  goneState = { name: name || listed || id, removed: !!removed };
  renderGone();
  setFilename(goneState.name);
}

function showDisabled(name) {
  const miss = document.getElementById('xr-disabled');
  if (name) miss.prepend(name + ': ');
  miss.hidden = false;
  setFilename(name);
}

document.addEventListener('mentria:localechange', (e) => {
  const code = (e && e.detail && e.detail.code) || document.documentElement.lang;
  const locale = (window.MENTRIA_LOCALES || []).find((l) => l.code === code);
  if (locale) prefix = locale.prefix;
  renderGone();
});

function takeHashArgs() {
  const h = new URLSearchParams(location.hash.slice(1));
  const cmd = h.get('cmd');
  if (!cmd) return null;
  const args = h.get('args') || '';
  h.delete('cmd');
  h.delete('args');
  const rest = h.toString();
  try { history.replaceState(history.state, '', location.pathname + location.search + (rest ? '#' + rest : '')); } catch (_) {}
  return { cmd, args };
}

const app = entry && X.isApp(entry);
const source = entry && entry.enabled && !app ? X.getSource(id) : null;
if (!entry || !entry.enabled || (!app && !source)) {
  if (entry && !entry.enabled) showDisabled(entry.manifest.name);
  else showGone(entry ? entry.manifest.name : '', false);
  frame.remove();
} else {
  const m = entry.manifest;
  const filename = document.querySelector('.terminal-frame__filename');
  if (filename) filename.textContent = m.icon && !/^data:/.test(m.icon) ? m.icon + ' ' + m.name : m.name;
  const title = m.name + ' · Mentria';
  document.title = title;
  const xrH1 = document.getElementById('xr-h1');
  if (xrH1) xrH1.textContent = m.name;
  frame.title = m.name;
  if (app) root.classList.add('xr--app');
  document.addEventListener('mentria:localechange', () => { document.title = title; });
  const mount = (args) => H.mountExtension(frame, {
    manifest: m,
    source,
    get prefix() { return prefix; },
    args,
    get blockedTemplate() { return root.dataset.blocked; },
    onError: (msg) => { errEl.textContent = msg; errEl.hidden = false; },
    onClose: () => { location.href = prefix + '/'; }
  });
  mount(takeHashArgs());
  let running = true;
  const stop = (removed) => {
    if (!running) return;
    running = false;
    frame.remove();
    errEl.hidden = true;
    if (removed) {
      showGone(m.name, true);
      setTimeout(() => { try { if (!X.getEntry(id)) X.clearData(id); } catch (_) {} }, 0);
    } else {
      showDisabled(m.name);
    }
  };
  const check = () => {
    if (!running) return;
    let now = null;
    try { now = X.getEntry(id); } catch (_) { return; }
    if (!now) stop(true);
    else if (!now.enabled) stop(false);
  };
  window.addEventListener('storage', (e) => { if (e.key === null || e.key === 'mentria.store.ext.registry') check(); });
  window.addEventListener('mentria:write', (e) => { const d = (e && e.detail) || {}; if (d.ns === 'ext' && d.key === 'registry') check(); });
  window.addEventListener('pageshow', (e) => { if (e.persisted) check(); });
  if (app) setTimeout(() => { if (running && navigator.onLine) X.ensureAppPages(id).catch(() => {}); }, 4000);
  window.addEventListener('hashchange', () => {
    if (!running) return;
    const next = takeHashArgs();
    if (!next) return;
    let taken = false;
    try {
      const w = frame.contentWindow;
      if (w) taken = !w.dispatchEvent(new w.CustomEvent('mentria:command', { detail: { cmd: next.cmd, args: next.args }, cancelable: true }));
    } catch (_) { taken = false; }
    if (!taken) mount(next);
  });
}
</script>

<style>
.xr { display: flex; flex-direction: column; height: min(820px, 78vh); }
.xr__frame { flex: 1; width: 100%; border: 0; min-height: 0; background: transparent; }
.xr--app { height: min(820px, 82vh); }
@media (max-width: 480px) {
  .xr { height: min(600px, 70vh); }
}
.xr__error, .xr__missing { font-family: var(--font-mono); font-size: 0.8rem; color: var(--syn-pink, #f472b6); padding: 0.6rem 0.8rem; margin: 0; }
.xr__missing a { color: var(--accent, #6ef3c5); text-decoration: underline; text-underline-offset: 2px; }
.xr__error[hidden], .xr__missing[hidden] { display: none; }
@media (pointer: coarse) and (orientation: landscape) and (max-height: 540px) {
  .terminal-frame:has(.xr--app) { position: fixed; inset: 0; z-index: 9000; margin: 0; max-width: none; border: 0; border-radius: 0; }
  .terminal-frame:has(.xr--app) .terminal-frame__titlebar { display: none; }
  .terminal-frame:has(.xr--app) .terminal-frame__body { padding: 0; height: 100%; }
  .xr.xr--app { height: 100vh; height: 100svh; }
}
</style>
