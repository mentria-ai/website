<section class="comms">
  <div class="comms__onboard" id="comms-onboard" hidden>
    <div class="comms__onboard-step" id="comms-onboard-insecure" hidden>
      <h2 class="comms__onboard-h">This page needs a secure connection</h2>
      <p class="comms__onboard-p">Your browser only allows the encryption comms depends on over <strong>https</strong>. You're on a plain http address, so keys can't be created here.</p>
      <p class="comms__onboard-p">Open <a class="comms__url" href="https://mentria.ai/comms/">https://mentria.ai/comms/</a> instead — or use an https address if you're testing locally.</p>
    </div>
    <div class="comms__onboard-step" id="comms-onboard-intro">
      <h2 class="comms__onboard-h">Private chat that runs on your devices</h2>
      <p class="comms__onboard-p">Messages, calls and files go straight to the other person — encrypted end to end. No account, no phone number, and no server that can read them.</p>
      <button class="comms__btn comms__btn--big" id="comms-onboard-start" type="button">get started</button>
      <p class="comms__onboard-fine">Takes about ten seconds. Everything stays on your device.</p>
    </div>
    <div class="comms__onboard-step" id="comms-onboard-form" hidden>
      <h2 class="comms__onboard-h">What should people call you?</h2>
      <input class="comms__input comms__input--big" id="comms-onboard-name" type="text" maxlength="32" placeholder="your name" autocomplete="nickname" enterkeyhint="done">
      <button class="comms__btn comms__btn--big" id="comms-onboard-create" type="button">create my identity</button>
      <p class="comms__onboard-fine" id="comms-onboard-hint">Your device will ask for Face&nbsp;ID, Touch&nbsp;ID or your screen lock to protect it.</p>
      <p class="comms__onboard-err" id="comms-onboard-err" hidden></p>
    </div>
    <div class="comms__onboard-step" id="comms-onboard-done" hidden>
      <h2 class="comms__onboard-h">You're set up</h2>
      <p class="comms__onboard-p" id="comms-onboard-method"></p>
      <p class="comms__onboard-p">Save this recovery code somewhere safe. It's the only way back in if you lose your devices — you won't need it day to day.</p>
      <code class="comms__recovery" id="comms-onboard-code"></code>
      <div class="comms__onboard-actions">
        <button class="comms__btn comms__btn--ghost" id="comms-onboard-copy" type="button">copy code</button>
        <button class="comms__btn" id="comms-onboard-passkey" type="button" hidden>protect with face id / touch id</button>
        <button class="comms__btn comms__btn--big" id="comms-onboard-continue" type="button">start chatting</button>
      </div>
    </div>
  </div>

  <div class="comms__lock" id="comms-id-locked" hidden>
    <p class="comms__lock-h">Welcome back</p>
    <p class="comms__lock-waiting" id="comms-lock-waiting" hidden></p>
    <button class="comms__btn comms__btn--big" id="comms-id-passkey" type="button" hidden>unlock</button>
    <details class="comms__lock-alt" id="comms-lock-alt">
      <summary>use my recovery code instead</summary>
      <div class="comms__lock-row">
        <input class="comms__input" id="comms-id-pass" type="password" placeholder="recovery code or passphrase" autocomplete="current-password">
        <button class="comms__btn" id="comms-id-unlock" type="button">unlock</button>
      </div>
    </details>
    <span class="comms__id-note" id="comms-id-err"></span>
  </div>

  <div class="comms__app comms__app--people" id="comms-app" hidden>
    <div class="comms__profile" id="comms-profile">
      <div class="comms__id-row comms__id-row--you" id="comms-id-on" hidden>
        <span class="comms__avatar comms__avatar--me" id="comms-prof-avatar" aria-hidden="true"></span>
        <input class="comms__input comms__input--short" id="comms-id-name" type="text" maxlength="32" placeholder="display name" autocomplete="nickname" aria-label="your display name">
        <span class="comms__badge comms__badge--fp" id="comms-id-fp" title="your identity fingerprint"></span>
      </div>
      <span class="comms__profile-spacer"></span>
      <button class="comms__btn comms__btn--ghost comms__btn--icon" id="comms-adv-toggle" type="button" aria-expanded="false" title="settings and rooms" aria-label="settings and rooms"><svg class="comms__i" aria-hidden="true"><use href="#ci-gear"></use></svg></button>
    </div>

    <div class="comms__chathead" id="comms-chathead">
      <button class="comms__btn comms__btn--ghost comms__btn--icon" id="comms-leave" type="button" hidden title="back to your people" aria-label="back to your people"><svg class="comms__i" aria-hidden="true"><use href="#ci-back"></use></svg></button>
      <span class="comms__avatar" id="comms-chat-avatar" aria-hidden="true"></span>
      <div class="comms__chathead-mid">
        <span class="comms__chathead-name" id="comms-chat-title"></span>
        <span class="comms__chathead-sub">
          <span class="comms__sub-bit" id="comms-status">not in a chat</span>
          <span class="comms__sub-bit" id="comms-enc" title="end-to-end encrypted — only people in this chat can read it" hidden><svg class="comms__i" aria-hidden="true"><use href="#ci-lock"></use></svg></span>
          <span class="comms__sub-bit" id="comms-eph" title="messages aren't saved (room starts with !)" hidden><svg class="comms__i" aria-hidden="true"><use href="#ci-clock"></use></svg></span>
          <span class="comms__sub-bit" id="comms-peers" hidden><svg class="comms__i" aria-hidden="true"><use href="#ci-users"></use></svg><span id="comms-peers-n">0</span></span>
        </span>
      </div>
      <button class="comms__btn comms__btn--icon" id="comms-call-start" type="button" hidden title="start a call" aria-label="start a call"><svg class="comms__i" aria-hidden="true"><use href="#ci-phone"></use></svg></button>
      <button class="comms__btn comms__btn--ghost comms__btn--icon" id="comms-call-cam" type="button" hidden aria-pressed="false" title="camera" aria-label="camera"><svg class="comms__i" aria-hidden="true"><use href="#ci-cam"></use></svg></button>
      <button class="comms__btn comms__btn--ghost comms__btn--icon" id="comms-call-mic" type="button" hidden aria-pressed="true" title="microphone" aria-label="microphone"><svg class="comms__i" aria-hidden="true"><use href="#ci-mic"></use></svg></button>
      <button class="comms__btn comms__btn--danger comms__btn--icon" id="comms-call-hangup" type="button" hidden title="hang up" aria-label="hang up"><svg class="comms__i" aria-hidden="true"><use href="#ci-hangup"></use></svg></button>
    </div>

    <div class="comms__notif" id="comms-notif" hidden>
      <span class="comms__notif-text">get a notification when a message arrives — even with comms closed</span>
      <button class="comms__btn" id="comms-notif-enable" type="button">enable</button>
      <button class="comms__btn comms__btn--ghost comms__btn--icon" id="comms-notif-dismiss" type="button" title="not now" aria-label="not now"><svg class="comms__i" aria-hidden="true"><use href="#ci-plus" style="transform:rotate(45deg);transform-origin:center"></use></svg></button>
    </div>

    <div class="comms__id-row" id="comms-id-none" hidden>
      <span class="comms__id-note">you're in a shared room as a guest. set up an identity to use your name, contacts and direct messages.</span>
      <button class="comms__btn comms__btn--ghost" id="comms-id-setup-here" type="button">set up</button>
    </div>

    <div class="comms__contacts" id="comms-contacts" hidden>
      <div class="comms__contacts-head">
        <span class="comms__lbl">people</span>
        <button class="comms__btn comms__btn--ghost comms__btn--icon" id="comms-id-share" type="button" aria-pressed="false"><svg class="comms__i" aria-hidden="true"><use href="#ci-qr"></use></svg><span class="comms__btn-t" id="comms-id-share-t">my code</span></button>
        <button class="comms__btn comms__btn--ghost comms__btn--icon" id="comms-add-toggle" type="button" aria-expanded="false"><svg class="comms__i" aria-hidden="true"><use href="#ci-plus"></use></svg><span class="comms__btn-t" id="comms-add-toggle-t">add someone</span></button>
        <button class="comms__btn comms__btn--ghost" id="comms-id-contacts" type="button" aria-expanded="false" hidden>contacts</button>
      </div>
      <div class="comms__id-card" id="comms-id-card" hidden>
        <canvas class="comms__id-qr" id="comms-id-qr" width="0" height="0"></canvas>
        <div class="comms__id-card-side">
          <p class="comms__id-note">scan or paste this code on another person's device to become contacts. it contains your public key, never your secrets.</p>
          <code class="comms__url comms__url--wrap" id="comms-id-code"></code>
          <button class="comms__btn comms__btn--ghost" id="comms-id-copy" type="button">copy code</button>
        </div>
      </div>
      <div class="comms__add" id="comms-add" hidden>
        <button class="comms__addopt" id="comms-scan" type="button"><svg class="comms__i" aria-hidden="true"><use href="#ci-qr"></use></svg><span>scan their code</span></button>
        <div class="comms__scan" id="comms-scan-wrap" hidden>
          <video class="comms__scan-video" id="comms-scan-video" playsinline muted></video>
          <div class="comms__scan-zoom" id="comms-scan-zoom-wrap" hidden>
            <svg class="comms__i" aria-hidden="true"><use href="#ci-qr"></use></svg>
            <input type="range" id="comms-scan-zoom" min="1" max="5" step="0.1" value="1" aria-label="camera zoom">
          </div>
          <p class="comms__id-note" id="comms-scan-note">point the camera at their “my code” screen</p>
          <div class="comms__scan-actions">
            <button class="comms__btn comms__btn--ghost comms__btn--icon" id="comms-scan-torch" type="button" hidden aria-pressed="false" title="flashlight" aria-label="flashlight"><svg class="comms__i" aria-hidden="true"><use href="#ci-flash"></use></svg></button>
            <button class="comms__btn comms__btn--ghost" id="comms-scan-stop" type="button">cancel</button>
          </div>
        </div>
        <div class="comms__contacts-add">
          <input class="comms__input" id="comms-contact-in" type="text" enterkeyhint="done" placeholder="…or paste a contact code (MC1.…)" spellcheck="false" autocapitalize="off">
          <button class="comms__btn comms__btn--ghost" id="comms-contact-add" type="button">add</button>
        </div>
      </div>
      <div class="comms__contacts-list" id="comms-contacts-list"></div>
    </div>

    <div class="comms__ring" id="comms-ring" hidden>
      <span class="comms__ring-text" id="comms-ring-text">incoming call</span>
      <button class="comms__btn" id="comms-ring-accept" type="button">accept</button>
      <button class="comms__btn comms__btn--ghost" id="comms-ring-decline" type="button">decline</button>
    </div>

    <div class="comms__chatbody" id="comms-drop">
      <div class="comms__media" id="comms-media" hidden></div>
      <div class="comms__peerlist" id="comms-peerlist" hidden></div>
      <div class="comms__log" id="comms-log" aria-live="polite" aria-relevant="additions"></div>
    </div>

    <form class="comms__send" id="comms-send" autocomplete="off">
      <label class="comms__attach" title="send a file" aria-label="send a file"><input type="file" id="comms-file" multiple hidden><svg class="comms__i" aria-hidden="true"><use href="#ci-clip"></use></svg></label>
      <input class="comms__input comms__input--msg" id="comms-msg" type="text" enterkeyhint="send" placeholder="message" disabled>
      <button class="comms__btn comms__btn--send" id="comms-go" type="submit" disabled title="send" aria-label="send"><svg class="comms__i" aria-hidden="true"><use href="#ci-send"></use></svg></button>
    </form>

    <div class="comms__adv" id="comms-adv" hidden>
      <div class="comms__adv-sec">
        <span class="comms__lbl">room</span>
        <div class="comms__room">
          <input class="comms__input" id="comms-room" type="text" enterkeyhint="go" autocomplete="off" spellcheck="false" lang="en" dir="ltr" autocapitalize="off" placeholder="!ephemeral">
          <button class="comms__btn" id="comms-join" type="button">join</button>
          <button class="comms__btn comms__btn--ghost" id="comms-newroom" type="button">new room link</button>
        </div>
      </div>
      <div class="comms__share" id="comms-share" hidden>
        <span class="comms__lbl">share</span>
        <code class="comms__url" id="comms-url"></code>
        <button class="comms__btn comms__btn--ghost" id="comms-copy" type="button">copy</button>
        <button class="comms__btn comms__btn--ghost" id="comms-genkey" type="button" title="generate a fresh encryption key and append it to the URL">+ key</button>
      </div>
      <div class="comms__adv-sec comms__adv-sec--col">
        <div class="comms__adv-row">
          <span class="comms__lbl">notifications</span>
          <button class="comms__btn comms__btn--ghost" id="comms-push-test" type="button">test my notifications</button>
        </div>
        <span class="comms__id-note" id="comms-push-status">…</span>
        <span class="comms__id-note comms__push-log" id="comms-push-test-log" hidden></span>
      </div>
      <div class="comms__adv-sec">
        <span class="comms__lbl">this device</span>
        <button class="comms__btn comms__btn--ghost comms__btn--mute" id="comms-mute" type="button" aria-pressed="false">sound: on</button>
        <button class="comms__btn comms__btn--ghost" id="comms-attach-ext" type="button">attach extension</button>
        <a class="comms__btn comms__btn--ghost" href="/about/">identity settings</a>
      </div>
    </div>
  </div>

  <div class="comms__picker" id="comms-picker" hidden>
    <div class="comms__picker-backdrop" data-picker-close></div>
    <div class="comms__picker-card" role="dialog" aria-modal="true" aria-label="share extension">
      <h3 class="comms__picker-h">share extension</h3>
      <div class="comms__picker-list" id="comms-picker-list"></div>
      <div class="comms__picker-actions">
        <button type="button" class="comms__btn comms__btn--ghost" data-picker-close>cancel</button>
      </div>
    </div>
  </div>
</section>

{% include "terminal-frame-close.njk" %}

<style>
.comms{display:flex;flex-direction:column;gap:.75rem;font-family:var(--font-mono);font-size:.9rem}
.comms [hidden]{display:none !important}
.comms__onboard{display:flex;flex-direction:column;align-items:center;text-align:center;gap:0;padding:2.5rem 1.25rem;background:#0d1115;border:1px solid #1a1f24;border-radius:10px}
.comms__onboard[hidden]{display:none}
.comms__onboard-step{display:flex;flex-direction:column;align-items:center;gap:.9rem;width:100%;max-width:30rem}
.comms__onboard-step[hidden]{display:none}
.comms__onboard-h{margin:0;font-size:1.05rem;color:var(--accent,#6ef3c5);letter-spacing:.02em;line-height:1.4;text-transform:none}
.comms__onboard-p{margin:0;color:#c3ccd6;font-size:.85rem;line-height:1.65;max-width:26rem}
.comms__onboard-fine{margin:0;color:#7a838d;font-size:.75rem;line-height:1.5}
.comms__onboard-err{margin:0;color:#e5534b;font-size:.78rem;line-height:1.5}
.comms__onboard-err[hidden]{display:none}
.comms__onboard-actions{display:flex;gap:.6rem;flex-wrap:wrap;justify-content:center}
.comms__btn--big{padding:.7rem 1.6rem;font-size:.92rem;min-height:44px}
.comms__input--big{max-width:18rem;text-align:center;padding:.6rem .8rem;font-size:.95rem;flex:none;width:100%}
.comms__recovery{display:block;width:100%;max-width:24rem;background:#0a0d10;border:1px dashed var(--accent,#6ef3c5);border-radius:6px;padding:.7rem;color:var(--accent,#6ef3c5);font-size:.95rem;letter-spacing:.12em;word-break:break-all;line-height:1.6}
.comms__lock{display:flex;flex-direction:column;align-items:center;gap:.75rem;padding:2rem 1.25rem;background:#0d1115;border:1px solid #1a1f24;border-radius:10px;text-align:center}
.comms__lock[hidden]{display:none}
.comms__lock-h{margin:0;color:#c3ccd6;font-size:.95rem}
.comms__lock-waiting{margin:0;color:var(--accent,#6ef3c5);font-size:.8rem}
.comms__lock-waiting[hidden]{display:none}
.comms__lock-alt{width:100%;max-width:24rem;color:#7a838d;font-size:.78rem}
.comms__lock-alt summary{cursor:pointer;list-style:none;padding:.3rem}
.comms__lock-alt summary::-webkit-details-marker{display:none}
