---
layout: base.njk
permalink: /share/index.html
title: "Shared photo"
robots: "noindex, nofollow"
englishOnly: true
eleventyExcludeFromCollections: true
eleventyExcludeFromSitemap: true
---
<section class="hero" style="padding-top:1.5rem;">
  <h1>{{ "share_target.title" | t }}</h1>
  <p>{{ "share_target.lede" | t }}</p>
</section>
<section class="shr" id="shr">
  <figure class="shr__preview" id="shr-preview" hidden>
    <img id="shr-img" alt="">
    <figcaption id="shr-name"></figcaption>
  </figure>
  <div class="shr__actions" id="shr-actions" hidden>
    <a class="m-btn m-btn--primary shr__act" id="shr-annotate" href="/tools/annotate-image/?shared=1">{{ "share_target.annotate" | t }}</a>
    <a class="m-btn m-btn--ghost shr__act" href="/tools/qr-scanner/?shared=1">{{ "share_target.qr" | t }}</a>
    <a class="m-btn m-btn--ghost shr__act" href="/tools/exif/?shared=1">{{ "share_target.exif" | t }}</a>
    <button type="button" class="m-btn m-btn--ghost shr__act" id="shr-cancel">{{ "share_target.cancel" | t }}</button>
  </div>
  <p class="shr__empty" id="shr-empty" hidden>{{ "share_target.empty" | t }} <a href="/">{{ "share_target.home" | t }}</a></p>
</section>
<script>
(async () => {
  const $ = (id) => document.getElementById(id);
  let res = null;
  try { res = await (await caches.open('mentria-share')).match('/share-target/file'); } catch (_) {}
  if (!res) { $('shr-empty').hidden = false; return; }
  const blob = await res.blob();
  let name = 'shared-image';
  try { name = decodeURIComponent(res.headers.get('x-file-name') || name); } catch (_) {}
  $('shr-img').src = URL.createObjectURL(blob);
  $('shr-img').alt = name;
  $('shr-name').textContent = name;
  $('shr-preview').hidden = false;
  $('shr-actions').hidden = false;
  if (!navigator.gpu) $('shr-annotate').hidden = true;
  $('shr-cancel').addEventListener('click', async () => {
    try { await (await caches.open('mentria-share')).delete('/share-target/file'); } catch (_) {}
    location.href = '/';
  });
})();
</script>
<style>
.shr { max-width: 560px; margin: 0 auto 3rem; padding: 0 1rem; display: flex; flex-direction: column; gap: 1rem; }
.shr__preview { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
.shr__preview[hidden], .shr__actions[hidden], .shr__empty[hidden], .shr__act[hidden] { display: none; }
.shr__preview img { max-width: 100%; max-height: min(46vh, 360px); border-radius: var(--radius-md, 8px); border: 1px solid var(--term-border-strong); object-fit: contain; background: var(--term-bg-raised); }
.shr__preview figcaption { font-family: var(--font-mono); font-size: var(--text-xs, 0.75rem); color: var(--term-muted); overflow-wrap: anywhere; }
.shr__actions { display: flex; flex-direction: column; gap: 0.6rem; }
.shr__act { justify-content: center; text-align: center; }
.shr__empty { text-align: center; color: var(--term-muted); }
</style>
