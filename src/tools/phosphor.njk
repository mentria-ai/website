        <div class="ph-stack">
          <button type="button" class="ph-btn ph-btn--primary" id="ph-resume">{{ "tool.phosphor.paused_resume" | t }}</button>
          <button type="button" class="ph-btn" id="ph-pause-restart">{{ "tool.phosphor.paused_restart" | t }}</button>
          <button type="button" class="ph-btn" id="ph-pause-courses">{{ "tool.phosphor.back_to_courses" | t }}</button>
        </div>
        <p class="ph-ov__hint" id="ph-pause-note">{{ "tool.phosphor.paused_hint" | t }}</p>
        <div class="ph-ov__row">
          <button type="button" class="ph-btn ph-btn--sm ph-gfx" id="ph-gfx-pause" aria-pressed="false" title="{{ 'tool.phosphor.gfx_hint' | t }}">{{ "tool.phosphor.gfx_label" | t }}</button>
        </div>
      </div>
    </div>

    <div class="ph-ov ph-ov--complete" id="ph-complete" hidden>
