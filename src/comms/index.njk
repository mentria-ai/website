const updatePushStatus = () => {
  if (!els.pushStatus) return;
  const bits = [];
  if (!window.MentriaPush || !MentriaPush.isSupported()) bits.push('not supported in this browser');
  else if (MentriaPush.permission() !== 'granted') bits.push('yours: off — use the enable banner in your people list');
  else bits.push(ringToken ? 'yours: on' : 'yours: registering…');
  CID.getContacts().forEach((c) => {
    bits.push(`${c.name || c.fp}: ${c.ring ? 'reachable' : 'no token yet — they need to enable notifications once'}`);
  });
  try {
    const lk = MentriaStore.get('comms', 'last_knock');
    if (lk && lk.t) bits.push(`last knock sent: ${hhmmOf(lk.t)} ${lk.ok ? '✓' : '✗ ' + (lk.reason || 'failed')}`);
  } catch (_) {}
  els.pushStatus.textContent = bits.join(' · ');
  if (window.MentriaPushDB && MentriaPushDB.kvGet) {
    MentriaPushDB.kvGet('last-push-at').then((t) => {
      if (typeof t === 'number' && t > 0) els.pushStatus.textContent += ` · last push received: ${hhmmOf(t)}`;
    }).catch(() => {});
  }
};

const pushTestLog = (line, replace) => {
  els.pushTestLog.hidden = false;
  if (replace) {
    const parts = els.pushTestLog.textContent.split('\n');
    parts[parts.length - 1] = line;
    els.pushTestLog.textContent = parts.join('\n');
  } else {
    els.pushTestLog.textContent += (els.pushTestLog.textContent ? '\n' : '') + line;
