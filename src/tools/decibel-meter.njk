---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/tools/decibel-meter/index.html"
eleventyComputed:
  lang: "{{ locale.code }}"
  title: "{{ 'tools.decibel-meter.title' | t }}"
  description: "{{ 'tools.decibel-meter.lede' | t }}"
---
<section class="hero" style="padding-top:1rem;">
  <p class="eyebrow eyebrow--crumbs"><a class="eyebrow__link" href="{{ locale.pathPrefix }}/">~</a><span class="eyebrow__sep">/</span><a class="eyebrow__link" href="{{ locale.pathPrefix }}/tools/">tools</a><span class="eyebrow__sep">/</span><span class="eyebrow__current">decibel-meter</span></p>
  <h1>{{ "tools.decibel-meter.title" | t }}</h1>
  <p>{{ "tools.decibel-meter.lede" | t }}</p>
  {% include "tldr.njk" %}
</section>

{% set terminalTitle = "decibel-meter.js" %}
{% include "terminal-frame-open.njk" %}
<section class="db" id="db">

  <div class="db__live" id="db-live" hidden>
    <div class="db__gauge">
      <div class="db__scale" aria-hidden="true">
        <span class="db__tick" style="bottom:0%">30</span>
        <span class="db__tick" style="bottom:22.2%">50</span>
        <span class="db__tick" style="bottom:44.4%">70</span>
        <span class="db__tick" style="bottom:66.7%">90</span>
        <span class="db__tick" style="bottom:88.9%">110</span>
      </div>
      <div class="db__track" role="img" aria-label="{{ 'tool.decibel-meter.meter_aria' | t }}">
        <div class="db__fill" id="db-fill"></div>
        <div class="db__peak" id="db-peak"></div>
      </div>
      <div class="db__readout" id="db-readout" data-level="calm">
        <div class="db__value" id="db-value" aria-hidden="true">—</div>
        <div class="db__unit" aria-hidden="true">{{ "tool.decibel-meter.unit" | t }}</div>
        <div class="db__level" id="db-level"></div>
        <div class="db__slow">
          <span class="db__slow-label">{{ "tool.decibel-meter.slow_label" | t }}</span>
          <span class="db__slow-value" id="db-slow">—</span>
        </div>
      </div>
    </div>

    <p class="db__sr" id="db-sr" role="status" aria-live="polite"></p>

    <div class="db__stats">
      <div class="db__stat">
        <span class="db__stat-label">{{ "tool.decibel-meter.stat_min" | t }}</span>
        <span class="db__stat-value" id="db-stat-min">—</span>
      </div>
      <div class="db__stat">
        <span class="db__stat-label">{{ "tool.decibel-meter.stat_avg" | t }}</span>
        <span class="db__stat-value" id="db-stat-avg">—</span>
      </div>
      <div class="db__stat">
        <span class="db__stat-label">{{ "tool.decibel-meter.stat_peak" | t }}</span>
        <span class="db__stat-value" id="db-stat-peak">—</span>
      </div>
    </div>

    <div class="db__controls">
      <button type="button" class="m-btn m-btn--primary m-btn--pill" id="db-stop">{{ "tool.decibel-meter.btn_stop" | t }}</button>
      <button type="button" class="m-btn m-btn--ghost m-btn--pill" id="db-reset">{{ "tool.decibel-meter.btn_reset_stats" | t }}</button>
    </div>

    <div class="db__cal">
      <label class="db__cal-label" for="db-cal">
        <span>{{ "tool.decibel-meter.calibration_label" | t }}</span>
        <span class="db__cal-value" id="db-cal-value">+90</span>
      </label>
      <input type="range" class="db__cal-range" id="db-cal" min="70" max="110" step="1" value="90">
      <p class="db__cal-hint">{{ "tool.decibel-meter.calibration_hint" | t }}</p>
    </div>

    <p class="db__hint">{{ "tool.decibel-meter.screen_hint" | t }}</p>
  </div>

  <div class="db__panel" id="db-start">
    <h2 class="db__panel-title">{{ "tool.decibel-meter.start_title" | t }}</h2>
    <p class="db__panel-body">{{ "tool.decibel-meter.start_body" | t }}</p>
    <p class="db__panel-err" id="db-start-err" hidden></p>
    <button type="button" class="m-btn m-btn--primary m-btn--pill" id="db-start-btn">{{ "tool.decibel-meter.btn_start" | t }}</button>
  </div>

  <div class="db__panel" id="db-denied" hidden>
    <h2 class="db__panel-title db__panel-title--warn">{{ "tool.decibel-meter.denied_title" | t }}</h2>
    <p class="db__panel-body">{{ "tool.decibel-meter.denied_body" | t }}</p>
    <button type="button" class="m-btn m-btn--ghost m-btn--pill" id="db-retry">{{ "tool.decibel-meter.btn_retry" | t }}</button>
  </div>

  <div class="db__panel" id="db-unsupported" hidden>
    <h2 class="db__panel-title db__panel-title--warn">{{ "tool.decibel-meter.unsupported_title" | t }}</h2>
    <p class="db__panel-body">{{ "tool.decibel-meter.unsupported_body" | t }}</p>
  </div>

  <div class="db__panel" id="db-insecure" hidden>
    <h2 class="db__panel-title db__panel-title--warn">{{ "tool.decibel-meter.insecure_title" | t }}</h2>
    <p class="db__panel-body">{{ "tool.decibel-meter.insecure_body" | t }}</p>
  </div>

  <div class="db__ref">
    <h2 class="db__ref-title">{{ "tool.decibel-meter.ladder_title" | t }}</h2>
    <ul class="db__ref-list" id="db-ref">
      <li class="db__ref-row" data-db="20"><span class="db__ref-db">20</span><span class="db__ref-label">{{ "tool.decibel-meter.ref_20" | t }}</span><span class="db__ref-now">{{ "tool.decibel-meter.ladder_now" | t }}</span></li>
      <li class="db__ref-row" data-db="30"><span class="db__ref-db">30</span><span class="db__ref-label">{{ "tool.decibel-meter.ref_30" | t }}</span><span class="db__ref-now">{{ "tool.decibel-meter.ladder_now" | t }}</span></li>
      <li class="db__ref-row" data-db="40"><span class="db__ref-db">40</span><span class="db__ref-label">{{ "tool.decibel-meter.ref_40" | t }}</span><span class="db__ref-now">{{ "tool.decibel-meter.ladder_now" | t }}</span></li>
      <li class="db__ref-row" data-db="50"><span class="db__ref-db">50</span><span class="db__ref-label">{{ "tool.decibel-meter.ref_50" | t }}</span><span class="db__ref-now">{{ "tool.decibel-meter.ladder_now" | t }}</span></li>
      <li class="db__ref-row" data-db="60"><span class="db__ref-db">60</span><span class="db__ref-label">{{ "tool.decibel-meter.ref_60" | t }}</span><span class="db__ref-now">{{ "tool.decibel-meter.ladder_now" | t }}</span></li>
      <li class="db__ref-row" data-db="70"><span class="db__ref-db">70</span><span class="db__ref-label">{{ "tool.decibel-meter.ref_70" | t }}</span><span class="db__ref-now">{{ "tool.decibel-meter.ladder_now" | t }}</span></li>
      <li class="db__ref-row" data-db="80"><span class="db__ref-db">80</span><span class="db__ref-label">{{ "tool.decibel-meter.ref_80" | t }}</span><span class="db__ref-now">{{ "tool.decibel-meter.ladder_now" | t }}</span></li>
      <li class="db__ref-row" data-db="90"><span class="db__ref-db">90</span><span class="db__ref-label">{{ "tool.decibel-meter.ref_90" | t }}</span><span class="db__ref-now">{{ "tool.decibel-meter.ladder_now" | t }}</span></li>
      <li class="db__ref-row" data-db="100"><span class="db__ref-db">100</span><span class="db__ref-label">{{ "tool.decibel-meter.ref_100" | t }}</span><span class="db__ref-now">{{ "tool.decibel-meter.ladder_now" | t }}</span></li>
      <li class="db__ref-row" data-db="110"><span class="db__ref-db">110</span><span class="db__ref-label">{{ "tool.decibel-meter.ref_110" | t }}</span><span class="db__ref-now">{{ "tool.decibel-meter.ladder_now" | t }}</span></li>
    </ul>
  </div>

  <div class="db__notes">
    <p class="db__note db__note--honesty">{{ "tool.decibel-meter.honesty_note" | t }}</p>
    <p class="db__note">{{ "tool.decibel-meter.privacy_note" | t }}</p>
  </div>

</section>
{% include "terminal-frame-close.njk" %}
{% include "tool-schema.njk" %}

<script>
(function () {
  'use strict';

  var LANG = document.documentElement.lang || undefined;

  var COPY = {
    errNoMic:     {{ ("tool.decibel-meter.err_no_mic"     | t) | dump | safe }},
    errGeneric:   {{ ("tool.decibel-meter.err_generic"    | t) | dump | safe }},
    levelCalm:    {{ ("tool.decibel-meter.level_calm"     | t) | dump | safe }},
    levelLoud:    {{ ("tool.decibel-meter.level_loud"     | t) | dump | safe }},
    levelHarmful: {{ ("tool.decibel-meter.level_harmful"  | t) | dump | safe }},
    liveAria:     {{ ("tool.decibel-meter.live_aria"      | t) | dump | safe }}
  };

  var STORE_NS = 'tools';
  var STORE_KEY = 'decibel_settings';
  var DB_MIN = 30;
  var DB_MAX = 120;
  var FLOOR_DBFS = -100;
  var EMA_ALPHA = 0.2;
  var SLOW_WINDOW_MS = 1000;
  var PEAK_HOLD_MS = 2000;
  var PEAK_DECAY_PER_S = 20;
  var SR_INTERVAL_MS = 2000;
  var OFFSET_MIN = 70;
  var OFFSET_MAX = 110;
  var OFFSET_DEFAULT = 90;

  function $(id) { return document.getElementById(id); }

  var liveEl = $('db-live');
  var startPanel = $('db-start');
  var deniedPanel = $('db-denied');
  var unsupPanel = $('db-unsupported');
  var insecPanel = $('db-insecure');
  var startBtn = $('db-start-btn');
  var startErrEl = $('db-start-err');
  var retryBtn = $('db-retry');
  var stopBtn = $('db-stop');
  var resetBtn = $('db-reset');
  var valueEl = $('db-value');
  var levelEl = $('db-level');
  var slowEl = $('db-slow');
  var fillEl = $('db-fill');
  var peakEl = $('db-peak');
  var readoutEl = $('db-readout');
  var srEl = $('db-sr');
  var statMinEl = $('db-stat-min');
  var statAvgEl = $('db-stat-avg');
  var statPeakEl = $('db-stat-peak');
  var calInput = $('db-cal');
  var calValueEl = $('db-cal-value');
  var refRows = Array.prototype.slice.call(document.querySelectorAll('.db__ref-row'));

  var offset = OFFSET_DEFAULT;

  function loadSettings() {
    try {
      var s = window.MentriaStore ? window.MentriaStore.get(STORE_NS, STORE_KEY) : null;
      if (s && typeof s.offset === 'number' && s.offset >= OFFSET_MIN && s.offset <= OFFSET_MAX) {
        offset = Math.round(s.offset);
      }
    } catch (_) {}
  }

  function saveSettings() {
    try {
      if (window.MentriaStore) window.MentriaStore.set(STORE_NS, STORE_KEY, { offset: offset });
    } catch (_) {}
  }

  var audioCtx = null;
  var analyser = null;
  var micSource = null;
  var stream = null;
  var buf = null;
  var rafId = null;
  var running = false;

  var fastDbfs = null;
  var slowTimes = [];
  var slowPowers = [];
  var statMinDbfs = null;
  var statPeakDbfs = null;
  var statPowerSum = 0;
  var statFrames = 0;
  var peakDbfs = null;
  var peakAt = 0;
  var lastFrameAt = 0;
  var lastSrAt = 0;
  var currentRefRow = null;
  var currentLevel = '';

  function toDisplay(dbfs) {
    var v = dbfs + offset;
    return v < 0 ? 0 : v;
  }

  function toPercent(v) {
    var p = ((v - DB_MIN) / (DB_MAX - DB_MIN)) * 100;
    if (p < 0) return 0;
    if (p > 100) return 100;
    return p;
  }

  function levelOf(v) {
    if (v < 70) return 'calm';
    if (v <= 85) return 'loud';
    return 'harmful';
  }

  function fmt1(v) {
    return v.toLocaleString(LANG, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  }

  function powerToDbfs(power) {
    if (!(power > 0)) return FLOOR_DBFS;
    var d = 10 * Math.log10(power);
    return d < FLOOR_DBFS ? FLOOR_DBFS : d;
  }

  function resetStats() {
    statMinDbfs = null;
    statPeakDbfs = null;
    statPowerSum = 0;
    statFrames = 0;
    peakDbfs = fastDbfs;
    peakAt = lastFrameAt;
    renderStats();
  }

  function renderStats() {
    statMinEl.textContent = statMinDbfs === null ? '—' : fmt1(toDisplay(statMinDbfs));
    statPeakEl.textContent = statPeakDbfs === null ? '—' : fmt1(toDisplay(statPeakDbfs));
    statAvgEl.textContent = statFrames === 0 ? '—' : fmt1(toDisplay(powerToDbfs(statPowerSum / statFrames)));
  }

  function highlightRef(v) {
    var best = null;
    var bestDist = Infinity;
    for (var i = 0; i < refRows.length; i++) {
      var d = Math.abs(parseFloat(refRows[i].getAttribute('data-db')) - v);
      if (d < bestDist) { bestDist = d; best = refRows[i]; }
    }
    if (best === currentRefRow) return;
    if (currentRefRow) currentRefRow.classList.remove('is-current');
    if (best) best.classList.add('is-current');
    currentRefRow = best;
  }

  function clearRefHighlight() {
    if (currentRefRow) currentRefRow.classList.remove('is-current');
    currentRefRow = null;
  }

  function render(now, fast, slow) {
    var v = toDisplay(fast);
    var sv = toDisplay(slow);
    valueEl.textContent = Math.round(v).toLocaleString(LANG);
    slowEl.textContent = fmt1(sv);
    fillEl.style.clipPath = 'inset(' + (100 - toPercent(v)).toFixed(2) + '% 0 0 0)';
    peakEl.style.bottom = toPercent(toDisplay(peakDbfs === null ? fast : peakDbfs)) + '%';

    var lvl = levelOf(v);
    if (lvl !== currentLevel) {
      currentLevel = lvl;
      readoutEl.setAttribute('data-level', lvl);
      levelEl.textContent = lvl === 'calm' ? COPY.levelCalm : (lvl === 'loud' ? COPY.levelLoud : COPY.levelHarmful);
    }

    renderStats();
    highlightRef(sv);

    if (now - lastSrAt >= SR_INTERVAL_MS) {
      lastSrAt = now;
      srEl.textContent = COPY.liveAria.replace('{db}', Math.round(v).toLocaleString(LANG));
    }
  }

  function frame(now) {
    if (!running || !analyser || !buf) return;
    rafId = requestAnimationFrame(frame);

    analyser.getFloatTimeDomainData(buf);
    var sum = 0;
    for (var i = 0; i < buf.length; i++) sum += buf[i] * buf[i];
    var power = sum / buf.length;
    var dbfs = powerToDbfs(power);

    fastDbfs = fastDbfs === null ? dbfs : fastDbfs + (dbfs - fastDbfs) * EMA_ALPHA;

    slowTimes.push(now);
    slowPowers.push(power);
    while (slowTimes.length > 1 && now - slowTimes[0] > SLOW_WINDOW_MS) {
      slowTimes.shift();
      slowPowers.shift();
    }
    var slowSum = 0;
    for (var j = 0; j < slowPowers.length; j++) slowSum += slowPowers[j];
    var slowDbfs = powerToDbfs(slowSum / slowPowers.length);

    statPowerSum += power;
    statFrames += 1;
    if (statMinDbfs === null || fastDbfs < statMinDbfs) statMinDbfs = fastDbfs;
    if (statPeakDbfs === null || fastDbfs > statPeakDbfs) statPeakDbfs = fastDbfs;

    var dt = lastFrameAt ? (now - lastFrameAt) / 1000 : 0;
    lastFrameAt = now;
    if (peakDbfs === null || fastDbfs >= peakDbfs) {
      peakDbfs = fastDbfs;
      peakAt = now;
    } else if (now - peakAt > PEAK_HOLD_MS) {
      var decayed = peakDbfs - PEAK_DECAY_PER_S * dt;
      peakDbfs = decayed < fastDbfs ? fastDbfs : decayed;
    }

    render(now, fastDbfs, slowDbfs);
  }

  var wakeLock = null;
  function syncWakeLock() {
    if (!('wakeLock' in navigator)) return;
    if (running) {
      if (wakeLock) return;
      navigator.wakeLock.request('screen').then(function (lock) {
        wakeLock = lock;
        lock.addEventListener('release', function () { wakeLock = null; });
        if (!running) {
          try { lock.release(); } catch (_) {}
          wakeLock = null;
        }
      }).catch(function () { wakeLock = null; });
    } else if (wakeLock) {
      try { wakeLock.release(); } catch (_) {}
      wakeLock = null;
    }
  }
  document.addEventListener('visibilitychange', function () {
    if (document.visibilityState === 'visible') syncWakeLock();
  });

  function showPanel(name) {
    liveEl.hidden = name !== 'live';
    startPanel.hidden = name !== 'start';
    deniedPanel.hidden = name !== 'denied';
    unsupPanel.hidden = name !== 'unsupported';
    insecPanel.hidden = name !== 'insecure';
  }

  function setStartError(text) {
    startErrEl.textContent = text || '';
    startErrEl.hidden = !text;
  }

  function stop() {
    running = false;
    if (rafId) {
      cancelAnimationFrame(rafId);
      rafId = null;
    }
    if (stream) {
      var tracks = stream.getTracks();
      for (var i = 0; i < tracks.length; i++) {
        try { tracks[i].stop(); } catch (_) {}
      }
      stream = null;
    }
    if (micSource) {
      try { micSource.disconnect(); } catch (_) {}
      micSource = null;
    }
    analyser = null;
    buf = null;
    if (audioCtx) {
      var ctx = audioCtx;
      audioCtx = null;
      try {
        var closing = ctx.close();
        if (closing && closing.catch) closing.catch(function () {});
      } catch (_) {}
    }
    syncWakeLock();
    clearRefHighlight();
    showPanel('start');
  }

  function startSession() {
    if (!window.isSecureContext) { showPanel('insecure'); return; }
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) { showPanel('unsupported'); return; }
    var Ctx = window.AudioContext || window.webkitAudioContext;
    if (!Ctx) { showPanel('unsupported'); return; }

    setStartError('');
    startBtn.disabled = true;

    var ctx;
    try {
      ctx = new Ctx();
    } catch (_) {
      startBtn.disabled = false;
      showPanel('unsupported');
      return;
    }

    var acquired = null;
    navigator.mediaDevices.getUserMedia({
      audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false }
    }).then(function (mediaStream) {
      acquired = mediaStream;
      var resumed = ctx.state === 'suspended' ? ctx.resume() : null;
      var settled = resumed && resumed.then ? resumed : Promise.resolve();
      return settled.catch(function () {}).then(function () { return mediaStream; });
    }).then(function (mediaStream) {
      audioCtx = ctx;
      stream = mediaStream;
      analyser = ctx.createAnalyser();
      analyser.fftSize = 2048;
      analyser.smoothingTimeConstant = 0;
      buf = new Float32Array(analyser.fftSize);
      micSource = ctx.createMediaStreamSource(mediaStream);
      micSource.connect(analyser);

      fastDbfs = null;
      slowTimes = [];
      slowPowers = [];
      statMinDbfs = null;
      statPeakDbfs = null;
      statPowerSum = 0;
      statFrames = 0;
      peakDbfs = null;
      peakAt = 0;
      lastFrameAt = 0;
      lastSrAt = 0;
      currentLevel = '';
      renderStats();

      acquired = null;
      running = true;
      startBtn.disabled = false;
      showPanel('live');
      syncWakeLock();
      rafId = requestAnimationFrame(frame);
    }).catch(function (err) {
      startBtn.disabled = false;
      if (acquired) {
        var tracks = acquired.getTracks();
        for (var i = 0; i < tracks.length; i++) {
          try { tracks[i].stop(); } catch (_) {}
        }
        acquired = null;
      }
      stream = null;
      micSource = null;
      analyser = null;
      buf = null;
      try {
        var closing = ctx.close();
        if (closing && closing.catch) closing.catch(function () {});
      } catch (_) {}
      audioCtx = null;
      var name = err && err.name;
      if (name === 'NotAllowedError' || name === 'SecurityError') {
        showPanel('denied');
      } else if (name === 'NotFoundError' || name === 'OverconstrainedError' || name === 'NotReadableError') {
        showPanel('start');
        setStartError(COPY.errNoMic);
      } else {
        showPanel('start');
        setStartError(COPY.errGeneric);
      }
    });
  }

  startBtn.addEventListener('click', startSession);
  stopBtn.addEventListener('click', stop);
  resetBtn.addEventListener('click', resetStats);
  retryBtn.addEventListener('click', function () {
    setStartError('');
    showPanel('start');
  });

  calInput.addEventListener('input', function () {
    var v = parseInt(calInput.value, 10);
    if (!(v >= OFFSET_MIN && v <= OFFSET_MAX)) return;
    offset = v;
    calValueEl.textContent = '+' + v;
    renderStats();
  });
  calInput.addEventListener('change', saveSettings);

  window.addEventListener('pagehide', function () {
    if (running) stop();
  });

  loadSettings();
  calInput.value = String(offset);
  calValueEl.textContent = '+' + offset;
  renderStats();

  if (!window.isSecureContext) showPanel('insecure');
  else if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) showPanel('unsupported');
  else showPanel('start');
})();
</script>

<style>
.db {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-5);
  font-family: var(--font-mono);
  max-width: 480px;
  margin: 0 auto;
  padding: var(--space-2) 0 var(--space-4);
}

.db__live {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-5);
  width: 100%;
}
.db__live[hidden] { display: none; }

.db__gauge {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  width: 100%;
}

.db__scale {
  position: relative;
  width: 2.1rem;
  height: 240px;
  flex: none;
}
.db__tick {
  position: absolute;
  right: 0;
  transform: translateY(50%);
  font-size: var(--text-2xs);
  color: var(--term-muted);
  font-variant-numeric: tabular-nums;
}

.db__track {
  position: relative;
  width: 30px;
  flex: none;
  height: 240px;
  border: 1px solid var(--term-border);
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.03);
  overflow: hidden;
}

.db__fill {
  position: absolute;
  inset: 0;
  clip-path: inset(100% 0 0 0);
  transition: clip-path 90ms linear;
  background: linear-gradient(
    to top,
    #34d399 0%,
    #4ade80 40%,
    #fbbf24 46%,
    #fbbf24 58%,
    #f87171 66%,
    #ef4444 100%
  );
}

.db__peak {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 3px;
  background: var(--term-fg-strong);
  box-shadow: 0 0 8px rgba(248, 250, 252, 0.55);
  transition: bottom 120ms linear;
}

.db__readout {
