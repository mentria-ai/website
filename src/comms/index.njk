let scanStream = null;
let scanRaf = null;
let scanDetector = null;
let scanCanvas = null;
let scanCtx = null;
let scanTrack = null;
let scanFocusCaps = null;
let scanFocusBusy = false;
let scanMisses = 0;
let scanTorchOn = false;

const setupScanTrack = () => {
  scanTrack = scanStream && scanStream.getVideoTracks ? scanStream.getVideoTracks()[0] : null;
  scanFocusCaps = null;
  els.scanZoomWrap.hidden = true;
  els.scanTorch.hidden = true;
  scanTorchOn = false;
  els.scanTorch.setAttribute('aria-pressed', 'false');
  els.scanTorch.classList.remove('is-on');
  if (!scanTrack || !scanTrack.getCapabilities) return;
  let caps;
  try { caps = scanTrack.getCapabilities(); } catch (_) { return; }
  const modes = caps.focusMode && caps.focusMode.indexOf ? caps.focusMode : [];
  scanFocusCaps = {
    continuous: modes.indexOf('continuous') >= 0,
    singleShot: modes.indexOf('single-shot') >= 0,
    manualNear: null
  };
  if (modes.indexOf('manual') >= 0 && caps.focusDistance &&
      typeof caps.focusDistance.min === 'number' && caps.focusDistance.max > caps.focusDistance.min) {
    scanFocusCaps.manualNear = caps.focusDistance.min + (caps.focusDistance.max - caps.focusDistance.min) * 0.08;
  }
  if (!scanFocusCaps.continuous && !scanFocusCaps.singleShot && scanFocusCaps.manualNear === null) scanFocusCaps = null;
  if (scanFocusCaps && scanFocusCaps.continuous) {
    scanTrack.applyConstraints({ advanced: [{ focusMode: 'continuous' }] }).catch(() => {});
  }
  if (caps.torch) els.scanTorch.hidden = false;
  if (caps.zoom && typeof caps.zoom.min === 'number' && caps.zoom.max > caps.zoom.min) {
    const settings = scanTrack.getSettings ? scanTrack.getSettings() : {};
    els.scanZoom.min = caps.zoom.min;
    els.scanZoom.max = Math.min(caps.zoom.max, caps.zoom.min * 5);
    els.scanZoom.step = 0.1;
    els.scanZoom.value = typeof settings.zoom === 'number' ? settings.zoom : caps.zoom.min;
    els.scanZoomWrap.hidden = false;
  }
};

const restoreScanFocus = () => {
  scanFocusBusy = false;
  if (scanTrack && scanFocusCaps && scanFocusCaps.continuous) {
    scanTrack.applyConstraints({ advanced: [{ focusMode: 'continuous' }] }).catch(() => {});
  }
};

const nudgeScanFocus = () => {
  if (!scanTrack || !scanFocusCaps || scanFocusBusy) return;
  if (scanFocusCaps.manualNear !== null) {
    scanFocusBusy = true;
    scanTrack.applyConstraints({ advanced: [{ focusMode: 'manual', focusDistance: scanFocusCaps.manualNear }] })
      .then(() => { setTimeout(restoreScanFocus, 900); })
      .catch(() => { scanFocusBusy = false; });
  } else if (scanFocusCaps.singleShot) {
    scanFocusBusy = true;
    scanTrack.applyConstraints({ advanced: [{ focusMode: 'single-shot' }] })
      .then(() => { setTimeout(restoreScanFocus, 900); })
      .catch(() => { scanFocusBusy = false; });
  } else if (scanFocusCaps.continuous) {
    scanTrack.applyConstraints({ advanced: [{ focusMode: 'continuous' }] }).catch(() => {});
  }
};

const loadJsQR = () => new Promise((resolve) => {
  if (window.jsQR) { resolve(true); return; }
  const s = document.createElement('script');
  s.src = '/assets/js/jsqr.js?v={{ buildHash }}';
  s.onload = () => resolve(!!window.jsQR);
  s.onerror = () => resolve(false);
  document.head.appendChild(s);
});

const stopScan = () => {
  els.scan.hidden = false;
  if (scanRaf) { cancelAnimationFrame(scanRaf); scanRaf = null; }
  if (scanStream) { scanStream.getTracks().forEach((t) => { try { t.stop(); } catch (_) {} }); scanStream = null; }
  scanTrack = null;
  scanFocusCaps = null;
  scanFocusBusy = false;
  try { els.scanVideo.srcObject = null; } catch (_) {}
  els.scanWrap.hidden = true;
};

const handleScanned = async (value) => {
  const raw = String(value || '').trim();
  const idx = raw.indexOf('MC1.');
  if (idx === -1) { els.scanNote.textContent = 'that code isn\'t a mentria contact code — keep pointing at their screen'; return false; }
  stopScan();
  els.contactIn.value = raw.slice(idx);
  els.contactAdd.click();
  return true;
};

const scanTick = async () => {
  if (!scanStream) return;
  const v = els.scanVideo;
  if (v.readyState >= 2 && v.videoWidth) {
    scanMisses++;
    if (scanMisses % 48 === 0) nudgeScanFocus();
    try {
      if (scanDetector) {
        const found = await scanDetector.detect(v);
        if (found && found.length && await handleScanned(found[0].rawValue)) return;
      } else if (window.jsQR) {
        if (!scanCanvas) { scanCanvas = document.createElement('canvas'); scanCtx = scanCanvas.getContext('2d', { willReadFrequently: true }); }
        const w = Math.min(560, v.videoWidth), h = Math.round(v.videoHeight * (w / v.videoWidth));
        scanCanvas.width = w; scanCanvas.height = h;
        scanCtx.drawImage(v, 0, 0, w, h);
        const img = scanCtx.getImageData(0, 0, w, h);
        const r = window.jsQR(img.data, w, h, { inversionAttempts: 'dontInvert' });
        if (r && r.data && await handleScanned(r.data)) return;
      }
    } catch (_) {}
  }
  scanRaf = requestAnimationFrame(scanTick);
};

els.scan.addEventListener('click', async () => {
  if (scanStream) { stopScan(); return; }
  els.scan.hidden = true;
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    els.scanWrap.hidden = false;
    els.scanNote.textContent = 'this browser can\'t open the camera — paste their code instead';
    return;
  }
  els.scanWrap.hidden = false;
  els.scanNote.textContent = 'starting camera…';
  try {
    scanStream = await navigator.mediaDevices.getUserMedia({
      video: { facingMode: 'environment', width: { ideal: 1920 }, height: { ideal: 1080 } }
    });
  } catch (_) {
    els.scanNote.textContent = 'camera permission denied — paste their code instead';
    return;
  }
  els.scanVideo.srcObject = scanStream;
  setupScanTrack();
  scanMisses = 0;
  try { await els.scanVideo.play(); } catch (_) {}
  scanDetector = null;
  if ('BarcodeDetector' in window) {
    try {
      const formats = await BarcodeDetector.getSupportedFormats();
      if (formats.includes('qr_code')) scanDetector = new BarcodeDetector({ formats: ['qr_code'] });
    } catch (_) {}
  }
  if (!scanDetector) await loadJsQR();
  els.scanNote.textContent = 'point the camera at their “my code” screen';
  scanTick();
});

els.scanStop.addEventListener('click', stopScan);

els.scanZoom.addEventListener('input', () => {
  if (!scanTrack) return;
  scanTrack.applyConstraints({ advanced: [{ zoom: parseFloat(els.scanZoom.value) }] }).catch(() => {});
});

els.scanTorch.addEventListener('click', () => {
  scanTorchOn = !scanTorchOn;
  els.scanTorch.setAttribute('aria-pressed', String(scanTorchOn));
  els.scanTorch.classList.toggle('is-on', scanTorchOn);
  if (scanTrack) scanTrack.applyConstraints({ advanced: [{ torch: scanTorchOn }] }).catch(() => {});
});

const leaveRoom = async () => {
  stopScan();
  await joinNew(null, null, { leave: true });
};

els.leave.addEventListener('click', leaveRoom);

els.idCopy.addEventListener('click', async () => {
  try {
    await navigator.clipboard.writeText(els.idCode.textContent);
    els.idCopy.textContent = 'copied';
    setTimeout(() => { els.idCopy.textContent = 'copy code'; }, 1200);
  } catch {}
});

els.idContacts.addEventListener('click', () => {
  els.contacts.hidden = !els.contacts.hidden;
  els.idContacts.setAttribute('aria-expanded', String(!els.contacts.hidden));
  renderContacts();
});

let dmOpening = false;
const openDmWith = async (c) => {
  if (!myId || dmOpening) return;
  dmOpening = true;
  els.chatTitle.textContent = c.name || c.fp;
  paintAvatar(els.chatAvatar, c.name || c.fp, c.fp);
  els.status.textContent = 'connecting…';
  setView('chat');
  try {
    const { roomName, b64Key } = await CID.deriveDm(myId.privateKey, c.pub);
    els.room.value = roomName;
    clearUnreadFor(c.fp);
    renderContacts();
    await joinNew(roomName, b64Key, { share: false, contact: c });
  } catch (err) {
    sys('could not open the chat: ' + err.message);
  } finally {
    dmOpening = false;
  }
};

const renderContacts = () => {
  if (!els.contactList) return;
  els.contactList.innerHTML = '';

  const requests = CID.getRequests();
  requests.forEach((r) => {
    const row = document.createElement('div');
    row.className = 'comms__contact comms__contact--req';
    const av = document.createElement('span');
    av.className = 'comms__avatar';
    paintAvatar(av, r.name, r.fp);
    const mid = document.createElement('span');
    mid.className = 'comms__contact-mid';
    const name = document.createElement('span');
    name.className = 'comms__contact-name';
    name.textContent = r.name || '(unnamed)';
    const sub = document.createElement('span');
    sub.className = 'comms__contact-fp';
    sub.textContent = 'wants to connect · ' + r.fp;
    mid.append(name, sub);
    const ok = document.createElement('button');
    ok.type = 'button';
    ok.className = 'comms__btn';
    ok.textContent = 'accept';
    ok.addEventListener('click', async () => {
      try {
        const added = await CID.addContact(r);
        CID.dropRequest(r.fp);
        renderContacts();
        subscribeUnread();
        if (added) announceToContact(added);
      } catch (err) {
        sys('could not accept: ' + err.message);
      }
    });
    const no = document.createElement('button');
    no.type = 'button';
    no.className = 'comms__btn comms__btn--ghost';
    no.textContent = 'ignore';
    no.addEventListener('click', () => { CID.dropRequest(r.fp); renderContacts(); });
    row.append(av, mid, ok, no);
    els.contactList.append(row);
  });

  const contacts = CID.getContacts();
  if (!contacts.length && !requests.length) {
    const empty = document.createElement('div');
    empty.className = 'comms__id-note comms__contacts-empty';
    empty.textContent = 'no one here yet — share “my code” with someone, or use “add someone” to scan or paste theirs.';
    els.contactList.append(empty);
    return;
  }
  contacts.forEach((c) => {
    const row = document.createElement('div');
    row.className = 'comms__contact';
    row.setAttribute('role', 'button');
    row.setAttribute('tabindex', '0');
    row.dataset.fp = c.fp;
    row.setAttribute('aria-label', 'chat with ' + (c.name || c.fp));
    const av = document.createElement('span');
    av.className = 'comms__avatar';
    paintAvatar(av, c.name, c.fp);
    const mid = document.createElement('span');
    mid.className = 'comms__contact-mid';
    const name = document.createElement('span');
    name.className = 'comms__contact-name';
    name.textContent = c.name || '(unnamed)';
    const sub = document.createElement('span');
    sub.className = 'comms__contact-fp';
    sub.textContent = c.fp;
    mid.append(name, sub);
    row.append(av, mid);
    const unread = (unreadMap[c.fp] && unreadMap[c.fp].n) || 0;
    if (unread > 0) {
      const badge = document.createElement('span');
      badge.className = 'comms__unread';
      badge.textContent = unread > 99 ? '99+' : String(unread);
      badge.title = unread + ' unread';
      row.append(badge);
    }
    const rm = document.createElement('button');
    rm.type = 'button';
    rm.className = 'comms__rowbtn';
    rm.title = 'remove ' + (c.name || c.fp);
    rm.setAttribute('aria-label', 'remove ' + (c.name || c.fp));
    rm.innerHTML = '<svg class="comms__i" aria-hidden="true"><use href="#ci-trash"></use></svg>';
    rm.addEventListener('click', async (e) => {
      e.stopPropagation();
      const ok = await (typeof mentriaConfirm === 'function' ? mentriaConfirm('Remove ' + (c.name || c.fp) + ' from contacts?') : Promise.resolve(true));
      if (!ok) return;
      CID.removeContact(c.fp);
      renderContacts();
      renderPeerList();
    });
    const chev = document.createElement('span');
    chev.className = 'comms__chev';
    chev.innerHTML = '<svg class="comms__i" aria-hidden="true"><use href="#ci-chev"></use></svg>';
    row.append(rm, chev);
    row.addEventListener('click', () => openDmWith(c));
    row.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openDmWith(c); }
    });
    els.contactList.append(row);
  });
};

els.contactAdd.addEventListener('click', async () => {
  try {
    const payload = CID.decodeContactCode(els.contactIn.value);
    const saved = await CID.addContact(payload);
    els.contactIn.value = '';
    renderContacts();
    subscribeUnread();
    const reached = await announceToContact(saved);
    sys(reached
      ? `contact added: ${saved.name || saved.fp} — they'll see your request next time they open comms.`
      : `contact added: ${saved.name || saved.fp}`);
  } catch (err) {
    sys('could not add contact: ' + err.message);
  }
});
els.contactIn.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); els.contactAdd.click(); } });

const RECOVERY_ALPHA = 'abcdefghjkmnpqrstuvwxyz23456789';
const makeRecoveryCode = () => {
  const bytes = crypto.getRandomValues(new Uint8Array(20));
  let out = '';
  for (let i = 0; i < 20; i++) {
    if (i && i % 5 === 0) out += '-';
    out += RECOVERY_ALPHA[bytes[i] % RECOVERY_ALPHA.length];
  }
  return out;
};

const cryptoOk = () => !!(window.MentriaIdentity && MentriaIdentity.cryptoReady && MentriaIdentity.cryptoReady());

const showOnboardStep = (which) => {
  const step = cryptoOk() ? which : 'insecure';
  els.obInsecure.hidden = step !== 'insecure';
  els.obIntro.hidden = step !== 'intro';
  els.obForm.hidden = step !== 'form';
  els.obDone.hidden = step !== 'done';
};

els.obStart.addEventListener('click', () => {
  showOnboardStep('form');
  els.obName.focus();
});

els.obName.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); els.obCreate.click(); } });

const setOnboardMethod = (ok) => {
  els.obMethod.textContent = ok
    ? 'Your device lock now unlocks comms — no password to remember.'
    : 'This device can\'t use a passkey for encryption yet, so your recovery code is how you unlock.';
  els.obPasskey.hidden = ok;
};

els.obCreate.addEventListener('click', async () => {
  const name = (els.obName.value || '').trim().slice(0, 32);
  if (!name) { els.obErr.hidden = false; els.obErr.textContent = 'pick a name first — it\'s only shared with people you add.'; els.obName.focus(); return; }
  els.obErr.hidden = true;
  els.obCreate.disabled = true;
  const prevLabel = els.obCreate.textContent;
  els.obCreate.textContent = 'setting up…';
  try {
    const code = makeRecoveryCode();
    await window.MentriaIdentity.setup(code);
    CID.setProfile({ name });
    let passkeyOk = false;
    try { await window.MentriaIdentity.enrollPasskey(); passkeyOk = true; } catch (_) { passkeyOk = false; }
    els.obCode.textContent = code;
    setOnboardMethod(passkeyOk);
    showOnboardStep('done');
    await initIdentity();
  } catch (err) {
    const code = err && err.message;
    els.obErr.hidden = false;
    els.obErr.textContent = code === 'insecure-context'
      ? 'this page needs an https address before it can create keys — open https://mentria.ai/comms/'
      : 'could not set up: ' + (code || err);
    if (code === 'insecure-context') showOnboardStep('insecure');
  } finally {
    els.obCreate.disabled = false;
    els.obCreate.textContent = prevLabel;
  }
});

els.obPasskey.addEventListener('click', async () => {
  els.obPasskey.disabled = true;
  try {
    await window.MentriaIdentity.enrollPasskey();
    setOnboardMethod(true);
  } catch (err) {
    const code = err && err.message;
    els.obMethod.textContent = code === 'prf-unsupported'
      ? 'This device can\'t use a passkey for encryption yet, so your recovery code is how you unlock.'
      : 'That didn\'t work — your recovery code still unlocks everything. You can try again in identity settings.';
    els.obPasskey.hidden = true;
  } finally {
    els.obPasskey.disabled = false;
  }
});

els.obCopy.addEventListener('click', async () => {
  try {
    await navigator.clipboard.writeText(els.obCode.textContent || '');
    els.obCopy.textContent = 'copied';
    setTimeout(() => { els.obCopy.textContent = 'copy code'; }, 1600);
  } catch (_) {}
});

els.obContinue.addEventListener('click', () => {
  onboardDone = true;
  onboardActive = false;
  refreshIdUI();
  if (!hasRoomHash()) els.contactIn.focus();
});

els.setupHere.addEventListener('click', () => {
  onboardDone = false;
  onboardActive = true;
  refreshIdUI();
  showOnboardStep('intro');
  els.onboard.scrollIntoView({ block: 'center', behavior: 'smooth' });
});

els.advToggle.addEventListener('click', () => {
  const open = els.adv.hidden;
  if (open) updatePushStatus();
  els.adv.hidden = !open;
  els.advToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  if (open) els.adv.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
});

els.newRoom.addEventListener('click', async () => {
  const name = EPHEMERAL_PREFIX + randomRoomSlug();
  const key = b64urlEncode(crypto.getRandomValues(new Uint8Array(32)));
  els.room.value = name;
  await joinNew(name, key);
  try {
    await navigator.clipboard.writeText(window.location.href);
    els.newRoom.textContent = 'link copied';
    setTimeout(() => { els.newRoom.textContent = 'new room link'; }, 2000);
  } catch (_) {}
});

refreshIdUI();
if (CID.idState() === 'unlocked') initIdentity();
else if (CID.idState() === 'locked' && window.MentriaIdentity && MentriaIdentity.tryDeviceUnlock) {
  MentriaIdentity.tryDeviceUnlock().then((ok) => { if (ok) initIdentity(); else refreshIdUI(); });
}

function randomRoomSlug() {
  const bytes = crypto.getRandomValues(new Uint8Array(5));
  const alpha = 'abcdefghijklmnopqrstuvwxyz234567';
  let bits = 0, value = 0, out = '';
  for (let i = 0; i < bytes.length; i++) {
    value = (value << 8) | bytes[i]; bits += 8;
    while (bits >= 5) { out += alpha[(value >>> (bits - 5)) & 0x1f]; bits -= 5; }
  }
  return out;
}

const bootHash = window.location.hash && window.location.hash !== '#' ? parseHash(window.location.hash) : null;
if (bootHash && isDmRoom(bootHash.room)) {
  window.history.replaceState(null, '', window.location.pathname + window.location.search);
}
const hasHash = !!bootHash && !isDmRoom(bootHash.room);
if (hasHash) {
  const parsed = bootHash;
  els.room.value = parsed.room;
  refreshShareUrl(parsed.room, parsed.b64Key);
  window.addEventListener('load', () => joinNew(parsed.room, parsed.b64Key));
} else {
  window.addEventListener('load', () => {
    if (CID.idState() === 'unlocked') sys('pick someone below to start a private chat — or open ⚙ for a shareable room link.');
  });
}
window.addEventListener('hashchange', () => {
  const next = parseHash(window.location.hash);
  if (isDmRoom(next.room)) {
    window.history.replaceState(null, '', window.location.pathname + window.location.search);
    refreshIdUI();
    return;
  }
  const sameRoom = next.room === (els.room.value || '').trim();
  const sameKey = next.b64Key === (chatKey ? next.b64Key : null);
  if (!sameRoom || !sameKey) {
    els.room.value = next.room;
    joinNew(next.room, next.b64Key);
  }
  refreshIdUI();
});
</script>
