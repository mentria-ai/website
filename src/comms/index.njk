const contactRow = (c, info, missedMap) => {
  const row = document.createElement('div');
  row.className = 'comms__contact' + (currentDmContact && currentDmContact.fp === c.fp ? ' comms__contact--current' : '');
  row.dataset.fp = c.fp;
  const av = document.createElement('span');
  av.className = 'comms__avatar';
  av.setAttribute('aria-hidden', 'true');
  paintAvatar(av, c.name, c.fp);
  const openBtn = document.createElement('button');
  openBtn.type = 'button';
  openBtn.className = 'comms__contact-open';
  openBtn.setAttribute('aria-label', fmt(T.people.chat_with, { name: c.name || c.fp }));
  const { mid } = rowMid(c.name || T.people.unnamed, info.preview || c.fp, info.ts);
  openBtn.append(mid);
  row.append(av, openBtn);
  const missed = missedMap[c.fp];
  if (missed && missed.n > 0) {
    const mc = document.createElement('span');
    mc.className = 'comms__missed';
    mc.title = missed.n > 1 ? fmt(T.people.missed_many, { n: missed.n }) : T.people.missed_one;
    mc.setAttribute('aria-label', mc.title);
    mc.innerHTML = '<svg class="comms__i" aria-hidden="true"><use href="#ci-phone"></use></svg>';
    row.append(mc);
  }
  if (info.unread > 0) row.append(unreadBadge(info.unread));
  const rm = document.createElement('button');
  rm.type = 'button';
  rm.className = 'comms__rowbtn';
  rm.title = fmt(T.people.remove, { name: c.name || c.fp });
  rm.setAttribute('aria-label', fmt(T.people.remove, { name: c.name || c.fp }));
  rm.innerHTML = '<svg class="comms__i" aria-hidden="true"><use href="#ci-trash"></use></svg>';
  rm.addEventListener('click', async (e) => {
    e.stopPropagation();
    const ok = await (typeof mentriaConfirm === 'function' ? mentriaConfirm(fmt(T.people.confirm_remove, { name: c.name || c.fp }), { danger: true }) : Promise.resolve(true));
    if (!ok) return;
    CID.removeContact(c.fp);
    dropStoredThreads((t) => t.kind === 'dm' && t.meta && t.meta.fp === c.fp);
    renderContacts();
    renderPeerList();
  });
  row.append(rm, rowChev());
  row.addEventListener('click', () => openDmWith(c));
  return row;
};

const roomRow = (r, info) => {
  const row = document.createElement('div');
  row.className = 'comms__contact comms__roomrow' + (currentRoomName === r.room ? ' comms__roomrow--current' : '');
  const av = document.createElement('span');
  av.className = 'comms__avatar comms__avatar--room';
  av.innerHTML = '<svg class="comms__i" aria-hidden="true"><use href="#ci-lock"></use></svg>';
  const openBtn = document.createElement('button');
  openBtn.type = 'button';
  openBtn.className = 'comms__contact-open';
  const { mid, name } = rowMid(r.label || r.room, info.preview || fmt(T.rooms.sub, { id: short(r.room) }), info.ts);
  openBtn.append(mid);
  row.append(av, openBtn);
  if (info.unread > 0 && currentRoomName !== r.room) row.append(unreadBadge(info.unread));
  const open = () => { if (currentRoomName !== r.room) openSavedRoom(r); setView('chat'); };
  row.addEventListener('click', open);
  const bell = document.createElement('button');
  bell.type = 'button';
  const alertsOn = !!r.notify;
  bell.className = 'comms__rowbtn comms__rowbtn--bell' + (alertsOn ? ' comms__rowbtn--on' : '');
  bell.title = alertsOn ? T.rooms.bell_on : T.rooms.bell_off;
  bell.setAttribute('aria-label', bell.title);
  bell.setAttribute('aria-pressed', String(alertsOn));
  bell.innerHTML = '<svg class="comms__i" aria-hidden="true"><use href="#ci-bell"></use></svg>';
  bell.addEventListener('click', (e) => { e.stopPropagation(); setRoomNotify(r.room, !alertsOn); });
  const ren = document.createElement('button');
  ren.type = 'button';
  ren.title = T.rooms.rename;
  ren.setAttribute('aria-label', T.rooms.rename_label);
  ren.textContent = T.rooms.rename;
  ren.className = 'comms__rowbtn comms__rowbtn--text';
  ren.addEventListener('click', (e) => {
    e.stopPropagation();
    const input = document.createElement('input');
    input.className = 'comms__input comms__room-rename';
    input.type = 'text';
    input.maxLength = 40;
    input.value = r.label || r.room;
    input.setAttribute('aria-label', T.rooms.name_label);
    let finished = false;
    const done = (save) => { if (finished) return; finished = true; if (save) renameRoom(r.room, input.value); renderContacts(); };
    input.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter' || ev.key === ' ' || ev.key === 'Escape') ev.stopPropagation();
      if (ev.key === 'Enter') { ev.preventDefault(); done(true); } else if (ev.key === 'Escape') { ev.preventDefault(); done(false); }
    });
    input.addEventListener('blur', () => done(true));
    input.addEventListener('click', (ev) => ev.stopPropagation());
    openBtn.replaceWith(mid);
    name.replaceWith(input);
    input.focus();
    input.select();
  });
  const rm = document.createElement('button');
  rm.type = 'button';
  rm.className = 'comms__rowbtn';
  rm.title = T.rooms.forget;
  rm.setAttribute('aria-label', T.rooms.forget);
  rm.innerHTML = '<svg class="comms__i" aria-hidden="true"><use href="#ci-trash"></use></svg>';
  rm.addEventListener('click', async (e) => {
    e.stopPropagation();
    const ok = await (typeof mentriaConfirm === 'function' ? mentriaConfirm(T.rooms.confirm_forget, { danger: true }) : Promise.resolve(true));
    if (!ok) return;
    forgetRoom(r.room);
    dropStoredThreads((t) => t.id === r.room);
    delete unreadMap[roomUnreadKey(r.room)];
    try { CID.setUnread(unreadMap); } catch (_) {}
    renderContacts();
    subscribeUnread();
  });
  const inv = document.createElement('button');
  inv.type = 'button';
  inv.className = 'comms__rowbtn';
  inv.title = T.invite.contact;
  inv.setAttribute('aria-label', T.invite.contact);
  inv.innerHTML = '<svg class="comms__i" aria-hidden="true"><use href="#ci-users"></use></svg>';
  inv.addEventListener('click', (e) => { e.stopPropagation(); inviteContact(r); });
  const lk = document.createElement('button');
  lk.type = 'button';
  lk.className = 'comms__rowbtn comms__rowbtn--text';
  lk.title = T.roomlock.go;
  lk.setAttribute('aria-label', T.roomlock.go);
  lk.textContent = T.roomlock.short;
  lk.hidden = !mySign;
  lk.addEventListener('click', (e) => { e.stopPropagation(); openLock(r.room); });
  row.append(bell, inv, lk, ren, rm);
  return row;
};

const joinSelf = async () => {
