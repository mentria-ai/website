<style>
.ph-wrap { margin: 1.25rem 0 2rem; }
.ph-stage {
  position: relative; width: 100%; aspect-ratio: 16 / 9;
  max-height: 76vh; max-height: 76svh;
  overflow: hidden; background: #04060a;
