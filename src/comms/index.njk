    if (myId && !sideWs) ensureSideSocket();
  }
});

if (navigator.serviceWorker) {
  navigator.serviceWorker.addEventListener('message', (e) => {
    const d = e && e.data;
    if (!d || !d.type) return;
    if (d.type === 'comms-unread') {
      updateLockWaiting();
      if (window.MentriaCommsNav) MentriaCommsNav.refresh();
    } else if (d.type === 'push-resubscribed') {
      MentriaStore.remove('comms', 'ring_announced');
      initRingToken();
    }
  });
}

const PK_LATER_KEY = 'passkey_offer_dismissed';
let pkSupportCache = null;
const passkeyPossible = async () => {
  if (pkSupportCache !== null) return pkSupportCache;
  try {
    const I = window.MentriaIdentity;
    const sup = I && I.passkeySupport ? await I.passkeySupport() : 'no';
    pkSupportCache = sup !== 'no' && !!window.isSecureContext;
  } catch { pkSupportCache = false; }
  return pkSupportCache;
};
const refreshPasskeyOffer = async (justUnlockedByCode) => {
