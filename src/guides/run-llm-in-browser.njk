<script type="module">
const $ = (id) => document.getElementById(id);
const runBtn = $('llm-demo-run');
const input = $('llm-demo-input');
const statusEl = $('llm-demo-status');
const out = $('llm-demo-out');
const stats = $('llm-demo-stats');
const NAMES = { '0.8b': 'Qwen3.5 0.8B', '2b': 'Qwen3.5 2B', '4b': 'Qwen3.5 4B', '27b': 'Bonsai 27B' };
const SYSTEM = 'You are a helpful assistant. Reply briefly in plain text, without markdown, headings or lists.';
const shareEl = $('llm-demo-share');
function browserName() {
  const brands = navigator.userAgentData && navigator.userAgentData.brands;
  const known = brands && brands.find((b) => /Edge|Opera|Brave|Chrome/.test(b.brand) && !/Not/.test(b.brand) && b.brand !== 'Chromium');
  const os = (navigator.userAgentData && navigator.userAgentData.platform) || ((navigator.userAgent.match(/Android|iPhone|iPad|Mac OS X|Windows|Linux|CrOS/) || [''])[0].replace('Mac OS X', 'macOS').replace('CrOS', 'ChromeOS'));
  let name = known ? known.brand + ' ' + known.version : '';
  if (!name) {
    const ua = navigator.userAgent;
    const m = ua.match(/Firefox\/(\d+)/) || ua.match(/Edg\/(\d+)/) || ua.match(/Chrome\/(\d+)/) || ua.match(/Version\/(\d+[.\d]*).*Safari/);
    name = m ? (/Firefox/.test(m[0]) ? 'Firefox ' : /Edg/.test(m[0]) ? 'Edge ' : /Chrome/.test(m[0]) ? 'Chrome ' : 'Safari ') + m[1] : '';
  }
  return [name, os].filter(Boolean).join(' on ');
}
async function gpuName() {
  try {
    const a = await navigator.gpu.requestAdapter();
    const i = a && (a.info || (a.requestAdapterInfo ? await a.requestAdapterInfo() : null));
    return i ? [i.vendor, i.architecture, i.description].filter(Boolean).join(' ') : '';
  } catch (_) { return ''; }
}
for (const b of document.querySelectorAll('.llm-demo__examples [data-prompt]')) {
  b.addEventListener('click', () => { input.value = b.dataset.prompt; input.focus(); });
}
if (!navigator.gpu) {
  runBtn.disabled = true;
  statusEl.textContent = "This browser doesn't support WebGPU yet. The table below shows which browsers do.";
} else {
  let Ask = null;
  try {
    Ask = await import('/assets/js/mentria-local-ask.js');
    const info = await Ask.modelInfo();
    statusEl.textContent = info.cached
      ? NAMES[info.tier] + ' is saved on this device.'
      : 'The first run downloads ' + NAMES[info.tier] + ' (' + info.sizeLabel + ') once.';
  } catch (_) {
    statusEl.textContent = '';
  }
  let busy = false;
  runBtn.addEventListener('click', async () => {
    const prompt = input.value.trim();
    if (!prompt || busy || !Ask) return;
    busy = true;
    runBtn.disabled = true;
    out.hidden = true;
    out.textContent = '';
    stats.hidden = true;
    shareEl.hidden = true;
    statusEl.textContent = 'Starting the model…';
    const onEvent = (e) => {
      const d = e.detail || {};
      if (d.phase === 'progress' && d.message) statusEl.textContent = d.message;
    };
    window.addEventListener('mentria:localask', onEvent);
    const loadedBefore = !!(Ask.debugState && Ask.debugState().loaded);
    const tStart = performance.now();
    let tFirst = 0;
    let tLast = 0;
    let tokens = 0;
    try {
      await Ask.askLocal(SYSTEM, prompt, {
        source: 'guide',
        noOffer: true,
        maxTokens: 200,
        onToken: (_, all) => {
          const now = performance.now();
          if (!tFirst) { tFirst = now; statusEl.textContent = 'Writing…'; out.hidden = false; }
          tLast = now;
          tokens += 1;
          out.textContent = all;
        }
      });
      const info = await Ask.modelInfo().catch(() => null);
      $('llm-demo-model').textContent = info ? NAMES[info.tier] : '';
      $('llm-demo-ttft-label').textContent = loadedBefore ? 'First word after' : 'Loaded and answering after';
      $('llm-demo-ttft').textContent = tFirst ? ((tFirst - tStart) / 1000).toFixed(1) + ' s' : '';
      $('llm-demo-speed').textContent = tokens > 1 && tLast > tFirst ? Math.round((tokens - 1) / ((tLast - tFirst) / 1000)) + ' tokens/s' : '';
      stats.hidden = false;
      statusEl.textContent = 'Done. Run it again, or try another prompt.';
      const speed = $('llm-demo-speed').textContent;
      if (speed) {
        const model = $('llm-demo-model').textContent;
        const lines = ['**Model:** ' + model, '**Speed:** ' + speed];
        if (loadedBefore) lines.push('**First word after:** ' + $('llm-demo-ttft').textContent);
        const browser = browserName();
        if (browser) lines.push('**Browser:** ' + browser);
        const gpu = await gpuName();
        if (gpu) lines.push('**GPU:** ' + gpu);
        lines.push('**Device:** (add your device, for example: MacBook Air M2, 16 GB)', '', 'Measured with the demo on https://mentria.ai/guides/run-llm-in-browser/');
        shareEl.href = 'https://github.com/mentria-ai/website/discussions/new?category=show-and-tell&title=' + encodeURIComponent('Benchmark: ' + model + ' at ' + speed) + '&body=' + encodeURIComponent(lines.join('\n'));
        shareEl.hidden = false;
      }
    } catch (e) {
      const msg = (e && e.message) || '';
      statusEl.textContent = msg === 'download-postponed' ? 'Download postponed. Run it again when you are on a faster connection.' : 'The model could not run here: ' + msg.slice(0, 120);
    } finally {
      window.removeEventListener('mentria:localask', onEvent);
      busy = false;
      runBtn.disabled = false;
    }
  });
}
</script>
