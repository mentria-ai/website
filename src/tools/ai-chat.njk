  async function fetchAdapterIndex() {
    if (adapterIndex && adapterIndex.tier === currentTier) return adapterIndex.entries;
    let entries = [];
    try {
      const res = await fetch(ADAPTER_INDEX_OVERRIDE || (adapterBase() + 'loras/index.json'), { cache: 'no-cache' });
      if (res.ok) {
        const raw = await res.json();
        entries = (Array.isArray(raw) ? raw : (raw && raw.adapters) || []).filter((e) => e && typeof e.name === 'string' && typeof e.path === 'string');
      }
    } catch (_) { entries = []; }
    adapterIndex = { tier: currentTier, entries };
    return entries;
  }

  async function sha256Hex(text) {
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
    return Array.from(new Uint8Array(buf)).map((b) => b.toString(16).padStart(2, '0')).join('');
  }

  function fmtBytes(n) {
    if (!(n > 0)) return '';
    return n >= 1048576 ? Math.round(n / 1048576) + ' MB' : Math.round(n / 1024) + ' KB';
  }

  function adapterMeta(e) {
    const parts = [];
    if (e.r) parts.push('r' + e.r);
    if (e.alpha) parts.push('α' + e.alpha);
    if (e.bytes) parts.push(fmtBytes(e.bytes));
    if (e.thinking && COPY.adaptersThinking[e.thinking]) parts.push(COPY.adaptersThinking[e.thinking]);
    if (e.date) parts.push(e.date);
    return parts.join(' · ');
  }

