  const grip = document.getElementById('ac-grip');
  const TUNE_URL = '/assets/js/mentria-tune.js';
  const TUNE_KEEP = ['messages', 'signal', 'images'];
  let gripOn = false;
  let tuneBusy = false;
  let tuneCount = 0;
  let tuneOverrides = {};
  let lastParams = null;
  let gripDrag = null;
  let lastTapAt = 0;
  const PULL_ARM = 34;
  const PULL_MAX = 64;

  function tuneActive() { return currentTier === '27b' && Object.keys(tuneOverrides).length > 0; }

  function syncGrip() {
    grip.hidden = !(gripOn && engine && currentTier === '27b');
    grip.classList.toggle('is-set', tuneActive());
  }

  function clearTune() {
    Object.keys(tuneOverrides).forEach((k) => { delete tuneOverrides[k]; });
    tuneCount = 0;
  }

  function resetTune() {
    gripOn = false;
    clearTune();
    lastParams = null;
    lastTapAt = 0;
    syncGrip();
  }

  function flashGrip(cls) {
    grip.classList.remove('is-run', 'is-ok', 'is-err');
    void grip.offsetWidth;
    grip.classList.add(cls);
    setTimeout(() => grip.classList.remove(cls), 1000);
  }

  function applyTune(params) {
    if (!tuneActive()) return;
    Object.keys(tuneOverrides).forEach((k) => { if (TUNE_KEEP.indexOf(k) < 0) params[k] = tuneOverrides[k]; });
  }

  async function runTune() {
    if (tuneBusy || !engine || currentTier !== '27b') return;
    tuneBusy = true;
    grip.classList.remove('is-ok', 'is-err');
    grip.classList.add('is-run');
    const started = performance.now();
    const settle = () => new Promise((r) => setTimeout(r, Math.max(0, 420 - (performance.now() - started))));
    const n = tuneCount + 1;
    try {
      const ctx = {
        engine: engine,
        tier: currentTier,
        maxSeq: contextTokens,
        count: n,
        adapter: pinned ? pinned.name : null,
        last: lastParams ? Object.assign({}, lastParams) : null,
        overrides: tuneOverrides,
        reset: () => { Object.keys(tuneOverrides).forEach((k) => { delete tuneOverrides[k]; }); }
      };
      window.__mentriaEngine = engine;
      window.__mentriaTune = ctx;
      const mod = await import(TUNE_URL + '?t=' + Date.now());
      const fn = typeof mod.default === 'function' ? mod.default : (typeof mod.tune === 'function' ? mod.tune : null);
      const res = fn ? await fn(ctx) : null;
      tuneCount = n;
      if (res && typeof res === 'object') Object.assign(tuneOverrides, res);
      TUNE_KEEP.forEach((k) => { delete tuneOverrides[k]; });
      if (prefixCache) prefixCache.invalidate();
      await settle();
      flashGrip('is-ok');
      if (navigator.vibrate) { try { navigator.vibrate([10, 40, 18]); } catch (_) {} }
    } catch (err) {
      console.warn('mentria-tune:', err);
      await settle();
      flashGrip('is-err');
    } finally {
      tuneBusy = false;
      syncGrip();
    }
  }

  function setPull(px, armed) {
    grip.style.setProperty('--pull', px + 'px');
    grip.style.setProperty('--pull-k', String(Math.min(1, Math.abs(px) / PULL_ARM)));
    grip.classList.toggle('is-armed', !!armed);
  }

  function endGrip(e, cancelled) {
    const d = gripDrag;
    if (!d || (e && e.pointerId !== d.id)) return;
    gripDrag = null;
    grip.classList.remove('is-drag');
    setPull(0, false);
    if (cancelled || tuneBusy) return;
    if (d.armed) { lastTapAt = 0; runTune(); return; }
    if (d.moved || Date.now() - d.t > 350) { lastTapAt = 0; return; }
    const now = Date.now();
    if (now - lastTapAt < 380) { lastTapAt = 0; runTune(); return; }
    lastTapAt = now;
  }

  grip.addEventListener('pointerdown', (e) => {
    if (tuneBusy || (e.pointerType === 'mouse' && e.button !== 0)) return;
    gripDrag = { id: e.pointerId, x: e.clientX, y: e.clientY, t: Date.now(), moved: false, armed: false };
    grip.classList.add('is-drag');
    try { grip.setPointerCapture(e.pointerId); } catch (_) {}
  });
  grip.addEventListener('pointermove', (e) => {
    const d = gripDrag;
    if (!d || e.pointerId !== d.id) return;
    const up = d.y - e.clientY;
    if (Math.abs(up) > 6 || Math.abs(e.clientX - d.x) > 6) d.moved = true;
    const lift = Math.max(0, up);
    const pull = lift <= PULL_ARM ? lift : PULL_ARM + (lift - PULL_ARM) * 0.3;
    const armed = lift >= PULL_ARM;
    if (armed && !d.armed && navigator.vibrate) { try { navigator.vibrate(8); } catch (_) {} }
    d.armed = armed;
    setPull(-Math.min(pull, PULL_MAX), armed);
  });
  grip.addEventListener('pointerup', (e) => endGrip(e, false));
  grip.addEventListener('pointercancel', (e) => endGrip(e, true));
  grip.addEventListener('contextmenu', (e) => e.preventDefault());

  function sendGesture() {
    if (engine && currentTier === '27b' && !adaptersPanel.hidden) {
      closeAdapters();
      gripOn = !gripOn;
      if (!gripOn && tuneActive()) { clearTune(); if (prefixCache) prefixCache.invalidate(); }
      syncGrip();
      return;
    }
    openAdapters();
  }

  let pressTimer = null;
  let longPressAt = 0;
  sendBtn.addEventListener('pointerdown', (e) => {
    if (e.pointerType === 'mouse' && e.button !== 0) return;
    clearTimeout(pressTimer);
    pressTimer = setTimeout(() => { longPressAt = Date.now(); sendGesture(); }, 500);
  });
  ['pointerup', 'pointerleave', 'pointercancel'].forEach((ev) => sendBtn.addEventListener(ev, () => clearTimeout(pressTimer)));
  sendBtn.addEventListener('contextmenu', (e) => { e.preventDefault(); clearTimeout(pressTimer); sendGesture(); });

  function markRoute(bodyEl, route) {
    if (!route) return;
    const bubble = bodyEl && bodyEl.closest ? bodyEl.closest('.ac__msg') : null;
    const label = bubble ? bubble.querySelector('.ac__msg-label') : null;
    if (label) label.textContent = label.textContent + ' · ' + (route === 'tool' ? COPY.routeTool : COPY.routeChat);
  }

  function parseToolCall(text) {
    const m = text.match(/<tool_call>\s*([\s\S]*?)\s*<\/tool_call>/);
    if (!m) return null;
    try {
      const call = JSON.parse(m[1]);
      const q = call && call.arguments && call.arguments.query;
      if (call && call.name === 'web_search' && typeof q === 'string' && q.trim()) return q.trim().slice(0, 200);
    } catch (_) {}
    return null;
  }

  function syncSearchToggle() {
    const cfg = getSearchCfg();
    if (!cfg || !cfg.url || pinned) { webSearchOn = false; }
    searchToggle.hidden = false;
    searchToggle.disabled = !!pinned;
    searchToggle.title = pinned ? COPY.searchPinned : cfg && cfg.url ? COPY.searchToggle : COPY.searchConfigure;
    searchToggle.setAttribute('aria-label', searchToggle.title);
    searchToggle.setAttribute('aria-pressed', String(webSearchOn));
  }

  function openSearchCfg() {
    const cfg = getSearchCfg();
    searchUrlEl.value = (cfg && cfg.url) || '';
    searchRemBtn.hidden = !(cfg && cfg.url);
    searchStatus.textContent = '';
    searchCfg.hidden = false;
    try { searchUrlEl.focus({ preventScroll: true }); } catch (_) {}
  }

  searchToggle.addEventListener('click', () => {
    const cfg = getSearchCfg();
    if (!cfg || !cfg.url) { openSearchCfg(); return; }
    if (!searchCfg.hidden) { searchCfg.hidden = true; }
    webSearchOn = !webSearchOn;
    syncSearchToggle();
  });

  searchToggle.addEventListener('contextmenu', (e) => { e.preventDefault(); openSearchCfg(); });

  async function testSearchUrl(url) {
    const prev = getSearchCfg();
    setSearchCfg({ url });
    try { return await runWebSearch('wikipedia', { allowEmpty: true }); }
    finally { setSearchCfg(prev); }
  }

  searchTestBtn.addEventListener('click', async () => {
    const url = searchUrlEl.value.trim();
    if (!LOCAL_URL_RE.test(url)) { searchStatus.textContent = COPY.searchLocalOnly; return; }
    searchTestBtn.disabled = true;
    searchStatus.textContent = '…';
    try {
      const results = await testSearchUrl(url);
      searchStatus.textContent = COPY.searchTestOk.replace('{n}', String(results.length));
    } catch (err) {
      searchStatus.textContent = COPY.searchTestFail.replace('{err}', String(err && err.message || err));
    } finally { searchTestBtn.disabled = false; }
  });

  searchSaveBtn.addEventListener('click', () => {
    const url = searchUrlEl.value.trim();
    if (!LOCAL_URL_RE.test(url)) { searchStatus.textContent = COPY.searchLocalOnly; return; }
    setSearchCfg({ url });
    webSearchOn = true;
    searchCfg.hidden = true;
    syncSearchToggle();
  });

  searchRemBtn.addEventListener('click', () => {
    setSearchCfg(null);
    webSearchOn = false;
    searchCfg.hidden = true;
    syncSearchToggle();
  });


  const emptySubEl = document.querySelector('.ac__empty-sub');
  function updateEmptySub(id) {
    if (!emptySubEl) return;
    const tier = Tiers.TIERS[id || currentTier || (tierDecision && tierDecision.tier) || '0.8b'];
    if (!tier) return;
    let raw = null;
    try { raw = window.MentriaI18n && window.MentriaI18n.t && window.MentriaI18n.t('tool.ai-chat.empty_sub'); } catch (_) {}
    emptySubEl.textContent = (raw || COPY.emptySub).replace('{size}', tier.sizeLabel);
  }
  document.addEventListener('mentria:localechange', function () { updateEmptySub(); });
  updateEmptySub(Tiers.getUserTier() || '0.8b');

  function tierOptionLabel(id) {
    const t = Tiers.TIERS[id];
    const quality = id === '0.8b' ? COPY.tierFast : id === '2b' ? COPY.tierBetter : id === '4b' ? COPY.tierBest : COPY.tierMax;
    return id === '0.8b' ? (t.name + ' · ' + quality) : (t.name + ' · ' + quality + ' · ' + t.sizeLabel);
  }

  function syncTierSelector() {
    if (!tierDecision || !tierDecision.tier) return;
    const ids = ['0.8b'].concat(tierDecision.eligible);
    if (ids.length < 2) { tierSel.hidden = true; return; }
    tierSel.innerHTML = '';
    for (const id of ids) {
      const opt = document.createElement('option');
      opt.value = id;
      opt.textContent = tierOptionLabel(id);
      tierSel.appendChild(opt);
    }
    tierSel.value = currentTier || tierDecision.tier;
    tierSel.hidden = false;
  }

  tierSel.addEventListener('change', async () => {
    const id = tierSel.value;
    if (id === currentTier || generating) { tierSel.value = currentTier; return; }
    if (id !== '0.8b' && !(await Tiers.isTierCached(id))) {
      const ok = await window.mentriaConfirm(COPY.tierConfirm.replace('{size}', Tiers.TIERS[id].sizeLabel));
      if (!ok) { tierSel.value = currentTier; return; }
    }
    Tiers.setUserTier(id);
    tierDecision = await Tiers.decideTier();
    updateEmptySub(id);
    try { engine?.terminate(); } catch (_) {}
    engine = null;
    prefixCache = null;
    inputEl.disabled = true; sendBtn.disabled = true;
    loadModel();
  });

  /* ── Load engine + model ─────────────────────────── */
  async function loadModel() {
    setStatus('loading', COPY.statusLoadingModel);
    await ensureStrip();
    try {
      const { ensureModel } = await import('/assets/js/mentria-model.js');
      const createEngine = () => {
        const e = new MentriaEngine(MENTRIA_DIST_BASE + 'worker.mjs');
        window.mentriaWrapEngine && window.mentriaWrapEngine(e);
        return e;
      };
      const res = await ensureModel(createEngine, {
        vision: true,
        offerUpgrade: true,
        onProgress: onEngineProgress,
        onTier: (info) => strip.setTier(info),
        onDeviceLost: (info) => {
          prefixCache = null;
          setStatus('error', COPY.errDeviceLost);
          inputEl.disabled = true; sendBtn.disabled = true;
          console.error('WebGPU device lost:', info);
        }
      });
      engine = res.engine;
      currentTier = res.tier;
      contextTokens = res.maxSeq || 2048;
      strip.setTier(Activity.tierInfo(Tiers.TIERS[currentTier], currentTier));
      prefixCache = null;
      if (currentTier === '27b' && typeof engine.createPrefixCache === 'function') {
        try {
          const t = Tiers.TIERS[currentTier] || {};
          prefixCache = await engine.createPrefixCache({
            modelId: (t.shards && t.shards[0]) || currentTier,
            maxSeq: contextTokens,
            kvMode: (t.appleMaxSeq && contextTokens === t.appleMaxSeq) ? 'f16' : 'f32'
          });
        } catch (_) { prefixCache = null; }
      }
      routerIds = null; searchAdapterSpecState = null; searchAdapterLoaded = false; searchAdapterActive = false;
      resetPinned();
      resetTune();
      systemMessage.content = systemPromptFor(currentTier);
      syncThinkToggle();
      syncSearchToggle();
      try { await navigator.storage?.persist?.(); } catch (_) {}
      syncTierSelector();
      updateEmptySub();
      strip.done({ prime: COPY.statusReady, linger: 1200 });
      setStatus('ready', COPY.statusReady);
      deleteBtn.style.display = '';
      inputEl.disabled = false;
      sendBtn.disabled = false;
      inputEl.focus();
    } catch (err) {
      if (err && err.message === 'download-postponed') { if (strip) strip.hide(); setStatus('idle', COPY.downloadPostponed); return; }
      console.error('Model load error:', err);
      if (strip) strip.error(String(err && err.message || err), { phase: strip.phaseName || 'loading', onRetry: () => { inputEl.disabled = true; sendBtn.disabled = true; loadModel(); } });
      setStatus('error', COPY.errLoadPrefix + (err.message || err));
    }
  }

  /* ── Generate ────────────────────────────────────── */
  async function generate() {
    if (generating || !engine) return;
    const text = inputEl.value.trim();
    if (!text && !attachedImage) return;

    inputEl.value = '';
    autoResize();

    // Build user content (mirrors HF chat-template content-array shape)
    const userContent = [];
    if (attachedImage) userContent.push({ type: 'image' });
    userContent.push({ type: 'text', text: text || 'Describe this image.' });

    addMessage('user', text, attachedDataUrl);
    messages.push({ role: 'user', content: userContent });
    persistConversation();
    clearChatBtn.style.display = '';

    // If a NEW image was just attached, append it to the persistent conversation
    // history so it stays bound to its placeholder in the messages array on every
    // future turn. Then clear the staging state.
    if (attachedImage) {
      conversationImages.push({
        rgbHwc: attachedImage.rgbHwc,
        h: attachedImage.h,
        w: attachedImage.w,
      });
    }
    attachedImage = null;
    attachedDataUrl = null;
    imgPreview.style.display = 'none';
    fileInput.value = '';

    await runGeneration();
  }

  async function regenerate() {
    if (generating || !engine) return;
    const bubbles = messagesEl.querySelectorAll('.ac__msg--assistant');
    const lastBubble = bubbles.length ? bubbles[bubbles.length - 1] : null;
    const last = messages[messages.length - 1];
    if (last && last.role === 'assistant') {
      messages.pop();
      while (messages.length > 1 && messages[messages.length - 1].ephemeral) messages.pop();
      persistConversation();
      if (lastBubble) lastBubble.remove();
    } else if (lastBubble && lastBubble.classList.contains('ac__msg--ghost')) {
      lastBubble.remove();
    }
    if (messages.length < 2 || messages[messages.length - 1].role !== 'user') return;
    await runGeneration();
  }

  function stopGeneration() {
    if (abortCtrl) abortCtrl.abort();
  }

  async function runGeneration() {
    const epoch = genEpoch;
    const deepThink = deepThinkOn && !pinned && currentTier === '27b' && contextTokens >= 2048;
    generating = true;
    setSendMode(true);
    setStatus('generating', deepThink ? COPY.thinking : COPY.statusGenerating);
    counterReset();
    abortCtrl = new AbortController();

    if (window.renderMarkdownReady) { try { await window.renderMarkdownReady; } catch (_) {} }
    if (epoch !== genEpoch) {
      generating = false;
      abortCtrl = null;
      setSendMode(false);
      setStatus('ready', COPY.statusReady);
      return;
    }

    const bodyEl = addMessage('assistant', '');
    bodyEl.classList.add('ac__streaming');
    let fullText = '';
    let pendingPaint = false;

    const genStart = performance.now();
    let thinkDetails = null, thinkSummaryEl = null, thinkBodyEl = null, thinkDoneSecs = null;
    if (deepThink) {
      thinkDetails = document.createElement('details');
      thinkDetails.className = 'ac__think';
      thinkDetails.open = true;
      thinkSummaryEl = document.createElement('summary');
      thinkSummaryEl.textContent = COPY.thinking;
      thinkBodyEl = document.createElement('div');
      thinkBodyEl.className = 'ac__think-text';
      thinkDetails.append(thinkSummaryEl, thinkBodyEl);
      bodyEl.parentNode.insertBefore(thinkDetails, bodyEl);
    }

    function splitThink() {
      const ci = fullText.indexOf('</think>');
      if (ci === -1) return { think: fullText, answer: '', closed: false };
      return { think: fullText.slice(0, ci), answer: fullText.slice(ci + 8), closed: true };
    }

    function paintThink(parts) {
      thinkBodyEl.textContent = parts.think;
      if (parts.closed) {
        if (thinkDoneSecs === null) {
          thinkDoneSecs = Math.round((performance.now() - genStart) / 1000);
          thinkDetails.open = false;
        }
        thinkSummaryEl.textContent = COPY.thoughtFor.replace('{s}', String(thinkDoneSecs));
      } else {
        thinkSummaryEl.textContent = COPY.thinking + ' ' + Math.round((performance.now() - genStart) / 1000) + 's';
        if (thinkDetails.open) thinkBodyEl.scrollTop = thinkBodyEl.scrollHeight;
      }
    }

    function paintToken() {
      pendingPaint = false;
      if (!generating || epoch !== genEpoch) return;
      const stick = isNearBottom();
      let display;
      if (deepThink) {
        const parts = splitThink();
        paintThink(parts);
        display = parts.answer.trim();
      } else {
        display = fullText.replace(/<think>[\s\S]*?<\/think>/g, '').trim();
      }
      // window.renderMarkdown escapes html before applying markdown patterns,
      // so model-emitted <script> tags are inert. Falls back to textContent if
      // markdown.js failed to load.
      if (window.renderMarkdown) bodyEl.innerHTML = renderMarkdown(display) || '<p>…</p>';
      else bodyEl.textContent = display || '…';
      if (stick) scrollToBottom();
    }

    function finalize(wasStopped) {
      bodyEl.classList.remove('ac__streaming');
      const stick = isNearBottom();
      let display;
      let thinkTruncated = false;
      if (deepThink) {
        const parts = splitThink();
        paintThink(parts);
        if (thinkDoneSecs === null) {
          thinkSummaryEl.textContent = COPY.thoughtFor.replace('{s}', String(Math.round((performance.now() - genStart) / 1000)));
        }
        display = parts.answer.replace(/<\|[^|]*\|>/g, '').replace(/<tool_call>[\s\S]*?(<\/tool_call>|$)/g, '').trim();
        thinkTruncated = !wasStopped && !parts.closed;
      } else {
        display = fullText
          .replace(/<think>[\s\S]*?<\/think>/g, '')
          .replace(/<tool_call>[\s\S]*?(<\/tool_call>|$)/g, '')
          .replace(/<\|[^|]*\|>/g, '')   // belt-and-suspenders strip if a multi-piece special leaks through
          .trim();
      }
      if (wasStopped && !display) {
        bodyEl.textContent = COPY.stopped;
        bodyEl.classList.add('ac__msg-body--muted');
        bodyEl.parentNode.classList.add('ac__msg--ghost');
        addAssistantActions(bodyEl, null);
        return;
      }
      if (thinkTruncated && !display) {
        thinkDetails.open = true;
        bodyEl.textContent = COPY.thinkCut;
        bodyEl.classList.add('ac__msg-body--muted');
        messages.push({ role: 'assistant', content: COPY.thinkCut });
        persistConversation();
        addAssistantActions(bodyEl, null);
        if (stick) scrollToBottom();
        return;
      }
      const escEmpty = COPY.emptyResponse.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
      if (window.renderMarkdown) bodyEl.innerHTML = renderMarkdown(display) || `<p>${escEmpty}</p>`;
      else bodyEl.textContent = display || COPY.emptyResponse;
      messages.push({ role: 'assistant', content: display });
      persistConversation();
      addAssistantActions(bodyEl, () => display);
      if (stick) scrollToBottom();
    }

    const bigContext = contextTokens >= 4096;
    const hugeContext = contextTokens >= 8192;
    const HISTORY_CHAR_BUDGET = deepThink
      ? (hugeContext ? 7000 : bigContext ? 5000 : 800)
      : (hugeContext ? 14000 : bigContext ? 9500 : contextTokens >= 2048 ? 3400 : 1200);
    const turnText = (m) => Array.isArray(m.content)
      ? m.content.filter(p => p && p.type === 'text').map(p => p.text).join(' ')
      : String(m.content || '');
    const turnImages = (m) => Array.isArray(m.content)
      ? m.content.filter(p => p && p.type === 'image').length
      : 0;
    const rest = messages.slice(1);
    const replyReserve = deepThink
      ? (hugeContext ? 6000 : bigContext ? 3400 : 512)
      : (bigContext ? 768 : contextTokens >= 2048 ? MAX_TOKENS : 320);
    const historyTokenBudget = Math.max(256, contextTokens - replyReserve - 160);
    const textOnly = (m) => ({ role: m.role, content: turnText(m) });
    const countTokens = async (turns) => {
      if (!engine || typeof engine.encodeChat !== 'function') return null;
      const enc = await engine.encodeChat([{ role: 'system', content: messages[0].content }, ...turns.map(textOnly)], { enableThinking: deepThink });
      const images = turns.reduce((a, m) => a + turnImages(m), 0);
      return enc.ids.length + images * 300;
    };
    let kept = [];
    let exactPromptTokens = null;
    try {
      const all = await countTokens(rest);
      if (all != null && all <= historyTokenBudget) { kept = rest.slice(); exactPromptTokens = all; }
      else if (all != null) {
        for (let i = rest.length - 1; i >= 0; i--) {
          const candidate = rest.slice(i);
          const n = await countTokens(candidate);
          if (kept.length && (n == null || n > historyTokenBudget)) break;
          kept = candidate; exactPromptTokens = n;
        }
      }
    } catch (_) { kept = []; exactPromptTokens = null; }
    if (!kept.length) {
      let budget = 0;
      for (let i = rest.length - 1; i >= 0; i--) {
        budget += turnText(rest[i]).length + turnImages(rest[i]) * 1200;
        if (kept.length && budget > HISTORY_CHAR_BUDGET) break;
        kept.unshift(rest[i]);
      }
    }
    let droppedImages = 0;
    for (let i = 0; i < rest.length - kept.length; i++) droppedImages += turnImages(rest[i]);
    const windowImages = conversationImages.slice(droppedImages);
    const imagesForRequest = windowImages.length ? windowImages : undefined;

    const keptChars = kept.reduce((a, m) => a + turnText(m).length, 0);
    const searchActive = webSearchOn && !pinned && !!(getSearchCfg() || {}).url;
    if (searchActive && currentTier === '27b' && !imagesForRequest && rest.length > 1) setStatus('generating', COPY.statusRereading);
    const routeAsk = () => routeTurn(turnText(rest[rest.length - 1]));
    const route = (searchActive && currentTier === '27b' && !imagesForRequest && rest.length)
      ? (prefixCache ? await prefixCache.withCheckpoint(routeAsk) : await routeAsk())
      : null;
    if (epoch !== genEpoch) return;
    const useTool = route ? route === 'tool' : searchActive;
    markRoute(bodyEl, route);
    await setSearchAdapter(useTool);
    const systemContent = useTool ? systemMessage.content + SEARCH_TOOL_PROMPT : systemMessage.content;
    const toolTurns = [];
    const searchesDone = [];
    let searchSources = [];
    let searchErrored = false;

    try {
      for (let round = 0; round < 3; round++) {
        const toolChars = toolTurns.reduce((a, m) => a + m.content.length, 0);
        const estPromptTokens = exactPromptTokens != null
          ? exactPromptTokens + Math.ceil((toolChars + (useTool ? SEARCH_TOOL_PROMPT.length : 0)) / 3.5) + 16
          : Math.ceil((systemContent.length + keptChars + toolChars) / 3.5) + windowImages.length * 300 + 80;
        const thinkBudget = Math.max(512, Math.min(hugeContext ? 6000 : 3400, contextTokens - estPromptTokens - 120));
        const smp = (pinned && pinned.sampling) || null;
        const num = (v, d) => (typeof v === 'number' && isFinite(v) ? v : d);
        const params = {
          messages: [{ role: 'system', content: systemContent }, ...kept, ...toolTurns],
          maxTokens: (imagesForRequest && IS_IOS) ? 256
            : (pinned && num(pinned.maxTokens, 0) > 0) ? pinned.maxTokens
            : deepThink ? thinkBudget
            : (bigContext ? 768 : contextTokens >= 2048 ? MAX_TOKENS : 320),
          temperature: smp ? num(smp.temperature, 0.7) : deepThink ? 0.7 : 0,
          topK: smp ? num(smp.topK, 50) : deepThink ? 20 : 1,
          topP: smp ? num(smp.topP, 0.9) : deepThink ? 0.95 : 1.0,
          repetitionPenalty: smp ? num(smp.repetitionPenalty, 1.0) : currentTier === '27b' ? 1.0 : 1.15,
          enableThinking: pinned ? !!pinned.enableThinking : deepThink,
          signal: abortCtrl.signal,
        };
        applyTune(params);
        lastParams = Object.assign({}, params);
        TUNE_KEEP.forEach((k) => { delete lastParams[k]; });
        if (imagesForRequest) params.images = imagesForRequest;

        let promptIds = null;
        if (prefixCache && !imagesForRequest) {
          try { promptIds = (await engine.encodeChat(params.messages, { enableThinking: deepThink })).ids; } catch (_) { promptIds = null; }
        }
        const replyIds = [];
        let committedTokens = 0;
        await engine.generate(params, (event) => {
          if (typeof event.tokenId === 'number' && event.tokenId >= 0) replyIds.push(event.tokenId);
          if (event.finished && typeof event.committedTokens === 'number') committedTokens = event.committedTokens;
          if (typeof event.token === 'string' && event.token.length > 0) {
            // Skip Qwen special tokens (<|im_end|>, <|endoftext|>, etc) from the visible stream
            if (/^<\|[^|]*\|>$/.test(event.token)) return;
            counterTick();
            if (strip) strip.token(counterN, { ctxUsed: estPromptTokens + counterN, ctxWindow: contextTokens });
            fullText += event.token;
            if (!pendingPaint) {
              pendingPaint = true;
              requestAnimationFrame(paintToken);
            }
          }
        });
        if (prefixCache) {
          if (promptIds && committedTokens > 0) prefixCache.noteLedger(promptIds.concat(replyIds).slice(0, committedTokens));
          else prefixCache.invalidate();
        }

        if (!useTool || round >= 2 || epoch !== genEpoch) break;
        const answerPart = deepThink ? splitThink().answer : fullText.replace(/<think>[\s\S]*?<\/think>/g, '');
        const query = parseToolCall(answerPart);
        if (!query) break;

        searchesDone.push(query);
        const stick = isNearBottom();
        bodyEl.textContent = COPY.searching.replace('{q}', query);
        if (stick) scrollToBottom();
        let resultJson;
        try {
          const results = await runWebSearch(query);
          const nMax = contextTokens >= 4096 ? 5 : 3;
          const slim = results.slice(0, nMax).map((r) => {
            const o = { title: r.title, url: r.url, snippet: r.snippet.slice(0, contextTokens >= 4096 ? 300 : 160) };
            if (r.date) o.date = r.date;
            return o;
          });
          resultJson = JSON.stringify(slim);
          searchSources = searchSources.concat(slim);
        } catch (err) {
          resultJson = JSON.stringify({ error: String(err && err.message || err) });
          searchErrored = true;
        }
        toolTurns.push({ role: 'assistant', content: fullText, ephemeral: true });
        toolTurns.push({ role: 'user', content: '<tool_response>\n' + resultJson + '\n</tool_response>', ephemeral: true });
        fullText = '';
        if (thinkDetails) { thinkDoneSecs = null; thinkDetails.open = true; }
      }

      generating = false;
      if (epoch === genEpoch) {
        for (const t of toolTurns) messages.push(t);
        finalize(false);
        if (searchesDone.length) attachSources(bodyEl, searchesDone, searchSources, searchErrored);
      }
    } catch (err) {
      generating = false;
      if (prefixCache) prefixCache.invalidate();
      const aborted = err && err.name === 'AbortError';
      if (epoch === genEpoch) {
        const friendly = /maxseq/i.test(String(err && err.message))
          ? COPY.errContextFull
          : COPY.errPrefix + (err && err.message);
        if (aborted) {
          finalize(true);
        } else if (fullText.trim()) {
          finalize(true);
          if (window.MentriaUI) MentriaUI.toast(friendly);
        } else {
          bodyEl.textContent = friendly;
          bodyEl.parentNode.classList.add('ac__msg--ghost');
          addAssistantActions(bodyEl, null);
        }
      }
      if (!aborted) console.error('Generation error:', err);
    }

    abortCtrl = null;
    if (strip) { if (strip.phaseName === 'answering') strip.done({ tokens: counterN }); else strip.hide(); }
    setSendMode(false);
    setStatus('ready', COPY.statusReady);
    inputEl.focus();
  }

  /* ── Delete cached model ─────────────────────────── */
  async function deleteModel() {
    if (!(await mentriaConfirm(COPY.confirmDelete))) return;
    try {
      const keys = await caches.keys();
      for (const key of keys) {
        if (key.includes('mentria') || key.includes('huggingface') || key.includes('transformers')) {
          await caches.delete(key);
        }
      }
      const dbs = (typeof indexedDB.databases === 'function') ? await indexedDB.databases() : [];
      for (const db of dbs) {
        if (db.name && (db.name.includes('mentria') || db.name.includes('transformers') || db.name.includes('onnxruntime'))) {
          indexedDB.deleteDatabase(db.name);
        }
      }
      try { await engine?.unload(); } catch {}
      engine = null;
      prefixCache = null;
      messages = [systemMessage];
      conversationImages = [];
      if (window.MentriaStore) window.MentriaStore.remove('ai_chat', 'conversation');
      clearChatBtn.style.display = 'none';
      messagesEl.innerHTML = '';
      if (emptyEl) {
        messagesEl.appendChild(emptyEl);
        emptyEl.style.display = '';
      }
      deleteBtn.style.display = 'none';
      inputEl.disabled = true;
      sendBtn.disabled = true;
      setStatus('idle', COPY.statusModelDeleted);
    } catch (err) {
      console.error('Delete error:', err);
      mentriaAlert(COPY.errDeletePrefix + err.message);
    }
  }

  /* ── Image handling ──────────────────────────────── */
  async function attachFile(file) {
    if (!file || !file.type.startsWith('image/')) return;
    removeImage();
    const url = URL.createObjectURL(file);
    imgThumb.src = url;
    imgPreview.style.display = '';
    attachedDataUrl = url;
    try {
      attachedImage = await fileToEngineImage(file, IMG_MAX);
    } catch (err) {
      console.error('Image attach error:', err);
      removeImage();
      setStatus('error', COPY.errBadImage);
    }
  }

  function removeImage() {
    if (attachedDataUrl) { try { URL.revokeObjectURL(attachedDataUrl); } catch (_) {} }
    attachedImage = null;
    attachedDataUrl = null;
    imgPreview.style.display = 'none';
    imgThumb.src = '';
    fileInput.value = '';
  }

  /* ── Events ──────────────────────────────────────── */
  sendBtn.addEventListener('click', () => {
    if (Date.now() - longPressAt < 800) return;
    if (generating) { stopGeneration(); return; }
    generate();
  });

  inputEl.addEventListener('keydown', e => {
    if (e.isComposing || e.keyCode === 229) return;
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      generate();
    }
  });

  inputEl.addEventListener('input', autoResize);

  fileInput.addEventListener('change', () => {
    if (fileInput.files[0]) attachFile(fileInput.files[0]);
  });

  imgRemoveBtn.addEventListener('click', removeImage);
  deleteBtn.addEventListener('click', deleteModel);

  // Paste image from clipboard
  document.addEventListener('paste', e => {
    const items = e.clipboardData?.items;
    if (!items) return;
    for (const item of items) {
      if (item.type.startsWith('image/')) {
        e.preventDefault();
        attachFile(item.getAsFile());
        break;
      }
    }
  });

  /* ── Init ────────────────────────────────────────── */
  (async () => {
    tierDecision = await Tiers.decideTier();
    if (!tierDecision.tier) {
      showUnsupportedError(COPY.errNoWebGpu);
      return;
    }
    syncTierSelector();
    updateEmptySub();
    loadModel();
  })();
}
</script>

