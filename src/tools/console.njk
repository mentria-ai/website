    if (!v) { const p = document.createElement('p'); p.textContent = raw.slice(0, 600); body.appendChild(p); return; }
    const p = document.createElement('p'); p.textContent = v.summary || ''; body.appendChild(p);
    const mk = (title, arr, cls) => { if (!arr || !arr.length) return; const t = document.createElement('div'); t.className = 'cs__vsub'; t.textContent = title; body.appendChild(t); const ul = document.createElement('ul'); ul.className = cls || ''; arr.forEach((x) => { const li = document.createElement('li'); li.textContent = typeof x === 'string' ? x : (x.title + ' — ' + (x.actual || '') + ' [' + (x.severity || 'minor') + ']'); ul.appendChild(li); }); body.appendChild(ul); };
    mk('✓', cleanList(v.worked, 5)); mk('~', cleanList(v.friction, 5)); mk('✗', cleanList(v.bugs, 4), 'cs__bugs');
    (v.bugs || []).forEach((b) => {
      const btn = document.createElement('button'); btn.type = 'button'; btn.className = 'm-btn m-btn--ghost m-btn--pill cs__file'; btn.textContent = COPY.btnFile + ': ' + String(b.title || '').slice(0, 40);
      btn.addEventListener('click', () => {
        const title = String(b.title || 'Issue in ' + app.title).slice(0, 100);
        const bodyText = '## Problem\n' + (b.actual || '') + '\n\n## Steps\n' + (b.steps || steps.join('\n')) + '\n\n## Expected\n' + (b.expected || '') + '\n\n## Actual\n' + (b.actual || '') + '\n\n## Impact\n' + (v.summary || '') + '\n\n_Found on `/tools/' + app.slug + '/` at ' + new Date().toISOString().slice(0, 10) + '_';
        const sev = ['critical', 'major', 'minor'].includes(b.severity) ? b.severity : 'minor';
        window.open('https://github.com/mentria-ai/website/issues/new?labels=' + encodeURIComponent('bug,auto-generated,severity:' + sev) + '&title=' + encodeURIComponent(title) + '&body=' + encodeURIComponent(bodyText.slice(0, 5000)), '_blank', 'noopener');
      });
      body.appendChild(btn);
    });
    logEl.scrollTop = logEl.scrollHeight;
  }
  sessionBtn.addEventListener('click', runSession);
  import('/assets/js/mentria-bus.js').then(({ MentriaBus }) => {
    MentriaBus.provide('console.test', (args) => testSession({ task: (args || {}).task, persona: (args || {}).persona, uiOnly: (args || {}).uiOnly === true ? true : undefined }), {
      description: 'Commission a QA test of a Mentria app. The 27B model running on this device opens the app and tries to carry out the task the way a person would, then reports what worked, what was awkward, and any bugs, with steps to reproduce. Takes one to five minutes and needs the 27B tier.',
      parameters: { type: 'object', properties: {
        task: { type: 'string', description: 'What the test user should try to do, in plain language, naming the app — for example "Set a 5 minute countdown timer and start it".' },
        persona: { type: 'string', description: 'Optional test user: newcomer, busy, careful, power, random, or a sentence describing one.' },
        uiOnly: { type: 'boolean', description: 'Optional. Force the test user to drive the on-screen controls instead of calling a capability, so the interface itself is exercised.' }
      }, required: ['task'] },
      timeoutMs: 320000,
      ai: true
    });
  }).catch(() => {});
  window.__console = { snapshot, execute, runTask, runSession, testSession, resolveMentions, parseAction, raws, setAdapter, adapterState: () => adapterOn, quantityCheck, taskDurations, clockList, evidenceOnScreen, uiOnlyRe: UI_ONLY_RE };
})();
</script>

