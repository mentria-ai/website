<script>
(function () {
  'use strict';

  const COPY = {
    state_empty: {{ ("tool.json-formatter.state_empty" | t) | dump | safe }},
    state_valid: {{ ("tool.json-formatter.state_valid" | t) | dump | safe }},
    state_invalid: {{ ("tool.json-formatter.state_invalid" | t) | dump | safe }},
    state_busy: {{ ("tool.json-formatter.state_busy" | t) | dump | safe }},
    state_paused: {{ ("tool.json-formatter.state_paused" | t) | dump | safe }},
    line_col: {{ ("tool.json-formatter.line_col" | t) | dump | safe }},
    invalid_announce: {{ ("tool.json-formatter.invalid_announce" | t) | dump | safe }},
    type_object: {{ ("tool.json-formatter.type_object" | t) | dump | safe }},
    type_array: {{ ("tool.json-formatter.type_array" | t) | dump | safe }},
    type_string: {{ ("tool.json-formatter.type_string" | t) | dump | safe }},
    type_number: {{ ("tool.json-formatter.type_number" | t) | dump | safe }},
    type_boolean: {{ ("tool.json-formatter.type_boolean" | t) | dump | safe }},
    type_null: {{ ("tool.json-formatter.type_null" | t) | dump | safe }},
    empty: {{ ("tool.json-formatter.empty" | t) | dump | safe }},
    keys_one: {{ ("tool.json-formatter.keys_one" | t) | dump | safe }},
    keys_other: {{ ("tool.json-formatter.keys_other" | t) | dump | safe }},
    items_one: {{ ("tool.json-formatter.items_one" | t) | dump | safe }},
    items_other: {{ ("tool.json-formatter.items_other" | t) | dump | safe }},
    err_eof: {{ ("tool.json-formatter.err_eof" | t) | dump | safe }},
    err_eof_open: {{ ("tool.json-formatter.err_eof_open" | t) | dump | safe }},
    err_eof_string: {{ ("tool.json-formatter.err_eof_string" | t) | dump | safe }},
    err_expect_value: {{ ("tool.json-formatter.err_expect_value" | t) | dump | safe }},
    err_expect_key: {{ ("tool.json-formatter.err_expect_key" | t) | dump | safe }},
    err_expect_colon: {{ ("tool.json-formatter.err_expect_colon" | t) | dump | safe }},
    err_expect_comma_obj: {{ ("tool.json-formatter.err_expect_comma_obj" | t) | dump | safe }},
    err_expect_comma_arr: {{ ("tool.json-formatter.err_expect_comma_arr" | t) | dump | safe }},
    err_trailing_comma: {{ ("tool.json-formatter.err_trailing_comma" | t) | dump | safe }},
    err_extra: {{ ("tool.json-formatter.err_extra" | t) | dump | safe }},
    err_single_quote: {{ ("tool.json-formatter.err_single_quote" | t) | dump | safe }},
    err_comment: {{ ("tool.json-formatter.err_comment" | t) | dump | safe }},
    err_leading_zero: {{ ("tool.json-formatter.err_leading_zero" | t) | dump | safe }},
    err_number_digit: {{ ("tool.json-formatter.err_number_digit" | t) | dump | safe }},
    err_bad_escape: {{ ("tool.json-formatter.err_bad_escape" | t) | dump | safe }},
    err_bad_unicode: {{ ("tool.json-formatter.err_bad_unicode" | t) | dump | safe }},
    err_control_char: {{ ("tool.json-formatter.err_control_char" | t) | dump | safe }},
    err_string_newline: {{ ("tool.json-formatter.err_string_newline" | t) | dump | safe }},
    err_word: {{ ("tool.json-formatter.err_word" | t) | dump | safe }},
    lossy_one: {{ ("tool.json-formatter.lossy_one" | t) | dump | safe }},
    lossy_other: {{ ("tool.json-formatter.lossy_other" | t) | dump | safe }},
    lossy_badge: {{ ("tool.json-formatter.lossy_badge" | t) | dump | safe }},
    big_confirm: {{ ("tool.json-formatter.big_confirm" | t) | dump | safe }},
    paused_msg: {{ ("tool.json-formatter.paused_msg" | t) | dump | safe }},
    too_large_input: {{ ("tool.json-formatter.too_large_input" | t) | dump | safe }},
    too_large_output: {{ ("tool.json-formatter.too_large_output" | t) | dump | safe }},
    file_too_large: {{ ("tool.json-formatter.file_too_large" | t) | dump | safe }},
    file_read_failed: {{ ("tool.json-formatter.file_read_failed" | t) | dump | safe }},
    file_opened: {{ ("tool.json-formatter.file_opened" | t) | dump | safe }},
    meta_format: {{ ("tool.json-formatter.meta_format" | t) | dump | safe }},
    meta_minify: {{ ("tool.json-formatter.meta_minify" | t) | dump | safe }},
    meta_sorted: {{ ("tool.json-formatter.meta_sorted" | t) | dump | safe }},
    meta_stale: {{ ("tool.json-formatter.meta_stale" | t) | dump | safe }},
    trunc_note: {{ ("tool.json-formatter.trunc_note" | t) | dump | safe }},
    copied: {{ ("tool.json-formatter.copied" | t) | dump | safe }},
    copy_failed: {{ ("tool.json-formatter.copy_failed" | t) | dump | safe }},
    copied_output: {{ ("tool.json-formatter.copied_output" | t) | dump | safe }},
    copied_path: {{ ("tool.json-formatter.copied_path" | t) | dump | safe }},
    downloaded: {{ ("tool.json-formatter.downloaded" | t) | dump | safe }},
    cleared: {{ ("tool.json-formatter.cleared" | t) | dump | safe }},
    expand_capped: {{ ("tool.json-formatter.expand_capped" | t) | dump | safe }},
    show_more: {{ ("tool.json-formatter.show_more" | t) | dump | safe }},
    download_base: {{ ("tool.json-formatter.download_base" | t) | dump | safe }}
  };

  const Core = (function () {
    const T = { OBJ: 1, OBJ_END: 2, ARR: 3, ARR_END: 4, KEY: 5, STR: 6, NUM: 7, NUM_LOSSY: 8, TRUE: 9, FALSE: 10, NULL: 11 };
    const TOKEN_CLASS = ['', '', '', '', '', 'jf-k', 'jf-s', 'jf-n', 'jf-n jf-lossy', 'jf-b', 'jf-b', 'jf-z'];
    const S_TOP = 0;
    const S_AFTER_COLON = 1;
    const S_AFTER_COMMA = 2;
    const S_ARRAY_START = 3;
    const S_OBJECT_START = 4;
    const S_KEY = 5;
    const S_COLON = 6;
    const S_NEXT = 7;
    const S_DONE = 8;
    const WINDOW_BEFORE = 36;
    const WINDOW_AFTER = 28;
    const INVISIBLE = /[\p{C}\p{Z}]/u;
    const DOT_NAME = /^[A-Za-z_\u0080-\uD7FF\uE000-\u{10FFFF}][A-Za-z0-9_\u0080-\uD7FF\uE000-\u{10FFFF}]*$/u;
    const PATH_ESCAPES = { 8: '\\b', 9: '\\t', 10: '\\n', 12: '\\f', 13: '\\r', 39: "\\'", 92: '\\\\' };
    const STRING_ESCAPES = { 34: '"', 47: '/', 92: '\\', 98: '\b', 102: '\f', 110: '\n', 114: '\r', 116: '\t' };

    function isDigit(c) {
      return c >= 48 && c <= 57;
    }

    function isHex(c) {
      return (c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102);
    }

    function isWordStart(c) {
      return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c === 95 || c === 36;
    }

    function isWordChar(c) {
      return isWordStart(c) || isDigit(c);
    }

    function isOpen(t) {
      return t === T.OBJ || t === T.ARR;
    }

    function describeChar(text, i) {
      const cp = text.codePointAt(i);
      const ch = String.fromCodePoint(cp);
      if (INVISIBLE.test(ch)) return 'U+' + cp.toString(16).toUpperCase().padStart(4, '0');
      return ch;
    }

    function wordAt(text, i) {
      let j = i;
      while (j < text.length && j - i < 40 && isWordChar(text.charCodeAt(j))) j++;
      return j > i ? text.slice(i, j) : describeChar(text, i);
    }

    function decimalKey(s) {
      let i = 0;
      let neg = false;
      if (s.charCodeAt(0) === 45) {
        neg = true;
        i = 1;
      }
      let digits = '';
      let frac = 0;
      let inFrac = false;
      for (; i < s.length; i++) {
        const c = s.charCodeAt(i);
        if (c === 46) {
          inFrac = true;
          continue;
        }
        if (c === 101 || c === 69) break;
        digits += s[i];
        if (inFrac) frac++;
      }
      let exp = i < s.length ? Number(s.slice(i + 1)) : 0;
      exp -= frac;
      let a = 0;
      while (a < digits.length && digits.charCodeAt(a) === 48) a++;
      let b = digits.length;
      while (b > a && digits.charCodeAt(b - 1) === 48) b--;
      if (a === b) return '0';
      exp += digits.length - b;
      return (neg ? '-' : '') + digits.slice(a, b) + 'e' + exp;
    }

    function isLossy(literal) {
      const n = Number(literal);
      if (!isFinite(n)) return true;
      if (n === 0) return decimalKey(literal) !== '0';
      return decimalKey(String(n)) !== decimalKey(literal);
    }

    function utf8Length(s) {
      const n = s.length;
      let bytes = 0;
      for (let i = 0; i < n; i++) {
        const c = s.charCodeAt(i);
        if (c < 0x80) bytes += 1;
        else if (c < 0x800) bytes += 2;
        else if (c >= 0xD800 && c <= 0xDBFF && i + 1 < n && (s.charCodeAt(i + 1) & 0xFC00) === 0xDC00) {
          bytes += 4;
          i++;
        } else bytes += 3;
      }
      return bytes;
    }

    function scan(text) {
      const len = text.length;
      let cap = 256;
      while (cap < (len >> 4)) cap *= 2;
      let type = new Uint8Array(cap);
      let start = new Int32Array(cap);
      let end = new Int32Array(cap);
      let link = new Int32Array(cap);
      let size = new Int32Array(cap);
      let n = 0;
      let stack = new Int32Array(64);
      let sp = 0;
      let state = S_TOP;
      let i = len > 0 && text.charCodeAt(0) === 0xFEFF ? 1 : 0;
      let numberHasExponent = false;
      let failure = null;
      let lossyCount = 0;
      const lossyList = [];

      function grow() {
        cap *= 2;
        const t2 = new Uint8Array(cap);
        t2.set(type);
        type = t2;
        const s2 = new Int32Array(cap);
        s2.set(start);
        start = s2;
        const e2 = new Int32Array(cap);
        e2.set(end);
        end = e2;
        const l2 = new Int32Array(cap);
        l2.set(link);
        link = l2;
        const z2 = new Int32Array(cap);
        z2.set(size);
        size = z2;
      }

      function push(t, s, e) {
        if (n === cap) grow();
        type[n] = t;
        start[n] = s;
        end[n] = e;
        link[n] = -1;
        size[n] = 0;
        return n++;
      }

      function fail(offset, code, found, extra) {
        failure = { offset: offset, code: code, found: found || '' };
        if (extra) {
          failure.at = extra.at;
          if (extra.bracket) failure.bracket = extra.bracket;
        }
        return -1;
      }

      function scanString(s) {
        let j = s + 1;
        for (;;) {
          if (j >= len) return fail(len, 'eof_string', '', { at: s });
          const c = text.charCodeAt(j);
          if (c === 34) return j + 1;
          if (c === 92) {
            j++;
            if (j >= len) return fail(len, 'eof_string', '', { at: s });
            const e = text.charCodeAt(j);
            if (e === 117) {
              j++;
              for (let k = 0; k < 4; k++, j++) {
                if (j >= len) return fail(len, 'eof_string', '', { at: s });
                if (!isHex(text.charCodeAt(j))) return fail(j, 'bad_unicode', describeChar(text, j));
              }
            } else if (e === 34 || e === 92 || e === 47 || e === 98 || e === 102 || e === 110 || e === 114 || e === 116) {
              j++;
            } else {
              return fail(j, 'bad_escape', describeChar(text, j));
            }
          } else if (c < 32) {
            return fail(j, c === 10 || c === 13 ? 'string_newline' : 'control_char', describeChar(text, j));
          } else {
            j++;
          }
        }
      }

      function scanDigits(j) {
        while (j < len && isDigit(text.charCodeAt(j))) j++;
        return j;
      }

      function scanNumber(s) {
        let j = s;
        numberHasExponent = false;
        if (text.charCodeAt(j) === 45) {
          j++;
          if (j >= len) return fail(len, 'eof');
        }
        let c = text.charCodeAt(j);
        if (c === 48) {
          j++;
          if (j < len && isDigit(text.charCodeAt(j))) return fail(j, 'leading_zero', describeChar(text, j));
        } else if (c >= 49 && c <= 57) {
          j = scanDigits(j + 1);
        } else {
          return fail(j, 'number_digit', describeChar(text, j));
        }
        if (j < len && text.charCodeAt(j) === 46) {
          j++;
          if (j >= len) return fail(len, 'eof');
          if (!isDigit(text.charCodeAt(j))) return fail(j, 'number_digit', describeChar(text, j));
          j = scanDigits(j + 1);
        }
        if (j < len && (text.charCodeAt(j) | 32) === 101) {
          numberHasExponent = true;
          j++;
          if (j >= len) return fail(len, 'eof');
          c = text.charCodeAt(j);
          if (c === 43 || c === 45) {
            j++;
            if (j >= len) return fail(len, 'eof');
          }
          if (!isDigit(text.charCodeAt(j))) return fail(j, 'number_digit', describeChar(text, j));
          j = scanDigits(j + 1);
        }
        return j;
      }

      function scanWord(s, word) {
        for (let k = 1; k < word.length; k++) {
          if (s + k >= len) return fail(len, 'eof');
          if (text.charCodeAt(s + k) !== word.charCodeAt(k)) return fail(s + k, 'word', wordAt(text, s));
        }
        const j = s + word.length;
        if (j < len && isWordChar(text.charCodeAt(j))) return fail(j, 'word', wordAt(text, s));
        return j;
      }

      function openContainer(t) {
        const k = push(t, i, i + 1);
        if (sp === stack.length) {
          const bigger = new Int32Array(stack.length * 2);
          bigger.set(stack);
          stack = bigger;
        }
        stack[sp++] = k;
        i++;
      }

      function closeContainer() {
        const o = stack[--sp];
        const k = push(type[o] === T.OBJ ? T.OBJ_END : T.ARR_END, i, i + 1);
        link[o] = k;
        link[k] = o;
        i++;
        state = sp > 0 ? S_NEXT : S_DONE;
      }

      function error(offset, code, found) {
        fail(offset, code, found);
        return { error: failure };
      }

      function valueError(c) {
        if (c === 39) return error(i, 'single_quote', "'");
        if (c === 47) return error(i, 'comment', '/');
        if (isWordStart(c)) return error(i, 'word', wordAt(text, i));
        return error(i, 'expect_value', describeChar(text, i));
      }

      function keyError(c) {
        if (c === 39) return error(i, 'single_quote', "'");
        if (c === 47) return error(i, 'comment', '/');
        return error(i, 'expect_key', isWordStart(c) ? wordAt(text, i) : describeChar(text, i));
      }

      for (;;) {
        while (i < len) {
          const w = text.charCodeAt(i);
          if (w === 32 || w === 10 || w === 13 || w === 9) i++;
          else break;
        }
        if (i >= len) {
          if (state === S_DONE) break;
          if (state === S_TOP) return { empty: true };
          if (sp > 0) {
            const o = stack[sp - 1];
            fail(len, 'eof_open', '', { at: start[o], bracket: type[o] === T.OBJ ? '{' : '[' });
            return { error: failure };
