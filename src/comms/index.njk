      icon: '/assets/img/icon-192x192.png',
      badge: '/assets/img/badge.svg',
      data: { url: spec.url || COMMS_PATH },
      renotify: true
    });
  } catch (_) {}
};
const closeLocalNotif = async (tag) => {
  if (!navigator.serviceWorker) return;
  try {
    const reg = await navigator.serviceWorker.ready;
    (await reg.getNotifications({ tag })).forEach((note) => note.close());
  } catch (_) {}
};
const notifTargetNow = () => {
  if (currentDmContact) return { tag: 'comms-dm:' + currentDmContact.fp, url: COMMS_PATH };
  if (currentRoomName && !isDmRoom(currentRoomName)) {
    const entry = roomNotifyEntry(currentRoomName);
    return { tag: 'comms-room:' + currentRoomName, url: entry ? COMMS_PATH + formatHash(entry.room, entry.key) : COMMS_PATH };
  }
  return { tag: 'comms-msg', url: COMMS_PATH };
};

const handleRoomCtl = (ctl, sfp) => {
  if (!ctl || ctl.k !== 'ring' || !currentRoomName || isDmRoom(currentRoomName)) return;
  const token = (typeof ctl.token === 'string' && RING_TOKEN_RE.test(ctl.token)) ? ctl.token : null;
  if (!token || (ringToken && token === ringToken)) return;
  const list = savedRooms();
  const entry = list.find((r) => r.room === currentRoomName);
  if (!entry) return;
  const rings = roomRings(entry);
  if (ctl.off) delete rings[token];
  else rings[token] = { name: String(ctl.name || '').slice(0, 32), sfp: sfp || null, ts: Date.now() };
  const keys = Object.keys(rings);
  if (keys.length > 20) keys.sort((a, b) => (rings[a].ts || 0) - (rings[b].ts || 0)).slice(0, keys.length - 20).forEach((k) => { delete rings[k]; });
  entry.rings = rings;
  setSavedRooms(list);
};

const publishRoomCtl = async (ctl) => {
  if (!chatKey || !currentRoomName || isDmRoom(currentRoomName) || !chatTopic || !chatPersist) return false;
  const cmid = newCmid();
  seenCmids.add(cmid);
  try {
    const enc = await encryptText(chatKey, packChatPlain('', { ctl }));
    if (chatAction) { try { chatAction.send({ cmid, enc }); } catch (_) {} }
    rememberSentCmid(cmid);
    const eventStr = await createPersistentEvent(CHAT_KIND, chatTopic, JSON.stringify({ cmid, ts: Date.now(), enc }), expiryTags());
    let sent = false;
    const sockets = getRelaySockets() || {};
    for (const ws of Object.values(sockets)) {
      if (ws && ws.readyState === 1) { try { ws.send(eventStr); sent = true; } catch (_) {} }
    }
    return sent;
  } catch (_) { return false; }
};

const announceRoomRing = async () => {
  if (!currentRoomName || !chatKey || isDmRoom(currentRoomName)) return;
  const list = savedRooms();
  const entry = list.find((r) => r.room === currentRoomName);
  if (!entry) return;
  const stale = (Date.now() - (entry.announcedAt || 0)) > 7 * 86400000;
  if (entry.notify && ringToken && (entry.announced !== ringToken || stale)) {
    const sent = await publishRoomCtl({ k: 'ring', token: ringToken, name: (myProfile && myProfile.name) || '' });
    if (sent) {
      const fresh = entry.announced !== ringToken;
      entry.announced = ringToken;
      entry.announcedAt = Date.now();
      setSavedRooms(list);
      if (fresh) sys(T.rooms.alerts_on);
    }
  } else if (!entry.notify && entry.announced) {
    const sent = await publishRoomCtl({ k: 'ring', token: entry.announced, off: true });
    if (sent) { entry.announced = null; setSavedRooms(list); sys(T.rooms.alerts_off); }
  }
};

const setRoomNotify = async (roomName, on) => {
  const entry = roomNotifyEntry(roomName);
  if (!entry) return;
  if (on) {
    if (!window.MentriaPush || !MentriaPush.isSupported()) {
      const iosTab = /iPhone|iPad|iPod/.test(navigator.userAgent) && !navigator.standalone;
      notice(iosTab ? T.rooms.alerts_ios : T.rooms.alerts_unsupported);
      return;
    }
    if (MentriaPush.permission() !== 'granted') {
      const ok = await MentriaPush.requestPermission();
      if (!ok) { notice(T.rooms.alerts_denied); return; }
    }
    if (!ringToken) await initRingToken();
    if (!ringToken) { notice(T.rooms.alerts_failed); return; }
  }
  const list = savedRooms();
  const fresh = list.find((r) => r.room === roomName);
  if (!fresh) return;
  fresh.notify = !!on;
  setSavedRooms(list);
  renderContacts();
  if (currentRoomName === roomName) { await announceRoomRing(); return; }
  if (on) { window.location.hash = formatHash(fresh.room, fresh.key); setView('chat'); }
};

if (new URLSearchParams(window.location.search).has('debug')) {
  window.__commsDebug = { setRoomNotify, announceRoomRing, publishRoomCtl, savedRooms, setSavedRooms, setRingToken: (t) => { ringToken = t; }, ringToken: () => ringToken };
}

let lastRoomRingAt = 0;
const ringRoomMembers = () => {
  if (!currentRoomName || currentDmContact || isDmRoom(currentRoomName)) return;
  if (!window.MentriaPush || !MentriaPush.ring) return;
  const entry = roomNotifyEntry(currentRoomName);
  const rings = roomRings(entry);
  const connected = new Set();
  for (const p of peerProfiles.values()) if (p && p.verified && p.ring) connected.add(p.ring);
  const targets = Object.keys(rings).filter((tk) => tk !== ringToken && !connected.has(tk));
  if (!targets.length || Date.now() - lastRoomRingAt < 8000) return;
  lastRoomRingAt = Date.now();
  targets.forEach((tk) => {
    MentriaPush.ring(tk, 'comms-msg').then((res) => {
      if (!(res && res.reason === 'unknown-token')) return;
      const list = savedRooms();
      const e = list.find((r) => r.room === entry.room);
      if (e && e.rings && e.rings[tk]) { delete e.rings[tk]; setSavedRooms(list); }
    }).catch(() => {});
  });
};

const sentCmidsFor = (fp) => {
  try {
    const log = MentriaStore.get('comms', 'sentlog') || {};
    return Array.isArray(log[fp]) ? log[fp] : [];
  } catch (_) { return []; }
};

const publishChat = async (text, cmid) => {
  if (!chatTopic || !chatPersist || !chatKey) return;
  rememberSentCmid(cmid);
  try {
    const enc = await encryptText(chatKey, packChatPlain(text));
    const eventStr = await createPersistentEvent(CHAT_KIND, chatTopic, JSON.stringify({ cmid, ts: Date.now(), enc }), expiryTags());
    const sockets = getRelaySockets() || {};
    for (const ws of Object.values(sockets)) {
      if (ws && ws.readyState === 1) {
        try { ws.send(eventStr); } catch {}
      }
    }
    ringRoomMembers();
  } catch (err) {
    console.warn('chat publish failed:', err);
  }
};

const certFingerprints = (sdp) => {
  const out = new Set();
  String(sdp || '').split(/\r?\n/).forEach((line) => {
    const m = /^a=fingerprint:(\S+)\s+([0-9A-Fa-f:]+)/.exec(line.trim());
    if (m) out.add(m[1].toLowerCase() + ' ' + m[2].toUpperCase());
  });
  return Array.from(out).sort().join(',');
};

const connBinding = (peerId) => {
  try {
    const pc = room && room.getPeers ? room.getPeers()[peerId] : null;
    const local = pc && pc.localDescription ? certFingerprints(pc.localDescription.sdp) : '';
    const remote = pc && pc.remoteDescription ? certFingerprints(pc.remoteDescription.sdp) : '';
    return local && remote ? { local, remote } : null;
  } catch (_) { return null; }
};

const finishCheck = (peerId) => {
  const pend = pendingChecks.get(peerId);
  if (!pend) return;
  clearTimeout(pend.timer);
  pendingChecks.delete(peerId);
};

const announcePeer = (peerId, fallback) => {
  if (!peers.has(peerId)) return;
  let prof = peerProfiles.get(peerId);
  const contact = prof && prof.verified && prof.pub ? CID.contactByPub(prof.pub) : null;
  const label = (contact && contact.name) || (prof && prof.name) || '';
  if (prof && typeof prof.announcedAs === 'string' && (prof.announcedAs || !label)) return;
  if (!label && !fallback) return;
  if (!prof) { prof = { name: '' }; peerProfiles.set(peerId, prof); }
  prof.announcedAs = label;
  const withFp = !!(label && prof.verified && prof.fp && !isDmRoom(currentRoomName || ''));
  sys(fmt(withFp ? T.log.here_fp : T.log.here, { name: label || T.people.someone, fp: prof.fp }));
};

const challengePeer = (peerId, action) => {
  const prof = peerProfiles.get(peerId);
  if (!action || !myId || !prof || !prof.pub) return;
  finishCheck(peerId);
  const entry = { n: b64urlEncode(crypto.getRandomValues(new Uint8Array(16))), pub: prof.pub, timer: null };
  entry.timer = setTimeout(() => { if (pendingChecks.get(peerId) === entry) announcePeer(peerId); }, 8000);
  pendingChecks.set(peerId, entry);
  try { action.send({ t: 'q', n: entry.n, pub: { x: myId.publicJwk.x, y: myId.publicJwk.y } }, peerId); } catch (_) {}
};

const applyVerifiedProfile = async (peerId) => {
  const prof = peerProfiles.get(peerId);
  if (!prof || !prof.verified || !prof.pub || !prof.ring) return;
  const existing = CID.contactByPub(prof.pub);
  if (!existing || existing.ring === prof.ring) return;
  try {
    await CID.addContact({ name: existing.name || prof.name, pub: prof.pub, ring: prof.ring });
    if (currentDmContact && currentDmContact.fp === existing.fp) currentDmContact.ring = prof.ring;
  } catch (_) {}
};

const samePubOf = (a, b) => !!(a && b && a.x === b.x && a.y === b.y);

let joinSeq = 0;

const joinNew = async (roomName, b64Key = null, opts = {}) => {
  const seq = ++joinSeq;
  const leavingDm = currentDmContact;
  joinTarget = (opts.leave || !roomName) ? null : { room: roomName, key: b64Key || null };
  stopScan();
  MentriaBus.unprovide('comms.peers');
  MentriaBus.unprovide('comms.share');
  MentriaBus.unprovide('extensions.requestInstall');
  endCall(true);
  incomingRings.clear();
  stopRinging();
  if (room) {
    closeChatSub();
    try { await room.leave(); } catch {}
    if (seq !== joinSeq) return;
    room = null;
    chatAction = metaAction = chunkAction = profAction = callAction = null;
    peers.clear();
    peerProfiles.clear();
    pendingChecks.forEach((pend) => clearTimeout(pend.timer));
    pendingChecks.clear();
    proofAnswers.clear();
    chatSubId = null;
    chatTopic = null;
    chatKey = null;
  }
  revokeObjectUrls();
  if (currentRoomName && !currentDmContact && !isDmRoom(currentRoomName)) { touchRoom(currentRoomName); clearUnreadFor(roomUnreadKey(currentRoomName)); }
  currentDmContact = null;
  if (leavingDm) clearUnreadFor(leavingDm.fp);
  els.log.innerHTML = '';
  logPinned = true;
  introTs = 0;
  roomJoinedAt = Date.now();
  els.status.textContent = T.chat.connecting;
  els.peers.hidden = true;
  els.enc.hidden = true;

  if (opts.leave || !roomName) {
    currentRoomName = null;
    currentDmContact = null;
    joinedLocked = false;
    els.room.value = '';
    els.status.textContent = T.chat.not_in_chat;
    els.share.hidden = true;
    els.eph.hidden = true;
    els.leave.hidden = true;
    els.callStart.hidden = true;
    els.msg.disabled = true;
    els.go.disabled = true;
    if (window.location.hash) window.history.replaceState(null, '', window.location.pathname + window.location.search);
    setView('people');
    renderContacts();
    return;
  }

  chatKey = b64Key ? await deriveKey(b64Key) : null;
  const topic = chatKey && !isEphemeralRoom(roomName) ? await chatTopicFor(roomName, b64Key) : null;
  if (seq !== joinSeq) return;
  if (b64Key && !chatKey) sysTop(T.log.bad_key);
  if (chatKey && b64Key) { rememberRoom(roomName, b64Key); clearUnreadFor(roomUnreadKey(roomName)); }

  if (opts.share === false || isDmRoom(roomName)) {
    if (window.location.hash) window.history.replaceState(null, '', window.location.pathname + window.location.search);
  } else {
    const nextHash = formatHash(roomName, b64Key);
    if (window.location.hash !== nextHash) window.location.hash = nextHash;
  }
  refreshShareUrl(roomName);

  let iceServers;
  try {
    iceServers = await getIce();
  } catch {
    iceServers = FALLBACK_ICE;
  }
  if (seq !== joinSeq) return;

  const rtcConfig = { iceServers };
  if (relayOnly && hasTurn(iceServers)) rtcConfig.iceTransportPolicy = 'relay';
  else if (relayOnly) console.warn('hide-my-ip requested but no relay server available — connecting normally');
  const roomConfig = { appId: 'mentria', relayConfig: { urls: [RELAY] }, rtcConfig };
  if (chatKey && b64Key) roomConfig.password = b64Key;
  const keyNotes = new Set();
  const onJoinError = (info) => {
    const reason = String((info && info.error) || '').toLowerCase();
    if (seq !== joinSeq || !reason.includes('password')) return;
    const note = isDmRoom(roomName) ? T.log.key_dm : peers.size > 0 ? T.log.key_room_other : T.log.key_room_mine;
    if (keyNotes.has(note)) return;
    keyNotes.add(note);
    sys(note);
  };
  try {
    room = joinRoom(roomConfig, roomName, { onJoinError });
  } catch (err) {
    sys(fmt(T.log.join_failed, { reason: why(err) }));
    els.status.textContent = T.chat.error;
    return;
  }

  currentRoomName = roomName;
  joinedLocked = CID.idState() !== 'unlocked';
  if (chatKey && b64Key) {
    renderContacts();
    subscribeUnread();
    closeLocalNotif('comms-room:' + roomName);
    setTimeout(() => { if (seq === joinSeq) announceRoomRing(); }, 3000);
  }
  if (opts.contact) currentDmContact = opts.contact;
  els.chatTitle.textContent = opts.contact ? (opts.contact.name || opts.contact.fp) : ((roomNotifyEntry(roomName) || {}).label || roomName);
  paintAvatar(els.chatAvatar, opts.contact ? (opts.contact.name || opts.contact.fp) : '#', opts.contact ? opts.contact.fp : roomName);
  els.status.textContent = isDmRoom(roomName) ? T.chat.private : fmt(T.chat.room, { room: roomName });
  els.leave.hidden = false;
  setView('chat');
  setConnUI();
  els.eph.hidden = !!chatKey && !isEphemeralRoom(roomName);
  els.eph.title = chatKey ? T.chat.eph_bang : T.chat.eph_nokey;
  els.enc.hidden = !chatKey;
  els.msg.disabled = false;
  els.go.disabled = false;
  updatePeers();
  updateCallUI();
  if (isDmRoom(roomName)) sysTop(T.log.dm_note);
  else sysTop(myProfile.name ? fmt(T.log.alone_named, { name: myProfile.name, room: roomName }) : fmt(T.log.alone, { room: roomName }));
  if (chatKey && !isDmRoom(roomName)) sysTop(T.log.enc_note);

  callAction = room.makeAction('call');
  callAction.onMessage = (data, ctx) => {
    if (seq !== joinSeq || !data || typeof data !== 'object') return;
    const cid = (typeof data.cid === 'string' && data.cid && data.cid.length <= 64) ? data.cid : 'legacy:' + ctx.peerId;
    if (data.kind === 'ring') onCallRing(ctx.peerId, cid);
    else if (data.kind === 'join') onCallJoin(ctx.peerId, cid, true);
    else if (data.kind === 'here') onCallJoin(ctx.peerId, cid, false);
    else if (data.kind === 'decline') onCallDecline(ctx.peerId, cid);
    else if (data.kind === 'leave') onCallLeave(ctx.peerId);
  };

  room.onPeerStream = (stream, peerId) => {
    if (seq !== joinSeq) return;
    if (call.active && call.members.has(peerId)) addTile(peerId, stream, { label: displayName(peerId) });
    else pendingStreams.set(peerId, stream);
  };

  const pchk = room.makeAction('pchk');
  pchk.onMessage = async (data, ctx) => {
    if (!data || typeof data !== 'object' || !myId || !myFp || typeof data.n !== 'string' || data.n.length > 64) return;
    if (data.t === 'q') {
      if (!data.pub || typeof data.pub.x !== 'string' || typeof data.pub.y !== 'string') return;
      const asked = (proofAnswers.get(ctx.peerId) || 0) + 1;
      proofAnswers.set(ctx.peerId, asked);
      const bind = asked <= 12 ? connBinding(ctx.peerId) : null;
      if (!bind) return;
      try {
        const theirPub = { x: data.pub.x, y: data.pub.y };
        const mac = await CID.pairProof(myId.privateKey, theirPub, [PROOF_LABEL, data.n, myFp, await CID.fingerprint(theirPub), bind.local, bind.remote]);
        if (seq === joinSeq) pchk.send({ t: 'a', n: data.n, mac }, ctx.peerId);
      } catch (_) {}
      return;
    }
    if (data.t !== 'a') return;
    const pend = pendingChecks.get(ctx.peerId);
    const prof = peerProfiles.get(ctx.peerId);
    if (!pend || pend.n !== data.n || !prof || !prof.fp || !samePubOf(prof.pub, pend.pub)) return;
    const bind = connBinding(ctx.peerId);
    if (!bind) return;
    const ok = await CID.checkPairProof(myId.privateKey, pend.pub, [PROOF_LABEL, pend.n, prof.fp, myFp, bind.remote, bind.local], data.mac);
    const cur = peerProfiles.get(ctx.peerId);
    if (!ok || seq !== joinSeq || pendingChecks.get(ctx.peerId) !== pend || !cur || !samePubOf(cur.pub, pend.pub)) return;
    finishCheck(ctx.peerId);
    cur.verified = true;
    await applyVerifiedProfile(ctx.peerId);
    renderPeerList();
    announcePeer(ctx.peerId);
  };

  profAction = room.makeAction('prof');
  profAction.onMessage = async (data, ctx) => {
    if (!data || typeof data !== 'object') return;
    const prof = { name: String(data.name || '').slice(0, 32) };
    if (data.pub && typeof data.pub.x === 'string' && typeof data.pub.y === 'string') {
      prof.pub = { x: data.pub.x, y: data.pub.y };
      try { prof.fp = await CID.fingerprint(prof.pub); } catch {}
    }
    if (typeof data.ring === 'string') prof.ring = data.ring.slice(0, 64);
    if (seq !== joinSeq || !peers.has(ctx.peerId)) return;
    const known = peerProfiles.get(ctx.peerId);
    prof.verified = !!(known && known.verified && samePubOf(known.pub, prof.pub));
    if (known && typeof known.announcedAs === 'string') prof.announcedAs = known.announcedAs;
    peerProfiles.set(ctx.peerId, prof);
    if (prof.verified) await applyVerifiedProfile(ctx.peerId);
    else if (prof.pub && myId) challengePeer(ctx.peerId, pchk);
    else finishCheck(ctx.peerId);
    renderPeerList();
    if (!prof.pub || !myId) announcePeer(ctx.peerId);
  };

  chatAction = room.makeAction('chat');
  chatAction.onMessage = async (data, ctx) => {
    const cmid = data && data.cmid;
    if (cmid && seenCmids.has(cmid)) return;
    let text, sfp = null, sfp2 = null;
    if (data && data.enc) {
      if (!chatKey) return;
      try {
        const unpacked = unpackChatPlain(await decryptText(chatKey, data.enc));
        text = unpacked.text;
        sfp = unpacked.sfp;
        sfp2 = unpacked.sfp2;
        if (unpacked.ctl) { if (cmid) seenCmids.add(cmid); handleRoomCtl(unpacked.ctl, sfp); return; }
      } catch { return; }
    } else {
      text = String(data && data.text || '');
    }
    if (cmid) seenCmids.add(cmid);
    renderRemoteChat({ senderId: ctx.peerId, text, ts: Date.now(), sfp, sfp2 });
    playPing(880);
  };

  const incoming = new Map();
  metaAction = room.makeAction('fmeta');
  metaAction.onMessage = (meta, ctx) => {
    if (!meta || typeof meta !== 'object') return;
    const size = Number(meta.size);
    if (!Number.isFinite(size) || size < 0 || size > MAX_FILE) return;
    let open = 0;
    incoming.forEach((_, k) => { if (k.startsWith(ctx.peerId + ':')) open++; });
    if (open >= 4) return;
    const line = renderLine(displayName(ctx.peerId), '', { peerId: ctx.peerId, quiet: true, html: progressHTML(T.files.receiving, meta.name, size, 0) });
    incoming.set(ctx.peerId + ':' + meta.id, { meta, size, chunks: [], received: 0, line, paint: 0 });
  };

  chunkAction = room.makeAction('fchunk');
  chunkAction.onMessage = async (data, ctx) => {
    const m = ctx.metadata || {};
    const key = ctx.peerId + ':' + m.id;
    const entry = incoming.get(key);
    if (!entry) return;
    const bytes = (data instanceof ArrayBuffer || ArrayBuffer.isView(data)) ? data.byteLength : -1;
    const received = entry.received + bytes;
    if (bytes < 0 || received > entry.size || received > MAX_FILE) {
      incoming.delete(key);
      entry.chunks = [];
      if (entry.paint) cancelAnimationFrame(entry.paint);
      entry.line.line.removeAttribute('aria-live');
      entry.line.what.innerHTML = fmtHtml(T.files.interrupted, { name: strongName(entry.meta.name) });
      return;
    }
    entry.chunks.push(data);
    entry.received = received;
    if (!entry.paint) {
      entry.paint = requestAnimationFrame(() => {
        entry.paint = 0;
        if (incoming.get(key) === entry) entry.line.what.innerHTML = progressHTML(T.files.receiving, entry.meta.name, entry.size, entry.received);
      });
    }
    if (m.done) {
      if (entry.paint) { cancelAnimationFrame(entry.paint); entry.paint = 0; }
      entry.line.what.innerHTML = progressHTML(T.files.receiving, entry.meta.name, entry.size, entry.received);
      entry.line.line.removeAttribute('aria-live');
      const safeType = /^image\/(png|jpeg|gif|webp|avif|bmp)$/i.test(entry.meta.type || '') ? entry.meta.type : 'application/octet-stream';
      const blob = new Blob(entry.chunks, { type: safeType });
      if (entry.meta.kind === 'mentria-pack' || /\.mentria\.json$/i.test(entry.meta.name || '')) {
        const text = await blob.text();
        const who = nameOf(ctx.peerId);
        const label = document.createElement('span');
        label.textContent = fmt(T.files.pack_from, { who, title: entry.meta.packTitle || entry.meta.name }) + ' ';
        const importBtn = document.createElement('button');
        importBtn.type = 'button';
        importBtn.className = 'comms__btn comms__btn--ghost';
        importBtn.textContent = T.files.import;
        importBtn.addEventListener('click', async () => {
          importBtn.disabled = true;
          try {
            const P = await loadPacks();
            const res = await P.importText(text, { source: 'contact', from: who });
            importBtn.replaceWith(Object.assign(document.createElement('a'), { href: PREFIX + '/learn/play/?id=' + encodeURIComponent(res.row.id), textContent: T.files.open }));
            label.textContent = (res.replaced ? T.files.updated : T.files.imported) + ' ';
          } catch (e) { sys(fmt(T.files.import_failed, { reason: (e && e.errors && e.errors[0]) || why(e) })); importBtn.disabled = false; }
        });
        entry.line.what.innerHTML = '';
        entry.line.what.append(label, importBtn);
      } else if (entry.meta.kind === 'mentria-ext') {
        const html = await blob.text();
        const who = nameOf(ctx.peerId);
        const label = document.createElement('span');
        label.textContent = fmt(T.files.ext_from, { who, name: entry.meta.extName || entry.meta.name }) + ' ';
        const installBtn = document.createElement('button');
        installBtn.type = 'button';
        installBtn.className = 'comms__btn comms__btn--ghost';
        installBtn.textContent = T.files.install;
        installBtn.addEventListener('click', async () => {
          installBtn.disabled = true;
          try {
            const installed = await MentriaBus.invoke('extensions.requestInstall', { html, from: who });
            if (installed) {
              installBtn.replaceWith(Object.assign(document.createElement('a'), { href: PREFIX + '/tools/extensions/run/?id=' + encodeURIComponent(installed.manifest.id), textContent: T.files.open }));
              label.textContent = T.files.installed + ' ';
            } else { installBtn.disabled = false; }
          } catch (e) { sys(fmt(T.files.install_failed, { reason: why(e) })); installBtn.disabled = false; }
        });
        entry.line.what.innerHTML = '';
        entry.line.what.append(label, installBtn);
      } else {
        const url = trackObjectUrl(blob);
        entry.line.what.innerHTML = completeHTML(T.files.received, {}, entry.meta.name, entry.meta.size, safeType, url);
      }
      incoming.delete(key);
      playPing(660);
    }
  };

  room.onPeerJoin = (peerId) => {
    peers.add(peerId);
    updatePeers();
    renderPeerList();
    sendProfileTo(peerId);
    setTimeout(() => { if (seq === joinSeq && peers.has(peerId) && !peerProfiles.has(peerId)) announcePeer(peerId, true); }, 6000);
  };
  room.onPeerLeave = (peerId) => {
    const who = nameOf(peerId);
    const announced = (peerProfiles.get(peerId) || {}).announcedAs;
    const wasMember = call.members.has(peerId);
    for (const [key, entry] of incoming) {
      if (key.startsWith(peerId + ':')) {
        entry.line.line.removeAttribute('aria-live');
        entry.line.what.innerHTML = fmtHtml(T.files.peer_left, { name: strongName(entry.meta.name), who: escapeHtml(who) });
        incoming.delete(key);
      }
    }
    if (incomingRings.delete(peerId)) { sys(fmt(T.people.tried_call, { name: who })); renderRing(); }
    call.invited.delete(peerId);
    peers.delete(peerId);
    peerProfiles.delete(peerId);
    finishCheck(peerId);
    proofAnswers.delete(peerId);
    if (!wasMember) removeTile(peerId);
    pendingStreams.delete(peerId);
    updatePeers();
    renderPeerList();
    if (typeof announced === 'string') sys(fmt(T.log.left, { name: who }));
    if (wasMember) dropMember(peerId, false);
    else if (call.active && !call.connected && call.cid && !call.invited.size) endCall(false);
  };

  setupChatPersistence(roomName, topic);

  MentriaBus.provide('comms.peers', () => ({ count: peers.size }), { description: 'Number of connected comms peers.', parameters: { type: 'object', properties: {} }, ai: false });
  MentriaBus.provide('comms.share', async ({ filename, html, name }) => {
    if (!metaAction || !chunkAction) throw new Error(T.share_err.not_connected);
    if (peers.size === 0) throw new Error(T.share_err.no_peers);
    if (new Blob([html]).size > MAX_FILE) throw new Error(T.share_err.too_large);
    const file = new File([html], filename || 'extension.html', { type: 'text/html' });
    await sendOne(file, { kind: 'mentria-ext', extName: name });
    return { sentTo: peers.size };
  }, { description: 'Send an extension to connected comms peers.', parameters: { type: 'object', properties: { filename: { type: 'string' }, html: { type: 'string' }, name: { type: 'string' } }, required: ['html'] }, ai: false });
  MentriaBus.provide('extensions.requestInstall', ({ html, from }) => confirmInstall(html, Object.assign({ from }, INSTALL_OPTS)), { description: 'Install a received extension after a human trust prompt.', parameters: { type: 'object', properties: { html: { type: 'string' }, from: { type: 'string' } }, required: ['html'] }, ai: false });
};

els.join.addEventListener('click', () => {
  const name = (els.room.value || (EPHEMERAL_PREFIX + randomRoomSlug())).trim().slice(0, 64);
  const { b64Key } = parseHash(window.location.hash);
  joinNew(name, b64Key);
});

els.send.addEventListener('submit', async (e) => {
  e.preventDefault();
  const text = els.msg.value.trim();
  if (!text || !chatAction) return;
  const cmid = newCmid();
  seenCmids.add(cmid);
  let livePayload;
  if (chatKey) {
    try {
      const enc = await encryptText(chatKey, packChatPlain(text));
      livePayload = { cmid, enc };
    } catch (err) {
      sys(fmt(T.log.enc_failed, { reason: why(err) }));
      return;
    }
  } else {
    livePayload = { text, cmid };
  }
  if (!navigator.onLine) {
    renderPendingLine(text, livePayload, cmid);
    els.msg.value = '';
    return;
  }
  chatAction.send(livePayload);
  publishChat(text, cmid);
  const sent = renderLine('you', text, { me: true });
  if (!currentDmContact && peers.size === 0) {
    const note = document.createElement('span');
    note.className = 'comms__pending-note';
    note.textContent = chatPersist ? T.log.saved_note : T.log.nobody_note;
    sent.what.append(' ', note);
  }
  els.msg.value = '';
  maybeRingContact();
});

const dragEvents = ['dragenter', 'dragover'];
const undragEvents = ['dragleave', 'drop'];
dragEvents.forEach(ev => els.drop.addEventListener(ev, (e) => { e.preventDefault(); els.drop.classList.add('comms__drop--hot'); }));
undragEvents.forEach(ev => els.drop.addEventListener(ev, (e) => { e.preventDefault(); els.drop.classList.remove('comms__drop--hot'); }));
const CHUNK = 32 * 1024;
const sendOne = async (file, extra) => {
  const id = Math.random().toString(36).slice(2);
  const line = renderLine('you', '', { me: true, quiet: true, html: progressHTML(T.files.sending, file.name, file.size, 0) });
  await metaAction.send(Object.assign({ id, name: file.name, size: file.size, type: file.type }, extra || {}));
  const buf = await file.arrayBuffer();
  let sent = 0;
  let paint = 0;
  for (let offset = 0; offset < buf.byteLength; offset += CHUNK) {
    if (peers.size === 0) {
      if (paint) cancelAnimationFrame(paint);
      line.line.removeAttribute('aria-live');
      line.what.innerHTML = fmtHtml(T.files.send_interrupted, { name: strongName(file.name) });
      throw new Error(T.files.all_left);
    }
    const slice = buf.slice(offset, Math.min(offset + CHUNK, buf.byteLength));
    const done = offset + CHUNK >= buf.byteLength;
    await chunkAction.send(slice, { metadata: { id, done } });
    sent += slice.byteLength;
    if (!paint) paint = requestAnimationFrame(() => { paint = 0; line.what.innerHTML = progressHTML(T.files.sending, file.name, file.size, sent); });
  }
  if (paint) cancelAnimationFrame(paint);
  const previewUrl = trackObjectUrl(file);
  const n = peers.size;
  line.line.removeAttribute('aria-live');
  line.what.innerHTML = completeHTML(n > 0 ? (n === 1 ? T.files.sent_one : T.files.sent_many) : T.files.uncertain, { n }, file.name, file.size, file.type, previewUrl);
};

const sendFiles = async (fileList) => {
  if (!metaAction || !chunkAction || peers.size === 0) {
    if (currentDmContact) {
      sys(fmt(T.files.dm_offline, { name: whoNow() }));
      knockNow('comms-msg').then((ok) => {
        if (ok) sys(T.files.pinged);
      });
    } else {
      sys(T.files.nobody);
    }
    return;
  }
  const all = Array.from(fileList || []);
  if (!all.length) return;
  const tooBig = all.filter(f => f.size > MAX_FILE);
  const ok = all.filter(f => f.size <= MAX_FILE);
  if (tooBig.length) {
    sys(fmt(T.files.skipped, { cap: fmtMB(MAX_FILE), files: tooBig.map(f => `${f.name} ${fmtSize(f.size)}`).join(', ') }));
  }
  if (!ok.length) return;
  const total = ok.reduce((s, f) => s + f.size, 0);
  if (ok.length > 1) sys(fmt(peers.size === 1 ? T.files.sending_to_one : T.files.sending_to_many, { n: ok.length, size: fmtSize(total), p: peers.size }));
  if (total > MAX_TOTAL_WARN) sys(fmt(T.files.heads_up, { size: fmtSize(total) }));
  for (const file of ok) {
    try { await sendOne(file); } catch (err) { sys(fmt(T.files.send_failed_for, { name: file.name, reason: why(err) })); }
  }
};

els.drop.addEventListener('drop', (e) => { sendFiles(e.dataTransfer.files); });
els.file.addEventListener('change', (e) => { sendFiles(e.target.files); e.target.value = ''; });

const pickerEl = document.getElementById('comms-picker');
const pickerListEl = document.getElementById('comms-picker-list');
let pickerResolve = null;
let pickerOpener = null;
function pickerTrapTab(e) {
  if (e.key !== 'Tab') return;
  const focusables = [...pickerEl.querySelectorAll('button')].filter(b => b.offsetParent);
  if (!focusables.length) return;
  const first = focusables[0];
  const last = focusables[focusables.length - 1];
  if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
  else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  else if (!pickerEl.contains(document.activeElement)) { e.preventDefault(); first.focus(); }
}
function closePicker(value) {
  const r = pickerResolve;
  pickerResolve = null;
  pickerEl.hidden = true;
  pickerListEl.innerHTML = '';
  document.removeEventListener('keydown', pickerTrapTab, true);
  const opener = pickerOpener;
  pickerOpener = null;
  if (r) r(value);
  if (opener) setTimeout(() => { if (document.contains(opener)) opener.focus(); }, 0);
}
pickerEl.querySelectorAll('[data-picker-close]').forEach((el) => el.addEventListener('click', () => closePicker(null)));
document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !pickerEl.hidden) { e.preventDefault(); closePicker(null); } });
function pickExtension(list) {
  pickerListEl.innerHTML = '';
  list.forEach((ext) => {
    const item = document.createElement('button');
    item.type = 'button';
    item.className = 'comms__picker-item';
    const nm = document.createElement('span');
    nm.textContent = (ext.icon && !/^data:/.test(ext.icon) ? ext.icon + ' ' : '') + ext.name;
    const ver = document.createElement('span');
    ver.className = 'comms__picker-ver';
    ver.textContent = 'v' + ext.version;
    item.append(nm, ver);
    item.addEventListener('click', () => closePicker(ext));
    pickerListEl.appendChild(item);
  });
  pickerOpener = (document.activeElement && document.activeElement !== document.body) ? document.activeElement : attachExtBtn;
  pickerEl.hidden = false;
  document.addEventListener('keydown', pickerTrapTab, true);
  const first = pickerListEl.querySelector('.comms__picker-item');
  if (first) first.focus();
  return new Promise((res) => { pickerResolve = res; });
}

const attachExtBtn = document.getElementById('comms-attach-ext');
attachExtBtn.addEventListener('click', async () => {
  if (attachExtBtn.disabled) return;
  attachExtBtn.disabled = true;
  try {
    if (peers.size === 0) {
      sys(currentDmContact ? fmt(T.attach.ext_dm, { name: whoNow() }) : T.attach.nobody);
      return;
    }
    let list;
    try { list = await MentriaBus.invoke('extensions.list'); } catch (e) { sys(fmt(T.attach.ext_unavailable, { reason: why(e) })); return; }
    if (!list.length) { sys(T.attach.no_ext); return; }
    const chosen = await pickExtension(list);
    if (!chosen) return;
    let html;
    try { html = await MentriaBus.invoke('extensions.getSource', { id: chosen.id }); } catch (e) { sys(fmt(T.attach.ext_read_failed, { reason: why(e) })); return; }
    if (!html) { sys(T.attach.ext_missing); return; }
    const file = new File([html], chosen.id + '.html', { type: 'text/html' });
    await sendOne(file, { kind: 'mentria-ext', extName: chosen.name });
  } catch (e) { sys(fmt(T.attach.send_failed, { reason: why(e) })); }
  finally { attachExtBtn.disabled = false; }
});

const attachPackBtn = document.getElementById('comms-attach-pack');
attachPackBtn.addEventListener('click', async () => {
  if (attachPackBtn.disabled) return;
  attachPackBtn.disabled = true;
  try {
    if (peers.size === 0) {
      sys(currentDmContact ? fmt(T.attach.pack_dm, { name: whoNow() }) : T.attach.nobody);
      return;
    }
    const P = await loadPacks().catch(() => null);
    const rows = P ? await P.list() : [];
    if (!rows.length) { sys(T.attach.no_packs); return; }
    const chosen = await pickExtension(rows.map((r) => ({ id: r.id, name: P.text(r.title), version: String(r.version), icon: '' })));
    if (!chosen) return;
    const row = await P.get(chosen.id);
    if (!row || !row.pack) { sys(T.attach.pack_missing); return; }
    const json = JSON.stringify(row.pack);
    if (new Blob([json]).size > MAX_FILE) { sys(T.attach.pack_too_large); return; }
    const file = new File([json], chosen.id + '.mentria.json', { type: 'application/json' });
    await sendOne(file, { kind: 'mentria-pack', packTitle: chosen.name });
  } catch (e) { sys(fmt(T.attach.send_failed, { reason: why(e) })); }
  finally { attachPackBtn.disabled = false; }
});

els.mute.addEventListener('click', () => {
  muted = !muted;
  els.mute.textContent = muted ? T.adv.sound_off : T.adv.sound_on;
  els.mute.setAttribute('aria-pressed', String(muted));
  try { localStorage.setItem('comms.muted', muted ? '1' : '0'); } catch (_) {}
  if (!muted) playPing(880);
});
if (muted) { els.mute.textContent = T.adv.sound_off; els.mute.setAttribute('aria-pressed', 'true'); }

const updateCallUI = () => {
  const inRoom = !!room;
  if (inRoom && currentRoomName) els.share.hidden = isDmRoom(currentRoomName) || call.active;
  els.callStart.hidden = !inRoom || call.active;
  els.callCam.hidden = !call.active;
  els.callMic.hidden = !call.active;
  els.callHangup.hidden = !call.active;
  els.media.hidden = callTiles.size === 0;
};

const addTile = (key, stream, opts = {}) => {
  removeTile(key);
  const tile = document.createElement('div');
  tile.className = 'comms__tile';
  const hasVideo = stream.getVideoTracks().some((t) => t.readyState === 'live');
  let mediaEl;
  if (hasVideo) {
    mediaEl = document.createElement('video');
    mediaEl.autoplay = true;
    mediaEl.playsInline = true;
    if (opts.local) mediaEl.muted = true;
  } else {
    mediaEl = document.createElement('audio');
    mediaEl.autoplay = true;
    if (opts.local) mediaEl.muted = true;
    mediaEl.style.display = 'none';
    const voice = document.createElement('span');
    voice.className = 'comms__tile-voice';
    voice.textContent = '\u{1F399}';
    tile.append(voice);
  }
  mediaEl.srcObject = stream;
  tile.append(mediaEl);
  const label = document.createElement('span');
  label.className = 'comms__tile-label';
  label.textContent = opts.label || T.call.peer;
  tile.append(label);
  els.media.append(tile);
  callTiles.set(key, { tile, stream });
  updateCallUI();
};

const removeTile = (key) => {
  const t = callTiles.get(key);
  if (!t) return;
  t.tile.remove();
  callTiles.delete(key);
  updateCallUI();
};

const stopRinging = () => {
  if (ringTimer) { clearInterval(ringTimer); ringTimer = null; }
  els.ring.hidden = true;
};

const renderRing = () => {
  if (ringAccepting) return;
  const now = Date.now();
  incomingRings.forEach((r, pid) => {
    if (r.until > now && peers.has(pid)) return;
    incomingRings.delete(pid);
    sys(fmt(T.people.tried_call, { name: nameOf(pid) }));
  });
  if (!incomingRings.size) { stopRinging(); return; }
  const latest = Array.from(incomingRings.keys()).pop();
  els.ringText.textContent = fmt(T.ring.calling, { name: nameOf(latest) });
  els.ring.hidden = false;
  if (!ringTimer) {
    playPing(660);
    ringTimer = setInterval(() => { renderRing(); if (ringTimer) playPing(660); }, 1400);
  }
};

const resetCallButtons = () => {
  els.callMic.classList.remove('is-off');
  els.callMic.setAttribute('aria-pressed', 'true');
  els.callMic.title = T.call.mic_on;
  els.callCam.classList.add('is-off');
  els.callCam.setAttribute('aria-pressed', 'false');
  els.callCam.title = T.call.cam_off;
};

const getLocalMedia = (video) => navigator.mediaDevices.getUserMedia({
  audio: { echoCancellation: true, noiseSuppression: true },
  video: video ? { width: { ideal: 640 }, height: { ideal: 480 } } : false
});

const callSend = (msg, peerId) => {
  if (!callAction) return;
  try {
    const sent = callAction.send(msg, peerId || undefined);
    if (sent && typeof sent.catch === 'function') sent.catch(() => {});
  } catch (_) {}
};

const settle = (result) => { Promise.allSettled([].concat(result || [])); };

const shareStreamWith = (peerId) => {
  if (!room || !call.local || call.sentTo.has(peerId) || !peers.has(peerId)) return;
  call.sentTo.add(peerId);
  try { settle(room.addStream(call.local, { target: peerId })); } catch (_) {}
};

const unshareStreamWith = (peerId) => {
  if (!call.sentTo.delete(peerId) || !room || !call.local || !peers.has(peerId)) return;
  try { settle(room.removeStream(call.local, { target: peerId })); } catch (_) {}
};

const clearAnswerTimer = () => {
  if (call.answerTimer) { clearTimeout(call.answerTimer); call.answerTimer = null; }
};

const addMember = (peerId, announce) => {
  if (!call.active || !peers.has(peerId)) return;
  const fresh = !call.members.has(peerId);
  call.members.add(peerId);
  call.invited.delete(peerId);
  call.connected = true;
  clearAnswerTimer();
  shareStreamWith(peerId);
  const held = pendingStreams.get(peerId);
  if (held) {
    pendingStreams.delete(peerId);
    if (held.getTracks().some((t) => t.readyState === 'live')) addTile(peerId, held, { label: displayName(peerId) });
  }
  if (fresh && announce) sys(fmt(T.call.joined, { name: nameOf(peerId) }));
  updateCallUI();
};

const dropMember = (peerId, announce) => {
  if (!call.members.delete(peerId)) return;
  unshareStreamWith(peerId);
  removeTile(peerId);
  pendingStreams.delete(peerId);
  if (announce) sys(fmt(T.call.left, { name: nameOf(peerId) }));
  if (call.active && !call.members.size) endCall(false);
  else updateCallUI();
};

const openCall = async () => {
  const forRoom = room;
  let local;
  try { local = await getLocalMedia(false); }
  catch (err) { sys(fmt(T.call.mic_unavailable, { reason: why(err) })); return false; }
  if (!room || room !== forRoom) { local.getTracks().forEach((t) => t.stop()); return false; }
  if (call.active) { local.getTracks().forEach((t) => t.stop()); return true; }
  call.active = true;
  call.local = local;
  call.videoOn = false;
  call.micOff = false;
  call.connected = false;
  call.cid = null;
  call.cids.clear();
  call.members.clear();
  call.invited.clear();
  call.sentTo.clear();
  resetCallButtons();
  addTile('you', local, { local: true, label: myProfile.name || T.call.you });
  updateCallUI();
  return true;
};

const startCall = async () => {
  if (call.active || !room || callStarting) return;
  if (!peers.size) {
    if (currentDmContact) {
      sys(fmt(T.call.ringing, { name: whoNow() }));
      const target = currentDmContact;
      const ok = await knockNow('comms-ring');
      announceCallTo(target);
      sys(ok ? T.call.notified : T.call.unreachable);
    } else {
      sys(T.call.nobody);
    }
    return;
  }
  if (peers.size > 4) { sys(T.call.too_many); return; }
  callStarting = true;
  let opened = false;
  try { opened = await openCall(); } finally { callStarting = false; }
  if (!opened || call.cid) return;
  const cid = b64urlEncode(crypto.getRandomValues(new Uint8Array(9)));
  call.cid = cid;
  call.cids.add(cid);
  peers.forEach((p) => { if (!call.members.has(p)) call.invited.add(p); });
  callSend({ kind: 'ring', cid });
  sys(T.call.calling_room);
  clearAnswerTimer();
  call.answerTimer = setTimeout(() => {
    call.answerTimer = null;
    if (call.active && !call.connected) endCall(false, T.call.no_answer);
  }, ANSWER_MS);
  updateCallUI();
};

const endCall = (silent, note) => {
  clearAnswerTimer();
  if (!call.active) { pendingStreams.clear(); return; }
  if (!silent) callSend(call.cid ? { kind: 'leave', cid: call.cid } : { kind: 'leave' });
  try { if (room && call.local) settle(room.removeStream(call.local)); } catch (_) {}
  if (call.local) call.local.getTracks().forEach((t) => t.stop());
  call.local = null;
  call.active = false;
  call.connected = false;
  call.cid = null;
  call.cids.clear();
  call.members.clear();
  call.invited.clear();
  call.sentTo.clear();
  resetCallButtons();
  callTiles.forEach((t) => t.tile.remove());
  callTiles.clear();
  pendingStreams.clear();
  updateCallUI();
  if (!silent) sys(note || T.call.ended);
};

const onCallRing = (peerId, cid) => {
  if (!peers.has(peerId)) return;
  pendingStreams.delete(peerId);
  if (call.active && call.cids.has(cid)) return;
  if (call.active && (call.members.has(peerId) || call.invited.has(peerId))) {
    call.cids.add(cid);
    addMember(peerId, false);
    callSend({ kind: 'join', cid }, peerId);
    return;
  }
  incomingRings.set(peerId, { cid, until: Date.now() + RING_MS });
  renderRing();
};

const onCallJoin = (peerId, cid, reply) => {
  if (!call.active || !call.cids.has(cid) || !peers.has(peerId)) return;
  addMember(peerId, true);
  if (reply) callSend({ kind: 'here', cid }, peerId);
};

const onCallDecline = (peerId, cid) => {
  if (!call.active || !call.cids.has(cid)) return;
  sys(fmt(T.call.declined, { name: nameOf(peerId) }));
  call.invited.delete(peerId);
  if (!call.connected && !call.invited.size) endCall(false);
};

const onCallLeave = (peerId) => {
  pendingStreams.delete(peerId);
  if (incomingRings.delete(peerId)) {
    sys(fmt(T.people.tried_call, { name: nameOf(peerId) }));
    renderRing();
  }
  call.invited.delete(peerId);
  if (call.members.has(peerId)) dropMember(peerId, true);
  else if (call.active && !call.connected && call.cid && !call.invited.size) endCall(false);
};

const acceptRings = async () => {
  if (ringAccepting) return;
  const now = Date.now();
  if (!Array.from(incomingRings.entries()).some(([pid, r]) => peers.has(pid) && r.until > now)) { renderRing(); return; }
  ringAccepting = true;
  stopRinging();
  let opened = call.active;
  try { if (!opened) opened = await openCall(); } finally { ringAccepting = false; }
  const rings = Array.from(incomingRings.entries()).filter(([pid]) => peers.has(pid));
  incomingRings.clear();
  if (!opened) {
    rings.forEach(([pid, r]) => callSend({ kind: 'decline', cid: r.cid }, pid));
    return;
  }
  if (!rings.length) {
    if (!call.connected && !call.cid) endCall(true);
    return;
  }
  const cids = new Set();
  rings.forEach(([pid, r]) => {
    call.cids.add(r.cid);
    cids.add(r.cid);
    addMember(pid, false);
  });
  cids.forEach((cid) => callSend({ kind: 'join', cid }));
  updateCallUI();
};

const declineRings = () => {
  stopRinging();
  incomingRings.forEach((r, pid) => {
    callSend({ kind: 'decline', cid: r.cid }, pid);
    pendingStreams.delete(pid);
  });
  incomingRings.clear();
};

els.callStart.addEventListener('click', () => startCall());
els.callHangup.addEventListener('click', () => endCall(false));

els.callMic.addEventListener('click', () => {
  if (!call.local) return;
  call.micOff = !call.micOff;
  call.local.getAudioTracks().forEach((t) => { t.enabled = !call.micOff; });
  els.callMic.title = call.micOff ? T.call.mic_off : T.call.mic_on;
  els.callMic.classList.toggle('is-off', call.micOff);
  els.callMic.setAttribute('aria-pressed', String(!call.micOff));
});

els.callCam.addEventListener('click', async () => {
  if (!call.active || !room) return;
  els.callCam.disabled = true;
  try {
    const next = await getLocalMedia(!call.videoOn);
    if (!call.active || !room || !call.local) { next.getTracks().forEach((t) => t.stop()); return; }
    const targets = Array.from(call.sentTo);
    try { settle(room.removeStream(call.local)); } catch (_) {}
    call.local.getTracks().forEach((t) => t.stop());
    call.sentTo.clear();
    call.local = next;
    call.videoOn = !call.videoOn;
    if (call.micOff) next.getAudioTracks().forEach((t) => { t.enabled = false; });
    targets.forEach((pid) => { if (call.members.has(pid)) shareStreamWith(pid); });
    addTile('you', next, { local: true, label: myProfile.name || T.call.you });
    els.callCam.title = call.videoOn ? T.call.cam_on : T.call.cam_off;
    els.callCam.classList.toggle('is-off', !call.videoOn);
    els.callCam.setAttribute('aria-pressed', String(call.videoOn));
  } catch (err) {
    sys(fmt(T.call.cam_unavailable, { reason: why(err) }));
  } finally {
    els.callCam.disabled = false;
  }
});

els.ringAccept.addEventListener('click', () => { acceptRings(); });
els.ringDecline.addEventListener('click', () => { declineRings(); });

const sendProfileTo = (peerId) => {
  if (!profAction || !myId) return;
  const payload = { name: myProfile.name, pub: { x: myId.publicJwk.x, y: myId.publicJwk.y } };
  if (ringToken) payload.ring = ringToken;
  try { profAction.send(payload, peerId || undefined); } catch {}
};

const broadcastProfile = () => sendProfileTo(null);

let onboardDone = false;
let onboardActive = false;

const INBOX_KIND = 3839;
const INBOX_LOOKBACK_SEC = HISTORY_LOOKBACK_SEC;
let sideWs = null;
let sideOpen = null;
let inboxSubId = null;
let unreadSubId = null;
let myInboxTopic = null;
const topicToFp = new Map();
const topicToRoom = new Map();
const seenInboxIds = new Set();
let unreadMap = {};
const unreadFloor = new Map();
let unreadFlush = null;

const queueUnreadFlush = (render) => {
  if (!unreadFlush) {
    unreadFlush = { render: false };
    setTimeout(() => {
      const f = unreadFlush;
      unreadFlush = null;
      try { CID.setUnread(unreadMap); } catch (_) {}
      if (f.render) { renderContacts(); syncOsBadge(); }
    }, 80);
  }
  if (render) unreadFlush.render = true;
};

const unreadFloorOf = (k, fallback) => {
  if (unreadFloor.has(k)) return unreadFloor.get(k);
  return unreadMap[k] ? (unreadMap[k].lastTs || 0) : (fallback || 0);
};

const countUnread = (k, ts) => {
  const e = unreadMap[k] || { n: 0, lastTs: 0 };
  e.n = (e.n || 0) + 1;
  e.lastTs = Math.max(e.lastTs || 0, ts);
  unreadMap[k] = e;
  queueUnreadFlush(true);
};

let sideOpens = 0;

const ensureSideSocket = () => {
  if (sideWs && sideWs.readyState === 1) return Promise.resolve(sideWs);
  if (sideOpen) return sideOpen;
  sideOpen = new Promise((resolve) => {
    let ws;
    try { ws = new WebSocket(RELAY); } catch (_) { sideOpen = null; resolve(null); return; }
    const done = (val) => { sideOpen = null; resolve(val); };
    ws.addEventListener('open', () => {
      sideWs = ws;
      const isReconnect = sideOpens++ > 0;
      done(ws);
      if (isReconnect && myId) { subscribeInbox(); subscribeUnread(); }
    });
    ws.addEventListener('error', () => { done(null); });
    ws.addEventListener('close', () => {
      if (sideWs === ws) {
        sideWs = null;
        setTimeout(() => { if (myId && !document.hidden && !sideWs) ensureSideSocket(); }, 4000 + Math.random() * 4000);
      }
    });
    ws.addEventListener('message', handleSideMsg);
  });
  return sideOpen;
};

const sideSend = async (str) => {
  const ws = await ensureSideSocket();
  if (!ws || ws.readyState !== 1) return false;
  try { ws.send(str); return true; } catch (_) { return false; }
};

const publishToInbox = async (theirPub, payload) => {
  if (!myId) return false;
  try {
    const env = await CID.sealToInbox(theirPub, payload, myId.privateKey);
    const topic = await CID.inboxTopic(theirPub);
    const evt = await createPersistentEvent(INBOX_KIND, topic, JSON.stringify(env), expiryTags());
    let sent = await sideSend(evt);
    const sockets = getRelaySockets() || {};
    for (const ws of Object.values(sockets)) {
      if (ws && ws.readyState === 1) { try { ws.send(evt); sent = true; } catch (_) {} }
    }
    return sent;
  } catch (_) { return false; }
};

const announceToContact = async (contact) => {
  if (!myId || !contact || !contact.pub) return;
  const payload = { v: 1, name: (myProfile && myProfile.name) || '', pub: { x: myId.publicJwk.x, y: myId.publicJwk.y }, ts: Date.now() };
  if (ringToken) payload.ring = ringToken;
  await publishToInbox(contact.pub, payload);
};

const subscribeInbox = async () => {
  if (!myId) return;
  myInboxTopic = await CID.inboxTopic(myId.publicJwk);
  inboxSubId = 'mi-' + Math.random().toString(36).slice(2);
  const since = Math.floor(Date.now() / 1000) - INBOX_LOOKBACK_SEC;
  await sideSend(JSON.stringify(['REQ', inboxSubId, { kinds: [INBOX_KIND], '#x': [myInboxTopic], since, limit: 50 }]));
};

const subscribeUnread = async () => {
  if (!myId) return;
  const contacts = CID.getContacts();
  const byFp = new Map();
  const byRoom = new Map();
  for (const c of contacts) {
    try {
      const { roomName, b64Key } = await CID.deriveDm(myId.privateKey, c.pub);
      const topic = await chatTopicFor(roomName, b64Key);
      if (topic) byFp.set(topic, c.fp);
    } catch (_) {}
  }
  for (const r of savedRooms()) {
    const topic = await chatTopicFor(r.room, r.key);
    if (topic) byRoom.set(topic, r);
  }
  topicToFp.clear();
  byFp.forEach((fp, topic) => topicToFp.set(topic, fp));
  topicToRoom.clear();
  byRoom.forEach((r, topic) => topicToRoom.set(topic, r));
  const topics = Array.from(byFp.keys()).concat(Array.from(byRoom.keys()));
  if (unreadSubId) await sideSend(JSON.stringify(['CLOSE', unreadSubId]));
  if (!topics.length) { unreadSubId = null; return; }
  unreadFloor.clear();
  topicToFp.forEach((fp) => unreadFloor.set(fp, (unreadMap[fp] && unreadMap[fp].lastTs) || 0));
  topicToRoom.forEach((r) => { const k = roomUnreadKey(r.room); unreadFloor.set(k, unreadMap[k] ? (unreadMap[k].lastTs || 0) : (r.lastSeen || 0)); });
  unreadSubId = 'mu-' + Math.random().toString(36).slice(2);
  const since = Math.floor(Date.now() / 1000) - HISTORY_LOOKBACK_SEC;
  await sideSend(JSON.stringify(['REQ', unreadSubId, { kinds: [CHAT_KIND], '#x': topics, since, limit: 300 }]));
};

const handleSideMsg = async (msgEvent) => {
  let msg;
  try { msg = JSON.parse(msgEvent.data); } catch { return; }
  if (!Array.isArray(msg) || msg[0] !== 'EVENT' || !msg[2]) return;
  const ev = msg[2];
  if (seenInboxIds.has(ev.id)) return;
  seenInboxIds.add(ev.id);

  if (msg[1] === inboxSubId) {
    if (!myId) return;
    let envelope;
    try { envelope = JSON.parse(ev.content); } catch { return; }
    const payload = await CID.openInboxEnvelope(myId.privateKey, envelope, myId.publicJwk);
    if (!payload || !payload.verified) return;
    if (payload.kind === 'call') {
      let callerFp = null;
      try { callerFp = await CID.fingerprint(payload.pub); } catch (_) {}
      if (!callerFp) return;
      const known = CID.contactByPub(payload.pub);
      if (known) callerFp = known.fp;
      const who = (known && known.name) || payload.name || T.people.someone;
      if (currentDmContact && currentDmContact.fp === callerFp && peers.size > 0) { markMissedCall(callerFp, payload.ts, ev.id, true); return; }
      if (!markMissedCall(callerFp, payload.ts, ev.id)) return;
      renderContacts();
      playPing(660);
      notice(fmt(T.people.tried_call, { name: who }));
      return;
    }
    const existing = CID.contactByPub(payload.pub);
    if (existing) {
      if (typeof payload.ts !== 'number' || payload.ts <= (existing.annTs || 0)) return;
      try {
        const updated = await CID.addContact({ name: payload.name, pub: payload.pub, ring: payload.ring, annTs: Math.min(payload.ts, Date.now()) });
        if (currentDmContact && currentDmContact.fp === existing.fp && updated) currentDmContact = updated;
        renderContacts();
        updatePushStatus();
      } catch (_) {}
      return;
    }
    const saved = await CID.saveRequest(payload);
    if (saved) {
      renderContacts();
      notice(fmt(T.people.wants_sys, { name: saved.name || T.people.someone }));
      playPing(660);
    }
    return;
  }

  if (msg[1] === unreadSubId) {
    const tag = (ev.tags || []).find((t) => t && t[0] === 'x');
    const fp = tag && topicToFp.get(tag[1]);
    const savedRoom = !fp && tag ? topicToRoom.get(tag[1]) : null;
    if (!fp && !savedRoom) return;
    let content;
    try { content = JSON.parse(ev.content); } catch { return; }
    const ts = (content && typeof content.ts === 'number') ? content.ts : (ev.created_at || 0) * 1000;
    if (savedRoom) {
      const k = roomUnreadKey(savedRoom.room);
      if (currentRoomName === savedRoom.room) {
        unreadMap[k] = { n: 0, lastTs: Math.max(ts, Date.now()) };
        unreadFloor.set(k, Date.now());
        queueUnreadFlush(false);
        return;
      }
      if (!content || !content.enc) return;
      if (typeof content.cmid === 'string' && content.cmid.startsWith(selfId + ':')) return;
      if (ts <= unreadFloorOf(k, savedRoom.lastSeen)) return;
      let preview = null;
      try {
        const key = await roomCryptoKey(savedRoom);
        const unpacked = key ? unpackChatPlain(await decryptText(key, content.enc)) : null;
        if (!unpacked || unpacked.ctl || sentByMe(unpacked)) return;
        preview = unpacked.text;
      } catch (_) { return; }
      if (currentRoomName === savedRoom.room || ts <= unreadFloorOf(k, savedRoom.lastSeen)) return;
      countUnread(k, ts);
      notifyLocal({ tag: 'comms-room:' + savedRoom.room, title: savedRoom.label || savedRoom.room, body: preview, url: COMMS_PATH + formatHash(savedRoom.room, savedRoom.key) });
      return;
    }
    if (currentDmContact && currentDmContact.fp === fp) {
      const seen = unreadMap[fp] || { n: 0, lastTs: 0 };
      seen.n = 0;
      seen.lastTs = Math.max(seen.lastTs || 0, ts, Date.now());
      unreadMap[fp] = seen;
      unreadFloor.set(fp, Date.now());
      queueUnreadFlush(false);
      return;
    }
    if (!content || !content.enc) return;
    if (typeof content.cmid === 'string') {
      if (content.cmid.startsWith(selfId + ':')) return;
      if (sentCmidsFor(fp).includes(content.cmid)) return;
    }
    if (ts <= unreadFloorOf(fp, 0)) return;
    countUnread(fp, ts);
  }
};

const clearUnreadFor = (fp) => {
  unreadMap[fp] = { n: 0, lastTs: Date.now() };
  unreadFloor.set(fp, Date.now());
  try { CID.setUnread(unreadMap); } catch (_) {}
  syncOsBadge();
};

const hasRoomHash = () => {
  const h = window.location.hash;
  return !!(h && h !== '#' && h.length > 2);
};

const refreshIdUI = () => {
  const state = CID.idState();
  const guest = hasRoomHash();
  if ((state === 'none' || state === 'unavailable') && !guest && !onboardDone) onboardActive = true;
  els.onboard.hidden = !onboardActive;
  if (onboardActive && !cryptoOk()) showOnboardStep('insecure');
  els.idLocked.hidden = state !== 'locked' || onboardActive;
  if (state === 'locked' && !onboardActive) updateLockWaiting();
  els.app.hidden = onboardActive || (state === 'locked' && !guest);
