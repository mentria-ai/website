    try {
      const a = await compose(st.pages.slice(0, at));
      const b = await compose(st.pages.slice(at));
      await deliver([new File([a], outName(C.part + '-1'), { type: 'application/pdf' }), new File([b], outName(C.part + '-2'), { type: 'application/pdf' })]);
