};

const packChatPlain = (text) => JSON.stringify({ v: 2, t: text, sfp: myFp || undefined });
const unpackChatPlain = (raw) => {
  try {
    const o = JSON.parse(raw);
    if (o && o.v === 2 && typeof o.t === 'string') return { text: o.t, sfp: typeof o.sfp === 'string' ? o.sfp : null };
  } catch (_) {}
  return { text: raw, sfp: null };
};

const handleNostrMsg = async (msgEvent) => {
  let msg;
  try { msg = JSON.parse(msgEvent.data); } catch { return; }
  if (!Array.isArray(msg)) return;
  if (msg[0] === 'EVENT' && msg[1] === chatSubId && msg[2]) {
    const ev = msg[2];
    let content;
    try { content = JSON.parse(ev.content); } catch { return; }
    if (!content || !content.cmid || seenCmids.has(content.cmid)) return;
    let text, sfp = null;
    if (content.enc) {
      if (!chatKey) return;
      try {
        const unpacked = unpackChatPlain(await decryptText(chatKey, content.enc));
        text = unpacked.text;
        sfp = unpacked.sfp;
      } catch { return; }
    } else if (typeof content.text === 'string') {
      text = content.text;
    } else {
      return;
    }
    seenCmids.add(content.cmid);
    const senderId = (content.cmid.split(':')[0]) || ev.pubkey;
    const evTs = (ev.created_at || 0) * 1000;
    let ts = (typeof content.ts === 'number' && content.ts > 0) ? content.ts : evTs;
    if (evTs > 0 && Math.abs(ts - evTs) > 120000) ts = evTs;
    const item = { senderId, text, ts, sfp };
    renderRemoteChat(item, { silent: ts < roomJoinedAt - 2000 });
  }
};

const closeChatSub = () => {
  if (!chatSubId) return;
  const closeMsg = JSON.stringify(['CLOSE', chatSubId]);
  const sockets = getRelaySockets() || {};
  for (const ws of Object.values(sockets)) {
    try { ws.send(closeMsg); } catch {}
  }
};

const setupChatPersistence = async (roomName) => {
  chatTopic = CHAT_TOPIC_PREFIX + roomName;
  chatPersist = !isEphemeralRoom(roomName);
  seenCmids = new Set();

  if (!chatPersist) {
    chatSubId = null;
    sys('ephemeral room — messages aren\'t saved. drop the leading ! to persist.');
    return;
  }

  chatSubId = 'mc-' + Math.random().toString(36).slice(2);

  const deadline = Date.now() + 8000;
  let openSockets = [];
  while (Date.now() < deadline) {
    const socketsMap = getRelaySockets() || {};
    openSockets = Object.values(socketsMap).filter(ws => ws && ws.readyState === 1);
    if (openSockets.length > 0) break;
    await new Promise(r => setTimeout(r, 200));
  }
  if (!openSockets.length) {
    sys('relay unreachable — history disabled this session.');
    return;
  }

  const sinceSec = Math.floor(Date.now() / 1000) - HISTORY_LOOKBACK_SEC;
  const req = JSON.stringify(['REQ', chatSubId, {
    kinds: [CHAT_KIND],
    '#x': [chatTopic],
    since: sinceSec,
    limit: HISTORY_LIMIT
  }]);

  for (const ws of openSockets) {
    try {
      if (!socketListenersAttached.has(ws)) {
        ws.addEventListener('message', handleNostrMsg);
        socketListenersAttached.add(ws);
      }
      ws.send(req);
    } catch (err) {
      console.warn('chat history setup failed for socket:', err);
    }
  }

};

const rememberSentCmid = (cmid) => {
  if (!currentDmContact || !cmid) return;
  try {
    const log = MentriaStore.get('comms', 'sentlog') || {};
    const arr = Array.isArray(log[currentDmContact.fp]) ? log[currentDmContact.fp] : [];
    arr.push(cmid);
    log[currentDmContact.fp] = arr.slice(-300);
    MentriaStore.set('comms', 'sentlog', log);
  } catch (_) {}
};

const sentCmidsFor = (fp) => {
  try {
    const log = MentriaStore.get('comms', 'sentlog') || {};
    return Array.isArray(log[fp]) ? log[fp] : [];
  } catch (_) { return []; }
};

const publishChat = async (text, cmid) => {
  if (!chatTopic || !chatPersist) return;
  rememberSentCmid(cmid);
  try {
    let payload;
    if (chatKey) {
      const enc = await encryptText(chatKey, packChatPlain(text));
      payload = { cmid, ts: Date.now(), enc };
    } else {
      payload = { text, cmid, ts: Date.now() };
    }
    const eventStr = await createPersistentEvent(CHAT_KIND, chatTopic, JSON.stringify(payload));
    const sockets = getRelaySockets() || {};
    for (const ws of Object.values(sockets)) {
      if (ws && ws.readyState === 1) {
        try { ws.send(eventStr); } catch {}
      }
    }
  } catch (err) {
    console.warn('chat publish failed:', err);
  }
};

let joinSeq = 0;

const joinNew = async (roomName, b64Key = null, opts = {}) => {
  const seq = ++joinSeq;
  const leavingDm = currentDmContact;
  stopScan();
  MentriaBus.unprovide('comms.peers');
  MentriaBus.unprovide('comms.share');
  MentriaBus.unprovide('extensions.requestInstall');
  endCall(true);
  if (room) {
    closeChatSub();
    try { await room.leave(); } catch {}
    if (seq !== joinSeq) return;
    room = null;
    chatAction = metaAction = chunkAction = profAction = callAction = null;
    peers.clear();
    peerProfiles.clear();
    chatSubId = null;
    chatTopic = null;
    chatKey = null;
  }
  revokeObjectUrls();
  currentDmContact = null;
  if (leavingDm) clearUnreadFor(leavingDm.fp);
  els.log.innerHTML = '';
  roomJoinedAt = Date.now();
  els.status.textContent = 'connecting…';
  els.peers.hidden = true;
  els.enc.hidden = true;

  if (opts.leave || !roomName) {
    currentRoomName = null;
    currentDmContact = null;
    els.room.value = '';
    els.status.textContent = 'not in a chat';
    els.share.hidden = true;
    els.eph.hidden = true;
    els.leave.hidden = true;
    els.callStart.hidden = true;
    els.msg.disabled = true;
    els.go.disabled = true;
    if (window.location.hash) window.history.replaceState(null, '', window.location.pathname + window.location.search);
    setView('people');
    renderContacts();
    return;
  }

  chatKey = b64Key ? await deriveKey(b64Key) : null;
  if (seq !== joinSeq) return;
  if (b64Key && !chatKey) sys('encryption key in URL is invalid — chat will appear unreadable.');

  if (opts.share === false || isDmRoom(roomName)) {
    if (window.location.hash) window.history.replaceState(null, '', window.location.pathname + window.location.search);
  } else {
    window.location.hash = formatHash(roomName, b64Key);
  }
  refreshShareUrl(roomName, b64Key);

  let iceServers;
  try {
    iceServers = await getIce();
  } catch {
    iceServers = FALLBACK_ICE;
  }
  if (seq !== joinSeq) return;

  try {
    room = joinRoom(
      {
        appId: 'mentria',
        relayConfig: { urls: [RELAY] },
        rtcConfig: { iceServers }
      },
      roomName
    );
  } catch (err) {
    sys(`failed to join: ${err.message}`);
    els.status.textContent = 'error';
    return;
  }

  currentRoomName = roomName;
  if (opts.contact) currentDmContact = opts.contact;
  els.chatTitle.textContent = opts.contact ? (opts.contact.name || opts.contact.fp) : roomName;
  paintAvatar(els.chatAvatar, opts.contact ? (opts.contact.name || opts.contact.fp) : '#', opts.contact ? opts.contact.fp : roomName);
  els.status.textContent = isDmRoom(roomName) ? 'private chat' : `room: ${roomName}`;
  els.leave.hidden = false;
  setView('chat');
  setConnUI();
  els.eph.hidden = !isEphemeralRoom(roomName);
  els.enc.hidden = !chatKey;
  els.msg.disabled = false;
  els.go.disabled = false;
  updatePeers();
  updateCallUI();
  if (isDmRoom(roomName)) sys('private chat — end-to-end encrypted, only your two identities can open it.');
  else sys(`you are ${myProfile.name ? myProfile.name + ' (' + short(selfId) + ')' : short(selfId)} — alone in "${roomName}". share the URL to invite someone.`);
  if (chatKey && !isDmRoom(roomName)) sys('end-to-end encrypted. anyone with the full URL (including the key after the colon) can decrypt.');

  callAction = room.makeAction('call');
  callAction.onMessage = (data, ctx) => {
    const kind = data && data.kind;
    if (kind === 'ring') {
      if (call.active) return;
      els.ringText.textContent = `${displayName(ctx.peerId)} is calling`;
      els.ring.hidden = false;
      call.ringDeadline = Date.now() + 30000;
      if (call.ringTimer) clearInterval(call.ringTimer);
      call.ringTimer = setInterval(() => {
        if (Date.now() > call.ringDeadline) { stopRinging(); return; }
        playPing(660);
      }, 1400);
      playPing(660);
    } else if (kind === 'decline') {
      sys(`${displayName(ctx.peerId)} declined the call.`);
    } else if (kind === 'leave') {
      removeTile(ctx.peerId);
      sys(`${displayName(ctx.peerId)} left the call.`);
    } else if (kind === 'join') {
      sys(`${displayName(ctx.peerId)} joined the call.`);
    }
  };

  room.onPeerStream = (stream, peerId) => {
    if (call.active) addTile(peerId, stream, { label: displayName(peerId) });
    else pendingStreams.set(peerId, stream);
  };

  profAction = room.makeAction('prof');
  profAction.onMessage = async (data, ctx) => {
    if (!data || typeof data !== 'object') return;
    const prof = { name: String(data.name || '').slice(0, 32) };
    if (data.pub && typeof data.pub.x === 'string' && typeof data.pub.y === 'string') {
      prof.pub = { x: data.pub.x, y: data.pub.y };
      try { prof.fp = await CID.fingerprint(prof.pub); } catch {}
    }
    if (typeof data.ring === 'string') prof.ring = data.ring.slice(0, 64);
    const known = peerProfiles.get(ctx.peerId);
    peerProfiles.set(ctx.peerId, prof);
    if (prof.fp && prof.ring && prof.pub) {
      const existing = CID.getContacts().find((c) => c.fp === prof.fp);
      if (existing && existing.ring !== prof.ring) {
        try {
          await CID.addContact({ name: existing.name || prof.name, pub: prof.pub, ring: prof.ring });
          if (currentDmContact && currentDmContact.fp === prof.fp) currentDmContact.ring = prof.ring;
        } catch (_) {}
      }
    }
    renderPeerList();
    if (!known && prof.name) sys(`${short(ctx.peerId)} is ${prof.name}${prof.fp ? ' (' + prof.fp + ')' : ''}`);
  };

  chatAction = room.makeAction('chat');
  chatAction.onMessage = async (data, ctx) => {
    const cmid = data && data.cmid;
    if (cmid && seenCmids.has(cmid)) return;
    let text, sfp = null;
    if (data && data.enc) {
      if (!chatKey) return;
      try {
        const unpacked = unpackChatPlain(await decryptText(chatKey, data.enc));
        text = unpacked.text;
        sfp = unpacked.sfp;
      } catch { return; }
    } else {
      text = String(data && data.text || '');
    }
    if (cmid) seenCmids.add(cmid);
    renderRemoteChat({ senderId: ctx.peerId, text, ts: Date.now(), sfp });
    playPing(880);
  };

  const incoming = new Map();
  metaAction = room.makeAction('fmeta');
  metaAction.onMessage = (meta, ctx) => {
    const line = renderLine(displayName(ctx.peerId), '', { peerId: ctx.peerId, quiet: true, html: progressHTML('receiving', meta.name, meta.size, 0) });
    incoming.set(ctx.peerId + ':' + meta.id, { meta, chunks: [], received: 0, line });
  };

  chunkAction = room.makeAction('fchunk');
  chunkAction.onMessage = async (data, ctx) => {
    const m = ctx.metadata || {};
    const key = ctx.peerId + ':' + m.id;
    const entry = incoming.get(key);
    if (!entry) return;
    entry.chunks.push(data);
    entry.received += (data.byteLength || data.size || 0);
    entry.line.what.innerHTML = progressHTML('receiving', entry.meta.name, entry.meta.size, entry.received);
    if (m.done) {
      entry.line.line.removeAttribute('aria-live');
      const blob = new Blob(entry.chunks, { type: entry.meta.type || 'application/octet-stream' });
      if (entry.meta.kind === 'mentria-ext') {
        const html = await blob.text();
        const who = short(ctx.peerId);
        const label = document.createElement('span');
        label.textContent = 'extension from ' + who + ': ' + (entry.meta.extName || entry.meta.name) + ' ';
        const installBtn = document.createElement('button');
        installBtn.type = 'button';
        installBtn.className = 'comms__btn comms__btn--ghost';
        installBtn.textContent = 'install';
        installBtn.addEventListener('click', async () => {
          installBtn.disabled = true;
          try {
            const installed = await MentriaBus.invoke('extensions.requestInstall', { html, from: who });
            if (installed) {
              installBtn.replaceWith(Object.assign(document.createElement('a'), { href: '/tools/extensions/run/?id=' + encodeURIComponent(installed.manifest.id), textContent: 'open' }));
              label.textContent = 'installed ✓ ';
            } else { installBtn.disabled = false; }
          } catch (e) { sys('install failed: ' + e.message); installBtn.disabled = false; }
        });
        entry.line.what.innerHTML = '';
        entry.line.what.append(label, installBtn);
      } else {
        const url = trackObjectUrl(blob);
        entry.line.what.innerHTML = 'received ' + completeHTML(entry.meta.name, entry.meta.size, entry.meta.type, url);
      }
      incoming.delete(key);
      playPing(660);
    }
  };

  room.onPeerJoin = (peerId) => {
    peers.add(peerId);
    updatePeers();
    renderPeerList();
    sys(`${short(peerId)} joined`);
    sendProfileTo(peerId);
  };
  room.onPeerLeave = (peerId) => {
    const who = displayName(peerId);
    for (const [key, entry] of incoming) {
      if (key.startsWith(peerId + ':')) {
        entry.line.line.removeAttribute('aria-live');
        entry.line.what.innerHTML = `transfer interrupted — <strong>${escapeHtml(entry.meta.name)}</strong> (${escapeHtml(who)} left before finishing)`;
        incoming.delete(key);
      }
    }
    peers.delete(peerId);
    peerProfiles.delete(peerId);
    removeTile(peerId);
    pendingStreams.delete(peerId);
    updatePeers();
    renderPeerList();
    sys(`${displayName(peerId)} left`);
  };

  setupChatPersistence(roomName);

  MentriaBus.provide('comms.peers', () => ({ count: peers.size }), { description: 'Number of connected comms peers.', parameters: { type: 'object', properties: {} }, ai: false });
  MentriaBus.provide('comms.share', async ({ filename, html, name }) => {
    if (!metaAction || !chunkAction) throw new Error('comms not connected');
    if (peers.size === 0) throw new Error('no peers to send to');
    if (new Blob([html]).size > MAX_FILE) throw new Error('extension too large to send');
    const file = new File([html], filename || 'extension.html', { type: 'text/html' });
    await sendOne(file, { kind: 'mentria-ext', extName: name });
    return { sentTo: peers.size };
  }, { description: 'Send an extension to connected comms peers.', parameters: { type: 'object', properties: { filename: { type: 'string' }, html: { type: 'string' }, name: { type: 'string' } }, required: ['html'] }, ai: false });
  MentriaBus.provide('extensions.requestInstall', ({ html, from }) => confirmInstall(html, { from }), { description: 'Install a received extension after a human trust prompt.', parameters: { type: 'object', properties: { html: { type: 'string' }, from: { type: 'string' } }, required: ['html'] }, ai: false });
};

els.join.addEventListener('click', () => {
  const name = (els.room.value || (EPHEMERAL_PREFIX + randomRoomSlug())).trim().slice(0, 64);
  const { b64Key } = parseHash(window.location.hash);
  joinNew(name, b64Key);
});

els.genkey.addEventListener('click', async () => {
  const bytes = crypto.getRandomValues(new Uint8Array(32));
  const key = b64urlEncode(bytes);
  const name = (els.room.value || (EPHEMERAL_PREFIX + randomRoomSlug())).trim().slice(0, 64);
  await joinNew(name, key);
  try {
    await navigator.clipboard.writeText(window.location.href);
    els.genkey.textContent = 'key generated · url copied';
    setTimeout(() => { els.genkey.textContent = '+ key'; }, 2000);
  } catch {
    els.genkey.textContent = 'key generated';
    setTimeout(() => { els.genkey.textContent = '+ key'; }, 2000);
  }
});

els.send.addEventListener('submit', async (e) => {
  e.preventDefault();
  const text = els.msg.value.trim();
  if (!text || !chatAction) return;
  const cmid = newCmid();
  seenCmids.add(cmid);
  let livePayload;
  if (chatKey) {
    try {
      const enc = await encryptText(chatKey, packChatPlain(text));
      livePayload = { cmid, enc };
    } catch (err) {
      sys('encryption failed: ' + err.message);
      return;
    }
  } else {
    livePayload = { text, cmid };
  }
  if (!navigator.onLine) {
    renderPendingLine(text, livePayload, cmid);
    els.msg.value = '';
    return;
  }
  chatAction.send(livePayload);
  publishChat(text, cmid);
  renderLine('you', text, { me: true });
  els.msg.value = '';
  maybeRingContact();
});

els.copy.addEventListener('click', async () => {
  try { await navigator.clipboard.writeText(els.url.textContent); els.copy.textContent = 'copied'; setTimeout(() => els.copy.textContent = 'copy', 1200); } catch {}
});

const dragEvents = ['dragenter', 'dragover'];
const undragEvents = ['dragleave', 'drop'];
dragEvents.forEach(ev => els.drop.addEventListener(ev, (e) => { e.preventDefault(); els.drop.classList.add('comms__drop--hot'); }));
undragEvents.forEach(ev => els.drop.addEventListener(ev, (e) => { e.preventDefault(); els.drop.classList.remove('comms__drop--hot'); }));
const CHUNK = 32 * 1024;
const sendOne = async (file, extra) => {
  const id = Math.random().toString(36).slice(2);
  const line = renderLine('you', '', { me: true, quiet: true, html: progressHTML('sending', file.name, file.size, 0) });
  await metaAction.send(Object.assign({ id, name: file.name, size: file.size, type: file.type }, extra || {}));
  const buf = await file.arrayBuffer();
  let sent = 0;
  for (let offset = 0; offset < buf.byteLength; offset += CHUNK) {
    if (peers.size === 0) {
      line.line.removeAttribute('aria-live');
      line.what.innerHTML = `send interrupted — <strong>${escapeHtml(file.name)}</strong>: everyone left the room`;
      throw new Error('all peers left during send');
    }
    const slice = buf.slice(offset, Math.min(offset + CHUNK, buf.byteLength));
    const done = offset + CHUNK >= buf.byteLength;
    await chunkAction.send(slice, { metadata: { id, done } });
    sent += slice.byteLength;
    line.what.innerHTML = progressHTML('sending', file.name, file.size, sent);
  }
  const previewUrl = trackObjectUrl(file);
  const n = peers.size;
  line.line.removeAttribute('aria-live');
  line.what.innerHTML = (n > 0
    ? `sent to ${n} peer${n === 1 ? '' : 's'} `
    : 'delivery uncertain — no peers connected ') + completeHTML(file.name, file.size, file.type, previewUrl);
};

const sendFiles = async (fileList) => {
  if (!metaAction || !chunkAction || peers.size === 0) { sys('no peers to send to.'); return; }
  const all = Array.from(fileList || []);
  if (!all.length) return;
  const tooBig = all.filter(f => f.size > MAX_FILE);
  const ok = all.filter(f => f.size <= MAX_FILE);
  if (tooBig.length) {
    sys(`skipped (over ${fmtMB(MAX_FILE)} cap): ${tooBig.map(f => `${f.name} ${fmtSize(f.size)}`).join(', ')}`);
  }
  if (!ok.length) return;
  const total = ok.reduce((s, f) => s + f.size, 0);
  if (ok.length > 1) sys(`sending ${ok.length} file${ok.length===1?'':'s'} (${fmtSize(total)}) to ${peers.size} peer${peers.size===1?'':'s'}…`);
  if (total > MAX_TOTAL_WARN) sys(`heads up: ${fmtSize(total)} total — this may take a while.`);
  for (const file of ok) {
    try { await sendOne(file); } catch (err) { sys(`send failed for ${file.name}: ${err.message}`); }
  }
};

els.drop.addEventListener('drop', (e) => { sendFiles(e.dataTransfer.files); });
els.file.addEventListener('change', (e) => { sendFiles(e.target.files); e.target.value = ''; });

const pickerEl = document.getElementById('comms-picker');
const pickerListEl = document.getElementById('comms-picker-list');
let pickerResolve = null;
let pickerOpener = null;
function pickerTrapTab(e) {
  if (e.key !== 'Tab') return;
  const focusables = [...pickerEl.querySelectorAll('button')].filter(b => b.offsetParent);
  if (!focusables.length) return;
  const first = focusables[0];
  const last = focusables[focusables.length - 1];
  if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
  else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  else if (!pickerEl.contains(document.activeElement)) { e.preventDefault(); first.focus(); }
}
function closePicker(value) {
  const r = pickerResolve;
  pickerResolve = null;
  pickerEl.hidden = true;
  pickerListEl.innerHTML = '';
  document.removeEventListener('keydown', pickerTrapTab, true);
  const opener = pickerOpener;
  pickerOpener = null;
  if (r) r(value);
  if (opener) setTimeout(() => { if (document.contains(opener)) opener.focus(); }, 0);
}
pickerEl.querySelectorAll('[data-picker-close]').forEach((el) => el.addEventListener('click', () => closePicker(null)));
document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !pickerEl.hidden) { e.preventDefault(); closePicker(null); } });
function pickExtension(list) {
  pickerListEl.innerHTML = '';
  list.forEach((ext) => {
    const item = document.createElement('button');
    item.type = 'button';
    item.className = 'comms__picker-item';
    const nm = document.createElement('span');
    nm.textContent = (ext.icon && !/^data:/.test(ext.icon) ? ext.icon + ' ' : '') + ext.name;
    const ver = document.createElement('span');
    ver.className = 'comms__picker-ver';
    ver.textContent = 'v' + ext.version;
    item.append(nm, ver);
    item.addEventListener('click', () => closePicker(ext));
    pickerListEl.appendChild(item);
  });
  pickerOpener = (document.activeElement && document.activeElement !== document.body) ? document.activeElement : attachExtBtn;
  pickerEl.hidden = false;
  document.addEventListener('keydown', pickerTrapTab, true);
  const first = pickerListEl.querySelector('.comms__picker-item');
  if (first) first.focus();
  return new Promise((res) => { pickerResolve = res; });
}

const attachExtBtn = document.getElementById('comms-attach-ext');
attachExtBtn.addEventListener('click', async () => {
  if (attachExtBtn.disabled) return;
  attachExtBtn.disabled = true;
  try {
    if (peers.size === 0) { sys('no peers to send to.'); return; }
    let list;
    try { list = await MentriaBus.invoke('extensions.list'); } catch (e) { sys('extensions unavailable: ' + e.message); return; }
    if (!list.length) { sys('no installed extensions to share.'); return; }
    const chosen = await pickExtension(list);
    if (!chosen) return;
    let html;
    try { html = await MentriaBus.invoke('extensions.getSource', { id: chosen.id }); } catch (e) { sys('could not read extension: ' + e.message); return; }
    if (!html) { sys('extension source missing.'); return; }
    const file = new File([html], chosen.id + '.html', { type: 'text/html' });
    await sendOne(file, { kind: 'mentria-ext', extName: chosen.name });
  } catch (e) { sys('send failed: ' + e.message); }
  finally { attachExtBtn.disabled = false; }
});

els.mute.addEventListener('click', () => {
  muted = !muted;
  els.mute.textContent = muted ? 'sound: off' : 'sound: on';
  els.mute.setAttribute('aria-pressed', String(muted));
  try { localStorage.setItem('comms.muted', muted ? '1' : '0'); } catch (_) {}
  if (!muted) playPing(880);
});
if (muted) { els.mute.textContent = 'sound: off'; els.mute.setAttribute('aria-pressed', 'true'); }

const updateCallUI = () => {
  const inRoom = !!room;
  els.callStart.hidden = !inRoom || call.active;
  els.callCam.hidden = !call.active;
  els.callMic.hidden = !call.active;
  els.callHangup.hidden = !call.active;
  els.media.hidden = callTiles.size === 0;
};

const addTile = (key, stream, opts = {}) => {
  removeTile(key);
  const tile = document.createElement('div');
  tile.className = 'comms__tile';
  const hasVideo = stream.getVideoTracks().some((t) => t.readyState === 'live');
  let mediaEl;
  if (hasVideo) {
    mediaEl = document.createElement('video');
    mediaEl.autoplay = true;
    mediaEl.playsInline = true;
    if (opts.local) mediaEl.muted = true;
  } else {
    mediaEl = document.createElement('audio');
    mediaEl.autoplay = true;
    if (opts.local) mediaEl.muted = true;
    mediaEl.style.display = 'none';
    const voice = document.createElement('span');
    voice.className = 'comms__tile-voice';
    voice.textContent = '\u{1F399}';
    tile.append(voice);
  }
  mediaEl.srcObject = stream;
  tile.append(mediaEl);
  const label = document.createElement('span');
  label.className = 'comms__tile-label';
  label.textContent = opts.label || 'peer';
  tile.append(label);
  els.media.append(tile);
  callTiles.set(key, { tile, stream });
  updateCallUI();
};

const removeTile = (key) => {
  const t = callTiles.get(key);
  if (!t) return;
  t.tile.remove();
  callTiles.delete(key);
  updateCallUI();
};

const stopRinging = () => {
  if (call.ringTimer) { clearInterval(call.ringTimer); call.ringTimer = null; }
  els.ring.hidden = true;
};

const getLocalMedia = (video) => navigator.mediaDevices.getUserMedia({
  audio: { echoCancellation: true, noiseSuppression: true },
  video: video ? { width: { ideal: 640 }, height: { ideal: 480 } } : false
});

const startCall = async (answering) => {
  if (call.active || !room) return;
  if (!peers.size) { sys('no peers to call.'); return; }
  if (peers.size > 4) { sys('calls support up to 5 people in a room (peer-to-peer mesh).'); return; }
  let local;
  try { local = await getLocalMedia(false); }
  catch (err) { sys('microphone unavailable: ' + err.message); return; }
  call.active = true;
  call.local = local;
  call.videoOn = false;
  call.micOff = false;
  els.callCam.setAttribute('aria-pressed', 'false');
  els.callCam.title = 'camera off — tap to turn on';
  els.callCam.setAttribute('aria-pressed', 'false');
  els.callMic.setAttribute('aria-pressed', 'true');
  els.callMic.title = 'mic on — tap to mute';
  els.callMic.setAttribute('aria-pressed', 'false');
  room.addStream(local);
  addTile('you', local, { local: true, label: myProfile.name || 'you' });
  pendingStreams.forEach((stream, peerId) => addTile(peerId, stream, { label: displayName(peerId) }));
  pendingStreams.clear();
  if (!answering) {
    callAction.send({ kind: 'ring' });
    sys('calling the room… they need to accept.');
  } else {
    callAction.send({ kind: 'join' });
  }
  updateCallUI();
};

const endCall = (silent) => {
  stopRinging();
  if (!call.active) { pendingStreams.clear(); return; }
  try { if (callAction && !silent) callAction.send({ kind: 'leave' }); } catch {}
  try { if (room && call.local) room.removeStream(call.local); } catch {}
  if (call.local) call.local.getTracks().forEach((t) => t.stop());
  call.local = null;
  call.active = false;
  callTiles.forEach((t) => t.tile.remove());
  callTiles.clear();
  pendingStreams.clear();
  updateCallUI();
  if (!silent) sys('call ended.');
};

