---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{%- for page in collections.all -%}
{%- if not page.data.eleventyExcludeFromSitemap and not (page.url | startsWith('/assets/')) -%}
{%- if page.data.englishOnly %}
  <url>
    <loc>{{ site.siteUrl }}{{ page.url }}</loc>
    <lastmod>{{ (page.data.modified or page.date).toISOString() }}</lastmod>
  </url>
{%- else -%}
{%- for locale in locales %}
  <url>
    <loc>{{ site.siteUrl }}{{ locale.pathPrefix }}{{ page.url }}</loc>
    <lastmod>{{ (page.data.modified or page.date).toISOString() }}</lastmod>
  </url>
{%- endfor -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- for pair in deepcutsLocalized %}
  <url><loc>{{ site.siteUrl }}{{ pair.locale.pathPrefix }}/feed/deepcuts/{{ pair.edition.id }}/</loc>{% for img in pair.edition | deckImages(pair.locale.code) %}<image:image><image:loc>{{ img.url }}</image:loc></image:image>{% endfor %}</url>
{%- endfor -%}
{%- for pair in sourceLocalized %}
  <url><loc>{{ site.siteUrl }}{{ pair.locale.pathPrefix }}/feed/source/{{ pair.deck.id }}/</loc>{% for img in pair.deck | deckImages(pair.locale.code) %}<image:image><image:loc>{{ img.url }}</image:loc></image:image>{% endfor %}</url>
{%- endfor -%}
{%- for pair in extensionsLocalized %}
  <url><loc>{{ site.siteUrl }}{{ pair.locale.pathPrefix }}/extensions/{{ pair.ext.id }}/</loc></url>
{%- endfor -%}
{%- for pair in chaptersLocalized %}
  <url><loc>{{ site.siteUrl }}{{ pair.locale.pathPrefix }}/feed/chapter/{{ pair.chapter.id }}/</loc>{% for img in pair.chapter | deckImages(pair.locale.code) %}<image:image><image:loc>{{ img.url }}</image:loc></image:image>{% endfor %}</url>
{%- endfor -%}
{%- for pair in storiesLocalized %}
  <url><loc>{{ site.siteUrl }}{{ pair.locale.pathPrefix }}/feed/story/{{ pair.deck.id }}/</loc>{% for img in pair.deck | deckImages(pair.locale.code) %}<image:image><image:loc>{{ img.url }}</image:loc></image:image>{% endfor %}</url>
{%- endfor -%}
</urlset>
