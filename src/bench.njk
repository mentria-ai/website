---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/bench/index.html"
robots: "noindex, nofollow"
title: "Model benchmark"
description: "Measures load time, time to first token and decode speed of the on-device model tiers on this device."
eleventyComputed:
  lang: "{{ locale.code }}"
---
<section class="hero" style="padding-top:1rem;">
  <p class="eyebrow eyebrow--crumbs"><a class="eyebrow__link" href="{{ locale.pathPrefix }}/">~</a><span class="eyebrow__sep">/</span><span class="eyebrow__current">bench</span></p>
  <h1>Model benchmark</h1>
  <p class="lede">Loads a tier in this tab, runs fixed prompts, and reports load time, time to first token and decode speed. Close other model tabs first: one engine per device.</p>
</section>

<section class="bench" id="bench">
  <div class="bench__grid">
    <fieldset class="bench__box">
      <legend>Tiers</legend>
      <div id="bench-tiers" class="bench__tiers"></div>
      <label class="bench__opt"><input type="checkbox" id="bench-vision"> load the vision model too and run one image prompt</label>
      <label class="bench__opt"><input type="checkbox" id="bench-force"> ignore eligibility (may crash the tab on small devices)</label>
      <label class="bench__opt"><input type="checkbox" id="bench-profile"> profile run: per-pass GPU timings on the first prompt (slower while profiling; use when asked)</label>
      <label class="bench__opt"><input type="checkbox" id="bench-quick"> quick (short prompt only)</label>
      <label class="bench__opt">runs per prompt <input type="number" id="bench-runs" min="1" max="5" value="1" style="width:4rem"></label>
      <label class="bench__opt">init/load options JSON (applied to init and loadModel) <input type="text" id="bench-init" placeholder='{"mobileMatvec":"ksplit"}' style="width:100%;font-family:var(--font-mono);font-size:.8rem"></label>
      <label class="bench__opt">generate options JSON, one object or a list (each entry runs the prompts once on the same load, in order) <input type="text" id="bench-gen" placeholder='[{"mobilePrefill":"off","m1VecmatRoute":false},{"mobilePrefill":"mrow"}]' style="width:100%;font-family:var(--font-mono);font-size:.8rem"></label>
      <label class="bench__opt">max tokens per prompt (blank = prompt default) <input type="number" id="bench-maxtok" min="4" max="512" style="width:5rem"></label>
      <div class="bench__actions">
        <button class="bench__btn" id="bench-run" type="button">Run selected</button>
        <button class="bench__btn bench__btn--ghost" id="bench-copy" type="button" disabled>Copy markdown</button>
        <button class="bench__btn bench__btn--ghost" id="bench-summary" type="button" disabled>Copy summary</button>
        <button class="bench__btn bench__btn--ghost" id="bench-json" type="button" disabled>Copy diagnostics JSON</button>
      </div>
      <p class="bench__status" id="bench-status" aria-live="polite">idle</p>
    </fieldset>
    <fieldset class="bench__box">
      <legend>This device</legend>
      <pre class="bench__pre" id="bench-device">reading…</pre>
    </fieldset>
  </div>
  <div class="bench__tablewrap">
    <table class="bench__table" id="bench-table" hidden>
      <thead><tr><th>tier</th><th>vision</th><th>cached</th><th>load s</th><th>prompt</th><th>TTFT ms</th><th>decode tok/s</th><th>tokens</th><th>total s</th></tr></thead>
      <tbody id="bench-rows"></tbody>
    </table>
  </div>
  <pre class="bench__pre bench__log" id="bench-log"></pre>
</section>

<style>
.bench { max-width: var(--wide, 1100px); margin: 0 auto; padding: 0 1rem 3rem; }
.bench__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
@media (max-width: 720px) { .bench__grid { grid-template-columns: 1fr; } }
.bench__box { border: 1px solid var(--border, rgba(255,255,255,.12)); border-radius: 12px; padding: 1rem; min-width: 0; }
.bench__box legend { font-family: var(--font-mono); font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted, #8896a8); padding: 0 .4rem; }
.bench__tiers { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: .75rem; }
.bench__tiers label { display: inline-flex; align-items: center; gap: .4rem; border: 1px solid var(--border, rgba(255,255,255,.14)); border-radius: 999px; padding: .35rem .8rem; font-family: var(--font-mono); font-size: .9rem; }
.bench__tiers label.is-off { opacity: .55; }
.bench__opt { display: block; font-size: .9rem; margin: .35rem 0; }
.bench__actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .8rem; }
.bench__btn { background: var(--accent, #6ef3c5); color: #0a0a0a; border: 0; border-radius: 8px; padding: .55rem 1rem; font-family: var(--font-mono); font-weight: 600; cursor: pointer; }
.bench__btn--ghost { background: transparent; color: var(--fg, #e2e8f0); border: 1px solid var(--border, rgba(255,255,255,.2)); }
.bench__btn:disabled { opacity: .45; cursor: default; }
.bench__status { font-family: var(--font-mono); font-size: .85rem; color: var(--accent, #6ef3c5); margin: .8rem 0 0; min-height: 1.2em; overflow-wrap: anywhere; }
.bench__pre { font-family: var(--font-mono); font-size: .78rem; line-height: 1.45; white-space: pre-wrap; overflow-wrap: anywhere; margin: 0; color: var(--muted, #c9d4df); }
.bench__log { margin-top: 1rem; max-height: 14rem; overflow: auto; border-top: 1px solid var(--border, rgba(255,255,255,.1)); padding-top: .75rem; }
.bench__tablewrap { overflow-x: auto; margin-top: 1rem; }
.bench__table { border-collapse: collapse; width: 100%; font-family: var(--font-mono); font-size: .82rem; }
.bench__table th, .bench__table td { text-align: left; padding: .45rem .6rem; border-bottom: 1px solid var(--border, rgba(255,255,255,.1)); white-space: nowrap; }
.bench__table th { color: var(--muted, #8896a8); font-weight: 500; }
</style>

<script type="module">
const $ = (s) => document.querySelector(s);
const statusEl = $('#bench-status');
const logEl = $('#bench-log');
const rowsEl = $('#bench-rows');
const tableEl = $('#bench-table');
const results = [];
const consoleLines = [];
for (const level of ['log', 'info', 'warn', 'error']) {
  const orig = console[level].bind(console);
  console[level] = (...args) => { try { consoleLines.push(level + ': ' + args.map((a) => typeof a === 'string' ? a : JSON.stringify(a)).join(' ').slice(0, 300)); if (consoleLines.length > 200) consoleLines.shift(); } catch (_) {} orig(...args); };
}
const PROMPTS = [
  { id: 'short', system: 'You answer in one short sentence.', user: 'What is a countdown timer for?', maxTokens: 40 },
  { id: 'medium', system: 'You are a concise assistant.', user: 'Explain in three sentences how a web page can run a language model on the GPU.', maxTokens: 120 },
  { id: 'long', system: 'You are a helpful writer.', user: 'Write a 150 word note about why keeping data on the device matters, in plain language.', maxTokens: 220 }
];
const setStatus = (t) => { statusEl.textContent = t; };
const log = (t) => { logEl.textContent += t + '\n'; logEl.scrollTop = logEl.scrollHeight; };
const compact = (o, depth) => { if (depth > 3 || o == null || typeof o !== 'object') return o; if (Array.isArray(o)) return o.slice(0, 40).map((x) => compact(x, depth + 1)); const out = {}; let n = 0; for (const k of Object.keys(o)) { if (n++ > 60) break; const v = o[k]; if (typeof v === 'function') continue; if (ArrayBuffer.isView(v)) { out[k] = '[typed array ' + v.length + ']'; continue; } out[k] = compact(v, depth + 1); } return out; };
const parseJson = (txt) => { const t = String(txt || '').trim(); if (!t) return null; try { const v = JSON.parse(t); return v && typeof v === 'object' ? v : null; } catch (e) { log('options JSON ignored: ' + e.message); return null; } };
const genConfigs = () => { const v = parseJson($('#bench-gen').value); if (!v) return [null]; return Array.isArray(v) ? v.filter((x) => x && typeof x === 'object') : [v]; };
const maxTokOverride = () => { const n = +$('#bench-maxtok').value; return n >= 4 ? Math.min(512, n) : null; };
const percentile = (arr, p) => { if (!arr.length) return null; const a = arr.slice().sort((x, y) => x - y); return a[Math.min(a.length - 1, Math.floor(p * (a.length - 1)))]; };

const device = { ua: navigator.userAgent, deviceMemory: navigator.deviceMemory || null, cores: navigator.hardwareConcurrency || null, webgpu: !!navigator.gpu };
async function readDevice() {
  try {
    const est = navigator.storage && navigator.storage.estimate ? await navigator.storage.estimate() : null;
    if (est) device.storage = { usageGB: +((est.usage || 0) / 1e9).toFixed(2), quotaGB: +((est.quota || 0) / 1e9).toFixed(1) };
    if (navigator.gpu) {
      const adapter = await navigator.gpu.requestAdapter();
      if (adapter) {
        const info = adapter.info || (adapter.requestAdapterInfo ? await adapter.requestAdapterInfo() : {});
        device.gpu = { vendor: info.vendor || '', architecture: info.architecture || '', device: info.device || '', description: info.description || '' };
        device.features = [...adapter.features];
        const L = adapter.limits;
        device.limits = { maxBufferSize: L.maxBufferSize, maxStorageBufferBindingSize: L.maxStorageBufferBindingSize, maxUniformBufferBindingSize: L.maxUniformBufferBindingSize, maxComputeWorkgroupStorageSize: L.maxComputeWorkgroupStorageSize, maxComputeInvocationsPerWorkgroup: L.maxComputeInvocationsPerWorkgroup, maxComputeWorkgroupSizeX: L.maxComputeWorkgroupSizeX, maxComputeWorkgroupSizeY: L.maxComputeWorkgroupSizeY, maxComputeWorkgroupsPerDimension: L.maxComputeWorkgroupsPerDimension, maxBindGroups: L.maxBindGroups, maxStorageBuffersPerShaderStage: L.maxStorageBuffersPerShaderStage };
      }
    }
  } catch (e) { device.error = String(e && e.message || e); }
  $('#bench-device').textContent = JSON.stringify(device, null, 1);
}

const Tiers = await import('/assets/js/mentria-tiers.js');
const chain = Tiers.TIER_CHAIN || ['0.8b', '2b', '4b', '27b'];
const decision = await Tiers.decideTier().catch(() => ({ tier: '0.8b', eligible: [] }));
const eligible = new Set([decision.tier, chain[chain.length - 1]].concat(decision.eligible || []));
const tiersEl = $('#bench-tiers');
for (const id of chain) {
  const t = Tiers.TIERS[id];
  if (!t) continue;
  const cached = await Tiers.isTierCached(id).catch(() => false);
  const lab = document.createElement('label');
  lab.className = eligible.has(id) ? '' : 'is-off';
  lab.innerHTML = '<input type="checkbox" value="' + id + '"' + (id === decision.tier ? ' checked' : '') + '> ' + id + ' · ' + (t.sizeLabel || '') + (cached ? ' · cached' : '') + (eligible.has(id) ? '' : ' · not eligible');
  tiersEl.appendChild(lab);
}
log('decision: tier=' + decision.tier + ' eligible=' + [...eligible].join(',') + (decision.reason ? ' reason=' + decision.reason : ''));
readDevice();
const diagnostics = { version: 2, device, decision: compact(decision, 0), runs: [] };

function makeTestImage() {
  const c = document.createElement('canvas'); c.width = 448; c.height = 448;
  const x = c.getContext('2d');
  x.fillStyle = '#f4f1ea'; x.fillRect(0, 0, 448, 448);
  x.fillStyle = '#1b1f24'; x.font = 'bold 40px sans-serif'; x.fillText('GATE 12', 40, 90);
  x.font = '28px sans-serif'; x.fillText('Boarding 14:35', 40, 150); x.fillText('Seat 21A', 40, 200);
  x.fillStyle = '#d33'; x.fillRect(40, 260, 160, 120);
  x.fillStyle = '#2a7'; x.beginPath(); x.arc(330, 320, 70, 0, Math.PI * 2); x.fill();
  return c;
}

async function stats(engine) { try { const r = await Promise.race([engine.getStats(), new Promise((_, rej) => setTimeout(() => rej(new Error('getStats timeout 5 s')), 5000))]); return compact(r, 0); } catch (e) { return { error: String(e && e.message || e) }; } }

async function runTier(id, vision, runs, force, profile, quick) {
  if (!eligible.has(id) && !force) { log(id + ': skipped (not eligible; tick "ignore eligibility" to force)'); return; }
  const { MentriaEngine } = await import('/assets/mentria/dist/mentria.mjs');
  const engine = new MentriaEngine('/assets/mentria/dist/worker.mjs');
  if (window.mentriaWrapEngine) window.mentriaWrapEngine(engine);
  const run = { tier: id, vision, profile, fallbacks: [], prompts: [], consoleStart: consoleLines.length };
  engine.onProgress = (p) => { const pct = p && p.total ? Math.round(100 * p.loaded / p.total) : null; setStatus(id + ': ' + ((p && p.message) || 'loading') + (pct != null ? ' ' + pct + '%' : '')); };
  try { engine.onFallback = (e) => { run.fallbacks.push(compact(e, 0)); log(id + ': fallback event ' + JSON.stringify(compact(e, 0)).slice(0, 200)); }; } catch (_) {}
  const cached = await Tiers.isTierCached(id).catch(() => false);
  run.cached = cached;
  const t0 = performance.now();
  try {
    const tInit = performance.now();
    run.initOptions = parseJson($('#bench-init').value);
    run.genOptions = genConfigs();
    const initRes = run.initOptions ? await engine.init(run.initOptions) : await engine.init();
    run.initResult = compact(initRes, 0);
    run.initS = +((performance.now() - tInit) / 1000).toFixed(2);
    const opts = await Tiers.loadOptionsFor(id, { vision });
    run.maxSeq = opts && opts.config && opts.config.attention ? opts.config.attention.maxSeq : null;
    const loadRes = await engine.loadModel(run.initOptions ? Object.assign({}, opts, run.initOptions) : opts);
    run.loadResult = compact(loadRes, 0);
  } catch (e) {
    run.loadError = String(e && e.message || e);
    log(id + ': load failed: ' + run.loadError);
    diagnostics.runs.push(run);
    try { engine.terminate(); } catch (_) {}
    return;
  }
  const loadS = +((performance.now() - t0) / 1000).toFixed(1);
  run.loadS = loadS;
  run.statsAfterLoad = await stats(engine);
  log(id + ': loaded in ' + loadS + ' s (cached before run: ' + cached + ', vision: ' + vision + ', route: ' + JSON.stringify(run.loadResult && (run.loadResult.decodeRoute || run.loadResult.route || '')) + ')');
  let prompts = quick ? PROMPTS.slice(0, 1) : PROMPTS.slice();
  if (vision) prompts.push({ id: 'image', system: 'You describe images precisely.', user: 'Read all the text in this image and name the two shapes.', maxTokens: 80, image: true });
  let gi = 0;
  for (const g of run.genOptions) for (const p of prompts) {
    const gLabel = g ? ' ' + JSON.stringify(g) : '';
    const userText = run.genOptions.length > 1 ? 'Variant ' + (run.genOptions.indexOf(g) + 1) + ': ' + p.user : p.user;
    for (let r = 0; r < runs; r++) {
      setStatus(id + ': ' + p.id + gLabel + ' run ' + (r + 1) + '/' + runs);
      let tokens = 0, tFirst = 0, text = '', tPrev = 0;
      const gaps = [];
      const params = Object.assign({}, g || {}, {
        messages: p.image
          ? [{ role: 'system', content: p.system }, { role: 'user', content: [{ type: 'image' }, { type: 'text', text: userText }] }]
          : [{ role: 'system', content: p.system }, { role: 'user', content: userText }],
        maxTokens: maxTokOverride() || p.maxTokens, temperature: 0, topK: 1, topP: 1, repetitionPenalty: p.image ? 1.15 : 1.0, enableThinking: false
      });
      const profiles = [];
      if (profile && r === 0 && (device.features || []).includes('timestamp-query')) { params.tsAll2 = 2; params.onProfile = (pr) => { profiles.push(compact(pr, 0)); }; }
      if (p.image) {
        const c = makeTestImage();
        const d = c.getContext('2d').getImageData(0, 0, c.width, c.height).data;
        const rgb = new Uint8Array(c.width * c.height * 3);
        for (let i = 0, j = 0; i < d.length; i += 4, j += 3) { rgb[j] = d[i]; rgb[j + 1] = d[i + 1]; rgb[j + 2] = d[i + 2]; }
        params.images = [{ rgbHwc: rgb, h: c.height, w: c.width }];
      }
      const statsBefore = await stats(engine);
      const tStart = performance.now();
      let finalEvent = null;
      try {
        await engine.generate(params, (ev) => {
          if (ev && ev.finished) finalEvent = compact(ev, 0);
          if (typeof ev.token === 'string' && ev.token.length) {
            if (/^<\|[^|]*\|>$/.test(ev.token)) return;
            const now = performance.now();
            tokens++; text += ev.token;
            if (!tFirst) tFirst = now; else gaps.push(now - tPrev);
            tPrev = now;
          }
        });
      } catch (e) { log(id + ' ' + p.id + ': generate failed: ' + (e && e.message || e)); run.prompts.push({ id: p.id, error: String(e && e.message || e) }); continue; }
      const tEnd = performance.now();
      const ttft = tFirst ? Math.round(tFirst - tStart) : null;
      const decode = tFirst && tokens > 1 ? +(((tokens - 1) / ((tEnd - tFirst) / 1000))).toFixed(2) : null;
      const statsAfter = await stats(engine);
      const row = { tier: id, vision: vision, cached: cached, loadS: loadS, prompt: p.id + gLabel, run: r + 1, ttftMs: ttft, decodeTps: decode, tokens: tokens, totalS: +((tEnd - tStart) / 1000).toFixed(2), sample: text.replace(/\s+/g, ' ').slice(0, 90) };
      results.push(row);
      addRow(row);
      const promptTokens = finalEvent && typeof finalEvent.committedTokens === 'number' && typeof finalEvent.numTokens === 'number' ? finalEvent.committedTokens - finalEvent.numTokens : null;
      const prefillTps = promptTokens && ttft ? +((promptTokens / (ttft / 1000))).toFixed(1) : null;
      run.prompts.push({ id: p.id + gLabel, gen: g || null, run: r + 1, ttftMs: ttft, decodeTps: decode, tokens, totalS: row.totalS, promptTokens, prefillTps, engineTps: finalEvent ? finalEvent.tokensPerSecond : null, gapMs: { min: Math.round(percentile(gaps, 0)), median: Math.round(percentile(gaps, 0.5)), p90: Math.round(percentile(gaps, 0.9)), max: Math.round(percentile(gaps, 1)) }, promptChars: p.user.length + p.system.length, image: !!p.image, profileFlags: !!params.tsAll2, profiles, statsBefore, statsAfter, finalEvent, sample: row.sample });
      log(id + ' ' + p.id + gLabel + ': ttft ' + ttft + ' ms, ' + decode + ' tok/s, ' + tokens + ' tokens, gap median ' + Math.round(percentile(gaps, 0.5)) + ' ms (p90 ' + Math.round(percentile(gaps, 0.9)) + ') · "' + row.sample + '"');
    }
  }
  run.consoleLines = consoleLines.slice(run.consoleStart);
  delete run.consoleStart;
  diagnostics.runs.push(run);
  try { engine.terminate(); } catch (_) {}
  setStatus(id + ': done, engine released');
}

function addRow(r) {
  tableEl.hidden = false;
  const tr = document.createElement('tr');
  tr.innerHTML = [r.tier, r.vision ? 'yes' : 'no', r.cached ? 'yes' : 'no', r.loadS, r.prompt + (r.run > 1 ? ' #' + r.run : ''), r.ttftMs == null ? '' : r.ttftMs, r.decodeTps == null ? '' : r.decodeTps, r.tokens, r.totalS].map((v) => '<td>' + v + '</td>').join('');
  rowsEl.appendChild(tr);
  for (const b of ['#bench-copy', '#bench-json', '#bench-summary']) $(b).disabled = false;
}

function markdown() {
  const head = '| tier | vision | cached | load s | prompt | TTFT ms | decode tok/s | tokens | total s |\n|---|---|---|---|---|---|---|---|---|\n';
  const body = results.map((r) => '| ' + [r.tier, r.vision ? 'yes' : 'no', r.cached ? 'yes' : 'no', r.loadS, r.prompt + (r.run > 1 ? ' #' + r.run : ''), r.ttftMs == null ? '' : r.ttftMs, r.decodeTps == null ? '' : r.decodeTps, r.tokens, r.totalS].join(' | ') + ' |').join('\n');
  const dev = device.gpu ? (device.gpu.description || device.gpu.architecture || device.gpu.vendor) : 'no webgpu';
  return '### ' + dev + ' · ' + (device.deviceMemory || '?') + ' GB device memory · ' + new Date().toISOString().slice(0, 16).replace('T', ' ') + '\n\n' + head + body + '\n\nfeatures: ' + (device.features || []).join(', ') + '\nlimits: ' + JSON.stringify(device.limits || {}) + '\n';
}

function summary() {
  const dev = device.gpu ? [device.gpu.vendor, device.gpu.architecture, device.gpu.description].filter(Boolean).join(' ') : 'no webgpu';
  const lines = ['bench ' + new Date().toISOString().slice(0, 16).replace('T', ' ') + ' · ' + dev + ' · mem ' + (device.deviceMemory || '?') + ' GB · f16 ' + ((device.features || []).includes('shader-f16') ? 'y' : 'n') + ' subgroups ' + ((device.features || []).includes('subgroups') ? 'y' : 'n') + ' · bind ' + Math.round(((device.limits || {}).maxStorageBufferBindingSize || 0) / 1048576) + ' MiB · wg ' + ((device.limits || {}).maxComputeInvocationsPerWorkgroup || '?')];
  for (const run of diagnostics.runs) {
    const lr = run.loadResult || {};
    const ns = lr.narrowSubgroup;
    const bp = lr.bindingPlan;
    const ge = run.statsAfterLoad && run.statsAfterLoad.gpuErrors;
    const lpf = lr.loadPlan && lr.loadPlan.fallbackEvents ? lr.loadPlan.fallbackEvents.length : 0;
    lines.push(run.tier + (run.vision ? '+vl' : '') + (run.initOptions ? ' init' + JSON.stringify(run.initOptions) : '') + ': load ' + run.loadS + ' s' + (run.loadError ? ' LOAD ERROR ' + run.loadError : '') + ' · decodeRoute ' + JSON.stringify(lr.decodeRoute == null ? '?' : lr.decodeRoute) + ' · narrow ' + (ns == null ? 'n/a' : (ns.published ? 'PUBLISHED@' + ns.width : 'NOT published@' + ns.width + ' (' + String(ns.reason || '').slice(0, 80) + ')')) + ' · windows ' + (bp ? bp.windowCount + (bp.overLimit && bp.overLimit.length ? ' overLimit ' + bp.overLimit.map((o) => o.name).join(',') : '') : '?') + ' · gpuErrors ' + (ge ? ge.count : '?') + ' · loadFallbacks ' + lpf + (run.fallbacks.length ? ' · hostFallbacks ' + run.fallbacks.length : ''));
    if (lr.kernelVariants) lines.push('  variants ' + JSON.stringify(lr.kernelVariants).slice(0, 220));
    if (lr.mobileMatvec) lines.push('  mobileMatvec ' + JSON.stringify(lr.mobileMatvec).slice(0, 200)); else if (lr.kernelVariants && lr.kernelVariants.mobileMatvecReason) lines.push('  mobileMatvec declined: ' + lr.kernelVariants.mobileMatvecReason);
    if (ns && (ns.probeCached != null || ns.cacheStatus)) lines.push('  probe cache ' + (ns.cacheStatus || '') + ' cached=' + ns.probeCached);
    for (const p of run.prompts) {
      const fe = p.finalEvent || {};
      const c = fe.counters && fe.counters.perDecodeToken ? fe.counters.perDecodeToken : null;
      const cp = fe.counters && fe.counters.perPrefillToken ? fe.counters.perPrefillToken : null;
      lines.push('  ' + p.id + ': ttft ' + p.ttftMs + ' ms' + (p.promptTokens ? ' (' + p.promptTokens + ' prompt tok, prefill ' + p.prefillTps + ' tok/s)' : '') + ' · ' + p.decodeTps + ' tok/s' + (fe.decodeTokensPerSecond ? ' (engine ' + (+fe.decodeTokensPerSecond).toFixed(1) + ')' : '') + ' · ' + p.tokens + ' tok · gap med ' + (p.gapMs ? p.gapMs.median : '?') + ' p90 ' + (p.gapMs ? p.gapMs.p90 : '?') + ' max ' + (p.gapMs ? p.gapMs.max : '?') + (c ? ' · disp/tok ' + (+c.dispatches).toFixed(0) + ' map/tok ' + (+c.mapAsync).toFixed(2) + ' cmd/tok ' + (+c.cmdBufs).toFixed(0) : '') + (cp ? ' · disp/prompt-tok ' + (+cp.dispatches).toFixed(1) : '') + (fe.decodeRoute ? ' · ' + fe.decodeRoute : '') + (fe.kernelVariants && fe.kernelVariants.prefillRoute ? ' · prefill ' + fe.kernelVariants.prefillRoute + (fe.kernelVariants.mobilePrefill ? '(' + (typeof fe.kernelVariants.mobilePrefill === 'object' ? (fe.kernelVariants.mobilePrefill.reason || JSON.stringify(fe.kernelVariants.mobilePrefill).slice(0, 60)) : String(fe.kernelVariants.mobilePrefill)) + ')' : '') : '') + (fe.prefillReused ? ' · prefillReused ' + fe.prefillReused : '') + (fe.kernelVariants && fe.kernelVariants.m1VecmatRoute != null ? ' · m1 ' + fe.kernelVariants.m1VecmatRoute + (fe.kernelVariants.m1VecmatRouteReason ? '(' + String(fe.kernelVariants.m1VecmatRouteReason).slice(0, 40) + ')' : '') : '') + (fe.fallbacks && fe.fallbacks.length ? ' · fallbacks ' + fe.fallbacks.length : '') + (p.profiles && p.profiles.length ? ' · profile ' + p.profiles.length + ' msg' : '') + (p.error ? ' ERROR ' + p.error : ''));
      if (p.profiles && p.profiles.length && p.profiles[0].decode && p.profiles[0].decode.byLabel) { const n = Math.max(1, p.tokens || 1); lines.push('    decode passes (ms per token): ' + p.profiles[0].decode.byLabel.slice(0, 8).map((b) => (b.label || b.name) + ' ' + (b.sumUs != null ? (b.sumUs / 1000 / n).toFixed(2) : '?') + ' ×' + (b.count != null ? Math.round(b.count / n) : '?')).join(', ') + (p.profiles[0].decode.totalUs ? ' · gpu total ' + (p.profiles[0].decode.totalUs / 1000 / n).toFixed(1) + ' ms/tok' : '')); if (p.profiles[0].prefill && p.profiles[0].prefill.byLabel) lines.push('    prefill passes (ms total): ' + p.profiles[0].prefill.byLabel.slice(0, 6).map((b) => (b.label || b.name) + ' ' + (b.sumUs != null ? (b.sumUs / 1000).toFixed(1) : '?')).join(', ') + (p.profiles[0].prefill.totalUs ? ' · gpu total ' + (p.profiles[0].prefill.totalUs / 1000).toFixed(1) + ' ms' : '')); }
    }
  }
  return lines.join('\n');
}

$('#bench-run').addEventListener('click', async () => {
  const ids = [...tiersEl.querySelectorAll('input:checked')].map((i) => i.value);
  if (!ids.length) { setStatus('pick at least one tier'); return; }
  const vision = $('#bench-vision').checked;
  const force = $('#bench-force').checked;
  const profile = $('#bench-profile').checked;
  const quick = $('#bench-quick').checked;
  const runs = Math.max(1, Math.min(5, +$('#bench-runs').value || 1));
  $('#bench-run').disabled = true;
  try {
    for (const id of ids) await runTier(id, vision, runs, force, profile, quick);
  } finally {
    $('#bench-run').disabled = false;
  }
});
const copyText = async (text, okMsg) => { try { await navigator.clipboard.writeText(text); setStatus(okMsg); } catch (_) { const ta = document.createElement('textarea'); ta.value = text; ta.style.cssText = 'position:fixed;left:0;top:0;width:90vw;height:40vh;z-index:9'; document.body.appendChild(ta); ta.select(); setStatus('clipboard blocked; text shown below, select and copy'); } };
$('#bench-copy').addEventListener('click', () => copyText(markdown(), 'markdown copied'));
$('#bench-json').addEventListener('click', () => copyText(JSON.stringify(diagnostics), 'diagnostics json copied'));
$('#bench-summary').addEventListener('click', () => copyText(summary(), 'summary copied'));
</script>
