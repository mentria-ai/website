        <button class="comms__btn comms__btn--ghost" id="comms-attach-ext" type="button">{{ 'tool.comms.adv.attach_ext' | t }}</button>
        <button class="comms__btn comms__btn--ghost" id="comms-attach-pack" type="button">{{ 'tool.comms.adv.attach_pack' | t }}</button>
        <button class="comms__btn comms__btn--ghost" id="comms-pk-settings" type="button" hidden>{{ 'tool.comms.passkey.add' | t }}</button>
        <a class="comms__btn comms__btn--ghost" href="{{ locale.pathPrefix }}/about/">{{ 'tool.comms.adv.identity' | t }}</a>
      </div>
    </div>
  </div>

  <div class="comms__picker" id="comms-picker" hidden>
    <div class="comms__picker-backdrop" data-picker-close></div>
    <div class="comms__picker-card" role="dialog" aria-modal="true" aria-label="{{ 'tool.comms.picker.title' | t }}">
