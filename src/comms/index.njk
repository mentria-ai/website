const refreshMyCode = () => {
  if (els.idCard.hidden || !myId) return;
  const code = CID.encodeContactCode(myProfile, myId.publicJwk, ringToken);
  els.idCode.textContent = code;
  try {
    const qr = qrcodegen.QrCode.encodeText(code, qrcodegen.QrCode.Ecc.LOW);
    const border = 2, px = 4, dim = qr.size + border * 2;
    els.idQr.width = dim * px; els.idQr.height = dim * px;
    const ctx = els.idQr.getContext('2d');
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, els.idQr.width, els.idQr.height);
    ctx.fillStyle = '#000000';
    for (let y = 0; y < qr.size; y++) {
      for (let x = 0; x < qr.size; x++) {
        if (qr.getModule(x, y)) ctx.fillRect((x + border) * px, (y + border) * px, px, px);
      }
    }
  } catch {}
};

els.idShare.addEventListener('click', () => {
