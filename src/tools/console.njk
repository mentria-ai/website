.cs__bar select { flex: 1; min-width: 0; background: var(--term-bg-raised, #0d0f12); border: 1px solid var(--term-border, #2a3138); color: var(--term-fg); border-radius: 7px; padding: 0.35rem 0.5rem; font-family: inherit; font-size: 0.78rem; }
.cs__iconbtn { background: transparent; border: 1px solid var(--term-border, #2a3138); color: var(--term-fg); border-radius: 7px; width: 2.1rem; height: 2.1rem; font-family: inherit; font-size: 0.95rem; cursor: pointer; flex: none; }
.cs__iconbtn:hover, .cs__iconbtn[aria-pressed="true"] { border-color: var(--accent, #6ef3c5); color: var(--accent, #6ef3c5); }
.cs__phone { width: 390px; max-width: 100%; height: 780px; max-height: 78vh; border: 6px solid #1a2026; border-radius: 28px; overflow: hidden; background: #000; box-shadow: 0 0 0 1px var(--term-border, #2a3138), 0 18px 50px rgba(0, 0, 0, 0.6); }
.cs__phone iframe { width: 100%; height: 100%; border: 0; display: block; background: var(--term-bg, #0b0e11); }
.cs__screen { width: 100%; max-height: 220px; overflow: auto; font-size: 0.62rem; line-height: 1.4; color: var(--term-muted); background: var(--term-bg-raised, #0d0f12); border: 1px dashed var(--term-border, #2a3138); border-radius: 8px; padding: 0.5rem; margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
