<!DOCTYPE html>
<html lang="{{ lang or 'en' }}" class="ext-app">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' 'inline-speculation-rules'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.mentria.ai https://mentria-ai.github.io; media-src 'self' blob: https://cdn.mentria.ai https://mentria-ai.github.io; font-src 'self'; connect-src 'self' blob: data: http://localhost:* http://127.0.0.1:* https://cdn.mentria.ai https://mentria-ai.github.io https://huggingface.co https://*.huggingface.co https://*.hf.co https://relay.mentria.ai wss://relay.mentria.ai; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'">
    {%- if usesThree %}
    <script type="importmap">{"imports":{"three":"/assets/vendor/three-0.186.0/build/three.module.min.js","three/addons/":"/assets/vendor/three-0.186.0/examples/jsm/","/assets/vendor/three-0.186.0/build/three.core.js":"/assets/vendor/three-0.186.0/build/three.core.min.js"}}</script>
