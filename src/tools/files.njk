---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/tools/files/index.html"
eleventyComputed:
  lang: "{{ locale.code }}"
  title: "{{ 'tools.files.title' | t }}"
  description: "{{ 'tools.files.lede' | t }}"
---
<section class="hero" style="padding-top:1rem;">
  <p class="eyebrow eyebrow--crumbs"><a class="eyebrow__link" href="{{ locale.pathPrefix }}/" aria-label="{{ 'nav.home' | t }}">~</a><span class="eyebrow__sep">/</span><a class="eyebrow__link" href="{{ locale.pathPrefix }}/tools/">tools</a><span class="eyebrow__sep">/</span><span class="eyebrow__current">files</span></p>
  <h1>{{ "tools.files.title" | t }}</h1>
  <p>{{ "tools.files.lede" | t }}</p>
  {% include "tldr.njk" %}
</section>

{% set terminalTitle = "files.js" %}
{% include "terminal-frame-open.njk" %}
<section class="files" id="files">

  <div class="files__toolbar">
    <p class="files__summary" id="files-summary"></p>
    <div class="files__toolbar-actions">
      <button type="button" class="m-btn m-btn--ghost" id="files-export-all">{{ "tool.files.export_all" | t }}</button>
      <button type="button" class="m-btn m-btn--ghost" id="files-restore">{{ "about.data_import_button" | t }}…</button>
      <button type="button" class="m-btn m-btn--ghost" id="files-refresh">{{ "tool.files.refresh" | t }}</button>
      <button type="button" class="m-btn m-btn--danger" id="files-erase">{{ "tool.files.erase_button" | t }}</button>
    </div>
  </div>

  <div class="files__body">
    <nav class="files__tree" id="files-tree" aria-label="{{ 'tool.files.tree_label' | t }}"></nav>

    <div class="files__main">
      <div class="files__main-head">
        <h2 class="files__main-title" id="files-main-title">{{ "tool.files.select_prompt" | t }}</h2>
        <span class="files__main-count" id="files-main-count"></span>
        <div class="files__main-actions" id="files-main-actions"></div>
      </div>

      <p class="files__empty" id="files-empty" hidden></p>

      <div class="files__table-wrap" id="files-table-wrap" hidden>
        <table class="files-table">
          <caption class="files-sr">{{ "tool.files.items_caption" | t }}</caption>
          <thead>
            <tr>
              <th scope="col">{{ "tool.files.col_key" | t }}</th>
              <th scope="col">{{ "tool.files.col_size" | t }}</th>
              <th scope="col">{{ "tool.files.col_modified" | t }}</th>
              <th scope="col" class="files-table__actions-h">{{ "tool.files.col_actions" | t }}</th>
            </tr>
          </thead>
          <tbody id="files-rows"></tbody>
        </table>
      </div>
    </div>
  </div>

  <p class="files__status m-status" id="files-status"></p>
</section>

<div class="files-modal m-modal" id="files-view-modal" hidden>
  <div class="files-modal__backdrop" data-close></div>
  <div class="files-modal__card m-modal__card">
    <div class="files-modal__head">
      <h3 class="files-modal__h" id="files-view-title"></h3>
      <button type="button" class="m-btn m-btn--icon" data-close aria-label="{{ 'tool.files.close' | t }}">{% include "icon-x.njk" %}</button>
    </div>
    <p class="files-modal__note" id="files-view-note" hidden></p>
    <pre class="files-modal__pre" id="files-view-pre" tabindex="0" aria-label="{{ 'tool.files.value_label' | t }}"></pre>
  </div>
</div>

<div class="files-modal m-modal" id="files-export-modal" hidden>
  <div class="files-modal__backdrop" data-close></div>
  <div class="files-modal__card m-modal__card">
    <h3 class="files-modal__h">{{ "tool.files.export_modal_title" | t }}</h3>
    <p class="files-modal__p">{{ "tool.files.export_modal_lede" | t }}</p>
    <div class="m-field">
      <label for="files-export-pass">{{ "tool.files.passphrase_label" | t }}</label>
      <input class="m-input" type="password" id="files-export-pass" autocomplete="new-password" minlength="8" spellcheck="false">
    </div>
    <p class="files-modal__strength" id="files-export-strength" aria-live="polite"></p>
    <div class="files-modal__actions">
      <button type="button" class="m-btn m-btn--ghost" data-close>{{ "tool.files.cancel" | t }}</button>
      <button type="button" class="m-btn m-btn--primary" id="files-export-confirm">{{ "tool.files.export_confirm" | t }}</button>
    </div>
  </div>
</div>

<div class="files-modal m-modal" id="files-restore-modal" hidden>
  <div class="files-modal__backdrop" data-close></div>
  <div class="files-modal__card m-modal__card">
    <h3 class="files-modal__h">{{ "about.data_import_title" | t }}</h3>
    <p class="files-modal__p">{{ "about.data_import_lede" | t }}</p>
    <div class="m-field">
      <label for="files-restore-file">{{ "about.data_import_choose" | t }}</label>
      <input class="m-input" type="file" id="files-restore-file" accept="application/json,.json">
    </div>
    <div class="m-field">
      <label for="files-restore-pass">{{ "tool.files.passphrase_label" | t }}</label>
      <input class="m-input" type="password" id="files-restore-pass" autocomplete="current-password" spellcheck="false">
    </div>
    <p class="files-modal__strength" id="files-restore-status" aria-live="polite"></p>
    <div class="files-modal__actions">
      <button type="button" class="m-btn m-btn--ghost" data-close>{{ "tool.files.cancel" | t }}</button>
      <button type="button" class="m-btn m-btn--primary" id="files-restore-confirm">{{ "about.data_import_button" | t }}</button>
    </div>
  </div>
</div>

<div class="files-modal m-modal" id="files-erase-modal" hidden>
  <div class="files-modal__backdrop" data-close></div>
  <div class="files-modal__card m-modal__card">
    <h3 class="files-modal__h">{{ "tool.files.erase_title" | t }}</h3>
    <p class="files-modal__p">{{ "tool.files.erase_lede" | t }}</p>
    <div class="m-field">
      <label for="files-erase-word" id="files-erase-word-label"></label>
      <input class="m-input" type="text" id="files-erase-word" autocomplete="off" spellcheck="false" autocapitalize="off">
    </div>
    <p class="files-modal__strength" id="files-erase-status" aria-live="polite"></p>
    <div class="files-modal__actions">
      <button type="button" class="m-btn m-btn--ghost" data-close>{{ "tool.files.cancel" | t }}</button>
      <button type="button" class="m-btn m-btn--danger" id="files-erase-confirm" disabled>{{ "tool.files.erase_confirm" | t }}</button>
    </div>
  </div>
</div>

{% include "terminal-frame-close.njk" %}
{% include "tool-schema.njk" %}

<script>
(() => {
  'use strict';

  const COPY = {
    nsInvoice: {{ ("tools.invoice.title" | t) | dump | safe }},
    nsQuickNotes: {{ ("tool.files.ns_quick_notes" | t) | dump | safe }},
    nsTotp:       {{ ("tool.files.ns_totp"        | t) | dump | safe }},
    nsTools:      {{ ("tool.files.ns_tools"       | t) | dump | safe }},
    nsGames:      {{ ("tool.files.ns_games"       | t) | dump | safe }},
    nsIdentity:   {{ ("tool.files.ns_identity"    | t) | dump | safe }},
    nsExt:        {{ ("tool.files.ns_ext"         | t) | dump | safe }},
    nsExtdata:    {{ ("tool.files.ns_extdata"     | t) | dump | safe }},
    nsUi:         {{ ("tool.files.ns_ui"          | t) | dump | safe }},
    nsPacks:      {{ ("tool.files.ns_packs"       | t) | dump | safe }},
    nsFeed:       {{ ("tool.files.ns_feed"        | t) | dump | safe }},
    nsHandoff:    {{ ("tool.files.ns_handoff"     | t) | dump | safe }},
    nsComms:      {{ ("nav.comms"                 | t) | dump | safe }},
    nsAiChat:     {{ ("tools.ai-chat.title"       | t) | dump | safe }},
    nsLegacy:     {{ ("tool.files.ns_legacy"      | t) | dump | safe }},
    treeItemLabel:{{ ("tool.files.tree_item_label"| t) | dump | safe }},
    view:         {{ ("tool.files.view"           | t) | dump | safe }},
    exportItem:   {{ ("tool.files.export"         | t) | dump | safe }},
    del:          {{ ("tool.files.delete"         | t) | dump | safe }},
    confirmDelete:{{ ("tool.files.confirm_delete" | t) | dump | safe }},
    confirmDeleteTotp: {{ ("tool.files.confirm_delete_totp" | t) | dump | safe }},
    cachesGroup: {{ ("tool.files.caches_group" | t) | dump | safe }},
    cachesShare: {{ ("tool.files.caches_share" | t) | dump | safe }},
    redaction:    {{ ("tool.files.redaction_notice" | t) | dump | safe }},
    truncated:    {{ ("tool.files.truncated_note" | t) | dump | safe }},
    emptyStore:   {{ ("tool.files.empty_store"    | t) | dump | safe }},
    emptyNs:      {{ ("tool.files.empty_ns"       | t) | dump | safe }},
    selectPrompt: {{ ("tool.files.select_prompt"  | t) | dump | safe }},
    storageSummary: {{ ("tool.files.storage_summary" | t) | dump | safe }},
    storageUnknown: {{ ("tool.files.storage_unknown" | t) | dump | safe }},
    statusDeleted:{{ ("tool.files.status_deleted" | t) | dump | safe }},
    statusExported:{{ ("tool.files.status_exported" | t) | dump | safe }},
    backupDone:   {{ ("tool.files.status_backup_done" | t) | dump | safe }},
    dbGroup: {{ ("tool.files.db_group" | t) | dump | safe }},
    cacheModels: {{ ("tool.files.cache_models" | t) | dump | safe }},
    cacheApp: {{ ("tool.files.cache_app" | t) | dump | safe }},
    cacheDecks: {{ ("tool.files.cache_decks" | t) | dump | safe }},
    cacheArt: {{ ("tool.files.cache_art" | t) | dump | safe }},
    dbRadio: {{ ("tool.files.db_radio" | t) | dump | safe }},
    dbPush: {{ ("tool.files.db_push" | t) | dump | safe }},
    dbPacks: {{ ("tool.files.db_packs" | t) | dump | safe }},
    dbIdentity: {{ ("tool.files.db_identity" | t) | dump | safe }},
    dbExt: {{ ("tool.files.db_ext" | t) | dump | safe }},
    deleteModels: {{ ("tool.files.delete_models" | t) | dump | safe }},
    confirmDeleteModels: {{ ("tool.files.confirm_delete_models" | t) | dump | safe }},
    clearCache: {{ ("tool.files.clear_cache" | t) | dump | safe }},
    confirmClearCache: {{ ("tool.files.confirm_clear_cache" | t) | dump | safe }},
    deleteDb: {{ ("tool.files.delete_db" | t) | dump | safe }},
    confirmDeleteDb: {{ ("tool.files.confirm_delete_db" | t) | dump | safe }},
    confirmDeleteIdentity: {{ ("tool.files.confirm_delete_identity" | t) | dump | safe }},
    confirmDeletePacks: {{ ("tool.files.confirm_delete_packs" | t) | dump | safe }},
    recordsN: {{ ("tool.files.records_n" | t) | dump | safe }},
    dbBlocked: {{ ("tool.files.db_blocked" | t) | dump | safe }},
    modelsShare: {{ ("tool.files.models_share" | t) | dump | safe }},
    eraseType: {{ ("tool.files.erase_type" | t) | dump | safe }},
    eraseWord: {{ ("tool.files.erase_word" | t) | dump | safe }},
    eraseWorking: {{ ("tool.files.erase_working" | t) | dump | safe }},
    eraseDone: {{ ("tool.files.erase_done" | t) | dump | safe }},
    statusCleared: {{ ("tool.files.status_cleared" | t) | dump | safe }},
    restoreBusy:  {{ ("about.data_import_busy" | t) | dump | safe }},
    restoreDone:  {{ ("about.data_import_done" | t) | dump | safe }},
    restoreFail:  {{ ("about.data_import_fail" | t) | dump | safe }},
    passShort:    {{ ("tool.files.status_pass_short" | t) | dump | safe }},
    backupFailed: {{ ("tool.files.status_backup_failed" | t) | dump | safe }},
    strengthHint: {{ ("tool.files.strength_hint"  | t) | dump | safe }},
    strengthWeak: {{ ("tool.files.strength_weak"  | t) | dump | safe }},
    strengthMedium:{{ ("tool.files.strength_medium"| t) | dump | safe }},
    strengthStrong:{{ ("tool.files.strength_strong"| t) | dump | safe }}
  };

  const DASH = '—';
  const VIEW_LIMIT = 50 * 1024;
  const LEGACY_ID = '__legacy__';
  const NS_LABELS = {
    invoice: COPY.nsInvoice,
    quick_notes: COPY.nsQuickNotes,
    totp: COPY.nsTotp,
    tools: COPY.nsTools,
    games: COPY.nsGames,
    identity: COPY.nsIdentity,
    ext: COPY.nsExt,
    ui: COPY.nsUi,
    packs: COPY.nsPacks,
    feed: COPY.nsFeed,
    handoff: COPY.nsHandoff,
    comms: COPY.nsComms,
    ai_chat: COPY.nsAiChat
  };

  const $ = (id) => document.getElementById(id);
  const store = window.MentriaStore;

  const treeEl = $('files-tree');
  const mainTitle = $('files-main-title');
  const mainCount = $('files-main-count');
  const emptyEl = $('files-empty');
  const tableWrap = $('files-table-wrap');
  const rowsEl = $('files-rows');
  const summaryEl = $('files-summary');
  const status = MentriaUI.status($('files-status'));

  const state = { buckets: [], cacheBuckets: [], dbBuckets: [], selected: null, cacheView: null, dbView: null };
  function allBuckets() { return state.buckets.concat(state.cacheBuckets, state.dbBuckets); }
  const mainActions = $('files-main-actions');
  const KNOWN_DBS = ['mentria-radio', 'mentria-push', 'mentria-packs', 'mentria-identity'];
  const isModelCache = (nm) => nm === 'mentria-models' || nm.indexOf('mentria-models-') === 0;

  function cacheLabel(nm) {
    if (nm === 'mentria-models') return COPY.cacheModels;
    if (isModelCache(nm)) return COPY.cacheModels + ' (' + nm.slice('mentria-models-'.length) + ')';
    if (nm.indexOf('mentria-cache-') === 0) return COPY.cacheApp;
    if (nm.indexOf('mentria-decks-') === 0) return COPY.cacheDecks;
    if (nm === 'mentria-deck-art') return COPY.cacheArt;
    return nm;
  }
  function dbLabel(nm) {
    if (nm === 'mentria-radio') return COPY.dbRadio;
    if (nm === 'mentria-push') return COPY.dbPush;
    if (nm === 'mentria-packs') return COPY.dbPacks;
    if (nm === 'mentria-identity') return COPY.dbIdentity;
    if (nm.indexOf('mentria-ext-') === 0) return COPY.dbExt.replace('{id}', nm.slice('mentria-ext-'.length));
    return nm;
  }
  function idbReq(req) {
    return new Promise((resolve, reject) => {
      req.onsuccess = () => resolve(req.result);
      req.onerror = () => reject(req.error);
    });
  }
  function openExistingDb(name) {
    return new Promise((resolve) => {
      let req;
      try { req = indexedDB.open(name); } catch (_) { resolve(null); return; }
      let created = false;
      req.onupgradeneeded = () => { created = true; try { req.transaction.abort(); } catch (_) {} };
      req.onsuccess = () => { if (created) { req.result.close(); resolve(null); } else resolve(req.result); };
      req.onerror = () => resolve(null);
      req.onblocked = () => resolve(null);
    });
  }
  async function listDbNames() {
    if (typeof indexedDB === 'undefined') return [];
    if (indexedDB.databases) {
      try { return (await indexedDB.databases()).map((d) => d.name).filter(Boolean); } catch (_) {}
    }
    const out = [];
    for (const nm of KNOWN_DBS) { const db = await openExistingDb(nm); if (db) { out.push(nm); db.close(); } }
    return out;
  }
  async function dbStores(name) {
    const db = await openExistingDb(name);
    if (!db) return null;
    const stores = [];
    try {
      for (const st of Array.from(db.objectStoreNames)) {
        const count = await idbReq(db.transaction(st, 'readonly').objectStore(st).count());
        stores.push({ name: st, count });
      }
    } catch (_) {}
    db.close();
    return stores;
  }
  function deleteDb(name) {
    return new Promise((resolve) => {
      let req;
      try { req = indexedDB.deleteDatabase(name); } catch (_) { resolve('error'); return; }
      const timer = setTimeout(() => resolve('blocked'), 4000);
      req.onsuccess = () => { clearTimeout(timer); resolve('ok'); };
      req.onerror = () => { clearTimeout(timer); resolve('error'); };
      req.onblocked = () => {};
    });
  }

  function fmtBytes(n) {
    if (n == null || isNaN(n)) return DASH;
    if (n < 1024) return n + ' B';
    if (n < 1024 * 1024) return (n / 1024).toFixed(1) + ' KB';
    if (n < 1024 * 1024 * 1024) return (n / (1024 * 1024)).toFixed(1) + ' MB';
    return (n / (1024 * 1024 * 1024)).toFixed(1) + ' GB';
  }

  function localFootprint() {
    let bytes = 0;
    try {
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (!k) continue;
        if (k.indexOf('mentria.store.') === 0 || k.indexOf('mentria.meta.') === 0 || k.indexOf('mentria_') === 0 || k.indexOf('mentria-') === 0) {
          const v = localStorage.getItem(k) || '';
          bytes += (k.length + v.length) * 2;
        }
      }
    } catch (_) {}
    return bytes;
  }

  function fmtDate(mtime) {
    if (mtime == null || isNaN(mtime)) return DASH;
    const lang = document.documentElement.lang || 'en';
    try {
      return new Intl.DateTimeFormat(lang, { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(mtime));
    } catch (_) {
      try { return new Date(mtime).toLocaleString(); } catch (__) { return DASH; }
    }
  }

  function nsLabel(id) {
    if (id === LEGACY_ID) return COPY.nsLegacy;
    if (id.indexOf('extdata.') === 0) return COPY.nsExtdata.replace('{id}', id.slice('extdata.'.length));
    if (Object.prototype.hasOwnProperty.call(NS_LABELS, id)) return NS_LABELS[id];
    return id;
  }

  function legacyKeys() {
    const out = [];
    try {
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (k && k.indexOf('mentria_') === 0) out.push(k);
      }
    } catch (_) {}
    return out.sort();
  }

  function bucketCount(bucket) {
    if (bucket.kind === 'legacy') return legacyKeys().length;
    return store.list(bucket.id).length;
  }

  function scan() {
    const buckets = [];
    let namespaces = [];
    try { namespaces = store.listNamespaces(); } catch (_) {}
    namespaces.forEach((ns) => {
      buckets.push({ id: ns, kind: 'ns', fileNs: ns });
    });
    if (legacyKeys().length) {
      buckets.push({ id: LEGACY_ID, kind: 'legacy', fileNs: 'legacy' });
    }
    state.buckets = buckets;
    if (state.selected && !buckets.some((b) => b.id === state.selected)) {
      state.selected = null;
    }
  }

  function itemsOf(bucket) {
    if (bucket.kind === 'legacy') {
      return legacyKeys().map((k) => ({ key: k, meta: null }));
    }
    return store.list(bucket.id).sort().map((k) => {
      let meta = null;
      try { meta = store.getMeta(bucket.id, k); } catch (_) {}
      return { key: k, meta: meta };
    });
  }

  function readValue(bucket, key) {
    if (bucket.kind === 'legacy') {
      try { return localStorage.getItem(key); } catch (_) { return null; }
    }
    try { return store.get(bucket.id, key); } catch (_) { return null; }
  }

  function prettyOf(v) {
    if (v == null) return '';
    if (typeof v === 'string') {
      try { return JSON.stringify(JSON.parse(v), null, 2); } catch (_) { return v; }
    }
    try { return JSON.stringify(v, null, 2); } catch (_) { return String(v); }
  }

  function exportContent(bucket, key) {
    const v = readValue(bucket, key);
    if (bucket.kind === 'legacy') {
      try { return JSON.stringify(JSON.parse(v), null, 2); } catch (_) { return JSON.stringify(v); }
    }
    try { return JSON.stringify(v, null, 2); } catch (_) { return JSON.stringify(String(v)); }
  }

  function safeName(s) {
    return String(s).replace(/[\\/]+/g, '_');
  }

  function renderTree() {
    treeEl.textContent = '';
    if (!state.buckets.length) {
      const p = document.createElement('p');
      p.className = 'files__tree-empty';
      p.textContent = COPY.emptyStore;
      treeEl.appendChild(p);
      return;
    }
    state.buckets.forEach((bucket) => {
      const n = bucketCount(bucket);
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'files__ns';
      btn.dataset.id = bucket.id;
      const selected = state.selected === bucket.id;
      if (selected) btn.classList.add('is-active');
      btn.setAttribute('aria-current', selected ? 'true' : 'false');
      const label = nsLabel(bucket.id);
      btn.setAttribute('aria-label', COPY.treeItemLabel.replace('{name}', label).replace('{n}', n));
      const name = document.createElement('span');
      name.className = 'files__ns-name';
      name.textContent = label;
      const count = document.createElement('span');
      count.className = 'files__ns-count';
      count.textContent = n;
      btn.appendChild(name);
      btn.appendChild(count);
      treeEl.appendChild(btn);
    });
    appendGroup(COPY.cachesGroup, state.cacheBuckets, (b) => cacheLabel(b.name));
    appendGroup(COPY.dbGroup, state.dbBuckets, (b) => dbLabel(b.name));
  }

  function appendGroup(title, buckets, labelOf) {
    if (!buckets.length) return;
    const h = document.createElement('p');
    h.className = 'files__tree-group';
    h.textContent = title;
    treeEl.appendChild(h);
    buckets.forEach((bucket) => {
      const label = labelOf(bucket);
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'files__ns';
      btn.dataset.id = bucket.id;
      btn.title = bucket.name;
      const selected = state.selected === bucket.id;
      if (selected) btn.classList.add('is-active');
      btn.setAttribute('aria-current', selected ? 'true' : 'false');
      btn.setAttribute('aria-label', COPY.treeItemLabel.replace('{name}', label).replace('{n}', bucket.count));
      const name = document.createElement('span');
      name.className = 'files__ns-name';
      name.textContent = label;
      const count = document.createElement('span');
      count.className = 'files__ns-count';
      count.textContent = bucket.count;
      btn.appendChild(name);
      btn.appendChild(count);
      treeEl.appendChild(btn);
    });
  }

  function headAction(label, handler) {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'm-btn m-btn--danger files-table__btn';
    btn.textContent = label;
    btn.addEventListener('click', handler);
    mainActions.appendChild(btn);
  }

  function renderMain() {
    const bucket = state.selected ? allBuckets().find((b) => b.id === state.selected) : null;
    mainActions.textContent = '';
    if (!bucket) {
      mainTitle.textContent = COPY.selectPrompt;
      mainCount.textContent = '';
      tableWrap.hidden = true;
      emptyEl.hidden = true;
      rowsEl.textContent = '';
      return;
    }
    if (bucket.kind === 'cache') { renderCacheMain(bucket); return; }
    if (bucket.kind === 'idb') { renderDbMain(bucket); return; }
    const label = nsLabel(bucket.id);
    mainTitle.textContent = label;
    const items = itemsOf(bucket);
    mainCount.textContent = items.length;
    rowsEl.textContent = '';
    if (!items.length) {
      tableWrap.hidden = true;
      emptyEl.hidden = false;
      emptyEl.textContent = COPY.emptyNs;
      return;
    }
    emptyEl.hidden = true;
    tableWrap.hidden = false;
    items.forEach((item) => {
      const tr = document.createElement('tr');

      const keyCell = document.createElement('th');
      keyCell.scope = 'row';
      keyCell.className = 'files-table__key';
      keyCell.textContent = item.key;

      const sizeCell = document.createElement('td');
      sizeCell.className = 'files-table__num';
      sizeCell.textContent = item.meta ? fmtBytes(item.meta.size) : DASH;

      const dateCell = document.createElement('td');
      dateCell.className = 'files-table__date';
      dateCell.textContent = item.meta ? fmtDate(item.meta.mtime) : DASH;

      const actionCell = document.createElement('td');
      actionCell.className = 'files-table__actions';
      actionCell.appendChild(makeAction(COPY.view, 'view', item.key, 'm-btn--ghost'));
      actionCell.appendChild(makeAction(COPY.exportItem, 'export', item.key, 'm-btn--ghost'));
      actionCell.appendChild(makeAction(COPY.del, 'delete', item.key, 'm-btn--danger'));

      tr.appendChild(keyCell);
      tr.appendChild(sizeCell);
      tr.appendChild(dateCell);
      tr.appendChild(actionCell);
      rowsEl.appendChild(tr);
    });
  }

  function makeAction(label, action, key, variant) {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'm-btn ' + variant + ' files-table__btn';
    btn.dataset.action = action;
    btn.dataset.key = key;
    btn.textContent = label;
    return btn;
  }

  async function scanCaches() {
    if (typeof caches === 'undefined') return;
    try {
      const names = await caches.keys();
      const out = [];
      for (const nm of names) {
        const c = await caches.open(nm);
        const reqs = await c.keys();
        if (isModelCache(nm) && !reqs.length) continue;
        out.push({ id: 'cache:' + nm, kind: 'cache', name: nm, count: reqs.length });
      }
      out.sort((a, b) => a.name.localeCompare(b.name));
      state.cacheBuckets = out;
      renderTree();
    } catch (_) {}
  }

  async function scanDbs() {
    try {
      const names = (await listDbNames()).sort();
      const out = [];
      for (const nm of names) {
        const stores = await dbStores(nm);
        if (!stores) continue;
        out.push({ id: 'idb:' + nm, kind: 'idb', name: nm, count: stores.reduce((a, st) => a + st.count, 0), stores });
      }
      state.dbBuckets = out;
      if (state.selected && state.selected.indexOf('idb:') === 0 && !out.some((b) => b.id === state.selected)) state.selected = null;
      renderTree();
    } catch (_) {}
  }

  function renderDbMain(bucket) {
    mainTitle.textContent = dbLabel(bucket.name);
    mainCount.textContent = COPY.recordsN.replace('{n}', bucket.count);
    rowsEl.textContent = '';
    state.dbView = bucket;
    headAction(COPY.deleteDb, () => deleteDbBucket(bucket));
    if (!bucket.stores.length) { tableWrap.hidden = true; emptyEl.hidden = false; emptyEl.textContent = COPY.emptyNs; return; }
    emptyEl.hidden = true;
    tableWrap.hidden = false;
    bucket.stores.forEach((st) => {
      const tr = document.createElement('tr');
      const keyCell = document.createElement('th');
      keyCell.scope = 'row';
      keyCell.className = 'files-table__key';
      keyCell.textContent = st.name;
      const sizeCell = document.createElement('td');
      sizeCell.className = 'files-table__num';
      sizeCell.textContent = COPY.recordsN.replace('{n}', st.count);
      const dateCell = document.createElement('td');
      dateCell.className = 'files-table__date';
      const actionCell = document.createElement('td');
      actionCell.className = 'files-table__actions';
      if (bucket.name !== 'mentria-identity' && st.count) actionCell.appendChild(makeAction(COPY.exportItem, 'dbexport', st.name, 'm-btn--ghost'));
      tr.appendChild(keyCell);
      tr.appendChild(sizeCell);
      tr.appendChild(dateCell);
      tr.appendChild(actionCell);
      rowsEl.appendChild(tr);
    });
  }

  async function exportDbStore(bucket, storeName) {
    const db = await openExistingDb(bucket.name);
    if (!db) return;
    let rows = [];
    try { rows = await idbReq(db.transaction(storeName, 'readonly').objectStore(storeName).getAll()); } catch (_) {}
    db.close();
    let text;
    try { text = JSON.stringify(rows, null, 2); } catch (_) { text = '[]'; }
    MentriaUI.downloadFile(safeName(bucket.name) + '.' + safeName(storeName) + '.json', new Blob([text], { type: 'application/json' }));
    status.set(COPY.statusExported.replace('{name}', storeName), 'ok');
  }

  async function deleteDbBucket(bucket) {
    const label = dbLabel(bucket.name);
    const msg = bucket.name === 'mentria-identity' ? COPY.confirmDeleteIdentity
      : bucket.name === 'mentria-packs' ? COPY.confirmDeletePacks
      : COPY.confirmDeleteDb.replace('{name}', label);
    if (!(await window.mentriaConfirm(msg))) return;
    const res = await deleteDb(bucket.name);
    if (res === 'blocked') { status.set(COPY.dbBlocked, 'err'); return; }
    status.set(COPY.statusDeleted.replace('{name}', label), 'ok');
    state.selected = null;
    refresh();
  }

  async function clearCacheBucket(bucket) {
    if (isModelCache(bucket.name)) {
      if (!(await window.mentriaConfirm(COPY.confirmDeleteModels))) return;
      try { const names = await caches.keys(); await Promise.all(names.filter(isModelCache).map((nm) => caches.delete(nm))); } catch (_) {}
      status.set(COPY.statusDeleted.replace('{name}', COPY.cacheModels), 'ok');
    } else {
      const label = cacheLabel(bucket.name);
      if (!(await window.mentriaConfirm(COPY.confirmClearCache.replace('{name}', label)))) return;
      try { await caches.delete(bucket.name); } catch (_) {}
      status.set(COPY.statusCleared.replace('{name}', label), 'ok');
    }
    state.selected = null;
    refresh();
  }

  async function modelBytes() {
    let total = 0;
    try {
      for (const nm of await caches.keys()) {
        if (!isModelCache(nm)) continue;
        const c = await caches.open(nm);
        const reqs = await c.keys();
        if (reqs.length > 400) continue;
        for (const req of reqs) {
          const res = await c.match(req);
          if (!res) continue;
          const cl = parseInt(res.headers.get('content-length') || '', 10);
          total += Number.isFinite(cl) && cl > 0 ? cl : (await res.blob()).size;
        }
      }
    } catch (_) {}
    return total;
  }

  async function renderCacheMain(bucket) {
    mainTitle.textContent = cacheLabel(bucket.name);
    if (isModelCache(bucket.name)) headAction(COPY.deleteModels, () => clearCacheBucket(bucket));
    else if (bucket.name.indexOf('mentria-cache-') !== 0) headAction(COPY.clearCache, () => clearCacheBucket(bucket));
    mainCount.textContent = bucket.count;
    rowsEl.textContent = '';
    emptyEl.hidden = true;
    tableWrap.hidden = false;
    const token = bucket.id + ':' + Date.now();
    state.cacheView = { token, name: bucket.name, entries: [] };
    const c = await caches.open(bucket.name);
    const reqs = await c.keys();
    if (!state.cacheView || state.cacheView.token !== token) return;
    if (!reqs.length) { tableWrap.hidden = true; emptyEl.hidden = false; emptyEl.textContent = COPY.emptyNs; return; }
    const sizeCells = [];
    reqs.forEach((req, i) => {
      const u = new URL(req.url);
      const tail = decodeURIComponent(u.pathname.split('/').pop() || u.hostname) + (u.search || '');
      state.cacheView.entries.push({ req, tail });
      const tr = document.createElement('tr');
      const keyCell = document.createElement('th');
      keyCell.scope = 'row';
      keyCell.className = 'files-table__key';
      keyCell.textContent = tail.length > 46 ? tail.slice(0, 26) + '…' + tail.slice(-17) : tail;
      keyCell.title = req.url;
      const sizeCell = document.createElement('td');
      sizeCell.className = 'files-table__num';
      sizeCell.textContent = DASH;
      sizeCells.push(sizeCell);
      const dateCell = document.createElement('td');
      dateCell.className = 'files-table__date';
      dateCell.textContent = u.hostname === location.hostname ? '' : u.hostname;
      const actionCell = document.createElement('td');
      actionCell.className = 'files-table__actions';
      actionCell.appendChild(makeAction(COPY.view, 'cview', String(i), 'm-btn--ghost'));
      actionCell.appendChild(makeAction(COPY.del, 'cdelete', String(i), 'm-btn--danger'));
      tr.appendChild(keyCell);
      tr.appendChild(sizeCell);
      tr.appendChild(dateCell);
      tr.appendChild(actionCell);
      rowsEl.appendChild(tr);
    });
    if (reqs.length > 40) return;
    let total = 0;
    for (let i = 0; i < reqs.length; i++) {
      if (!state.cacheView || state.cacheView.token !== token) return;
      let size = null;
      try {
        const res = await c.match(reqs[i]);
        if (res) {
          const cl = parseInt(res.headers.get('content-length') || '', 10);
          size = Number.isFinite(cl) && cl > 0 ? cl : (await res.blob()).size;
        }
      } catch (_) {}
      if (!state.cacheView || state.cacheView.token !== token) return;
      if (size != null) { sizeCells[i].textContent = fmtBytes(size); state.cacheView.entries[i].size = size; total += size; }
    }
    mainCount.textContent = bucket.count + ' · ' + fmtBytes(total);
  }

  async function cacheAction(action, idx) {
    const cv = state.cacheView;
    if (!cv || !cv.entries[idx]) return;
    const en = cv.entries[idx];
    if (action === 'cview') {
      viewTitle.textContent = en.tail.slice(0, 60);
      viewNote.hidden = true;
      viewPre.textContent = JSON.stringify({ url: en.req.url, size: en.size != null ? fmtBytes(en.size) : null, cache: cv.name }, null, 2);
      viewModal.open();
      return;
    }
    if (action === 'cdelete') {
      const ok = await window.mentriaConfirm(COPY.confirmDelete.replace('{name}', en.tail.slice(0, 40)));
      if (!ok) return;
      try {
        const c = await caches.open(cv.name);
        await c.delete(en.req);
      } catch (_) {}
      refresh();
    }
  }

  async function renderSummary() {
    let est = null;
    try { est = await store.estimate(); } catch (_) {}
    const local = localFootprint();
    if (!est || est.usage == null || est.quota == null || !est.quota) {
      summaryEl.textContent = COPY.storageSummary.replace('{used}', fmtBytes(local)).replace(' / {quota}', '').replace('{quota}', '');
      return;
    }
    let text = COPY.storageSummary
      .replace('{used}', fmtBytes(est.usage + local))
      .replace('{quota}', fmtBytes(est.quota));
    let ud = est.usageDetails;
    if (!ud && navigator.storage && navigator.storage.estimate) {
      try { ud = (await navigator.storage.estimate()).usageDetails; } catch (_) {}
    }
    if (ud && ud.caches > 0) text += ' · ' + COPY.cachesShare.replace('{n}', fmtBytes(ud.caches));
    summaryEl.textContent = text;
    const models = await modelBytes();
    if (models > 0 && models >= (est.usage + local) * 0.4) summaryEl.textContent = text + ' · ' + COPY.modelsShare.replace('{n}', fmtBytes(models));
  }

  function refresh() {
    scan();
    renderTree();
    renderMain();
    renderSummary();
    scanCaches();
    scanDbs();
  }

  treeEl.addEventListener('click', (e) => {
    const btn = e.target.closest('.files__ns');
    if (!btn) return;
    state.selected = btn.dataset.id;
    status.clear();
    renderTree();
    renderMain();
  });

  const viewModal = MentriaUI.modal($('files-view-modal'));
  const exportModal = MentriaUI.modal($('files-export-modal'));
  const restoreModal = MentriaUI.modal($('files-restore-modal'));
  const eraseModal = MentriaUI.modal($('files-erase-modal'));
  document.body.appendChild($('files-view-modal'));
  document.body.appendChild($('files-export-modal'));
  document.body.appendChild($('files-restore-modal'));
  document.body.appendChild($('files-erase-modal'));

  const viewTitle = $('files-view-title');
  const viewPre = $('files-view-pre');
  const viewNote = $('files-view-note');

  function openView(bucket, key) {
    viewTitle.textContent = key;
    viewNote.hidden = true;
    viewNote.textContent = '';
    if (bucket.id === 'identity') {
      viewPre.textContent = '';
      viewNote.hidden = false;
      viewNote.textContent = COPY.redaction;
      viewModal.open();
      return;
    }
    let pretty = prettyOf(readValue(bucket, key));
    if (pretty.length > VIEW_LIMIT) {
      const full = fmtBytes(new Blob([pretty]).size);
      pretty = pretty.slice(0, VIEW_LIMIT);
      viewNote.hidden = false;
      viewNote.textContent = COPY.truncated.replace('{size}', full);
    }
    viewPre.textContent = pretty;
    viewModal.open();
  }

  async function deleteItem(bucket, key) {
    const msg = (bucket.id === 'totp')
      ? COPY.confirmDeleteTotp.replace('{name}', key)
      : COPY.confirmDelete.replace('{name}', key);
    const ok = await window.mentriaConfirm(msg);
    if (!ok) return;
    if (bucket.kind === 'legacy') {
      try { localStorage.removeItem(key); } catch (_) {}
    } else {
      store.remove(bucket.id, key);
    }
    status.set(COPY.statusDeleted.replace('{name}', key), 'ok');
    refresh();
  }

  function exportItem(bucket, key) {
    const content = exportContent(bucket, key);
    const filename = safeName(bucket.fileNs) + '.' + safeName(key) + '.json';
    MentriaUI.downloadFile(filename, new Blob([content], { type: 'application/json' }));
    status.set(COPY.statusExported.replace('{name}', key), 'ok');
  }

  rowsEl.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-action]');
    if (!btn) return;
    if (btn.dataset.action === 'cview' || btn.dataset.action === 'cdelete') { cacheAction(btn.dataset.action, Number(btn.dataset.key)); return; }
    if (btn.dataset.action === 'dbexport') { if (state.dbView) exportDbStore(state.dbView, btn.dataset.key); return; }
    const bucket = state.selected ? allBuckets().find((b) => b.id === state.selected) : null;
    if (!bucket) return;
    const key = btn.dataset.key;
    if (btn.dataset.action === 'view') openView(bucket, key);
    else if (btn.dataset.action === 'export') exportItem(bucket, key);
    else if (btn.dataset.action === 'delete') deleteItem(bucket, key);
  });

  const passInput = $('files-export-pass');
  const strengthEl = $('files-export-strength');

  function strengthLabel(label) {
    if (label === 'strong') return COPY.strengthStrong;
    if (label === 'medium') return COPY.strengthMedium;
    return COPY.strengthWeak;
  }

  passInput.addEventListener('input', () => {
    if (!passInput.value) { strengthEl.textContent = ''; strengthEl.dataset.level = ''; return; }
    const s = MentriaBackup.scorePassphrase(passInput.value);
    strengthEl.dataset.level = s.label;
    strengthEl.textContent = COPY.strengthHint.replace('{label}', strengthLabel(s.label));
  });

  $('files-export-all').addEventListener('click', () => {
    passInput.value = '';
    strengthEl.textContent = '';
    strengthEl.dataset.level = '';
    exportModal.open();
    passInput.focus();
  });

  $('files-export-confirm').addEventListener('click', async () => {
    if (!window.MentriaBackup) { status.set(COPY.backupFailed.replace('{msg}', 'MentriaBackup'), 'err'); return; }
    const pass = passInput.value;
    if (!pass || pass.length < 8) { status.set(COPY.passShort, 'err'); return; }
    const btn = $('files-export-confirm');
    btn.disabled = true;
    try {
      const env = await MentriaBackup.encryptBackup(store.exportAll(), pass);
      MentriaBackup.downloadBackupJson(env, 'mentria-files-backup');
      passInput.value = '';
      exportModal.close();
      status.set(COPY.backupDone, 'ok');
    } catch (err) {
      status.set(COPY.backupFailed.replace('{msg}', String(err && err.message || err)), 'err');
    } finally {
      btn.disabled = false;
    }
  });

  $('files-restore').addEventListener('click', () => {
    $('files-restore-file').value = '';
    $('files-restore-pass').value = '';
    $('files-restore-status').textContent = '';
    restoreModal.open();
    $('files-restore-file').focus();
  });

  $('files-restore-confirm').addEventListener('click', async () => {
    const fileEl = $('files-restore-file');
    const passEl = $('files-restore-pass');
    const out = $('files-restore-status');
    const f = fileEl.files && fileEl.files[0];
    if (!f) { fileEl.focus(); return; }
    if (!passEl.value) { passEl.focus(); return; }
    if (!window.MentriaBackup) { out.textContent = COPY.restoreFail.replace('{err}', 'MentriaBackup'); return; }
    if (f.size > 32 * 1024 * 1024) { out.textContent = COPY.restoreFail.replace('{err}', 'file too large'); return; }
    const btn = $('files-restore-confirm');
    btn.disabled = true;
    out.textContent = COPY.restoreBusy;
    try {
      const env = JSON.parse(await f.text());
      const data = await MentriaBackup.decryptBackup(env, passEl.value);
      const result = store.importAll(data, { mode: 'merge' });
      out.textContent = COPY.restoreDone.replace('{n}', result.restored);
      setTimeout(() => { location.reload(); }, 1200);
    } catch (err) {
      out.textContent = COPY.restoreFail.replace('{err}', String(err && err.message || err));
      btn.disabled = false;
    } finally {
      passEl.value = '';
    }
  });

  const eraseWord = $('files-erase-word');
  const eraseBtn = $('files-erase-confirm');
  const eraseOut = $('files-erase-status');
  $('files-erase-word-label').textContent = COPY.eraseType.replace('{word}', COPY.eraseWord);
  eraseWord.addEventListener('input', () => {
    eraseBtn.disabled = eraseWord.value.trim().toLocaleLowerCase() !== COPY.eraseWord.toLocaleLowerCase();
  });
  $('files-erase').addEventListener('click', () => {
    eraseWord.value = '';
    eraseBtn.disabled = true;
    eraseOut.textContent = '';
    eraseModal.open();
    eraseWord.focus();
  });
  eraseBtn.addEventListener('click', async () => {
    if (eraseBtn.disabled) return;
    eraseBtn.disabled = true;
    eraseWord.disabled = true;
    eraseOut.textContent = COPY.eraseWorking;
    const settle = (p, ms) => Promise.race([p.catch(() => {}), new Promise((r) => setTimeout(r, ms))]);
    try {
      const reg = navigator.serviceWorker ? await settle(navigator.serviceWorker.getRegistration(), 2000) : null;
      const sub = reg && reg.pushManager ? await settle(reg.pushManager.getSubscription(), 2000) : null;
      if (sub) await settle(sub.unsubscribe(), 3000);
    } catch (_) {}
    try { localStorage.clear(); } catch (_) {}
    try { sessionStorage.clear(); } catch (_) {}
    try {
      const names = await settle(listDbNames(), 3000);
      for (const nm of names || []) await deleteDb(nm);
    } catch (_) {}
    try { if (typeof caches !== 'undefined') for (const nm of await caches.keys()) await caches.delete(nm); } catch (_) {}
    try {
      if (navigator.storage && navigator.storage.getDirectory) {
        const root = await navigator.storage.getDirectory();
        for await (const name of root.keys()) await root.removeEntry(name, { recursive: true });
      }
    } catch (_) {}
    try {
      if (navigator.serviceWorker) for (const r of await navigator.serviceWorker.getRegistrations()) await r.unregister();
    } catch (_) {}
    try { localStorage.clear(); } catch (_) {}
    location.replace(location.pathname + '?erased=1');
  });

  if (/[?&]erased=1/.test(location.search)) {
    history.replaceState(null, '', location.pathname);
    status.set(COPY.eraseDone, 'ok');
  }

  document.querySelectorAll('.files-modal [data-close]').forEach((el) => {
    el.addEventListener('click', () => { viewModal.close(); exportModal.close(); restoreModal.close(); eraseModal.close(); });
  });

  $('files-refresh').addEventListener('click', () => { refresh(); status.set('', ''); status.clear(); });

  window.addEventListener('mentria:write', () => { refresh(); });

  refresh();
})();
</script>

<style>
.files__main-actions { display: flex; gap: 0.5rem; margin-left: auto; }
.files__main-actions:empty { display: none; }

.files {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  font-family: var(--font-mono);
  padding: var(--space-2) 0 var(--space-4);
}

.files__toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}
.files__summary {
  margin: 0;
  font-size: var(--text-xs);
  color: var(--term-muted);
}
.files__toolbar-actions {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
}

.files__body {
  display: grid;
  grid-template-columns: minmax(180px, 240px) 1fr;
  gap: var(--space-4);
  align-items: start;
}

.files__tree {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  border: 1px solid var(--term-border);
  border-radius: var(--radius-md);
  padding: var(--space-2);
  background: rgba(255, 255, 255, 0.015);
}
.files__tree-group {
  margin: var(--space-2) 0 0;
  padding: 0 var(--space-1);
  font-size: 0.62rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--term-muted);
}
.files__tree-empty {
  margin: 0;
  padding: var(--space-3);
  font-size: var(--text-xs);
  color: var(--term-muted);
  line-height: 1.5;
}
.files__ns {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  width: 100%;
  text-align: left;
  padding: var(--space-2) var(--space-3);
  border: 1px solid transparent;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--term-fg);
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  cursor: pointer;
  transition: background var(--duration-fast) var(--ease-out),
    border-color var(--duration-fast) var(--ease-out),
    color var(--duration-fast) var(--ease-out);
}
.files__ns:hover { background: rgba(255, 255, 255, 0.04); }
.files__ns:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.files__ns.is-active {
  background: var(--cyan-15);
  border-color: var(--term-border);
  color: var(--syn-cyan);
}
.files__ns-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.files__ns-count {
  flex-shrink: 0;
  font-size: var(--text-2xs);
  color: var(--term-muted);
  background: rgba(255, 255, 255, 0.05);
  border-radius: var(--radius-pill);
  padding: 0 var(--space-2);
  min-width: 1.6em;
  text-align: center;
}
.files__ns.is-active .files__ns-count { color: var(--syn-cyan); }

.files__main {
  min-width: 0;
  border: 1px solid var(--term-border);
  border-radius: var(--radius-md);
  padding: var(--space-3);
  background: rgba(255, 255, 255, 0.01);
}
.files__main-head {
  display: flex;
  align-items: baseline;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
}
.files__main-title {
  margin: 0;
  font-size: var(--text-base);
  color: var(--accent);
}
.files__main-count {
  font-size: var(--text-xs);
  color: var(--term-muted);
}
.files__empty {
  margin: 0;
  padding: var(--space-5);
  text-align: center;
  font-size: var(--text-xs);
  color: var(--term-muted);
  line-height: 1.5;
}

.files__table-wrap { overflow-x: auto; }
.files-table {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--text-xs);
}
.files-table th,
.files-table td {
  padding: var(--space-2) var(--space-3);
  text-align: left;
  border-bottom: 1px solid var(--term-border);
