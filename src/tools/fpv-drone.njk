---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/tools/fpv-drone/index.html"
usesThree: true
eleventyComputed:
  lang: "{{ locale.code }}"
  title: "{{ 'tools.fpv-drone.title' | t }}"
  description: "{{ 'tools.fpv-drone.lede' | t }}"
---
<style>
.sk-wrap { margin: 1.25rem 0 2rem; }
.sk-hero__row { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; margin-top: 0.6rem; }
.sk-helpbtn {
  font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.1em;
  color: var(--term-fg); background: rgba(255, 255, 255, 0.05); cursor: pointer;
  border: 1px solid var(--term-border-strong); border-radius: var(--radius-pill);
  padding: 0.45rem 0.95rem; min-height: 40px;
}
.sk-helpbtn:hover, .sk-helpbtn:focus-visible { border-color: var(--accent); color: var(--accent); outline: none; }
.sk-stage {
  position: relative; width: 100%; aspect-ratio: 16 / 9;
  max-height: 80vh; max-height: 80svh;
  overflow: hidden; background: #04060a; outline: none;
  border: 1px solid var(--term-border-strong); border-radius: var(--radius-lg);
  font-family: var(--font-mono); touch-action: none;
  -webkit-user-select: none; user-select: none; -webkit-touch-callout: none;
}
.sk-stage:fullscreen { aspect-ratio: auto; width: 100vw; height: 100vh; height: 100svh; max-height: none; border: 0; border-radius: 0; }
.sk-stage:-webkit-full-screen { aspect-ratio: auto; width: 100vw; height: 100vh; max-height: none; border: 0; border-radius: 0; }
.sk-canvas { display: block; width: 100%; height: 100%; }
.sk-ov {
  position: absolute; inset: 0; z-index: 45;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 0.8rem; padding: 1.5rem; text-align: center;
  background: radial-gradient(ellipse at 50% 40%, rgba(110, 243, 197, 0.08), transparent 60%), #04060a;
  font-family: var(--font-mono); color: var(--term-fg);
}
.sk-ov[hidden] { display: none; }
.sk-ov p { margin: 0; }
.sk-ov__logo { width: min(340px, 62%); height: auto; filter: drop-shadow(0 0 22px rgba(110, 243, 197, 0.25)); }
.sk-ov__status { color: var(--term-muted); font-size: var(--text-xs); letter-spacing: 0.16em; text-transform: uppercase; }
.sk-ov__bar { width: min(260px, 60%); height: 3px; border-radius: 3px; background: rgba(110, 243, 197, 0.14); overflow: hidden; }
.sk-ov__bar i { display: block; width: 40%; height: 100%; background: var(--accent); animation: sk-boot 1.2s ease-in-out infinite; }
@keyframes sk-boot { 0% { transform: translateX(-100%); } 100% { transform: translateX(260%); } }
.sk-ov__title { margin: 0; font-size: clamp(1.2rem, 3.6vw, 1.8rem); letter-spacing: 0.14em; color: var(--syn-amber); text-transform: uppercase; }
.sk-ov__hint { color: var(--term-muted); font-size: var(--text-xs); max-width: 56ch; line-height: 1.7; }
.sk-ov__code { display: block; max-width: 60ch; color: var(--syn-pink); font-size: var(--text-2xs); word-break: break-word; }
.sk-help { max-width: min(420px, calc(100vw - 1.5rem)); }
.sk-help__block { margin: 0 0 0.9rem; }
.sk-help__block[hidden] { display: none; }
.sk-help__head { margin: 0 0 0.45rem; color: var(--term-muted); font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; }
.sk-help__text { margin: 0 0 0.35rem; color: var(--term-fg); font-size: 0.8rem; line-height: 1.5; }
.sk-help__note { margin: 0.4rem 0 0; color: var(--term-muted); font-size: 0.74rem; line-height: 1.55; }
@media (prefers-reduced-motion: reduce) { .sk-ov__bar i { animation: none; width: 100%; } }
@media (max-width: 720px) and (orientation: portrait) {
  .sk-stage { aspect-ratio: auto; height: 70vh; height: 70svh; max-height: none; }
}
@media (pointer: coarse) and (orientation: landscape) and (max-height: 540px) {
  .sk-stage {
    position: fixed; inset: 0; z-index: 9000;
    width: 100vw; height: 100vh; height: 100svh; max-height: none;
    aspect-ratio: auto; border: 0; border-radius: 0;
  }
}
</style>

<section class="hero" style="padding-top:1rem;">
  <p class="eyebrow eyebrow--crumbs"><a class="eyebrow__link" href="{{ locale.pathPrefix }}/" aria-label="{{ 'nav.home' | t }}">~</a><span class="eyebrow__sep">/</span><a class="eyebrow__link" href="{{ locale.pathPrefix }}/tools/">tools</a><span class="eyebrow__sep">/</span><span class="eyebrow__current">fpv-drone</span></p>
  <h1>{{ "tools.fpv-drone.title" | t }}</h1>
  <p>{{ "tools.fpv-drone.lede" | t }}</p>
  {% include "tldr.njk" %}
  <div class="sk-hero__row">
    <button type="button" class="sk-helpbtn" popovertarget="sk-help">{{ "tool.fpv-drone.help.title" | t }}</button>
  </div>
</section>

<div id="sk-help" popover class="game-help sk-help">
  <p class="game-help-title">{{ "tool.fpv-drone.help.title" | t }}</p>
  <div class="sk-help__block" data-input="touch">
    <p class="sk-help__head">{{ "tool.fpv-drone.help.touch" | t }}</p>
    <p class="sk-help__text">{{ "tool.fpv-drone.help.touchLeft" | t }}</p>
    <p class="sk-help__text">{{ "tool.fpv-drone.help.touchRight" | t }}</p>
    <p class="sk-help__text">{{ "tool.fpv-drone.help.touchButtons" | t }}</p>
  </div>
  <div class="sk-help__block" data-input="keyboard pointer">
    <p class="sk-help__head">{{ "tool.fpv-drone.help.keyboard" | t }}</p>
    <ul class="game-help-list">
      <li><span><span class="kbd">W</span><span class="kbd">S</span></span><span class="game-help-label">{{ "tool.fpv-drone.help.throttle" | t }}</span></li>
      <li><span><span class="kbd">A</span><span class="kbd">D</span></span><span class="game-help-label">{{ "tool.fpv-drone.help.yaw" | t }}</span></li>
      <li><span><span class="kbd">↑</span><span class="kbd">↓</span><span class="kbd">←</span><span class="kbd">→</span></span><span class="game-help-label">{{ "tool.fpv-drone.help.tilt" | t }}</span></li>
      <li><span><span class="kbd">C</span></span><span class="game-help-label">{{ "tool.fpv-drone.help.camera" | t }}</span></li>
      <li><span><span class="kbd">M</span></span><span class="game-help-label">{{ "tool.fpv-drone.help.mode" | t }}</span></li>
      <li><span><span class="kbd">R</span></span><span class="game-help-label">{{ "tool.fpv-drone.help.restart" | t }}</span></li>
      <li><span><span class="kbd">Esc</span></span><span class="game-help-label">{{ "tool.fpv-drone.help.pause" | t }}</span></li>
    </ul>
  </div>
  <div class="sk-help__block" data-input="gamepad">
    <p class="sk-help__head">{{ "tool.fpv-drone.help.gamepad" | t }}</p>
    <ul class="game-help-list">
      <li><span><span class="kbd">L</span></span><span class="game-help-label">{{ "tool.fpv-drone.help.padLeft" | t }}</span></li>
      <li><span><span class="kbd">R</span></span><span class="game-help-label">{{ "tool.fpv-drone.help.padRight" | t }}</span></li>
      <li><span><span class="kbd">Y</span></span><span class="game-help-label">{{ "tool.fpv-drone.help.camera" | t }}</span></li>
      <li><span><span class="kbd">RB</span></span><span class="game-help-label">{{ "tool.fpv-drone.help.mode" | t }}</span></li>
      <li><span><span class="kbd">Back</span></span><span class="game-help-label">{{ "tool.fpv-drone.help.restart" | t }}</span></li>
      <li><span><span class="kbd">Start</span></span><span class="game-help-label">{{ "tool.fpv-drone.help.pause" | t }}</span></li>
    </ul>
  </div>
  <p class="sk-help__note">{{ "tool.fpv-drone.help.note" | t }}</p>
</div>

<div class="sk-wrap">
  <div class="sk-stage" id="sk-stage" tabindex="-1">
    <canvas class="sk-canvas" id="sk-canvas"></canvas>
    <div class="sk-ov" id="sk-boot">
      <img class="sk-ov__logo" src="/assets/games/sprites/logo-skyrush.webp" alt="{{ 'tools.fpv-drone.title' | t }}" width="640" height="200">
      <div class="sk-ov__bar" aria-hidden="true"><i></i></div>
      <p class="sk-ov__status">{{ "tool.fpv-drone.boot" | t }}</p>
    </div>
    <div class="sk-ov" id="sk-fail" hidden>
      <p class="sk-ov__title">{{ "tool.fpv-drone.fail.title" | t }}</p>
      <p class="sk-ov__hint">{{ "tool.fpv-drone.fail.body" | t }}</p>
      <code class="sk-ov__code" id="sk-fail-detail"></code>
    </div>
  </div>
</div>

