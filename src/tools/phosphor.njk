.ph-hud__tl { position: absolute; top: calc(env(safe-area-inset-top, 0px) + 12px); left: calc(env(safe-area-inset-left, 0px) + 14px); display: flex; gap: clamp(12px, 2.6cqw, 26px); align-items: flex-start; }
.ph-hud__tr { position: absolute; top: calc(env(safe-area-inset-top, 0px) + 10px); right: calc(env(safe-area-inset-right, 0px) + 12px); display: flex; gap: 8px; align-items: center; pointer-events: auto; }
.ph-hud__bl { position: absolute; bottom: calc(env(safe-area-inset-bottom, 0px) + 12px); left: calc(env(safe-area-inset-left, 0px) + 14px); }
.ph-hud__br { position: absolute; bottom: calc(env(safe-area-inset-bottom, 0px) + 12px); right: calc(env(safe-area-inset-right, 0px) + 14px); text-align: right; }
.ph-stat { display: flex; flex-direction: column; gap: 0.1rem; }
