      var btn = e.target && e.target.closest ? e.target.closest('[data-diag]') : null;
      if (!btn) return;
      diagInput.value = btn.getAttribute('data-diag');
      showError(false);
      renderDiag();
    });
  }

  function renderDiag() {
    var v = parseDecimal(diagInput.value);
    var chips = diagChips.querySelectorAll('[data-diag]');
    for (var i = 0; i < chips.length; i++) {
      chips[i].setAttribute('aria-pressed', parseDecimal(chips[i].getAttribute('data-diag')) === v ? 'true' : 'false');
    }
    var ppm = diagonalPpm(v);
    if (!ppm) { diagResultEl.textContent = ''; return; }
    diagResultEl.textContent = COPY.diagResult
      .replace('{ppi}', String(Math.round(ppm * 25.4 * (window.devicePixelRatio || 1))))
      .replace('{ppm}', num(ppm, 3));
  }

  function renderUnitsBtn() {
    var label = state.units === 'metric' ? COPY.unitsMetric : COPY.unitsImperial;
    unitsBtn.textContent = label;
    unitsBtn.setAttribute('aria-label', COPY.unitsLabel + ': ' + label);
  }

  function cardMaxLong() {
    var w = Math.max(CARD_MIN_PX, (ov.clientWidth || 360) - 24);
    var h = (ov.clientHeight || 640) - 110;
    var byWidth = w * (CARD_LONG_MM / CARD_SHORT_MM);
    return Math.max(CARD_MIN_PX + 40, Math.min(CARD_CAP_PX, Math.min(byWidth, h)));
  }

  function setCardLong(px) {
    cardLong = Math.min(cardMaxLong(), Math.max(CARD_MIN_PX, Math.round(px)));
    renderCard();
  }

  function renderCard() {
    var shortPx = Math.round(cardLong * (CARD_SHORT_MM / CARD_LONG_MM));
    cardEl.style.width = shortPx + 'px';
    cardEl.style.height = Math.round(cardLong) + 'px';
    cardGrip.setAttribute('aria-valuenow', String(Math.round(cardLong)));
    cardGrip.setAttribute('aria-valuemax', String(Math.round(cardMaxLong())));
    var previewPpm = cardLong / CARD_LONG_MM;
    cardSizeEl.textContent = COPY.cardSize
      .replace('{w}', String(shortPx))
      .replace('{h}', String(Math.round(cardLong)))
      .replace('{dpi}', String(Math.round(previewPpm * 25.4 * (window.devicePixelRatio || 1))));
  }

  function renderKnown() {
    gapEl.textContent = COPY.knownGap.replace('{n}', String(Math.round(measuredPx())));
  }

  function showError(show) {
    errEl.hidden = !show;
    errEl.textContent = show ? COPY.errRange : '';
  }

  function renderAll() {
    renderStatus();
    renderUnitsBtn();
    renderLines();
    renderReadout();
    renderCard();
    renderKnown();
    draw();
  }

  function draw() {
    if (!isOpen() || !ovCanvas.width || !ovCanvas.height) return;
    var ctx = ovCanvas.getContext('2d');
    if (!ctx) return;
    var dpr = state.dpr;
    var W = ovCanvas.width;
    var H = ovCanvas.height;

    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, W, H);

    var ppmDev = state.ppm * dpr;
    var thin = Math.max(1, Math.round(dpr * 0.6));
    var midT = Math.max(1, Math.round(dpr * 0.9));
    var bigT = Math.max(2, Math.round(dpr * 1.4));
    var fs = Math.max(10, Math.round(12 * dpr));

    ctx.fillStyle = C.plate;
    ctx.fillRect(0, 0, Math.round(PLATE_W * dpr), H);

    ctx.font = fs + 'px ' + C.mono;
    ctx.textAlign = 'left';
    ctx.textBaseline = 'middle';

    var lenSm = Math.round(10 * dpr);
    var lenMd = Math.round(17 * dpr);
    var lenLg = Math.round(26 * dpr);
    var showMm = ppmDev >= 3;
    var show5 = ppmDev * 5 >= 3;
    var maxMm = Math.floor(H / ppmDev) + 1;

    for (var i = 0; i <= maxMm; i++) {
      var y = Math.round(i * ppmDev);
      if (y > H) break;
      var isCm = i % 10 === 0;
      var isHalf = i % 5 === 0;
      if (!isCm && !isHalf && !showMm) continue;
      if (!isCm && isHalf && !show5) continue;
      ctx.fillStyle = C.metric;
      ctx.globalAlpha = isCm ? 1 : (isHalf ? 0.75 : 0.42);
      ctx.fillRect(0, y, isCm ? lenLg : (isHalf ? lenMd : lenSm), isCm ? bigT : (isHalf ? midT : thin));
      ctx.globalAlpha = 1;
      if (isCm && i > 0) {
        ctx.fillStyle = C.label;
        ctx.fillText(String(i / 10), Math.round(CM_NUM_X * dpr), y + Math.round(dpr));
      }
    }

    var sixteenth = ppmDev * 25.4 / 16;
    var inX = Math.round(IN_TICK_X * dpr);
    var show16 = sixteenth >= 3;
    var show8 = sixteenth * 2 >= 3;
    var show4 = sixteenth * 4 >= 3;
    var maxK = Math.floor(H / sixteenth) + 1;
    var inLen = [Math.round(26 * dpr), Math.round(20 * dpr), Math.round(15 * dpr), Math.round(11 * dpr), Math.round(8 * dpr)];
    var inThick = [bigT, midT, midT, thin, thin];
    var inAlpha = [1, 0.8, 0.68, 0.52, 0.38];

    for (var k = 0; k <= maxK; k++) {
      var ky = Math.round(k * sixteenth);
      if (ky > H) break;
      var lvl;
      if (k % 16 === 0) lvl = 0;
      else if (k % 8 === 0) lvl = 1;
      else if (k % 4 === 0) lvl = 2;
      else if (k % 2 === 0) lvl = 3;
      else lvl = 4;
      if (lvl === 4 && !show16) continue;
      if (lvl === 3 && !show8) continue;
      if (lvl === 2 && !show4) continue;
      ctx.fillStyle = C.imperial;
      ctx.globalAlpha = inAlpha[lvl];
      ctx.fillRect(inX, ky, inLen[lvl], inThick[lvl]);
      ctx.globalAlpha = 1;
      if (lvl === 0 && k > 0) {
        ctx.fillStyle = C.label;
        ctx.fillText(String(k / 16), Math.round(IN_NUM_X * dpr), ky + Math.round(dpr));
      }
    }

    ctx.textBaseline = 'bottom';
    ctx.fillStyle = C.muted;
    ctx.fillText(COPY.unitCm, Math.round(4 * dpr), H - Math.round(10 * dpr));
    ctx.fillText(COPY.unitIn, inX, H - Math.round(10 * dpr));

    var zeroT = Math.max(2, Math.round(3 * dpr));
    ctx.fillStyle = C.label;
    ctx.fillRect(0, 0, W, zeroT);
    ctx.textBaseline = 'top';
    ctx.font = (fs + Math.round(2 * dpr)) + 'px ' + C.mono;
    ctx.fillText('0', Math.round(4 * dpr), zeroT + Math.round(4 * dpr));
  }

  var dragging = false;
  var dragPointer = null;
  var dragWhich = 'a';
  var grabDy = 0;

  function nearestLine(y) {
    if (!state.abMode) return 'a';
    return Math.abs(y - lines.a) <= Math.abs(y - lines.b) ? 'a' : 'b';
  }

  function surfaceY(clientY) {
    return clientY - surface.getBoundingClientRect().top;
  }

  surface.addEventListener('pointerdown', function (e) {
    var y = surfaceY(e.clientY);
    var grabbed = e.target && e.target.closest ? e.target.closest('.rl-ov__line') : null;
    if (grabbed === lineB && state.abMode) dragWhich = 'b';
    else if (grabbed === lineA) dragWhich = 'a';
    else { dragWhich = nearestLine(y); grabbed = null; }
    grabDy = grabbed ? y - lines[dragWhich] : 0;
    dragging = true;
    dragPointer = e.pointerId;
    ov.classList.add('is-dragging');
    try { surface.setPointerCapture(e.pointerId); } catch (err) {}
    setLine(dragWhich, y - grabDy);
  });
  surface.addEventListener('pointermove', function (e) {
    if (!dragging || e.pointerId !== dragPointer) return;
    setLine(dragWhich, surfaceY(e.clientY) - grabDy);
  });
  function endDrag(e) {
    if (!dragging || (e && e.pointerId !== dragPointer)) return;
    dragging = false;
    dragPointer = null;
    ov.classList.remove('is-dragging');
  }
  surface.addEventListener('pointerup', endDrag);
  surface.addEventListener('pointercancel', endDrag);

  function bindLineKeys(el, which) {
    el.addEventListener('keydown', function (e) {
      var step = e.shiftKey ? 10 : 1;
      if (e.key === 'ArrowUp') { setLine(which, lines[which] - step); e.preventDefault(); }
      else if (e.key === 'ArrowDown') { setLine(which, lines[which] + step); e.preventDefault(); }
      else if (e.key === 'Home') { setLine(which, 0); e.preventDefault(); }
      else if (e.key === 'End') { setLine(which, viewH); e.preventDefault(); }
    });
  }
  bindLineKeys(lineA, 'a');
  bindLineKeys(lineB, 'b');

  var gripActive = false;
  var gripPid = null;
  var gripStartY = 0;
  var gripStartLong = 0;
  cardGrip.addEventListener('pointerdown', function (e) {
    gripActive = true;
    gripPid = e.pointerId;
    gripStartY = e.clientY;
    gripStartLong = cardLong;
    cardGrip.classList.add('is-dragging');
    try { cardGrip.setPointerCapture(e.pointerId); } catch (err) {}
  });
  cardGrip.addEventListener('pointermove', function (e) {
    if (!gripActive || e.pointerId !== gripPid) return;
    setCardLong(gripStartLong + (e.clientY - gripStartY));
    showError(false);
  });
  function gripDone(e) {
    if (!gripActive || (e && e.pointerId !== gripPid)) return;
    gripActive = false;
    gripPid = null;
    cardGrip.classList.remove('is-dragging');
  }
  cardGrip.addEventListener('pointerup', gripDone);
  cardGrip.addEventListener('pointercancel', gripDone);
  cardGrip.addEventListener('keydown', function (e) {
    var step = e.shiftKey ? 10 : 1;
    if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { setCardLong(cardLong - step); e.preventDefault(); }
    else if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { setCardLong(cardLong + step); e.preventDefault(); }
  });

  var stepBtns = calPanel.querySelectorAll('.rl-ov__step');
  for (var s = 0; s < stepBtns.length; s++) {
    (function (btn) {
      var delta = parseInt(btn.getAttribute('data-step'), 10) || 0;
      var tpl = delta < 0 ? COPY.cardNarrower : COPY.cardWider;
      btn.setAttribute('aria-label', tpl.replace('{n}', String(Math.abs(delta))));
      btn.addEventListener('click', function () {
        setCardLong(cardLong + delta);
        showError(false);
      });
    })(stepBtns[s]);
  }

  function setCalMode(mode) {
    if (mode === 'known') calMode = 'known';
    else if (mode === 'diagonal') calMode = 'diagonal';
    else calMode = 'card';
    paneCard.hidden = calMode !== 'card';
    paneKnown.hidden = calMode !== 'known';
    paneDiag.hidden = calMode !== 'diagonal';
    calPanel.classList.toggle('is-full', calMode === 'card');
    showError(false);
    if (calMode === 'known') renderKnown();
    else if (calMode === 'diagonal') renderDiag();
    else renderCard();
  }

  var modesCtl = window.MentriaUI && window.MentriaUI.segmented
    ? window.MentriaUI.segmented(modesSeg, setCalMode)
    : null;

  function openCal(open) {
    calPanel.hidden = !open;
    if (!open) return;
    calPanel.classList.toggle('is-full', calMode === 'card');
    buildDiagChips();
    setCardLong(state.ppm * CARD_LONG_MM);
    knownInput.value = '';
    diagInput.value = stored && stored.source === 'diagonal' && stored.value ? String(stored.value) : '';
    showError(false);
    renderKnown();
    renderDiag();
  }

  function startCardCalibration() {
    setCalMode('card');
    if (modesCtl) modesCtl.set('card');
    openCal(true);
  }

  function openOverlay(withCalibration) {
    ov.hidden = false;
    document.documentElement.classList.add('rl-ov-on');
    resolve();
    layoutOverlay();
    renderAll();
    if (withCalibration) startCardCalibration();
    else openCal(false);
    closeBtn.focus();
  }

  function closeOverlay() {
    openCal(false);
    ov.hidden = true;
    document.documentElement.classList.remove('rl-ov-on');
    renderStatus();
    openBtn.focus();
  }

  openBtn.addEventListener('click', function () { openOverlay(false); });
  pageCalBtn.addEventListener('click', function () { openOverlay(true); });
  closeBtn.addEventListener('click', closeOverlay);
  ovCalBtn.addEventListener('click', startCardCalibration);
  warnBtn.addEventListener('click', startCardCalibration);
  cancelBtn.addEventListener('click', function () { openCal(false); });

  unitsBtn.addEventListener('click', function () {
    state.units = state.units === 'metric' ? 'imperial' : 'metric';
    storeSet('ruler_units', { order: state.units });
    renderUnitsBtn();
    renderReadout();
  });

  abBtn.addEventListener('click', function () {
    state.abMode = !state.abMode;
    abBtn.setAttribute('aria-pressed', state.abMode ? 'true' : 'false');
    if (state.abMode && Math.abs(lines.b - lines.a) < 8) {
      lines.b = Math.min(viewH, lines.a + Math.round(viewH * 0.25));
    }
    renderLines();
    renderReadout();
    if (calMode === 'known') renderKnown();
  });

  resetBtn.addEventListener('click', function () {
    resetLines();
    renderLines();
    renderReadout();
    renderKnown();
  });

  applyBtn.addEventListener('click', function () {
    var ppm;
    var value = null;
    if (calMode === 'known') {
      var mm = parseDecimal(knownInput.value);
      var gap = measuredPx();
      if (!isFinite(mm) || mm <= 0 || gap < 8) { showError(true); return; }
      ppm = gap / mm;
      value = mm;
    } else if (calMode === 'diagonal') {
      var inches = parseDecimal(diagInput.value);
      ppm = diagonalPpm(inches);
      if (!ppm) { showError(true); return; }
      value = inches;
    } else {
      ppm = cardLong / CARD_LONG_MM;
    }
    if (!commitCalibration(ppm, calMode, value)) { showError(true); return; }
    showError(false);
    openCal(false);
    layoutOverlay();
    renderAll();
    toast(COPY.applied);
  });

  clearBtn.addEventListener('click', function () {
    var ask = window.mentriaConfirm ? window.mentriaConfirm(COPY.confirmClear) : Promise.resolve(true);
    Promise.resolve(ask).then(function (ok) {
      if (!ok) return;
      clearCalibration();
      renderStatus();
      if (isOpen()) { layoutOverlay(); renderAll(); }
      toast(COPY.cleared);
    });
  });

  knownInput.addEventListener('input', function () { showError(false); });
  diagInput.addEventListener('input', function () { showError(false); renderDiag(); });

  document.addEventListener('keydown', function (e) {
    if (!isOpen() || e.key !== 'Escape') return;
    if (!calPanel.hidden) { openCal(false); return; }
    closeOverlay();
  });

  var pending = 0;
  function schedule() {
    if (pending) return;
    pending = requestAnimationFrame(function () {
      pending = 0;
      resolve();
      renderStatus();
      if (!isOpen()) return;
      layoutOverlay();
      renderAll();
    });
  }
  window.addEventListener('resize', schedule);
  window.addEventListener('orientationchange', schedule);
  if (window.visualViewport) window.visualViewport.addEventListener('resize', schedule);
  if (window.ResizeObserver) {
    try { new ResizeObserver(schedule).observe(ov); } catch (e) {}
  }

  var dprQuery = null;
  function onDprChange() {
    watchDpr();
    schedule();
  }
  function watchDpr() {
    if (!window.matchMedia) return;
    if (dprQuery && dprQuery.removeEventListener) dprQuery.removeEventListener('change', onDprChange);
    try {
      dprQuery = window.matchMedia('(resolution: ' + (window.devicePixelRatio || 1) + 'dppx)');
      if (dprQuery.addEventListener) dprQuery.addEventListener('change', onDprChange);
    } catch (e) { dprQuery = null; }
  }

  loadState();
  if (modesCtl) modesCtl.set('card');
  renderStatus();
  renderUnitsBtn();
  watchDpr();
  detectAndroid();
})();
</script>
