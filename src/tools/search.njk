---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/tools/search/index.html"
eleventyComputed:
  lang: "{{ locale.code }}"
  title: "{{ 'tools.search.title' | t }}"
  description: "{{ 'tools.search.lede' | t }}"
localeReload: true
---
<section class="hero" style="padding-top:1rem;">
  <p class="eyebrow eyebrow--crumbs"><a class="eyebrow__link" href="{{ locale.pathPrefix }}/" aria-label="{{ 'nav.home' | t }}">~</a><span class="eyebrow__sep">/</span><a class="eyebrow__link" href="{{ locale.pathPrefix }}/tools/">tools</a><span class="eyebrow__sep">/</span><span class="eyebrow__current">search</span></p>
  <h1>{{ "tools.search.title" | t }}</h1>
  <p>{{ "tools.search.lede" | t }}</p>
  {% include "tldr.njk" %}
</section>

{% set terminalTitle = "search.js" %}
{% include "terminal-frame-open.njk" %}
<section class="sx">
  <div class="sx__bar">
    <svg class="sx__bar-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input type="search" id="sx-input" class="sx__input" enterkeyhint="search" aria-label="{{ 'tools.search.title' | t }}" placeholder="{{ 'tool.search.ph_input' | t }}" autocomplete="off" autocapitalize="off" spellcheck="false">
  </div>

  <div class="sx__filters" id="sx-filters">
    <button class="sx__chip is-active" type="button" data-type="all" aria-pressed="true">{{ "tool.search.type_all" | t }}</button>
    <button class="sx__chip" type="button" data-type="tool" aria-pressed="false">{{ "tool.search.type_tool" | t }}</button>
    <button class="sx__chip" type="button" data-type="post" aria-pressed="false">{{ "tool.search.type_post" | t }}</button>
    <button class="sx__chip" type="button" data-type="chapter" aria-pressed="false">{{ "tool.search.type_chapter" | t }}</button>
  </div>

  <div class="sx__ai" id="sx-ai" hidden>
    <div class="sx__ai-head">
      <span class="sx__ai-label">{{ "tool.search.ai_summary_label" | t }}</span>
      <button class="sx__ai-btn" id="sx-ai-btn">{{ "tool.search.ai_run_btn" | t }}</button>
    </div>
    <div class="sx__activity" id="sx-activity"></div>
    <div class="sx__ai-body" id="sx-ai-body"></div>
  </div>

  <p class="sx__count" id="sx-count" aria-live="polite"></p>
  <p class="sx__count" id="sx-offline" hidden>{{ "tool.search.offline_partial" | t }}</p>
  <ol class="sx__results" id="sx-results"></ol>
  <button class="sx__more" type="button" id="sx-more" hidden>{{ "tool.search.show_more" | t }}</button>
  <p class="sx__hint" id="sx-hint">{{ "tool.search.empty_hint" | t }}</p>
</section>
{% include "terminal-frame-close.njk" %}
{% include "tool-schema.njk" %}

<script>
(() => {
  const COPY = {
    placeholder:    {{ ("tool.search.ph_input"          | t) | dump | safe }},
    countOne:       {{ ("tool.search.result_count_one"  | t) | dump | safe }},
    countMany:      {{ ("tool.search.result_count_many" | t) | dump | safe }},
    noResults:      {{ ("tool.search.no_results"        | t) | dump | safe }},
    noResultsType:  {{ ("tool.search.no_results_filter" | t) | dump | safe }},
    emptyHint:      {{ ("tool.search.empty_hint"        | t) | dump | safe }},
    aiThinking:     {{ ("tool.search.ai_thinking"       | t) | dump | safe }},
    aiUnavailable:  {{ ("tool.search.ai_unavailable"    | t) | dump | safe }}
  };
  const TYPE_LABEL = {
    tool:      {{ ("tool.search.label_tool"    | t) | dump | safe }},
    extension: {{ ("store.kind"                | t) | dump | safe }},
    post:      {{ ("tool.search.label_post"    | t) | dump | safe }},
    chapter:   {{ ("tool.search.label_chapter" | t) | dump | safe }}
  };
  const TYPE_FILTER = { extension: 'tool' };
  const PAGE_SIZE = 30;
  const LANG = {{ (lang | default("en")) | dump | safe }};
  const LOCALE_PREFIX = {{ (locale.pathPrefix | default("")) | dump | safe }};
  const MENTRIA_DIST_BASE  = '/assets/mentria/dist/';
  const MARKDOWN_SRC = '/assets/js/markdown.js?v={{ buildHash }}';

  const $input   = document.getElementById('sx-input');
  const $count   = document.getElementById('sx-count');
  const $results = document.getElementById('sx-results');
  const $more    = document.getElementById('sx-more');
  const $hint    = document.getElementById('sx-hint');
  const $offline = document.getElementById('sx-offline');
  const $ai      = document.getElementById('sx-ai');
  const $aiBtn   = document.getElementById('sx-ai-btn');
  const $aiBody  = document.getElementById('sx-ai-body');
  const $aiAct   = document.getElementById('sx-activity');
  let aiStrip = null;
  const $filters = document.getElementById('sx-filters');

  let INDEX = [];
  let activeType = 'all';
  let lastResults = [];
  let lastQNorm = '';
  let shown = 0;
  let aiEngine = null;
  let modelCacheChecked = false;
  let aiEpoch = 0;
  let aiAbort = null;
  let aiLoad = null;
  let aiKey = '';
  let mdLoad = null;

  function normalize(s) {
    return (s || '').toString().toLowerCase()
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  }

  function foldWithMap(text) {
    const raw = String(text ?? '');
    let folded = '';
    const map = [];
    for (let i = 0; i < raw.length; i++) {
      const f = normalize(raw[i]);
      for (let j = 0; j < f.length; j++) {
        folded += f[j];
        map.push(i);
      }
    }
    return { raw, folded, map };
  }

  function matchRanges(text, qNorm) {
    const { raw, folded, map } = foldWithMap(text);
    const ranges = [];
    let from = 0;
    while (true) {
      const idx = folded.indexOf(qNorm, from);
      if (idx < 0) break;
      const end = idx + qNorm.length;
      ranges.push([map[idx], end < folded.length ? map[end] : raw.length]);
      from = end;
    }
    return ranges;
  }

  let wordSegmenter = null;
  try {
    if (typeof Intl !== 'undefined' && Intl.Segmenter) {
      wordSegmenter = new Intl.Segmenter(LANG, { granularity: 'word' });
    }
  } catch (_) { wordSegmenter = null; }

  function tokenize(s) {
    const n = normalize(s);
    if (wordSegmenter) {
      return Array.from(wordSegmenter.segment(n)).filter(x => x.isWordLike).map(x => x.segment);
    }
    return n.split(/[^\p{L}\p{N}]+/u).filter(Boolean);
  }

  function scoreEntry(entry, qTokens, qNorm) {
    const haystackTitle = normalize(entry.title);
    const haystackDesc  = normalize(entry.description);
    const haystackTldr  = normalize(entry.tldr);
    const haystackTags  = normalize(entry.tags);
    const haystackAll   = haystackTitle + ' ' + haystackDesc + ' ' + haystackTldr + ' ' + normalize(entry.slug) + ' ' + normalize(entry.category) + ' ' + haystackTags;

    let score = 0;
    if (haystackTitle.startsWith(qNorm)) score += 200;
    if (haystackTitle.includes(qNorm)) score += 100;
    if (haystackAll.includes(qNorm)) score += 25;

    for (const t of qTokens) {
      if (haystackTitle.includes(t)) score += 30;
      if (haystackDesc.includes(t))  score += 12;
      if (haystackTldr.includes(t))  score += 6;
      if (haystackTags.includes(t))  score += 30;
      if (normalize(entry.slug).includes(t)) score += 20;
      if (normalize(entry.category).includes(t)) score += 4;
    }
    return score;
  }

  function snippet(text, qNorm) {
    if (!text) return '';
    const ranges = qNorm.length >= 2 ? matchRanges(text, qNorm) : [];
    if (!ranges.length) return text.slice(0, 140) + (text.length > 140 ? '…' : '');
    const start = Math.max(0, ranges[0][0] - 40);
    const end   = Math.min(text.length, ranges[0][1] + 80);
    return (start > 0 ? '…' : '') + text.slice(start, end) + (end < text.length ? '…' : '');
  }

  function escape(s) {
    return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function highlight(text, qNorm) {
    const raw = String(text ?? '');
    if (!qNorm || qNorm.length < 2) return escape(raw);
    const ranges = matchRanges(raw, qNorm);
    if (!ranges.length) return escape(raw);
    let out = '';
    let pos = 0;
    for (const [a, b] of ranges) {
      out += escape(raw.slice(pos, a)) + '<mark>' + escape(raw.slice(a, b)) + '</mark>';
      pos = b;
    }
    return out + escape(raw.slice(pos));
  }

  function editDistanceAtMost(a, b, limit) {
    if (Math.abs(a.length - b.length) > limit) return false;
    let prev = [];
    for (let j = 0; j <= b.length; j++) prev.push(j);
    for (let i = 1; i <= a.length; i++) {
      const cur = [i];
      let rowMin = i;
      for (let j = 1; j <= b.length; j++) {
        const cost = a[i - 1] === b[j - 1] ? 0 : 1;
        const v = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost);
        cur.push(v);
        if (v < rowMin) rowMin = v;
      }
      if (rowMin > limit) return false;
      prev = cur;
    }
    return prev[b.length] <= limit;
  }

  function fuzzyScoreEntry(entry, qTokens) {
    let score = 0;
    const fields = [
      [tokenize(entry.title), 30],
      [tokenize(entry.slug), 20],
      [tokenize(entry.description), 10]
    ];
    for (const qt of qTokens) {
      if (qt.length < 4) continue;
      const limit = qt.length >= 8 ? 2 : 1;
      for (const [tokens, weight] of fields) {
        if (tokens.some(t => editDistanceAtMost(qt, t, limit))) { score += weight; break; }
      }
    }
    return score;
  }

  function search(query) {
    const qNorm = normalize(query.trim());
    if (!qNorm) return [];
    const qTokens = tokenize(query);

    const pool = [];
    const scored = [];
    for (const entry of INDEX) {
      if (entry.lang !== LANG) continue;
      if (entry.requires === 'motion' && window.MentriaCaps && window.MentriaCaps.motion === false) continue;
      pool.push(entry);
      const score = scoreEntry(entry, qTokens, qNorm);
      if (score > 0) scored.push({ entry, score });
    }
    if (!scored.length && qTokens.some(t => t.length >= 4)) {
      for (const entry of pool) {
        const score = fuzzyScoreEntry(entry, qTokens);
        if (score > 0) scored.push({ entry, score });
      }
    }
    scored.sort((a, b) => b.score - a.score);
    return scored.map(s => s.entry);
  }

  function typeOf(entry) {
    return TYPE_FILTER[entry.type] || entry.type;
  }

  function pluralize(n) {
    return (n === 1 ? COPY.countOne : COPY.countMany).replace('{n}', n);
  }

  function resultItem(r, qNorm) {
    const li = document.createElement('li');
    li.className = 'sx__result';
    li.innerHTML =
      '<a class="sx__result-link" href="' + escape(r.url) + '">' +
        '<span class="sx__result-type">' + escape(TYPE_LABEL[r.type] || r.type) + '</span>' +
        '<h2 class="sx__result-title">' + highlight(r.title, qNorm) + '</h2>' +
        (r.description ? '<p class="sx__result-desc">' + highlight(snippet(r.description, qNorm), qNorm) + '</p>' : '') +
      '</a>';
    return li;
  }

  function renderMore() {
    const from = $results.children.length;
    const end = Math.min(lastResults.length, shown);
    for (let i = from; i < end; i++) $results.appendChild(resultItem(lastResults[i], lastQNorm));
    $more.hidden = end >= lastResults.length;
  }

  function render(results, qNorm, total) {
    lastResults = results;
    lastQNorm = qNorm;
    shown = PAGE_SIZE;
    $results.innerHTML = '';
    $more.hidden = true;
    if (results.length === 0) {
      $count.textContent = qNorm ? (total ? COPY.noResultsType : COPY.noResults) : '';
      $hint.style.display = qNorm ? 'none' : '';
      $ai.hidden = true;
      return;
    }
    $count.textContent = pluralize(results.length);
    $hint.style.display = 'none';
    renderMore();
    if (modelCacheChecked && aiEngine) $ai.hidden = false;
  }

  // ── Cache detection ─────────────────────────────────────────────
  // Try to reach the engine bundle and probe whether a previous visit
  // has cached the model weights. Done once per page load.
  async function detectCachedModel() {
    if (modelCacheChecked) return;
    modelCacheChecked = true;
    if (!('caches' in window) || !navigator.gpu) return;
    try {
      const Tiers = await import('/assets/js/mentria-tiers.js');
      const tier = await Tiers.effectiveTier({ cachedOnly: true });
      if (!tier) return;
      aiEngine = { cached: true };
      if (lastResults.length) $ai.hidden = false;
    } catch (_) { /* ignore */ }
  }

  // ── AI summary ──────────────────────────────────────────────────
  function stopAI() {
    aiEpoch++;
    if (aiAbort) { aiAbort.abort(); aiAbort = null; }
    if (aiStrip) aiStrip.hide();
    $aiBody.textContent = '';
    $aiBtn.disabled = false;
  }

  function loadMarkdown() {
    if (!mdLoad) {
      mdLoad = new Promise((resolve) => {
        if (typeof window.renderMarkdown === 'function') { resolve(); return; }
        const s = document.createElement('script');
        s.src = MARKDOWN_SRC;
        s.onload = () => resolve();
        s.onerror = () => resolve();
        document.head.appendChild(s);
      }).then(() => window.renderMarkdownReady).catch(() => {});
    }
    return mdLoad;
  }

  function showSummary(text) {
    const clean = text.replace(/<think>[\s\S]*?<\/think>/g, '').trim();
    if (typeof window.renderMarkdown !== 'function') { $aiBody.textContent = clean; return; }
    const tpl = document.createElement('template');
    tpl.innerHTML = window.renderMarkdown(clean);
    tpl.content.querySelectorAll('img').forEach((n) => n.remove());
    $aiBody.replaceChildren(tpl.content);
  }

  function loadEngine() {
    if (aiEngine && !aiEngine.cached) return Promise.resolve(aiEngine);
    if (!aiLoad) {
      aiLoad = (async () => {
        const { MentriaEngine } = await import(MENTRIA_DIST_BASE + 'mentria.mjs');
        const { ensureModel } = await import('/assets/js/mentria-model.js');
        const createEngine = () => {
          const e = new MentriaEngine(MENTRIA_DIST_BASE + 'worker.mjs');
          window.mentriaWrapEngine && window.mentriaWrapEngine(e);
          return e;
        };
        const res = await ensureModel(createEngine, { vision: false, cachedOnly: true, onProgress: (p) => { if (aiStrip && aiAbort) aiStrip.onProgress(p); }, onTier: (i) => { if (aiStrip) aiStrip.setTier(i); } });
        aiEngine = res.engine;
        return aiEngine;
      })();
      aiLoad.then(() => { aiLoad = null; }, () => { aiLoad = null; });
    }
    return aiLoad;
  }

  // LoRA-ready hook: when a "search-rerank" adapter ships under
  // /loras/search/ on the model bucket, wire it via engine.swapAdapter()
  // before the generate() call below.
  async function runAISummary() {
    if (!lastResults.length) return;
    stopAI();
    const epoch = aiEpoch;
    const ctl = new AbortController();
    aiAbort = ctl;
    $aiBtn.disabled = true;
    $aiBody.textContent = COPY.aiThinking;
    const mdReady = loadMarkdown();
    if (!aiStrip) { try { const A = await import('/assets/js/mentria-activity.js'); aiStrip = A.createActivityStrip($aiAct, { panel: false }); } catch (_) {} }

    try {
      if (epoch !== aiEpoch) return;
      const engine = await loadEngine();
      if (epoch !== aiEpoch) return;
      await Promise.race([mdReady, new Promise((r) => setTimeout(r, 4000))]);
      if (epoch !== aiEpoch) return;

      const top = lastResults.slice(0, 5).map((r, i) =>
        (i + 1) + '. ' + r.title + ' — ' + (r.description || '')).join('\n');
      const messages = [
        { role: 'system', content:
          'You are a concise search assistant for a personal site. ' +
          'Given a user query and the top 5 ranked results, write ONE sentence ' +
          '(max 25 words) that helps the user pick a result. No preamble. ' +
          'Reference results by number when useful.' },
        { role: 'user', content: 'Query: ' + $input.value.trim() + '\n\nTop results:\n' + top }
      ];

      let buffer = '', nTok = 0, painting = false;
      const paint = () => {
        painting = false;
        if (epoch === aiEpoch) showSummary(buffer);
      };
      $aiBody.textContent = '';
      await engine.generate({
        messages, maxTokens: 96,
        temperature: 0.2, topP: 0.9, topK: 30,
        repetitionPenalty: 1.1, enableThinking: false,
        signal: ctl.signal
      }, (event) => {
        if (epoch !== aiEpoch) return;
        if (typeof event.token === 'string' && event.token.length > 0) {
          if (/^<\|[^|]*\|>$/.test(event.token)) return;
          buffer += event.token;
          if (aiStrip) aiStrip.token(++nTok);
          if (!painting) { painting = true; requestAnimationFrame(paint); }
        }
      });
      if (epoch === aiEpoch) showSummary(buffer);
      if (aiStrip && epoch === aiEpoch) aiStrip.done({ tokens: nTok });
    } catch (err) {
      if (epoch !== aiEpoch) return;
      console.warn('AI summary failed:', err);
      if (aiStrip) aiStrip.hide();
      $aiBody.textContent = COPY.aiUnavailable;
    } finally {
      if (epoch === aiEpoch) {
        aiAbort = null;
        $aiBtn.disabled = false;
      }
    }
  }

  function setType(type) {
    const chips = Array.from($filters.querySelectorAll('[data-type]'));
    activeType = chips.some(b => b.dataset.type === type) ? type : 'all';
    chips.forEach(b => {
      const on = b.dataset.type === activeType;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
  }

  // ── Boot ────────────────────────────────────────────────────────
  setType(new URLSearchParams(location.search).get('type'));
  const feedIndexP = fetch('/search-index-feed.' + LANG + '.json')
    .then(r => (r.ok ? r.json() : []))
    .catch(() => { $offline.hidden = false; return []; });

  fetch('/search-index.' + LANG + '.json').then(r => r.json()).then(idx => {
    INDEX = idx;
    const params = new URLSearchParams(location.search);
    const initial = params.get('q') || '';
    if (initial) { $input.value = initial; runQuery(initial); }
    $input.focus();
    feedIndexP.then(extra => {
      if (!Array.isArray(extra) || !extra.length) return;
      INDEX = INDEX.concat(extra);
      if ($input.value.trim()) runQuery($input.value);
    });
  }).catch(err => {
    console.error('search index load failed:', err);
    $hint.textContent = COPY.noResults;
  });

  function runQuery(q) {
    const qNorm = normalize(q.trim());
    const all = search(q);
    const results = activeType === 'all' ? all : all.filter(e => typeOf(e) === activeType);
    const key = qNorm + '\n' + results.slice(0, 5).map(r => r.url).join('\n');
    if (key !== aiKey) { stopAI(); aiKey = key; }
    render(results, qNorm, all.length);
    detectCachedModel();
    const url = new URL(location.href);
    if (q.trim()) url.searchParams.set('q', q.trim());
    else url.searchParams.delete('q');
    if (activeType !== 'all') url.searchParams.set('type', activeType);
    else url.searchParams.delete('type');
    history.replaceState(history.state, '', url);
  }

  let debounce = null;
  $input.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = setTimeout(() => runQuery($input.value), 80);
  });
  $input.addEventListener('keydown', e => {
    if (e.isComposing || e.keyCode === 229) return;
    if (e.key === 'Enter') { e.preventDefault(); runQuery($input.value); }
  });

  $filters.addEventListener('click', e => {
    const btn = e.target.closest('[data-type]');
    if (!btn) return;
    setType(btn.dataset.type);
    runQuery($input.value);
  });

  $more.addEventListener('click', () => {
    const from = $results.children.length;
    shown += PAGE_SIZE;
    renderMore();
    const next = $results.children[from];
    const link = next && next.querySelector('a');
    if (link) link.focus();
  });

  $aiBtn.addEventListener('click', runAISummary);
})();
</script>

<style>
.sx { display: flex; flex-direction: column; gap: 1rem; max-width: 720px; margin: 0 auto; }
.sx__bar {
  display: flex; align-items: center; gap: 0.6rem;
  padding: 0.7rem 1rem;
  background: rgba(255,255,255,0.04);
  border: 1px solid var(--term-border);
  border-radius: 999px;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.sx__bar:focus-within {
  border-color: var(--syn-cyan);
  box-shadow: 0 0 12px rgba(34,211,238,0.18);
}
.sx__bar-icon { color: var(--term-muted); flex-shrink: 0; }
.sx__input {
  flex: 1; min-width: 0;
  background: transparent; border: none; outline: none;
  color: var(--term-fg);
  font-family: var(--font-mono); font-size: 1rem;
}
.sx__input::placeholder { color: var(--term-muted); opacity: 0.7; }

.sx__filters { display: flex; gap: 0.4rem; flex-wrap: wrap; }
.sx__chip {
  font-family: var(--font-mono); font-size: 0.75rem;
  padding: 0.3rem 0.85rem;
  border-radius: 999px;
  border: 1px solid var(--term-border);
  background: transparent;
  color: var(--term-muted);
  cursor: pointer;
  transition: all 0.15s ease;
}
.sx__chip:hover { color: var(--term-fg); border-color: rgba(255,255,255,0.18); }
.sx__chip.is-active {
  background: rgba(34,211,238,0.12);
  border-color: rgba(34,211,238,0.35);
  color: var(--syn-cyan);
}

.sx__ai {
  border: 1px solid rgba(167,139,250,0.25);
  background: rgba(167,139,250,0.05);
  border-radius: 8px;
  padding: 0.75rem 1rem;
}
.sx__ai-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
.sx__ai-label {
  font-family: var(--font-mono); font-size: 0.7rem;
  text-transform: uppercase; letter-spacing: 0.12em;
  color: var(--syn-purple);
}
.sx__ai-btn {
  font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600;
  padding: 0.35rem 0.85rem;
  border-radius: 999px;
  border: 1px solid rgba(167,139,250,0.4);
  background: rgba(167,139,250,0.1);
  color: var(--syn-purple);
  cursor: pointer;
  transition: all 0.15s ease;
}
.sx__ai-btn:hover:not(:disabled) {
  background: rgba(167,139,250,0.2);
  border-color: var(--syn-purple);
}
.sx__ai-btn:disabled { opacity: 0.5; cursor: not-allowed; }
.sx__ai-body {
  margin-top: 0.6rem;
  font-family: var(--font-mono); font-size: 0.85rem;
  line-height: 1.55; color: var(--term-fg);
  min-height: 1.55em;
}
