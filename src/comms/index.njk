const renderLine = (who, what, opts = {}) => {
  const line = document.createElement('div');
  line.className = 'comms__line' + (opts.sys ? ' comms__line--sys' : opts.me ? ' comms__line--me' : ' comms__line--peer');
  const w = document.createElement('span');
  w.className = 'comms__who' + (opts.sys ? ' comms__who--sys' : opts.me ? ' comms__who--me' : '');
  if (opts.sys) {
    w.hidden = true;
  } else if (opts.me) {
    w.textContent = hhmmOf(opts.ts);
  } else {
    w.textContent = who;
    if (opts.peerId) w.style.color = peerColor(opts.peerId);
    const time = document.createElement('span');
    time.className = 'comms__time';
    time.textContent = hhmmOf(opts.ts);
    w.append(time);
  }
  const t = document.createElement('span');
  t.className = 'comms__what' + (opts.sys ? ' comms__what--sys' : '');
  if (opts.html) t.innerHTML = opts.html;
  else if (!opts.sys && window.renderMarkdown && /[*_`#>\[\]|\n-]/.test(String(what || ''))) {
    t.innerHTML = renderMarkdown(String(what)) || '';
    t.querySelectorAll('a[href]').forEach((a) => { a.target = '_blank'; a.rel = 'noopener'; });
  } else t.textContent = what;
  if (opts.quiet) line.setAttribute('aria-live', 'off');
  line.append(w, t);
  const ts = (typeof opts.ts === 'number' && opts.ts > 0) ? opts.ts : Date.now();
  line.dataset.ts = String(ts);
  const kids = els.log.children;
  let ref = null;
  for (let i = kids.length - 1; i >= 0; i--) {
    if (Number(kids[i].dataset.ts || 0) <= ts) break;
    ref = kids[i];
  }
  if (ref) els.log.insertBefore(line, ref);
  else els.log.append(line);
  if (logPinned || (opts.me && typeof opts.ts !== 'number')) els.log.scrollTop = els.log.scrollHeight;
  return { line, what: t };
};

