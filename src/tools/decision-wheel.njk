---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/tools/decision-wheel/index.html"
eleventyComputed:
  lang: "{{ locale.code }}"
  title: "{{ 'tools.decision-wheel.title' | t }}"
  description: "{{ 'tools.decision-wheel.lede' | t }}"
---
<section class="hero" style="padding-top:1rem;">
  <p class="eyebrow eyebrow--crumbs"><a class="eyebrow__link" href="{{ locale.pathPrefix }}/">~</a><span class="eyebrow__sep">/</span><a class="eyebrow__link" href="{{ locale.pathPrefix }}/tools/">tools</a><span class="eyebrow__sep">/</span><span class="eyebrow__current">decision-wheel</span></p>
  <h1>{{ "tools.decision-wheel.title" | t }}</h1>
  <p>{{ "tools.decision-wheel.lede" | t }}</p>
  {% include "tldr.njk" %}
</section>

{% set terminalTitle = "decision-wheel.js" %}
{% include "terminal-frame-open.njk" %}
<section class="dw">
  <div class="dw__stage">
    <div class="dw__ring-outer"></div>

    <div class="dw__wheel-wrap">
      <div class="dw__pointer" aria-hidden="true">
        <svg width="20" height="28" viewBox="0 0 20 28"><path d="M10 28L0 0h20z" fill="var(--syn-cyan)"/></svg>
      </div>
      <div class="dw__wheel" id="dw-wheel" role="img" aria-label="{{ 'tool.decision-wheel.aria_wheel' | t }}">
        <div class="dw__segments" id="dw-segments"></div>
        <button class="dw__hub" id="dw-hub" type="button" aria-label="{{ 'tool.decision-wheel.aria_spin' | t }}"></button>
      </div>
    </div>
  </div>

  <div class="dw__result-wrap">
    <div class="dw__result-label">{{ "tool.decision-wheel.result_label" | t }}</div>
    <div class="dw__result" id="dw-result" data-outcome="" role="status" aria-live="polite">
      <span class="dw__result-text">{{ "tool.decision-wheel.result_ready" | t }}</span>
    </div>
  </div>

  <div class="dw__controls">
    <button class="dw__spin-btn" id="dw-spin">
      <span class="dw__spin-icon">&#x25B6;</span>
      {{ "tool.decision-wheel.btn_spin" | t }}
    </button>
  </div>

  <div class="dw__options">
    <div class="dw__options-label" id="dw-options-label">{{ "tool.decision-wheel.options_label" | t }}</div>
    <ul class="dw__option-list" id="dw-option-list" aria-labelledby="dw-options-label"></ul>
    <form class="dw__option-form" id="dw-option-form">
      <input class="m-input dw__option-input" id="dw-option-input" maxlength="24" autocomplete="off" placeholder="{{ 'tool.decision-wheel.add_placeholder' | t }}" aria-label="{{ 'tool.decision-wheel.add_placeholder' | t }}">
      <button type="submit" class="m-btn m-btn--ghost" id="dw-option-add">{{ "tool.decision-wheel.btn_add" | t }}</button>
      <button type="button" class="m-btn m-btn--ghost" id="dw-option-reset">{{ "tool.decision-wheel.btn_reset" | t }}</button>
    </form>
  </div>
</section>
{% include "terminal-frame-close.njk" %}

{% include "tool-schema.njk" %}

<script>
(() => {
  const COPY = {
    yes:  {{ ("tool.decision-wheel.outcome_yes"  | t) | dump | safe }},
    no:   {{ ("tool.decision-wheel.outcome_no"   | t) | dump | safe }},
    upto: {{ ("tool.decision-wheel.outcome_upto" | t) | dump | safe }},
    wait: {{ ("tool.decision-wheel.outcome_wait" | t) | dump | safe }},
    errMin: {{ ("tool.decision-wheel.err_min" | t) | dump | safe }},
    errMax: {{ ("tool.decision-wheel.err_max" | t) | dump | safe }},
    btnRemove: {{ ("tool.decision-wheel.btn_remove" | t) | dump | safe }}
  };
  const DEFAULTS = [COPY.yes, COPY.no, COPY.upto, COPY.wait];
  const PALETTE = [
    { dot: "var(--syn-green)",  hi: "var(--green-30)",  glow: "var(--green-15)",  soft: "var(--green-8)" },
    { dot: "var(--syn-pink)",   hi: "var(--pink-30)",   glow: "var(--pink-15)",   soft: "var(--pink-10)" },
    { dot: "var(--syn-cyan)",   hi: "var(--cyan-30)",   glow: "var(--cyan-15)",   soft: "var(--cyan-8)" },
    { dot: "var(--syn-amber)",  hi: "var(--amber-30)",  glow: "var(--amber-15)",  soft: "var(--amber-8)" },
    { dot: "var(--syn-purple)", hi: "var(--purple-20)", glow: "var(--purple-20)", soft: "var(--purple-8)" },
    { dot: "var(--syn-orange)", hi: "var(--orange-30)", glow: "var(--orange-15)", soft: "var(--orange-8)" }
  ];
  const MINN = 2, MAXN = 8;
  const NS = "tools", KEY = "decision_wheel_options";

  const wheel = document.getElementById("dw-wheel");
  const segWrap = document.getElementById("dw-segments");
  const resultEl = document.getElementById("dw-result");
  const resultText = resultEl.querySelector(".dw__result-text");
  const spinBtn = document.getElementById("dw-spin");
  const hubBtn = document.getElementById("dw-hub");
  const listEl = document.getElementById("dw-option-list");
  const formEl = document.getElementById("dw-option-form");
  const inputEl = document.getElementById("dw-option-input");
  const resetBtn = document.getElementById("dw-option-reset");
  const readyLabel = resultText.textContent;
  const reducedMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function loadOptions() {
    try {
      const v = window.MentriaStore && window.MentriaStore.get(NS, KEY);
      if (Array.isArray(v)) {
        const clean = v.filter((x) => typeof x === "string" && x.trim()).map((x) => x.trim().slice(0, 24));
        if (clean.length >= MINN && clean.length <= MAXN) return clean;
      }
    } catch (_) {}
    return null;
  }

  let options = loadOptions() || DEFAULTS.slice();
  let customized = !!loadOptions();
  let segments = [];

  function persist() {
    if (!window.MentriaStore) return;
    if (customized) window.MentriaStore.set(NS, KEY, options);
    else window.MentriaStore.remove(NS, KEY);
  }

  function colorIdx(i, n) {
    let c = i % PALETTE.length;
    if (i === n - 1 && n > PALETTE.length && c === 0) c = 1;
    return c;
  }

  function wedgeClip(a0, a1) {
    const pts = ["50% 50%"];
    const step = Math.min(22.5, a1 - a0);
    for (let a = a0; a < a1 + 0.01; a += step) {
      const ang = Math.min(a, a1) * Math.PI / 180;
      const x = 50 + 150 * Math.sin(ang);
      const y = 50 - 150 * Math.cos(ang);
      pts.push(x.toFixed(2) + "% " + y.toFixed(2) + "%");
    }
    return "polygon(" + pts.join(", ") + ")";
  }

  function buildWheel() {
    segWrap.innerHTML = "";
    segments = [];
    const angle = 360 / options.length;
    options.forEach((label, i) => {
      const pal = PALETTE[colorIdx(i, options.length)];
      const d = document.createElement("div");
      d.className = "dw__segment";
      d.style.clipPath = wedgeClip(i * angle, (i + 1) * angle);
      d.style.setProperty("--seg-angle", (i * angle + angle / 2) + "deg");
      d.style.setProperty("--seg-hi", pal.hi);
      d.style.setProperty("--seg-glow", pal.glow);
      d.style.setProperty("--seg-soft", pal.soft);
      segWrap.appendChild(d);
      segments.push(d);
    });
  }

  function renderOptions() {
    listEl.innerHTML = "";
    options.forEach((label, i) => {
      const pal = PALETTE[colorIdx(i, options.length)];
      const li = document.createElement("li");
      li.className = "dw__option-row";
      const dot = document.createElement("span");
      dot.className = "dw__option-dot";
      dot.style.background = pal.dot;
      const text = document.createElement("span");
      text.className = "dw__option-text";
      text.textContent = label;
      const rm = document.createElement("button");
      rm.type = "button";
      rm.className = "dw__option-remove m-btn m-btn--ghost m-btn--icon";
      rm.textContent = "\u00d7";
      rm.setAttribute("aria-label", COPY.btnRemove.replace("{name}", label));
      rm.disabled = options.length <= MINN;
      rm.addEventListener("click", () => {
        if (options.length <= MINN) return;
        options.splice(i, 1);
        customized = true;
        applyChange();
      });
      li.append(dot, text, rm);
      listEl.appendChild(li);
    });
  }

  function resetResult() {
    resultText.textContent = readyLabel;
    resultEl.dataset.outcome = "";
    resultEl.style.removeProperty("--result-color");
  }

  function applyChange() {
    persist();
    buildWheel();
    renderOptions();
    resetResult();
  }

  formEl.addEventListener("submit", (e) => {
    e.preventDefault();
    const v = inputEl.value.trim().slice(0, 24);
    if (!v) return;
    if (options.length >= MAXN) {
      if (window.MentriaUI) MentriaUI.toast(COPY.errMax);
      return;
    }
    options.push(v);
    customized = true;
    inputEl.value = "";
    applyChange();
    inputEl.focus();
  });

  resetBtn.addEventListener("click", () => {
    options = DEFAULTS.slice();
    customized = false;
    applyChange();
  });

  function rand() {
    try { return crypto.getRandomValues(new Uint32Array(1))[0] / 4294967296; }
    catch (_) { return Math.random(); }
  }

  let rotation = 0;
  let velocity = 0;
  let animating = false;
  let lastActiveIndex = -1;
  const FRICTION = 0.985;
  const STOP_THRESHOLD = 0.3;

  function getSegmentAtPointer() {
    const angle = 360 / options.length;
    const norm = ((rotation % 360) + 360) % 360;
    const pointerAngle = (360 - norm) % 360;
    return Math.floor(pointerAngle / angle) % options.length;
  }

  function highlightSegment(index) {
    if (index === lastActiveIndex) return;
    segments.forEach((s2) => s2.classList.remove("dw__segment--active"));
    if (index >= 0 && index < segments.length) segments[index].classList.add("dw__segment--active");
    lastActiveIndex = index;
  }

  function settle(finalIndex) {
    const pal = PALETTE[colorIdx(finalIndex, options.length)];
    resultText.textContent = options[finalIndex];
    resultEl.style.setProperty("--result-color", pal.dot);
    segments.forEach((s2) => s2.classList.remove("dw__segment--active"));
    segments[finalIndex].classList.add("dw__segment--winner");
    lastActiveIndex = -1;
    if (navigator.vibrate) { try { navigator.vibrate(30); } catch (_) {} }
  }

  function tick() {
    if (!animating) return;
    velocity *= FRICTION;
    rotation += velocity;
    wheel.style.transform = "rotate(" + rotation + "deg)";
    highlightSegment(getSegmentAtPointer());
    if (velocity < STOP_THRESHOLD) {
      animating = false;
      velocity = 0;
      wheel.classList.remove("dw__wheel--spinning");
      settle(getSegmentAtPointer());
      return;
    }
    requestAnimationFrame(tick);
  }

  function spin() {
    segments.forEach((s2) => s2.classList.remove("dw__segment--winner"));
    resultText.textContent = "...";
    resultEl.dataset.outcome = "";
    if (reducedMotion) {
      const n = options.length;
      const angle = 360 / n;
      const finalIndex = Math.floor(rand() * n);
      rotation = (360 - (finalIndex * angle + angle / 2)) % 360;
      wheel.style.transform = "rotate(" + rotation + "deg)";
      settle(finalIndex);
      return;
    }
    velocity += 15 + rand() * 10 + rand() * 8;
    if (velocity > 80) velocity = 80;
    wheel.classList.add("dw__wheel--spinning");
    if (!animating) {
      animating = true;
      requestAnimationFrame(tick);
    }
  }

  if (spinBtn) spinBtn.addEventListener("click", spin);
  if (hubBtn) hubBtn.addEventListener("click", spin);

  buildWheel();
  renderOptions();
})();
</script>

<style>
.dw {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rem;
  padding: 1rem 0;
  font-family: var(--font-mono);
}

.dw__stage {
  position: relative;
  width: min(340px, 80vw);
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dw__ring-outer {
  position: absolute;
  inset: -8px;
  border-radius: 50%;
  border: 1px solid rgba(34, 211, 238, 0.12);
  pointer-events: none;
}
.dw__ring-outer::before {
  content: '';
  position: absolute;
  inset: -12px;
  border-radius: 50%;
  border: 1px dashed rgba(34, 211, 238, 0.06);
}

.dw__wheel-wrap {
  position: relative;
  width: 100%;
  height: 100%;
}

.dw__wheel {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  position: relative;
  overflow: hidden;
  background: #0d0d0d;
  box-shadow:
    0 0 0 2px var(--term-border),
    0 0 40px rgba(0,0,0,0.6),
    inset 0 0 30px rgba(0,0,0,0.8);
}

.dw__wheel--spinning {
  box-shadow:
    0 0 0 2px rgba(34, 211, 238, 0.2),
    0 0 60px rgba(34, 211, 238, 0.1),
    inset 0 0 30px rgba(0,0,0,0.8);
}

.dw__segments { position: absolute; inset: 0; }

.dw__segment {
  position: absolute;
  inset: 0;
  background: linear-gradient(var(--seg-angle), var(--seg-glow) 0%, var(--seg-soft) 100%);
  transition: background 0.15s ease, box-shadow 0.15s ease;
}

.dw__segment--active {
  background: linear-gradient(var(--seg-angle), var(--seg-hi) 0%, var(--seg-soft) 100%);
  box-shadow: inset 0 0 30px var(--seg-glow);
}

.dw__segment--winner {
  background: linear-gradient(var(--seg-angle), var(--seg-hi) 0%, var(--seg-soft) 100%);
  box-shadow: inset 0 0 40px var(--seg-glow), 0 0 20px var(--seg-soft);
}

.dw__options {
  width: 100%;
  max-width: 24rem;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.dw__options-label {
  font-size: var(--text-2xs);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--term-muted);
}
.dw__option-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}
.dw__option-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-1) var(--space-2);
  border: 1px solid var(--term-border);
  border-radius: var(--radius-sm);
  font-size: var(--text-xs);
  color: var(--term-fg);
}
.dw__option-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
}
.dw__option-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dw__option-remove {
  width: 24px;
  height: 24px;
  padding: 0;
  font-size: var(--text-sm);
  line-height: 1;
}
.dw__option-form {
  display: flex;
  gap: var(--space-2);
}
.dw__option-input { flex: 1; min-width: 0; }

.dw__hub {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: radial-gradient(circle, #1a1a1a 0%, var(--term-bg) 100%);
  border: 2px solid rgba(255,255,255,0.08);
  box-shadow:
    0 0 20px rgba(0,0,0,0.8),
    inset 0 1px 0 rgba(255,255,255,0.05);
  z-index: 2;
  cursor: pointer;
  padding: 0;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.dw__hub:hover {
  border-color: var(--cyan-30);
  box-shadow:
    0 0 20px rgba(0,0,0,0.8),
    0 0 12px var(--cyan-15),
    inset 0 1px 0 rgba(255,255,255,0.05);
}
.dw__hub::after {
  content: '';
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--syn-cyan);
  box-shadow: 0 0 10px var(--syn-cyan), 0 0 20px var(--cyan-30);
}

.dw__pointer {
  position: absolute;
  top: -14px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  filter: drop-shadow(0 0 8px rgba(34, 211, 238, 0.5));
  animation: dw-pointer-pulse 2s ease-in-out infinite;
}

@keyframes dw-pointer-pulse {
  0%, 100% { filter: drop-shadow(0 0 6px rgba(34, 211, 238, 0.4)); }
  50% { filter: drop-shadow(0 0 14px rgba(34, 211, 238, 0.7)); }
}

.dw__result-wrap {
  text-align: center;
}

.dw__result-label {
  font-size: 0.65rem;
  color: var(--term-muted);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  margin-bottom: 0.4rem;
}

.dw__result {
  --result-color: var(--term-muted);
  font-size: clamp(1.6rem, 5vw, 2.2rem);
  font-weight: 700;
  color: var(--result-color);
  min-height: 1.5em;
  display: flex;
  align-items: center;
  justify-content: center;
  text-shadow: 0 0 20px color-mix(in srgb, var(--result-color) 50%, transparent);
  transition: color 0.3s ease;
}

.dw__result[data-outcome="yes"] { --result-color: var(--syn-green); }
.dw__result[data-outcome="no"] { --result-color: var(--syn-pink); }
.dw__result[data-outcome="upto"] { --result-color: var(--syn-cyan); }
.dw__result[data-outcome="wait"] { --result-color: var(--syn-amber); }

.dw__controls {
  display: flex;
  justify-content: center;
}

.dw__spin-btn {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  border: none;
  border-radius: var(--radius-pill);
  padding: 0.7rem 2rem;
  font-family: var(--font-mono);
  font-size: 0.9rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  cursor: pointer;
  color: #000;
  background: linear-gradient(135deg, var(--syn-cyan) 0%, #0ea5e9 100%);
  box-shadow: 0 4px 20px var(--cyan-30);
  transition: all 0.25s ease;
}

.dw__spin-btn:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 6px 28px rgba(34, 211, 238, 0.45);
}

.dw__spin-btn:active:not(:disabled) {
  transform: translateY(0);
}


.dw__spin-icon {
  font-size: 0.75rem;
}

.dw__legend {
  display: flex;
  gap: 1.25rem;
  flex-wrap: wrap;
  justify-content: center;
  font-size: 0.75rem;
  color: var(--term-muted);
}

.dw__legend-item {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.dw__legend-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  box-shadow: 0 0 6px currentColor;
}

.dw__wheel::before {
  content: '';
  position: absolute;
  top: 0; left: 50%;
  width: 1px;
  height: 100%;
  background: var(--term-divider);
  z-index: 1;
}
.dw__wheel::after {
  content: '';
  position: absolute;
  top: 50%; left: 0;
  width: 100%;
  height: 1px;
  background: var(--term-divider);
  z-index: 1;
}

@media (max-width: 480px) {
  .dw__legend {
    gap: 0.75rem;
    font-size: 0.7rem;
  }
}
</style>
