};

const updatePushStatus = () => {
  if (!els.pushStatus) return;
  const bits = [];
  if (!window.MentriaPush || !MentriaPush.isSupported()) bits.push(T.push.unsupported);
  else if (MentriaPush.permission() !== 'granted') bits.push(T.push.yours_off);
  else bits.push(ringToken ? T.push.yours_on : ringRegFailed ? T.push.yours_failed : T.push.yours_pending);
  CID.getContacts().forEach((c) => {
    bits.push(fmt(c.ring ? T.push.reachable : T.push.no_token, { name: c.name || c.fp }));
  });
  try {
    const lk = MentriaStore.get('comms', 'last_knock');
    if (lk && lk.t) bits.push(lk.ok ? fmt(T.push.knock_ok, { time: hhmmOf(lk.t) }) : fmt(T.push.knock_fail, { time: hhmmOf(lk.t), reason: knockWhy(lk.reason) }));
  } catch (_) {}
  els.pushStatus.textContent = bits.join(' · ');
  if (window.MentriaPushDB && MentriaPushDB.kvGet) {
    MentriaPushDB.kvGet('last-push-at').then((t) => {
      if (typeof t === 'number' && t > 0) els.pushStatus.textContent += ' · ' + fmt(T.push.last_push, { time: hhmmOf(t) });
