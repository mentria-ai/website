  .calc__key--clear:hover { background: var(--pink-15); }
  .calc__key--eq:hover { background: var(--syn-cyan-soft); border-color: transparent; }
  .calc__hist:hover { border-color: var(--term-border-strong); background: var(--term-surface-2); }
