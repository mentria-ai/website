---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/tools/pdf/index.html"
eleventyComputed:
  lang: "{{ locale.code }}"
  title: "{{ 'tools.pdf.title' | t }}"
  description: "{{ 'tools.pdf.lede' | t }}"
---
<section class="hero" style="padding-top:1rem;">
  <p class="eyebrow eyebrow--crumbs"><a class="eyebrow__link" href="{{ locale.pathPrefix }}/" aria-label="{{ 'nav.home' | t }}">~</a><span class="eyebrow__sep">/</span><a class="eyebrow__link" href="{{ locale.pathPrefix }}/tools/">tools</a><span class="eyebrow__sep">/</span><span class="eyebrow__current">pdf</span></p>
  <h1>{{ "tools.pdf.title" | t }}</h1>
  <p>{{ "tools.pdf.lede" | t }}</p>
  {% include "tldr.njk" %}
</section>

{% set terminalTitle = "pdf.js" %}
{% include "terminal-frame-open.njk" %}
<section class="pdf" id="pdf">
  <div class="pdf__start" id="pdf-start">
    <div class="pdf__drop" id="pdf-drop">
      <svg class="pdf__drop-icon" viewBox="0 0 48 48" aria-hidden="true"><use href="#tool-pdf"></use></svg>
      <p class="pdf__drop-title">{{ "tool.pdf.drop" | t }}</p>
      <div class="pdf__drop-acts">
        <button type="button" class="m-btn m-btn--primary" id="pdf-open">{{ "tool.pdf.open" | t }}</button>
        <button type="button" class="m-btn m-btn--ghost" id="pdf-combine">{{ "tool.pdf.combine" | t }}</button>
      </div>
      <p class="pdf__hint">{{ "tool.pdf.drop_hint" | t }}</p>
    </div>
    <div class="pdf__can">
      <div><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg><p><b>{{ "tool.pdf.can_read_t" | t }}</b><span>{{ "tool.pdf.can_read" | t }}</span></p></div>
      <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 11-6 6v3h9l3-3"/><path d="m22 12-4.6 4.6a2 2 0 0 1-2.8 0l-5.2-5.2a2 2 0 0 1 0-2.8L14 4"/></svg><p><b>{{ "tool.pdf.can_edit_t" | t }}</b><span>{{ "tool.pdf.can_edit" | t }}</span></p></div>
      <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17c2.5-3 4-6 6-6s-1 6 1 6 3-4 5-4 1 4 3 4 3-2 3-2"/><path d="M3 21h18"/></svg><p><b>{{ "tool.pdf.can_sign_t" | t }}</b><span>{{ "tool.pdf.can_sign" | t }}</span></p></div>
      <div><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg><p><b>{{ "tool.pdf.can_pages_t" | t }}</b><span>{{ "tool.pdf.can_pages" | t }}</span></p></div>
    </div>
  </div>

  <div class="pdf__app" id="pdf-app" hidden>
    <div class="pdf__top">
      <div class="pdf__file"><span class="pdf__name" id="pdf-name"></span><span class="pdf__meta" id="pdf-meta"></span></div>
      <div class="m-seg pdf__modes" id="pdf-modes" role="group" aria-label="{{ 'tool.pdf.modes_label' | t }}">
        <button type="button" data-mode="read" class="is-active" aria-pressed="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 4h6a4 4 0 0 1 4 4v12a3 3 0 0 0-3-3H2z"/><path d="M22 4h-6a4 4 0 0 0-4 4v12a3 3 0 0 1 3-3h7z"/></svg>{{ "tool.pdf.mode_read" | t }}</button>
        <button type="button" data-mode="edit" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>{{ "tool.pdf.mode_edit" | t }}</button>
        <button type="button" data-mode="pages" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>{{ "tool.pdf.mode_pages" | t }}</button>
      </div>
      <div class="pdf__acts">
        <button type="button" class="pdf__ib" id="pdf-another" title="{{ 'tool.pdf.open_other' | t }}" aria-label="{{ 'tool.pdf.open_other' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg></button>
        <button type="button" class="pdf__ib" id="pdf-share" title="{{ 'tool.pdf.share' | t }}" aria-label="{{ 'tool.pdf.share' | t }}" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M16 6l-4-4-4 4"/><path d="M12 2v13"/></svg></button>
        <button type="button" class="m-btn m-btn--primary pdf__save" id="pdf-save" title="{{ 'tool.pdf.save' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg><span>{{ "tool.pdf.save" | t }}</span></button>
      </div>
    </div>

    <div class="pdf__bar" id="pdf-readbar">
      <button type="button" class="pdf__ib pdf__wide" id="pdf-prev" title="{{ 'tool.pdf.prev' | t }}" aria-label="{{ 'tool.pdf.prev' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
      <span class="pdf__page pdf__wide" id="pdf-page" aria-live="polite"></span>
      <button type="button" class="pdf__ib pdf__wide" id="pdf-next" title="{{ 'tool.pdf.next' | t }}" aria-label="{{ 'tool.pdf.next' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
      <span class="pdf__sep pdf__wide"></span>
      <button type="button" class="pdf__ib" id="pdf-zoom-out" title="{{ 'tool.pdf.zoom_out' | t }}" aria-label="{{ 'tool.pdf.zoom_out' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/></svg></button>
      <span class="pdf__zoom" id="pdf-zoom"></span>
      <button type="button" class="pdf__ib" id="pdf-zoom-in" title="{{ 'tool.pdf.zoom_in' | t }}" aria-label="{{ 'tool.pdf.zoom_in' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
      <button type="button" class="pdf__ib" id="pdf-fit" title="{{ 'tool.pdf.fit' | t }}" aria-label="{{ 'tool.pdf.fit' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg></button>
      <span class="pdf__sep"></span>
      <button type="button" class="pdf__ib" id="pdf-dark" title="{{ 'tool.pdf.dark' | t }}" aria-label="{{ 'tool.pdf.dark' | t }}" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg></button>
      <button type="button" class="pdf__ib" id="pdf-side" title="{{ 'tool.pdf.side' | t }}" aria-label="{{ 'tool.pdf.side' | t }}" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg></button>
      <button type="button" class="pdf__ib pdf__end" id="pdf-search" title="{{ 'tool.pdf.search' | t }}" aria-label="{{ 'tool.pdf.search' | t }}" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg></button>
    </div>
    <form class="pdf__findrow" id="pdf-findrow" role="search" hidden>
      <label class="pdf__find"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg><input type="search" id="pdf-find" placeholder="{{ 'tool.pdf.find_ph' | t }}" aria-label="{{ 'tool.pdf.find_ph' | t }}" enterkeyhint="search" autocomplete="off"><em id="pdf-find-count"></em></label>
      <button type="button" class="pdf__ib" id="pdf-find-prev" title="{{ 'tool.pdf.find_prev' | t }}" aria-label="{{ 'tool.pdf.find_prev' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg></button>
      <button type="button" class="pdf__ib" id="pdf-find-next" title="{{ 'tool.pdf.find_next' | t }}" aria-label="{{ 'tool.pdf.find_next' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
    </form>

    <div class="pdf__bar" id="pdf-editbar" hidden>
      <div class="pdf__tools" role="group" aria-label="{{ 'tool.pdf.mode_edit' | t }}">
        <button type="button" class="pdf__chip" data-tool="highlight" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 11-6 6v3h9l3-3"/><path d="m22 12-4.6 4.6a2 2 0 0 1-2.8 0l-5.2-5.2a2 2 0 0 1 0-2.8L14 4"/></svg>{{ "tool.pdf.t_highlight" | t }}</button>
        <button type="button" class="pdf__chip" data-tool="text" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7V4h16v3M9 20h6M12 4v16"/></svg>{{ "tool.pdf.t_text" | t }}</button>
        <button type="button" class="pdf__chip" data-tool="draw" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17c3-4 5 2 8-2s4-6 7-3 3 2 3 2"/></svg>{{ "tool.pdf.t_draw" | t }}</button>
        <button type="button" class="pdf__chip" data-tool="image" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>{{ "tool.pdf.t_image" | t }}</button>
        <button type="button" class="pdf__chip" data-tool="sign" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17c2.5-3 4-6 6-6s-1 6 1 6 3-4 5-4 1 4 3 4 3-2 3-2"/><path d="M3 21h18"/></svg>{{ "tool.pdf.t_sign" | t }}</button>
      </div>
      <div class="pdf__opts">
        <span class="pdf__sep pdf__wide"></span>
        <div class="pdf__swatches" id="pdf-swatches" role="radiogroup" aria-label="{{ 'tool.pdf.color' | t }}"></div>
        <span class="pdf__sep"></span>
        <button type="button" class="pdf__ib" id="pdf-undo" title="{{ 'tool.pdf.undo' | t }}" aria-label="{{ 'tool.pdf.undo' | t }}" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/></svg></button>
        <button type="button" class="pdf__ib" id="pdf-redo" title="{{ 'tool.pdf.redo' | t }}" aria-label="{{ 'tool.pdf.redo' | t }}" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 14 5-5-5-5"/><path d="M20 9H9a5 5 0 0 0 0 10h3"/></svg></button>
        <button type="button" class="pdf__ib" id="pdf-del" title="{{ 'tool.pdf.delete_item' | t }}" aria-label="{{ 'tool.pdf.delete_item' | t }}" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg></button>
        <span class="pdf__hint pdf__wide pdf__end" id="pdf-edit-hint"></span>
      </div>
    </div>

    <div class="pdf__view" id="pdf-view">
      <aside class="pdf__rail" id="pdf-rail">
        <div class="pdf__rail-tabs" role="tablist">
          <button type="button" role="tab" data-rail="thumbs" aria-selected="true" class="is-on">{{ "tool.pdf.tab_pages" | t }}</button>
          <button type="button" role="tab" data-rail="outline" aria-selected="false">{{ "tool.pdf.tab_outline" | t }}</button>
        </div>
        <div class="pdf__thumbs" id="pdf-thumbs"></div>
        <div class="pdf__outline" id="pdf-outline" hidden></div>
      </aside>
      <div class="pdf__stage" id="pdf-stage">
        <div class="pdf__scroll" id="pdf-scroll"><div class="pdfViewer" id="pdf-viewer"></div></div>
        <div class="pdf__float pdf__narrow" id="pdf-float" aria-hidden="true"></div>
      </div>
    </div>

    <div class="pdf__pages" id="pdf-pages" hidden>
      <div class="pdf__grid" id="pdf-grid" role="listbox" aria-multiselectable="true" aria-label="{{ 'tool.pdf.mode_pages' | t }}"></div>
      <div class="pdf__tray">
        <span class="pdf__hint" id="pdf-pages-hint"></span>
        <button type="button" class="m-btn m-btn--ghost" data-act="add"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M12 12v6M9 15h6"/></svg><span>{{ "tool.pdf.p_add" | t }}</span></button>
        <button type="button" class="m-btn m-btn--ghost" data-act="rotate"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/></svg><span>{{ "tool.pdf.p_rotate" | t }}</span></button>
        <button type="button" class="m-btn m-btn--ghost" data-act="delete"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg><span>{{ "tool.pdf.p_delete" | t }}</span></button>
        <button type="button" class="m-btn m-btn--ghost" data-act="extract"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/><path d="M9 15h6"/></svg><span>{{ "tool.pdf.p_extract" | t }}</span></button>
        <button type="button" class="m-btn m-btn--ghost" data-act="split"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M20 4 8.1 15.9M14.5 14.5 20 20M8.1 8.1 12 12"/></svg><span>{{ "tool.pdf.p_split" | t }}</span></button>
        <button type="button" class="m-btn m-btn--ghost" data-act="images"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg><span>{{ "tool.pdf.p_images" | t }}</span></button>
      </div>
    </div>
  </div>

  <form class="pdf__pass" id="pdf-pass" hidden>
    <p class="pdf__pass-title">{{ "tool.pdf.pass_title" | t }}</p>
    <p class="pdf__hint" id="pdf-pass-msg"></p>
    <input class="m-input pdf__pass-input" type="password" id="pdf-pass-input" placeholder="{{ 'tool.pdf.pass_ph' | t }}" aria-label="{{ 'tool.pdf.pass_ph' | t }}" autocomplete="off">
    <div class="pdf__drop-acts">
      <button type="submit" class="m-btn m-btn--primary">{{ "tool.pdf.pass_open" | t }}</button>
      <button type="button" class="m-btn m-btn--ghost" id="pdf-pass-cancel">{{ "tool.pdf.pass_cancel" | t }}</button>
    </div>
  </form>

  <p class="pdf__status" id="pdf-status" role="status" aria-live="polite"></p>

  <input type="file" id="pdf-file" accept="application/pdf,.pdf" hidden>
  <input type="file" id="pdf-files" accept="application/pdf,.pdf" multiple hidden>
  <input type="file" id="pdf-image" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml" hidden>
</section>

<div class="m-modal pdf-sig" id="pdf-sig" hidden>
  <div class="m-modal__card pdf-sig__card" aria-labelledby="pdf-sig-title">
    <p class="pdf-sig__title" id="pdf-sig-title">{{ "tool.pdf.sig_title" | t }}</p>
    <div class="m-seg pdf-sig__tabs" role="group">
      <button type="button" data-sig="draw" class="is-active" aria-pressed="true">{{ "tool.pdf.sig_draw" | t }}</button>
      <button type="button" data-sig="type" aria-pressed="false">{{ "tool.pdf.sig_type" | t }}</button>
    </div>
    <canvas class="pdf-sig__pad" id="pdf-sig-pad" width="720" height="260" aria-label="{{ 'tool.pdf.sig_draw' | t }}"></canvas>
    <input class="m-input pdf-sig__name" id="pdf-sig-name" placeholder="{{ 'tool.pdf.sig_name_ph' | t }}" aria-label="{{ 'tool.pdf.sig_name_ph' | t }}" hidden autocomplete="name">
    <label class="pdf-sig__keep"><input type="checkbox" id="pdf-sig-keep"> {{ "tool.pdf.sig_keep" | t }}</label>
    <div class="pdf-sig__acts">
      <button type="button" class="m-btn m-btn--ghost" id="pdf-sig-saved" hidden>{{ "tool.pdf.sig_saved" | t }}</button>
      <button type="button" class="m-btn m-btn--ghost" id="pdf-sig-clear">{{ "tool.pdf.sig_clear" | t }}</button>
      <button type="button" class="m-btn m-btn--ghost" id="pdf-sig-cancel">{{ "tool.pdf.sig_cancel" | t }}</button>
      <button type="button" class="m-btn m-btn--primary" id="pdf-sig-use">{{ "tool.pdf.sig_use" | t }}</button>
    </div>
  </div>
</div>
{% include "terminal-frame-close.njk" %}

{% set pdfKeys = ["pages_count", "pages_one", "selected", "edited", "saved", "find_count", "find_none", "no_outline", "hint_highlight", "hint_text", "hint_draw", "hint_image", "hint_sign", "hint_none", "p_hint", "p_hint_touch", "p_from", "p_need_sel", "p_split_need", "p_deleted", "p_deleted_one", "p_undo", "p_keep_one", "p_locked", "p_working", "p_extracted", "p_split_done", "p_images_done", "page_label", "pass_need", "pass_wrong", "loading", "opening", "not_pdf", "bad_pdf", "offline_first", "load_failed", "save_failed", "sig_empty", "part", "color", "pages_name", "extract_name"] %}
<script>
window.MENTRIA_PDF_COPY = {
{%- for k in pdfKeys %}
  {{ k }}: {{ ("tool.pdf." + k) | t | dump | safe }},
{%- endfor %}
};
</script>
<script type="module">
const V = '/assets/vendor/pdfjs-6.4.299/';
const PL = '/assets/vendor/pdf-lib-1.17.1/pdf-lib.esm.min.js';
const C = window.MENTRIA_PDF_COPY;
const $ = (id) => document.getElementById(id);
const IS_IOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
const COARSE = matchMedia('(pointer: coarse)').matches;
const fill = (s, o) => String(s).replace(/\{(\w+)\}/g, (_, k) => (o && o[k] != null ? o[k] : ''));
const toast = (m) => { if (window.MentriaUI && window.MentriaUI.toast) window.MentriaUI.toast(m); };
const say = (m) => { $('pdf-status').textContent = m || ''; };
const HL_COLORS = ['#6ef3c5', '#fbbf24', '#f472b6', '#67e8f9'];
const PEN_COLORS = ['#111827', '#1d4ed8', '#dc2626', '#15803d'];

const st = {
  core: null, view: null, doc: null, bytes: null, name: '', size: 0, locked: false,
  viewer: null, bus: null, link: null, find: null,
  mode: 'read', tool: null, dirty: false, hl: HL_COLORS[0], pen: PEN_COLORS[0],
  sources: [], pages: [], sel: new Set(), pagesDirty: false, nextId: 1, pageCount: 0
};

let libP = null;
function lib() {
  if (!libP) {
    libP = (async () => {
      if (!document.getElementById('pdf-viewer-css')) {
        const l = document.createElement('link');
        l.id = 'pdf-viewer-css';
        l.rel = 'stylesheet';
        l.href = V + 'pdf_viewer.css';
        document.head.appendChild(l);
      }
      const core = await import(V + 'pdf.min.mjs');
      core.GlobalWorkerOptions.workerSrc = V + 'pdf.worker.min.mjs';
      globalThis.pdfjsLib = core;
      const view = await import(V + 'pdf_viewer.mjs');
      st.core = core;
      st.view = view;
      return { core, view };
    })().catch((e) => { libP = null; throw e; });
  }
  return libP;
}
let plP = null;
function pdfLib() {
  if (!plP) plP = import(PL).catch((e) => { plP = null; throw e; });
  return plP;
}

function baseName() { return (st.name || 'document.pdf').replace(/\.pdf$/i, ''); }
function isPdf(f) { return !!f && (/pdf$/i.test(f.type || '') || /\.pdf$/i.test(f.name || '')); }

function docArgs(bytes) {
  return { data: bytes.slice(), cMapUrl: V + 'cmaps/', cMapPacked: true, standardFontDataUrl: V + 'standard_fonts/', wasmUrl: V + 'wasm/', iccUrl: V + 'iccs/', isEvalSupported: false, enableXfa: false };
}

let passCb = null;
function askPassword(update, reason) {
  const P = st.core.PasswordResponses;
  st.locked = true;
  passCb = update;
  $('pdf-pass-msg').textContent = reason === P.INCORRECT_PASSWORD ? C.pass_wrong : C.pass_need;
  $('pdf-pass').hidden = false;
  $('pdf-start').hidden = true;
  $('pdf-pass-input').value = '';
  $('pdf-pass-input').focus();
}
let passTask = null;
$('pdf-pass').addEventListener('submit', (e) => {
  e.preventDefault();
  if (passCb) passCb($('pdf-pass-input').value);
});
$('pdf-pass-cancel').addEventListener('click', () => {
  $('pdf-pass').hidden = true;
  passCb = null;
  if (passTask) { try { passTask.destroy(); } catch (_) {} }
  if (!st.doc) $('pdf-start').hidden = false;
});

async function loadDoc(bytes) {
  const L = await lib();
  const task = L.core.getDocument(docArgs(bytes));
  passTask = task;
  st.locked = false;
  task.onPassword = (update, reason) => askPassword(update, reason);
  const doc = await task.promise;
  $('pdf-pass').hidden = true;
  passCb = null;
  return doc;
}

async function openFiles(files, toPages) {
  const list = Array.from(files || []).filter(isPdf);
  if (!list.length) { if (files && files.length) toast(C.not_pdf); return; }
  const first = list[0];
  const ok = await openBytes(new Uint8Array(await first.arrayBuffer()), first.name || 'document.pdf', { fresh: true });
  if (!ok) return;
  if (list.length > 1 || toPages) {
    await setMode('pages');
    for (const f of list.slice(1)) await addSource(f);
  }
}

async function openBytes(bytes, name, opts) {
  const o = opts || {};
  say(st.core ? C.opening : C.loading);
  let doc;
  try {
    doc = await loadDoc(bytes);
  } catch (e) {
    $('pdf-pass').hidden = true;
    if (!st.doc) { $('pdf-start').hidden = false; $('pdf-app').hidden = true; }
    if (!st.core) say(navigator.onLine === false ? C.offline_first : C.load_failed);
