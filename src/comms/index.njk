const sentByMe = (m) => (m.sfp2 ? m.sfp2 === myFp : !!m.sfp && (m.sfp === myFp || m.sfp === myLegacyFp));
const sentBy = (m, c) => (m.sfp2 ? m.sfp2 === c.fp : !!m.sfp && (m.sfp === c.fp || m.sfp === legacyFps.get(c.fp)));

const renderRemoteChat = (item, opts = {}) => {
  if (sentByMe(item)) {
    renderLine('you', item.text, { me: true, quiet: true, ts: item.ts });
    return;
  }
  let who = displayName(item.senderId);
  if (currentDmContact && sentBy(item, currentDmContact)) who = currentDmContact.name || who;
  renderLine(who, item.text, { peerId: item.senderId, quiet: !!opts.silent, ts: item.ts });
  if (!opts.silent) {
    playPing(880);
    const target = notifTargetNow();
    notifyLocal({ tag: target.tag, title: who, body: item.text, url: target.url });
  }
};

const packChatPlain = (text, extra) => JSON.stringify(Object.assign({ v: 2, t: text, sfp: myLegacyFp || undefined, sfp2: (myFp && myFp !== myLegacyFp) ? myFp : undefined }, extra || {}));
const unpackChatPlain = (raw) => {
  try {
    const o = JSON.parse(raw);
    if (o && o.v === 2 && typeof o.t === 'string') {
      return { text: o.t, sfp: typeof o.sfp === 'string' ? o.sfp : null, sfp2: typeof o.sfp2 === 'string' ? o.sfp2 : null, ctl: (o.ctl && typeof o.ctl === 'object') ? o.ctl : null };
    }
  } catch (_) {}
  return { text: raw, sfp: null, sfp2: null, ctl: null };
};

const handleNostrMsg = async (msgEvent) => {
  let msg;
  try { msg = JSON.parse(msgEvent.data); } catch { return; }
  if (!Array.isArray(msg)) return;
  if (msg[0] === 'EVENT' && msg[1] === chatSubId && msg[2]) {
    const ev = msg[2];
    let content;
    try { content = JSON.parse(ev.content); } catch { return; }
    if (!content || !content.cmid || !content.enc || !chatKey || seenCmids.has(content.cmid)) return;
    let text, sfp = null, sfp2 = null;
    try {
      const unpacked = unpackChatPlain(await decryptText(chatKey, content.enc));
      text = unpacked.text;
      sfp = unpacked.sfp;
      sfp2 = unpacked.sfp2;
      if (unpacked.ctl) { seenCmids.add(content.cmid); handleRoomCtl(unpacked.ctl, sfp); return; }
    } catch { return; }
    seenCmids.add(content.cmid);
    const senderId = (content.cmid.split(':')[0]) || ev.pubkey;
    const evTs = (ev.created_at || 0) * 1000;
    let ts = (typeof content.ts === 'number' && content.ts > 0) ? content.ts : evTs;
    if (evTs > 0 && Math.abs(ts - evTs) > 120000) ts = evTs;
    const item = { senderId, text, ts, sfp, sfp2 };
    renderRemoteChat(item, { silent: ts < roomJoinedAt - 2000 });
  }
};

const closeChatSub = () => {
  if (!chatSubId) return;
  const closeMsg = JSON.stringify(['CLOSE', chatSubId]);
  const sockets = getRelaySockets() || {};
  for (const ws of Object.values(sockets)) {
    try { ws.send(closeMsg); } catch {}
  }
};

const setupChatPersistence = async (roomName, topic) => {
  chatTopic = topic || null;
  chatPersist = !!(chatTopic && chatKey);
  seenCmids = new Set();

  if (!chatPersist) {
    chatSubId = null;
    sysTop(chatKey ? T.log.eph_key : T.log.eph_nokey);
    return;
  }

  chatSubId = 'mc-' + Math.random().toString(36).slice(2);

  const deadline = Date.now() + 8000;
  let openSockets = [];
  while (Date.now() < deadline) {
    const socketsMap = getRelaySockets() || {};
    openSockets = Object.values(socketsMap).filter(ws => ws && ws.readyState === 1);
    if (openSockets.length > 0) break;
    await new Promise(r => setTimeout(r, 200));
  }
  if (!openSockets.length) {
    sys(T.log.relay_down);
    return;
  }

  const sinceSec = Math.floor(Date.now() / 1000) - HISTORY_LOOKBACK_SEC;
  const req = JSON.stringify(['REQ', chatSubId, {
    kinds: [CHAT_KIND],
    '#x': [chatTopic],
    since: sinceSec,
    limit: HISTORY_LIMIT
  }]);

  for (const ws of openSockets) {
    try {
      if (!socketListenersAttached.has(ws)) {
        ws.addEventListener('message', handleNostrMsg);
        socketListenersAttached.add(ws);
      }
      ws.send(req);
    } catch (err) {
      console.warn('chat history setup failed for socket:', err);
    }
  }

};

const rememberSentCmid = (cmid) => {
  if (!currentDmContact || !cmid) return;
