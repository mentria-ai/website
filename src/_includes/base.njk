<!DOCTYPE html>
<html lang="{{ lang | default('en') }}"{% if feedLayout %} class="feed-layout"{% endif %}{% if localeReload %} data-locale-reload{% endif %}>
<head>
    <meta charset="UTF-8">
    <style>@media (prefers-reduced-motion: no-preference) { @view-transition { navigation: auto; } }</style>
    {# Disable user pinch-to-zoom + iOS focus auto-zoom. The site has
       multi-tap interactions (CLI input, game touch controls, install
       sheet, language switcher) that iOS otherwise hijacks for zoom
       gestures. maximum-scale=1.0 + user-scalable=no together cover the
       older iOS versions that occasionally ignore one or the other.
       The CSS also forces 16px on inputs to prevent the focus-zoom
       that fires even when scaling is locked. #}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta http-equiv="origin-trial" content="AvrrtV9qfu43567NDhfTp/wlKgPoCTk66lxx5aB8pgWBholGgP+VKLTWt/60cXLHNH9JlbDBJsUgEHTXF1OE/A0AAABKeyJvcmlnaW4iOiJodHRwczovL21lbnRyaWEuYWk6NDQzIiwiZmVhdHVyZSI6IldlYk1DUCIsImV4cGlyeSI6MTc5NDg3MzYwMH0=">
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.mentria.ai https://mentria-ai.github.io; media-src 'self' blob: https://cdn.mentria.ai https://mentria-ai.github.io; font-src 'self'; connect-src 'self' blob: data: http://localhost:* http://127.0.0.1:* https://cdn.mentria.ai https://mentria-ai.github.io https://huggingface.co https://*.huggingface.co https://*.hf.co https://relay.mentria.ai wss://relay.mentria.ai; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'">
    {%- if usesThree %}
    <script type="importmap">{"imports":{"three":"/assets/vendor/three-0.186.0/build/three.module.min.js","three/addons/":"/assets/vendor/three-0.186.0/examples/jsm/","/assets/vendor/three-0.186.0/build/three.core.js":"/assets/vendor/three-0.186.0/build/three.core.min.js"}}</script>
    {%- endif %}
    <script type="speculationrules">
      { "prefetch": [{ "source": "document", "where": { "href_matches": "/*" }, "eagerness": "moderate" }] }
    </script>
    <script>
      window.MENTRIA_PAGE_LOCALIZED = {{ 'true' if ((locale or pair) and not notFound) else 'false' }};
      window.MENTRIA_EN_ONLY = {{ englishOnlyUrls | dump | safe }};
      window.MENTRIA_LOCALES = [
        {%- for loc in locales -%}
        { code: {{ loc.code | dump | safe }}, prefix: {{ loc.pathPrefix | dump | safe }}, name: {{ loc.nativeName | dump | safe }}, isDefault: {{ loc.isDefault | dump | safe }}, dict: "/assets/i18n/{{ loc.code }}.json?v={{ buildHash }}", palette: "/assets/js/site-palette.{{ loc.code | lower }}.js?v={{ buildHash }}" }{% if not loop.last %},{% endif %}
        {%- endfor -%}
      ];
    </script>
    <script>
      window.addEventListener('dragover', function (e) { e.preventDefault(); });
      window.addEventListener('drop', function (e) { e.preventDefault(); });
    </script>
    <script>
      (function () {
        var standalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone;
        if (standalone) document.documentElement.classList.add('is-standalone');
        var seen = null;
        try { seen = localStorage.getItem('mentria_seen'); } catch (e) {}
        if (seen || standalone) document.documentElement.classList.add('app-chrome');
        try { localStorage.setItem('mentria_seen', '1'); } catch (e) {}
      })();
    </script>
    {%- if content | contains('terminal-frame--fullscreen') %}
    <script>
      (function () {
        var m = (location.pathname || '').match(/\/tools\/([^/]+)\//);
        if (!m) return;
        var pref = null;
        try { pref = localStorage.getItem('mentria.store.ui.fullscreen.' + m[1]); } catch (e) {}
        if (pref !== 'false') document.documentElement.classList.add('is-fullscreen-tool');
      })();
    </script>
    {%- endif %}
    <script>
      (function () {
        try {
          var locales = window.MENTRIA_LOCALES || [];
          var path = location.pathname || '/';
          var rest = (location.search || '') + (location.hash || '');
          function localeOfPath(p) {
            for (var i = 0; i < locales.length; i++) {
              var pre = locales[i].prefix;
              if (pre && (p === pre || p.indexOf(pre + '/') === 0)) return locales[i];
            }
            return null;
          }
          function localeOfCode(c) {
            for (var i = 0; i < locales.length; i++) { if (locales[i].code === c) return locales[i]; }
            return null;
          }
          function go(loc) { location.replace(loc.prefix + (path === '/' ? '/' : path) + rest); }
          var current = localeOfPath(path);
          if (current && window.MENTRIA_EN_ONLY && window.MENTRIA_EN_ONLY.indexOf(path.slice(current.prefix.length) || '/') >= 0) {
            location.replace((path.slice(current.prefix.length) || '/') + rest);
            return;
          }
          if (!window.MENTRIA_PAGE_LOCALIZED && !current) return;

          var pref = null;
          try { pref = localStorage.getItem('mentria_lang'); } catch (_) {}
          if (pref) {
            var target = localeOfCode(pref);
            if (target && target.prefix && !current) go(target);
            return;
          }

          var FLAG = 'mentria_lang_redirected_at';
          if (localStorage.getItem(FLAG) || current) return;
          var bl = (navigator.language || 'en').toLowerCase();
          for (var j = 0; j < locales.length; j++) {
            if (!locales[j].prefix) continue;
            var code = locales[j].code.toLowerCase();
            var base = code.split('-')[0];
            if (bl === code || bl === base || bl.indexOf(base + '-') === 0) {
              try {
                localStorage.setItem(FLAG, String(Date.now()));
                localStorage.setItem('mentria_lang', locales[j].code);
              } catch (_) {}
              go(locales[j]);
              return;
            }
          }
        } catch (_) { /* ignore */ }
      })();
    </script>
    {% set baseUrl = site.siteUrl | default('/') %}
    {% set pageUrl = baseUrl ~ page.url %}
    {% set metaTitle = ((title and (title ~ " | " ~ site.title)) or ("site.metaTitle" | t)) | htmlDecode %}
    {% set metaDescription = (description | default(("site.metaDescription" | t))) | htmlDecode %}
    {% set socialImage = socialImageOverride or (site.siteUrl ~ (site.socialImage | default('/assets/img/icon-512x512.png'))) %}
    {% set isPost = tags and ('post' in tags) %}
    {% set ogLocales = { 'en': 'en_US', 'es': 'es_ES', 'fr': 'fr_FR', 'ja': 'ja_JP', 'pt-BR': 'pt_BR' } %}
    <title>{{ metaTitle }}</title>
    <meta name="description" content="{{ metaDescription }}">
    <meta name="keywords" content="{{ site.keywords }}">
    <meta name="robots" content="{{ robots or (site.robots | default('index, follow')) }}">
    <meta name="author" content="{{ site.author }}">
    <meta name="theme-color" content="#0a0a0a">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

    <meta property="og:type" content="{{ 'article' if isPost else 'website' }}">
    <meta property="og:url" content="{{ pageUrl }}">
    <meta property="og:title" content="{{ metaTitle }}">
    <meta property="og:description" content="{{ metaDescription }}">
    <meta property="og:image" content="{{ socialImage }}">
    {%- if not socialImageOverride %}
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ 'site.socialImageAlt' | t }}">
    {%- endif %}
    <meta property="og:locale" content="{{ ogLocales[lang | default('en')] or 'en_US' }}">
    {%- if not isPost and not englishOnly %}
    {%- for loc in locales %}{% if loc.code != (lang | default('en')) %}
    <meta property="og:locale:alternate" content="{{ ogLocales[loc.code] }}">
    {%- endif %}{% endfor %}
    {%- endif %}
    {%- if isPost %}
    <meta property="article:published_time" content="{{ page.date | isoDate }}">
    <meta property="article:author" content="{{ site.author }}">
    {%- endif %}

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="{{ pageUrl }}">
    <meta name="twitter:title" content="{{ metaTitle }}">
    <meta name="twitter:description" content="{{ metaDescription }}">
    <meta name="twitter:image" content="{{ socialImage }}">

    {%- if 'noindex' not in (robots or '') %}
    <link rel="canonical" href="{{ pageUrl }}">
    {%- endif %}
    <link rel="icon" href="/assets/img/favicon-96x96.png" type="image/png">
    <link rel="apple-touch-icon" href="/assets/img/icon-192x192.png">

    {#- Reciprocal hreflang matrix — one alternate per supported locale -#}
    {%- if not isPost and not englishOnly %}
    {%- for loc in locales %}
    <link rel="alternate" hreflang="{{ loc.code }}" href="{{ site.siteUrl }}{{ page.url | switchLocale(loc.code) }}">
    {%- endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ site.siteUrl }}{{ page.url | switchLocale('en') }}">
    {%- endif %}

    {%- if feedLayout %}
    <link rel="preconnect" href="https://cdn.mentria.ai" crossorigin>
    {%- endif %}
    <link rel="preload" href="/assets/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/jbm-latin.woff2"   as="font" type="font/woff2" crossorigin>

    <link rel="stylesheet" href="/assets/css/style.css?v={{ buildHash }}">
    <link rel="stylesheet" href="/assets/css/mentria-ui.css?v={{ buildHash }}">
    <link rel="stylesheet" href="/assets/css/mentria-palette.css?v={{ buildHash }}">
    <link rel="stylesheet" href="/assets/css/terminal.css?v={{ buildHash }}">
    <link rel="manifest" href="/manifest.json">

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "{{ site.siteUrl }}/#organization",
          "name": "{{ site.title }}",
          "url": "{{ site.siteUrl }}",
          "logo": {
            "@type": "ImageObject",
            "url": "{{ site.siteUrl }}/assets/img/icon-512x512.png",
            "width": 512,
            "height": 512
          },
          "sameAs": [
            "https://github.com/mentria-ai",
            "https://huggingface.co/mentriaai",
            "https://x.com/mentria_ai"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "{{ site.siteUrl }}/#website",
          "url": "{{ site.siteUrl }}",
          "name": "{{ site.title }}",
          "description": {{ ('site.metaDescription' | traw) | dump | safe }},
          "publisher": { "@id": "{{ site.siteUrl }}/#organization" },
          "inLanguage": "{{ lang | default('en') }}"
        }
      ]
    }
    </script>

    {%- set localePrefix = ((locale or pair.locale).pathPrefix | default("")) -%}
    {%- set siteCode = ((lang or "en") | lower) if (((lang or "en") | lower) in ["en", "es", "fr", "ja", "pt-br"]) else "en" -%}
    {%- set isHomePage = (page.url == "/" or page.url == localePrefix + "/") -%}
    {%- set inTools = page.url | startsWith(localePrefix + "/tools/") -%}
    {%- set isToolIndex = (page.url == localePrefix + "/tools/") -%}
    {%- set inFeed = page.url | startsWith(localePrefix + "/feed/") -%}
    {%- set inLearn = page.url | startsWith(localePrefix + "/learn/") -%}
    {%- set isLearnIndex = (page.url == localePrefix + "/learn/") -%}
    {%- set inExtensions = page.url | startsWith(localePrefix + "/extensions/") -%}
    {%- set isExtensionIndex = (page.url == localePrefix + "/extensions/") -%}
    {%- set isPost = tags and ("post" in tags) -%}
    {%- set plainTitle = (title or "") | htmlDecode | striptags -%}
    {%- if not isHomePage and (inTools or inFeed or inLearn or inExtensions) %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ ("nav.home" | traw) | dump | safe }}, "item": "{{ site.siteUrl }}{{ localePrefix }}/" }
        {%- if inTools %},
        { "@type": "ListItem", "position": 2, "name": {{ ("nav.tools" | traw) | dump | safe }}, "item": "{{ site.siteUrl }}{{ localePrefix }}/tools/" }
        {%- if not isToolIndex %},
        { "@type": "ListItem", "position": 3, "name": {{ plainTitle | dump | safe }}, "item": "{{ pageUrl }}" }
        {%- endif %}
        {%- elif inFeed or inLearn %},
        { "@type": "ListItem", "position": 2, "name": {{ ("learn.title" | traw) | dump | safe }}, "item": "{{ site.siteUrl }}{{ localePrefix }}/learn/" }
        {%- if not isLearnIndex %},
        { "@type": "ListItem", "position": 3, "name": {{ plainTitle | dump | safe }}, "item": "{{ pageUrl }}" }
        {%- endif %}
        {%- else %},
        { "@type": "ListItem", "position": 2, "name": {{ ("home.launcher.extensions" | traw) | dump | safe }}, "item": "{{ site.siteUrl }}{{ localePrefix }}/extensions/" }
        {%- if not isExtensionIndex %},
        { "@type": "ListItem", "position": 3, "name": {{ ((pair.ext.name or title) | htmlDecode | striptags) | dump | safe }}, "item": "{{ pageUrl }}" }
        {%- endif %}
        {%- endif %}
      ]
    }
    </script>
    {%- endif %}

    {%- if isPost %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "mainEntityOfPage": { "@type": "WebPage", "@id": "{{ pageUrl }}" },
      "headline": {{ plainTitle | dump | safe }},
      "description": {{ ((description or "") | htmlDecode | striptags) | dump | safe }},
      {%- if cover %}
      "image": "{{ site.siteUrl }}{{ cover }}",
      {%- else %}
      "image": "{{ socialImage }}",
      {%- endif %}
      "datePublished": "{{ page.date.toISOString() }}",
      "dateModified": "{{ page.date.toISOString() }}",
      "author": { "@type": "Organization", "@id": "{{ site.siteUrl }}/#organization" },
      "publisher": { "@id": "{{ site.siteUrl }}/#organization" },
      "inLanguage": "{{ lang | default('en') }}"
    }
    </script>
    {%- endif %}
</head>
<body class="scanlines">
    <script src="/assets/js/mentria-store.js?v={{ buildHash }}"></script>
    <script>
      (function () {
        function init() {
        var ring = document.querySelector('[data-week-ring]');
        if (!ring || !window.MentriaStore) return;
        var segs = ring.querySelectorAll('.week-ring__seg');
        function pad(n) { return (n < 10 ? '0' : '') + n; }
        function key(d) { return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); }
        function paint() {
          var days = window.MentriaStore.get('packs', 'days') || {};
          var d = new Date(), today = key(d), n = 0;
          var start = new Date(d.getFullYear(), d.getMonth(), d.getDate());
          start.setDate(start.getDate() - ((start.getDay() + 6) % 7));
          for (var i = 0; i < 7 && i < segs.length; i++) {
            var x = new Date(start.getFullYear(), start.getMonth(), start.getDate() + i);
            var k = key(x), on = !!days[k];
            if (on) n++;
            segs[i].classList.toggle('is-on', on);
            segs[i].classList.toggle('is-today', k === today);
          }
          var labelN = ring.getAttribute('data-label-n') || '';
          if (labelN) { var l = labelN.split('{n}').join(String(n)); ring.setAttribute('aria-label', l); ring.setAttribute('title', l); }
          clearTimeout(tipTimer);
          if (n) tipTimer = setTimeout(function () { explain(n); }, 1500);
        }
        var tipTimer = 0;
        function explain(n) {
          var tip = ring.getAttribute('data-toast');
          if (!tip || !window.MentriaUI || ring.offsetParent === null || window.MentriaStore.get('ui', 'week_ring_told')) return;
          var r = ring.getBoundingClientRect();
          if (!r.width || r.bottom <= 0 || r.top >= innerHeight) return;
          var hit = document.elementFromPoint(r.left + r.width / 2, r.top + r.height / 2);
          if (!hit || !ring.contains(hit)) return;
          window.MentriaStore.set('ui', 'week_ring_told', true);
          window.MentriaUI.toast(tip.split('{n}').join(String(n)), { duration: 6000 });
        }
        paint();
        window.addEventListener('mentria:write', paint);
        document.addEventListener('mentria:localechange', paint);
        window.addEventListener('pageshow', function (e) { if (e.persisted) paint(); });
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
      })();
    </script>
    <script src="/assets/js/mentria-caps.js?v={{ buildHash }}"></script>
    <script src="/assets/js/mentria-ui.js?v={{ buildHash }}"></script>
    <script src="/assets/js/mentria-backup.js?v={{ buildHash }}" defer></script>
    <script src="/assets/js/mentria-gamepad.js?v={{ buildHash }}" defer></script>
    <script src="/assets/js/mentria-push-db.js?v={{ buildHash }}"></script>
    <script src="/assets/js/mentria-push.js?v={{ buildHash }}"></script>
    <script src="/assets/js/mentria-comms-nav.js?v={{ buildHash }}" defer></script>
    <script src="/assets/js/mentria-input-help.js?v={{ buildHash }}" defer></script>
    <script>if (document.modelContext && document.modelContext.registerTool) { import('/assets/js/mentria-webmcp.js?v={{ buildHash }}'); }</script>
    <script src="/assets/js/site-palette.{{ siteCode }}.js?v={{ buildHash }}"></script>
    <script src="/assets/js/mentria-palette.js?v={{ buildHash }}" defer></script>
    {% include "header.njk" %}

    <script>
      (function () {
        var el = document.getElementById('m-offline');
        if (!el) return;
        function sync() {
          var off = navigator.onLine === false;
          el.hidden = !off;
          document.documentElement.classList.toggle('is-offline', off);
        }
        window.addEventListener('online', sync);
        window.addEventListener('offline', sync);
        sync();
      })();
    </script>
    <main id="main-content" tabindex="-1">
        {{ content | safe }}
    </main>

    {% if not deckLayout %}
    <div class="tools-popup" id="tools-popup" hidden role="dialog" aria-modal="true" aria-label="{{ 'nav.tools' | t }}">
      <div class="tools-popup__scrim" data-tools-close></div>
      <div class="tools-popup__panel" tabindex="-1">
        <div class="tools-popup__bar">
          <label class="tools-popup__find">
            <svg class="tools-popup__find-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="20" y1="20" x2="16.2" y2="16.2"/></svg>
            <input type="search" id="tools-find" class="tools-popup__input" placeholder="{{ 'tools_page.search_placeholder' | t }}" aria-label="{{ 'tools_page.search_label' | t }}" data-i18na="placeholder=tools_page.search_placeholder;aria-label=tools_page.search_label" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="go">
          </label>
          <button type="button" class="tools-popup__close" data-tools-close aria-label="{{ 'common.close' | t }}" title="{{ 'common.close' | t }}" data-i18na="aria-label=common.close;title=common.close"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
        </div>
        <div class="tools-popup__body"></div>
      </div>
    </div>
    <nav class="app-bar" aria-label="{{ 'palette.app_bar' | t }}">
      <a class="app-bar__item" href="{{ localePrefix }}/"{% if isHomePage %} aria-current="page"{% endif %}>
        <svg class="app-bar__i" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 11.3 12 4.2l8.5 7.1V19a1.2 1.2 0 0 1-1.2 1.2h-4.6v-5.6H9.3v5.6H4.7A1.2 1.2 0 0 1 3.5 19z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
        <span class="app-bar__t">{{ 'nav.home' | t }}</span>
      </a>
      <a class="app-bar__item" href="{{ localePrefix }}/learn/"{% if inFeed or inLearn %} aria-current="page"{% endif %}>
        <svg class="app-bar__i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 6.6c-1.7-1.4-4.1-1.9-7.6-1.6v13.2c3.5-.3 5.9.2 7.6 1.6 1.7-1.4 4.1-1.9 7.6-1.6V5c-3.5-.3-5.9.2-7.6 1.6zM12 6.6v13.2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
        <span class="app-bar__t">{{ 'learn.title' | t }}</span>
      </a>
      <a class="app-bar__item app-bar__item--tools" href="{{ localePrefix }}/tools/" data-tools-open{% if isToolIndex %} aria-current="page"{% endif %}>
        <svg class="app-bar__i" viewBox="0 0 24 24" aria-hidden="true"><path d="M14.8 3.6a5.2 5.2 0 0 0-5.8 7l-5.4 5.4a1.6 1.6 0 0 0 0 2.3l1.1 1.1a1.6 1.6 0 0 0 2.3 0l5.4-5.4a5.2 5.2 0 0 0 7-5.8l-3 3-2.6-.7-.7-2.6z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
        <span class="app-bar__t">{{ 'nav.tools' | t }}</span>
      </a>
      <a class="app-bar__item app-bar__item--comms" href="/comms/" data-comms-link{% if page.url | startsWith('/comms/') %} aria-current="page"{% endif %}>
        <span class="app-bar__icwrap">
          <svg class="app-bar__i" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.6 4.8h14.8a1.4 1.4 0 0 1 1.4 1.4v8.6a1.4 1.4 0 0 1-1.4 1.4H9.4l-5.2 3.8V6.2a1.4 1.4 0 0 1 1.4-1.4z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
          <span class="nav-badge" data-comms-badge hidden>0</span>
        </span>
        <span class="app-bar__t">{{ 'nav.comms' | t }}</span>
      </a>
      <button type="button" class="app-bar__item" data-palette-open>
        <svg class="app-bar__i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="m15.5 15.5 4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        <span class="app-bar__t">{{ 'nav.search' | t }}</span>
      </button>
    </nav>
    {% endif %}

    {% include "pwa-install.njk" %}

    <div id="m-dialog" popover="manual" class="m-dialog" role="alertdialog" aria-modal="true" aria-labelledby="m-dialog-msg">
      <p class="m-dialog__msg" id="m-dialog-msg"></p>
      <div class="m-dialog__actions">
        <button type="button" class="m-dialog__btn m-dialog__btn--ghost" id="m-dialog-cancel">{{ "common.dialog.cancel" | t }}</button>
        <button type="button" class="m-dialog__btn m-dialog__btn--primary" id="m-dialog-ok">{{ "common.dialog.ok" | t }}</button>
      </div>
