  async function pinAdapter(entry) {
    if (pinning || !engine || typeof engine.swapAdapter !== 'function') return;
    if ((entry && pinned && pinned.name === entry.name) || (!entry && !pinned)) return;
    pinning = true;
    adaptersNote.textContent = entry ? COPY.adaptersLoading.replace('{name}', entry.title || entry.name) : '';
    try {
      if (entry && entry.system_sha256 && typeof entry.system === 'string') {
        const digest = await sha256Hex(entry.system);
        if (digest !== String(entry.system_sha256).toLowerCase()) throw new Error(COPY.adaptersSha);
      }
      if (generating) stopGeneration();
      const outgoing = pinned;
      if (searchAdapterActive) { await engine.swapAdapter({ name: null }); searchAdapterActive = false; }
      if (outgoing) {
        await engine.swapAdapter({ name: null });
        if (outgoing.name !== SEARCH_ADAPTER.name && pinnedLoaded.has(outgoing.name)) {
          try { await engine.unloadAdapter(outgoing.name); } catch (_) {}
          pinnedLoaded.delete(outgoing.name);
        }
      }
      if (entry) {
        const base = adapterBase();
        const path = String(entry.path).replace(/\/?$/, '/');
        const spec = pinnedLoaded.has(entry.name)
          ? { name: entry.name }
          : { name: entry.name, configUrl: base + path + 'adapter_config.json', weightsUrl: base + path + 'adapter_model.safetensors' };
        await engine.swapAdapter(spec);
        pinnedLoaded.add(entry.name);
      }
      pinned = entry;
      if (prefixCache) prefixCache.invalidate();
      systemMessage.content = pinned && typeof pinned.system === 'string' && pinned.system ? pinned.system : systemPromptFor(currentTier);
      clearConversation();
      webSearchOn = false;
      syncSearchToggle();
      syncThinkToggle();
      syncAdapterChip();
      if (pinned && window.MentriaUI) MentriaUI.toast(COPY.adaptersPinned.replace('{name}', pinned.title || pinned.name));
      pinning = false;
      closeAdapters();
    } catch (err) {
      pinning = false;
      const msg = COPY.adaptersFailed.replace('{name}', entry ? (entry.title || entry.name) : COPY.adaptersBase).replace('{err}', String(err && err.message || err));
      renderAdapters().then(() => { adaptersNote.textContent = msg; });
      console.warn('adapter pin failed:', err);
    }
  }

