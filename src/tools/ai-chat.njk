---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/tools/ai-chat/index.html"
eleventyComputed:
  lang: "{{ locale.code }}"
  title: "{{ 'tools.ai-chat.title' | t }}"
  description: "{{ 'tools.ai-chat.lede' | t }}"
---
<section class="hero" style="padding-top:1rem;">
  <p class="eyebrow eyebrow--crumbs"><a class="eyebrow__link" href="{{ locale.pathPrefix }}/">~</a><span class="eyebrow__sep">/</span><a class="eyebrow__link" href="{{ locale.pathPrefix }}/tools/">tools</a><span class="eyebrow__sep">/</span><span class="eyebrow__current">ai-chat</span></p>
  <h1>{{ "tools.ai-chat.title" | t }}</h1>
  <p>{{ "tools.ai-chat.lede" | t }}</p>
  {% include "tldr.njk" %}
</section>

{% set terminalTitle = "ai-chat.js" %}
{% include "terminal-frame-open.njk" %}
<section class="ac">
  <div class="ac__status" id="ac-status">
    <span class="ac__status-dot" id="ac-status-dot"></span>
    <span class="ac__status-text" id="ac-status-text" role="status" aria-live="polite">{{ "tool.ai-chat.status_checking_webgpu" | t }}</span>
    <select class="ac__tier" id="ac-tier" aria-label="{{ 'tool.ai-chat.tier_label' | t }}" hidden></select>
    <button class="ac__delete-btn" id="ac-clear-chat" title="{{ 'tool.ai-chat.btn_new_chat' | t }}" style="display:none;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      <span>{{ "tool.ai-chat.btn_new_chat" | t }}</span>
    </button>
    <button class="ac__delete-btn" id="ac-delete-model" title="{{ 'tool.ai-chat.btn_delete_model_title' | t }}" style="display:none;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
      <span>{{ "tool.ai-chat.btn_delete_model" | t }}</span>
    </button>
  </div>

  <div class="ac__progress-wrap" id="ac-progress-wrap" style="display:none;">
    <div class="ac__progress-info">
      <span id="ac-progress-label">{{ "tool.ai-chat.progress_label" | t }}</span>
      <span id="ac-progress-pct">0%</span>
    </div>
    <div class="ac__progress-bar">
      <div class="ac__progress-fill" id="ac-progress-fill"></div>
    </div>
    <div class="ac__progress-detail" id="ac-progress-detail"></div>
  </div>

  <div class="ac__messages" id="ac-messages">
    <div class="ac__empty" id="ac-empty">
      <div class="ac__empty-icon">&#9670;</div>
      <p>{{ "tool.ai-chat.empty_msg" | t }}</p>
      <p class="ac__empty-sub">{{ "tool.ai-chat.empty_sub" | t }}</p>
    </div>
  </div>

  <div class="ac__img-preview" id="ac-img-preview" style="display:none;">
    <img id="ac-img-thumb" alt="{{ 'tool.ai-chat.img_alt_attached' | t }}" />
    <button class="ac__img-remove" id="ac-img-remove" title="{{ 'tool.ai-chat.btn_remove_image' | t }}">&times;</button>
  </div>

  <div class="ac__input-wrap">
    <label class="ac__attach-btn" id="ac-attach-label" title="{{ 'tool.ai-chat.btn_attach_image' | t }}">
      <input type="file" id="ac-file-input" accept="image/*" hidden />
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
    </label>
    <textarea class="ac__input" id="ac-input" rows="1" enterkeyhint="send" placeholder="{{ 'tool.ai-chat.input_placeholder' | t }}" disabled></textarea>
    <button class="ac__send-btn" id="ac-send" title="{{ 'tool.ai-chat.btn_send' | t }}" disabled>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
    </button>
  </div>
</section>
{% include "terminal-frame-close.njk" %}

{% include "tool-schema.njk" %}

<script src="/assets/js/markdown.js?v={{ buildHash }}"></script>

<script type="module">
const COPY = {
  statusLoadingModel:  {{ ("tool.ai-chat.status_loading_model"  | t) | dump | safe }},
  statusGenerating:    {{ ("tool.ai-chat.status_generating"     | t) | dump | safe }},
  statusReady:         {{ ("tool.ai-chat.status_ready"          | t) | dump | safe }},
  statusModelDeleted:  {{ ("tool.ai-chat.status_model_deleted"  | t) | dump | safe }},
  imgAltAttachedShort: {{ ("tool.ai-chat.img_alt_attached_short" | t) | dump | safe }},
  labelYou:            {{ ("tool.ai-chat.label_you"             | t) | dump | safe }},
  errNoWebGpu:         {{ ("tool.ai-chat.err_no_webgpu"         | t) | dump | safe }},
  errUnsupportedMain:  {{ ("tool.ai-chat.err_unsupported_main"  | t) | dump | safe }},
  errUnsupportedSub:   {{ ("tool.ai-chat.err_unsupported_sub"   | t) | dump | safe }},
  errLoadRuntime:      {{ ("tool.ai-chat.err_load_runtime"      | t) | dump | safe }},
  errDeviceLost:       {{ ("tool.ai-chat.err_device_lost"       | t) | dump | safe }},
  errBadImage:         {{ ("tool.ai-chat.err_bad_image"         | t) | dump | safe }},
  errLoadPrefix:       {{ ("tool.ai-chat.err_load_prefix"       | t) | dump | safe }},
  errContextFull:      {{ ("tool.ai-chat.err_context_full"      | t) | dump | safe }},
  errPrefix:           {{ ("tool.ai-chat.err_prefix"            | t) | dump | safe }},
  errDeletePrefix:     {{ ("tool.ai-chat.err_delete_prefix"     | t) | dump | safe }},
  emptyResponse:       {{ ("tool.ai-chat.empty_response"        | t) | dump | safe }},
  confirmDelete:       {{ ("tool.ai-chat.confirm_delete"        | t) | dump | safe }},
  downloadPostponed:   {{ ("common.download_postponed"          | t) | dump | safe }},
  tierLabel:           {{ ("tool.ai-chat.tier_label"            | t) | dump | safe }},
  tierFast:            {{ ("tool.ai-chat.tier_fast"             | t) | dump | safe }},
  tierBetter:          {{ ("tool.ai-chat.tier_better"           | t) | dump | safe }},
  tierBest:            {{ ("tool.ai-chat.tier_best"             | t) | dump | safe }},
  tierMax:             {{ ("tool.ai-chat.tier_max"              | t) | dump | safe }},
  emptySub:            {{ ("tool.ai-chat.empty_sub"             | t) | dump | safe }},
  tierConfirm:         {{ ("tool.ai-chat.tier_confirm"          | t) | dump | safe }},
  tierFallback:        {{ ("tool.ai-chat.tier_fallback"         | t) | dump | safe }},
  btnSend:             {{ ("tool.ai-chat.btn_send"              | t) | dump | safe }},
  btnStop:             {{ ("tool.ai-chat.btn_stop"              | t) | dump | safe }},
  btnCopy:             {{ ("tool.ai-chat.btn_copy"              | t) | dump | safe }},
  copied:              {{ ("tool.ai-chat.copied"                | t) | dump | safe }},
  copyFailed:          {{ ("tool.ai-chat.copy_failed"           | t) | dump | safe }},
  btnRegenerate:       {{ ("tool.ai-chat.btn_regenerate"        | t) | dump | safe }},
  stopped:             {{ ("tool.ai-chat.stopped"               | t) | dump | safe }}
};

const MENTRIA_DIST_BASE  = '/assets/mentria/dist/';
const MENTRIA_TIERS_PATH = '/assets/js/mentria-tiers.js';

const IS_IOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
const IMG_MAX = IS_IOS ? 256 : 448;
const MAX_TOKENS = 512;

/* ── Status helpers ────────────────────────────────────────────────────── */
const statusDot  = document.getElementById('ac-status-dot');
const statusText = document.getElementById('ac-status-text');
function setStatus(state, text) {
  statusDot.className = 'ac__status-dot ac__status-dot--' + state;
  statusText.textContent = text;
}

/* ── WebGPU gate ───────────────────────────────────────────────────────── */
// Mentria is WebGPU-only by design. If the browser doesn't expose WebGPU,
// surface a clean error rather than silently degrading. Common cases:
//   - Safari < 26 (no WebGPU)
//   - Firefox stable (WebGPU still in nightly as of 2026-04)
//   - Chrome on Linux without `--enable-features=Vulkan`
//   - Mobile browsers without WebGPU yet
function showUnsupportedError(reason) {
  setStatus('error', reason);
  const messagesEl = document.getElementById('ac-messages');
  const emptyEl    = document.getElementById('ac-empty');
  if (emptyEl) {
    const escSub = COPY.errUnsupportedSub.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    emptyEl.innerHTML =
      '<div class="ac__empty-icon">&#9888;</div>' +
      '<p>' + COPY.errUnsupportedMain + '</p>' +
      '<p class="ac__empty-sub">' + escSub + '</p>';
  }
  document.getElementById('ac-input').disabled = true;
  document.getElementById('ac-send').disabled  = true;
  document.getElementById('ac-attach-label').style.display = 'none';
}

if (!navigator.gpu) {
  showUnsupportedError(COPY.errNoWebGpu);
} else {
  let MentriaEngine, Tiers;
  try {
    ({ MentriaEngine } = await import(MENTRIA_DIST_BASE + 'mentria.mjs'));
    Tiers = await import(MENTRIA_TIERS_PATH);
  } catch (err) {
    console.error('Failed to load mentria-engine bundle:', err);
    showUnsupportedError(COPY.errLoadRuntime);
  }
  if (MentriaEngine && Tiers) runApp(MentriaEngine, Tiers);
}

function runApp(MentriaEngine, Tiers) {
  /* ── DOM refs ────────────────────────────────────── */
  const tierSel       = document.getElementById('ac-tier');
  const deleteBtn     = document.getElementById('ac-delete-model');
  const clearChatBtn  = document.getElementById('ac-clear-chat');
  const progressWrap  = document.getElementById('ac-progress-wrap');
  const progressLabel = document.getElementById('ac-progress-label');
  const progressPct   = document.getElementById('ac-progress-pct');
  const progressFill  = document.getElementById('ac-progress-fill');
  const progressDetail= document.getElementById('ac-progress-detail');
  const messagesEl    = document.getElementById('ac-messages');
  const emptyEl       = document.getElementById('ac-empty');
  const imgPreview    = document.getElementById('ac-img-preview');
  const imgThumb      = document.getElementById('ac-img-thumb');
  const imgRemoveBtn  = document.getElementById('ac-img-remove');
  const fileInput     = document.getElementById('ac-file-input');
  const inputEl       = document.getElementById('ac-input');
  const sendBtn       = document.getElementById('ac-send');

  /* ── State ───────────────────────────────────────── */
  let engine = null;
  let generating = false;
  let abortCtrl = null;
  let genEpoch = 0;
  let attachedImage = null;       // {rgbHwc, h, w} — pending attach for the NEXT send
  let attachedDataUrl = null;
  // conversationImages keeps every image sent in this conversation, in order.
  // The chat template re-renders the full message history every turn, so each
  // {type:'image'} placeholder needs its corresponding rgbHwc on every call —
  // not just the turn the image was first attached on.
  let conversationImages = [];
  let messages = [
    { role: 'system', content:
      "You are the Mentria AI assistant. You run Qwen3.5 locally in the user's browser via WebGPU. Your weights were fine-tuned and shipped by mentria.ai.\n\n" +
      "When the user asks who you are or what model you run: identify as the Mentria AI assistant, running Qwen3.5 in their browser. When asked about Mentria itself: it is a small privacy-first creative studio at mentria.ai, building tools, games, and AI experiences that run entirely client-side with no servers, no accounts, and no telemetry. Notable parts of the site: TOTP, quick notes, QR scanner, color picker, Tetris, Breakout, Minesweeper, an infinite AI-generated radio, a P2P chat and file drop at /comms/, and a daily image-fact feed called Deep Cuts.\n\n" +
      "Be helpful, accurate, and brief. Don't over-apologize. When the user shares an image, describe what you see directly. You cannot browse the web, run code, call APIs, or remember between sessions; if something is outside your training, say so plainly.\n\n" +
      "Formatting: use markdown sparingly. For tables, output strict GitHub-flavored markdown: one header row, one divider row made only of pipes and dashes, then data rows. Never put prose, notes, parentheticals, or extra characters between the divider and the data rows. Each cell is one short phrase, never a sentence. Any explanation goes outside the table."
    },
  ];

  const systemMessage = messages[0];

  function persistConversation() {
    if (!window.MentriaStore) return;
    const turns = [];
    for (let i = 1; i < messages.length; i++) {
      const m = messages[i];
      if (Array.isArray(m.content)) {
        const txt = m.content.filter(p => p && p.type === 'text').map(p => p.text).join(' ');
        turns.push({ role: m.role, text: txt, img: m.content.some(p => p && p.type === 'image') || undefined });
      } else {
        turns.push({ role: m.role, text: String(m.content || '') });
      }
    }
    const capped = turns.slice(-40);
    if (capped.length) window.MentriaStore.set('ai_chat', 'conversation', capped);
    else window.MentriaStore.remove('ai_chat', 'conversation');
  }

  function clearConversation() {
    genEpoch++;
    if (generating) stopGeneration();
    messages = [systemMessage];
    conversationImages = [];
    if (window.MentriaStore) window.MentriaStore.remove('ai_chat', 'conversation');
    messagesEl.innerHTML = '';
    if (emptyEl) {
      messagesEl.appendChild(emptyEl);
      emptyEl.style.display = '';
    }
    clearChatBtn.style.display = 'none';
  }

  async function restoreConversation() {
    if (!window.MentriaStore) return;
    const saved = window.MentriaStore.get('ai_chat', 'conversation');
    if (!Array.isArray(saved) || !saved.length) return;
    if (window.renderMarkdownReady) { try { await window.renderMarkdownReady; } catch (_) {} }
    saved.forEach((t) => {
      if (!t || (t.role !== 'user' && t.role !== 'assistant') || typeof t.text !== 'string') return;
      if (t.role === 'user') {
        const shown = t.img
          ? (t.text ? t.text + ' [' + COPY.imgAltAttachedShort + ']' : '[' + COPY.imgAltAttachedShort + ']')
          : t.text;
        addMessage('user', shown);
        const engineText = t.img
          ? (t.text || 'Describe this image.') + ' (an image was attached here in an earlier session; it is no longer available)'
          : t.text;
        messages.push({ role: 'user', content: [{ type: 'text', text: engineText }] });
      } else {
        const bodyEl = addMessage('assistant', '');
        if (window.renderMarkdown) bodyEl.innerHTML = renderMarkdown(t.text) || '';
        else bodyEl.textContent = t.text;
        messages.push({ role: 'assistant', content: t.text });
        addAssistantActions(bodyEl, () => t.text);
      }
    });
    clearChatBtn.style.display = '';
    scrollToBottom();
  }

  clearChatBtn.addEventListener('click', clearConversation);
  setTimeout(restoreConversation, 0);

  function scrollToBottom() { messagesEl.scrollTop = messagesEl.scrollHeight; }
  const nativeFieldSizing = CSS.supports('field-sizing', 'content');
  function autoResize() {
    if (nativeFieldSizing) return;
    inputEl.style.height = 'auto';
    inputEl.style.height = Math.min(inputEl.scrollHeight, 120) + 'px';
  }
  function formatBytes(b) {
    if (b < 1024) return b + ' B';
    if (b < 1048576) return (b / 1024).toFixed(1) + ' KB';
    return (b / 1048576).toFixed(1) + ' MB';
  }

  function addMessage(role, content, imageUrl) {
    if (emptyEl) emptyEl.style.display = 'none';
    const bubble = document.createElement('div');
    bubble.className = 'ac__msg ac__msg--' + role;
    const label = document.createElement('div');
    label.className = 'ac__msg-label';
    label.textContent = role === 'user' ? COPY.labelYou : 'qwen-' + ((currentTier && Tiers.TIERS[currentTier]) ? Tiers.TIERS[currentTier].name : '0.8B');
    bubble.appendChild(label);
    if (imageUrl) {
      const img = document.createElement('img');
      img.className = 'ac__msg-img'; img.src = imageUrl; img.alt = COPY.imgAltAttachedShort;
      bubble.appendChild(img);
    }
    const body = document.createElement('div');
    body.className = 'ac__msg-body';
    if (content) body.textContent = content;
    bubble.appendChild(body);
    messagesEl.appendChild(bubble);
    scrollToBottom();
    return body;
  }

  const SEND_SVG = sendBtn.innerHTML;
  const STOP_SVG = '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>';
  const ICON_ATTRS = 'width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';
  const COPY_SVG  = '<svg ' + ICON_ATTRS + '><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
  const CHECK_SVG = '<svg ' + ICON_ATTRS + '><polyline points="20 6 9 17 4 12"/></svg>';
  const FAIL_SVG  = '<svg ' + ICON_ATTRS + '><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
  const REGEN_SVG = '<svg ' + ICON_ATTRS + '><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>';

  function setSendMode(stop) {
    sendBtn.classList.toggle('ac__send-btn--stop', stop);
    sendBtn.innerHTML = stop ? STOP_SVG : SEND_SVG;
    sendBtn.title = stop ? COPY.btnStop : COPY.btnSend;
    deleteBtn.disabled = stop;
    tierSel.disabled = stop;
  }

  function isNearBottom() {
    return messagesEl.scrollHeight - messagesEl.scrollTop - messagesEl.clientHeight < 80;
  }

  function addAssistantActions(bodyEl, getText) {
    const bubble = bodyEl.parentNode;
    const old = bubble.querySelector('.ac__msg-actions');
    if (old) old.remove();
    const row = document.createElement('div');
    row.className = 'ac__msg-actions';
    if (getText) {
      const copyBtn = document.createElement('button');
      copyBtn.type = 'button';
      copyBtn.className = 'ac__msg-action';
      copyBtn.title = COPY.btnCopy;
      copyBtn.setAttribute('aria-label', COPY.btnCopy);
      copyBtn.innerHTML = COPY_SVG;
      let busy = false;
      copyBtn.addEventListener('click', () => {
        if (busy) return;
        busy = true;
        const settle = (svg, cls, label) => {
          copyBtn.innerHTML = svg;
          copyBtn.classList.add(cls);
          copyBtn.title = label;
          setTimeout(() => {
            copyBtn.innerHTML = COPY_SVG;
            copyBtn.classList.remove(cls);
            copyBtn.title = COPY.btnCopy;
            busy = false;
          }, 1200);
        };
        Promise.resolve()
          .then(() => {
            if (!navigator.clipboard || !navigator.clipboard.writeText) throw new Error('no-clipboard');
            return navigator.clipboard.writeText(String(getText()));
          })
          .then(() => settle(CHECK_SVG, 'is-copied', COPY.copied))
          .catch(() => settle(FAIL_SVG, 'is-failed', COPY.copyFailed));
      });
      row.appendChild(copyBtn);
    }
    messagesEl.querySelectorAll('.ac__msg-regen').forEach(b => b.remove());
    const regenBtn = document.createElement('button');
    regenBtn.type = 'button';
    regenBtn.className = 'ac__msg-action ac__msg-regen';
    regenBtn.title = COPY.btnRegenerate;
    regenBtn.setAttribute('aria-label', COPY.btnRegenerate);
    regenBtn.innerHTML = REGEN_SVG;
    regenBtn.addEventListener('click', regenerate);
    row.appendChild(regenBtn);
    bubble.appendChild(row);
  }

  /* ── Image preprocessing ─────────────────────────── */
  // Mentria expects {rgbHwc: Uint8Array, h, w} where h,w are multiples of
  // patch_size * spatial_merge_size = 32. We cap at 448² for predictable
  // prefill latency (~286 ms vision-tower pass on M-series; chat-friendly
  // per the engine's S463 bench).
  async function fileToEngineImage(file, targetSize = 448) {
    const bitmap = await createImageBitmap(file);
    const maxDim = Math.max(bitmap.width, bitmap.height);
    const scale = maxDim > targetSize ? (targetSize / maxDim) : 1;
    let w = Math.round(bitmap.width * scale);
    let h = Math.round(bitmap.height * scale);
    w = Math.max(32, Math.round(w / 32) * 32);
    h = Math.max(32, Math.round(h / 32) * 32);
    const canvas = document.createElement('canvas');
    canvas.width = w; canvas.height = h;
    const ctx = canvas.getContext('2d');
    ctx.drawImage(bitmap, 0, 0, w, h);
    const { data } = ctx.getImageData(0, 0, w, h);
    const rgbHwc = new Uint8Array(w * h * 3);
    for (let i = 0, j = 0; i < data.length; i += 4, j += 3) {
      rgbHwc[j]     = data[i];
      rgbHwc[j + 1] = data[i + 1];
      rgbHwc[j + 2] = data[i + 2];
    }
    return { rgbHwc, h, w };
  }

  /* ── Progress tracking ───────────────────────────── */
  // The engine multiplexes two progress semantics on one channel: BYTE counts
  // for shard download/upload (loaded/total in the hundreds-of-millions) and
  // STEP counters for discrete stage transitions (loaded=0/1, loaded=1/1).
  // We clamp the ratio to [0,1] so a stale byte loaded paired with a step
  // total can't render as "60-billion-percent", and we only show the
  // human-readable byte line when total looks like real bytes (>= 1 KiB).
  function onEngineProgress(p) {
    if (!p) return;
    progressWrap.style.display = '';
    if (p.message) progressLabel.textContent = p.message;
    if (p.loaded != null && p.total != null && p.total > 0) {
      const ratio = Math.max(0, Math.min(1, p.loaded / p.total));
      const pct = Math.round(ratio * 100);
      progressFill.style.width = pct + '%';
      progressPct.textContent = pct + '%';
      progressDetail.textContent =
        p.total >= 1024 ? (formatBytes(p.loaded) + ' / ' + formatBytes(p.total)) : '';
    }
  }

  /* ── Tier selection ──────────────────────────────── */
  let tierDecision = null;
  let currentTier = null;
  let contextTokens = 2048;

  const emptySubEl = document.querySelector('.ac__empty-sub');
  function updateEmptySub(id) {
    if (!emptySubEl) return;
    const tier = Tiers.TIERS[id || currentTier || (tierDecision && tierDecision.tier) || '0.8b'];
    if (!tier) return;
    let raw = null;
    try { raw = window.MentriaI18n && window.MentriaI18n.t && window.MentriaI18n.t('tool.ai-chat.empty_sub'); } catch (_) {}
    emptySubEl.textContent = (raw || COPY.emptySub).replace('{size}', tier.sizeLabel);
  }
  document.addEventListener('mentria:localechange', function () { updateEmptySub(); });
  updateEmptySub(Tiers.getUserTier() || '0.8b');

  function tierOptionLabel(id) {
    const t = Tiers.TIERS[id];
    const quality = id === '0.8b' ? COPY.tierFast : id === '2b' ? COPY.tierBetter : id === '4b' ? COPY.tierBest : COPY.tierMax;
    return id === '0.8b' ? (t.name + ' · ' + quality) : (t.name + ' · ' + quality + ' · ' + t.sizeLabel);
  }

  function syncTierSelector() {
    if (!tierDecision || !tierDecision.tier) return;
    const ids = ['0.8b'].concat(tierDecision.eligible);
    if (ids.length < 2) { tierSel.hidden = true; return; }
    tierSel.innerHTML = '';
    for (const id of ids) {
      const opt = document.createElement('option');
      opt.value = id;
      opt.textContent = tierOptionLabel(id);
      tierSel.appendChild(opt);
    }
    tierSel.value = currentTier || tierDecision.tier;
    tierSel.hidden = false;
  }

  tierSel.addEventListener('change', async () => {
    const id = tierSel.value;
    if (id === currentTier || generating) { tierSel.value = currentTier; return; }
    if (id !== '0.8b' && !(await Tiers.isTierCached(id))) {
      const ok = await window.mentriaConfirm(COPY.tierConfirm.replace('{size}', Tiers.TIERS[id].sizeLabel));
      if (!ok) { tierSel.value = currentTier; return; }
    }
    Tiers.setUserTier(id);
    tierDecision = await Tiers.decideTier();
    updateEmptySub(id);
    try { engine?.terminate(); } catch (_) {}
    engine = null;
    inputEl.disabled = true; sendBtn.disabled = true;
    loadModel();
  });

  /* ── Load engine + model ─────────────────────────── */
  async function loadModel() {
    setStatus('loading', COPY.statusLoadingModel);
    progressWrap.style.display = '';
    try {
      const { ensureModel } = await import('/assets/js/mentria-model.js');
      const createEngine = () => {
        const e = new MentriaEngine(MENTRIA_DIST_BASE + 'worker.mjs');
        window.mentriaWrapEngine && window.mentriaWrapEngine(e);
        return e;
      };
      const res = await ensureModel(createEngine, {
        vision: true,
        offerUpgrade: true,
        onProgress: onEngineProgress,
        onDeviceLost: (info) => {
          setStatus('error', COPY.errDeviceLost);
          inputEl.disabled = true; sendBtn.disabled = true;
          console.error('WebGPU device lost:', info);
        }
      });
      engine = res.engine;
      currentTier = res.tier;
      contextTokens = res.maxSeq || 2048;
      try { await navigator.storage?.persist?.(); } catch (_) {}
      syncTierSelector();
      updateEmptySub();
      progressWrap.style.display = 'none';
      setStatus('ready', COPY.statusReady);
      deleteBtn.style.display = '';
      inputEl.disabled = false;
      sendBtn.disabled = false;
      inputEl.focus();
    } catch (err) {
      progressWrap.style.display = 'none';
      if (err && err.message === 'download-postponed') { setStatus('idle', COPY.downloadPostponed); return; }
      console.error('Model load error:', err);
      setStatus('error', COPY.errLoadPrefix + (err.message || err));
    }
  }

  /* ── Generate ────────────────────────────────────── */
  async function generate() {
    if (generating || !engine) return;
    const text = inputEl.value.trim();
    if (!text && !attachedImage) return;

    inputEl.value = '';
    autoResize();

    // Build user content (mirrors HF chat-template content-array shape)
    const userContent = [];
    if (attachedImage) userContent.push({ type: 'image' });
    userContent.push({ type: 'text', text: text || 'Describe this image.' });

    addMessage('user', text, attachedDataUrl);
    messages.push({ role: 'user', content: userContent });
    persistConversation();
    clearChatBtn.style.display = '';

    // If a NEW image was just attached, append it to the persistent conversation
    // history so it stays bound to its placeholder in the messages array on every
    // future turn. Then clear the staging state.
    if (attachedImage) {
      conversationImages.push({
        rgbHwc: attachedImage.rgbHwc,
        h: attachedImage.h,
        w: attachedImage.w,
      });
    }
    attachedImage = null;
    attachedDataUrl = null;
    imgPreview.style.display = 'none';
    fileInput.value = '';

    await runGeneration();
  }

  async function regenerate() {
    if (generating || !engine) return;
    const bubbles = messagesEl.querySelectorAll('.ac__msg--assistant');
    const lastBubble = bubbles.length ? bubbles[bubbles.length - 1] : null;
    const last = messages[messages.length - 1];
    if (last && last.role === 'assistant') {
      messages.pop();
      persistConversation();
      if (lastBubble) lastBubble.remove();
    } else if (lastBubble && lastBubble.classList.contains('ac__msg--ghost')) {
      lastBubble.remove();
    }
    if (messages.length < 2 || messages[messages.length - 1].role !== 'user') return;
    await runGeneration();
  }

  function stopGeneration() {
    if (abortCtrl) abortCtrl.abort();
  }

  async function runGeneration() {
    const epoch = genEpoch;
    generating = true;
    setSendMode(true);
    setStatus('generating', COPY.statusGenerating);
    abortCtrl = new AbortController();

    if (window.renderMarkdownReady) { try { await window.renderMarkdownReady; } catch (_) {} }
    if (epoch !== genEpoch) {
      generating = false;
      abortCtrl = null;
      setSendMode(false);
      setStatus('ready', COPY.statusReady);
      return;
    }

    const bodyEl = addMessage('assistant', '');
    let fullText = '';
    let pendingPaint = false;

    function paintToken() {
      pendingPaint = false;
      if (!generating || epoch !== genEpoch) return;
      const stick = isNearBottom();
      const display = fullText.replace(/<think>[\s\S]*?<\/think>/g, '').trim();
      // window.renderMarkdown escapes html before applying markdown patterns,
      // so model-emitted <script> tags are inert. Falls back to textContent if
      // markdown.js failed to load.
      if (window.renderMarkdown) bodyEl.innerHTML = renderMarkdown(display) || '<p>…</p>';
      else bodyEl.textContent = display || '…';
      if (stick) scrollToBottom();
    }

    function finalize(wasStopped) {
      const stick = isNearBottom();
      const display = fullText
        .replace(/<think>[\s\S]*?<\/think>/g, '')
        .replace(/<\|[^|]*\|>/g, '')   // belt-and-suspenders strip if a multi-piece special leaks through
        .trim();
      if (wasStopped && !display) {
        bodyEl.textContent = COPY.stopped;
        bodyEl.classList.add('ac__msg-body--muted');
        bodyEl.parentNode.classList.add('ac__msg--ghost');
        addAssistantActions(bodyEl, null);
        return;
      }
      const escEmpty = COPY.emptyResponse.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
      if (window.renderMarkdown) bodyEl.innerHTML = renderMarkdown(display) || `<p>${escEmpty}</p>`;
      else bodyEl.textContent = display || COPY.emptyResponse;
      messages.push({ role: 'assistant', content: display });
      persistConversation();
      addAssistantActions(bodyEl, () => display);
      if (stick) scrollToBottom();
    }

    // The engine's context (contextTokens: 2048, or 1024 for the 27B model on
    // discrete GPUs) covers prompt + response combined, so send only a trailing
    // window of the conversation (~4 chars/token with margin for template
    // overhead and dense tokenization). The engine matches image placeholders
    // to tensors by order across the whole chat-template render, so images
    // ride along only while their placeholder turn is kept.
    const HISTORY_CHAR_BUDGET = contextTokens >= 2048 ? 3400 : 1200;
    const turnText = (m) => Array.isArray(m.content)
      ? m.content.filter(p => p && p.type === 'text').map(p => p.text).join(' ')
      : String(m.content || '');
    const turnImages = (m) => Array.isArray(m.content)
      ? m.content.filter(p => p && p.type === 'image').length
      : 0;
    const rest = messages.slice(1);
    const kept = [];
    let budget = 0;
    for (let i = rest.length - 1; i >= 0; i--) {
      budget += turnText(rest[i]).length + turnImages(rest[i]) * 1200;
      if (kept.length && budget > HISTORY_CHAR_BUDGET) break;
      kept.unshift(rest[i]);
    }
    let droppedImages = 0;
    for (let i = 0; i < rest.length - kept.length; i++) droppedImages += turnImages(rest[i]);
    const windowImages = conversationImages.slice(droppedImages);
    const imagesForRequest = windowImages.length ? windowImages : undefined;

    try {
      const params = {
        messages: [messages[0], ...kept],
        maxTokens: (imagesForRequest && IS_IOS) ? 256 : (contextTokens >= 2048 ? MAX_TOKENS : 320),
        // Greedy decoding (matches transformers.js do_sample:false)
        temperature: 0, topK: 1, topP: 1.0,
        repetitionPenalty: 1.15,   // bumped 1.10 → 1.15 to break list-cycle pattern (S+1 test)
        enableThinking: false,
        signal: abortCtrl.signal,
      };
      if (imagesForRequest) params.images = imagesForRequest;

      await engine.generate(params, (event) => {
        if (typeof event.token === 'string' && event.token.length > 0) {
          // Skip Qwen special tokens (<|im_end|>, <|endoftext|>, etc) from the visible stream
          if (/^<\|[^|]*\|>$/.test(event.token)) return;
          fullText += event.token;
          if (!pendingPaint) {
            pendingPaint = true;
            requestAnimationFrame(paintToken);
          }
        }
      });

      generating = false;
      if (epoch === genEpoch) finalize(false);
    } catch (err) {
      generating = false;
      const aborted = err && err.name === 'AbortError';
      if (epoch === genEpoch) {
        const friendly = /maxseq/i.test(String(err && err.message))
          ? COPY.errContextFull
          : COPY.errPrefix + (err && err.message);
        if (aborted) {
          finalize(true);
        } else if (fullText.trim()) {
          finalize(true);
          if (window.MentriaUI) MentriaUI.toast(friendly);
        } else {
          bodyEl.textContent = friendly;
          bodyEl.parentNode.classList.add('ac__msg--ghost');
          addAssistantActions(bodyEl, null);
        }
      }
      if (!aborted) console.error('Generation error:', err);
    }

    abortCtrl = null;
    setSendMode(false);
    setStatus('ready', COPY.statusReady);
    inputEl.focus();
  }

  /* ── Delete cached model ─────────────────────────── */
  async function deleteModel() {
    if (!(await mentriaConfirm(COPY.confirmDelete))) return;
    try {
      const keys = await caches.keys();
      for (const key of keys) {
        if (key.includes('mentria') || key.includes('huggingface') || key.includes('transformers')) {
          await caches.delete(key);
        }
      }
      const dbs = (typeof indexedDB.databases === 'function') ? await indexedDB.databases() : [];
      for (const db of dbs) {
        if (db.name && (db.name.includes('mentria') || db.name.includes('transformers') || db.name.includes('onnxruntime'))) {
          indexedDB.deleteDatabase(db.name);
        }
      }
      try { await engine?.unload(); } catch {}
      engine = null;
      messages = [systemMessage];
      conversationImages = [];
      if (window.MentriaStore) window.MentriaStore.remove('ai_chat', 'conversation');
      clearChatBtn.style.display = 'none';
      messagesEl.innerHTML = '';
      if (emptyEl) {
        messagesEl.appendChild(emptyEl);
        emptyEl.style.display = '';
      }
      deleteBtn.style.display = 'none';
      inputEl.disabled = true;
      sendBtn.disabled = true;
      setStatus('idle', COPY.statusModelDeleted);
    } catch (err) {
      console.error('Delete error:', err);
      mentriaAlert(COPY.errDeletePrefix + err.message);
    }
  }

  /* ── Image handling ──────────────────────────────── */
  async function attachFile(file) {
    if (!file || !file.type.startsWith('image/')) return;
    removeImage();
    const url = URL.createObjectURL(file);
    imgThumb.src = url;
    imgPreview.style.display = '';
    attachedDataUrl = url;
    try {
      attachedImage = await fileToEngineImage(file, IMG_MAX);
    } catch (err) {
      console.error('Image attach error:', err);
      removeImage();
      setStatus('error', COPY.errBadImage);
    }
  }

  function removeImage() {
    if (attachedDataUrl) { try { URL.revokeObjectURL(attachedDataUrl); } catch (_) {} }
    attachedImage = null;
    attachedDataUrl = null;
    imgPreview.style.display = 'none';
    imgThumb.src = '';
    fileInput.value = '';
  }

  /* ── Events ──────────────────────────────────────── */
  sendBtn.addEventListener('click', () => {
    if (generating) { stopGeneration(); return; }
    generate();
  });

  inputEl.addEventListener('keydown', e => {
    if (e.isComposing || e.keyCode === 229) return;
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      generate();
    }
  });

  inputEl.addEventListener('input', autoResize);

  fileInput.addEventListener('change', () => {
    if (fileInput.files[0]) attachFile(fileInput.files[0]);
  });

  imgRemoveBtn.addEventListener('click', removeImage);
  deleteBtn.addEventListener('click', deleteModel);

  // Paste image from clipboard
  document.addEventListener('paste', e => {
    const items = e.clipboardData?.items;
    if (!items) return;
    for (const item of items) {
      if (item.type.startsWith('image/')) {
        e.preventDefault();
        attachFile(item.getAsFile());
        break;
      }
    }
  });

  /* ── Init ────────────────────────────────────────── */
  (async () => {
    tierDecision = await Tiers.decideTier();
    if (!tierDecision.tier) {
      showUnsupportedError(COPY.errNoWebGpu);
      return;
    }
    syncTierSelector();
    updateEmptySub();
    loadModel();
  })();
}
</script>

