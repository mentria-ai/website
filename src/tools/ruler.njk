---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/tools/ruler/index.html"
eleventyComputed:
  lang: "{{ locale.code }}"
  title: "{{ 'tools.ruler.title' | t }}"
  description: "{{ 'tools.ruler.lede' | t }}"
---
<section class="hero" style="padding-top:1rem;">
  <p class="eyebrow eyebrow--crumbs"><a class="eyebrow__link" href="{{ locale.pathPrefix }}/">~</a><span class="eyebrow__sep">/</span><a class="eyebrow__link" href="{{ locale.pathPrefix }}/tools/">tools</a><span class="eyebrow__sep">/</span><span class="eyebrow__current">ruler</span></p>
  <h1>{{ "tools.ruler.title" | t }}</h1>
  <p>{{ "tools.ruler.lede" | t }}</p>
  {% include "tldr.njk" %}
</section>

{% set terminalTitle = "ruler.js" %}
{% include "terminal-frame-open.njk" %}
<section class="rl" id="rl">

  <div class="rl__bar">
    <span class="rl__bar-label">{{ "tool.ruler.status_label" | t }}</span>
    <span class="rl__chip" id="rl-chip" data-state="uncal" role="status" aria-live="polite">{{ "tool.ruler.state_uncalibrated" | t }}</span>
    <span class="rl__nerd" id="rl-nerd"></span>
  </div>

  <p class="rl__stale" id="rl-stale" hidden>{{ "tool.ruler.stale_note" | t }}</p>
  <p class="rl__zoom" id="rl-zoom" hidden>{{ "tool.ruler.zoom_warn" | t }}</p>
  <p class="rl__detected" id="rl-detected" hidden>{{ "tool.ruler.detected_hint" | t }}</p>

  <div class="rl__intro">
    <div class="rl__preview" aria-hidden="true">
      <svg viewBox="0 0 96 168" width="96" height="168">
        <rect x="0" y="0" width="52" height="168" rx="3" fill="rgba(255,255,255,0.03)"></rect>
        <rect x="0" y="0" width="96" height="3" fill="#e2e8f0"></rect>
        <g fill="#6ef3c5">
          <rect x="0" y="14" width="9" height="1.5"></rect>
          <rect x="0" y="26" width="9" height="1.5"></rect>
          <rect x="0" y="38" width="15" height="1.5"></rect>
          <rect x="0" y="50" width="9" height="1.5"></rect>
          <rect x="0" y="62" width="9" height="1.5"></rect>
          <rect x="0" y="74" width="24" height="2"></rect>
          <rect x="0" y="86" width="9" height="1.5"></rect>
          <rect x="0" y="98" width="9" height="1.5"></rect>
          <rect x="0" y="110" width="15" height="1.5"></rect>
          <rect x="0" y="122" width="9" height="1.5"></rect>
          <rect x="0" y="134" width="9" height="1.5"></rect>
          <rect x="0" y="146" width="24" height="2"></rect>
        </g>
        <g fill="#22d3ee" opacity="0.85">
          <rect x="30" y="20" width="7" height="1.5"></rect>
          <rect x="30" y="44" width="11" height="1.5"></rect>
          <rect x="30" y="68" width="7" height="1.5"></rect>
          <rect x="30" y="92" width="18" height="2"></rect>
          <rect x="30" y="116" width="7" height="1.5"></rect>
          <rect x="30" y="140" width="11" height="1.5"></rect>
        </g>
        <rect x="0" y="112" width="96" height="2" fill="#f472b6"></rect>
        <rect x="60" y="104" width="30" height="18" rx="9" fill="#111" stroke="#f472b6"></rect>
      </svg>
    </div>
    <div class="rl__intro-body">
      <p class="rl__explainer">{{ "tool.ruler.page_explainer" | t }}</p>
      <div class="rl__controls">
        <button class="m-btn m-btn--primary m-btn--pill rl__open" id="rl-open" type="button">{{ "tool.ruler.btn_open" | t }}</button>
        <button class="m-btn m-btn--ghost m-btn--pill" id="rl-cal-btn" type="button">{{ "tool.ruler.btn_calibrate" | t }}</button>
        <button class="m-btn m-btn--ghost m-btn--pill" id="rl-clear-btn" type="button" hidden>{{ "tool.ruler.btn_clear" | t }}</button>
      </div>
    </div>
  </div>

  <p class="rl__honesty">{{ "tool.ruler.honesty" | t }}</p>
</section>
{% include "terminal-frame-close.njk" %}

<div class="rl-ov" id="rl-ov" hidden role="dialog" aria-modal="true" aria-label="{{ 'tool.ruler.overlay_label' | t }}">
  <canvas class="rl-ov__canvas" id="rl-ov-canvas" role="img" aria-label="{{ 'tool.ruler.canvas_label' | t }}"></canvas>

  <div class="rl-ov__surface" id="rl-ov-surface" role="group" aria-label="{{ 'tool.ruler.measure_label' | t }}">
    <div class="rl-ov__line rl-ov__line--a" id="rl-line-a" role="slider" tabindex="0" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" aria-label="{{ 'tool.ruler.handle_a' | t }}">
      <span class="rl-ov__rule" aria-hidden="true"></span>
      <span class="rl-ov__tab" id="rl-tab-a" aria-hidden="true">A</span>
    </div>
    <div class="rl-ov__line rl-ov__line--b" id="rl-line-b" role="slider" tabindex="0" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" aria-label="{{ 'tool.ruler.handle_b' | t }}" hidden>
      <span class="rl-ov__rule" aria-hidden="true"></span>
      <span class="rl-ov__tab" id="rl-tab-b" aria-hidden="true">B</span>
    </div>
  </div>

  <div class="rl-ov__chrome">
    <p class="rl-ov__zero-cap">{{ "tool.ruler.zero_caption" | t }}</p>

    <button class="rl-ov__close" id="rl-close" type="button" aria-label="{{ 'tool.ruler.btn_close' | t }}">&#x2715;</button>

    <div class="rl-ov__readout" id="rl-readout">
      <span class="rl-ov__readout-label">{{ "tool.ruler.readout_label" | t }}</span>
      <span class="rl-ov__readout-main" id="rl-out-1">—</span>
      <span class="rl-ov__readout-alt" id="rl-out-2"></span>
    </div>

    <p class="rl-ov__hint">{{ "tool.ruler.pan_hint" | t }}</p>

    <div class="rl-ov__stack">
      <p class="rl-ov__flag rl-ov__flag--zoom" id="rl-ov-zoom" hidden>{{ "tool.ruler.zoom_warn" | t }}</p>
      <p class="rl-ov__flag rl-ov__flag--ok" id="rl-ov-detected" hidden>{{ "tool.ruler.detected_hint" | t }}</p>
      <div class="rl-ov__warn" id="rl-warn" hidden>
        <p class="rl-ov__warn-text">{{ "tool.ruler.warn_uncalibrated" | t }}</p>
        <button class="m-btn m-btn--primary m-btn--pill" id="rl-warn-btn" type="button">{{ "tool.ruler.warn_action" | t }}</button>
      </div>
      <div class="rl-ov__tools">
        <button class="m-btn m-btn--ghost m-btn--pill rl-ov__tool" id="rl-units-btn" type="button"></button>
        <button class="m-btn m-btn--ghost m-btn--pill rl-ov__tool" id="rl-ab-btn" type="button" aria-pressed="false">{{ "tool.ruler.measure_ab" | t }}</button>
        <button class="m-btn m-btn--ghost m-btn--pill rl-ov__tool" id="rl-ov-cal-btn" type="button">{{ "tool.ruler.btn_calibrate" | t }}</button>
        <button class="m-btn m-btn--ghost m-btn--pill rl-ov__tool" id="rl-reset-btn" type="button">{{ "tool.ruler.reset_markers" | t }}</button>
      </div>
    </div>
  </div>

  <div class="rl-ov__cal" id="rl-cal" hidden>
    <h2 class="rl-ov__cal-title">{{ "tool.ruler.cal_title" | t }}</h2>

    <div class="m-seg rl-ov__modes" id="rl-modes">
      <button type="button" data-value="card">{{ "tool.ruler.mode_card" | t }}</button>
      <button type="button" data-value="known">{{ "tool.ruler.mode_known" | t }}</button>
      <button type="button" data-value="diagonal" id="rl-mode-diagonal">{{ "tool.ruler.mode_diagonal" | t }}</button>
    </div>

    <div class="rl-ov__pane" id="rl-pane-card">
      <p class="rl-ov__note">{{ "tool.ruler.card_intro" | t }}</p>
      <div class="rl-ov__card-wrap">
        <div class="rl-ov__card" id="rl-card">
          <span class="rl-ov__card-chip" aria-hidden="true"></span>
          <span class="rl-ov__card-spec">{{ "tool.ruler.card_spec" | t }}</span>
          <div class="rl-ov__card-grip" id="rl-card-grip" role="slider" tabindex="0" aria-orientation="vertical" aria-valuemin="200" aria-valuemax="1400" aria-valuenow="324" aria-label="{{ 'tool.ruler.card_resize' | t }}"><span class="rl-ov__card-grip-dot" aria-hidden="true"></span></div>
        </div>
      </div>
      <div class="rl-ov__card-row">
        <button class="m-btn m-btn--ghost m-btn--pill rl-ov__step" type="button" data-step="-10">&minus;10</button>
        <button class="m-btn m-btn--ghost m-btn--pill rl-ov__step" type="button" data-step="-1">&minus;1</button>
        <span class="rl-ov__card-size" id="rl-card-size"></span>
        <button class="m-btn m-btn--ghost m-btn--pill rl-ov__step" type="button" data-step="1">+1</button>
        <button class="m-btn m-btn--ghost m-btn--pill rl-ov__step" type="button" data-step="10">+10</button>
      </div>
    </div>

    <div class="rl-ov__pane" id="rl-pane-known" hidden>
      <p class="rl-ov__note">{{ "tool.ruler.known_intro" | t }}</p>
      <p class="rl-ov__gap" id="rl-gap"></p>
      <div class="m-field rl-ov__known-field">
        <label for="rl-known">{{ "tool.ruler.known_label" | t }}</label>
        <input class="m-input" id="rl-known" type="number" min="1" max="2000" step="0.1" inputmode="decimal">
      </div>
    </div>

    <div class="rl-ov__pane" id="rl-pane-diagonal" hidden>
      <p class="rl-ov__note">{{ "tool.ruler.diagonal_intro" | t }}</p>
      <div class="rl-ov__chips" id="rl-diag-chips" role="group" aria-label="{{ 'tool.ruler.diagonal_label' | t }}"></div>
      <div class="m-field rl-ov__known-field">
        <label for="rl-diag">{{ "tool.ruler.diagonal_label" | t }}</label>
        <input class="m-input" id="rl-diag" type="number" min="3" max="120" step="0.1" inputmode="decimal">
      </div>
      <p class="rl-ov__gap rl-ov__gap--diag" id="rl-diag-result"></p>
    </div>

    <p class="m-status rl-ov__err" id="rl-err" data-tone="err" hidden></p>

    <div class="rl-ov__cal-actions">
      <button class="m-btn m-btn--primary m-btn--pill" id="rl-apply" type="button">{{ "tool.ruler.btn_apply" | t }}</button>
      <button class="m-btn m-btn--ghost m-btn--pill" id="rl-cancel" type="button">{{ "tool.ruler.btn_cancel" | t }}</button>
    </div>
  </div>
</div>

{% include "tool-schema.njk" %}

<style>
.rl {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  font-family: var(--font-mono);
  padding: var(--space-2) 0 var(--space-4);
  max-width: 100%;
}

.rl__bar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-2) var(--space-3);
}
.rl__bar-label {
  font-size: var(--text-2xs);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--term-muted);
}
.rl__chip {
  font-size: var(--text-2xs);
  padding: 0.25rem 0.6rem;
  border-radius: var(--radius-pill);
  border: 1px solid var(--term-border-strong);
  color: var(--term-muted);
}
.rl__chip[data-state="cal"] {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--green-8);
}
.rl__chip[data-state="stale"] {
  border-color: var(--syn-amber);
  color: var(--syn-amber);
  background: var(--amber-8);
}
.rl__chip[data-state="detected"],
.rl__chip[data-state="diagonal"] {
  border-color: var(--syn-cyan);
  color: var(--syn-cyan);
  background: var(--cyan-8);
}
.rl__nerd {
  font-size: var(--text-2xs);
  color: var(--term-subtle);
  font-variant-numeric: tabular-nums;
  margin-left: auto;
}

.rl__stale {
  margin: 0;
  font-size: var(--text-xs);
  line-height: 1.55;
  color: var(--syn-amber);
  background: var(--amber-8);
  border: 1px solid var(--amber-30);
  border-radius: var(--radius-md);
  padding: var(--space-3);
}
.rl__stale[hidden] { display: none; }

.rl__zoom {
  margin: 0;
  font-size: var(--text-xs);
  line-height: 1.55;
  color: var(--syn-pink);
  background: var(--pink-10);
  border: 1px solid var(--pink-30);
  border-radius: var(--radius-md);
  padding: var(--space-3);
}
.rl__zoom[hidden] { display: none; }

.rl__detected {
  margin: 0;
  font-size: var(--text-2xs);
  line-height: 1.55;
  color: var(--term-subtle);
}
.rl__detected[hidden] { display: none; }

.rl__intro {
  display: flex;
  align-items: center;
  gap: var(--space-5);
  padding: var(--space-4);
  border: 1px solid var(--term-border);
  border-radius: var(--radius-lg);
  background: rgba(255, 255, 255, 0.015);
}
.rl__preview {
  flex: none;
  line-height: 0;
  opacity: 0.85;
}
.rl__intro-body {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  min-width: 0;
}
.rl__explainer {
  margin: 0;
  font-size: var(--text-sm);
  line-height: 1.6;
  color: var(--term-fg);
  max-width: 56ch;
}
.rl__controls {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}
.rl__controls button[hidden] { display: none; }
.rl__open {
  font-size: var(--text-base);
  padding: var(--space-3) var(--space-6);
  font-weight: 700;
  min-height: 48px;
}

.rl__honesty {
  margin: 0;
  font-size: var(--text-2xs);
  line-height: 1.65;
  color: var(--term-subtle);
  max-width: 72ch;
}

.rl-ov {
  position: fixed;
  inset: 0;
  z-index: 2147483000;
  background: #07090b;
  overflow: hidden;
  font-family: var(--font-mono);
  overscroll-behavior: none;
  -webkit-tap-highlight-color: transparent;
}
.rl-ov[hidden] { display: none; }

.rl-ov__canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.rl-ov__surface {
  position: absolute;
  inset: 0;
  touch-action: none;
  user-select: none;
  -webkit-user-select: none;
  cursor: ns-resize;
}

.rl-ov__line {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 0;
  will-change: transform;
}
.rl-ov__line[hidden] { display: none; }
.rl-ov__rule {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 2px;
  background: var(--syn-pink);
  box-shadow: 0 0 8px rgba(244, 114, 182, 0.55);
}
.rl-ov__line--b .rl-ov__rule {
  background: var(--syn-amber);
  box-shadow: 0 0 8px rgba(251, 191, 36, 0.5);
}
.rl-ov__tab {
  position: absolute;
  left: 132px;
  top: -22px;
  width: 52px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-pill);
  border: 1px solid var(--syn-pink);
  background: rgba(12, 14, 17, 0.92);
  color: var(--syn-pink);
  font-size: var(--text-xs);
  font-weight: 700;
  box-shadow: var(--elev-2);
}
.rl-ov__line--b .rl-ov__tab {
  left: 192px;
  border-color: var(--syn-amber);
  color: var(--syn-amber);
}
.rl-ov__line:focus { outline: none; }
.rl-ov__line:focus-visible .rl-ov__tab {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.rl-ov__chrome {
  position: absolute;
  inset: 0;
  pointer-events: none;
  padding: calc(env(safe-area-inset-top, 0px) + 10px) calc(env(safe-area-inset-right, 0px) + 10px) calc(env(safe-area-inset-bottom, 0px) + 10px) calc(env(safe-area-inset-left, 0px) + 10px);
}

.rl-ov__zero-cap {
  position: absolute;
  top: 0;
  left: 126px;
  margin: 0;
  font-size: var(--text-2xs);
  color: var(--term-subtle);
  max-width: 190px;
  line-height: 1.4;
}

.rl-ov__close {
  position: absolute;
  top: 0;
  right: 0;
  width: 44px;
  height: 44px;
  border-radius: var(--radius-pill);
  border: 1px solid var(--term-border-strong);
  background: rgba(12, 14, 17, 0.9);
  color: var(--term-fg);
  font-size: 1rem;
  cursor: pointer;
  pointer-events: auto;
}
.rl-ov__close:hover { border-color: var(--accent); color: var(--accent); }

.rl-ov__readout {
  position: absolute;
  top: 54px;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
  text-align: right;
}
.rl-ov__readout-label {
  font-size: var(--text-2xs);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--term-muted);
}
.rl-ov__readout-main {
  font-size: var(--text-xl);
  font-weight: 700;
  color: var(--term-fg-strong);
  font-variant-numeric: tabular-nums;
  line-height: 1.15;
}
.rl-ov__readout-alt {
  font-size: var(--text-sm);
  color: var(--term-muted);
  font-variant-numeric: tabular-nums;
}

.rl-ov__hint {
  position: absolute;
  top: 138px;
  right: 0;
  margin: 0;
  max-width: 230px;
  text-align: right;
  font-size: var(--text-2xs);
  line-height: 1.5;
  color: var(--term-subtle);
}

.rl-ov__stack {
  position: absolute;
  left: 126px;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: var(--space-3);
}

.rl-ov__warn {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-2);
  padding: var(--space-3);
  border: 1px solid var(--amber-30);
  border-radius: var(--radius-md);
  background: rgba(38, 28, 6, 0.94);
  pointer-events: auto;
}
.rl-ov__warn[hidden] { display: none; }

.rl-ov__flag {
  width: 100%;
  margin: 0;
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-md);
  font-size: var(--text-2xs);
  line-height: 1.5;
  pointer-events: auto;
}
.rl-ov__flag[hidden] { display: none; }
.rl-ov__flag--zoom {
  color: var(--syn-pink);
  border: 1px solid var(--pink-30);
  background: rgba(40, 10, 24, 0.94);
}
.rl-ov__flag--ok {
  color: var(--term-subtle);
  border: 1px solid var(--term-border-strong);
  background: rgba(12, 14, 17, 0.9);
}
.rl-ov__warn-text {
  margin: 0;
  font-size: var(--text-xs);
  line-height: 1.5;
  color: var(--syn-amber);
}
.rl-ov__warn .m-btn { min-height: 44px; }

.rl-ov__tools {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: var(--space-2);
}
.rl-ov__tool {
  pointer-events: auto;
  min-height: 40px;
  background: rgba(12, 14, 17, 0.9);
}
.rl-ov__tool[aria-pressed="true"] {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--green-8);
}

.rl-ov__close,
.rl-ov__stack,
.rl-ov__hint,
.rl-ov__zero-cap {
  transition: opacity var(--duration-fast) var(--ease-out);
}
.rl-ov.is-dragging .rl-ov__close,
.rl-ov.is-dragging .rl-ov__stack,
.rl-ov.is-dragging .rl-ov__hint,
.rl-ov.is-dragging .rl-ov__zero-cap {
  opacity: 0.1;
}

.rl-ov__cal {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 94%;
  overflow: auto;
  overscroll-behavior: contain;
  background: #0b0e11;
  border-top: 1px solid var(--term-border-strong);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: var(--space-4) calc(env(safe-area-inset-right, 0px) + var(--space-4)) calc(env(safe-area-inset-bottom, 0px) + var(--space-4)) calc(env(safe-area-inset-left, 0px) + var(--space-4));
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  box-shadow: var(--elev-3);
}
.rl-ov__cal[hidden] { display: none; }
.rl-ov__cal.is-full {
  top: 0;
  max-height: none;
  padding-top: calc(env(safe-area-inset-top, 0px) + var(--space-4));
  border-radius: 0;
}
.rl-ov__cal-title {
  margin: 0;
  font-size: var(--text-base);
  color: var(--accent);
}
.rl-ov__modes { max-width: 320px; }

.rl-ov__pane {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}
.rl-ov__pane[hidden] { display: none; }

.rl-ov__note {
  margin: 0;
  font-size: var(--text-xs);
  line-height: 1.6;
  color: var(--term-muted);
  max-width: 62ch;
}

.rl-ov__card-wrap {
  overflow: auto;
  margin-left: calc(-1 * (env(safe-area-inset-left, 0px) + var(--space-4)));
  margin-right: calc(-1 * (env(safe-area-inset-right, 0px) + var(--space-4)));
  padding: var(--space-2) var(--space-2) var(--space-6) var(--space-2);
}

