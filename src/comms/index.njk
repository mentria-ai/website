---
layout: base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.pathPrefix }}/comms/index.html"
eleventyComputed:
  lang: "{{ locale.code }}"
  title: "{{ 'tools.comms.title' | t }}"
  seoTitle: "{{ 'tools.comms.seo_title' | t }}"
  description: "{{ 'tool.comms.meta_description' | t }}"
localeReload: true
unlockTool: true
---
{%- set commsHttps = "https://mentria.ai" + locale.pathPrefix + "/comms/" -%}
<svg class="comms__sprite" aria-hidden="true" focusable="false"><defs>
  <symbol id="ci-lock" viewBox="0 0 24 24"><g transform="translate(0 1)"><path d="M7 10V7a5 5 0 0 1 10 0v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><rect x="4" y="10" width="16" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="15" r="1.6" fill="currentColor"/></g></symbol>
  <symbol id="ci-phone" viewBox="0 0 24 24"><path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></symbol>
  <symbol id="ci-hangup" viewBox="0 0 24 24"><path d="M2.5 13.5c5-4.5 14-4.5 19 0l-2.5 2.5-3.2-1.6v-2.2a12 12 0 0 0-7.6 0v2.2L5 16z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M4 20 20 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
  <symbol id="ci-cam" viewBox="0 0 24 24"><rect x="3" y="7" width="12" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="m15 11 6-3v8l-6-3z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></symbol>
  <symbol id="ci-mic" viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
  <symbol id="ci-users" viewBox="0 0 24 24"><g transform="translate(1.2 0.1)"><circle cx="9" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M3 19a6 6 0 0 1 12 0M16.5 5.5a3.2 3.2 0 0 1 0 6M18 19a5.5 5.5 0 0 0-2.5-4.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></g></symbol>
  <symbol id="ci-gear" viewBox="0 0 24 24"><path d="M10.0 4.77 10.32 2.45 13.68 2.45 14.0 4.77 15.69 5.47 17.56 4.05 19.95 6.44 18.53 8.31 19.23 10.0 21.55 10.32 21.55 13.68 19.23 14.0 18.53 15.69 19.95 17.56 17.56 19.95 15.69 18.53 14.0 19.23 13.68 21.55 10.32 21.55 10.0 19.23 8.31 18.53 6.44 19.95 4.05 17.56 5.47 15.69 4.77 14.0 2.45 13.68 2.45 10.32 4.77 10.0 5.47 8.31 4.05 6.44 6.44 4.05 8.31 5.47Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="12" cy="12" r="3.4" fill="none" stroke="currentColor" stroke-width="1.6"/></symbol>
  <symbol id="ci-share" viewBox="0 0 24 24"><path d="M12 3.4v11.4M8.4 6.9 12 3.4l3.6 3.5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/><path d="M7 10.4H5.6a1.4 1.4 0 0 0-1.4 1.4v7.4a1.4 1.4 0 0 0 1.4 1.4h12.8a1.4 1.4 0 0 0 1.4-1.4v-7.4a1.4 1.4 0 0 0-1.4-1.4H17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="ci-qr" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="2"/><rect x="14" y="3" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="2"/><rect x="3" y="14" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="2"/><path d="M14 14h3v3h-3zM19 19h2v2h-2z" fill="currentColor"/></symbol>
  <symbol id="ci-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
  <symbol id="ci-back" viewBox="0 0 24 24"><path d="M14.5 5 8 12l6.5 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="ci-stop" viewBox="0 0 24 24"><rect x="6.5" y="6.5" width="11" height="11" rx="2" fill="currentColor"/></symbol><symbol id="ci-send" viewBox="0 0 24 24"><path d="M3.5 11.2 20.2 4l-3.4 16-5.3-6.2zM11.5 13.8l8.7-9.8" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/></symbol>
  <symbol id="ci-devices" viewBox="0 0 24 24"><rect x="2.5" y="5" width="13" height="9.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M1.5 17.5h16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><rect x="17" y="8" width="5" height="11" rx="1.3" fill="none" stroke="currentColor" stroke-width="1.8"/></symbol>
  <symbol id="ci-media" viewBox="0 0 24 24"><rect x="3.5" y="4.5" width="17" height="15" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="9" cy="10" r="1.8" fill="currentColor"/><path d="m4.5 17.5 5-5 3.5 3.5 2.5-2.5 4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="ci-clip" viewBox="0 0 24 24"><g transform="translate(0.9 1)"><path d="m17.5 11.5-6.1 6.1a4.3 4.3 0 0 1-6-6l7.4-7.4a3 3 0 0 1 4.2 4.2l-7.3 7.3a1.6 1.6 0 0 1-2.3-2.3l6.1-6.1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></g></symbol>
  <symbol id="ci-trash" viewBox="0 0 24 24"><path d="M4.5 6.5h15M9.5 3.5h5M7 6.5l.8 13a1.6 1.6 0 0 0 1.6 1.5h5.2a1.6 1.6 0 0 0 1.6-1.5l.8-13M10 10.5v6M14 10.5v6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></symbol>
  <symbol id="ci-bell" viewBox="0 0 24 24"><path d="M6.5 16.5V11a5.5 5.5 0 0 1 11 0v5.5l1.6 2.2H4.9zM10 20.6a2 2 0 0 0 4 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="ci-chev" viewBox="0 0 24 24"><path d="m9.5 5 6.5 7-6.5 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="ci-flash" viewBox="0 0 24 24"><path d="M13 2.5 5.5 13.5H11L10 21.5l7.7-11H12.3z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></symbol>
  <symbol id="ci-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
  <symbol id="ci-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="m16 16 4.5 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
</defs></svg>

<section class="comms">
  <h1 class="sr-only">{{ 'tools.comms.title' | t }}</h1>
  <div class="comms__picker comms__lock" id="comms-lock" hidden>
    <div class="comms__picker-backdrop" data-lock-close></div>
    <div class="comms__picker-card" role="dialog" aria-modal="true" aria-labelledby="comms-lock-title">
      <h3 class="comms__picker-h" id="comms-lock-title"></h3>
      <p class="comms__invite-by">{{ 'tool.comms.roomlock.note' | t }}</p>
      <div class="comms__lock-list" id="comms-lock-list"></div>
      <div class="comms__picker-actions comms__invite-actions">
        <button type="button" class="comms__btn comms__btn--ghost" data-lock-close>{{ 'tool.comms.picker.cancel' | t }}</button>
        <button type="button" class="comms__btn" id="comms-lock-go">{{ 'tool.comms.roomlock.go' | t }}</button>
      </div>
    </div>
  </div>
  <div class="comms__picker comms__invite" id="comms-invite" hidden>
    <div class="comms__picker-backdrop"></div>
    <div class="comms__picker-card" role="dialog" aria-modal="true" aria-labelledby="comms-invite-title">
      <h3 class="comms__picker-h" id="comms-invite-title"></h3>
      <p class="comms__invite-by" id="comms-invite-by" hidden></p>
      <p class="comms__invite-ios" id="comms-invite-ios" hidden><span>{{ 'tool.comms.invite.ios' | t }}</span> <button type="button" class="comms__btn comms__btn--ghost" id="comms-invite-copy">{{ 'tool.comms.invite.copy' | t }}</button></p>
      <div class="comms__picker-actions comms__invite-actions">
        <button type="button" class="comms__btn comms__btn--ghost" id="comms-invite-later">{{ 'tool.comms.invite.not_now' | t }}</button>
        <button type="button" class="comms__btn comms__btn--ghost" id="comms-invite-copylink" hidden>{{ 'tool.comms.invite.copy_link' | t }}</button>
        <button type="button" class="comms__btn" id="comms-invite-share" hidden>{{ 'tool.comms.invite.share' | t }}</button>
        <button type="button" class="comms__btn" id="comms-invite-retry" hidden>{{ 'tool.comms.invite.retry' | t }}</button>
        <button type="button" class="comms__btn" id="comms-invite-join" hidden>{{ 'tool.comms.invite.join' | t }}</button>
      </div>
    </div>
  </div>
  <div class="comms__onboard" id="comms-onboard" hidden>
    <div class="comms__onboard-step" id="comms-onboard-insecure" hidden>
      <h2 class="comms__onboard-h">{{ 'tool.comms.onboard.insecure_title' | t }}</h2>
      <p class="comms__onboard-p">{{ 'tool.comms.onboard.insecure_body' | t | safe }}</p>
      <p class="comms__onboard-p">{{ 'tool.comms.onboard.insecure_open' | t | replace('{link}', '<a class="comms__url" href="' + commsHttps + '">' + commsHttps + '</a>') | safe }}</p>
    </div>
    <div class="comms__onboard-step" id="comms-onboard-intro">
      <h2 class="comms__onboard-h">{{ 'tool.comms.onboard.intro_title' | t }}</h2>
      <p class="comms__onboard-p">{{ 'tool.comms.onboard.intro_body' | t }}</p>
      <button class="comms__btn comms__btn--big" id="comms-onboard-start" type="button">{{ 'tool.comms.onboard.start' | t }}</button>
      <p class="comms__onboard-fine">{{ 'tool.comms.onboard.intro_fine' | t }}</p>
    </div>
    <div class="comms__onboard-step" id="comms-onboard-form" hidden>
      <h2 class="comms__onboard-h">{{ 'tool.comms.onboard.name_title' | t }}</h2>
      <input class="comms__input comms__input--big" id="comms-onboard-name" type="text" maxlength="32" placeholder="{{ 'tool.comms.onboard.name_placeholder' | t }}" autocomplete="nickname" enterkeyhint="done">
      <button class="comms__btn comms__btn--big" id="comms-onboard-create" type="button">{{ 'tool.comms.onboard.create' | t }}</button>
      <div class="comms__card-slot" id="comms-onboard-card" hidden></div>
      <p class="comms__onboard-fine" id="comms-onboard-hint">{{ 'tool.comms.onboard.hint' | t }}</p>
      <p class="comms__onboard-err" id="comms-onboard-err" hidden></p>
    </div>
    <div class="comms__onboard-step" id="comms-onboard-done" hidden>
      <h2 class="comms__onboard-h">{{ 'tool.comms.onboard.done_title' | t }}</h2>
      <p class="comms__onboard-p" id="comms-onboard-method"></p>
      <p class="comms__onboard-p">{{ 'tool.comms.onboard.done_body' | t }}</p>
      <code class="comms__recovery" id="comms-onboard-code"></code>
      <div class="comms__onboard-actions">
        <button class="comms__btn comms__btn--ghost" id="comms-onboard-copy" type="button">{{ 'tool.comms.onboard.copy_code' | t }}</button>
        <button class="comms__btn" id="comms-onboard-passkey" type="button" hidden>{{ 'tool.comms.onboard.passkey' | t }}</button>
        <button class="comms__btn comms__btn--big" id="comms-onboard-continue" type="button">{{ 'tool.comms.onboard.continue' | t }}</button>
      </div>
    </div>
  </div>

  <div class="comms__lock" id="comms-id-locked" hidden>
    <p class="comms__lock-link" id="comms-lock-link" hidden><strong>{{ 'unlock.link_title' | t }}</strong> {{ 'unlock.link_body' | t }}</p>
    <p class="comms__lock-h" id="comms-lock-title">{{ 'tool.comms.lock.title' | t }}</p>
    <p class="comms__lock-waiting" id="comms-lock-waiting" hidden></p>
    <div class="comms__card-slot" id="comms-id-card-slot" hidden></div>
    <button class="comms__btn comms__btn--ghost" id="comms-lock-old" type="button" aria-expanded="false" aria-controls="comms-id-passkey comms-lock-alt" hidden>{{ 'tool.comms.lock.old_unlock' | t }}</button>
    <button class="comms__btn comms__btn--big" id="comms-id-passkey" type="button" hidden>{{ 'tool.comms.lock.unlock' | t }}</button>
    <details class="comms__lock-alt" id="comms-lock-alt">
      <summary>{{ 'tool.comms.lock.use_code' | t }}</summary>
      <div class="comms__lock-row">
        <input class="comms__input" id="comms-id-pass" type="password" placeholder="{{ 'tool.comms.lock.code_placeholder' | t }}" autocomplete="current-password">
        <button class="comms__btn" id="comms-id-unlock" type="button">{{ 'tool.comms.lock.unlock' | t }}</button>
      </div>
    </details>
    <span class="comms__id-note" id="comms-id-err"></span>
  </div>

  <div class="comms__app comms__app--people" id="comms-app" hidden>
    <div class="comms__side">
      <div class="comms__profile" id="comms-profile">
        <span class="comms__brand" aria-hidden="true">comms<i>_</i></span>
        <div class="comms__id-row comms__id-row--you" id="comms-id-on" hidden>
          <span class="comms__avatar comms__avatar--me" id="comms-prof-avatar" aria-hidden="true"></span>
          <input class="comms__input comms__input--short" id="comms-id-name" type="text" maxlength="32" placeholder="{{ 'tool.comms.profile.name_placeholder' | t }}" autocomplete="nickname" aria-label="{{ 'tool.comms.profile.name_label' | t }}">
          <span class="comms__badge comms__badge--fp" id="comms-id-fp" title="{{ 'tool.comms.profile.fp_title' | t }}"></span>
        </div>
        <span class="comms__profile-spacer"></span>
        <button class="comms__btn comms__btn--ghost comms__btn--icon" id="comms-id-lock" type="button" hidden title="{{ 'unlock.lock_now' | t }}" aria-label="{{ 'unlock.lock_now' | t }}"><svg class="comms__i" aria-hidden="true"><use href="#ci-lock"></use></svg></button>
        <button class="comms__btn comms__btn--ghost comms__btn--icon" id="comms-adv-toggle" type="button" aria-expanded="false" title="{{ 'tool.comms.profile.settings' | t }}" aria-label="{{ 'tool.comms.profile.settings' | t }}"><svg class="comms__i" aria-hidden="true"><use href="#ci-gear"></use></svg></button>
      </div>

      <div class="comms__adv" id="comms-adv" hidden>
        <div class="comms__adv-sec comms__agents" id="comms-agents" hidden>
          <span class="comms__lbl">{{ 'tool.comms.agent.heading' | t }}</span>
          <button class="comms__btn comms__btn--ghost" id="comms-agents-copy" type="button">{{ 'tool.comms.agent.connect' | t }}</button>
          <p class="comms__id-note" id="comms-agents-note">{{ 'tool.comms.agent.connect_note' | t }}</p>
        </div>
        <div class="comms__adv-sec">
          <span class="comms__lbl">{{ 'tool.comms.adv.room' | t }}</span>
          <div class="comms__room">
            <input class="comms__input" id="comms-room" type="text" enterkeyhint="go" autocomplete="off" spellcheck="false" autocapitalize="off" placeholder="{{ 'tool.comms.adv.room_placeholder' | t }}">
            <button class="comms__btn" id="comms-join" type="button">{{ 'tool.comms.adv.join' | t }}</button>
          </div>
          <div class="comms__room-new">
            <button class="comms__btn comms__btn--ghost" id="comms-newroom" type="button" title="{{ 'tool.comms.adv.new_room_title' | t }}">{{ 'tool.comms.adv.new_room' | t }}</button>
            <button class="comms__btn comms__btn--ghost" id="comms-newsaved" type="button" title="{{ 'tool.comms.adv.new_saved_title' | t }}">{{ 'tool.comms.adv.new_saved' | t }}</button>
          </div>
        </div>
        <div class="comms__adv-sec">
          <span class="comms__lbl">{{ 'tool.comms.adv.privacy' | t }}</span>
          <button class="comms__relay" id="comms-relay" type="button" role="switch" aria-checked="false">
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5 5 6v5c0 4.4 3 7.9 7 9 4-1.1 7-4.6 7-9V6Z"></path><path d="M9.4 11.8l1.9 1.9 3.3-3.4"></path></svg>
            <span class="comms__relay-lbl">{{ 'tool.comms.adv.hide_ip' | t }}</span>
            <span class="comms__relay-track" aria-hidden="true"><span class="comms__relay-thumb"></span></span>
          </button>
          <p class="comms__relay-note" id="comms-relay-note" hidden>{{ 'tool.comms.adv.relay_note' | t }}</p>
        </div>
        <div class="comms__adv-sec comms__adv-sec--col">
          <div class="comms__adv-row">
            <span class="comms__lbl">{{ 'tool.comms.adv.notifications' | t }}</span>
            <button class="comms__btn comms__btn--ghost" id="comms-push-test" type="button">{{ 'tool.comms.adv.test' | t }}</button>
          </div>
          <span class="comms__id-note" id="comms-push-status">…</span>
          <span class="comms__id-note comms__push-log" id="comms-push-test-log" hidden></span>
        </div>
        <div class="comms__adv-sec">
          <span class="comms__lbl">{{ 'tool.comms.adv.device' | t }}</span>
          <button class="comms__btn comms__btn--ghost comms__btn--mute" id="comms-mute" type="button" aria-pressed="false">{{ 'tool.comms.adv.sound_on' | t }}</button>
          <button class="comms__btn comms__btn--ghost" id="comms-attach-ext" type="button">{{ 'tool.comms.adv.attach_ext' | t }}</button>
          <button class="comms__btn comms__btn--ghost" id="comms-attach-pack" type="button">{{ 'tool.comms.adv.attach_pack' | t }}</button>
          <button class="comms__btn comms__btn--ghost" id="comms-pk-settings" type="button" hidden>{{ 'tool.comms.passkey.add' | t }}</button>
          <a class="comms__btn comms__btn--ghost" href="{{ locale.pathPrefix }}/about/">{{ 'tool.comms.adv.identity' | t }}</a>
        </div>
      </div>

      <div class="comms__upgrade" id="comms-pk-upgrade" hidden>
        <span class="comms__upgrade-text">{{ 'tool.comms.passkey.offer' | t }}</span>
        <div class="comms__upgrade-actions">
          <button class="comms__btn" id="comms-pk-enroll" type="button">{{ 'tool.comms.passkey.add' | t }}</button>
          <button class="comms__btn comms__btn--ghost" id="comms-pk-later" type="button">{{ 'tool.comms.passkey.later' | t }}</button>
        </div>
        <span class="comms__id-note" id="comms-pk-err" hidden></span>
      </div>

      <div class="comms__upgrade comms__link" id="comms-link" hidden>
        <span class="comms__upgrade-text"><strong>{{ 'unlock.link_title' | t }}</strong> {{ 'unlock.link_body' | t }}</span>
        <div class="comms__card-slot" id="comms-link-card" hidden></div>
        <div class="comms__upgrade-actions">
          <button class="comms__btn" id="comms-link-go" type="button" hidden>{{ 'tool.comms.guest.setup' | t }}</button>
          <button class="comms__btn comms__btn--ghost" id="comms-link-later" type="button">{{ 'tool.comms.passkey.later' | t }}</button>
        </div>
      </div>

      <div class="comms__notif" id="comms-notif" hidden>
        <span class="comms__notif-text">{{ 'tool.comms.notif.text' | t }}</span>
        <button class="comms__btn" id="comms-notif-enable" type="button">{{ 'tool.comms.notif.enable' | t }}</button>
        <button class="comms__btn comms__btn--ghost comms__btn--icon" id="comms-notif-dismiss" type="button" title="{{ 'tool.comms.notif.dismiss' | t }}" aria-label="{{ 'tool.comms.notif.dismiss' | t }}"><svg class="comms__i" aria-hidden="true"><use href="#ci-plus" style="transform:rotate(45deg);transform-origin:center"></use></svg></button>
      </div>

      <div class="comms__id-row" id="comms-id-none" hidden>
        <span class="comms__id-note">{{ 'tool.comms.guest.note' | t }}</span>
        <button class="comms__btn comms__btn--ghost" id="comms-id-setup-here" type="button">{{ 'tool.comms.guest.setup' | t }}</button>
      </div>

      <div class="comms__contacts" id="comms-contacts" hidden>
        <div class="comms__contacts-head">
          <span class="comms__lbl">{{ 'tool.comms.people.heading' | t }}</span>
          <button class="comms__btn comms__btn--ghost comms__btn--icon" id="comms-id-share" type="button" aria-pressed="false"><svg class="comms__i" aria-hidden="true"><use href="#ci-qr"></use></svg><span class="comms__btn-t" id="comms-id-share-t">{{ 'tool.comms.people.my_code' | t }}</span></button>
          <button class="comms__btn comms__btn--ghost comms__btn--icon" id="comms-add-toggle" type="button" aria-expanded="false"><svg class="comms__i" aria-hidden="true"><use href="#ci-plus"></use></svg><span class="comms__btn-t" id="comms-add-toggle-t">{{ 'tool.comms.people.add' | t }}</span></button>
