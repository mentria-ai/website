  errNoWebGpu:         {{ ("tool.ai-chat.err_no_webgpu"         | t) | dump | safe }},
  errUnsupportedMain:  {{ ("tool.ai-chat.err_unsupported_main"  | t) | dump | safe }},
  errUnsupportedSub:   {{ ("tool.ai-chat.err_unsupported_sub"   | t) | dump | safe }},
  errLoadRuntime:      {{ ("tool.ai-chat.err_load_runtime"      | t) | dump | safe }},
  errDeviceLost:       {{ ("tool.ai-chat.err_device_lost"       | t) | dump | safe }},
  errBadImage:         {{ ("tool.ai-chat.err_bad_image"         | t) | dump | safe }},
  errLoadPrefix:       {{ ("tool.ai-chat.err_load_prefix"       | t) | dump | safe }},
  errContextFull:      {{ ("tool.ai-chat.err_context_full"      | t) | dump | safe }},
  errPrefix:           {{ ("tool.ai-chat.err_prefix"            | t) | dump | safe }},
  errDeletePrefix:     {{ ("tool.ai-chat.err_delete_prefix"     | t) | dump | safe }},
  emptyResponse:       {{ ("tool.ai-chat.empty_response"        | t) | dump | safe }},
  confirmDelete:       {{ ("tool.ai-chat.confirm_delete"        | t) | dump | safe }},
  downloadPostponed:   {{ ("common.download_postponed"          | t) | dump | safe }},
  tierLabel:           {{ ("tool.ai-chat.tier_label"            | t) | dump | safe }},
  tierFast:            {{ ("tool.ai-chat.tier_fast"             | t) | dump | safe }},
  tierBetter:          {{ ("tool.ai-chat.tier_better"           | t) | dump | safe }},
  tierBest:            {{ ("tool.ai-chat.tier_best"             | t) | dump | safe }},
  tierMax:             {{ ("tool.ai-chat.tier_max"              | t) | dump | safe }},
  emptySub:            {{ ("tool.ai-chat.empty_sub"             | t) | dump | safe }},
  tierConfirm:         {{ ("tool.ai-chat.tier_confirm"          | t) | dump | safe }},
  tierFallback:        {{ ("tool.ai-chat.tier_fallback"         | t) | dump | safe }},
  btnSend:             {{ ("tool.ai-chat.btn_send"              | t) | dump | safe }},
  btnStop:             {{ ("tool.ai-chat.btn_stop"              | t) | dump | safe }},
  btnCopy:             {{ ("tool.ai-chat.btn_copy"              | t) | dump | safe }},
  copied:              {{ ("tool.ai-chat.copied"                | t) | dump | safe }},
  copyFailed:          {{ ("tool.ai-chat.copy_failed"           | t) | dump | safe }},
  btnRegenerate:       {{ ("tool.ai-chat.btn_regenerate"        | t) | dump | safe }},
  stopped:             {{ ("tool.ai-chat.stopped"               | t) | dump | safe }},
  thinkToggle:         {{ ("tool.ai-chat.think_toggle"          | t) | dump | safe }},
  thinkNeedsCtx:       {{ ("tool.ai-chat.think_needs_ctx"       | t) | dump | safe }},
  thinkToggleSlow:     {{ ("tool.ai-chat.think_toggle_slow"     | t) | dump | safe }},
  searchToggle:        {{ ("tool.ai-chat.search_toggle"         | t) | dump | safe }},
  searchConfigure:     {{ ("tool.ai-chat.search_configure"      | t) | dump | safe }},
  searchTestOk:        {{ ("tool.ai-chat.search_test_ok"        | t) | dump | safe }},
  searchTestFail:      {{ ("tool.ai-chat.search_test_fail"      | t) | dump | safe }},
  searchLocalOnly:     {{ ("tool.ai-chat.search_local_only"     | t) | dump | safe }},
  searching:           {{ ("tool.ai-chat.searching"             | t) | dump | safe }},
  searchSources:       {{ ("tool.ai-chat.search_sources"        | t) | dump | safe }},
  searchFailedNote:    {{ ("tool.ai-chat.search_failed_note"    | t) | dump | safe }},
  adaptersBase:        {{ ("tool.ai-chat.adapters_base"         | t) | dump | safe }},
  adaptersBaseDesc:    {{ ("tool.ai-chat.adapters_base_desc"    | t) | dump | safe }},
  adaptersNone:        {{ ("tool.ai-chat.adapters_none"         | t) | dump | safe }},
  adaptersOnly27:      {{ ("tool.ai-chat.adapters_only27"       | t) | dump | safe }},
  adaptersPin:         {{ ("tool.ai-chat.adapters_pin"          | t) | dump | safe }},
  adaptersActive:      {{ ("tool.ai-chat.adapters_active"       | t) | dump | safe }},
  adaptersRouter:      {{ ("tool.ai-chat.adapters_router"       | t) | dump | safe }},
  adaptersNote:        {{ ("tool.ai-chat.adapters_note"         | t) | dump | safe }},
  adaptersLoading:     {{ ("tool.ai-chat.adapters_loading"      | t) | dump | safe }},
  adaptersPinned:      {{ ("tool.ai-chat.adapters_pinned"       | t) | dump | safe }},
  adaptersFailed:      {{ ("tool.ai-chat.adapters_failed"       | t) | dump | safe }},
  adaptersSha:         {{ ("tool.ai-chat.adapters_sha"          | t) | dump | safe }},
  adaptersThinking:    { off: {{ ("tool.ai-chat.adapters_thinking_off" | t) | dump | safe }}, on: {{ ("tool.ai-chat.adapters_thinking_on" | t) | dump | safe }}, either: {{ ("tool.ai-chat.adapters_thinking_either" | t) | dump | safe }} },
  thinkPinned:         {{ ("tool.ai-chat.think_pinned"          | t) | dump | safe }},
  searchPinned:        {{ ("tool.ai-chat.search_pinned"         | t) | dump | safe }},
  thinking:            {{ ("tool.ai-chat.thinking"              | t) | dump | safe }},
  thoughtFor:          {{ ("tool.ai-chat.thought_for"           | t) | dump | safe }},
  thinkCut:            {{ ("tool.ai-chat.think_cut"             | t) | dump | safe }}
};

const MENTRIA_DIST_BASE  = '/assets/mentria/dist/';
const MENTRIA_TIERS_PATH = '/assets/js/mentria-tiers.js';

const IS_IOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
const IMG_MAX = IS_IOS ? 256 : 448;
const MAX_TOKENS = 512;

/* ── Status helpers ────────────────────────────────────────────────────── */
const statusDot  = document.getElementById('ac-status-dot');
const statusText = document.getElementById('ac-status-text');
const counterEl = document.getElementById('ac-counter');
let counterN = 0, counterFirst = 0, counterLast = 0;
function counterReset() { counterN = 0; counterFirst = 0; counterLast = 0; counterEl.hidden = true; counterEl.textContent = ''; }
function counterTick() {
  const now = performance.now();
  counterN++;
  if (!counterFirst) counterFirst = now;
  counterLast = now;
  const secs = (counterLast - counterFirst) / 1000;
  const tps = counterN > 1 && secs > 0.05 ? ((counterN - 1) / secs).toFixed(1) : '';
  counterEl.textContent = COPY.counter.replace('{n}', String(counterN)).replace('{tps}', tps || '…');
  counterEl.hidden = false;
}
function setStatus(state, text) {
  statusDot.className = 'ac__status-dot ac__status-dot--' + state;
  statusText.textContent = text;
}

/* ── WebGPU gate ───────────────────────────────────────────────────────── */
// Mentria is WebGPU-only by design. If the browser doesn't expose WebGPU,
// surface a clean error rather than silently degrading. Common cases:
//   - Safari < 26 (no WebGPU)
//   - Firefox stable (WebGPU still in nightly as of 2026-04)
//   - Chrome on Linux without `--enable-features=Vulkan`
//   - Mobile browsers without WebGPU yet
function showUnsupportedError(reason) {
  setStatus('error', reason);
  const messagesEl = document.getElementById('ac-messages');
  const emptyEl    = document.getElementById('ac-empty');
  if (emptyEl) {
    const escSub = COPY.errUnsupportedSub.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    emptyEl.innerHTML =
      '<div class="ac__empty-icon">&#9888;</div>' +
      '<p>' + COPY.errUnsupportedMain + '</p>' +
      '<p class="ac__empty-sub">' + escSub + '</p>';
  }
  document.getElementById('ac-input').disabled = true;
  document.getElementById('ac-send').disabled  = true;
  document.getElementById('ac-attach-label').style.display = 'none';
}

if (!navigator.gpu) {
  showUnsupportedError(COPY.errNoWebGpu);
} else {
  let MentriaEngine, Tiers;
  try {
    ({ MentriaEngine } = await import(MENTRIA_DIST_BASE + 'mentria.mjs'));
    Tiers = await import(MENTRIA_TIERS_PATH);
  } catch (err) {
    console.error('Failed to load mentria-engine bundle:', err);
    showUnsupportedError(COPY.errLoadRuntime);
  }
  if (MentriaEngine && Tiers) runApp(MentriaEngine, Tiers);
}

function runApp(MentriaEngine, Tiers) {
  /* ── DOM refs ────────────────────────────────────── */
  const tierSel       = document.getElementById('ac-tier');
  const deleteBtn     = document.getElementById('ac-delete-model');
  const clearChatBtn  = document.getElementById('ac-clear-chat');
  const activityHost  = document.getElementById('ac-activity');
  const messagesEl    = document.getElementById('ac-messages');
  const emptyEl       = document.getElementById('ac-empty');
  const imgPreview    = document.getElementById('ac-img-preview');
  const imgThumb      = document.getElementById('ac-img-thumb');
  const imgRemoveBtn  = document.getElementById('ac-img-remove');
  const fileInput     = document.getElementById('ac-file-input');
  const inputEl       = document.getElementById('ac-input');
  const sendBtn       = document.getElementById('ac-send');
  const thinkToggle   = document.getElementById('ac-think-toggle');
  const searchToggle  = document.getElementById('ac-search-toggle');
  const searchCfg     = document.getElementById('ac-search-cfg');
  const searchUrlEl   = document.getElementById('ac-search-url');
  const searchTestBtn = document.getElementById('ac-search-test');
  const searchSaveBtn = document.getElementById('ac-search-save');
  const searchRemBtn  = document.getElementById('ac-search-remove');
  const searchStatus  = document.getElementById('ac-search-status');
  const adaptersPanel = document.getElementById('ac-adapters');
  const adaptersList  = document.getElementById('ac-adapters-list');
  const adaptersNote  = document.getElementById('ac-adapters-note');
  const adaptersClose = document.getElementById('ac-adapters-close');
  const adapterChip   = document.getElementById('ac-adapter-chip');

  /* ── State ───────────────────────────────────────── */
  let engine = null;
  let prefixCache = null;
  let generating = false;
  let abortCtrl = null;
  let genEpoch = 0;
  let attachedImage = null;       // {rgbHwc, h, w} — pending attach for the NEXT send
  let attachedDataUrl = null;
  // conversationImages keeps every image sent in this conversation, in order.
  // The chat template re-renders the full message history every turn, so each
  // {type:'image'} placeholder needs its corresponding rgbHwc on every call —
  // not just the turn the image was first attached on.
  let conversationImages = [];
  function modelFamilyFor(tier) {
    return tier === '27b' ? 'Bonsai 27B' : 'Qwen3.5';
  }

  function systemPromptFor(tier) {
    const family = modelFamilyFor(tier);
    return "You are the Mentria AI assistant. You run " + family + " locally in the user's browser via WebGPU. Your weights were fine-tuned and shipped by mentria.ai.\n\n" +
      "When the user asks who you are or what model you run: identify as the Mentria AI assistant, running " + family + " in their browser. When asked about Mentria itself: it is a small privacy-first creative studio at mentria.ai, building tools, games, and AI experiences that run entirely client-side with no servers, no accounts, and no telemetry. Notable parts of the site: TOTP, quick notes, QR scanner, color picker, Tetris, Breakout, Minesweeper, an infinite AI-generated radio, a P2P chat and file drop at /comms/, and a daily image-fact feed called Deep Cuts.\n\n" +
      "Be helpful, accurate, and brief. Don't over-apologize. When the user shares an image, describe what you see directly. You cannot browse the web, run code, call APIs, or remember between sessions; if something is outside your training, say so plainly.\n\n" +
      "Formatting: use markdown sparingly. For tables, output strict GitHub-flavored markdown: one header row, one divider row made only of pipes and dashes, then data rows. Never put prose, notes, parentheticals, or extra characters between the divider and the data rows. Each cell is one short phrase, never a sentence. Any explanation goes outside the table.";
  }

  let messages = [
    { role: 'system', content: systemPromptFor(null) },
  ];

  const systemMessage = messages[0];

  function persistConversation() {
    if (!window.MentriaStore) return;
    const turns = [];
    for (let i = 1; i < messages.length; i++) {
      const m = messages[i];
      if (m.ephemeral) continue;
      if (Array.isArray(m.content)) {
        const txt = m.content.filter(p => p && p.type === 'text').map(p => p.text).join(' ');
        turns.push({ role: m.role, text: txt, img: m.content.some(p => p && p.type === 'image') || undefined });
      } else {
        turns.push({ role: m.role, text: String(m.content || '') });
      }
    }
    const capped = turns.slice(-40);
    if (capped.length) window.MentriaStore.set('ai_chat', 'conversation', capped);
    else window.MentriaStore.remove('ai_chat', 'conversation');
  }

  function clearConversation() {
    genEpoch++;
    if (generating) stopGeneration();
    messages = [systemMessage];
    conversationImages = [];
    if (window.MentriaStore) window.MentriaStore.remove('ai_chat', 'conversation');
    messagesEl.innerHTML = '';
    if (emptyEl) {
      messagesEl.appendChild(emptyEl);
      emptyEl.style.display = '';
    }
    clearChatBtn.style.display = 'none';
  }

  async function restoreConversation() {
    if (!window.MentriaStore) return;
    const saved = window.MentriaStore.get('ai_chat', 'conversation');
    if (!Array.isArray(saved) || !saved.length) return;
    if (window.renderMarkdownReady) { try { await window.renderMarkdownReady; } catch (_) {} }
    saved.forEach((t) => {
      if (!t || (t.role !== 'user' && t.role !== 'assistant') || typeof t.text !== 'string') return;
      if (t.role === 'user') {
        const shown = t.img
          ? (t.text ? t.text + ' [' + COPY.imgAltAttachedShort + ']' : '[' + COPY.imgAltAttachedShort + ']')
          : t.text;
        addMessage('user', shown);
        const engineText = t.img
          ? (t.text || 'Describe this image.') + ' (an image was attached here in an earlier session; it is no longer available)'
          : t.text;
        messages.push({ role: 'user', content: [{ type: 'text', text: engineText }] });
      } else {
        const bodyEl = addMessage('assistant', '');
        if (window.renderMarkdown) bodyEl.innerHTML = renderMarkdown(t.text) || '';
        else bodyEl.textContent = t.text;
        messages.push({ role: 'assistant', content: t.text });
        addAssistantActions(bodyEl, () => t.text);
      }
    });
    clearChatBtn.style.display = '';
    scrollToBottom();
  }

  clearChatBtn.addEventListener('click', clearConversation);
  setTimeout(restoreConversation, 0);

  function scrollToBottom() { messagesEl.scrollTop = messagesEl.scrollHeight; }
  const nativeFieldSizing = CSS.supports('field-sizing', 'content');
  function autoResize() {
    if (nativeFieldSizing) return;
    inputEl.style.height = 'auto';
    inputEl.style.height = Math.min(inputEl.scrollHeight, 120) + 'px';
  }

  function addMessage(role, content, imageUrl) {
    if (emptyEl) emptyEl.style.display = 'none';
    const bubble = document.createElement('div');
    bubble.className = 'ac__msg ac__msg--' + role;
    const label = document.createElement('div');
    label.className = 'ac__msg-label';
    label.textContent = role === 'user' ? COPY.labelYou : (currentTier === '27b' ? 'bonsai-' : 'qwen-') + ((currentTier && Tiers.TIERS[currentTier]) ? Tiers.TIERS[currentTier].name : '0.8B') + (pinned && role !== 'user' ? ' · ' + pinned.name : '');
    bubble.appendChild(label);
    if (imageUrl) {
      const img = document.createElement('img');
      img.className = 'ac__msg-img'; img.src = imageUrl; img.alt = COPY.imgAltAttachedShort;
      bubble.appendChild(img);
    }
    const body = document.createElement('div');
